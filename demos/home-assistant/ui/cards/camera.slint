import { Theme } from "../theme.slint";
import { Rooms } from "../rooms.slint";
import { Home } from "../state.slint";
import { Icon, IconName } from "../components/icon.slint";
import { ActionButton } from "../components/button.slint";

export component CameraCard inherits Rectangle {
    in property <int> room;
    private property <bool> wide: root.width > 400px;
    Rectangle {
        x: 16px; y: 16px; width: 248px; height: root.wide ? 194px : 150px;
        border-radius: 15px; clip: true;
        Image { source: Rooms.all[root.room].camera-image; image-fit: cover; width: 100%; height: 100%; }
        Rectangle {
            x: 12px; y: 12px; width: 65px; height: 25px; border-radius: 12px;
            background: #0b0f24cc;
            Rectangle {
                x: 10px; width: 6px; height: 6px; border-radius: 3px; background: Theme.danger;
                opacity: 0.65 + 0.35 * sin(animation-tick() / 1s * 220deg);
            }
            Text { x: 24px; text: "LIVE"; color: Theme.text; font-size: 11px; font-weight: 600; letter-spacing: 0.7px; }
        }
    }
    Icon { x: root.wide ? 288px : 22px; y: root.wide ? 25px : 182px; name: IconName.camera; ink: Theme.secondary; width: 22px; height: 22px; }
    Text { x: root.wide ? 288px : 55px; y: root.wide ? 65px : 183px; text: Rooms.all[root.room].camera-name; color: Theme.text; font-size: root.wide ? 26px : 17px; }
    if !root.wide: Text { x: parent.width - self.width - 22px; y: 187px; text: "2 events"; color: Theme.muted; font-size: 12px; }
    if root.wide: Text { x: 288px; y: 107px; text: "Motion at 18:31"; color: Theme.secondary; font-size: 15px; }
    if root.wide: Text { x: 288px; y: 132px; text: Home.talking ? "Talk demo active" : "Package delivered"; color: Theme.secondary; font-size: 15px; }
    if root.wide: ActionButton {
        x: 288px; y: 164px; width: 120px; height: 38px;
        selected: true; accent: Rooms.all[root.room].accent; show-icon: false; show-label: true;
        label: Home.talking ? "End talk" : "Talk";
        activated => { Home.activity(); Home.talking = !Home.talking; }
    }
}
