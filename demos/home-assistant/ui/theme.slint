export global Theme {
    out property <color> text: #eef1ff;
    out property <color> secondary: #9ca6cf;
    out property <color> muted: #7f8abb;
    out property <color> ink: #0b0f24;
    out property <color> warm: #ffc56b;
    out property <color> cool: #65b4ff;
    out property <color> hot: #ff9b67;
    out property <color> success: #6fdfad;
    out property <color> danger: #ff6676;
    out property <color> track: #2a3260;
    out property <color> border: #343f70;
    out property <brush> card: @linear-gradient(165deg, #1d264b, #141a35);
    out property <brush> control: @linear-gradient(160deg, #2a345f, #202746);
    out property <duration> motion: 580ms;
}
