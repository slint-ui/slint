// cspell:ignore Pancit Palabok choy

export struct Ingredient {
    image: image,
    name: string,
    description: string,
    amount: float,
    unit: string,
    substitute: string
}

export struct RecipeTip {
    title: string,
    description: string,
}

export struct Recipe {
    photo: image,
    title: string,
    rating: string,
    reviews: int,
    prep-time: string,
    total-time: int,
    portions: int,
    ingredients: [Ingredient],
    description: string,
    steps: [string],
    tips: [RecipeTip],
    serving-notes: string,
}

export global RecipeDefaults {
    out property <string> description: "Start your day with this vibrant and nutritious berry smoothie bowl. Packed with antioxidants, vitamins, and natural sweetness, this recipe is perfect for a quick breakfast or post-workout snack. The creamy texture comes from frozen berries blended to perfection.";
    out property <[string]> steps: [
        "Add frozen berries, banana, yogurt, and almond milk to your food processor.",
        "Blend on high speed until smooth and creamy, about 1-2 minutes.",
        "Pour into bowls and add your favorite toppings like granola, fresh berries, or coconut flakes.",
        "Serve immediately and enjoy your nutritious smoothie bowl!",
    ];
    out property <[RecipeTip]> tips: [
        {
            title: "Perfect Consistency",
            description: "Use frozen fruit for a thicker texture. Add liquid gradually to control consistency."
        },
        {
            title: "Topping Ideas",
            description: "Try granola, chia seeds, sliced almonds, fresh berries, or a drizzle of nut butter."
        },
        {
            title: "Make Ahead",
            description: "Pre-portion ingredients in freezer bags for quick morning prep."
        },
    ];

    out property <[Ingredient]> ingredients: [
        {
            image: @image-url("images/ingredients/oil.svg"),
            name: "light sesame oil",
            description: "",
            amount: 10,
            unit: "g",
            substitute: "groundnut oil"
        },
        {
            image: @image-url("images/ingredients/onion.svg"),
            name: "onions",
            description: "quartered",
            amount: 50,
            unit: "g",
            substitute: ""
        },
        {
            image: @image-url("images/ingredients/carrots.svg"),
            name: "carrots",
            description: "cut in large pieces (4 cm)",
            amount: 75,
            unit: "g",
            substitute: ""
        },
        {
            image: @image-url("images/ingredients/bacon.svg"),
            name: "bacon cubes",
            description: "",
            amount: 75,
            unit: "g",
            substitute: ""
        },
        {
            image: @image-url("images/ingredients/soy.svg"),
            name: "soy sauce",
            description: "",
            amount: 15,
            unit: "g",
            substitute: ""
        },
    ];
}

