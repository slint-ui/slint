// cspell:ignore Pancit Palabok

export struct Ingredient {
    image: image,
    name: string,
    description: string,
    amount: float,
    unit: string,
    substitute: string
}

export struct Recipe {
    photo-grid: image,
    photo-detail: image,
    title: string,
    rating: string,
    reviews: int,
    prep-time: string,
    total-time: int,
    portions: int,
    ingredients: [Ingredient]
}

export global CommonIngredients {
    out property <[Ingredient]> default-ingredients: [
        {
