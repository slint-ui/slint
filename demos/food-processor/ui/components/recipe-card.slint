import { RecipePhoto } from "recipe-photo.slint";

export component RecipeCard inherits Rectangle {
    width: 218px;
    height: 218px;

    in property <image> photo;
    in property <string> title: "Recipe Name";
    in property <string> time: "1 Std. 20 Min";

    callback recipe-clicked();

    RecipePhoto {
        width: 100%;
        height: 100%;
        photo: root.photo;

        Rectangle {
            background: @linear-gradient(0deg, #000000b8 0%, #00000000 70%);
        }

        Text {
            x: 12px;
            y: parent.height - self.height - 18px;
            width: parent.width - 24px;
            text: root.title;
            font-size: 16px;
            font-weight: FontWeight.bold;
            color: white;
            overflow: elide;
            horizontal-alignment: center;
            letter-spacing: -0.2px;
        }

        Rectangle {
            x: parent.width - self.width - 12px;
            y: 12px;
            width: max(80px, badge-content.preferred-width);
            height: 28px;
            border-radius: 8px;
            background: white;
            drop-shadow-blur: 8px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000030;

            badge-content := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;
                cross-axis-alignment: center;

                Image {
                    width: 12px;
                    height: 12px;
                    source: @image-url("../images/time.svg");
                }

                Text {
                    text: root.time;
                    color: #171717;
                    font-size: 12px;
                    font-weight: FontWeight.bold;
                    vertical-alignment: center;
                }
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.recipe-clicked(); }
    }
}
