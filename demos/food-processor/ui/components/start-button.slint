import { Styles } from "../styles.slint";

export component StartButton {
    callback clicked <=> ta.clicked;

    HorizontalLayout {
        spacing: Styles.spacing-lg;
        alignment: center;

        Image {
            source: @image-url("../images/play.svg");
            colorize: white;
            width: Styles.action-icon-size;
        }

        Text {
            font-size: Styles.button-font-size;
            font-weight: FontWeight.bold;
            color: white;
            text: "Start Recipe";
            letter-spacing: 0.2px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea { }
}
