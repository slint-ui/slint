export component StartButton {
    callback clicked <=> ta.clicked;

    HorizontalLayout {
        spacing: 16px;
        alignment: center;

        Image {
            source: @image-url("../images/play.svg");
            colorize: white;
            width: 30px;
        }

        Text {
            font-size: 16pt;
            font-weight: FontWeight.bold;
            color: white;
            text: "Start Recipe";
            letter-spacing: 0.2px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea { }
}
