import { ScrollView } from "std-widgets.slint";
import { RecipeCard } from "recipe-card.slint";
import { Recipe } from "../recipe-adapter.slint";
import { Header } from "header.slint";
import { Styles } from "../styles.slint";

export component RecipesGrid {
    in property <[Recipe]> recipes;
    in property <int> columns: 4;
    property <length> card-size: 218px;
    in property <length> spacing: (root.width - (Styles.side-margin * 2) - (card-size * columns)) / (columns - 1);

    callback item-clicked(int);

    ScrollView {
        x: 0px;
        y: header.height;
        width: root.width;
        height: root.height - header.height;
        content-width: self.visible-width;
        content-height: gl.preferred-height + 40px;
        horizontal-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: true;

        gl := GridLayout {
            x: Styles.side-margin;
            y: 16px;
            spacing: root.spacing;
            for recipe[index] in root.recipes: RecipeCard {
                photo: recipe.photo;
                title: recipe.title;
                time: recipe.total-time + " Min.";
                col: (index.mod(columns));
                row: (index / columns);
                recipe-clicked => {
                    root.item-clicked(index);
                }
            }
        }
    }

    header := Header {
        y: 0px;

        Rectangle {
            height: vl.preferred-height;
            vl := VerticalLayout {
                x: Styles.side-margin;
                alignment: start;
                spacing: 4px;
                Text {
                    color: #171717;
                    font-size: 24px;
                    text: "Recipes";
                    font-weight: FontWeight.semi-bold;
                }

                Text {
                    color: #737373;
                    font-size: Styles.small-font-size;
                    text: "Explore curated recipes for your food processor";
                    font-weight: FontWeight.medium;
                }
            }
        }
    }
}
