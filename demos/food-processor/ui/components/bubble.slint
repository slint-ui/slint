export component Bubble inherits Rectangle {
    width: 140px;
    height: 84px;
    border-radius: 14px;
    background: #fafafa;
    border-width: 1px;
    border-color: #e5e5e5;

    in property <string> title;
    in property <string> time: "15 Min";
    in property <image> icon: @image-url("../images/prep.jpg");

    Rectangle {
        x: 16px;
        width: vl.preferred-width;
        height: vl.preferred-height;
        vl := VerticalLayout {
            spacing: 4px;
            info := HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Image {
                    width: 16px;
                    source: root.icon;
                }

                Text {
                    text: root.title;
                    font-size: 12px;
                    font-weight: FontWeight.medium;
                    color: #737373;
                }
            }

            Text {
                text: root.time;
                font-size: 18px;
                font-weight: FontWeight.bold;
                color: #171717;
            }
        }
    }
}
