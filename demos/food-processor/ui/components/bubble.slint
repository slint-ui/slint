import { Styles } from "../styles.slint";

export component Bubble inherits Rectangle {
    width: 140px;
    height: 84px;
    border-radius: Styles.medium-border-radius;
    background: #fafafa;
    border-width: Styles.border-width;
    border-color: #e5e5e5;

    in property <string> title;
    in property <string> time: "15 Min";
    in property <image> icon: @image-url("../images/prep.jpg");

    Rectangle {
        x: Styles.spacing-lg;
        width: vl.preferred-width;
        height: vl.preferred-height;
        vl := VerticalLayout {
            spacing: Styles.spacing-xs;
            info := HorizontalLayout {
                alignment: start;
                spacing: Styles.spacing-sm;
                Image {
                    width: Styles.medium-icon-size;
                    source: root.icon;
                }

                Text {
                    text: root.title;
                    font-size: Styles.caption-font-size;
                    font-weight: FontWeight.medium;
                    color: #737373;
                }
            }

            Text {
                text: root.time;
                font-size: Styles.medium-font-size;
                font-weight: FontWeight.bold;
                color: #171717;
            }
        }
    }
}
