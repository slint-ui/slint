import { Recipe } from "../recipe-adapter.slint";
import { Styles } from "../styles.slint";

export component CookingTimer {
    in property <Recipe> recipe;
    in property <int> remaining-seconds: 0;

    property <float> minutes: Math.floor(root.remaining-seconds / 60);
    property <float> seconds: Math.mod(root.remaining-seconds, 60);
    property <string> seconds-str: seconds < 10 ? "0" + seconds : seconds;

    callback clicked <=> ta.clicked;
    callback close <=> close-ta.clicked;

    ta := TouchArea { }

    content := HorizontalLayout {
        padding-left: Styles.spacing-xl;
        padding-right: Styles.spacing-xl;
        spacing: Styles.spacing-xl;
        alignment: center;

        clock-icon := Rectangle {
            width: Styles.large-icon-size;
            height: self.width;
            cross-axis-self-alignment: center;
            border-radius: self.height / 2;
            background: #4285f4;

            Image {
                width: Styles.regular-icon-size;
                source: @image-url("../images/time.svg");
                colorize: white;
            }
        }

        VerticalLayout {
            spacing: Styles.spacing-xs;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: "Cooking";
                font-size: Styles.small-font-size;
                color: #999;
                font-weight: FontWeight.normal;
                horizontal-alignment: left;
            }

            Text {
                text: root.recipe.title;
                font-size: Styles.small-font-size;
                font-weight: FontWeight.semi-bold;
                color: white;
                horizontal-alignment: left;
            }
        }

        Rectangle {
            height: parent.height;
            width: 100px;

            Text {
                text: {
                    minutes + ":" + seconds-str
                }
                width: parent.width;
                font-size: Styles.small-font-size;
                font-weight: FontWeight.bold;
                color: white;
                vertical-alignment: center;
                horizontal-alignment: left;
            }

            Text {
                text: "|";
                font-size: Styles.small-font-size;
                x: close-button.x - Styles.control-padding;
            }

            close-button := Rectangle {
                x: parent.width - self.width;
                width: Styles.action-icon-size;
                height: self.width;

                close-ta := TouchArea {
                    width: 80px;
                    height: self.width;
                }

                Image {
                    source: @image-url("../images/close.svg");
                    width: 14px;
                    colorize: white;
                }
            }
        }
    }
}
