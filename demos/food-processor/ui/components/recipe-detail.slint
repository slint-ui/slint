import { ScrollView } from "std-widgets.slint";
import { Recipe } from "../recipe-adapter.slint";
import { Header } from "header.slint";
import { Styles } from "../styles.slint";
import { TabBar } from "tab-bar.slint";
import { OverviewPage } from "pages/overview.slint";
import { IngredientsPage } from "pages/ingredients.slint";
import { PreparationPage } from "pages/preparation.slint";
import { TipsPage } from "pages/tips.slint";
import { MoreInfoPage } from "pages/more_info.slint";


export component RecipeDetail inherits Rectangle {
    in property <Recipe> recipe;
    property <int> active-tab: 0;

    callback back-clicked();
    callback portions-changed(int);

    Rectangle {
        background: white;
    }

    header := Header {
        x: 0px;
        y: 0px;
        height: Styles.control-height + 2 * Styles.spacing-sm;
        TouchArea {
            x: 0px;
            width: 200px;
            height: 100%;
            clicked => {
                root.back-clicked();
            }
        }

        back-button := HorizontalLayout {
            x: Styles.side-margin;
            spacing: Styles.spacing-sm;
            height: self.preferred-height;
            Image {
                source: @image-url("../images/back.svg");
                width: Styles.medium-icon-size;
            }

            Text {
                vertical-alignment: center;
                text: "Back to Recipes";
                font-size: Styles.small-font-size;
                color: #525252;
                font-weight: FontWeight.medium;
            }
        }
    }

    details := Rectangle {
        width: root.width - (Styles.side-margin * 2);
        height: root.height - header.height - tabs.height - (Styles.spacing-xl * 2);
        x: Styles.side-margin;
        y: header.height + Styles.spacing-xl;

        if active-tab == 0: overview-page := OverviewPage {
            recipe: root.recipe;
        }
        else : ScrollView {
            content-width: self.visible-width;
            horizontal-scrollbar-policy: always-off;
            mouse-drag-pan-enabled: true;

            VerticalLayout {
                if active-tab == 1: IngredientsPage {
                    recipe: root.recipe;
                    portions-changed(portions) => { root.portions-changed(portions); }
                }
                else if active-tab == 2: PreparationPage {
                    recipe: root.recipe;
                }
                else if active-tab == 3: TipsPage {
                    recipe: root.recipe;
                }
                else if active-tab == 4: MoreInfoPage {
                    recipe: root.recipe;
                }
            }
        }
    }

    tabs := TabBar {
        y: parent.height - self.height;
        tabs: ["Overview", "Ingredients", "Preparation", "Tips", "More"];
        active-tab: root.active-tab;
        tab-changed(index) => {
            root.active-tab = index;
        }
    }
}
