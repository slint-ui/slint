import { Recipe } from "../../recipe-adapter.slint";
import { Styles } from "../../styles.slint";

component TipCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <color> bg-color;
    in property <color> text-color;

    background: root.bg-color;
    border-radius: 14px;
    border-width: 2px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: start;

        Text {
            text: root.title;
            font-size: Styles.regular-font-size;
            font-weight: FontWeight.semi-bold;
            color: root.text-color;
        }

        Text {
            text: root.description;
            font-size: Styles.small-font-size;
            color: root.text-color;
            font-weight: FontWeight.normal;
            wrap: word-wrap;
            opacity: 0.9;
        }
    }
}

export component TipsPage inherits VerticalLayout {
    in property <Recipe> recipe;
    spacing: 20px;
    padding: 40px;
    alignment: start;

    Text {
        text: "Pro Tips";
        font-size: Styles.regular-font-size;
        font-weight: FontWeight.semi-bold;
        color: #171717;
    }

    VerticalLayout {
        spacing: 20px;

        for tip[index] in root.recipe.tips: TipCard {
            title: tip.title;
            description: tip.description;
            bg-color: index == 0 ? #fef9e7 : index == 1 ? #deeafd : #e2fbe8;
            text-color: index == 0 ? #8b6914 : index == 1 ? #1b34af : #326b3d;
            border-color: index == 0 ? #feeca3 : index == 1 ? #bedbff : #c9f7e4;
        }
    }
}
