import { Recipe, Ingredient } from "../../recipe-adapter.slint";
import { Styles } from "../../styles.slint";

component IngredientItem inherits HorizontalLayout {
    in property <Ingredient> ingredient;
    in property <float> multiplier: 1.0;
    alignment: space-between;

    HorizontalLayout {
        spacing: 30px;
        height: 48px;

        Image {
            source: root.ingredient.image;
            width: 48px;
        }

        ingredient := VerticalLayout {
            spacing: 4px;
            alignment: center;

            Text {
                text: root.ingredient.name;
                font-size: 20px;
                font-weight: FontWeight.medium;
                color: #171717;
            }

            if root.ingredient.description != "": Text {
                text: root.ingredient.description;
                font-size: 12px;
                font-weight: FontWeight.normal;
                color: #737373;
            }

            if root.ingredient.substitute != "": Text {
                text: "or " + root.ingredient.substitute;
                font-size: Styles.small-font-size;
                font-weight: FontWeight.normal;
                color: #737373;
            }
        }
    }

    amount := Text {
        text: Math.round(root.ingredient.amount * root.multiplier) + " " + root.ingredient.unit;
        font-size: Styles.regular-font-size;
        font-weight: FontWeight.semi-bold;
        color: #171717;
    }
}

export component IngredientsPage inherits VerticalLayout {
    in property <Recipe> recipe;

    property <float> portion-multiplier: recipe.portions / 3;

    callback portions-changed(int);

    spacing: Styles.side-margin;
    padding-left: Styles.side-margin;
    padding-right: Styles.side-margin;
    padding-top: Styles.side-margin / 2;
    alignment: start;

    VerticalLayout {
        spacing: 20px;

        VerticalLayout {
            padding-bottom: 24px;

            Text {
                text: "Ingredients";
                font-size: 24px;
                font-weight: FontWeight.bold;
                color: #1a1a1a;
            }
        }

        for ingredient[index] in root.recipe.ingredients: IngredientItem {
            ingredient: ingredient;
            multiplier: root.portion-multiplier;
        }
    }
}
