import { ListView } from "std-widgets.slint";

/// How much the demo spends on its looks, see `adaptive.rs`.
export enum Quality { low, medium, high }

/// The shapes of the panels and controls.
export enum Style { cockpit, wing, ticket }

global Theme {
    /// The panels blur the globe behind them in high quality, and are flat and more opaque
    /// otherwise.
    in-out property <Quality> quality: Quality.high;
    out property <bool> blur: self.quality == Quality.high;
    in-out property <Style> style: Style.cockpit;
    out property <bool> cockpit: self.style == Style.cockpit;
    out property <bool> wing: self.style == Style.wing;
    out property <bool> ticket: self.style == Style.ticket;
    out property <color> text: #e8eef6;
    out property <color> muted: #8b98a9;
    /// Placeholders and the frame rate, dimmer than `muted`.
    out property <color> faint: #ffffff50;
    out property <color> accent: #2379f4;
    out property <color> accent-light: #6aaeff;
    /// Behind the globe on the entry screen.
    out property <color> background: #04070c;
    out property <color> surface: #0a111a;
    out property <color> glass: self.surface.with-alpha(self.blur ? 0.5 : 0.88);
    out property <color> line: #ffffff1c;
    /// A tint over the glass for buttons and fields, and its hover and pressed states.
    out property <color> fill: #ffffff12;
    out property <color> fill-hover: #ffffff1f;
    out property <color> fill-pressed: #ffffff2a;
    /// The off state of a toggle, and the part of the route still ahead.
    out property <color> track: #ffffff30;
    out property <length> margin: 16px;
}

export enum View { follow, route, globe, free }

export enum Phase { boarding, flying, arrived }

/// What the window shows: the entry screen, the globe growing from its place there to the window
/// or shrinking back, or a flight.
export enum Screen { entry, zoom, flight }

export struct AirportItem {
    /// -1 for none.
    index: int = -1,
    code: string,
    city: string,
    country: string,
    name: string,
}

export struct FlightInfo {
    phase: Phase,
    origin: AirportItem,
    destination: AirportItem,
    /// The flown part of the distance, from 0 to 1.
    progress: float,
    remaining-time: string,
    remaining-distance: string,
    flown-distance: string,
    total-distance: string,
    speed: string,
    altitude: string,
    temperature: string,
    heading: string,
    arrival-light: string,
}

/// An airport's place on the screen, in logical pixels.
export struct Marker {
    shown: bool,
    x: float,
    y: float,
    code: string,
}

export struct Aircraft {
    shown: bool,
    x: float,
    y: float,
    /// Clockwise from pointing up.
    angle: float,
}

export struct Label {
    x: float,
    y: float,
    name: string,
    opacity: float,
}

/// A panel of frosted glass. Panels on the right set `mirrored`, so that in the wing style
/// they sweep the other way, like the other wing.
component Glass inherits Rectangle {
    in property <bool> mirrored;
    /// The corners that aren't swept.
    in property <length> radius: Theme.cockpit ? 2px : Theme.wing ? 3px : 6px;
    in property <length> sweep: Theme.wing ? 56px : self.radius;
    /// The length of the brackets on the corners in the cockpit style, or 0 for none.
    in property <length> bracket: 12px;
    background: Theme.glass;
    backdrop-blur: Theme.blur ? 20px : 0px;
    border-top-left-radius: root.mirrored ? root.radius : root.sweep;
    border-top-right-radius: root.mirrored ? root.sweep : root.radius;
    border-bottom-right-radius: root.mirrored ? root.radius : root.sweep;
    border-bottom-left-radius: root.mirrored ? root.sweep : root.radius;
    border-width: 1px;
    border-color: Theme.line;
    for corner in (Theme.cockpit && root.bracket > 0 ? 4 : 0): Rectangle {
        property <bool> right: Math.mod(corner, 2) == 1;
        property <bool> bottom: corner >= 2;
        x: self.right ? root.width - self.width : 0;
        y: self.bottom ? root.height - self.height : 0;
        width: root.bracket;
        height: root.bracket;
        Rectangle {
            y: parent.bottom ? parent.height - self.height : 0;
            height: 2px;
            background: Theme.accent-light;
        }

        Rectangle {
            x: parent.right ? parent.width - self.width : 0;
            width: 2px;
            background: Theme.accent-light;
        }
    }
}

/// A glass panel, which the ticket style tears in two along `tear`.
component Panel {
    in property <length> tear;
    in property <bool> mirrored;
    property <length> notch: 16px;
    property <bool> torn: Theme.ticket && root.tear > 0;
    Glass {
        height: root.torn ? root.tear : root.height;
        mirrored: root.mirrored;
        border-bottom-right-radius: root.torn ? root.notch : root.mirrored ? self.radius : self.sweep;
        border-bottom-left-radius: root.torn ? root.notch : root.mirrored ? self.sweep : self.radius;
    }

    if root.torn: Glass {
        y: root.tear;
        height: root.height - root.tear;
        border-top-left-radius: root.notch;
        border-top-right-radius: root.notch;
    }

    if root.torn: Rectangle {
        y: root.tear - 1px;
        height: 2px;
        for dash in Math.floor((root.width - 2 * root.notch - 8px) / 8px): Rectangle {
            x: root.notch + 6px + dash * 8px;
            width: 4px;
            background: Theme.muted;
        }
    }

    @children
}

component PillButton inherits Rectangle {
    in property <string> text;
    /// An icon before the text, in the text's color.
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    /// See `Glass`.
    in property <bool> mirrored;
    callback clicked;
    property <length> radius: Theme.cockpit ? 2px : 4px;
    property <length> sweep: Theme.wing ? self.height / 2 : self.radius;
    height: 36px;
    min-width: content.preferred-width + 28px;
    border-top-left-radius: root.mirrored ? root.radius : root.sweep;
    border-top-right-radius: root.mirrored ? root.sweep : root.radius;
    border-bottom-right-radius: root.mirrored ? root.radius : root.sweep;
    border-bottom-left-radius: root.mirrored ? root.sweep : root.radius;
    border-width: Theme.cockpit && !root.primary ? 1px : 0;
    border-color: Theme.line;
    opacity: root.enabled ? 1 : 0.4;
    background: root.primary
        ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
        : (touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : Theme.fill);
    content := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon.width > 0: Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: Theme.text;
            transform-rotation: 90deg;
        }
        // The stub of a ticket.
        if Theme.ticket && root.icon.width > 0 && root.text != "": VerticalLayout {
            padding-left: 3px;
            padding-right: 3px;
            for dash in 4: Rectangle {
                width: 1px;
                height: 9px;
                Rectangle {
                    y: 2px;
                    height: 5px;
                    background: Theme.text.with-alpha(0.45);
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component RoundButton inherits Glass {
    in property <string> text;
    /// An icon instead of the text, in the text's color.
    in property <image> icon;
    in property <bool> checked;
    callback clicked;
    width: 40px;
    height: 40px;
    radius: Theme.cockpit ? 2px : Theme.wing ? 5px : 6px;
    sweep: Theme.wing ? self.width / 2 : self.radius;
    bracket: 0;
    background: root.checked ? Theme.accent : Theme.glass;
    Rectangle {
        border-top-left-radius: root.border-top-left-radius;
        border-top-right-radius: root.border-top-right-radius;
        border-bottom-right-radius: root.border-bottom-right-radius;
        border-bottom-left-radius: root.border-bottom-left-radius;
        background: touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : transparent;
    }

    if root.icon.width == 0: Text {
        text: root.text;
        color: Theme.text;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A key beside a cockpit display, with a light on top.
component Key inherits Glass {
    in property <string> text;
    /// An icon before the text, in the text's color.
    in property <image> icon;
    in property <angle> icon-rotation;
    in property <bool> checked;
    in property <bool> primary;
    callback clicked;
    bracket: 0;
    height: 44px;
    min-width: max(44px, content.preferred-width + 24px);
    horizontal-stretch: 1;
    background: root.primary ? Theme.accent : Theme.glass;
    Rectangle {
        border-radius: root.radius;
        background: touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : transparent;
    }

    Rectangle {
        x: 8px;
        y: 5px;
        width: parent.width - 16px;
        height: 3px;
        background: root.checked ? Theme.accent-light : root.primary ? Theme.text.with-alpha(0.35) : Theme.track;
        drop-shadow-blur: root.checked ? 6px : 0;
        drop-shadow-color: Theme.accent-light;
    }

    content := HorizontalLayout {
        y: 6px;
        height: parent.height - 6px;
        alignment: center;
        spacing: 6px;
        if root.icon.width > 0: Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: Theme.text;
            transform-rotation: root.icon-rotation;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.checked || root.primary ? Theme.text : Theme.muted;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A switch, or an annunciator in the cockpit style.
component Toggle {
    in property <string> text;
    in-out property <bool> checked;
    /// See `Glass`.
    in property <bool> mirrored;
    callback toggled();
    height: 32px;
    Text {
        x: 0;
        text: root.text;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
    }

    if Theme.cockpit: Rectangle {
        x: parent.width - self.width;
        width: 48px;
        height: 22px;
        border-radius: 2px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent-light : Theme.line;
        background: root.checked ? Theme.accent.with-alpha(0.3) : Theme.fill;
        animate background, border-color { duration: 150ms; }
        Text {
            text: root.checked ? "ON" : "OFF";
            color: root.checked ? Theme.accent-light : Theme.muted;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
        }
    }

    if !Theme.cockpit: Rectangle {
        property <length> radius: Theme.wing ? 3px : 4px;
        property <length> sweep: Theme.wing ? self.height / 2 : self.radius;
        x: parent.width - self.width;
        width: Theme.wing ? 40px : 38px;
        height: 22px;
        border-top-left-radius: root.mirrored ? self.radius : self.sweep;
        border-top-right-radius: root.mirrored ? self.sweep : self.radius;
        border-bottom-right-radius: root.mirrored ? self.radius : self.sweep;
        border-bottom-left-radius: root.mirrored ? self.sweep : self.radius;
        background: root.checked ? Theme.accent : Theme.track;
        animate background { duration: 150ms; }
        Rectangle {
            property <length> sweep: Theme.wing ? self.height / 2 : 2px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            width: 16px;
            height: 16px;
            border-top-left-radius: root.mirrored ? 2px : self.sweep;
            border-top-right-radius: root.mirrored ? self.sweep : 2px;
            border-bottom-right-radius: root.mirrored ? 2px : self.sweep;
            border-bottom-left-radius: root.mirrored ? self.sweep : 2px;
            background: white;
            animate x {
                duration: 150ms;
                easing: ease-out;
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

/// Options side by side; none is highlighted while `current` is -1.
/// A tab strip in the cockpit style, wings in the wing style, and coupons in the ticket style.
component Segmented {
    in property <[string]> options;
    in property <int> current;
    /// See `Glass`.
    in property <bool> mirrored;
    callback picked(index: int);
    property <length> cell: self.width / self.options.length;
    height: 36px;
    if !Theme.wing: Rectangle {
        border-radius: Theme.cockpit ? 2px : 4px;
        border-width: Theme.cockpit ? 1px : 0;
        border-color: Theme.line;
        background: Theme.fill;
    }

    for index in (Theme.wing ? root.options.length : 0): Rectangle {
        x: root.cell * index + 2px;
        width: root.cell - 4px;
        border-top-left-radius: root.mirrored ? 3px : self.height / 2;
        border-top-right-radius: root.mirrored ? self.height / 2 : 3px;
        border-bottom-right-radius: root.mirrored ? 3px : self.height / 2;
        border-bottom-left-radius: root.mirrored ? self.height / 2 : 3px;
        background: Theme.fill;
    }

    for index in (Theme.wing ? 0 : root.options.length - 1): Rectangle {
        x: root.cell * (index + 1);
        y: Theme.cockpit ? 9px : 5px;
        width: 1px;
        height: root.height - 2 * self.y;
        background: Theme.cockpit ? Theme.line : transparent;
        for dash in (Theme.ticket ? 5 : 0): Rectangle {
            y: dash * 6px;
            height: 3px;
            background: Theme.muted;
        }
    }

    if root.current >= 0: Rectangle {
        property <length> inset: Theme.cockpit ? 0 : Theme.wing ? 2px : 3px;
        property <length> radius: Theme.cockpit ? 0 : 3px;
        property <length> sweep: Theme.wing ? self.height / 2 : self.radius;
        x: root.cell * root.current + self.inset;
        y: Theme.wing ? 0 : self.inset;
        width: root.cell - 2 * self.inset;
        height: root.height - 2 * self.y;
        border-top-left-radius: root.mirrored ? self.radius : self.sweep;
        border-top-right-radius: root.mirrored ? self.sweep : self.radius;
        border-bottom-right-radius: root.mirrored ? self.radius : self.sweep;
        border-bottom-left-radius: root.mirrored ? self.sweep : self.radius;
        background: Theme.cockpit ? Theme.fill-hover : Theme.accent;
        animate x {
            duration: 200ms;
            easing: ease-out;
        }
        if Theme.cockpit: Rectangle {
            x: 6px;
            y: parent.height - self.height - 3px;
            width: parent.width - 12px;
            height: 3px;
            background: Theme.accent-light;
        }
    }

    for option[index] in root.options: Text {
        x: root.cell * index;
        width: root.cell;
        text: option;
        color: index == root.current ? Theme.text : Theme.muted;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.picked(index);
            }
        }
    }
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

/// A reading, which the cockpit style shows as a data block with a rule on its left.
component Stat {
    in property <string> label;
    in property <string> value;
    in property <length> value-size: 18px;
    // Columns of equal width, so that a changing value doesn't move the next column.
    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    HorizontalLayout {
        spacing: 9px;
        if Theme.cockpit: Rectangle {
            width: 2px;
            background: Theme.line;
            Rectangle {
                y: 0;
                height: 12px;
                background: Theme.accent-light;
            }
        }
        VerticalLayout {
            spacing: 2px;
            Caption {
                text: root.label;
            }

            Text {
                text: root.value;
                color: Theme.text;
                font-size: root.value-size;
                font-weight: 600;
            }
        }
    }
}

/// An airliner seen from above, nose up.
component AircraftIcon inherits Image {
    source: @image-url("icons/aircraft.svg");
}

/// The route from the origin to the destination, and how far along the aircraft is.
component FlightCard inherits Panel {
    in property <FlightInfo> flight;
    in property <bool> kiosk;
    /// Smaller, for phones.
    in property <bool> small;
    /// Leaves out the light at arrival, for short windows.
    in property <bool> brief;
    property <length> code-size: root.small ? 26px : 32px;
    tear: divider.y;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: root.small ? 14px : 18px;
        spacing: root.small ? 8px : 10px;
        HorizontalLayout {
            Caption {
                text: root.flight.phase == Phase.boarding ? "Boarding" : root.flight.phase == Phase.arrived ? "Landed" : "In flight";
                color: Theme.accent-light;
            }

            Caption {
                horizontal-alignment: right;
                text: root.kiosk ? "Random flights" : "Your flight";
            }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                if Theme.ticket: Caption {
                    text: "From";
                }
                origin-code := Text {
                    text: root.flight.origin.code;
                    color: Theme.text;
                    font-size: root.code-size;
                    font-weight: 800;
                }

                Text {
                    text: root.flight.origin.city;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }
            }

            // The progress along the route: a scale in the cockpit style, and an arc like the
            // flight's in the wing style.
            Rectangle {
                horizontal-stretch: 1;
                min-width: 60px;
                property <length> line-y: origin-code.y + origin-code.height / 2;
                // The arc is a quadratic Bézier from (0, ends) over (w / 2, peak) to (w, ends).
                property <float> w: self.width / 1px;
                property <float> ends: self.line-y / 1px + 19;
                property <float> peak: self.line-y / 1px - 19;
                property <float> t: root.flight.progress;
                property <float> arc-y: (1 - self.t) * (1 - self.t) * self.ends + 2 * self.t * (1 - self.t) * self.peak + self.t * self.t * self.ends;
                if !Theme.wing: Rectangle {
                    y: parent.line-y - 1px;
                    height: 2px;
                    background: Theme.track;
                }
                for tick in (Theme.cockpit ? 11 : 0): Rectangle {
                    x: (parent.width - 1px) * tick / 10;
                    y: parent.line-y - self.height / 2;
                    width: 1px;
                    height: Math.mod(tick, 5) == 0 ? 14px : 8px;
                    background: Theme.track;
                }
                // The flown part, from the origin to the aircraft.
                if !Theme.wing: Rectangle {
                    x: 0;
                    y: parent.line-y - 1px;
                    width: aircraft-icon.x + aircraft-icon.width / 2;
                    height: 2px;
                    background: Theme.accent-light;
                }
                if Theme.wing: Path {
                    viewbox-width: parent.w;
                    viewbox-height: self.height / 1px;
                    commands: "M 0 \{parent.ends} Q \{parent.w / 2} \{parent.peak} \{parent.w} \{parent.ends}";
                    stroke: Theme.track;
                    stroke-width: 2px;
                }
                // The flown part, the arc split at the aircraft.
                if Theme.wing: Path {
                    viewbox-width: parent.w;
                    viewbox-height: self.height / 1px;
                    commands: "M 0 \{parent.ends} Q \{parent.w * parent.t / 2} \{parent.ends + parent.t * (parent.peak - parent.ends)} \{parent.w * parent.t} \{parent.arc-y}";
                    stroke: Theme.accent-light;
                    stroke-width: 2.5px;
                }
                for end in (Theme.wing ? 2 : 0): Rectangle {
                    x: end * parent.width - self.width / 2;
                    y: parent.ends * 1px - self.height / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: end == 0 ? Theme.accent-light : Theme.track;
                }
                aircraft-icon := AircraftIcon {
                    x: Theme.wing ? parent.w * parent.t * 1px - self.width / 2 : (parent.width - self.width) * root.flight.progress;
                    y: Theme.wing ? parent.arc-y * 1px - self.height / 2 : parent.line-y - self.height / 2;
                    width: 24px;
                    height: 24px;
                    transform-rotation: 90deg + (Theme.wing ? atan2(2 * (1 - 2 * parent.t) * (parent.peak - parent.ends), parent.w) : 0deg);
                }

                if Theme.cockpit: Path {
                    x: aircraft-icon.x + aircraft-icon.width / 2 - self.width / 2;
                    y: parent.line-y + 9px;
                    width: 10px;
                    height: 7px;
                    viewbox-width: 10;
                    viewbox-height: 7;
                    commands: "M 0 7 L 5 0 L 10 7 Z";
                    fill: Theme.accent-light;
                }
            }

            VerticalLayout {
                if Theme.ticket: Caption {
                    text: "To";
                    horizontal-alignment: right;
                }
                Text {
                    text: root.flight.destination.code;
                    color: Theme.text;
                    font-size: root.code-size;
                    font-weight: 800;
                    horizontal-alignment: right;
                }

                Text {
                    text: root.flight.destination.city;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        divider := Rectangle {
            height: 1px;
            background: Theme.ticket ? transparent : Theme.line;
        }

        HorizontalLayout {
            spacing: 16px;
            Stat {
                label: "Time to go";
                value: root.flight.remaining-time;
                value-size: root.small ? 16px : 18px;
            }

            Stat {
                label: "Distance to go";
                value: root.flight.remaining-distance;
                value-size: root.small ? 16px : 18px;
            }
        }

        if !root.brief: Text {
            text: root.flight.arrival-light;
            color: Theme.muted;
            font-size: 13px;
        }
        if Theme.ticket && !root.brief: Rectangle {
            height: 30px;
            for bar in 72: Rectangle {
                x: parent.width * bar / 72;
                width: Math.mod(bar * 7 + 3, 5) == 0 ? 3px : Math.mod(bar * 3, 4) == 0 ? 2px : 1px;
                visible: Math.mod(bar * 5, 7) != 0;
                background: Theme.text.with-alpha(0.75);
            }
        }
    }
}

/// The aircraft's readings in flight, or the flight before boarding and after landing.
/// The ticket style shows them on a luggage tag.
component StatusCard inherits Glass {
    in property <FlightInfo> flight;
    /// Smaller, for phones, with one row of readings.
    in property <bool> small;
    height: layout.preferred-height;
    border-top-right-radius: Theme.ticket ? min(self.height / 2, 34px) : self.radius;
    border-bottom-right-radius: Theme.ticket ? min(self.height / 2, 34px) : self.sweep;
    // The eyelet.
    if Theme.ticket: Rectangle {
        x: parent.width - self.width - 16px;
        width: 14px;
        height: 14px;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.muted;
        background: Theme.background;
    }
    layout := VerticalLayout {
        padding: root.small ? 14px : 18px;
        padding-right: Theme.ticket ? 46px : root.small ? 14px : 18px;
        spacing: 12px;
        if root.flight.phase == Phase.flying: GridLayout {
            spacing-horizontal: root.small ? 12px : 20px;
            spacing-vertical: 12px;
            Row {
                Stat {
                    label: "Ground speed";
                    value: root.flight.speed;
                    value-size: root.small ? 16px : 18px;
                }

                Stat {
                    label: "Altitude";
                    value: root.flight.altitude;
                    value-size: root.small ? 16px : 18px;
                }

                Stat {
                    label: "Outside air";
                    value: root.flight.temperature;
                    value-size: root.small ? 16px : 18px;
                }
            }

            if !root.small: Row {
                Stat {
                    label: "Heading";
                    value: root.flight.heading;
                }

                Stat {
                    label: "Flown";
                    value: root.flight.flown-distance;
                }

                Stat {
                    label: "Total";
                    value: root.flight.total-distance;
                }
            }
        }
        if root.flight.phase == Phase.boarding: VerticalLayout {
            spacing: 4px;
            Caption {
                text: "Next flight";
            }

            Text {
                text: "\{root.flight.origin.city} to \{root.flight.destination.city}";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                text: "\{root.flight.total-distance}  ·  \{root.flight.remaining-time}";
                color: Theme.muted;
                font-size: 14px;
            }
        }
        if root.flight.phase == Phase.arrived: VerticalLayout {
            spacing: 4px;
            Caption {
                text: "Welcome to";
            }

            Text {
                text: root.flight.destination.city;
                color: Theme.text;
                font-size: 28px;
                font-weight: 800;
                wrap: word-wrap;
            }

            Text {
                text: "\{root.flight.destination.name}, \{root.flight.destination.country}";
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
    }
}

/// An airport's dot and code: a diamond like a waypoint in the cockpit style, and a luggage tag
/// in the ticket style.
component AirportMarker {
    in property <Marker> marker;
    in property <bool> destination;
    property <length> tag-x: Theme.cockpit ? 18px : Theme.ticket ? 17px : 12px;
    property <color> tag-background: root.destination ? Theme.accent : Theme.surface.with-alpha(Theme.ticket ? 0.9 : 0.8);
    width: 0;
    height: 0;
    visible: root.marker.shown;
    Rectangle {
        property <length> radius: Theme.cockpit ? 0 : Theme.wing ? 1px : self.width / 2;
        property <length> sweep: Theme.wing ? self.width / 2 : self.radius;
        x: -self.width / 2;
        y: -self.height / 2;
        width: Theme.cockpit ? 11px : 12px;
        height: self.width;
        transform-rotation: Theme.cockpit ? 45deg : 0deg;
        border-top-left-radius: self.sweep;
        border-top-right-radius: self.radius;
        border-bottom-right-radius: self.sweep;
        border-bottom-left-radius: self.radius;
        background: root.destination ? Theme.accent-light : white;
        border-width: 2px;
        border-color: root.destination ? white : Theme.accent;
        drop-shadow-blur: 6px;
        drop-shadow-color: #0009;
    }

    // The leader line to the code.
    if Theme.cockpit: Rectangle {
        x: 6px;
        y: 0;
        width: root.tag-x - self.x;
        height: 1px;
        background: root.destination ? Theme.accent-light : white;
    }

    // The tag's pointed end.
    if Theme.ticket: Rectangle {
        x: root.tag-x - self.width / 2;
        y: -self.height / 2;
        width: 15.6px;
        height: 15.6px;
        transform-rotation: 45deg;
        border-radius: 2px;
        background: root.tag-background;
    }

    Rectangle {
        property <length> radius: Theme.ticket ? 3px : 2px;
        property <length> sweep: Theme.wing ? self.height / 2 : self.radius;
        x: root.tag-x;
        y: -self.height / 2;
        height: 22px;
        width: code.preferred-width + code.x + 8px;
        border-top-left-radius: Theme.ticket ? 0 : self.sweep;
        border-top-right-radius: self.radius;
        border-bottom-right-radius: self.sweep;
        border-bottom-left-radius: Theme.ticket ? 0 : self.radius;
        background: root.tag-background;
        border-width: Theme.ticket ? 0 : 1px;
        border-color: Theme.line;
        // The tag's eyelet.
        if Theme.ticket: Rectangle {
            x: 1px;
            width: 5px;
            height: 5px;
            border-radius: self.width / 2;
            background: Theme.background;
        }
        code := Text {
            x: Theme.ticket ? 10px : 8px;
            text: root.marker.code;
            color: white;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }

        if Theme.cockpit: Rectangle {
            x: 0;
            width: 2px;
            background: root.destination ? white : Theme.accent-light;
        }
    }
}

component AirportRow inherits Rectangle {
    in property <AirportItem> airport;
    callback clicked();
    property <length> radius: Theme.cockpit ? 2px : Theme.wing ? 3px : 4px;
    property <length> sweep: Theme.wing ? 16px : self.radius;
    height: 46px;
    border-top-left-radius: root.sweep;
    border-top-right-radius: root.radius;
    border-bottom-right-radius: root.sweep;
    border-bottom-left-radius: root.radius;
    background: touch.has-hover ? Theme.fill-hover : transparent;
    if Theme.cockpit && touch.has-hover: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent-light;
    }
    Text {
        x: 10px;
        width: 44px;
        text: root.airport.code;
        color: Theme.accent-light;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }

    VerticalLayout {
        x: 60px;
        width: parent.width - 70px;
        alignment: center;
        Text {
            text: "\{root.airport.city}, \{root.airport.country}";
            color: Theme.text;
            font-size: 14px;
            overflow: elide;
        }

        Text {
            text: root.airport.name;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A search field for an airport.
component AirportField inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in-out property <string> text <=> input.text;
    callback activated();
    callback edited(text: string);
    callback accepted();
    property <length> radius: Theme.cockpit ? 2px : 4px;
    property <length> sweep: Theme.wing ? 18px : self.radius;
    height: 50px;
    border-top-left-radius: root.sweep;
    border-top-right-radius: root.radius;
    border-bottom-right-radius: root.sweep;
    border-bottom-left-radius: root.radius;
    background: Theme.fill;
    border-width: 1px;
    border-color: root.active && !Theme.cockpit ? Theme.accent : Theme.line;
    forward-focus: input;
    if Theme.cockpit && root.active: Rectangle {
        x: 0;
        width: 3px;
        background: Theme.accent-light;
    }

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    Caption {
        x: 14px;
        text: root.label;
        vertical-alignment: center;
    }

    if input.text == "": Text {
        x: input.x;
        text: "City, airport, or code";
        color: Theme.faint;
        font-size: 16px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 64px;
        width: parent.width - 78px;
        color: Theme.text;
        font-size: 16px;
        vertical-alignment: center;
        changed has-focus => {
            if self.has-focus {
                root.activated();
            }
        }
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
    }
}

export component AppWindow inherits Window {
    in property <image> texture;
    in property <FlightInfo> flight;
    in property <Marker> origin-marker;
    in property <Marker> destination-marker;
    in property <Aircraft> aircraft;
    /// The route behind and ahead of the aircraft, as path commands in logical pixels.
    in property <string> flown-path;
    in property <string> remaining-path;
    in property <[Label]> labels;
    in property <View> view;
    /// The airports that match the planner's search.
    in property <[AirportItem]> results;
    in property <string> gpu-text;
    in property <string> fps-text;
    in property <Screen> screen;
    /// How far the globe has grown from its place on the entry screen to the window, from 0 to 1.
    in property <float> zoom-progress;
    // The globe's place on the entry screen: beside the planner, or above it on a phone held
    // upright.
    property <length> panel-width: min(400px, root.content-width * 0.42);
    out property <length> entry-globe-x: root.narrow ? 0 : root.left-edge + root.panel-width + 16px;
    out property <length> entry-globe-y: root.narrow ? root.top-edge : 0;
    out property <length> entry-globe-width: root.width - self.entry-globe-x;
    out property <length> entry-globe-height: root.narrow ? root.height * 0.36 : root.height;

    /// Whether the demo flies between random airports on its own.
    in-out property <bool> kiosk: true;
    /// The airports picked in the planner.
    in-out property <AirportItem> planned-origin;
    in-out property <AirportItem> planned-destination;
    in-out property <bool> sunlight: true;
    in-out property <bool> borders: true;
    in-out property <Quality> quality: Quality.high;
    /// Whether the quality drops while frames take too long.
    in-out property <bool> auto-quality: true;

    /// Restarts the time until the kiosk takes over again.
    callback interacted();
    callback drag-started();
    callback dragged(dx: float, dy: float);
    callback drag-ended();
    /// Zooms in for a `factor` above 1.
    callback zoom(factor: float);
    /// Turns the view by `degrees` clockwise, as two fingers twist.
    callback twisted(degrees: float);
    callback choose-view(view: View);
    callback search(query: string);
    /// Starts the planned flight.
    callback take-off();
    /// Shrinks the globe of the flight back into its place on the entry screen.
    callback show-planner();
    callback planned-changed();
    callback settings-changed();

    property <bool> settings-open;
    /// How far the flight's panels have slid in, from 0 to 1.
    property <float> flight-in: root.screen == Screen.flight ? 1 : 0;
    animate flight-in {
        duration: 350ms;
        easing: spring;
    }
    property <bool> started;
    /// How far the planner has slid in on startup, from 0 to 1.
    property <float> planner-in: root.started ? 1 : 0;
    animate planner-in {
        duration: 350ms;
        easing: spring;
    }
    /// Where the controls rest at the bottom.
    property <length> controls-y: root.height - controls.height - root.bottom-edge - (root.narrow ? 0 : 14px);
    /// Whether the globe shows a route: during a flight, or once the planner has one.
    property <bool> route-shown: root.screen != Screen.entry || (root.planned-origin.index >= 0 && root.planned-destination.index >= 0);
    /// Which of the planner's fields the search results are for: 0 for the origin, 1 for
    /// the destination.
    property <int> active-field: 1;
    /// A phone held upright.
    property <bool> narrow: root.width < 600px;
    /// A phone held sideways.
    property <bool> short: root.height < 500px;
    property <bool> compact: root.width < 900px || root.height < 620px;
    property <length> margin: root.narrow || root.short ? 10px : Theme.margin;
    // The edges of the area for controls, clear of a phone's notch and home indicator.
    property <length> left-edge: root.safe-area-insets.left + root.margin;
    property <length> right-edge: root.safe-area-insets.right + root.margin;
    property <length> top-edge: root.safe-area-insets.top + root.margin;
    property <length> bottom-edge: root.safe-area-insets.bottom + root.margin;
    property <length> content-width: root.width - root.left-edge - root.right-edge;

    title: "Slint Flight Tracker";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 320px;
    background: black;

    changed sunlight => {
        root.settings-changed();
    }
    changed borders => {
        root.settings-changed();
    }
    changed quality => {
        Theme.quality = root.quality;
        root.settings-changed();
    }
    init => {
        Theme.quality = root.quality;
    }
    changed kiosk => {
        root.settings-changed();
    }
    /// Shows a flight that the kiosk proposes in the planner.
    public function propose(origin: AirportItem, destination: AirportItem) {
        root.planned-origin = origin;
        root.planned-destination = destination;
        from-field.text = origin.index >= 0 ? "\{origin.code}  ·  \{origin.city}" : "";
        to-field.text = destination.index >= 0 ? "\{destination.code}  ·  \{destination.city}" : "";
        root.active-field = 1;
    }

    function choose(airport: AirportItem) {
        if root.active-field == 0 {
            root.planned-origin = airport;
            from-field.text = "\{airport.code}  ·  \{airport.city}";
            to-field.focus();
        } else {
            root.planned-destination = airport;
            to-field.text = "\{airport.code}  ·  \{airport.city}";
        }
        root.planned-changed();
    }

    // A pattern under the globe on the entry screen, which shows through around it.
    if root.zoom-progress < 1: Rectangle {
        background: Theme.background;
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("icons/pattern.svg");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            colorize: Theme.accent-light;
        }

        Rectangle {
            x: root.entry-globe-x;
            y: root.entry-globe-y;
            width: root.entry-globe-width;
            height: root.entry-globe-height;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.25) 0%, Theme.accent.with-alpha(0.06) 45%, Theme.background.with-alpha(0) 70%);
        }

        // The globe's shadow on the pattern, so that the globe floats above it.
        Rectangle {
            property <length> globe-size: min(root.entry-globe-width, root.entry-globe-height) * 0.84;
            width: self.globe-size * 1.15;
            height: self.width;
            x: root.entry-globe-x + (root.entry-globe-width - self.width) / 2;
            y: root.entry-globe-y + (root.entry-globe-height - self.height) / 2 + self.globe-size * 0.05;
            background: @radial-gradient(circle, #000000d0 0%, #000000d0 48%, #00000060 60%, #00000000 72%);
        }
    }

    ScaleRotateGestureHandler {
        x: globe-view.x;
        y: globe-view.y;
        width: globe-view.width;
        height: globe-view.height;
        enabled: root.screen != Screen.zoom;
        property <float> last-scale: 1;
        property <angle> last-rotation;
        started => {
            self.last-scale = 1;
            self.last-rotation = 0deg;
        }
        updated => {
            root.zoom(self.scale / self.last-scale);
            self.last-scale = self.scale;
            root.twisted((self.rotation - self.last-rotation) / 1deg);
            self.last-rotation = self.rotation;
        }

        TouchArea {
            enabled: root.screen != Screen.zoom;
            property <length> last-x;
            property <length> last-y;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                    root.settings-open = false;
                    root.drag-started();
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.drag-ended();
                }
            }
            moved => {
                // In the frame's pixels, which the entry screen shows smaller.
                root.dragged((self.mouse-x - self.last-x) / frame.scale / 1px, (self.mouse-y - self.last-y) / frame.scale / 1px);
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
            double-clicked => {
                root.zoom(1.6);
            }
            scroll-event(event) => {
                root.zoom(Math.pow(1.0015, event.delta-y / 1px));
                accept
            }
        }
    }

    // The globe, in its place on the entry screen, or growing from there to the window. It shows
    // the middle of a frame rendered for the whole window, so it looks the same at any size.
    globe-view := Rectangle {
        property <float> grown: root.zoom-progress;
        x: root.entry-globe-x * (1 - self.grown);
        y: root.entry-globe-y * (1 - self.grown);
        width: root.entry-globe-width + (root.width - root.entry-globe-width) * self.grown;
        height: root.entry-globe-height + (root.height - root.entry-globe-height) * self.grown;
        clip: true;
        frame := Rectangle {
            property <float> scale: max(parent.width / root.width, parent.height / root.height);
            x: (parent.width - root.width * self.scale) / 2;
            y: (parent.height - root.height * self.scale) / 2;
            width: root.width;
            height: root.height;
            transform-scale: self.scale;
            transform-origin: { x: 0, y: 0 };
            Image {
                source: root.texture;
                width: 100%;
                height: 100%;
                image-fit: fill;
            }

            Path {
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: root.remaining-path;
                stroke: #ffffffa0;
                stroke-width: 2px / frame.scale;
                visible: root.remaining-path != "" && root.route-shown;
            }

            Path {
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: root.flown-path;
                stroke: Theme.accent-light.with-alpha(0.3);
                stroke-width: 7px / frame.scale;
                visible: root.flown-path != "" && root.route-shown;
            }

            Path {
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: root.flown-path;
                stroke: Theme.accent-light;
                stroke-width: 2.5px / frame.scale;
                visible: root.flown-path != "" && root.route-shown;
            }

            if root.screen != Screen.entry || root.planned-origin.index >= 0: AirportMarker {
                x: root.origin-marker.x * 1px;
                y: root.origin-marker.y * 1px;
                marker: root.origin-marker;
                transform-scale: 1 / frame.scale;
            }

            if root.route-shown: AirportMarker {
                x: root.destination-marker.x * 1px;
                y: root.destination-marker.y * 1px;
                marker: root.destination-marker;
                destination: true;
                transform-scale: 1 / frame.scale;
            }

            Rectangle {
                opacity: root.screen == Screen.flight ? 1 : 0;
                animate opacity { duration: 200ms; }
            for label in root.labels: Rectangle {
                x: label.x * 1px;
                y: label.y * 1px;
                width: 0;
                height: 0;
                opacity: label.opacity;
                Rectangle {
                    x: -2px;
                    y: -2px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffffb0;
                }

                Text {
                    x: 6px;
                    y: -self.height / 2;
                    text: label.name;
                    color: Theme.text.with-alpha(0.8);
                    font-size: 11px;
                    stroke: #00000080;
                    stroke-width: 2px;
                }
            }

            if root.aircraft.shown: Rectangle {
                x: root.aircraft.x * 1px - self.width / 2;
                y: root.aircraft.y * 1px - self.height / 2;
                width: 34px;
                height: 34px;
                transform-rotation: root.aircraft.angle * 1deg;
                // The shadow on the ground.
                AircraftIcon {
                    x: 3px;
                    y: 4px;
                    width: 100%;
                    height: 100%;
                    colorize: #00000070;
                }

                AircraftIcon {
                    width: 100%;
                    height: 100%;
                }
            }

            }
        }
    }

    // A change in `init` wouldn't animate, as the panel hasn't been laid out yet.
    Timer {
        interval: 500ms;
        running: !root.started;
        triggered => {
            root.started = true;
        }
    }

    // The planner, beside the globe, or below it on a phone held upright. It stays instantiated,
    // so its fields keep their text during a flight.
    Panel {
        property <length> rest-y: root.narrow ? root.entry-globe-y + root.entry-globe-height + 8px : root.top-edge;
        visible: root.zoom-progress < 1;
        property <float> away: 1 - root.planner-in + root.zoom-progress;
        x: root.narrow ? root.left-edge : root.left-edge - self.away * (self.width + root.left-edge + 30px);
        y: root.narrow ? self.rest-y + self.away * (root.height - self.rest-y + 30px) : self.rest-y;
        width: root.narrow ? root.content-width : root.panel-width;
        height: root.height - self.rest-y - root.bottom-edge;
        tear: header.y + header.height + 6px;
        VerticalLayout {
            padding: root.narrow ? 14px : 20px;
            spacing: 12px;
            header := HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: "Where to?";
                        color: Theme.text;
                        font-size: root.narrow ? 22px : 28px;
                        font-weight: 800;
                    }

                    Text {
                        text: root.kiosk ? "Random flights, or pick your own" : "Pick the airports, then take off";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }

                PillButton {
                    y: (parent.height - self.height) / 2;
                    text: "Take off";
                    icon: @image-url("icons/aircraft.svg");
                    primary: true;
                    enabled: root.planned-origin.index >= 0 && root.planned-destination.index >= 0 && root.planned-origin.index != root.planned-destination.index;
                    clicked => {
                        root.take-off();
                    }
                }
            }

            from-field := AirportField {
                label: "From";
                active: root.active-field == 0;
                activated => {
                    root.active-field = 0;
                    root.search(self.text == "\{root.planned-origin.code}  ·  \{root.planned-origin.city}" ? "" : self.text);
                }
                edited(text) => {
                    root.planned-origin.index = -1;
                    root.search(text);
                    root.planned-changed();
                }
                accepted => {
                    if root.results.length > 0 {
                        root.choose(root.results[0]);
                    }
                }
            }

            to-field := AirportField {
                label: "To";
                active: root.active-field == 1;
                activated => {
                    root.active-field = 1;
                    root.search(self.text == "\{root.planned-destination.code}  ·  \{root.planned-destination.city}" ? "" : self.text);
                }
                edited(text) => {
                    root.planned-destination.index = -1;
                    root.search(text);
                    root.planned-changed();
                }
                accepted => {
                    if root.results.length > 0 {
                        root.choose(root.results[0]);
                    }
                }
            }

            Caption {
                text: root.results.length == 1 ? "1 airport" : "\{root.results.length} airports";
            }

            ListView {
                vertical-stretch: 1;
                for airport in root.results: AirportRow {
                    airport: airport;
                    clicked => {
                        root.choose(airport);
                    }
                }
            }
        }
    }

    flight-card := FlightCard {
        visible: root.flight-in > 0;
        x: root.left-edge;
        y: root.top-edge - (1 - root.flight-in) * (self.height + root.top-edge + 30px);
        width: root.narrow ? root.content-width : min(420px, root.content-width - 56px);
        flight: root.flight;
        kiosk: root.kiosk;
        small: root.narrow || root.short;
        brief: root.short;
    }

    if root.narrow || !root.compact || root.flight.phase != Phase.flying: StatusCard {
        visible: root.flight-in > 0;
        x: root.left-edge;
        y: (root.narrow ? root.controls-y - self.height - 10px : root.height - self.height - root.bottom-edge - 14px)
            + (1 - root.flight-in) * (root.height - root.controls-y + self.height + 30px);
        width: root.narrow ? root.content-width : min(420px, root.content-width);
        flight: root.flight;
        small: root.narrow || root.short;
    }

    // Below the flight card on a phone held upright, where it takes the whole width.
    // In the cockpit style, the zoom buttons are keys in one strip.
    if Theme.cockpit: Glass {
        visible: zoom-buttons.visible;
        x: zoom-buttons.x;
        y: zoom-buttons.y;
        width: zoom-buttons.width;
        height: zoom-buttons.height;
        bracket: 6px;
    }

    zoom-buttons := VerticalLayout {
        visible: root.flight-in > 0;
        x: root.width - self.width - root.right-edge + (1 - root.flight-in) * (self.width + root.right-edge + 30px);
        y: root.narrow ? root.top-edge + flight-card.height + 10px : root.top-edge;
        width: 40px;
        height: self.preferred-height;
        spacing: Theme.cockpit ? 0 : 8px;
        RoundButton {
            text: "+";
            mirrored: true;
            background: Theme.cockpit ? transparent : Theme.glass;
            border-width: Theme.cockpit ? 0 : 1px;
            clicked => {
                root.zoom(1.5);
            }
        }

        if Theme.cockpit: Rectangle {
            height: 1px;
            Rectangle {
                x: 8px;
                width: parent.width - 16px;
                background: Theme.line;
            }
        }
        RoundButton {
            text: "−";
            mirrored: true;
            background: Theme.cockpit ? transparent : Theme.glass;
            border-width: Theme.cockpit ? 0 : 1px;
            clicked => {
                root.zoom(1 / 1.5);
            }
        }
    }

    // The views, the planner, and the settings. In the cockpit style, they're keys of their own.
    controls := Glass {
        visible: root.flight-in > 0;
        x: root.width - self.width - root.right-edge;
        y: root.controls-y + (1 - root.flight-in) * (root.height - root.controls-y + 30px);
        width: root.narrow ? root.content-width : bar.preferred-width;
        height: bar.preferred-height;
        mirrored: true;
        radius: 6px;
        sweep: Theme.wing ? self.height / 2 : self.radius;
        bracket: 0;
        background: Theme.cockpit ? transparent : Theme.glass;
        backdrop-blur: Theme.blur && !Theme.cockpit ? 20px : 0px;
        border-width: Theme.cockpit ? 0 : 1px;
        bar := HorizontalLayout {
            padding: Theme.cockpit ? 0 : 6px;
            spacing: Theme.cockpit ? 6px : 8px;
            for index in (Theme.cockpit ? 3 : 0): Key {
                property <View> view: index == 0 ? View.follow : index == 1 ? View.route : View.globe;
                text: index == 0 ? "Follow" : index == 1 ? "Route" : "Globe";
                checked: root.view == self.view;
                clicked => {
                    root.choose-view(self.view);
                }
            }
            if !Theme.cockpit: Segmented {
                preferred-width: 240px;
                min-width: 150px;
                horizontal-stretch: 1;
                mirrored: true;
                options: ["Follow", "Route", "Globe"];
                current: root.view == View.follow ? 0 : root.view == View.route ? 1 : root.view == View.globe ? 2 : -1;
                picked(index) => {
                    root.choose-view(index == 0 ? View.follow : index == 1 ? View.route : View.globe);
                }
            }
            if Theme.cockpit: Key {
                text: root.narrow ? "" : "Plan a flight";
                icon: @image-url("icons/aircraft.svg");
                icon-rotation: 90deg;
                primary: true;
                horizontal-stretch: root.narrow ? 1 : 0;
                clicked => {
                    root.settings-open = false;
                    root.show-planner();
                }
            }
            if !Theme.cockpit: PillButton {
                text: root.narrow ? "" : "Plan a flight";
                icon: @image-url("icons/aircraft.svg");
                primary: true;
                mirrored: true;
                clicked => {
                    root.settings-open = false;
                    root.show-planner();
                }
            }
            if Theme.cockpit: Key {
                width: 44px;
                horizontal-stretch: 0;
                icon: @image-url("icons/settings.svg");
                checked: root.settings-open;
                clicked => {
                    root.settings-open = !root.settings-open;
                    root.interacted();
                }
            }
            if !Theme.cockpit: RoundButton {
                width: 36px;
                height: 36px;
                mirrored: true;
                icon: @image-url("icons/settings.svg");
                checked: root.settings-open;
                clicked => {
                    root.settings-open = !root.settings-open;
                    root.interacted();
                }
            }
        }
    }

    if root.settings-open && root.screen == Screen.flight: Panel {
        x: root.width - self.width - root.right-edge;
        y: controls.y - self.height - 10px;
        width: min(260px, root.content-width);
        height: settings.preferred-height;
        mirrored: true;
        tear: quality.y + quality.height + 10px;
        settings := VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Caption {
                text: "Quality";
            }

            quality := Segmented {
                mirrored: true;
                options: ["Auto", "Low", "Medium", "High"];
                current: root.auto-quality ? 0 : root.quality == Quality.low ? 1 : root.quality == Quality.medium ? 2 : 3;
                picked(index) => {
                    root.auto-quality = index == 0;
                    root.quality = index == 1 ? Quality.low : index == 2 ? Quality.medium : Quality.high;
                    root.interacted();
                }
            }

            // Room for the tear.
            if Theme.ticket: Rectangle {
                height: 8px;
            }
            Toggle {
                text: "Random flights";
                mirrored: true;
                checked <=> root.kiosk;
                toggled => {
                    root.interacted();
                }
            }

            Toggle {
                text: "Borders";
                mirrored: true;
                checked <=> root.borders;
                toggled => {
                    root.interacted();
                }
            }

            Toggle {
                text: "Sunlight";
                mirrored: true;
                checked <=> root.sunlight;
                toggled => {
                    root.interacted();
                }
            }
        }
    }

    // The switch between the styles: at the bottom right of the entry screen's globe, and beside
    // the zoom buttons during a flight.
    if root.screen != Screen.zoom: Glass {
        x: root.screen == Screen.entry
            ? root.width - self.width - root.right-edge
            : zoom-buttons.x - self.width - 10px;
        y: root.screen == Screen.entry
            ? root.entry-globe-y + root.entry-globe-height - self.height - (root.narrow ? 8px : root.bottom-edge + 14px)
            : zoom-buttons.y;
        width: style-bar.preferred-width;
        height: style-bar.preferred-height;
        mirrored: true;
        radius: 6px;
        sweep: Theme.wing ? self.height / 2 : self.radius;
        bracket: 8px;
        style-bar := HorizontalLayout {
            padding: 6px;
            Segmented {
                width: 216px;
                mirrored: true;
                options: ["Cockpit", "Wing", "Ticket"];
                current: Theme.cockpit ? 0 : Theme.wing ? 1 : 2;
                picked(index) => {
                    Theme.style = index == 0 ? Style.cockpit : index == 1 ? Style.wing : Style.ticket;
                    root.interacted();
                }
            }
        }
    }

    if !root.narrow: Text {
        x: root.width - self.width - root.right-edge;
        y: root.height - self.height - root.safe-area-insets.bottom - 4px;
        text: "\{root.gpu-text}  ·  \{root.fps-text}";
        color: Theme.faint;
        font-size: 10px;
    }
}
