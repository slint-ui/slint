import { ListView } from "std-widgets.slint";
import "fonts/JetBrainsMonoNL-Bold.ttf";

/// How much the demo spends on its looks, see `adaptive.rs`.
export enum Quality { low, medium, high }

global Theme {
    /// The panels blur the globe behind them in high quality,
    /// and are flat and more opaque otherwise.
    in-out property <Quality> quality: Quality.high;
    out property <bool> blur: self.quality == Quality.high;
    out property <color> text: #f4efe3;
    out property <color> muted: #98a2b6;
    /// Placeholders and the frame rate, dimmer than `muted`.
    out property <color> faint: #f4efe350;
    /// Silver, for text, lines, and markers.
    out property <color> accent: #c3cad6;
    out property <color> accent-light: #dfe4ec;
    /// The one color of the UI, for what's selected, the primary action, and the route flown.
    out property <color> highlight: #6cb4ff;
    /// Surfaces in the highlight color, such as the primary button, lit softly from above.
    out property <brush> highlight-fill: @linear-gradient(180deg, #8ac4ff 0%, #559ff2 100%);
    /// Text and icons on the highlight color.
    out property <color> on-highlight: #06142b;
    /// The upper and lower halves of a flap, and of a lit one.
    out property <color> flap-upper: #1d2a44;
    out property <color> flap-lower: #121c30;
    out property <brush> lit-upper: @linear-gradient(180deg, #8ac4ff 0%, #74b6fb 100%);
    out property <brush> lit-lower: @linear-gradient(180deg, #62a9f5 0%, #559ff2 100%);
    /// Behind the globe on the entry screen.
    out property <color> background: #040915;
    out property <color> surface: #0b1528;
    out property <color> glass: self.surface.with-alpha(self.blur ? 0.86 : 0.95);
    out property <color> line: #c3cad630;
    /// A tint over the glass for buttons and fields, and its hover and pressed states.
    out property <color> fill: #ffffff0d;
    out property <color> fill-hover: #ffffff1f;
    out property <color> fill-pressed: #ffffff2a;
    /// The tiles of the route still ahead.
    out property <color> track: #ffffff22;
    out property <length> margin: 16px;
}

export enum View { follow, route, globe, free }

export enum Phase { boarding, flying, arrived }

/// What the window shows: the entry screen,
/// the globe growing from its place there to the window or shrinking back, or a flight.
export enum Screen { entry, zoom, flight }

export struct AirportItem {
    /// -1 for none.
    index: int = -1,
    code: string,
    city: string,
    country: string,
    name: string,
}

export struct FlightInfo {
    phase: Phase,
    /// The flight number, with Slint as the airline.
    number: string,
    origin: AirportItem,
    destination: AirportItem,
    /// The flown part of the distance, from 0 to 1.
    progress: float,
    remaining-time: string,
    /// The remaining time as hours and minutes, such as "9:05".
    remaining-clock: string,
    remaining-distance: string,
    flown-distance: string,
    total-distance: string,
    speed: string,
    altitude: string,
    temperature: string,
    /// The heading in degrees, such as "252°", and as a compass point, such as "WSW".
    heading: string,
    heading-compass: string,
    arrival-light: string,
}

/// An airport's place on the screen, in logical pixels.
export struct Marker {
    shown: bool,
    x: float,
    y: float,
    code: string,
}

export struct Aircraft {
    shown: bool,
    x: float,
    y: float,
    /// Clockwise from pointing up.
    angle: float,
}

export struct Label {
    x: float,
    y: float,
    name: string,
    opacity: float,
}

/// The "#MadeWithSlint" badge, at the size of its height.
component MadeWithSlint inherits Image {
    source: @image-url("icons/MadeWithSlint-logo-light.svg");
    width: self.height * 212 / 97;
    accessible-label: "#MadeWithSlint";
}

/// A panel of the board's housing.
component Glass inherits Rectangle {
    background: Theme.glass;
    backdrop-blur: Theme.blur ? 20px : 0px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.line;
    // The rivets.
    for corner in (root.width > 80px ? 4 : 0): Rectangle {
        x: Math.mod(corner, 2) == 0 ? 6px : root.width - self.width - 6px;
        y: corner < 2 ? 6px : root.height - self.height - 6px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff30;
    }
}

/// The characters of a string, which Slint can't slice.
export global Characters {
    /// The character at `index` of `text`, counted like `character-count`,
    /// or an empty string before its start or past its end.
    pure callback at(text: string, index: int) -> string;
}

/// One half of a `Flap`.
component FlapHalf inherits Rectangle {
    in property <string> text;
    /// The lower half, or else the upper one.
    in property <bool> lower;
    in property <length> flap-height;
    in property <length> size;
    in property <color> ink;
    border-top-left-radius: root.lower ? 0 : 2px;
    border-top-right-radius: root.lower ? 0 : 2px;
    border-bottom-left-radius: root.lower ? 2px : 0;
    border-bottom-right-radius: root.lower ? 2px : 0;
    // FemtoVG renders a clip with rounded corners through a layer, so the half of the character
    // is clipped by a rectangle without.
    Rectangle {
        clip: true;
        Text {
            y: root.lower ? -root.flap-height / 2 : 0;
            width: 100%;
            height: root.flap-height;
            text: root.text;
            color: root.ink;
            font-family: "JetBrains Mono NL";
            font-size: root.size;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// One flap of `Flaps`, which flips when its text changes.
component Flap {
    in property <string> text;
    /// How long the flap shows a text before it flips to a newer one.
    in property <duration> hold;
    in property <duration> flip-duration;
    in property <length> size;
    in property <color> ink;
    in property <brush> upper;
    in property <brush> lower;
    property <string> shown;
    property <string> previous;
    property <int> flips;
    property <float> turn: self.flips;
    animate turn { duration: root.flip-duration; }
    /// How far the flap has turned from `previous` to `shown`, from 0 to 1.
    property <float> t: self.turn == self.flips ? 1 : self.turn - Math.floor(self.turn);
    init => {
        self.shown = self.text;
        self.previous = self.text;
    }

    Timer {
        interval: root.hold;
        running: root.shown != root.text && root.t >= 1;
        triggered => {
            root.previous = root.shown;
            root.shown = root.text;
            root.flips += 1;
        }
    }

    FlapHalf {
        y: 0;
        height: root.height / 2;
        background: root.upper;
        text: root.shown;
        flap-height: root.height;
        size: root.size;
        ink: root.ink;
    }

    FlapHalf {
        y: root.height / 2;
        height: root.height / 2;
        lower: true;
        background: root.lower;
        text: root.t < 0.5 ? root.previous : root.shown;
        flap-height: root.height;
        size: root.size;
        ink: root.ink;
    }

    // The upper half of the old character, falling about the hinge.
    if root.t < 0.5: FlapHalf {
        y: 0;
        height: root.height / 2;
        background: root.upper;
        text: root.previous;
        flap-height: root.height;
        size: root.size;
        ink: root.ink;
        transform-origin: { x: 0, y: self.height };
        transform-scale-y: (1 - 2 * root.t) * 100%;
    }
    // The lower half of the new character, falling into place.
    if root.t >= 0.5 && root.t < 1: FlapHalf {
        y: root.height / 2;
        height: root.height / 2;
        lower: true;
        background: root.lower;
        text: root.shown;
        flap-height: root.height;
        size: root.size;
        ink: root.ink;
        transform-origin: { x: 0, y: 0 };
        transform-scale-y: (2 * root.t - 1) * 100%;
    }
    // The hinge.
    Rectangle {
        y: (root.height - self.height) / 2;
        height: 1px;
        // Fainter through small characters, which it would otherwise cut in half.
        background: root.size < 16px ? #00000070 : #000000c0;
    }
}

/// Text on a split-flap display, as on an airport's departures board.
/// Each character has a flap of its own, which flips when that character changes.
component Flaps {
    in property <string> text;
    in property <length> size: 16px;
    in property <color> color: Theme.text;
    /// Shows all of the text on one flap.
    in property <bool> whole;
    /// On a flap in the highlight color, like a sign.
    in property <bool> lit;
    /// How long the flaps show a text before they flip to a newer one.
    in property <duration> hold: 50ms;
    /// How long all of the flaps take to flip,
    /// from the first one starting to the last one finishing.
    in property <duration> flip: 520ms;
    /// The least number of flaps.
    /// Shorter text is aligned to the right, after blank flaps,
    /// so that a number's digits keep their flaps as it grows or shrinks.
    in property <int> places;
    property <int> length: self.text.character-count;
    property <int> count: self.whole ? 1 : max(1, max(self.places, self.length));
    // When all of the flaps flip, each one starts a little after the one on its left.
    property <duration> flip-duration: self.flip / (1 + (self.count - 1) * 0.15);
    property <length> gap: max(3px, self.size * 0.2);
    // The font is monospaced, so every character advances by the same width.
    property <length> flap-width: self.whole ? measure.preferred-width + 2 * self.gap : measure.preferred-width + self.gap;
    width: self.count * (self.flap-width + 2px) - 2px;
    height: self.size * 1.42;

    measure := Text {
        visible: false;
        text: root.whole ? root.text : "0";
        font-family: "JetBrains Mono NL";
        font-size: root.size;
        font-weight: 700;
    }

    for index in root.count: Flap {
        x: index * (root.flap-width + 2px);
        width: root.flap-width;
        height: root.height;
        text: root.whole ? root.text : Characters.at(root.text, index - (root.count - root.length));
        hold: root.hold + index * root.flip-duration * 0.15;
        flip-duration: root.flip-duration;
        size: root.size;
        ink: root.lit ? Theme.on-highlight : root.color;
        upper: root.lit ? Theme.lit-upper : Theme.flap-upper;
        lower: root.lit ? Theme.lit-lower : Theme.flap-lower;
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    /// An icon before the text, in the text's color.
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    property <color> ink: root.primary ? Theme.on-highlight : Theme.text;
    height: 36px;
    min-width: content.preferred-width + 28px;
    border-radius: 3px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.primary
        ? (touch.pressed ? Theme.highlight-fill.darker(0.2) : touch.has-hover ? Theme.highlight-fill.brighter(0.1) : Theme.highlight-fill)
        : (touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : Theme.fill);
    content := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon.width > 0: Image {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: root.icon;
            colorize: root.ink;
            transform-rotation: 90deg;
        }
        if root.text != "": Text {
            text: root.text.to-uppercase();
            color: root.ink;
            font-family: "JetBrains Mono NL";
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component RoundButton inherits Glass {
    in property <string> text;
    /// An icon instead of the text, in the text's color.
    in property <image> icon;
    in property <bool> checked;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 3px;
    background: root.checked ? Theme.highlight-fill : Theme.glass;
    Rectangle {
        border-radius: root.border-radius;
        background: touch.pressed ? Theme.fill-pressed : touch.has-hover ? Theme.fill-hover : transparent;
    }

    if root.icon.width == 0: Text {
        text: root.text;
        color: Theme.text;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width > 0: Image {
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.checked ? Theme.on-highlight : Theme.text;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Toggle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    height: 32px;
    Text {
        x: 0;
        text: root.text;
        color: Theme.text;
        font-size: 14px;
        vertical-alignment: center;
    }

    Flaps {
        x: parent.width - self.width;
        text: root.checked ? "ON" : "OFF";
        size: 13px;
        whole: true;
        color: root.checked ? Theme.highlight : Theme.muted;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

/// Options side by side, each on a flap; none is lit while `current` is -1.
component Segmented {
    in property <[string]> options;
    in property <int> current;
    callback picked(index: int);
    height: 36px;
    for option[index] in root.options: Rectangle {
        x: root.width / root.options.length * index;
        width: root.width / root.options.length;
        Flaps {
            text: option.to-uppercase();
            size: 12px;
            whole: true;
            lit: index == root.current;
            color: Theme.muted;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.picked(index);
            }
        }
    }
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

component Stat {
    in property <string> label;
    in property <string> value;
    /// After the value, smaller.
    in property <string> unit;
    /// The number of flaps, see `Flaps.places`.
    in property <int> places;
    in property <length> value-size: 18px;
    // Columns of equal width, so that a changing value doesn't move the next column.
    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    VerticalLayout {
        spacing: 2px;
        Caption {
            text: root.label;
        }

        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Flaps {
                text: root.value;
                size: root.value-size * 0.8;
                places: root.places;
                // The readings change all the time. A quick flip and a rest between flips keep
                // their digits readable.
                flip: 400ms;
                hold: 350ms;
            }

            // On the baseline of the digits, which are centered on their flaps: a smaller font
            // centered there sits a little high.
            if root.unit != "": Rectangle {
                width: unit.preferred-width;
                unit := Text {
                    y: root.value-size * 0.04;
                    height: parent.height;
                    vertical-alignment: center;
                    text: root.unit;
                    color: Theme.muted;
                    font-size: root.value-size * 0.68;
                }
            }
        }
    }
}

/// An airliner seen from above, nose up.
component AircraftIcon inherits Image {
    source: @image-url("icons/aircraft.svg");
}

/// The route from the origin to the destination, and how far along the aircraft is.
component FlightCard inherits Glass {
    in property <FlightInfo> flight;
    /// Smaller, for phones.
    in property <bool> small;
    /// Leaves out the light at arrival, for short windows.
    in property <bool> brief;
    property <length> code-size: root.small ? 26px : 32px;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: root.small ? 14px : 18px;
        spacing: root.small ? 8px : 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                origin-code := Flaps {
                    text: root.flight.origin.code;
                    size: root.code-size * 0.8;
                }

                Text {
                    text: root.flight.origin.city;
                    color: Theme.muted;
                    font-size: 13px;
                    overflow: elide;
                }
            }

            // The progress along the route, as tiles that light up.
            Rectangle {
                property <int> tiles: 14;
                property <length> tiles-y: origin-code.height / 2 + 6px;
                horizontal-stretch: 1;
                min-width: 60px;
                for tile in self.tiles: Rectangle {
                    x: (parent.width + 2px) * tile / parent.tiles;
                    y: parent.tiles-y;
                    width: (parent.width + 2px) / parent.tiles - 2px;
                    height: 10px;
                    border-radius: 1px;
                    background: tile < root.flight.progress * parent.tiles ? Theme.highlight : Theme.track;
                }

                AircraftIcon {
                    x: (parent.width - self.width) * root.flight.progress;
                    y: parent.tiles-y - self.height - 2px;
                    width: 22px;
                    height: 22px;
                    transform-rotation: 90deg;
                }
            }

            VerticalLayout {
                HorizontalLayout {
                    alignment: end;
                    Flaps {
                        text: root.flight.destination.code;
                        size: root.code-size * 0.8;
                    }
                }

                Text {
                    text: root.flight.destination.city;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            spacing: 16px;
            Stat {
                label: "Time to go";
                places: 5;
                unit: "h";
                value: root.flight.remaining-clock;
                value-size: root.small ? 16px : 18px;
            }

            Stat {
                label: "Distance to go";
                places: 6;
                unit: "km";
                value: root.flight.remaining-distance;
                value-size: root.small ? 16px : 18px;
            }
        }

        if !root.brief: HorizontalLayout {
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                text: root.flight.arrival-light;
                color: Theme.muted;
                font-size: 13px;
                overflow: elide;
            }

            Text {
                text: "Operated by Slint";
                color: Theme.muted;
                font-size: 13px;
            }
        }
    }
}

/// The aircraft's readings in flight, or the flight before boarding and after landing.
component StatusCard inherits Glass {
    in property <FlightInfo> flight;
    /// Smaller, for phones, with one row of readings.
    in property <bool> small;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: root.small ? 14px : 18px;
        spacing: 12px;
        if root.flight.phase == Phase.flying: GridLayout {
            spacing-horizontal: root.small ? 12px : 20px;
            spacing-vertical: 12px;
            Row {
                Stat {
                    label: "Ground speed";
                    places: 3;
                    unit: "km/h";
                    value: root.flight.speed;
                    value-size: root.small ? 16px : 18px;
                }

                Stat {
                    label: "Altitude";
                    places: 6;
                    unit: "m";
                    value: root.flight.altitude;
                    value-size: root.small ? 16px : 18px;
                }

                Stat {
                    label: "Outside air";
                    places: 3;
                    unit: "°C";
                    value: root.flight.temperature;
                    value-size: root.small ? 16px : 18px;
                }
            }

            if !root.small: Row {
                Stat {
                    label: "Heading";
                    places: 4;
                    unit: root.flight.heading-compass;
                    value: root.flight.heading;
                }

                Stat {
                    label: "Flown";
                    places: 6;
                    unit: "km";
                    value: root.flight.flown-distance;
                }

                Stat {
                    label: "Total";
                    places: 6;
                    unit: "km";
                    value: root.flight.total-distance;
                }
            }
        }
        if root.flight.phase == Phase.boarding: VerticalLayout {
            spacing: 4px;
            Caption {
                text: "Next flight \{root.flight.number}";
            }

            Text {
                text: "\{root.flight.origin.city} to \{root.flight.destination.city}";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                text: "\{root.flight.total-distance} km  ·  \{root.flight.remaining-time}";
                color: Theme.muted;
                font-size: 14px;
            }
        }
        if root.flight.phase == Phase.arrived: VerticalLayout {
            spacing: 4px;
            Caption {
                text: "Welcome to";
            }

            Text {
                text: root.flight.destination.city;
                color: Theme.text;
                font-size: 28px;
                font-weight: 800;
                wrap: word-wrap;
            }

            Text {
                text: "\{root.flight.destination.name}, \{root.flight.destination.country}";
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
    }
}

component AirportMarker {
    in property <Marker> marker;
    in property <bool> destination;
    width: 0;
    height: 0;
    visible: root.marker.shown;
    Rectangle {
        x: -self.width / 2;
        y: -self.height / 2;
        width: 10px;
        height: 10px;
        background: root.destination ? Theme.highlight : white;
        border-width: 2px;
        border-color: #111111;
        drop-shadow-blur: 6px;
        drop-shadow-color: #0009;
    }

    Flaps {
        x: 12px;
        y: -self.height / 2;
        text: root.marker.code;
        size: 12px;
        color: root.destination ? Theme.highlight : white;
    }
}

component AirportRow inherits Rectangle {
    in property <AirportItem> airport;
    /// The row's place in the list, for the stripes.
    in property <int> index;
    callback clicked();
    height: 46px;
    border-radius: 2px;
    background: touch.has-hover ? Theme.fill-hover : Math.mod(root.index, 2) == 1 ? #ffffff08 : transparent;
    Flaps {
        x: 8px;
        text: root.airport.code;
        size: 14px;
        color: Theme.accent;
    }

    VerticalLayout {
        x: 72px;
        width: parent.width - 82px;
        alignment: center;
        Text {
            text: "\{root.airport.city}, \{root.airport.country}".to-uppercase();
            font-family: "JetBrains Mono NL";
            color: Theme.text;
            font-size: 14px;
            overflow: elide;
        }

        Text {
            text: root.airport.name;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// A search field for an airport.
component AirportField inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in-out property <string> text <=> input.text;
    callback activated();
    callback edited(text: string);
    callback accepted();
    height: 50px;
    border-radius: 3px;
    background: Theme.fill;
    border-width: 1px;
    border-color: root.active ? Theme.highlight : Theme.line;
    forward-focus: input;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    Caption {
        x: 14px;
        text: root.label;
        vertical-alignment: center;
    }

    if input.text == "": Text {
        x: input.x;
        text: "City, airport, or code";
        color: Theme.faint;
        font-size: 16px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 64px;
        width: parent.width - 78px;
        color: Theme.text;
        font-size: 16px;
        vertical-alignment: center;
        changed has-focus => {
            if self.has-focus {
                root.activated();
            }
        }
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
    }
}

export component AppWindow inherits Window {
    in property <image> texture;
    /// The part of `texture` that the globe was rendered into, in pixels from the top left.
    in property <int> texture-used-width;
    in property <int> texture-used-height;
    in property <FlightInfo> flight;
    in property <Marker> origin-marker;
    in property <Marker> destination-marker;
    in property <Aircraft> aircraft;
    /// The route behind and ahead of the aircraft, as path commands in logical pixels.
    in property <string> flown-path;
    in property <string> remaining-path;
    in property <[Label]> labels;
    in property <View> view;
    /// The airports that match the planner's search.
    in property <[AirportItem]> results;
    in property <string> gpu-text;
    in property <string> fps-text;
    in property <Screen> screen;
    /// How far the globe has grown from its place on the entry screen to the window, from 0 to 1.
    in property <float> zoom-progress;
    /// How far the planner has slid away for a flight, from 0 to 1.
    in property <float> planner-away: 1;
    /// How much of its place the globe fills on the entry screen.
    in property <float> entry-fill;
    /// Whether the intro plays, which a click or tap skips.
    in property <bool> intro: true;
    /// How dark the intro still is as it fades in, from 1 to 0.
    in property <float> curtain: 1;
    callback skip-intro();
    /// Plays the intro again, and hands over to the random flights.
    callback restart();
    // The globe's place on the entry screen: beside the planner, or above it on a phone held
    // upright.
    property <length> panel-width: min(400px, root.content-width * 0.42);
    out property <length> entry-globe-x: root.narrow ? 0 : root.left-edge + root.panel-width + 16px;
    out property <length> entry-globe-y: root.narrow ? root.top-edge : 0;
    out property <length> entry-globe-width: root.width - self.entry-globe-x;
    out property <length> entry-globe-height: root.narrow ? root.height * 0.36 : root.height;

    /// Whether the demo flies between random airports on its own.
    in-out property <bool> kiosk: true;
    /// The airports picked in the planner.
    in-out property <AirportItem> planned-origin;
    in-out property <AirportItem> planned-destination;
    in-out property <bool> sunlight: true;
    in-out property <bool> borders: true;
    in-out property <bool> clouds: true;
    /// Whether the globe shows sharper imagery from the network while zoomed in.
    in-out property <bool> online-imagery: true;
    in property <bool> online-imagery-available: true;
    in-out property <Quality> quality <=> Theme.quality;
    /// Whether the quality drops while frames take too long.
    in-out property <bool> auto-quality: true;

    /// Restarts the time until the kiosk takes over again.
    callback interacted();
    callback drag-started();
    callback dragged(dx: float, dy: float);
    callback drag-ended();
    /// Zooms in for a `factor` above 1.
    callback zoom(factor: float);
    /// Turns the view by `degrees` clockwise, as two fingers twist.
    callback twisted(degrees: float);
    callback choose-view(view: View);
    callback search(query: string);
    /// Starts the planned flight.
    callback take-off();
    /// Shrinks the globe of the flight back into its place on the entry screen.
    callback show-planner();
    callback planned-changed();

    property <bool> settings-open;
    /// How far the flight's panels have slid in, from 0 to 1.
    property <float> flight-in: root.screen == Screen.flight ? 1 : 0;
    animate flight-in {
        duration: 350ms;
        easing: spring;
    }
    /// Where the controls rest at the bottom.
    property <length> controls-y: root.height - controls.height - root.bottom-edge - (root.narrow ? 0 : 14px);
    /// Whether the globe shows a route: during a flight, or once the planner has one.
    property <bool> route-shown: root.screen != Screen.entry || (root.planned-origin.index >= 0 && root.planned-destination.index >= 0);
    /// Which of the planner's fields the search results are for: 0 for the origin,
    /// 1 for the destination.
    property <int> active-field: 1;
    /// A phone held upright.
    property <bool> narrow: root.width < 600px;
    /// A phone held sideways.
    property <bool> short: root.height < 500px;
    property <bool> compact: root.width < 900px || root.height < 620px;
    property <length> margin: root.narrow || root.short ? 10px : Theme.margin;
    // The edges of the area for controls, clear of a phone's notch and home indicator.
    property <length> left-edge: root.safe-area-insets.left + root.margin;
    property <length> right-edge: root.safe-area-insets.right + root.margin;
    property <length> top-edge: root.safe-area-insets.top + root.margin;
    property <length> bottom-edge: root.safe-area-insets.bottom + root.margin;
    property <length> content-width: root.width - root.left-edge - root.right-edge;

    title: "Slint Flight Tracker";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 320px;
    background: black;

    changed screen => {
        root.settings-open = false;
    }
    pure function field-text(airport: AirportItem) -> string {
        "\{airport.code}  ·  \{airport.city}"
    }
    /// Shows a flight that the kiosk proposes in the planner.
    public function propose(origin: AirportItem, destination: AirportItem) {
        root.planned-origin = origin;
        root.planned-destination = destination;
        from-field.text = origin.index >= 0 ? root.field-text(origin) : "";
        to-field.text = destination.index >= 0 ? root.field-text(destination) : "";
        root.active-field = 1;
    }

    function choose(airport: AirportItem) {
        if root.active-field == 0 {
            root.planned-origin = airport;
            from-field.text = root.field-text(airport);
            to-field.focus();
        } else {
            root.planned-destination = airport;
            to-field.text = root.field-text(airport);
        }
        root.planned-changed();
    }

    // A pattern under the globe on the entry screen, which shows through around it.
    if root.zoom-progress < 1: Rectangle {
        background: Theme.background;
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("icons/pattern.svg");
            horizontal-tiling: repeat;
            vertical-tiling: repeat;
            colorize: Theme.accent-light;
        }

        Rectangle {
            x: root.entry-globe-x;
            y: root.entry-globe-y;
            width: root.entry-globe-width;
            height: root.entry-globe-height;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.25) 0%, Theme.accent.with-alpha(0.06) 45%, Theme.background.with-alpha(0) 70%);
        }

        // The globe's shadow on the pattern, so that the globe floats above it.
        Rectangle {
            property <length> globe-size: min(root.entry-globe-width, root.entry-globe-height) * root.entry-fill;
            width: self.globe-size * 1.15;
            height: self.width;
            x: root.entry-globe-x + (root.entry-globe-width - self.width) / 2;
            y: root.entry-globe-y + (root.entry-globe-height - self.height) / 2 + self.globe-size * 0.05;
            background: @radial-gradient(circle, #000000d0 0%, #000000d0 48%, #00000060 60%, #00000000 72%);
        }
    }

    ScaleRotateGestureHandler {
        // The globe's place, which grows from the entry screen's to the window.
        x: root.entry-globe-x * (1 - root.zoom-progress);
        y: root.entry-globe-y * (1 - root.zoom-progress);
        width: root.entry-globe-width + (root.width - root.entry-globe-width) * root.zoom-progress;
        height: root.entry-globe-height + (root.height - root.entry-globe-height) * root.zoom-progress;
        enabled: root.screen != Screen.zoom;
        property <float> last-scale: 1;
        property <angle> last-rotation;
        started => {
            self.last-scale = 1;
            self.last-rotation = 0deg;
        }
        updated => {
            root.zoom(self.scale / self.last-scale);
            self.last-scale = self.scale;
            root.twisted((self.rotation - self.last-rotation) / 1deg);
            self.last-rotation = self.rotation;
        }

        TouchArea {
            enabled: root.screen != Screen.zoom;
            property <length> last-x;
            property <length> last-y;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                    root.settings-open = false;
                    root.drag-started();
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.drag-ended();
                }
            }
            moved => {
                root.dragged((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
            double-clicked => {
                root.zoom(1.6);
            }
            scroll-event(event) => {
                root.zoom(Math.pow(1.0015, event.delta-y / 1px));
                accept
            }
        }
    }

    // The globe and what's drawn on it, rendered for the whole window. On the entry screen, the
    // projection moves the globe into its place, but it isn't clipped there, so that it can reach
    // under the planner.
    Image {
        source: root.texture;
        source-clip-width: root.texture-used-width;
        source-clip-height: root.texture-used-height;
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    Path {
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.remaining-path;
        stroke: #ffffffa0;
        stroke-width: 2px;
        visible: root.remaining-path != "" && root.route-shown;
    }

    Path {
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.flown-path;
        stroke: Theme.highlight.with-alpha(0.55);
        stroke-width: 7px;
        visible: root.flown-path != "" && root.route-shown;
    }

    Path {
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: root.flown-path;
        stroke: Theme.accent-light;
        stroke-width: 2.5px;
        visible: root.flown-path != "" && root.route-shown;
    }

    if root.screen != Screen.entry || root.planned-origin.index >= 0: AirportMarker {
        x: root.origin-marker.x * 1px;
        y: root.origin-marker.y * 1px;
        marker: root.origin-marker;
    }

    if root.route-shown: AirportMarker {
        x: root.destination-marker.x * 1px;
        y: root.destination-marker.y * 1px;
        marker: root.destination-marker;
        destination: true;
    }

    Rectangle {
        opacity: root.screen == Screen.flight ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 200ms; }
    for label in root.labels: Rectangle {
        x: label.x * 1px;
        y: label.y * 1px;
        width: 0;
        height: 0;
        opacity: label.opacity;
        Rectangle {
            x: -2px;
            y: -2px;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: #ffffffb0;
        }

        Text {
            x: 6px;
            y: -self.height / 2;
            text: label.name;
            color: Theme.text.with-alpha(0.8);
            font-size: 11px;
            stroke: #00000080;
            stroke-width: 2px;
        }
    }

    if root.aircraft.shown: Rectangle {
        x: root.aircraft.x * 1px - self.width / 2;
        y: root.aircraft.y * 1px - self.height / 2;
        width: 34px;
        height: 34px;
        transform-rotation: root.aircraft.angle * 1deg;
        // The shadow on the ground.
        AircraftIcon {
            x: 3px;
            y: 4px;
            width: 100%;
            height: 100%;
            colorize: #00000070;
        }

        AircraftIcon {
            width: 100%;
            height: 100%;
        }
    }

    }

    if root.curtain > 0: Rectangle {
        background: black;
        opacity: root.curtain;
    }

    if root.intro: TouchArea {
        clicked => {
            root.skip-intro();
        }
    }

    // The planner, beside the globe, or below it on a phone held upright. It stays instantiated,
    // so its fields keep their text during a flight.
    planner := Glass {
        property <length> inset: root.narrow ? 14px : 20px;
        property <length> rest-y: root.narrow ? root.entry-globe-y + root.entry-globe-height + 8px : root.top-edge;
        visible: root.planner-away < 1;
        x: root.narrow ? root.left-edge : root.left-edge - root.planner-away * (self.width + root.left-edge + 30px);
        y: root.narrow ? self.rest-y + root.planner-away * (root.height - self.rest-y + 30px) : self.rest-y;
        width: root.narrow ? root.content-width : root.panel-width;
        height: root.height - self.rest-y - root.bottom-edge;
        VerticalLayout {
            padding: planner.inset;
            spacing: 12px;
            // The badge wraps below the heading where the panel is too narrow for both.
            FlexboxLayout {
                spacing: 10px;
                alignment: space-between;
                cross-axis-alignment: center;
                Flaps {
                    text: "WHERE TO?";
                    size: root.narrow ? 17px : 21px;
                }

                if !root.narrow: MadeWithSlint {
                    height: 30px;
                }
            }

            from-field := AirportField {
                label: "From";
                active: root.active-field == 0;
                activated => {
                    root.active-field = 0;
                    root.search(self.text == root.field-text(root.planned-origin) ? "" : self.text);
                }
                edited(text) => {
                    root.planned-origin.index = -1;
                    root.search(text);
                    root.planned-changed();
                }
                accepted => {
                    if root.results.length > 0 {
                        root.choose(root.results[0]);
                    }
                }
            }

            to-field := AirportField {
                label: "To";
                active: root.active-field == 1;
                activated => {
                    root.active-field = 1;
                    root.search(self.text == root.field-text(root.planned-destination) ? "" : self.text);
                }
                edited(text) => {
                    root.planned-destination.index = -1;
                    root.search(text);
                    root.planned-changed();
                }
                accepted => {
                    if root.results.length > 0 {
                        root.choose(root.results[0]);
                    }
                }
            }

            Caption {
                text: root.results.length == 1 ? "1 airport" : "\{root.results.length} airports";
            }

            ListView {
                vertical-stretch: 1;
                for airport[index] in root.results: AirportRow {
                    index: index;
                    airport: airport;
                    clicked => {
                        root.choose(airport);
                    }
                }
            }

            // Below the list, where the airports were just picked.
            HorizontalLayout {
                alignment: space-between;
                RoundButton {
                    width: 36px;
                    height: 36px;
                    icon: @image-url("icons/settings.svg");
                    checked: root.settings-open;
                    clicked => {
                        root.settings-open = !root.settings-open;
                        root.interacted();
                    }
                }

                PillButton {
                    text: "Take off";
                    icon: @image-url("icons/aircraft.svg");
                    primary: true;
                    enabled: root.planned-origin.index >= 0 && root.planned-destination.index >= 0 && root.planned-origin.index != root.planned-destination.index;
                    clicked => {
                        root.take-off();
                    }
                }
            }
        }
    }

    // On a phone, the badge sits in a corner of the globe's place, rather than taking rows from
    // the planner's list.
    if root.narrow: MadeWithSlint {
        visible: root.planner-away < 1;
        opacity: 1 - root.planner-away;
        height: 30px;
        x: root.width - self.width - root.right-edge;
        y: root.entry-globe-y;
    }

    // On a wide screen during a flight, the badge sits above the controls.
    if !root.narrow: MadeWithSlint {
        visible: root.flight-in > 0;
        height: 40px;
        x: root.width - self.width - root.right-edge;
        y: controls.y - self.height - 12px;
    }

    flight-card := FlightCard {
        visible: root.flight-in > 0;
        x: root.left-edge;
        y: root.top-edge - (1 - root.flight-in) * (self.height + root.top-edge + 30px);
        width: root.narrow ? root.content-width : min(420px, root.content-width - 56px);
        flight: root.flight;
        small: root.narrow || root.short;
        brief: root.short;
    }

    if root.narrow || !root.compact || root.flight.phase != Phase.flying: StatusCard {
        visible: root.flight-in > 0;
        x: root.left-edge;
        y: (root.narrow ? root.controls-y - self.height - 10px : root.height - self.height - root.bottom-edge - 14px)
            + (1 - root.flight-in) * (root.height - root.controls-y + self.height + 30px);
        width: root.narrow ? root.content-width : min(420px, root.content-width);
        flight: root.flight;
        small: root.narrow || root.short;
    }

    // Below the flight card on a phone held upright, where it takes the whole width.
    VerticalLayout {
        visible: root.flight-in > 0;
        x: root.width - self.width - root.right-edge + (1 - root.flight-in) * (self.width + root.right-edge + 30px);
        y: root.narrow ? root.top-edge + flight-card.height + 10px : root.top-edge;
        width: 40px;
        spacing: 8px;
        RoundButton {
            text: "+";
            clicked => {
                root.zoom(1.5);
            }
        }

        RoundButton {
            text: "−";
            clicked => {
                root.zoom(1 / 1.5);
            }
        }
    }

    // The views, the planner, and the settings.
    controls := Glass {
        visible: root.flight-in > 0;
        x: root.width - self.width - root.right-edge;
        y: root.controls-y + (1 - root.flight-in) * (root.height - root.controls-y + 30px);
        width: root.narrow ? root.content-width : bar.preferred-width;
        height: bar.preferred-height;
        border-radius: 4px;
        bar := HorizontalLayout {
            padding: 6px;
            spacing: 8px;
            Segmented {
                preferred-width: 240px;
                min-width: 150px;
                horizontal-stretch: 1;
                options: ["Follow", "Route", "Globe"];
                current: root.view == View.follow ? 0 : root.view == View.route ? 1 : root.view == View.globe ? 2 : -1;
                picked(index) => {
                    root.choose-view(index == 0 ? View.follow : index == 1 ? View.route : View.globe);
                }
            }

            PillButton {
                text: root.narrow ? "" : "Plan a flight";
                icon: @image-url("icons/aircraft.svg");
                primary: true;
                clicked => {
                    root.settings-open = false;
                    root.show-planner();
                }
            }

            RoundButton {
                width: 36px;
                height: 36px;
                icon: @image-url("icons/settings.svg");
                checked: root.settings-open;
                clicked => {
                    root.settings-open = !root.settings-open;
                    root.interacted();
                }
            }
        }
    }

    // Above the settings button: during a flight at the right, and on the entry screen at the
    // bottom of the planner.
    if root.settings-open && root.screen != Screen.zoom: Glass {
        x: root.screen == Screen.flight ? root.width - self.width - root.right-edge : planner.x + planner.inset;
        y: (root.screen == Screen.flight ? controls.y : planner.y + planner.height - planner.inset - 36px) - self.height - 10px;
        width: min(260px, root.content-width);
        height: settings.preferred-height;
        settings := VerticalLayout {
            padding: 16px;
            spacing: 6px;
            Caption {
                text: "Quality";
            }

            Segmented {
                options: ["Auto", "Low", "Medium", "High"];
                current: root.auto-quality ? 0 : root.quality == Quality.low ? 1 : root.quality == Quality.medium ? 2 : 3;
                picked(index) => {
                    root.auto-quality = index == 0;
                    root.quality = index == 1 ? Quality.low : index == 2 ? Quality.medium : Quality.high;
                    root.interacted();
                }
            }

            Toggle {
                text: "Random flights";
                checked <=> root.kiosk;
                toggled => {
                    root.interacted();
                }
            }

            if root.online-imagery-available: Toggle {
                text: "Online imagery";
                checked <=> root.online-imagery;
                toggled => {
                    root.interacted();
                }
            }

            Toggle {
                text: "Clouds";
                checked <=> root.clouds;
                toggled => {
                    root.interacted();
                }
            }

            Toggle {
                text: "Borders";
                checked <=> root.borders;
                toggled => {
                    root.interacted();
                }
            }

            Toggle {
                text: "Sunlight";
                checked <=> root.sunlight;
                toggled => {
                    root.interacted();
                }
            }

            HorizontalLayout {
                alignment: start;
                PillButton {
                    text: "Restart";
                    clicked => {
                        root.settings-open = false;
                        root.restart();
                    }
                }
            }
        }
    }

    if !root.narrow: Text {
        x: root.width - self.width - root.right-edge;
        y: root.height - self.height - root.safe-area-insets.bottom - 4px;
        text: "\{root.gpu-text}  ·  \{root.fps-text}";
        color: Theme.faint;
        font-size: 10px;
    }
}
