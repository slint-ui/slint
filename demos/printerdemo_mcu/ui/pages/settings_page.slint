import { ComboBox, CheckBox, Page } from "../components/components.slint";
import { Kiosk } from "../common.slint";

export global SettingsMotion {
    in-out property <length> maximum;
    in-out property <length> raw-y;
}

export component SettingsPage inherits Page {
    header: "Settings";

    init => {
        SettingsMotion.maximum = max(0px, scroll.content-height - scroll.height);
    }

    scroll := Flickable {
        content-y <=> SettingsMotion.raw-y;
        changed height => { SettingsMotion.maximum = max(0px, self.content-height - self.height); }
        changed content-height => { SettingsMotion.maximum = max(0px, self.content-height - self.height); }
        VerticalLayout {
            width: 90%;
            padding: 12px;
            spacing: 16px;
            height: self.preferred-height;
            ComboBox {
                label: @tr("Quality");
                choices: ["Best", "Medium", "Draft"];
            }

            CheckBox {
                text: @tr("TURBO mode");
                checked: true;
            }

            CheckBox {
                text: @tr("Eco mode");
            }

            CheckBox {
                text: @tr("Kiosk mode");
                checked <=> Kiosk.enabled;
            }
        }
    }
}
