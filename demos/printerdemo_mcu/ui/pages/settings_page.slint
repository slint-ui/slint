import { ComboBox, CheckBox, Page } from "../components/components.slint";
import { Kiosk } from "../common.slint";

export global SettingsMotion {
    in-out property <length> maximum;
    in-out property <length> raw-y;
    in-out property <bool> pixel-snap: false;
    callback moved(length);
}

export component SettingsPage inherits Page {
    header: "Settings";

    scroll := Flickable {
        init => { SettingsMotion.maximum = max(0px, self.content-height - self.height); }
        changed height => { SettingsMotion.maximum = max(0px, self.content-height - self.height); }
        changed content-height => { SettingsMotion.maximum = max(0px, self.content-height - self.height); }
        content-width: self.width;
        content-height: settings-layout.preferred-height;
        content-y <=> SettingsMotion.raw-y;
        changed content-y => { SettingsMotion.moved(self.content-y); }
        Rectangle {
            width: scroll.width;
            height: settings-layout.preferred-height;
            y: SettingsMotion.pixel-snap ? round(scroll.content-y / 1px) * 1px - scroll.content-y : 0px;
            settings-layout := VerticalLayout {
                width: 90%;
                padding: 12px;
                spacing: 16px;
                height: self.preferred-height;
                ComboBox {
                    label: @tr("Quality");
                    choices: ["Best", "Medium", "Draft"];
                }

                CheckBox {
                    text: @tr("TURBO mode");
                    checked: true;
                }

                CheckBox {
                    text: @tr("Eco mode");
                }
                CheckBox {
                    text: @tr("Kiosk mode");
                    checked <=> Kiosk.enabled;
                }
            }
        }
    }
}
