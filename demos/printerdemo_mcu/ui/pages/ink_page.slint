import { DemoPalette, PrinterState, InkLevel, InkParticles } from "../common.slint";
import { Page } from "../components/components.slint";

component PlainInkPage inherits Page {
    property <bool> page-visible;

    header: "Ink Level";

    Timer {
        interval: 30ms;
        running: true;
        triggered => {
            self.stop();
            page-visible = true;
        }
    }

    Rectangle {
        height: 82%;
        width: 60%;

        HorizontalLayout {
            spacing: root.width * 5%;

            for color-info in PrinterState.ink-levels : Rectangle {
                ink := Rectangle {
                    width: parent.width;
                    height: parent.height * color-info.level;
                    y: parent.height - self.height;
                    clip: true;

                    states [
                        inactive when !root.page-visible : {
                            height: 2px;
                            out {
                                animate height {
                                    duration: 750ms;
                                    delay: 50ms;
                                    easing: ease-in-out;
                                }
                            }
                            in {
                                animate height { duration: 200ms; easing: ease-in; }
                            }
                        }
                    ]

                    Rectangle {
                        background: color-info.color;
                        border-radius: self.width / 2;
                        border-width: 2px;
                        height: parent.height + parent.y;
                        y: -parent.y;
                    }
                }

                Rectangle {
                    property <length> r: (parent.width - self.height) / 2;
                    property <length> y2: max(0phx, max(self.r - self.y, self.y - parent.height + self.r));

                    y: max(ink.y - self.height, 0phx);
                    height: 2px;
                    // w = 2*sqrt(r² - (max(0, min(r-y , y-h+r)))²)
                    width: 2*sqrt((self.r*self.r - self.y2*self.y2)/(1phx * 1phx))*1phx;  // FIXME: it would be nice if sqrt could do proper unit handling
                    x: (parent.width - self.width) / 2;
                    background: DemoPalette.neutral-box;
                }

                Rectangle {
                    border-radius: self.width / 2;
                    border-color: DemoPalette.neutral-box;
                    border-width: 2px;
                }
            }
        }
    }
}

export component InkPage inherits Rectangle {
    background: InkParticles.enabled ? #050914 : DemoPalette.page-background;
    property <length> vial-width: max(8px, floor((root.width - 80px) / 4px) * 1px);
    property <length> vial-height: max(24px, floor((root.height - 100px) / 1px) * 1px);

    init => { InkParticles.resize(round(root.vial-width / 1phx), round(root.vial-height / 1phx)); }
    changed vial-width => { InkParticles.resize(round(root.vial-width / 1phx), round(root.vial-height / 1phx)); }
    changed vial-height => { InkParticles.resize(round(root.vial-width / 1phx), round(root.vial-height / 1phx)); }

    if !InkParticles.enabled: PlainInkPage { }

    if InkParticles.enabled: Rectangle {
        Text {
            x: 16px;
            y: 12px;
            text: "INK LEVEL";
            font-size: 18px;
            color: #f4f8ff;
        }
        for info[index] in PrinterState.ink-levels: Rectangle {
            property <color> accent-color: [#ff9c10, #ff386c, #14c0ff, #bcd4ef][index];
            x: (root.width - 4 * root.vial-width - 42px) / 2 + index * (root.vial-width + 14px);
            y: 48px;
            width: root.vial-width;
            height: root.vial-height;

            Image {
                width: parent.width;
                height: parent.height;
                source: InkParticles.frames[index];
                image-fit: fill;
                image-rendering: pixelated;
            }
            TouchArea {
                width: parent.width;
                height: parent.height;
                changed pressed => { InkParticles.hold(index, self.pressed); }
            }
            Text {
                y: parent.height + 6px;
                width: parent.width;
                height: 24px;
                text: round(info.level * 100) + "%";
                font-size: 19px;
                horizontal-alignment: center;
                color: parent.accent-color;
            }
            Text {
                y: parent.height + 33px;
                width: parent.width;
                text: ["YELLOW", "RED", "CYAN", "BLACK"][index];
                font-size: 9px;
                horizontal-alignment: center;
                color: parent.accent-color;
            }
        }
    }
}
