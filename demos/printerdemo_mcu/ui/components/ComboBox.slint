import { DemoPalette } from "../common.slint";
import { MiniPopup } from "./MiniPopup.slint";
import { ShadowBox } from "ShadowBox.slint";
import { PressArea } from "PressArea.slint";

export component ComboBox {
    in property <[string]> choices;
    in-out property <int> current-index;
    in-out property <string> label;

    height: 108px;

    ShadowBox { }

    VerticalLayout {
        padding: 13px;
        alignment: space-between;

        Text {
            text: root.label;
            color: DemoPalette.text-foreground-color;
            font-size: 16px;
        }

        Rectangle {
            height: 48px;
            border-radius: 10px;
            border-width: 2px;
            border-color: #CAD5E2;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 13px;

                Text {
                    vertical-alignment: center;
                    text: root.choices[current-index];
                    color: DemoPalette.text-foreground-color;
                    font-size: 16px;
                    horizontal-stretch: 1;
                }

                Image {
                    source: @image-url("../images/mcu/combo-arrow.svg");
                }
            }
        }
    }

    TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up) {
                popup.show()
            }
        }
    }

    popup := MiniPopup {

        frame := Rectangle {
            width: 192px;
            height: 174px;
            border-radius: 14px;

            VerticalLayout {
                for choice[index] in root.choices: Rectangle {
                    border-top-left-radius: index == 0 ? frame.border-radius : 0;
                    border-top-right-radius: index == 0 ? frame.border-radius : 0;
                    border-bottom-left-radius: index == root.choices.length - 1 ? frame.border-radius : 0;
                    border-bottom-right-radius: index == root.choices.length - 1 ? frame.border-radius : 0;
                    vertical-stretch: 1;
                    background: (index == root.current-index ? DemoPalette.selection-background : white).brighter(-choice-touch.press-progress * 12%);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;

                        Text {
                            vertical-alignment: center;
                            font-size: 16px;
                            text: choice;
                            color: index == root.current-index ? white : DemoPalette.text-foreground-color;
                            horizontal-stretch: 1;
                        }

                        Image {
                            visible: index == root.current-index;
                            width: 20px;
                            source: @image-url("../images/mcu/tick-combo.svg");
                        }
                    }

                    if index > 0: Rectangle {
                        y: 0px;
                        background: #E2E8F0;
                        height: 1px;
                    }

                    choice-touch := PressArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                root.current-index = index;
                            }
                        }
                        clicked => {
                            popup.close();
                        }
                    }
                }
            }

            Rectangle {
                border-radius: frame.border-radius;
                border-width: 3px;
                border-color: #E2E8F0;
            }
        }
    }
}
