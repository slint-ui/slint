import { DemoPalette } from "../common.slint";
import { ButtonFace } from "ButtonFace.slint";
import { PressArea } from "PressArea.slint";

export component PushButton inherits Rectangle {

    in property <string> label <=> label.text;
    in property <image> icon;

    callback clicked <=> touch-area.clicked;

    height: 66px;

    face := ButtonFace {
        x: 2px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 9px;
        press-progress: touch-area.press-progress;
    }

    HorizontalLayout {
        y: face.content-offset;
        spacing: 10px;
        label := Text {
            font-size: 18px;
            color: DemoPalette.push-button-text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.icon.width > 0: img := Image {
            source: root.icon;
            image-fit: contain;
            width: 17px;
            height: 17px;
        }
    }


    touch-area := PressArea { }
}
