import { ComponentsView } from "components_view.slint";
import { Palette } from "std-widgets.slint";
import { MainWindowAdapter } from "../main_window_adapter.slint";
import { FilledIcons, OutlinedIcons } from "../icons.slint";
import {
    MaterialText,
    MaterialTypography,
    IconButton,
    MaterialPalette,
    MaterialAnimations,
    NavigationRail,
    NavigationItem,
    NavigationBar,
    SmallAppBar,
    PopupMenu,
    MenuItem,
    MaterialStyleMetrics,
    Dialog,
    TextField
} from "../../../../src/material.slint";

export enum Views {
    components
}

export global MainViewAdapter {
    in_out property <[MenuItem]> palettes: [
        { text: "Slint", enabled: true },
        { text: "Purple", enabled: true },
        { text: "Green", enabled: true },
        { text: "Red", enabled: true },
        { text: "Custom (Dynamic)", enabled: true },
    ];

    callback load_palette(index: int);
    callback apply_dynamic_color(hex: string) -> bool;
}

export component MainView {
    in property <length> safe-area-top;
    in property <length> safe-area-bottom;
    in property <length> safe-area-left;
    in property <length> safe-area-right;
    property <Views> current_view: Views.components;
    property <[NavigationItem]> navigation_items: [
        {
            text: "Components",
            icon: OutlinedIcons.dashboard,
            selected_icon: FilledIcons.dashboard
        }
    ];

    property <bool> invalid_color;

    function apply_custom_color(hex: string) {
        root.invalid_color = !MainViewAdapter.apply_dynamic_color(hex);
        if !root.invalid_color {
            color_dialog.close();
        }
    }

    VerticalLayout {
        padding-top: root.safe-area-top;
        padding-left: root.safe-area-left;
        padding-right: root.safe-area-right;

        app_bar := SmallAppBar {
            title: "Material 3";
            trailing_buttons: [
                { icon: OutlinedIcons.palette, enabled: true },
                { icon: Palette.color_scheme == ColorScheme.light ? OutlinedIcons.dark_mode : OutlinedIcons.light_mode, enabled: true }
            ];
            show_background: MainWindowAdapter.show_background;

            trailing_button_clicked(index) => {
                if index == 0 {
                    color_menu.show();
                }

                if index == 1 {

                    if Palette.color_scheme == ColorScheme.light {
                        Palette.color_scheme = ColorScheme.dark;
                        return;
                    }

                    Palette.color_scheme = ColorScheme.light;
                }
            }
        }

        color_menu := PopupMenu {
            x: root.width - MaterialStyleMetrics.size_200 - MaterialStyleMetrics.padding_16;
            y: app_bar.height / 2;
            items: MainViewAdapter.palettes;

            activated(index) => {
                if index == 4 {
                    root.invalid_color = false;
                    color_dialog.show();
                } else {
                    MainViewAdapter.load_palette(index);
                }
                color_menu.close();
            }
        }

        color_dialog := Dialog {
            x: -root.absolute_position.x;
            y: -root.absolute_position.y;
            width: MainWindowAdapter.width;
            height: MainWindowAdapter.height;
            title: "Custom M3 Dynamic Color";
            default_action_text: "Apply";
            actions: ["Cancel"];

            VerticalLayout {
                min_width: min(320px, root.width - MaterialStyleMetrics.padding_24 * 2);
                spacing: MaterialStyleMetrics.spacing_12;
                padding_top: MaterialStyleMetrics.padding_8;
                padding_bottom: MaterialStyleMetrics.padding_8;

                MaterialText {
                    text: "Enter a color as #RGB or #RRGGBB to generate Material 3 schemes dynamically:";
                    wrap: word_wrap;
                }

                color_tf := TextField {
                    text: "#2379F4";
                    label: "Hex Color";
                    placeholder_text: "#RRGGBB";
                    has_error: root.invalid_color;
                    supporting_text: root.invalid_color ? "Use 3 or 6 hexadecimal digits (0-9, A-F)." : "";
                    edited(text) => {
                        root.invalid_color = false;
                    }
                    accepted(val) => {
                        root.apply_custom_color(val);
                    }
                }
            }

            default_action_clicked => {
                root.apply_custom_color(color_tf.text);
            }

            action_clicked(idx) => {
                color_dialog.close();
            }
        }

        Rectangle {
            background: MaterialPalette.background;

            if !MainWindowAdapter.break_layout : HorizontalLayout {
                padding-bottom: root.safe-area-bottom;

                if root.current_view == Views.components : ComponentsView {
                    horizontal_stretch: 1;
                }
            }

            if MainWindowAdapter.break_layout : VerticalLayout {
                padding-bottom: root.safe-area-bottom;

                if root.current_view == Views.components : ComponentsView {
                    horizontal_stretch: 1;
                }
            }
        }
    }
}
