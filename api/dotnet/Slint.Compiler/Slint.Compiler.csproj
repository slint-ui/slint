<!--
  Packs the slint-compiler binaries that Slint.targets runs.
  Pass SlintCompilerBinariesDir, a directory with one sub-directory per runtime identifier:
    dotnet pack -p:SlintCompilerBinariesDir=artifacts/compiler    with artifacts/compiler/osx-arm64/slint-compiler
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Slint.Compiler</PackageId>
    <Description>The slint-compiler that the Slint package runs to generate C# code from .slint files.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- The package has no lib folder on purpose. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="buildTransitive/Slint.Compiler.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="$(SlintCompilerBinariesDir)/**/*" Pack="true" PackagePath="tools/" Condition="'$(SlintCompilerBinariesDir)' != ''" />
  </ItemGroup>
</Project>
