<!--
  A counter for the browser. Run scripts/build_dotnet_browser.sh first, then from this directory:
    dotnet build -c Release
    node ../../../scripts/run_in_chrome.mjs steps/run.json wwwroot bin/Release/net10.0/wwwroot [?renderer=software]
-->
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SlintIncludePaths>include</SlintIncludePaths>
  </PropertyGroup>
  <ItemGroup>
    <SlintFile Include="ui/app.slint" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Slint/Slint.csproj" />
  </ItemGroup>
  <Import Project="../Slint/build/Slint.targets" />
</Project>
