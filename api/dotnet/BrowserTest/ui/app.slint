import { Button, LineEdit, VerticalBox } from "std-widgets.slint";
// From the include path, which the browser's file system has at another place than the build machine.
import { Badge } from "badge.slint";

export component AppWindow inherits Window {
    title: "Slint in the browser";
    preferred-width: 400px;
    preferred-height: 300px;

    in-out property <int> counter: 42;
    in-out property <string> name;
    in-out property <int> ticks;
    callback request-increase-value();
    callback name-accepted(string);
    callback quit();

    VerticalBox {
        alignment: center;
        Text {
            text: "Counter: \{root.counter}";
            font-size: 24px;
            horizontal-alignment: center;
        }
        Button {
            text: "Increase value";
            clicked => {
                root.request-increase-value();
            }
        }
        LineEdit {
            placeholder-text: "Your name";
            accepted(text) => {
                root.name-accepted(text);
            }
        }
        Text {
            text: "Hello, \{root.name}! Ticks: \{root.ticks}";
            horizontal-alignment: center;
        }
        Badge { }
        Button {
            text: "Quit";
            clicked => {
                root.quit();
            }
        }
    }
}
