// Imports through SlintIncludePaths and SlintLibraryPath, see Slint.Tests.csproj.
import { Badge } from "badge.slint";
import { Tag } from "@tags/tag.slint";

export component ImportPaths {
    badge := Badge {}
    tag := Tag {}
    out property <string> text: badge.label + "/" + tag.label;
}
