// Matches the members of CounterViewModel by name, for the generated binding of a global.
export global CounterPage {
    in property <int> count;
    in-out property <string> label;
    callback increment();
}

export component CounterView {
    public function click-increment() { CounterPage.increment(); }
    public function type-label(text: string) { CounterPage.label = text; }
}
