<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <EnableMSTestRunner>true</EnableMSTestRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Slint/Slint.csproj" />
  </ItemGroup>
  <ItemGroup>
    <SlintFile Include="ui/generated.slint" />
    <SlintFile Include="ui/shared.slint" Generate="false" />
    <SlintFile Include="ui/live.slint" LivePreview="true" />
  </ItemGroup>
  <!-- A package reference imports this automatically; a project reference doesn't. -->
  <Import Project="../Slint/build/Slint.targets" />
</Project>
