<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinExe: Windows opens no console window for the app, and drops what it writes to the console. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Debug: `dotnet watch` reloads changes to the .slint files and to the C# code while the app runs. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SlintLivePreview>true</SlintLivePreview>
  </PropertyGroup>

  <!-- Release: `dotnet publish -c Release -r <runtime identifier>` builds a native executable with Native AOT. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

</Project>
