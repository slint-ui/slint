<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    The app links Slint into .NET's WebAssembly runtime, which needs the wasm-tools workload: `dotnet workload install wasm-tools`.
    `dotnet watch` applies C# changes while the page runs; after a change to a .slint file, press Ctrl+R in `dotnet watch` to rebuild.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
<!--#if (style != "default") -->
    <SlintStyle>SLINT_STYLE</SlintStyle>
<!--#endif -->
  </PropertyGroup>

  <ItemGroup>
    <SlintFile Include="ui/app-window.slint" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SLINT_PACKAGE_ID" Version="SLINT_VERSION" />
  </ItemGroup>

</Project>
