<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
<!--#if (style != "default") -->
    <SlintStyle>SLINT_STYLE</SlintStyle>
<!--#endif -->
  </PropertyGroup>

  <!-- Debug: `dotnet watch` reloads changes to the .slint files and to the C# code while the app runs. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <SlintLivePreview>true</SlintLivePreview>
  </PropertyGroup>

  <!-- Release: `dotnet publish -c Release -r <runtime identifier>` builds a native executable with Native AOT. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <SlintFile Include="ui/app-window.slint" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SLINT_PACKAGE_ID" Version="SLINT_VERSION" />
  </ItemGroup>

</Project>
