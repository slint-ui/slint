// Both component definition forms, instantiated like built-in elements.
//#sls.file.component.definition-forms

component Frame inherits Rectangle {
    width: 24px; //#cov(width+)
    height: 24px; //#cov(height+)
    background: #444444; //#cov(background+)
}

component Led {
    width: 20px; //#cov(width-)
    height: 20px; //#cov(height-)
    Rectangle { //#cov(Rectangle+)
        x: 2px; //#cov(x+)
        y: 2px; //#cov(y+)
        width: 16px; //#cov(width+)
        height: 16px; //#cov(height+)
        background: #ff0000; //#cov(background+)
    }
}

export component UserComponent inherits Window { //#cov(Window+)
    background: #202020; //#cov(background+)
    //#sls.file.element.instantiation-typename
    Frame { //#cov(Frame+)
        x: 8px; //#cov(x+)
        y: 8px; //#cov(y+)
        Led { x: 2px; y: 2px; } //#cov(Led+ x+ y+)
    }
    Frame { //#cov(Frame+)
        x: 40px; //#cov(x+)
        y: 8px; //#cov(y+)
        background: #006600; //#cov(background+)
        Led { x: 2px; y: 2px; } //#cov(Led+ x+ y+)
    }
}

/*
```rust
let x = UserComponent::new(crate::harness::WINDOW_SIZE);
screenshot!(x);
```

Only the exported component names a generated struct:
```rust compile_fail
//#sls.gen.component
let _ = Led::new(crate::harness::WINDOW_SIZE);
//~ ERROR undeclared type `Led`
```
*/
