// A base-less component without an explicit size is zero-sized, so its
// default-centered child extends 5px up and left of the instance position,
// exactly as in regular Slint.

component Dot {
    //#sls.geom.default-position
    Rectangle {
        width: 10px;
        height: 10px;
        background: #ffffff;
    }
}

export component BaselessImplicitSize inherits Window {
    background: #000000;
    Dot { x: 20px; y: 20px; }
}

/*
```rust
let x = BaselessImplicitSize::new();
screenshot!(x);
```
*/
