export component TestCase inherits Window {
    in property <length> width-input;
    in property <color> tint;
    out property <length> gap: 5px;
    out property <color> shade: #12345678;
    in-out property <length> offset;
    property <color> internal: #ff0000;
    in property <int> count: 42;
    in-out property <int> counter;
}

/*
```rust
let mut x = TestCase::new(crate::harness::WINDOW_SIZE);
//#sls.prop.def.value
//#sls.prop.decl.default
//#sls.type.length
assert_eq!(x.get_width_input(), 0);
assert_eq!(x.get_tint(), slint_sc::Color::default());
//#sls.type.color
let default_tint = x.get_tint();
assert_eq!((default_tint.red(), default_tint.green(), default_tint.blue(), default_tint.alpha()), (0, 0, 0, 0));
//#sls.prop.decl.form
//#sls.prop.decl.out
assert_eq!(x.get_gap(), 5);
assert_eq!(x.get_shade(), slint_sc::Color::from_argb_encoded(0x78123456));
//#sls.gen.prop.get
//#sls.gen.prop.set
//#sls.gen.prop.names
//#sls.prop.decl.in
x.set_width_input(42);
assert_eq!(x.get_width_input(), 42);
//#sls.prop.decl.in-out
x.set_offset(7);
assert_eq!(x.get_offset(), 7);
//#sls.gen.prop.types
//#sls.type.color
x.set_tint(slint_sc::Color::from_rgb_u8(1, 2, 3));
let tint = x.get_tint();
assert_eq!((tint.red(), tint.green(), tint.blue(), tint.alpha()), (1, 2, 3, 0xff));

// A whole number without a unit is an `int` literal; the default `int` is zero.
//#sls.type.int
//#sls.expr.int.form
//#sls.expr.int.type
assert_eq!(x.get_count(), 42);
assert_eq!(x.get_counter(), 0);
x.set_counter(9);
assert_eq!(x.get_counter(), 9);
```

An out property has no setter:
```rust compile_fail
let mut x = TestCase::new(crate::harness::WINDOW_SIZE);
//#sls.gen.prop.set
x.set_gap(5);
//~ ERROR no method named `set_gap`
```

A private property has no getter:
```rust compile_fail
let x = TestCase::new(crate::harness::WINDOW_SIZE);
//#sls.prop.decl.private
//#sls.gen.prop.get
x.get_internal();
//~ ERROR no method named `get_internal`
```

A private property has no setter:
```rust compile_fail
let mut x = TestCase::new(crate::harness::WINDOW_SIZE);
//#sls.prop.decl.private
//#sls.gen.prop.set
x.set_internal(slint_sc::Color::default());
//~ ERROR no method named `set_internal`
```
*/
