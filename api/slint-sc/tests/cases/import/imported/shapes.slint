// Components imported by the cases in the parent directory. Files in this
// directory are not cases themselves: the driver only collects the .slint
// files directly in each group directory.

export component Frame inherits Rectangle {
    width: 24px;
    height: 24px;
    background: #444444;
}

export component Led inherits Rectangle {
    width: 16px;
    height: 16px;
    background: #ff0000;
}
