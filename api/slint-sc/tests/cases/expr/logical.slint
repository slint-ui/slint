// `&&` and `||` combine two booleans, `!` negates one. They compose with
// parentheses to override precedence.

export component TestCase inherits Window {
    in property <bool> a;
    in property <bool> b;
    //#sls.op.logical
    out property <bool> both: a && b;
    out property <bool> either: a || b;
    //#sls.op.not
    out property <bool> not_a: !a;
    out property <bool> neither: !a && !b;
    out property <bool> not_both: !(a && b);
    out property <bool> grouped: (a || b) && !(a && b);
}

/*
```rust
let mut x = TestCase::new(crate::harness::WINDOW_SIZE);

for (a, b) in [(false, false), (false, true), (true, false), (true, true)] {
    x.set_a(a);
    x.set_b(b);

    // `&&` is true when both operands are true, `||` when either is.
    //#sls.op.logical
    assert_eq!(x.get_both(), a && b);
    assert_eq!(x.get_either(), a || b);

    // `!` negates a boolean.
    //#sls.op.not
    assert_eq!(x.get_not_a(), !a);
    assert_eq!(x.get_neither(), !a && !b);
    assert_eq!(x.get_not_both(), !(a && b));

    // Parentheses override precedence: exclusive-or built from the primitives.
    assert_eq!(x.get_grouped(), (a || b) && !(a && b));
}
```

```coverage
- 7:36 element
+ 11:31 binding both
+ 11:33 branch && true
+ 11:33 branch && false
+ 12:33 binding either
+ 12:35 branch || true
+ 12:35 branch || false
+ 14:32 binding not-a
+ 15:34 binding neither
+ 15:37 branch && true
+ 15:37 branch && false
+ 16:35 binding not-both
+ 16:39 branch && true
+ 16:39 branch && false
+ 17:34 binding grouped
+ 17:37 branch || true
+ 17:37 branch || false
+ 17:43 branch && true
+ 17:43 branch && false
+ 17:50 branch && true
+ 17:50 branch && false
```
*/
