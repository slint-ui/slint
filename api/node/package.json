{
  "name": "slint-ui",
  "version": "1.19.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": "./register.mjs",
    "./esbuild": {
      "types": "./esbuild.d.mts",
      "default": "./esbuild.mjs"
    }
  },
  "homepage": "https://github.com/slint-ui/slint",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/slint-ui/slint"
  },
  "keywords": [
    "gui",
    "ui",
    "native",
    "desktop",
    "desktop-app",
    "node",
    "deno",
    "bun",
    "javascript",
    "typescript",
    "cross-platform",
    "no-webview",
    "electron-alternative",
    "slint",
    "embedded"
  ],
  "description": "Native GUI toolkit for JavaScript and TypeScript on Node.js, Deno, and Bun: build desktop and embedded apps without a webview or Chromium",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@napi-rs/cli": "3.10.9",
    "@types/capture-console": "1.0.5",
    "@types/node": "catalog:",
    "capture-console": "1.0.2",
    "esbuild": "0.28.2",
    "image-js": "1.7.1",
    "typescript": "catalog:",
    "verdaccio": "6.10.7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "esbuild": ">=0.20"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22.18"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "compile": "tsc --build",
    "build": "napi build --platform --no-const-enum --release --js rust-module.cjs --dts rust-module.d.cts -c binaries.json",
    "build:dev": "napi build --platform --no-const-enum --release --js rust-module-dev.cjs --dts rust-module.d.cts -c binaries-dev.json --features system-testing,mcp,live-preview",
    "build:minimal": "napi build --platform --no-const-enum --js rust-module.cjs --dts rust-module.d.cts -c binaries.json --no-default-features",
    "build:debug": "napi build --platform --no-const-enum --js rust-module-dev.cjs --dts rust-module.d.cts -c binaries-dev.json --features system-testing,mcp,live-preview && pnpm compile",
    "build:testing": "napi build --platform --no-const-enum --js rust-module.cjs --dts rust-module.d.cts -c binaries.json --features testing,live-preview && pnpm compile",
    "docs": "pnpm build && pnpm -C ../../docs/nodejs run build",
    "docs:dev": "pnpm build && pnpm -C ../../docs/nodejs run dev",
    "docs:debug": "pnpm build:debug && pnpm -C ../../docs/nodejs run build",
    "type-check": "tsc -p tsconfig.bindings.json && tsc -p __test__/tsconfig.json && tsc -p tsconfig.e2e.json",
    "check": "biome check",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "test": "vitest run"
  }
}
