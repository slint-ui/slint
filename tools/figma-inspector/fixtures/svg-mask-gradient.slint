export component Demo inherits Window {
    width: 40px;
    height: 40px;
    background: transparent;
    Image {
        x: 0px;
        y: 0px;
        width: 40px;
        height: 40px;
        opacity: 0.8;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: fill;
    }
}
