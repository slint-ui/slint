export component Demo inherits Window {
    width: 240px;
    height: 64px;
    background: transparent;
    Rectangle {
        background: #1A1F2E;
        border-radius: 12px;
        FlexboxLayout {
            flex-wrap: no-wrap;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            alignment: center;
            cross-axis-alignment: center;
            Rectangle {
                preferred-width: 24px;
                horizontal-stretch: 0;
                height: 24px;
                background: #FAA62E;
                border-radius: 6px;
            }
            Text {
                horizontal-stretch: 0;
                vertical-stretch: 0;
                color: #FFFFFF;
                text: "Continue";
                font-family: "Inter";
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
