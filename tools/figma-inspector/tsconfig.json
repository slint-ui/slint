{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "types": ["node", "@figma/plugin-typings"],
        "paths": {
            "slint-wasm-generated": [
                "../../api/wasm-interpreter/pkg/slint_wasm_interpreter.d.ts"
            ]
        }
    },
    "include": ["src/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"]
}
