{
    "name": "slint.figma.plugin",
    "private": true,
    "version": "1.18.0",
    "type": "module",
    "scripts": {
        "check": "pnpm format && pnpm lint && pnpm type-check && pnpm knip && pnpm spellcheck",
        "lint": "biome lint .",
        "format": "biome format .",
        "format:check": "biome format .",
        "knip": "knip --directory ../.. --workspace tools/figma-inspector",
        "build": "vite build --config vite.config.code.ts && vite build",
        "build:slint": "wasm-pack build --release --target web ../../api/wasm-interpreter -- --features console_error_panic_hook",
        "test:bundle": "node tests/bundle-contract.mjs && node tests/sandbox-harness.mjs",
        "zip": "node scripts/package-plugin.mjs",
        "test:package": "node scripts/package-plugin.mjs --test && node tests/package-contract.mjs",
        "dev": "pnpm build:dev && concurrently --kill-others \"vite build --config vite.config.code.ts --mode development --watch\" \"vite build --mode development --watch\"",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser --project raster-1.25 --project raster-2",
        "verify": "pnpm build:slint && pnpm check && pnpm build && pnpm build:dev && pnpm test:bundle && pnpm test:package && pnpm test:nightly && pnpm test:unit && pnpm test:browser",
        "build:dev": "vite build --config vite.config.code.ts --mode development && vite build --mode development",
        "format:fix": "biome format --write .",
        "lint:fix": "biome lint --write .",
        "type-check": "tsc --noEmit",
        "spellcheck": "cspell --no-progress --gitignore \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.md\" \"vite.config*.ts\" \"ui.html\"",
        "zip:nightly": "node scripts/package-plugin.mjs --nightly",
        "test:nightly": "pnpm zip:nightly && node tests/nightly-package-contract.mjs",
        "build:slint:dev": "wasm-pack build --dev --target web ../../api/wasm-interpreter -- --features console_error_panic_hook"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@figma/plugin-typings": "1.138.0",
        "@noble/hashes": "2.4.0",
        "@shikijs/types": "4.4.3",
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "jszip": "3.10.1",
        "playwright": "catalog:",
        "shiki": "4.4.3",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "cspell": "catalog:",
        "vite-plugin-singlefile": "2.3.3",
        "concurrently": "9.2.1"
    }
}
