{
    "name": "slint.figma.plugin",
    "private": true,
    "version": "1.18.0",
    "type": "module",
    "scripts": {
        "check": "pnpm format && pnpm lint && pnpm type-check && pnpm knip && pnpm spellcheck",
        "lint": "biome lint .",
        "format": "biome format .",
        "format:check": "biome format .",
        "knip": "knip --directory ../.. --workspace tools/figma-inspector",
        "build": "node scripts/build.mjs",
        "build:slint": "pnpm prepare:slint && node scripts/build-slint.mjs",
        "check:syntax-assets": "node scripts/check-syntax-assets.mjs",
        "check:slint": "node scripts/check-slint-artifact.mjs",
        "test:bundle": "node tests/bundle-contract.mjs && node tests/sandbox-harness.mjs",
        "zip": "node scripts/package-plugin.mjs",
        "test:package": "node scripts/package-plugin.mjs --test && node tests/package-contract.mjs",
        "dev": "node scripts/dev.mjs",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser --project raster-1.25 --project raster-2",
        "verify": "pnpm build:slint && pnpm check:syntax-assets && pnpm check:slint && pnpm check && pnpm build && pnpm build:dev && pnpm test:bundle && pnpm test:package && pnpm test:nightly && pnpm test:unit && pnpm test:browser",
        "build:dev": "cross-env MODE=dev pnpm build",
        "prepare:slint": "node scripts/prepare-slint.mjs",
        "format:fix": "biome format --write .",
        "lint:fix": "biome lint --write .",
        "type-check": "tsc --noEmit",
        "spellcheck": "cspell --no-progress --gitignore \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.{ts,mjs}\" \"*.md\" \"docs/**/*.md\"",
        "zip:nightly": "node scripts/package-plugin.mjs --nightly",
        "test:nightly": "pnpm zip:nightly && node tests/nightly-package-contract.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@figma/plugin-typings": "1.138.0",
        "@noble/hashes": "2.4.0",
        "@shikijs/types": "4.4.3",
        "@types/node": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "cross-env": "10.1.0",
        "esbuild": "0.28.2",
        "jszip": "3.10.1",
        "playwright": "catalog:",
        "shiki": "4.4.3",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "cspell": "catalog:"
    }
}
