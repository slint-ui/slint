{
    "name": "slint.figma.plugin",
    "private": true,
    "version": "1.18.0",
    "type": "module",
    "scripts": {
        "dev": "vite build --watch --mode dev",
        "devcode": "vite build --watch --mode dev --config vite.config.code.ts",
        "build": "vite build",
        "buildcode": "vite build --config vite.config.code.ts",
        "preview": "vite preview",
        "hmr": "vite",
        "zip": "cross-env MODE=zip vite build",
        "check": "biome check",
        "lint": "biome lint",
        "lint:fix": "biome lint --fix",
        "format": "biome format",
        "format:fix": "biome format --write",
        "spellcheck": "cspell --no-progress --gitignore --exclude 'archive/**' \"./**/*.{ts,tsx}\"",
        "test": "vitest",
        "type-check": "tsc --noEmit",
        "build:slint": "pnpm prepare:slint && node scripts/build-slint.mjs",
        "check:syntax-assets": "node scripts/check-syntax-assets.mjs",
        "check:slint": "node scripts/check-slint-artifact.mjs",
        "prepare:slint": "node scripts/prepare-slint.mjs",
        "test:replacement": "vitest run --config vitest.replacement.config.ts --project unit",
        "build:replacement": "node scripts/build.mjs",
        "build:replacement:dev": "cross-env MODE=dev node scripts/build.mjs",
        "test:replacement:browser": "vitest run --config vitest.replacement.config.ts --project browser --project raster-1.25 --project raster-2",
        "verify:replacement": "pnpm build:slint && pnpm check:syntax-assets && pnpm check:slint && tsc --noEmit -p tsconfig.replacement.json && pnpm build:replacement && pnpm build:replacement:dev && node tests/bundle-contract.mjs && node tests/sandbox-harness.mjs && pnpm test:replacement && pnpm test:replacement:browser"
    },
    "devDependencies": {
        "@figma/plugin-typings": "1.138.0",
        "@types/jszip": "3.4.1",
        "@types/node": "catalog:",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.4",
        "cross-env": "10.1.0",
        "jszip": "3.10.1",
        "shiki": "4.4.3",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-figma-plugin": "0.0.24",
        "vite-plugin-singlefile": "2.3.3",
        "vitest": "catalog:",
        "@biomejs/biome": "catalog:",
        "@noble/hashes": "2.4.0",
        "@shikijs/types": "4.4.3",
        "@vitest/browser-playwright": "catalog:",
        "esbuild": "0.28.2",
        "knip": "6.34.0",
        "playwright": "catalog:"
    },
    "dependencies": {
        "figma-kit": "1.0.0-beta.23",
        "html-react-parser": "6.1.5",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-rnd": "10.5.3",
        "zustand": "5.0.14"
    }
}
