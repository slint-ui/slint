import { Palette, ScrollView, ListView, ComboBox, TextEdit } from "std-widgets.slint";
import { Button, ButtonVariant, PrimerTextInput, UnderlineNav, PrimerColors, Icons, Label } from "@primer";

import { ActionButton } from "action-button.slint";
import { InspectorCode } from "inspector-code.slint";
import { SourceView } from "source-view.slint";

export struct TestRow { id: string, title: string, detail: string, status: string, depth: int, group: bool, expanded: bool }
export struct HistoryRow { id: string, title: string, detail: string, pinned: bool }
export struct InspectRow { index: int, title: string, detail: string }
export struct StepRow { title: string, detail: string, status: string, depth: int, group: bool, expanded: bool, row-index: int }

component StatusDot inherits Rectangle {
    in property <string> status;
    width: 8px; height: 8px; border-radius: 4px;
    background: status == "Passed" ? PrimerColors.fgColor-success : (status == "Failed" || status == "Error" || status == "Crashed") ? PrimerColors.fgColor-danger : status == "Running" ? PrimerColors.fgColor-accent : status == "Skipped" ? PrimerColors.fgColor-attention : PrimerColors.fgColor-muted;
}

export component TestStudio inherits Window {
    title: "Slint Test Studio";
    preferred-width: 1380px; preferred-height: 900px; min-width: 1080px; min-height: 700px;
    default-font-family: "Mona Sans"; default-font-size: 14px;
    background: PrimerColors.bgColor-default;
    in property <[TestRow]> tests;
    in property <[StepRow]> steps;
    in property <[HistoryRow]> run-history;
    in property <[string]> recent-projects;
    in property <int> shown-count;
    in property <string> suite-summary;
    in property <string> run-diagnostics;
    in property <string> environment-info;
    in property <bool> has-artifacts;
    in property <bool> can-rerun;
    in property <bool> stale;
    in property <bool> historical;
    in property <bool> custom-components;
    in-out property <string> marker-query;
    in-out property <int> outcome-index;
    in-out property <bool> settings-open;
    in-out property <bool> history-open;
    in-out property <string> config-repo;
    in-out property <string> config-python;
    in-out property <string> config-binary;
    in-out property <string> config-paths;
    in-out property <int> config-backend;
    in-out property <string> config-count;
    in-out property <string> config-days;
    in-out property <string> config-gib;
    in property <string> settings-error;
    callback toggle-group(string);
    callback navigate-tree(int);
    callback expand-selected(bool);
    in property <length> reveal-y;
    in property <length> reveal-height;
    in property <int> reveal-serial;
    changed reveal-serial => {
        if root.reveal-y + test-list.content-y < 0px { test-list.content-y = -root.reveal-y; }
        if root.reveal-y + root.reveal-height + test-list.content-y > test-list.visible-height {
            test-list.content-y = test-list.visible-height - root.reveal-y - root.reveal-height;
        }
    }
    callback filter-changed;
    callback rerun-failed;
    callback show-settings;
    callback save-settings;
    callback choose-project(int);
    callback show-history;
    callback open-run(string);
    callback pin-run(string);
    callback delete-run(string);
    callback show-current;
    in property <string> selected-id;
    in property <string> selected-title: "Discovering tests…";
    in property <string> selected-path;
    in property <string> selected-status: "Not run";
    in property <string> source-code;
    pure callback highlight-source(string, bool) -> styled-text;
    in property <string> output;
    in property <string> summary: "Connecting to the Visual Editor test suite";
    in property <string> results-summary: "No tests run";
    in property <string> workspace-name;
    in property <bool> busy;
    in property <bool> ready;
    in property <bool> has-screenshot;
    in property <image> screenshot;
    in property <string> screenshot-caption: "No capture yet";
    in property <int> selected-step: -1;
    in property <string> elapsed;
    in-out property <string> query;
    in-out property <bool> failures-only;
    in-out property <bool> visible-editor;
    in-out property <bool> dark: false;
    in-out property <int> active-tab: 0;
    callback select-test(string);
    callback search(string);
    callback run-selected;
    callback debug-selected;
    callback debug-command(string);
    callback inspect-element(int);
    callback pick-element(float, float);
    callback inspector-search;
    in property <bool> debugging;
    in property <bool> paused;
    in property <bool> has-inspection;
    in property <image> inspection-image;
    in property <float> inspection-ratio: 1;
    in property <[InspectRow]> inspect-elements;
    in property <int> inspect-selected: -1;
    in property <float> highlight-x;
    in property <float> highlight-y;
    in property <float> highlight-width;
    in property <float> highlight-height;
    in property <string> inspection-details;
    in property <string> inspection-source;
    in property <string> inspection-filename;
    in property <int> property-line;
    in property <int> source-line;
    pure callback code-lines(string, bool, string) -> [string];
    pure callback raw-lines(string) -> [string];
    pure callback code-columns(string) -> int;
    pure callback styled-code(string) -> styled-text;
    in property <string> inspection-caption;
    in-out property <int> inspection-tab;
    in property <string> debug-status;
    in property <string> debug-source;
    in property <string> debug-context;
    in property <string> debug-details;
    in property <bool> debug-failure;
    in-out property <string> inspector-query;
    in-out property <string> pause-before;
    callback run-visible;
    callback stop;
    callback refresh;
    callback select-step(int);
    callback toggle-action(int);
    callback open-artifacts;

    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 68px; background: PrimerColors.bgColor-canvas-subtle;
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; spacing: 12px; cross-axis-alignment: center;
                Rectangle {
                    width: 32px; height: 32px; border-radius: 8px;
                    background: PrimerColors.bgColor-accent-emphasis;
                    Image { width: 20px; height: 20px; source: Icons.checkbox; colorize: white; }
                }
                VerticalLayout {
                    height: 40px; width: 240px; alignment: center; spacing: 3px;
                    Text { text: "Test Studio"; font-size: 17px; font-weight: 650; color: PrimerColors.fgColor-default; }
                    Text { text: "SLINT  /  VISUAL EDITOR"; font-size: 10px; font-weight: 600; color: PrimerColors.fgColor-muted; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.results-summary; color: PrimerColors.fgColor-muted; vertical-alignment: center; }
                ActionButton { label: "Project settings"; preferred-width: 150px; disabled: root.busy; activated => { root.show-settings(); } }
                ActionButton { label: "Recent runs"; preferred-width: 128px; disabled: root.busy; activated => { root.show-history(); } }
                Rectangle { width: 12px; }
                ActionButton { label: root.dark ? "Light theme" : "Dark theme"; activated => { root.dark = !root.dark; } }
            }
        }
        Rectangle { height: 1px; background: PrimerColors.borderColor-default; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 320px; background: PrimerColors.bgColor-canvas-subtle;
                VerticalLayout {
                    spacing: 0px;
                    VerticalLayout {
                        padding: 20px; spacing: 16px;
                        HorizontalLayout {
                            Text { text: "Tests"; color: PrimerColors.fgColor-default; font-weight: 650; font-size: 16px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            Label { text: "\{root.shown-count}"; }
                        }
                        PrimerTextInput {
                            text <=> root.query;
                            label-text: "Search tests"; label-visually-hidden: true;
                            placeholder: "Search tests or suites…";
                            has-leading-visual: true; leading-visual: Icons.search;
                            has-trailing-action: true;
                            edited(value) => { root.search(value); }
                        }
                        ComboBox { model: root.recent-projects; enabled: !root.busy; selected(index) => { root.choose-project(self.current-index); } }
                        PrimerTextInput {
                            text <=> root.marker-query; label-text: "Filter markers"; label-visually-hidden: true;
                            placeholder: "Filter by pytest marker…"; edited(value) => { root.filter-changed(); }
                        }
                        ComboBox {
                            model: ["All outcomes", "Failures and errors", "Passed", "Skipped", "Expected failure", "Unexpected pass", "Cancelled", "Not run"];
                            current-index <=> root.outcome-index;
                            selected(index) => { root.filter-changed(); }
                        }
                        if root.stale: Text { text: "Discovery stale — refresh to retry"; color: PrimerColors.fgColor-attention; wrap: word-wrap; font-size: 12px; }

                    }
                    Rectangle { height: 1px; background: PrimerColors.borderColor-muted; }
                    tree-keys := FocusScope {
                        vertical-stretch: 1;
                        key-pressed(event) => {
                            if event.text == Key.DownArrow { root.navigate-tree(1); return accept; }
                            if event.text == Key.UpArrow { root.navigate-tree(-1); return accept; }
                            if event.text == Key.LeftArrow { root.expand-selected(false); return accept; }
                            if event.text == Key.RightArrow { root.expand-selected(true); return accept; }
                            return reject;
                        }
                    test-list := ListView {
                        vertical-stretch: 1;
                        for row in root.tests: row-focus := FocusScope {
                            height: row.group ? 48px : 58px;
                            accessible-role: list-item; accessible-label: row.title + " · " + row.detail;
                            accessible-item-selected: root.selected-id == row.id;
                            accessible-action-default => { tree-keys.focus(); root.select-test(row.id); }

                            Rectangle {
                                background: root.selected-id == row.id ? PrimerColors.bgColor-accent-muted : row-touch.has-hover ? PrimerColors.bgColor-neutral-muted : transparent;
                                Rectangle { x: 0px; y: 0px; width: 3px; background: root.selected-id == row.id ? PrimerColors.fgColor-accent : transparent; }
                                HorizontalLayout {
                                    padding-left: 16px + row.depth * 12px; padding-right: 12px; spacing: 8px; cross-axis-alignment: center;
                                    Text { text: row.group ? (row.expanded ? "▾" : "▸") : ""; width: 12px; color: PrimerColors.fgColor-muted; }
                                    StatusDot { status: row.status; }
                                    VerticalLayout {
                                        height: 38px; alignment: center; spacing: 5px;
                                        Text { text: row.title; overflow: elide; color: PrimerColors.fgColor-default; font-size: 13px; font-weight: root.selected-id == row.id ? 600 : 400; }
                                        Text { text: row.detail; overflow: elide; color: PrimerColors.fgColor-muted; font-size: 11px; }
                                    }
                                }
                                row-touch := TouchArea { mouse-cursor: pointer; clicked => { tree-keys.focus(); root.select-test(row.id); } }
                                if row.group: TouchArea { x: 8px + row.depth * 12px; y: 0px; width: 24px; height: parent.height; mouse-cursor: pointer; clicked => { root.toggle-group(row.id); } }
                            }
                        }
                    }
                    }
                    if root.tests.length == 0: Text { text: root.busy ? "Discovering tests…" : "No matching tests"; color: PrimerColors.fgColor-muted; height: 60px; horizontal-alignment: center; }
                    Rectangle { height: 1px; background: PrimerColors.borderColor-muted; }
                    HorizontalLayout {
                        padding: 16px;
                        Text { text: root.suite-summary; overflow: elide; color: PrimerColors.fgColor-muted; font-size: 12px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "Refresh"; preferred-width: 86px; disabled: root.busy; activated => { root.refresh(); } }
                    }
                }
            }
            Rectangle { width: 1px; background: PrimerColors.borderColor-default; }
            VerticalLayout {
                spacing: 0px;
                VerticalLayout {
                    padding: 24px; spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.historical ? "HISTORICAL RUN" : "VISUAL EDITOR"; color: PrimerColors.fgColor-muted; font-size: 11px; font-weight: 650; }
                        Rectangle { horizontal-stretch: 1; }
                        StatusDot { status: root.selected-status; }
                        Text { text: root.selected-status; color: PrimerColors.fgColor-muted; font-size: 12px; }
                        Text { text: root.elapsed; color: PrimerColors.fgColor-muted; font-size: 12px; }
                    }
                    Text { text: root.selected-title; font-size: 24px; font-weight: 600; color: PrimerColors.fgColor-default; wrap: word-wrap; }
                    Text { text: root.selected-path; color: PrimerColors.fgColor-muted; font-size: 12px; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px; padding-top: 8px;
                        ActionButton { label: "Run selected"; variant: primary; disabled: root.busy || !root.ready || root.selected-id == ""; activated => { root.run-selected(); } }
                        ActionButton { label: "Debug selected"; preferred-width: 144px; disabled: root.busy || !root.ready || root.selected-id == ""; activated => { root.debug-selected(); } }
                        ActionButton { label: "Run shown (\{root.shown-count})"; preferred-width: 140px; disabled: root.busy || !root.ready || root.shown-count == 0; activated => { root.run-visible(); } }
                        ActionButton { label: "Rerun failed"; disabled: root.busy || !root.can-rerun; activated => { root.rerun-failed(); } }
                        ActionButton { label: "Stop"; preferred-width: 72px; disabled: !root.busy; activated => { root.stop(); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.historical: ActionButton { label: "Current tests"; disabled: root.busy; activated => { root.show-current(); } }
                        Label { text: root.visible-editor ? "Visible editor" : "Headless"; }
                    }
                }
                UnderlineNav {
                    height: 44px; accessible-name: "Test details";
                    items: [
                        { label: "Run details", enabled: true, counter: "", has-leading-icon: true, leading-icon: Icons.history },
                        { label: "Source", enabled: true, counter: "", has-leading-icon: true, leading-icon: Icons.file },
                        { label: "Output", enabled: true, counter: "", has-leading-icon: true, leading-icon: Icons.book },
                        { label: "Environment", enabled: true, counter: "", has-leading-icon: false },
                        { label: "Inspect & debug", enabled: true, counter: "", has-leading-icon: false },
                    ];
                    selected-index: root.active-tab;
                    item-activated(index) => { root.active-tab = index; }
                }
                if root.active-tab == 0: HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: 254px;
                        VerticalLayout {
                            padding: 20px; spacing: 12px;
                            Text { text: "Execution steps"; color: PrimerColors.fgColor-default; font-weight: 600; }
                            Text { text: "Select an action for its capture and Output details. Expand groups with the arrow."; wrap: word-wrap; color: PrimerColors.fgColor-muted; font-size: 12px; }
                            step-list := ListView {
                                vertical-stretch: 1;
                                for step[index] in root.steps: FocusScope {
                                    height: 72px;
                                    accessible-role: list-item; accessible-label: step.title;
                                    accessible-item-selected: root.selected-step == step.row-index;
                                    accessible-expanded: step.group && step.expanded;
                                    accessible-action-expand => { if step.group { root.toggle-action(step.row-index); } }
                                    accessible-action-default => { root.select-step(step.row-index); }
                                    key-pressed(event) => {
                                        if step.group && ((event.text == Key.LeftArrow && step.expanded) || (event.text == Key.RightArrow && !step.expanded)) { root.toggle-action(step.row-index); return accept; }
                                        if event.text == Key.Return || event.text == Key.Space { root.select-step(step.row-index); return accept; }
                                        return reject;
                                    }
                                    Rectangle {
                                        border-radius: 6px;
                                        background: root.selected-step == step.row-index ? PrimerColors.bgColor-accent-muted : step-touch.has-hover ? PrimerColors.bgColor-canvas-subtle : transparent;
                                        HorizontalLayout {
                                            padding: 12px; spacing: 10px; cross-axis-alignment: center;
                                            padding-left: 12px + min(step.depth, 6) * 10px;
                                            Text { text: step.group ? (step.expanded ? "▾" : "▸") : ""; width: 12px; color: PrimerColors.fgColor-muted; }
                                            StatusDot { status: step.status; }
                                            VerticalLayout {
                                                height: 46px; spacing: 4px; alignment: center;
                                                Text { text: step.title; height: 28px; color: PrimerColors.fgColor-default; font-size: 12px; font-weight: 550; wrap: word-wrap; overflow: elide; }
                                                Text { text: step.detail; color: PrimerColors.fgColor-muted; font-size: 11px; overflow: elide; }
                                            }
                                        }
                                        step-touch := TouchArea { mouse-cursor: pointer; clicked => { if step.group && self.mouse-x < 35px + min(step.depth, 6) * 10px { root.toggle-action(step.row-index); } else { root.select-step(step.row-index); } } }
                                    }
                                }
                            }
                            if root.steps.length == 0: Text { text: "Steps appear when you run this test."; wrap: word-wrap; color: PrimerColors.fgColor-muted; font-size: 12px; }
                        }
                    }
                    Rectangle { width: 1px; background: PrimerColors.borderColor-muted; }
                    Rectangle {
                        horizontal-stretch: 1; background: PrimerColors.bgColor-inset;
                        VerticalLayout {
                            padding: 20px; spacing: 16px;
                            HorizontalLayout {
                                Text { text: "Application preview"; font-weight: 600; color: PrimerColors.fgColor-default; }
                                Rectangle { horizontal-stretch: 1; }
                                Label { text: "Snapshot"; }
                            }
                            Rectangle {
                                vertical-stretch: 1; border-radius: 8px; border-width: 1px; border-color: PrimerColors.borderColor-default;
                                background: PrimerColors.bgColor-default; clip: true;
                                if root.has-screenshot: Image { width: 100%; height: 100%; source: root.screenshot; image-fit: contain; }
                                if !root.has-screenshot: VerticalLayout {
                                    alignment: center; padding: 32px; spacing: 16px;
                                    HorizontalLayout { alignment: center; Image { source: Icons.layout_grid; colorize: PrimerColors.fgColor-muted; width: 36px; height: 36px; } }
                                    Text { text: "See the test in action"; font-size: 18px; font-weight: 600; horizontal-alignment: center; color: PrimerColors.fgColor-default; }
                                    Text { text: "Run a test to capture the editor at each stage.\nSelect a capture to review what happened."; wrap: word-wrap; horizontal-alignment: center; color: PrimerColors.fgColor-muted; font-size: 13px; }
                                }
                            }
                            Text { text: root.screenshot-caption; color: PrimerColors.fgColor-muted; font-size: 12px; overflow: elide; }
                            HorizontalLayout {
                                Text { text: "Captured from the real Slint application"; color: PrimerColors.fgColor-muted; font-size: 11px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { label: "Artifacts"; preferred-width: 86px; disabled: !root.has-artifacts; activated => { root.open-artifacts(); } }
                            }
                        }
                    }
                }
                if root.active-tab == 1: SourceView {
                    source: root.source-code;
                    highlighted: root.highlight-source(root.source-code, root.dark);
                    historical: root.historical;
                }
                if root.active-tab == 2: TextEdit {
                    text: root.run-diagnostics + "\n\n" + root.output; read-only: true; font-family: "Menlo"; font-size: 12px;
                }
                if root.active-tab == 4: VerticalLayout {
                    padding: 16px; spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton { label: "Pause"; preferred-width: 70px; disabled: !root.debugging || root.paused; activated => { root.debug-command("pause"); } }
                        ActionButton { label: "Continue"; preferred-width: 88px; disabled: !root.paused; activated => { root.debug-command("continue"); } }
                        ActionButton { label: "Step over"; preferred-width: 108px; disabled: !root.paused; activated => { root.debug-command("step"); } }
                        ActionButton { label: "Step into"; preferred-width: 108px; disabled: !root.paused; activated => { root.debug-command("into"); } }
                        ActionButton { label: "Refresh view"; preferred-width: 112px; disabled: !root.paused; activated => { root.debug-command("inspect"); } }
                        Rectangle { horizontal-stretch: 1; }
                        Label { text: root.paused ? "Test paused" : "Captured state"; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        PrimerTextInput { text <=> root.pause-before; label-text: "Pause before action"; label-visually-hidden: true; placeholder: "Pause before action containing…"; }
                        ActionButton { label: "Set breakpoint"; preferred-width: 128px; disabled: !root.debugging; activated => { root.debug-command("breakpoint"); } }
                    }
                    HorizontalLayout {
                        spacing: 12px; cross-axis-alignment: center;
                        Text { text: root.debug-status; color: root.debug-failure ? PrimerColors.fgColor-danger : PrimerColors.fgColor-default; font-weight: 600; font-size: 17px; overflow: elide; horizontal-stretch: 1; }
                        if root.debug-failure: ActionButton { label: "Show details"; preferred-width: 128px; activated => { root.inspection-tab = 2; } }
                    }
                    if root.debug-context != "": Text { text: root.debug-context; color: PrimerColors.fgColor-muted; font-size: 12px; overflow: elide; }
                    Text { text: root.debug-source; height: 34px; color: PrimerColors.fgColor-muted; font-family: "Menlo"; font-size: 11px; wrap: word-wrap; overflow: elide; }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            width: 190px; spacing: 8px;
                            PrimerTextInput { text <=> root.inspector-query; label-text: "Find element"; label-visually-hidden: true; placeholder: "Find element…"; edited(value) => { root.inspector-search(); } }
                            ListView {
                                for element in root.inspect-elements: Rectangle {
                                    height: 48px; border-radius: 4px;
                                    background: root.inspect-selected == element.index ? PrimerColors.bgColor-accent-muted : PrimerColors.bgColor-canvas-subtle;
                                    accessible-role: list-item; accessible-label: "Inspect " + element.title;
                                    accessible-action-default => { root.inspect-element(element.index); }
                                    VerticalLayout {
                                        padding: 6px; spacing: 3px;
                                        Text { text: element.title; font-size: 12px; color: PrimerColors.fgColor-default; overflow: elide; }
                                        Text { text: element.detail; font-size: 10px; color: PrimerColors.fgColor-muted; }
                                    }
                                    TouchArea { clicked => { root.inspect-element(element.index); } }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            inspect-preview := Rectangle {
                                vertical-stretch: 1; min-height: 150px; background: PrimerColors.bgColor-inset; clip: true;
                                preview-content := Rectangle {
                                    accessible-role: image; accessible-label: "Inspection capture";
                                    width: min(parent.width, parent.height * root.inspection-ratio);
                                    height: self.width / max(0.01, root.inspection-ratio);
                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                    if root.has-inspection: Image { width: 100%; height: 100%; source: root.inspection-image; }
                                    if root.has-inspection && root.inspect-selected >= 0: Rectangle {
                                        x: parent.width * root.highlight-x; y: parent.height * root.highlight-y;
                                        width: parent.width * root.highlight-width; height: parent.height * root.highlight-height;
                                        background: #0969da25; border-width: 2px; border-color: #0969da;
                                    }
                                    TouchArea { enabled: root.has-inspection; clicked => { root.pick-element(self.mouse-x / self.width, self.mouse-y / self.height); } }
                                }
                            }
                            Text { text: "Click to pick by bounds; click again to cycle overlaps. Timers keep running while the test is paused."; font-size: 11px; color: PrimerColors.fgColor-muted; wrap: word-wrap; }
                            Text { text: root.inspection-caption; font-size: 11px; color: PrimerColors.fgColor-muted; wrap: word-wrap; }
                        }
                        VerticalLayout {
                            width: 350px; spacing: 8px;
                            ComboBox { model: ["Properties & locator", "Application source", "Failure details"]; current-index <=> root.inspection-tab; }
                            if root.inspection-tab < 2: InspectorCode {
                                source: root.inspection-tab == 0 ? root.inspection-details : root.inspection-source;
                                caption: root.inspection-tab == 0 ? "Captured properties" : root.inspection-filename;
                                lines: root.code-lines(self.source, root.dark, root.inspection-tab == 1 ? "slint" : "plain");
                                raw-lines: root.raw-lines(self.source);
                                columns: root.code-columns(self.source);
                                marked-line: root.inspection-tab == 0 ? root.property-line : root.source-line;
                                styled(markup) => { return root.styled-code(markup); }
                            }
                            if root.inspection-tab == 2: TextEdit { text: root.debug-details; read-only: true; font-family: "Menlo"; font-size: 11px; }
                        }
                    }
                }
                if root.active-tab == 3: TextEdit {
                    text: root.environment-info; read-only: true; font-family: "Menlo"; font-size: 12px;
                }
            }
        }
        Rectangle { height: 1px; background: PrimerColors.borderColor-default; }
        Rectangle {
            height: 34px; background: PrimerColors.bgColor-canvas-subtle;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 12px; cross-axis-alignment: center;
                StatusDot { status: root.busy ? "Running" : "Not run"; }
                Text { text: root.summary; color: PrimerColors.fgColor-muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                Rectangle { horizontal-stretch: 1; }
                if root.custom-components: Label { text: "Custom Primer components"; }
                Text { text: root.workspace-name; color: PrimerColors.fgColor-muted; font-size: 11px; vertical-alignment: center; }
            }
        }
    }
    if root.settings-open || root.history-open: Rectangle {
        background: #00000066;
        TouchArea { }
        Rectangle {
            width: min(780px, parent.width - 64px); height: min(790px, parent.height - 64px);
            border-radius: 12px; background: PrimerColors.bgColor-default;
            border-width: 1px; border-color: PrimerColors.borderColor-default;
            VerticalLayout {
                padding: 24px; spacing: 16px;
                HorizontalLayout {
                    Text { text: root.settings-open ? "Project settings" : "Recent runs"; font-size: 22px; font-weight: 600; color: PrimerColors.fgColor-default; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { label: "Close"; preferred-width: 80px; activated => { root.settings-open = false; root.history-open = false; } }
                }
                if root.settings-open: VerticalLayout {
                    spacing: 12px;
                    Text { text: "Use an existing test environment and editor build."; color: PrimerColors.fgColor-muted; }
                    PrimerTextInput { label-text: "Repository checkout"; text <=> root.config-repo; }
                    PrimerTextInput { label-text: "Test Python interpreter"; text <=> root.config-python; }
                    PrimerTextInput { label-text: "Editor binary"; text <=> root.config-binary; }
                    Text { text: "Discovery paths · absolute or relative to tools/editor/ui-tests, one per line"; color: PrimerColors.fgColor-default; font-size: 12px; }
                    TextEdit { text <=> root.config-paths; height: 64px; }
                    HorizontalLayout {
                        Text { text: "Editor backend"; color: PrimerColors.fgColor-default; vertical-alignment: center; }
                        ComboBox { model: ["Headless Skia", "Visible Skia"]; current-index <=> root.config-backend; }
                    }
                    Text { text: "History retention · active and pinned runs are protected"; color: PrimerColors.fgColor-default; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 16px;
                        PrimerTextInput { label-text: "Completed runs"; text <=> root.config-count; }
                        PrimerTextInput { label-text: "Days"; text <=> root.config-days; }
                        PrimerTextInput { label-text: "Storage target (GiB)"; text <=> root.config-gib; }
                    }
                    Text { text: root.settings-error; color: PrimerColors.fgColor-danger; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "Save project"; variant: primary; activated => { root.save-settings(); } }
                    }
                }
                if root.history-open: ListView {
                    for run in root.run-history: Rectangle {
                        height: 78px;
                        border-width: 1px; border-color: PrimerColors.borderColor-muted;
                        HorizontalLayout {
                            spacing: 12px; padding-top: 12px; padding-bottom: 12px; cross-axis-alignment: center;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: run.title; color: PrimerColors.fgColor-default; font-weight: 600; }
                                Text { text: run.detail; color: PrimerColors.fgColor-muted; font-size: 12px; }
                            }
                            ActionButton { label: "Open"; preferred-width: 72px; activated => { root.open-run(run.id); } }
                            ActionButton { label: run.pinned ? "Unpin" : "Pin"; preferred-width: 72px; activated => { root.pin-run(run.id); } }
                            ActionButton { label: "Delete"; preferred-width: 72px; disabled: run.pinned; activated => { root.delete-run(run.id); } }
                        }
                    }
                }
            }
        }
    }

}
