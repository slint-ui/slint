<?xml version="1.0" encoding="UTF-8"?>
<!-- cspell:ignore launchable -->
<!-- @VERSION@ and @DATE@ are filled in by the flatpak build, see dev.slint.VisualEditor.yml -->
<component type="desktop-application">
    <id>dev.slint.VisualEditor</id>

    <name>Slint Visual Editor</name>
    <summary>Design and edit Slint user interfaces</summary>

    <metadata_license>MIT</metadata_license>
    <project_license>LicenseRef-proprietary=https://github.com/slint-ui/slint/blob/master/LICENSE.md</project_license>

    <developer id="dev.slint">
        <name>SixtyFPS GmbH</name>
    </developer>

    <description>
        <p>
            The Slint Visual Editor is a live design tool for user interfaces
            written in the Slint UI language. Edit .slint files visually,
            preview them instantly, and inspect the element tree and
            properties of a running design.
        </p>
    </description>

    <categories>
        <category>Development</category>
    </categories>

    <keywords>
        <keyword>development</keyword>
        <keyword>gui</keyword>
        <keyword>designer</keyword>
        <keyword>slint</keyword>
    </keywords>

    <url type="homepage">https://slint.dev/</url>
    <url type="bugtracker">https://github.com/slint-ui/slint/issues</url>

    <launchable type="desktop-id">dev.slint.VisualEditor.desktop</launchable>

    <content_rating type="oars-1.1"/>

    <releases>
        <release version="@VERSION@" date="@DATE@"/>
    </releases>
</component>
