export component SimulatorWindow inherits Window {
    title: "Slint Live Preview";
    preferred-width: 800px;
    preferred-height: 600px;
    background: root.frame-enabled
        ? (Platform.os == OperatingSystemType.windows ? #181818 : transparent)
        : #202020;
    no-frame: root.frame-enabled;
    resize-border-width: 0px;
    min-width: root.frame-enabled ? 232.8px : 0px;
    min-height: root.frame-enabled ? 563.6px : 0px;

    in property <component-factory> preview-factory;
    in-out property <bool> frame-enabled: false;
    private property <float> phone-scale: max(0.6, root.width / 388px);
    callback presentation-changed(bool);
    callback quit-requested();

    changed frame-enabled => {
        root.presentation-changed(root.frame-enabled);
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Close Window";
                shortcut: @keys(Control + W);
                activated => {
                    root.quit-requested();
                }
            }
        }

        Menu {
            title: "View";
            MenuItem {
                title: "Android Phone Frame";
                checkable: true;
                checked <=> root.frame-enabled;
            }
        }
    }

    if !root.frame-enabled: ComponentContainer {
        width: root.width;
        height: root.height;
        component-factory: root.preview-factory;
    }

    if root.frame-enabled: device-stage := Rectangle {
        x: (root.width - self.width * root.phone-scale) / 2;
        y: 68px;
        width: 388px;
        height: 826px;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.phone-scale;

        screen := Rectangle {
            x: 14px;
            y: 13px;
            width: 360px;
            height: 800px;
            border-radius: 32px;
            clip: true;
            background: black;

            ComponentContainer {
                width: parent.width;
                height: parent.height;
                component-factory: root.preview-factory;
            }
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: @image-url("assets/android-phone-frame.png");
            image-fit: fill;
        }
    }

    if root.frame-enabled: control-bar := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: 52px;
        background: #202020;
        border-width: 1px;
        border-color: #484848;
        border-radius: self.height / 2;

        WindowMoveArea {
            x: 18px;
            y: 10px;
            width: parent.width - 36px;
            height: parent.height - 20px;
        }

        close-button := Rectangle {
            x: 14px;
            y: 13px;
            width: 26px;
            height: 26px;
            border-radius: self.width / 2;
            background: close-touch.pressed ? #c92638 : close-touch.has-hover ? #ff6573 : #ff4d5f;

            Text {
                text: "×";
                color: #531018;
                font-size: 18px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-touch := TouchArea {
                accessible-role: button;
                accessible-label: "Close simulator";
                mouse-cursor: pointer;
                clicked => {
                    root.quit-requested();
                }
            }
        }

        Text {
            x: 54px;
            y: 8px;
            width: parent.width - 108px;
            height: 20px;
            text: "Android Phone";
            color: #f2f2f2;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: 54px;
            y: 27px;
            width: parent.width - 108px;
            height: 17px;
            text: "360 × 800";
            color: #9b9b9b;
            font-size: 11px;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 48px;
            y: 23px;
            width: 32px;
            height: 6px;
            border-radius: self.height / 2;
            background: #555;
        }
    }
}
