export component RepeatedPaletteDrops inherits Window {
    width: 388px;
    height: 718px;
    background: #f8fafc;

    drop-target := Rectangle {
        x: 64px;
        y: 96px;
        width: 260px;
        height: 200px;
        background: #2563eb;
        Image {
            source: @image-url("EDIT_ME.png");
            x: 50px;
            y: 52px;
            width: 160px;
            height: 96px;
            image-fit: contain;
        }
    }

    Text {
        y: 320px;
        text: "Reload probe";
    }
}
