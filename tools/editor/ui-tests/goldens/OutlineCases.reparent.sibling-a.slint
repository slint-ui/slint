export component OutlineCases inherits Window {
    width: 640px;
    height: 480px;
    background: #f8fafc;

    container := Rectangle {
        x: 24px;
        y: 24px;
        width: 240px;
        height: 180px;
        background: #dbeafe;

        child-a := Rectangle {
            x: 16px;
            y: 16px;
            width: 72px;
            height: 48px;
            background: #2563eb;
        }

        child-b := Text {
            x: 16px;
            y: 88px;
            text: "Child";
            color: #111827;
        }
        sibling-a := Rectangle {
            width: 96px;
            height: 64px;
            background: #16a34a;
        }
    }


    sibling-b := Image {
        x: 304px;
        y: 136px;
        width: 96px;
        height: 64px;
        source: @image-url("assets/checker.svg");
    }
}
