export component RepeatedPaletteDrops inherits Window {
    width: 388px;
    height: 718px;
    background: #f8fafc;

    drop-target := Rectangle {
        x: 64px;
        y: 96px;
        width: 260px;
        height: 200px;
        background: #2563eb;
        Rectangle {
            x: 50px;
            y: 68px;
            width: 160px;
            height: 64px;
            background: #ffffff;
            border-radius: 12px;
            border-color: #d0d7de;
            border-width: 1px;
        }
    }

    Text {
        y: 320px;
        text: "Reload probe";
    }
}
