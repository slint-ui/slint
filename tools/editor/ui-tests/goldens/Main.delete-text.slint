import { NestedCard } from "components/Nested.slint";

export component Main inherits Window {
    width: 640px;
    height: 480px;
    background: #f8fafc;

    root-rectangle := Rectangle {
        x: 40px;
        y: 40px;
        width: 180px;
        height: 120px;
        background: #2563eb;
        border-radius: 12px;
    }


    root-image := Image {
        x: 230px;
        y: 132px;
        width: 128px;
        height: 96px;
        source: @image-url("assets/checker.svg");
        image-fit: contain;
    }

    NestedCard {
        x: 40px;
        y: 216px;
    }
}
