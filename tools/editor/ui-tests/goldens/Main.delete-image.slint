import { NestedCard } from "components/Nested.slint";

export component Main inherits Window {
    width: 640px;
    height: 480px;
    background: #f8fafc;

    root-rectangle := Rectangle {
        x: 40px;
        y: 40px;
        width: 180px;
        height: 120px;
        background: #2563eb;
        border-radius: 12px;
    }

    root-text := Text {
        x: 180px;
        y: 56px;
        width: 180px;
        height: 48px;
        text: "Fixture text";
        color: #111827;
        font-size: 20px;
    }


    NestedCard {
        x: 40px;
        y: 216px;
    }
}
