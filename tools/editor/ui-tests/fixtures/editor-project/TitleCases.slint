import { GroupBox, RadioGroup, TabWidget } from "std-widgets.slint";

export component TitleCases inherits Window {
    width: 640px;
    height: 480px;

    titled-group-box := GroupBox {
        x: 32px;
        y: 32px;
        width: 240px;
        height: 120px;
        title: "Options";
    }

    untitled-radio-group := RadioGroup {
        x: 32px;
        y: 192px;
        width: 240px;
        RadioButton {
            text: "First";
        }
    }

    TabWidget {
        x: 320px;
        y: 32px;
        width: 240px;
        height: 120px;
        titled-tab := Tab {
            title: "General";
        }
    }
}
