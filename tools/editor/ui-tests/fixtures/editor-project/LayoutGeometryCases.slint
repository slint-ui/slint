export component LayoutGeometryCases inherits Window {
    width: 640px;
    height: 480px;

    geometry-layout := HorizontalLayout {
        x: 32px;
        y: 32px;
        width: 400px;
        height: 200px;
        alignment: start;

        layout-child := Rectangle {
            width: 80px;
            background: #2563eb;
        }
    }
}
