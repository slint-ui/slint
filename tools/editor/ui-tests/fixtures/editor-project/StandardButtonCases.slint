import { StandardButton } from "std-widgets.slint";

export component StandardButtonCases inherits Window {
    width: 640px;
    height: 480px;

    default-standard-button := StandardButton {
        x: 32px;
        y: 32px;
    }

    cancel-standard-button := StandardButton {
        x: 32px;
        y: 96px;
        kind: cancel;
    }
}
