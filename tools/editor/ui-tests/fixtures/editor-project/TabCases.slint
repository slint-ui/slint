import { TabWidget } from "std-widgets.slint";

export component TabCases inherits Window {
    width: 640px;
    height: 480px;

    empty-tabs := TabWidget {
        x: 32px;
        y: 32px;
        width: 280px;
        height: 200px;
    }

    tabs := TabWidget {
        x: 32px;
        y: 256px;
        width: 280px;
        height: 200px;
        first-tab := Tab {
            title: "Tab 1";
        }
    }
}
