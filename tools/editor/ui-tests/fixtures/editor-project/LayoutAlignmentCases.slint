export component LayoutAlignmentCases inherits Window {
    width: 640px;
    height: 480px;

    default-horizontal-layout := HorizontalLayout {
        x: 32px;
        y: 32px;
        width: 200px;
        height: 64px;

        Rectangle { }
    }

    center-vertical-layout := VerticalLayout {
        x: 32px;
        y: 128px;
        width: 200px;
        height: 120px;
        alignment: center;

        Rectangle { }
    }

    default-flexbox-layout := FlexboxLayout {
        x: 32px;
        y: 280px;
        width: 200px;
        height: 120px;

        Rectangle { }
    }
}
