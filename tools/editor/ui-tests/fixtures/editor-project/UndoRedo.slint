export component UndoRedo inherits Window {
    width: 640px;
    height: 480px;
    background: #f8fafc;

    root-rectangle := Rectangle {
        x: 80px;
        y: 80px;
        width: 180px;
        height: 120px;
        background: #2563eb;
        transform-rotation: 0deg;
        border-radius: 12px;
    }
}
