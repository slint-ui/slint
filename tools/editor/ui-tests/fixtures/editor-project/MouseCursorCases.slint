export component MouseCursorCases inherits Window {
    width: 640px;
    height: 480px;

    default-touch-area := TouchArea {
        x: 32px;
        y: 32px;
        width: 200px;
        height: 100px;
    }

    pointer-touch-area := TouchArea {
        x: 32px;
        y: 160px;
        width: 200px;
        height: 100px;
        mouse-cursor: pointer;
        TouchArea {
            x: 43px;
            y: -28px;
            width: 160px;
            height: 96px;
            mouse-cursor: text;
        }
    }
}
