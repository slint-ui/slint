import { Button } from "std-widgets.slint";

export component CheckableCases inherits Window {
    width: 640px;
    height: 480px;

    plain-button := Button {
        x: 32px;
        y: 32px;
        text: "Plain";
    }

    checkable-button := Button {
        x: 32px;
        y: 96px;
        text: "Checkable";
        checkable: true;
    }
}
