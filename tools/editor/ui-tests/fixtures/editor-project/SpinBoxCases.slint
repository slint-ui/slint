import { SpinBox } from "std-widgets.slint";

export component SpinBoxCases inherits Window {
    width: 640px;
    height: 480px;

    default-spinbox := SpinBox {
        x: 32px;
        y: 32px;
        width: 200px;
    }

    ranged-spinbox := SpinBox {
        x: 32px;
        y: 96px;
        width: 200px;
        minimum: 10;
        maximum: 50;
        value: 20;
        step-size: 5;
    }
}
