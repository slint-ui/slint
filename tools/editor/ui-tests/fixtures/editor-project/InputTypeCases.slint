import { LineEdit } from "std-widgets.slint";

export component InputTypeCases inherits Window {
    width: 640px;
    height: 480px;

    default-line-edit := LineEdit {
        x: 32px;
        y: 32px;
        width: 200px;
        text: "Default";
    }

    password-line-edit := LineEdit {
        x: 32px;
        y: 96px;
        width: 200px;
        text: "Password";
        input-type: password;
    }
    Image {
        source: @image-url("EDIT_ME.png");
        x: 83px;
        y: 143px;
        width: 160px;
        height: 96px;
        image-fit: contain;
    }
}
