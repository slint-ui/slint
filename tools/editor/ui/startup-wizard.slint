import { Style } from "style.slint";
import { Palette } from "std-widgets.slint";
import { Project } from "project.slint";

global WizardTheme {
    out property <bool> dark: Style.dark;
    out property <color> stage-bg: Style.welcome.stage-bg;
    out property <color> shell-bg: Style.welcome.shell-bg;
    out property <color> side-bg: Style.welcome.side-bg;
    out property <color> control-bg: Style.welcome.control-bg;
    out property <color> control-hover: Style.welcome.control-hover;
    out property <color> text: Style.welcome.text;
    out property <color> muted: Style.welcome.muted;
    out property <color> accent: Style.welcome.accent;
}

component BrandMark inherits Rectangle {
    in-out property <length> mark-size: 90px;

    width: mark-size;
    height: mark-size;
    border-radius: mark-size * 23%;
    background: Style.welcome.brand-brush;
    clip: true;
    drop-shadow-blur: Style.shadows.brand.blur;
    drop-shadow-offset-y: Style.shadows.brand.offset-y;
    drop-shadow-color: Style.shadows.brand.color;

    for row in 4: Rectangle {
        y: root.mark-size * (22% + row * 19%);
        height: Style.controls.border-width;
        background: Style.welcome.brand-grid-horizontal;
    }

    for col in 4: Rectangle {
        x: root.mark-size * (22% + col * 19%);
        width: Style.controls.border-width;
        background: Style.welcome.brand-grid-vertical;
    }

    Image {
        width: parent.width * 56%;
        height: parent.height * 56%;
        source: @image-url("assets/slint-mark.svg");
        colorize: Style.colors.action-text;
        opacity: 0.94;
    }
}

component ActionIcon inherits Rectangle {
    in property <bool> folder: false;

    width: 18px;
    height: 18px;
    background: transparent;

    Image {
        width: 18px;
        height: 18px;
        source: root.folder
            ? @image-url("assets/primer-folder-open.svg")
            : @image-url("assets/primer-plus-circle.svg");
        colorize: Style.welcome.muted;
    }
}

component WelcomeAction inherits Rectangle {
    in property <string> label;
    in property <bool> folder: false;
    in property <bool> enabled: true;
    callback clicked;

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    height: Style.welcome.action-height;
    border-radius: Style.welcome.action-radius;
    background: touch.pressed ? Style.welcome.pressed-bg : touch.has-hover ? Style.welcome.control-hover : Style.welcome.control-bg;
    animate background { duration: Style.motion.feedback; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: Style.welcome.action-inset;
        padding-right: Style.welcome.action-inset;
        spacing: Style.spacing.control-inset;
        cross-axis-alignment: center;

        ActionIcon {
            folder: root.folder;
        }

        Text {
            text: root.label;
            color: Style.welcome.text;
            font-size: Style.typography.action.size;
            font-weight: FontWeight.extra-bold;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component RecentProjectRow inherits Rectangle {
    in property <string> title;
    in property <string> path;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback opened;

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.title;
    accessible-description: root.path;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.opened();
        }
    }

    height: Style.welcome.recent-height;
    border-radius: Style.welcome.recent-radius;
    background: selected ? Style.welcome.accent : (touch.has-hover && enabled ? Style.welcome.control-hover : transparent);
    animate background { duration: Style.motion.normal; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: Style.welcome.action-inset;
        padding-right: Style.welcome.recent-inset-right;
        spacing: Style.welcome.recent-gap;
        cross-axis-alignment: center;

        Image {
            width: Style.welcome.recent-icon-size;
            height: Style.welcome.recent-icon-size;
            source: @image-url("assets/primer-file-code.svg");
            colorize: root.selected ? Style.colors.action-text : Style.welcome.accent;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Style.welcome.recent-text-gap;

            Text {
                text: root.title;
                color: root.selected ? Style.colors.action-text : Style.welcome.text;
                font-size: Style.typography.body.size;
                font-weight: FontWeight.extra-bold;
                overflow: elide;
            }

            Text {
                text: root.path;
                color: root.selected ? Style.welcome.selected-muted : Style.welcome.muted;
                font-size: Style.typography.control.size;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.opened();
        }
        double-clicked => {
            root.opened();
        }

        Tooltip {
            text: @markdown("\{root.path}");
        }
    }
}

export component StartupWizard inherits Rectangle {
    callback opened;
    callback create-new-project;
    callback open-existing-project;

    property <length> shell-width: min(root.width - 2 * Style.welcome.outer-inset, Style.welcome.shell-width);
    property <length> shell-height: min(root.height - 2 * Style.welcome.outer-inset, Style.welcome.shell-height);
    property <length> shell-left: (root.width - shell-width) / 2;
    property <length> shell-top: (root.height - shell-height) / 2;
    property <length> side-width: shell-width < Style.welcome.compact-threshold ? Style.welcome.compact-side-width : Style.welcome.side-width;
    property <length> main-width: shell-width - side-width;

    accessible-role: AccessibleRole.region;
    accessible-label: "Startup wizard";

    background: Style.welcome.stage-bg;

    Rectangle {
        x: root.shell-left;
        y: root.shell-top;
        width: root.shell-width;
        height: root.shell-height;
        border-radius: Style.welcome.shell-radius;
        border-width: Style.controls.border-width;
        border-color: Style.welcome.shell-border;
        background: Style.welcome.shell-bg;
        clip: true;
        drop-shadow-blur: Style.shadows.welcome.blur;
        drop-shadow-offset-y: Style.shadows.welcome.offset-y;
        drop-shadow-color: Style.shadows.welcome.color;
        animate width, height, x, y { duration: Style.motion.layout; easing: ease-out-quad; }

        Rectangle {
            width: root.main-width;
            background: Style.welcome.shell-bg;
        }

        side-panel := Rectangle {
            x: root.main-width;
            width: root.side-width;
            background: Style.welcome.side-bg;
        }

        brand := BrandMark {
            mark-size: Style.welcome.brand-size;
            x: (root.main-width - self.width) / 2;
            y: Style.welcome.hero-top;
        }

        hero-title := Text {
            x: 0px;
            y: brand.y + brand.height + Style.welcome.hero-gap;
            width: root.main-width;
            height: Style.welcome.hero-title-height;
            text: "Slint Visual Editor";
            color: Style.welcome.text;
            font-size: Style.typography.hero.size;
            font-weight: FontWeight.semi-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 0px;
            y: hero-title.y + hero-title.height - 2px;
            width: root.main-width;
            height: Style.welcome.hero-subtitle-height;
            text: "Version 1.0";
            color: Style.welcome.muted;
            font-size: Style.typography.action.size;
            horizontal-alignment: center;
        }

        welcome-actions := VerticalLayout {
            x: Style.welcome.action-block-inset;
            y: root.shell-height - Style.welcome.action-bottom-inset;
            width: root.main-width - 2 * Style.welcome.action-block-inset;
            height: Style.welcome.action-block-height;
            spacing: Style.welcome.action-block-gap;
            WelcomeAction {
                label: "Create New Project...";
                clicked => {
                    root.create-new-project();
                }
            }

            WelcomeAction {
                label: "Open Existing Project...";
                folder: true;
                clicked => {
                    root.open-existing-project();
                }
            }
        }

        recent-list := VerticalLayout {
            x: root.main-width + Style.welcome.recent-panel-inset;
            y: Style.welcome.recent-panel-inset;
            width: root.side-width - 2 * Style.welcome.recent-panel-inset;
            height: Style.welcome.recent-panel-height;
            spacing: Style.welcome.recent-panel-gap;

            for project[index] in Project.recent: RecentProjectRow {
                title: project.name;
                path: project.root-path;
                selected: index == 0;
                opened => {
                    Project.open-recent-project(project);
                }
            }
        }
    }
}
