export global Images {
    out property <image> bg-frame: @image-url("bg-frame.svg");
    out property <image> bg-frame-light: @image-url("bg-frame-light.svg");
    out property <image> bg-frame-lines: @image-url("bg-frame-lines.svg");
    out property <image> bg-frame-lines-light: @image-url("bg-frame-lines-light.svg");
    out property <image> bg-frame-mark: @image-url("bg-frame-mark.svg");
    out property <image> bg-frame-mark-light: @image-url("bg-frame-mark-light.svg");
    out property <image> checkerboard: @image-url("checkerboard.svg");
    out property <image> image-fit-preview: @image-url("image-fit-preview.svg");
    out property <image> slint-logo-small-light: @image-url("slint-logo-small-light.png");
    out property <image> slint-mark: @image-url("slint-mark.svg");
}
