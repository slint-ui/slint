import { Api, CoordinateSpace, Geometry, Hover, ResizeHandle } from "api.slint";
import { CanvasView } from "components/canvas-view.slint";

export struct SnapGuide {
    start-x: length,
    start-y: length,
    end-x: length,
    end-y: length,
    label: string,
}

export struct SnapResult {
    parent-geometry: Geometry,
    guides: [SnapGuide],
}

export struct SnapPreview {
    valid: bool,
    root-geometry: Geometry,
    guides: [SnapGuide],
    identity: string,
}

export global Snapping {
    callback snap-move(parent-geometry: Geometry, zoom: float) -> SnapResult;
    callback snap-resize(parent-geometry: Geometry, handle: ResizeHandle, square: bool, zoom: float) -> SnapResult;

    public pure function selection-identity() -> string {
        return Api.current-element.source-uri + ":" + Api.current-element.offset
            + ":" + Api.selection.highlight-index + ":" + Hover.preview-generation;
    }

    function accept-preview(result: SnapResult, identity: string) -> SnapPreview {
        let geometry = result.parent-geometry;
        let accepted = Api.override-selected-element-geometry(
            geometry.x, geometry.y, geometry.width, geometry.height, CoordinateSpace.Parent,
        );
        return accepted.valid ? {
            valid: true,
            root-geometry: accepted.geometry,
            guides: result.guides,
            identity: identity,
        } : {};
    }

    public function preview-move(root-geometry: Geometry, identity: string) -> SnapPreview {
        if identity != Snapping.selection-identity() { return {}; }
        let parent = Api.root-geometry-to-parent-geometry(root-geometry);
        return parent.valid ? Snapping.accept-preview(
            Snapping.snap-move(parent.geometry, CanvasView.zoom), identity,
        ) : {};
    }

    public function preview-resize(root-geometry: Geometry, handle: ResizeHandle, square: bool, identity: string) -> SnapPreview {
        if identity != Snapping.selection-identity()
            || root-geometry.width <= 0px || root-geometry.height <= 0px { return {}; }
        let parent = Api.root-geometry-to-parent-geometry(root-geometry);
        if !parent.valid || parent.geometry.width <= 0px || parent.geometry.height <= 0px {
            return {};
        }
        let result = Snapping.snap-resize(parent.geometry, handle, square, CanvasView.zoom);
        if result.parent-geometry.width <= 0px || result.parent-geometry.height <= 0px {
            return {};
        }
        return Snapping.accept-preview(result, identity);
    }
}

export component SnapGuideLine inherits Path {
    in property <SnapGuide> guide;
    fit: preserve;
    stroke: #e649a0;
    stroke-width: 1phx;
    accessible-role: AccessibleRole.region;
    accessible-label: root.guide.label;
    MoveTo {
        x: root.guide.start-x * CanvasView.zoom / 1px;
        y: root.guide.start-y * CanvasView.zoom / 1px;
    }
    LineTo {
        x: root.guide.end-x * CanvasView.zoom / 1px;
        y: root.guide.end-y * CanvasView.zoom / 1px;
    }
}
