import { FileTreeNode } from "api.slint";

export struct RecentProject {
    name: string,
    root-path: string,
    component: string,
    path: string,
}

export global Project {
    in-out property <length> canvas-width: 390px;
    in-out property <length> canvas-height: 720px;
    in-out property <string> settings-key;
    in-out property <bool> settings-available;
    in-out property <bool> settings-editable;
    in-out property <string> settings-error;
    callback commit-canvas-dimension(string, string, string) -> bool;

    in-out property <[FileTreeNode]> file-tree;
    in-out property <string> selected-project-file;
    in-out property <[RecentProject]> recent;

    callback create-new-project() -> bool;
    callback create-new-slint-file() -> string;
    callback open-existing-project() -> bool;
    callback open-recent-project(RecentProject) -> bool;
}
