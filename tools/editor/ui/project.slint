import { FileTreeNode } from "api.slint";

export struct RecentProject {
    name: string,
    root-path: string,
    component: string,
    path: string,
}

export struct CanvasPreset {
    width: length = 390px,
    height: length = 720px,
}

export enum ProjectFileState { Available, Missing, Invalid }

export global Project {
    in-out property <[FileTreeNode]> file-tree;
    in-out property <string> selected-project-file;
    in-out property <[RecentProject]> recent;

    in-out property <ProjectFileState> project-file-state: ProjectFileState.Missing;
    in-out property <[CanvasPreset]> canvas-presets: [{ width: 390px, height: 720px }];
    in-out property <int> selected-canvas-preset;
    out property <Size> canvas-size: self.canvas-presets[self.selected-canvas-preset];
    in-out property <string> canvas-presets-error;
    callback update-canvas-preset(int, string, string) -> bool;
    callback add-canvas-preset() -> bool;
    callback delete-canvas-preset(int) -> bool;
    callback select-canvas-preset(int);

    callback create-new-project() -> bool;
    callback create-new-slint-file() -> string;
    callback open-existing-project() -> bool;
    callback open-recent-project(RecentProject) -> bool;
    callback close-project();
    callback clear-recent-projects();
}
