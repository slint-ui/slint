import { FileTreeNode } from "api.slint";

export struct RecentProject {
    name: string,
    root-path: string,
    component: string,
    path: string,
}

export global Project {
    in-out property <[FileTreeNode]> file-tree;
    in-out property <string> selected-project-file;
    in-out property <[RecentProject]> recent;

    callback create-new-project() -> bool;
    callback open-existing-project() -> bool;
    callback open-recent-project(RecentProject) -> bool;
}
