/// A Range in a source
export struct Range {
    start: int,
    end: int,
}

/// Information on an Element a Property belongs to
export struct ElementInformation {
    id: string,
    component-name: string,
    type-name: string,
    source-uri: string,
    source-version: int,
    /// The offset within source-uri
    offset: int,
}
