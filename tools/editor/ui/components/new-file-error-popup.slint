import { Style, Metrics, Typography, Colors, Theme, DialogStyle } from "../style.slint";
import { Button } from "../../controls/src/basic.slint";
import { ErrorNotice } from "error-notice.slint";
import { FloatingSurface } from "floating-surface.slint";

export component NewFileErrorPopup inherits PopupWindow {
    in property <DialogStyle> style: Style.dialog;
    in property <string> error;
    callback dismissed();

    width: root.style.width;
    height: max(root.style.height, content.preferred-height);
    close-policy: no-auto-close;

    FloatingSurface {
        border-width: Metrics.border-width;
        border-color: root.style.border;
        border-radius: Metrics.radius-large;

        content := VerticalLayout {
            VerticalLayout {
                padding: root.style.padding;
                spacing: Metrics.space-medium;

                HorizontalLayout {
                    spacing: Metrics.space-medium;
                    cross-axis-alignment: start;

                    Rectangle {
                        width: Metrics.control-medium;
                        height: Metrics.control-medium;
                        border-radius: Metrics.radius-medium;
                        background: Theme.surfaces.raised;
                        border-width: Metrics.border-width;
                        border-color: Theme.surfaces.raised-border;

                        Image {
                            width: Metrics.icon-small;
                            height: Metrics.icon-small;
                            source: @image-url("../assets/lucide/file-plus.svg");
                            colorize: Colors.muted;
                        }
                    }

                    VerticalLayout {
                        spacing: Metrics.space-small;
                        Text {
                            text: @tr("Couldn’t create file");
                            color: Colors.foreground;
                            font-size: Typography.heading.size;
                            font-weight: Typography.heading.weight;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("A new Slint file couldn’t be created in the project root.");
                            color: Colors.muted;
                            font-size: Typography.body.size;
                            wrap: word-wrap;
                        }
                    }
                }

                ErrorNotice { text: root.error; }
            }

            Rectangle {
                height: root.style.footer-height;
                background: root.style.footer-background;

                Rectangle {
                    height: Metrics.border-width;
                    y: 0px;
                    background: root.style.footer-border;
                }

                HorizontalLayout {
                    padding-left: Metrics.space-large;
                    padding-right: Metrics.space-large;
                    alignment: end;
                    cross-axis-alignment: center;

                    Button {
                        text: @tr("Close");
                        height: Style.compact-button.height;
                        horizontal-padding: Style.compact-button.padding-inline;
                        vertical-padding: 0px;
                        border-radius: Style.compact-button.radius;
                        border-width: Style.compact-button.border-width;
                        font-size: Style.compact-button.text.size;
                        font-weight: Style.compact-button.text.weight;
                        style: {
                            rest: {
                                background-color: Style.compact-button.appearance.normal.background,
                                foreground-color: Style.compact-button.appearance.normal.foreground,
                                border-color: Style.compact-button.appearance.normal.border,
                            },
                            hover: {
                                background-color: Style.compact-button.appearance.hover.background,
                                foreground-color: Style.compact-button.appearance.hover.foreground,
                                border-color: Style.compact-button.appearance.hover.border,
                            },
                            pressed: {
                                background-color: Style.compact-button.appearance.pressed.background,
                                foreground-color: Style.compact-button.appearance.pressed.foreground,
                                border-color: Style.compact-button.appearance.pressed.border,
                            },
                            disabled: {
                                background-color: Style.compact-button.appearance.disabled.background,
                                foreground-color: Style.compact-button.appearance.disabled.foreground,
                                border-color: Style.compact-button.appearance.disabled.border,
                            },
                            focus-color: Style.compact-button.appearance.focus-border,
                        };
                        clicked => {
                            root.close();
                            root.dismissed();
                        }
                    }
                }
            }
        }
    }
}
