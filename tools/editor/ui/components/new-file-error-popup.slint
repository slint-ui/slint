import { Style, Metrics, Colors, Typography, PaintStyle, DialogStyle } from "../style.slint";

export component NewFileErrorPopup inherits PopupWindow {
    in property <DialogStyle> style: Style.dialog;
    in property <string> error;
    callback dismissed();

    width: root.style.width;
    height: root.style.height;
    close-policy: no-auto-close;

    Rectangle {
        border-width: Metrics.border-width;
        border-color: root.style.border;
        border-radius: Metrics.radius-large;
        background: root.style.background;
        clip: true;
        drop-shadow-blur: root.style.shadow.blur;
        drop-shadow-offset-y: root.style.shadow.offset-y;
        drop-shadow-color: root.style.shadow.color;

        VerticalLayout {
            height: parent.height;

            Rectangle {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: root.style.padding;
                    spacing: Metrics.space-medium;

                    HorizontalLayout {
                        spacing: Metrics.space-medium;
                        cross-axis-alignment: start;

                        Rectangle {
                            width: root.style.error.icon-size;
                            height: root.style.error.icon-size;
                            border-radius: root.style.error.icon-size / 2;
                            background: root.style.error.icon-background;

                            Text {
                                text: "×";
                                color: root.style.error.icon-foreground;
                                font-size: root.style.error.icon-text.size;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-small;

                            Text {
                                text: @tr("Couldn’t create file");
                                color: Colors.foreground;
                                font-size: Typography.heading.size;
                                font-weight: Typography.heading.weight;
                            }

                            Text {
                                text: @tr("A new Slint file couldn’t be created in the project root.");
                                color: Colors.muted;
                                font-size: Typography.body.size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: root.style.error.height;
                        border-width: Metrics.border-width;
                        border-color: root.style.error.border;
                        border-radius: root.style.error.radius;
                        background: root.style.error.background;

                        Text {
                            x: root.style.error.inset;
                            width: parent.width - 2 * root.style.error.inset;
                            text: root.error;
                            color: root.style.error.foreground;
                            font-size: Typography.caption.size;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: root.style.footer-height;
                vertical-stretch: 0;
                background: root.style.footer-background;

                Rectangle {
                    height: Metrics.border-width;
                    y: 0px;
                    background: root.style.footer-border;
                }

                Rectangle {
                    private property <PaintStyle> paint: close-touch.pressed ? root.style.close-button.appearance.pressed
                        : close-touch.has-hover ? root.style.close-button.appearance.hover : root.style.close-button.appearance.normal;
                    width: bt.width + 2 * root.style.close-button.padding-inline;
                    height: root.style.close-button.height;
                    x: parent.width - self.width - Metrics.space-large;
                    y: (parent.height - self.height) / 2;
                    border-width: Metrics.border-width;
                    border-color: self.paint.border;
                    border-radius: root.style.close-button.radius;
                    background: self.paint.background;

                    bt := Text {
                        text: @tr("Close");
                        color: parent.paint.foreground;
                        font-size: root.style.close-button.text.size;
                        font-weight: root.style.close-button.text.weight;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Close");
                        clicked => {
                            root.close();
                            root.dismissed();
                        }
                    }
                }
            }
        }
    }
}
