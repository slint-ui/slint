import {
    BodyLabel, ComponentPaletteRow, EdgeDivider, EditorMetrics, HorizontalResizeDivider,
    MutedLabel, SectionTitle,
    PrimerTextInput, SidebarToggleButton, StudioTheme,
} from "common.slint";
import { Api, EditorSurfaceMode, ElementLibraryGroup, ElementLibraryEntry } from "../api.slint";
import { EditorTreeIcons } from "editor-tree-icons.slint";
import { Project } from "../project.slint";
import { FileTreeView } from "file-tree-view.slint";
import { ScrollView } from "std-widgets.slint";

component ElementsUnavailableNotice inherits Rectangle {
    height: 82px;
    border-radius: 8px;
    border-width: 1px;
    border-color: StudioTheme.soft-border;
    background: StudioTheme.panel-subtle.with-alpha(0.72);

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: StudioTheme.border.with-alpha(0.82);
            background: StudioTheme.panel-bg.with-alpha(0.72);

            Rectangle {
                x: 9px;
                y: 9px;
                width: 16px;
                height: 16px;
                border-radius: 5px;
                border-width: 2px;
                border-color: StudioTheme.muted.with-alpha(0.72);
                background: transparent;
            }

            Rectangle {
                x: 7px;
                y: 16px;
                width: 20px;
                height: 2px;
                border-radius: 1px;
                background: StudioTheme.muted.with-alpha(0.82);
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;

            BodyLabel {
                text: "Unavailable for images";
            }

            MutedLabel {
                text: "Open a component to drag elements.";
                wrap: word-wrap;
            }
        }
    }
}

component FilesUnavailableNotice inherits Rectangle {
    height: 82px;
    border-radius: 8px;
    border-width: 1px;
    border-color: StudioTheme.soft-border;
    background: StudioTheme.panel-subtle.with-alpha(0.72);

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: StudioTheme.border.with-alpha(0.82);
            background: StudioTheme.panel-bg.with-alpha(0.72);

            Rectangle {
                x: 8px;
                y: 10px;
                width: 18px;
                height: 14px;
                border-radius: 4px;
                border-width: 2px;
                border-color: StudioTheme.muted.with-alpha(0.72);
                background: transparent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;

            BodyLabel {
                text: "No files available";
            }

            MutedLabel {
                text: "Open a project file to browse siblings.";
                wrap: word-wrap;
            }
        }
    }
}

component ElementPaletteGroup inherits VerticalLayout {
    vertical-stretch: 0;
    in property <ElementLibraryGroup> group;
    in property <string> query;
    in property <bool> enabled: true;
    in property <bool> drag-enabled: true;
    callback drag-started();

    private property <bool> collapsed: false;
    private property <bool> expanded: root.query != "" || !root.collapsed;
    private property <[ElementLibraryEntry]> matches: Api.element-library-filter-entries(root.group.entries, root.query);
    function toggle() {
        if root.query == "" { root.collapsed = !root.collapsed; }
    }
    spacing: 0px;

    if root.matches.length > 0: Rectangle {
        height: 32px;
        border-radius: 4px;
        border-width: group-focus.has-focus ? 2px : 0px;
        border-color: StudioTheme.accent-strong;
        background: transparent;
        accessible-role: AccessibleRole.button;
        accessible-label: root.group.label;
        accessible-expanded: root.expanded;
        accessible-enabled: root.query == "";
        accessible-action-default => { root.toggle(); }

        group-focus := FocusScope {
            enabled: root.query == "";
            key-pressed(event) => {
                if event.text == Key.Return || event.text == Key.Space {
                    root.toggle();
                    return accept;
                }
                return reject;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            padding-left: 2px;
            cross-axis-alignment: center;
            Image {
                visible: root.query == "";
                width: 12px;
                height: 12px;
                source: root.expanded ? EditorTreeIcons.chevron-down : EditorTreeIcons.chevron-right;
                colorize: StudioTheme.muted;
            }
            MutedLabel { text: root.group.label; horizontal-stretch: 1; }
        }
        TouchArea {
            enabled: root.query == "";
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { group-focus.focus(); root.toggle(); }
        }
    }

    if root.matches.length > 0 && root.expanded: VerticalLayout {
        spacing: 0px;
        for row in ceil(root.matches.length / 2): HorizontalLayout {
            spacing: 4px;
            for column in 2: Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                if row * 2 + column < root.matches.length: ComponentPaletteRow {
                    width: parent.width;
                    enabled: root.enabled;
                    drag-enabled: root.drag-enabled;
                    kind: root.matches[row * 2 + column].kind;
                    label: root.matches[row * 2 + column].label;
                    drag-started => { root.drag-started(); }
                }
            }
        }
    }
}

component ElementPaletteRows inherits VerticalLayout {
    vertical-stretch: 1;
    in property <bool> enabled: true;
    in property <bool> drag-enabled: true;
    in property <string> query: "";
    callback drag-started();
    spacing: 0px;

    ScrollView {
        min-height: 0px;
        vertical-stretch: 1;
        content-width: self.width;
        content-height: max(palette.preferred-height, self.height);
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        palette := VerticalLayout {
            width: parent.width;
            for group in Api.element-library: ElementPaletteGroup {
                group: group;
                query: root.query;
                enabled: root.enabled;
                drag-enabled: root.drag-enabled;
                drag-started => { root.drag-started(); }
            }

            Rectangle {
                min-height: 24px;
                vertical-stretch: 1;
                if Api.element-library.length > 0 && !Api.element-library-has-matches(Api.element-library, root.query): MutedLabel {
                    width: parent.width;
                    height: parent.height;
                    text: "No Results";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component LeftPane inherits Rectangle {
    in property <bool> can-collapse: false;
    in property <length> elements-pane-height: 0px;
    callback drag-started();
    callback panes-collapsed();
    callback elements-pane-resized(length);
    callback elements-pane-reset();

    private property <bool> image-mode: Api.editor-surface-mode == EditorSurfaceMode.image;
    private property <length> default-elements-height: root.image-mode ? 540px : 360px;
    private property <length> requested-elements-height: root.elements-pane-height > 0px
        ? root.elements-pane-height
        : root.default-elements-height;
    private property <string> element-query: Api.element-library-normalize-query(search.text);
    private property <length> elements-height: 0px;
    private property <length> drag-start-height;

    function clamp-elements-height(height: length) -> length {
        return height.clamp(120px, max(120px, root.height - 250px));
    }

    init => {
        root.elements-height = root.clamp-elements-height(root.requested-elements-height);
    }

    changed requested-elements-height => {
        root.elements-height = root.clamp-elements-height(root.requested-elements-height);
    }

    changed image-mode => {
        root.elements-height = root.clamp-elements-height(root.requested-elements-height);
    }

    changed height => {
        root.elements-height = root.clamp-elements-height(root.requested-elements-height);
    }

    width: EditorMetrics.left-pane-width;
    background: StudioTheme.panel-bg;
    accessible-role: AccessibleRole.navigation;
    accessible-label: "Project and elements";

    EdgeDivider {
        x: parent.width - self.width;
    }

    VerticalLayout {
        height: 100%;
        spacing: 0px;

        HorizontalLayout {
            height: 48px;
            padding-top: 14px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 10px;
            cross-axis-alignment: center;

            if root.can-collapse: SidebarToggleButton {
                accessible-role: AccessibleRole.button;
                accessible-label: "Collapse sidebars";
                clicked => {
                    root.panes-collapsed();
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: center;

                BodyLabel {
                    text: "Project";
                    font-size: 14px;
                }

                MutedLabel {
                    text: "Files and elements";
                }
            }
        }

        VerticalLayout {
            padding: 14px;
            padding-bottom: 0px;
            SectionTitle { label: "FILES"; }

            if Project.file-tree.length == 0: FilesUnavailableNotice { }

            if Project.file-tree.length > 0: FileTreeView {
                vertical-stretch: 1;
            }
        }

        HorizontalResizeDivider {
            resize-label: "Elements pane resize";
            value: root.elements-height;
            value-maximum: max(120px, root.height - 250px);
            drag-started => {
                root.drag-start-height = root.elements-height;
            }
            dragged(delta) => {
                root.elements-height = root.clamp-elements-height(
                    max(120px, root.drag-start-height - delta),
                );
            }
            drag-finished(delta) => {
                if delta != 0px {
                    root.elements-pane-resized(root.clamp-elements-height(
                        max(120px, root.drag-start-height - delta),
                    ));
                }
            }
            value-set(height) => {
                let clamped-height = root.clamp-elements-height(max(120px, height));
                root.elements-height = clamped-height;
                root.elements-pane-resized(clamped-height);
            }
            reset-requested => {
                root.elements-pane-reset();
            }
        }

        VerticalLayout {
            height: root.elements-height;
            spacing: 8px;
            padding: 14px;

            SectionTitle { label: "ELEMENTS"; }

            search := PrimerTextInput {
                placeholder: "Search elements…";
                accessible-name: "Search elements";
                background: StudioTheme.panel-subtle;
            }

            if root.image-mode: ElementsUnavailableNotice { }

            ElementPaletteRows {
                vertical-stretch: 1;
                query: root.element-query;
                enabled: !root.image-mode;
                drag-enabled: Api.known-components.length > 0;
                drag-started => { root.drag-started(); }
            }
        }
    }
}
