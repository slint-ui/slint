import { Api, FillData, BrushKind, LinearGradientAxis, SelectionRectangle } from "../../api.slint";
import { EditorMetrics } from "../common.slint";

export global FillSession {
    in-out property <FillData> value;
    in-out property <bool> allow-gradient;
    in-out property <float> target-width;
    in-out property <float> target-height;
    in-out property <FillData> linear-fill;
    in-out property <FillData> radial-fill;
    in-out property <FillData> conic-fill;
    in-out property <bool> radial-center-initialized;
    in-out property <bool> conic-center-initialized;
    in-out property <bool> radius-initialized;
    in-out property <BrushKind> last-gradient: BrushKind.linear;
    in-out property <string> expression: "";
    in-out property <string> session-key: "";
    in-out property <string> target-key: "";
    in-out property <bool> unsupported: false;
    in-out property <bool> open: false;

    in-out property <Point> anchor-position;
    in-out property <length> anchor-width;

    in-out property <FillData> draft;
    in-out property <FillData> working-fill;
    in-out property <int> selected-stop;
    in-out property <bool> stop-panel-open;
    in-out property <length> main-x: (FillSession.anchor-position.x >= 316px ? FillSession.anchor-position.x - 308px : FillSession.anchor-position.x + FillSession.anchor-width + 8px).clamp(8px, max(8px, EditorMetrics.window-width - 308px));
    in-out property <bool> stop-on-left: FillSession.main-x >= 316px;
    in-out property <bool> stacked: FillSession.stop-panel-open && !FillSession.stop-on-left && FillSession.main-x + 608px > EditorMetrics.window-width - 8px;
    in-out property <int> focus-stop-generation;

    in-out property <color> working-color: FillSession.working-fill.kind == BrushKind.solid ? FillSession.working-fill.color : FillSession.working-fill.stops[FillSession.selected-stop].color;
    in-out property <bool> has-preview: false;
    in-out property <string> active-target;
    in-out property <bool> session-active: false;
    in-out property <FillData> original-fill: FillSession.value;
    out property <bool> editable: open && !Api.inspector-fill-refresh-pending && !unsupported;
    in-out property <string> property-name;
    in-out property <bool> canvas-target;
    in-out property <int> focus-generation;
    out property <bool> linear-active: open && editable && session-active && canvas-target
        && working-fill.kind == BrushKind.linear && Api.current-element.type-name == "Rectangle"
        && Api.selection.highlight-index >= 0;

    in-out property <LinearGradientAxis> axis;
    in-out property <Point> canvas-origin;
    in-out property <Size> canvas-size;
    in-out property <SelectionRectangle> selection;
    out property <Size> target-size: { width: target-width * 1px, height: target-height * 1px };
    private property <string> current-session-key: Api.current-element.source-uri + ":" + Api.current-element.offset + ":" + Api.selection.highlight-index + ":" + Api.inspector-fill-generation + ":" + property-name;
    changed current-session-key => {
        if FillSession.open && FillSession.session-key != FillSession.current-session-key {
            FillSession.close-picker(false, false);
        }
    }

    public function reset-axis() {
        FillSession.axis = Api.linear-gradient-axis(FillSession.working-fill, FillSession.target-size);
    }
    public function move-axis(fill: FillData, previous: LinearGradientAxis, next: LinearGradientAxis) {
        let dx = (next.end.x - next.start.x) / 1px;
        let dy = (next.end.y - next.start.y) / 1px;
        if dx * dx + dy * dy < 1 { return; }
        if FillSession.preview-fill(Api.remap-linear-gradient(fill, FillSession.target-size, previous, next)) {
            FillSession.axis = next;
        }
    }
    public function move-stop(point: Point) {
        FillSession.draft = FillSession.working-fill;
        FillSession.draft.stops = Api.clone-gradient-stops(FillSession.working-fill.stops);
        FillSession.selected-stop = Api.move-gradient-stop(FillSession.draft.stops, FillSession.selected-stop,
            Api.linear-gradient-position(FillSession.draft.angle, FillSession.target-size, point));
        FillSession.preview-fill(FillSession.draft);
    }

    public function preview-fill(fill: FillData) -> bool {
        if !FillSession.session-active || !FillSession.editable {
            return false;
        }
        if Api.inspector-fill-preview(FillSession.active-target, FillSession.property-name, fill) {
            if fill.kind == BrushKind.radial {
                FillSession.radial-center-initialized = FillSession.radial-center-initialized || fill.custom-center;
                FillSession.radius-initialized = FillSession.radius-initialized || fill.custom-radius;
            }
            if fill.kind == BrushKind.conic {
                FillSession.conic-center-initialized = FillSession.conic-center-initialized || fill.custom-center;
            }
            FillSession.has-preview = true;
            FillSession.working-fill = fill;
            if fill.kind == BrushKind.linear {
                FillSession.linear-fill = fill;
            }
            if fill.kind == BrushKind.radial {
                FillSession.radial-fill = fill;
            }
            if fill.kind == BrushKind.conic {
                FillSession.conic-fill = fill;
            }
            return true;
        }
        FillSession.close-picker(false, false);
        return false;
    }
    public function preview-color(c: color) -> bool {
        FillSession.draft = FillSession.working-fill;
        if FillSession.draft.kind == BrushKind.solid {
            FillSession.draft.color = c;
        } else {
            FillSession.draft.stops = Api.clone-gradient-stops(FillSession.working-fill.stops);
            FillSession.draft.stops[FillSession.selected-stop].color = c;
        }
        return FillSession.preview-fill(FillSession.draft);
    }
    public function select-kind(kind: BrushKind) -> bool {
        if kind == BrushKind.solid || kind == BrushKind.linear {
            FillSession.stop-panel-open = false;
        }
        FillSession.draft = FillSession.working-fill;
        if kind == BrushKind.solid {
            FillSession.draft.color = FillSession.working-color;
            FillSession.draft.kind = kind;
        } else {
            FillSession.draft = kind == BrushKind.linear ? FillSession.linear-fill : kind == BrushKind.radial ? FillSession.radial-fill : FillSession.conic-fill;
            FillSession.draft.stops = Api.clone-gradient-stops(FillSession.working-fill.stops.length >= 2 ? FillSession.working-fill.stops : [{color: FillSession.working-color, position: 0}, {color: FillSession.working-color, position: 1}]);
            FillSession.draft.kind = kind;
            FillSession.last-gradient = kind;
        }
        let accepted = FillSession.preview-fill(FillSession.draft);
        if accepted && kind == BrushKind.linear { FillSession.reset-axis(); }
        return accepted;
    }

    public function set-custom-center(custom: bool) -> bool {
        FillSession.draft = FillSession.working-fill;
        FillSession.draft.custom-center = custom;
        let initialized = FillSession.draft.kind == BrushKind.radial
            ? FillSession.radial-center-initialized : FillSession.conic-center-initialized;
        if custom && !initialized {
            FillSession.draft.center-x = FillSession.target-width / 2;
            FillSession.draft.center-y = FillSession.target-height / 2;
        }
        return FillSession.preview-fill(FillSession.draft);
    }

    public function set-custom-radius(custom: bool) -> bool {
        FillSession.draft = FillSession.working-fill;
        FillSession.draft.custom-radius = custom;
        if custom && !FillSession.radius-initialized {
            FillSession.draft.radius = max(1, sqrt(FillSession.target-width * FillSession.target-width + FillSession.target-height * FillSession.target-height) / 2);
        }
        return FillSession.preview-fill(FillSession.draft);
    }

    public function select-recent(fill: FillData) {
        if fill.kind == BrushKind.radial {
            FillSession.radial-center-initialized = fill.custom-center;
            FillSession.radius-initialized = fill.custom-radius;
        } else if fill.kind == BrushKind.conic {
            FillSession.conic-center-initialized = fill.custom-center;
        }
        FillSession.stop-panel-open = false;
        FillSession.selected-stop = 0;
        FillSession.draft = fill;
        FillSession.draft.stops = Api.clone-gradient-stops(fill.stops);
        FillSession.last-gradient = fill.kind == BrushKind.solid ? FillSession.last-gradient : fill.kind;
        FillSession.preview-fill(FillSession.draft);
        FillSession.reset-axis();
    }

    public function show-picker() {
        FillSession.stop-panel-open = false;
        FillSession.selected-stop = 0;
        FillSession.working-fill = FillSession.value;
        FillSession.original-fill = FillSession.value;
        FillSession.original-fill.stops = Api.clone-gradient-stops(FillSession.value.stops);
        FillSession.working-fill.stops = Api.clone-gradient-stops(FillSession.value.stops);
        FillSession.radial-center-initialized = FillSession.value.kind == BrushKind.radial && FillSession.value.custom-center;
        FillSession.conic-center-initialized = FillSession.value.kind == BrushKind.conic && FillSession.value.custom-center;
        FillSession.radius-initialized = FillSession.value.kind == BrushKind.radial && FillSession.value.custom-radius;
        FillSession.linear-fill = {kind: BrushKind.linear, angle: 90};
        FillSession.radial-fill = {kind: BrushKind.radial};
        FillSession.conic-fill = {kind: BrushKind.conic};
        FillSession.last-gradient = FillSession.value.kind == BrushKind.solid ? BrushKind.linear : FillSession.value.kind;
        if FillSession.value.kind == BrushKind.linear {
            FillSession.linear-fill = FillSession.working-fill;
        }
        if FillSession.value.kind == BrushKind.radial {
            FillSession.radial-fill = FillSession.working-fill;
        }
        if FillSession.value.kind == BrushKind.conic {
            FillSession.conic-fill = FillSession.working-fill;
        }
        FillSession.active-target = FillSession.target-key;
        FillSession.has-preview = false;
        FillSession.session-active = true;
        FillSession.reset-axis();

    }

    public function close-picker(accept: bool, return-focus: bool) {
        if !FillSession.session-active {
            return;
        }
        FillSession.session-active = false;
        FillSession.stop-panel-open = false;
        let changed = Api.fill-brush(FillSession.working-fill) != Api.fill-brush(FillSession.original-fill);
        if !accept || !changed || !Api.inspector-fill-commit(FillSession.active-target, FillSession.property-name, FillSession.working-fill) {
            if FillSession.has-preview {
                Api.inspector-cancel();
            }
            FillSession.working-fill = FillSession.original-fill;
        }
        FillSession.has-preview = false;
        FillSession.open = false;
        if return-focus {
            FillSession.focus-generation += 1;
        }
    }

    changed value => {
        if !FillSession.session-active {
            FillSession.working-fill = FillSession.value;
        }
    }



    changed open => {
        if FillSession.open {
            FillSession.show-picker();
        } else {
            FillSession.close-picker(false, false);
        }
    }

}
