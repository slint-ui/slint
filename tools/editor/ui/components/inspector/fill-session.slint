import { Properties, PropertyEditKind, PropertyValue, ColorFieldData, FillData, BrushKind, LinearGradientAxis } from "../../properties.slint";

import { Api } from "../../api.slint";
import { CanvasView } from "../canvas-view.slint";

export struct FillSessionTarget {
    key: string,
    session-key: string,
    property-name: string,
    size: Size,
    canvas: bool,
    element-rotation: float,
}

export struct FillSessionRequest {
    target: FillSessionTarget,
    anchor-position: Point,
    anchor-size: Size,
    activation-position: Point,
    activation-size: Size,
}

export global FillSession {
    out property <FillSessionRequest> request;
    private property <FillData> linear-fill;
    private property <FillData> radial-fill;
    private property <FillData> conic-fill;
    private property <bool> radial-center-initialized;
    private property <bool> conic-center-initialized;
    private property <bool> radius-initialized;
    out property <BrushKind> last-gradient: BrushKind.linear;
    out property <bool> open;
    out property <int> opening-generation;

    private property <FillData> draft;
    out property <PropertyValue> value: Properties.editor-property-value-data(request.target.property-name);
    out property <ColorFieldData> field-data: Properties.color-field-data(value);
    out property <FillData> working-fill: value.fill;
    out property <float> element-rotation: Properties.hooked-property-value-data(
        "transform-rotation", { value-float: request.target.element-rotation }).value-float;
    private property <angle> initial-selection-angle;
    out property <angle> canvas-rotation: FillSession.initial-selection-angle + (FillSession.element-rotation - FillSession.request.target.element-rotation) * 1deg;
    in-out property <int> selected-stop;
    in-out property <bool> stop-panel-open;
    in-out property <int> focus-stop-generation;

    out property <color> working-color: FillSession.working-fill.kind == BrushKind.solid ? FillSession.working-fill.color : FillSession.working-fill.stops[FillSession.selected-stop].color;
    private property <bool> has-preview;
    out property <bool> editable: open && !field-data.unsupported;
    out property <int> focus-generation;
    out property <int> anchor-focus-generation;
    private property <bool> canvas-editable: editable && request.target.canvas
        && Api.current-element.type-name == "Rectangle"
        && Api.selection.highlight-index >= 0;
    out property <bool> radial-active: canvas-editable && working-fill.kind == BrushKind.radial;
    out property <bool> conic-active: canvas-editable && working-fill.kind == BrushKind.conic;
    out property <bool> canvas-active: canvas-editable && working-fill.kind != BrushKind.solid;

    private property <LinearGradientAxis> handle-axis;
    out property <LinearGradientAxis> axis: working-fill.kind == BrushKind.radial && handle-axis.end.x <= handle-axis.start.x
        ? Properties.radial-gradient-axis(working-fill, request.target.size) : handle-axis;
    out property <LinearGradientAxis> y-axis: Properties.radial-gradient-y-axis(FillSession.working-fill, FillSession.request.target.size);
    in-out property <Point> canvas-origin;
    in-out property <Size> canvas-size;
    private property <string> current-session-key: Api.current-element.source-uri + ":" + Api.current-element.offset + ":" + Api.selection.highlight-index + ":" + Properties.inspector-fill-generation + ":" + request.target.property-name;
    changed current-session-key => {
        if FillSession.open && FillSession.request.target.session-key != FillSession.current-session-key {
            FillSession.close-picker(false, false);
        }
    }

    function reset-axis() {
        FillSession.handle-axis = FillSession.working-fill.kind == BrushKind.radial ? {}
            : FillSession.working-fill.kind == BrushKind.conic
            ? Properties.conic-gradient-axis(FillSession.working-fill, FillSession.request.target.size)
            : Properties.linear-gradient-axis(FillSession.working-fill, FillSession.request.target.size);
    }
    public function move-axis(fill: FillData, previous: LinearGradientAxis, next: LinearGradientAxis) {
        let dx = (next.end.x - next.start.x) / 1px;
        let dy = (next.end.y - next.start.y) / 1px;
        if dx * dx + dy * dy < 1 { return; }
        let updated = fill.kind == BrushKind.conic
            ? Properties.remap-conic-gradient(fill, previous, next)
            : fill.kind == BrushKind.radial
            ? Properties.remap-radial-gradient(fill, previous, next)
            : Properties.remap-linear-gradient(fill, FillSession.request.target.size, previous, next);
        if FillSession.preview-fill(updated) {
            FillSession.handle-axis = next;
        }
    }
    public function move-y-axis(fill: FillData, previous: LinearGradientAxis, next: LinearGradientAxis, match-radius: bool) {
        if next.end.y - next.start.y < 1px { return; }
        let updated = Properties.remap-radial-gradient-y(fill, FillSession.request.target.size, previous, next, match-radius);
        if FillSession.preview-fill(updated) { FillSession.handle-axis = {}; }
    }
    public function move-rotated-axis(fill: FillData, previous: LinearGradientAxis, next: LinearGradientAxis, rotation: float, match-radius: bool) {
        if next.end.x - next.start.x < 1px { return; }
        let updated = Properties.resize-radial-gradient-x(fill, FillSession.request.target.size, previous, next, match-radius);
        if FillSession.preview-fill-with-rotation(updated, rotation) { FillSession.handle-axis = {}; }
    }
    public pure function stop-point(position: float) -> Point {
        return FillSession.working-fill.kind == BrushKind.conic
            ? Properties.conic-gradient-point(FillSession.axis, position)
            : FillSession.working-fill.kind == BrushKind.radial
            ? Properties.gradient-axis-point(FillSession.axis, position)
            : Properties.linear-gradient-point(FillSession.working-fill.angle, FillSession.request.target.size, position);
    }
    public pure function stop-position(point: Point) -> float {
        return FillSession.working-fill.kind == BrushKind.conic
            ? Properties.conic-gradient-position(FillSession.axis, point)
            : FillSession.working-fill.kind == BrushKind.radial
            ? Properties.gradient-axis-position(FillSession.axis, point)
            : Properties.linear-gradient-position(FillSession.working-fill.angle, FillSession.request.target.size, point);
    }
    public function add-stop(point: Point) {
        if !FillSession.canvas-active { return; }
        FillSession.add-stop-position(FillSession.stop-position(point).clamp(0, 1));
        FillSession.focus-stop-generation += 1;
    }
    function prepare-draft(fill: FillData) {
        FillSession.draft = fill;
        FillSession.draft.stops = Properties.clone-gradient-stops(fill.stops);
    }

    public function add-stop-position(position: float) {
        FillSession.prepare-draft(FillSession.working-fill);
        FillSession.selected-stop = Properties.add-gradient-stop(FillSession.draft.stops, Properties.sample-fill-stop(FillSession.draft, position));
        FillSession.preview-fill(FillSession.draft);
    }
    public function remove-stop(index: int) {
        if FillSession.working-fill.stops.length <= 1 { return; }
        FillSession.prepare-draft(FillSession.working-fill);
        let position = FillSession.draft.stops[index].position;
        Properties.remove-gradient-stop(FillSession.draft.stops, index);
        FillSession.selected-stop = FillSession.selected-stop == index
            ? (FillSession.draft.kind == BrushKind.conic ? Properties.nearest-conic-gradient-stop(FillSession.draft.stops, position) : Properties.nearest-gradient-stop(FillSession.draft.stops, position))
            : FillSession.selected-stop - (FillSession.selected-stop > index ? 1 : 0);
        FillSession.preview-fill(FillSession.draft);
    }
    public function edit-stop-color(index: int) {
        if !FillSession.editable || FillSession.working-fill.kind == BrushKind.solid || index < 0 || index >= FillSession.working-fill.stops.length {
            return;
        }
        FillSession.selected-stop = index;
        FillSession.stop-panel-open = true;
    }
    public function apply-history(redo: bool) {
        FillSession.close-picker(false, false);
        Properties.inspector-cancel();
        Properties.inspector-generation += 1;
        Properties.inspector-fill-generation += 1;
        if redo { if Api.redo-enabled { Api.redo(); } }
        else { if Api.undo-enabled { Api.undo(); } }
    }

    public function move-stop-position(position: float) -> bool {
        FillSession.prepare-draft(FillSession.working-fill);
        FillSession.draft.stops[FillSession.selected-stop].position = position;
        return FillSession.preview-fill(FillSession.draft);
    }

    public function preview-fill(fill: FillData) -> bool {
        return FillSession.preview-fill-with-rotation(fill, FillSession.element-rotation);
    }

    function preview-fill-with-rotation(fill: FillData, rotation: float) -> bool {
        if !FillSession.editable {
            return false;
        }
        if FillSession.request.target.session-key != "" && FillSession.request.target.session-key != FillSession.current-session-key {
            FillSession.close-picker(false, false);
            return false;
        }
        Properties.inspector-cancel();
        if Properties.inspector-preview(FillSession.request.target.property-name, { kind: PropertyEditKind.fill, fill: fill })
            && (!FillSession.request.target.canvas || rotation == FillSession.request.target.element-rotation || Properties.inspector-preview("transform-rotation", {
                kind: PropertyEditKind.number, number: rotation, unit: "deg",
            })) {
            if fill.kind == BrushKind.radial {
                FillSession.radial-center-initialized = FillSession.radial-center-initialized || fill.custom-center;
                FillSession.radius-initialized = FillSession.radius-initialized || fill.custom-radius;
            }
            if fill.kind == BrushKind.conic {
                FillSession.conic-center-initialized = FillSession.conic-center-initialized || fill.custom-center;
            }
            FillSession.has-preview = true;
            return true;
        }
        Properties.inspector-cancel();
        FillSession.has-preview = false;
        FillSession.close-picker(false, false);
        return false;
    }
    public function restore-gesture(fill: FillData, rotation: float, axis: LinearGradientAxis) {
        if FillSession.preview-fill-with-rotation(fill, rotation) { FillSession.handle-axis = axis; }
    }
    public function preview-color(c: color) -> bool {
        FillSession.prepare-draft(FillSession.working-fill);
        if FillSession.draft.kind == BrushKind.solid {
            FillSession.draft.color = c;
        } else {
            FillSession.draft.stops[FillSession.selected-stop].color = c;
        }
        return FillSession.preview-fill(FillSession.draft);
    }
    function remember-gradient() {
        if FillSession.working-fill.kind == BrushKind.linear {
            FillSession.linear-fill = FillSession.working-fill;
        } else if FillSession.working-fill.kind == BrushKind.radial {
            FillSession.radial-fill = FillSession.working-fill;
        } else if FillSession.working-fill.kind == BrushKind.conic {
            FillSession.conic-fill = FillSession.working-fill;
        }
    }

    public function select-kind(kind: BrushKind) -> bool {
        FillSession.remember-gradient();
        FillSession.stop-panel-open = false;
        FillSession.draft = FillSession.working-fill;
        if kind == BrushKind.solid {
            FillSession.draft.color = FillSession.working-color;
            FillSession.draft.kind = kind;
        } else {
            FillSession.draft = kind == BrushKind.linear ? FillSession.linear-fill : kind == BrushKind.radial ? FillSession.radial-fill : FillSession.conic-fill;
            FillSession.draft.stops = Properties.clone-gradient-stops(FillSession.working-fill.stops.length >= 1 ? FillSession.working-fill.stops : [{color: FillSession.working-color, position: 0}, {color: FillSession.working-color, position: 1}]);
            FillSession.draft.kind = kind;
            FillSession.last-gradient = kind;
        }
        let accepted = FillSession.preview-fill(FillSession.draft);
        if accepted && kind != BrushKind.solid { FillSession.reset-axis(); }
        return accepted;
    }

    public function set-custom-center(custom: bool) -> bool {
        FillSession.draft = FillSession.working-fill;
        FillSession.draft.custom-center = custom;
        let initialized = FillSession.draft.kind == BrushKind.radial
            ? FillSession.radial-center-initialized : FillSession.conic-center-initialized;
        if custom && !initialized {
            FillSession.draft.center-x = (FillSession.request.target.size.width / 1px) / 2;
            FillSession.draft.center-y = (FillSession.request.target.size.height / 1px) / 2;
        }
        return FillSession.preview-fill(FillSession.draft);
    }

    public function set-custom-radius(custom: bool) -> bool {
        FillSession.draft = FillSession.working-fill;
        FillSession.draft.custom-radius = custom;
        if custom && !FillSession.radius-initialized {
            let x = Properties.radial-gradient-axis(FillSession.working-fill, FillSession.request.target.size);
            let y = Properties.radial-gradient-y-axis(FillSession.working-fill, FillSession.request.target.size);
            FillSession.draft.radius = max(1, (x.end.x - x.start.x) / 1px);
            FillSession.draft.radius-y = max(1, (y.end.y - y.start.y) / 1px);
        }
        return FillSession.preview-fill(FillSession.draft);
    }

    public function select-recent(fill: FillData) {
        FillSession.remember-gradient();
        if fill.kind == BrushKind.radial {
            FillSession.radial-center-initialized = fill.custom-center;
            FillSession.radius-initialized = fill.custom-radius;
        } else if fill.kind == BrushKind.conic {
            FillSession.conic-center-initialized = fill.custom-center;
        }
        FillSession.stop-panel-open = false;
        FillSession.selected-stop = 0;
        FillSession.prepare-draft(fill);
        FillSession.last-gradient = fill.kind == BrushKind.solid ? FillSession.last-gradient : fill.kind;
        FillSession.preview-fill(FillSession.draft);
        FillSession.reset-axis();
    }

    public function focus-anchor(position: Point) -> bool {
        let origin = FillSession.request.activation-position;
        let size = FillSession.request.activation-size;
        if !FillSession.open || position.x < origin.x || position.y < origin.y
            || position.x >= origin.x + size.width || position.y >= origin.y + size.height {
            return false;
        }
        FillSession.anchor-focus-generation += 1;
        return true;
    }

    public function begin(request: FillSessionRequest) {
        FillSession.close-picker(true, false);
        FillSession.request = request;
        FillSession.initial-selection-angle = CanvasView.selection.angle;
        let fill = FillSession.working-fill;
        FillSession.stop-panel-open = false;
        FillSession.selected-stop = 0;
        FillSession.radial-center-initialized = fill.kind == BrushKind.radial && fill.custom-center;
        FillSession.conic-center-initialized = fill.kind == BrushKind.conic && fill.custom-center;
        FillSession.radius-initialized = fill.kind == BrushKind.radial && fill.custom-radius;
        FillSession.linear-fill = fill.kind == BrushKind.linear ? fill : {kind: BrushKind.linear, angle: 90};
        FillSession.radial-fill = fill.kind == BrushKind.radial ? fill : {kind: BrushKind.radial};
        FillSession.conic-fill = fill.kind == BrushKind.conic ? fill : {kind: BrushKind.conic};
        FillSession.last-gradient = fill.kind == BrushKind.solid ? BrushKind.linear : fill.kind;
        FillSession.reset-axis();
        FillSession.open = true;
        FillSession.opening-generation += 1;
    }

    public function close-picker(accept: bool, return-focus: bool) {
        if !FillSession.open {
            return;
        }
        FillSession.open = false;
        FillSession.stop-panel-open = false;
        if FillSession.has-preview {
            if accept && Properties.inspector-commit() {
                Properties.add-recent-fill(FillSession.working-fill);
            } else {
                Properties.inspector-cancel();
            }
            FillSession.has-preview = false;
        }
        if return-focus {
            FillSession.focus-generation += 1;
        }
    }
}
