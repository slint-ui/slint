import { Style, Colors, Typography, Metrics, EffectSliderStyle } from "../../style.slint";

import { InspectorValueField } from "value-field.slint";

export component InspectorEffectSlider inherits Rectangle {
    in property <EffectSliderStyle> style: Style.effect-slider;
    in property <string> accessible-name: "";
    in property <string> label;
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> suffix: "px";
    in property <string> commit-key: "";
    callback accepted(float) -> bool;

    property <bool> dragging: false;
    property <float> drag-value: 0;

    width: Style.inspector-layout.content-width;
    height: root.style.height;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.accessible-name;
    accessible-value: "\{root.visual-value()}";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-action-set-value(value) => {
        if value.is-float() {
            root.accepted(root.clamped(value.to-float()));
        }
    }

    pure function clamped(value: float) -> float {
        return value.clamp(root.minimum, root.maximum).round();
    }

    pure function visual-value() -> float {
        return root.dragging ? root.drag-value : root.value;
    }

    pure function progress() -> float {
        return root.maximum == root.minimum ? 0 : ((root.visual-value() - root.minimum) / (root.maximum - root.minimum)).clamp(0, 1);
    }

    function value-at(pointer-x: length) -> float {
        let progress = ((pointer-x - track.x) / track.width).clamp(0.0, 1.0);
        return root.clamped(root.minimum + progress * (root.maximum - root.minimum));
    }

    function update-at(pointer-x: length) {
        root.drag-value = root.value-at(pointer-x);
    }

    Text {
        x: 0px;
        y: 0px;
        width: root.style.label-width;
        height: root.style.control-height;
        text: root.label;
        color: root.style.foreground;
        font-size: Typography.caption.size;
        font-weight: FontWeight.semi-bold;
        vertical-alignment: center;
        overflow: elide;
    }

    track := Rectangle {
        x: root.style.label-width + Metrics.space-compact;
        y: (root.style.control-height - self.height) / 2;
        width: root.style.track-width;
        height: root.style.track-height;
        border-radius: self.height / 2;
        background: root.style.track;
    }

    Rectangle {
        x: track.x;
        y: track.y;
        width: max(0px, track.width * root.progress());
        height: track.height;
        border-radius: track.border-radius;
        background: root.style.fill;
    }

    Rectangle {
        x: track.x + track.width * root.progress() - self.width / 2;
        y: track.y + (track.height - self.height) / 2;
        width: root.style.thumb-size;
        height: self.width;
        border-radius: self.width / 2;
        border-width: Metrics.border-width;
        border-color: root.style.border;
        background: slider-touch.pressed ? root.style.pressed-thumb : root.style.thumb;
        drop-shadow-blur: root.style.shadow.blur;
        drop-shadow-offset-y: root.style.shadow.offset-y;
        drop-shadow-color: root.style.shadow.color;
    }

    slider-touch := TouchArea {
        x: track.x - Metrics.space-regular;
        y: 0px;
        width: track.width + 2 * Metrics.space-regular;
        height: root.style.control-height;
        mouse-cursor: pointer;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dragging = true;
                root.update-at(self.x + self.mouse-x);
            } else if event.kind == PointerEventKind.move {
                if root.dragging {
                    root.update-at(self.x + self.mouse-x);
                }
            } else if event.kind == PointerEventKind.up {
                if root.dragging {
                    let value = root.drag-value;
                    root.dragging = false;
                    root.accepted(value);
                }
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
    }

    InspectorValueField {
        x: parent.width - self.width - (root.suffix != "" ? root.style.suffix-width + Metrics.space-tight : 0px);
        accessible-name: root.accessible-name + " value";
        prefix: "";
        value: "\{root.visual-value().round()}";
        commit-key: root.commit-key;
        width: root.suffix != "" ? root.style.value-width : root.style.plain-value-width;
        accepted(text) => {
            if !text.is-float() {
                return false;
            }
            return root.accepted(root.clamped(text.to-float()));
        }
    }

    Text {
        x: parent.width - self.width;
        y: 0px;
        width: root.style.suffix-width;
        height: root.style.control-height;
        text: root.suffix;
        color: Colors.muted;
        font-size: root.style.suffix-text.size;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}
