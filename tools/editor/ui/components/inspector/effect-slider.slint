import { Style } from "../../style.slint";

import { InspectorValueField } from "value-field.slint";

export component InspectorEffectSlider inherits Rectangle {
    in property <string> accessible-name: "";
    in property <string> label;
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> suffix: "px";
    in property <string> commit-key: "";
    callback accepted(float) -> bool;

    property <bool> dragging: false;
    property <float> drag-value: 0;

    width: Style.inspector.wide-width;
    height: Style.inspector.slider-height;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.accessible-name;
    accessible-value: "\{root.visual-value()}";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-action-set-value(value) => {
        if value.is-float() {
            root.accepted(root.clamped(value.to-float()));
        }
    }

    pure function clamped(value: float) -> float {
        return value.clamp(root.minimum, root.maximum).round();
    }

    pure function visual-value() -> float {
        return root.dragging ? root.drag-value : root.value;
    }

    pure function progress() -> float {
        return root.maximum == root.minimum ? 0 : ((root.visual-value() - root.minimum) / (root.maximum - root.minimum)).clamp(0, 1);
    }

    function value-at(pointer-x: length) -> float {
        let progress = ((pointer-x - track.x) / track.width).clamp(0.0, 1.0);
        return root.clamped(root.minimum + progress * (root.maximum - root.minimum));
    }

    function update-at(pointer-x: length) {
        root.drag-value = root.value-at(pointer-x);
    }

    Text {
        x: 0px;
        y: 0px;
        width: Style.inspector.slider-label-width;
        height: Style.inspector.field-height;
        text: root.label;
        color: Style.inspector.text;
        font-size: Style.typography.caption.size;
        font-weight: FontWeight.semi-bold;
        vertical-alignment: center;
        overflow: elide;
    }

    track := Rectangle {
        x: Style.inspector.slider-label-width + Style.spacing.compact;
        y: (Style.inspector.field-height - self.height) / 2;
        width: Style.inspector.slider-track-width;
        height: Style.inspector.slider-track-height;
        border-radius: self.height / 2;
        background: Style.inspector.field-bg;
    }

    Rectangle {
        x: track.x;
        y: track.y;
        width: max(0px, track.width * root.progress());
        height: track.height;
        border-radius: track.border-radius;
        background: Style.inspector.accent;
    }

    Rectangle {
        x: track.x + track.width * root.progress() - self.width / 2;
        y: track.y + (track.height - self.height) / 2;
        width: Style.inspector.slider-thumb-size;
        height: self.width;
        border-radius: self.width / 2;
        border-width: Style.controls.border-width;
        border-color: Style.inspector.panel-bg;
        background: slider-touch.pressed ? Style.inspector.slider-pressed : Style.inspector.accent;
        drop-shadow-blur: Style.shadows.slider.blur;
        drop-shadow-offset-y: Style.shadows.slider.offset-y;
        drop-shadow-color: Style.shadows.slider.color;
    }

    slider-touch := TouchArea {
        x: track.x - Style.spacing.regular;
        y: 0px;
        width: track.width + 2 * Style.spacing.regular;
        height: Style.inspector.field-height;
        mouse-cursor: pointer;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.dragging = true;
                root.update-at(self.x + self.mouse-x);
            } else if event.kind == PointerEventKind.move {
                if root.dragging {
                    root.update-at(self.x + self.mouse-x);
                }
            } else if event.kind == PointerEventKind.up {
                if root.dragging {
                    let value = root.drag-value;
                    root.dragging = false;
                    root.accepted(value);
                }
            } else if event.kind == PointerEventKind.cancel {
                root.dragging = false;
            }
        }
    }

    InspectorValueField {
        x: parent.width - self.width - (root.suffix != "" ? Style.inspector.slider-suffix-width + Style.spacing.tight : 0px);
        accessible-name: root.accessible-name + " value";
        prefix: "";
        value: "\{root.visual-value().round()}";
        commit-key: root.commit-key;
        width: root.suffix != "" ? Style.inspector.slider-value-width : Style.inspector.slider-plain-value-width;
        accepted(text) => {
            if !text.is-float() {
                return false;
            }
            return root.accepted(root.clamped(text.to-float()));
        }
    }

    Text {
        x: parent.width - self.width;
        y: 0px;
        width: Style.inspector.slider-suffix-width;
        height: Style.inspector.field-height;
        text: root.suffix;
        color: Style.inspector.muted;
        font-size: Style.typography.slider-tick.size;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}
