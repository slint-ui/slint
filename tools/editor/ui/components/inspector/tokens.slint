import { Style } from "../../style.slint";
import { StudioTheme } from "../common.slint";

export global InspectorTokens {
    out property <length> picker-width: Style.inspector.picker-width;
    out property <length> picker-gap: Style.inspector.picker-gap;
    out property <length> picker-margin: Style.inspector.picker-margin;
    out property <color> panel-bg: Style.inspector.panel-bg;
    out property <color> divider: Style.inspector.divider;
    out property <color> field-bg: Style.inspector.field-bg;
    out property <color> field-bg-hover: Style.inspector.field-bg-hover;
    out property <color> field-border: Style.inspector.field-border;
    out property <color> text: Style.inspector.text;
    out property <color> muted: Style.inspector.muted;
    out property <color> accent: Style.inspector.accent;
    out property <color> selected-control-bg: Style.inspector.selected-control-bg;
    out property <color> slider-fill: Style.inspector.slider-fill;
    out property <color> slider-thumb: Style.inspector.slider-thumb;
    out property <length> label-width: Style.inspector.label-width;
    out property <length> row-gap: Style.inspector.row-gap;
    out property <length> side-padding: Style.inspector.side-padding;
    out property <length> section-title-size: Style.inspector.section-title-size;
    out property <length> field-height: Style.inspector.field-height;
    out property <length> field-radius: Style.inspector.field-radius;
    out property <length> column-width: Style.inspector.column-width;
    out property <length> column-gap: Style.inspector.column-gap;
    out property <length> wide-width: Style.inspector.wide-width;
}
