import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextWrapSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Text Wrap");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            accessible-name: @tr("Text Wrap");
            value: InspectorEnumOptions.option-label("wrap", "no-wrap", InspectorEnumOptions.text-word-wrap-options);
            selected-index: InspectorEnumOptions.option-index("wrap", "no-wrap", InspectorEnumOptions.text-word-wrap-options);
            options: InspectorEnumOptions.text-word-wrap-options;
            wide: true;
            accepted(text) => {
                return text != "" && InspectorContext.commit-code("wrap", text);
            }
        }
    }
}
