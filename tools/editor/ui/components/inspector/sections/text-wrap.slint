import { PropertyEditKind } from "../../../properties.slint";

import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import {
    InspectorComboBox,
    InspectorEditableField,
    InspectorEnumOptions,
    InspectorPropertyRow,
    InspectorSection,
} from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextWrapSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: InspectorContext.is-text-selection() ? @tr("Text Wrap") : @tr("Lines");

    if InspectorContext.is-text-selection(): VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            commit-key: InspectorContext.inspector-key;
            accessible-name: @tr("Text Wrap");
            value: InspectorEnumOptions.option-label("wrap", "no-wrap", InspectorEnumOptions.text-word-wrap-options);
            selected-index: InspectorEnumOptions.option-index("wrap", "no-wrap", InspectorEnumOptions.text-word-wrap-options);
            options: InspectorEnumOptions.text-word-wrap-options;
            wide: true;
            accepted(text) => {
                return text != "" && InspectorContext.commit-enum("wrap", text);
            }
        }
    }

    InspectorPropertyRow {
        label: @tr("Max Lines");

        InspectorEditableField {
            accessible-name: @tr("Max lines");
            value: InspectorContext.property-number-label("max-lines", "0");
            commit-key: InspectorContext.field-key("max-lines");
            accepted(text) => {
                return text.is-float() ? InspectorContext.commit-value("max-lines", { kind: PropertyEditKind.integer, integer: text.to-float() }) : InspectorContext.commit-code("max-lines", text);
            }
        }
    }
}
