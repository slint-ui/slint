import { Style, InspectorStyle } from "../../../style.slint";
import { Api, PropertyValue } from "../../../api.slint";
import { InspectorPropertyRow, InspectorSection, InspectorValueField } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorLayoutSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Layout");

    for name in ["padding", "spacing"]: InspectorPropertyRow {
        label: name == "padding" ? @tr("Padding") : @tr("Spacing");
        InspectorValueField {
            property <PropertyValue> layout-value: Api.source-property-value-data(name, {});
            property <bool> numeric-value: self.layout-value.code == ""
                || (self.layout-value.is-number-literal
                    && self.layout-value.value-resolved
                    && self.layout-value.visual-items[self.layout-value.value-int] == "px");
            accessible-name: name == "padding" ? @tr("Layout padding") : @tr("Layout spacing");
            value: self.numeric-value ? "\{self.layout-value.value-float}" : self.layout-value.code;
            commit-key: InspectorContext.inspector-key;
            scrubbable: self.numeric-value;
            scrub-value: self.layout-value.value-float;
            scrub-has-minimum: true;
            scrub-preview(value) => { return Api.inspector-preview(InspectorContext.inspector-key, name, value); }
            scrub-accepted(value) => { return InspectorContext.commit-inspector(name, value); }
            scrub-canceled(value) => { Api.inspector-cancel(); }
            accepted(text) => {
                return text.is-float() ? InspectorContext.commit-inspector(name, text.to-float()) : InspectorContext.commit-code(name, text);
            }
        }
    }
}
