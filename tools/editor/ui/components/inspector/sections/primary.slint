import { Properties } from "../../../properties.slint";

import { InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorPrimarySection inherits InspectorSection {
    private property <bool> value: Properties.editor-property-value-data("primary").value-bool;
    changed value => { toggle.checked = root.value; }

    title: @tr("Emphasis");

    InspectorPropertyRow {
        label: @tr("Primary");

        toggle := InspectorSwitch {
            accessible-label: @tr("Primary");
            checked: root.value;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.value;
                InspectorContext.commit-boolean("primary", requested);
            }
        }
    }
}
