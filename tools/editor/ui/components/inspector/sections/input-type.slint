import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorInputTypeSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Input Type");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            accessible-name: @tr("Input Type");
            value: InspectorEnumOptions.option-label("input-type", "text", InspectorEnumOptions.input-type-options);
            selected-index: InspectorEnumOptions.option-index("input-type", "text", InspectorEnumOptions.input-type-options);
            options: InspectorEnumOptions.input-type-options;
            wide: true;
            accepted(text) => {
                return InspectorContext.commit-code("input-type", text);
            }
        }
    }
}
