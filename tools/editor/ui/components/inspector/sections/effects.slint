import { Properties, PropertyEditKind } from "../../../properties.slint";

import { Style, Metrics, InspectorStyle } from "../../../style.slint";

import { InspectorEffectSlider, InspectorSection, InspectorShadowControl, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";
import { ShadowSession } from "../shadow-session.slint";

export component InspectorEffectsSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <length> field-width;
    private property <bool> blur-enabled: Properties.source-property-value-data("backdrop-blur", {}).code != "";

    title: @tr("Effects");

    VerticalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorEffectSlider {
            width: root.field-width;
            accessible-name: @tr("Opacity");
            label: @tr("Opacity");
            value: (Properties.editor-number-property("opacity", 1) * 100).round();
            commit-key: InspectorContext.field-key("opacity");
            preview(value) => { return InspectorContext.preview-number("opacity", value / 100, ""); }
            accepted(value) => {
                return InspectorContext.commit-value("opacity", { kind: PropertyEditKind.number, number: value / 100 });
            }
            canceled => { Properties.inspector-cancel(); }
        }
        if InspectorContext.is-rectangle-selection(): InspectorShadowControl {
            width: root.field-width;
        }
        if InspectorContext.is-rectangle-selection(): InspectorShadowControl {
            inner: true;
            width: root.field-width;
        }
        if InspectorContext.is-rectangle-selection(): HorizontalLayout {
            private property <bool> blur-enabled: root.blur-enabled;
            changed blur-enabled => { blur-toggle.checked = self.blur-enabled; }

            height: Style.inspector-field.height;
            spacing: Metrics.space-small;
            cross-axis-alignment: center;
            Text {
                text: @tr("Backdrop blur");
                color: Style.inspector-field.appearance.normal.foreground;
                font-size: Style.inspector-field.text.size;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            blur-toggle := InspectorSwitch {
                accessible-label: @tr("Enable backdrop blur");
                checked: root.blur-enabled;
                toggled => {
                    self.focus();
                    self.checked = root.blur-enabled;
                    ShadowSession.close();
                    Properties.inspector-cancel();
                    if root.blur-enabled { InspectorContext.commit-codes([{ name: "backdrop-blur", value: "" }]); }
                    else { InspectorContext.commit-number("backdrop-blur", 16, "px"); }
                }
            }
        }
        if InspectorContext.is-rectangle-selection() && root.blur-enabled: InspectorEffectSlider {
            width: root.field-width;
            accessible-name: @tr("Backdrop blur amount");
            label: @tr("Blur");
            value: Properties.editor-number-property("backdrop-blur", 0);
            maximum: 128;
            clamp-maximum: false;
            commit-key: InspectorContext.field-key("backdrop-blur");
            preview(value) => { return InspectorContext.preview-number("backdrop-blur", value, "px"); }
            accepted(value) => { return InspectorContext.commit-number("backdrop-blur", value, "px"); }
            canceled => { Properties.inspector-cancel(); }
        }
    }
}
