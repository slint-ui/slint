import { Style, InspectorStyle } from "../../../style.slint";
import { Api } from "../../../api.slint";
import { InspectorSection } from "../index.slint";
import { InspectorStringField } from "../string-field.slint";
import { InspectorContext } from "context.slint";
import { InspectorAppearanceFields } from "appearance.slint";

export component InspectorTitleSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Title");
    accessible-role: groupbox;
    accessible-label: root.title;

    HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;

        InspectorStringField {
            accessible-name: @tr("Title");
            clear-label: @tr("Clear title");
            source-value: Api.source-property-value-data("title", {});
            default-value: Api.runtime-property-value-data("title", {}).value-string;
            commit-key: InspectorContext.field-key("title");
            accepted(text) => {
                return InspectorContext.commit-code("title", text);
            }
            preview(text) => { return Api.inspector-preview-string(InspectorContext.inspector-key, "title", text); }
            canceled => { Api.inspector-cancel(); }
        }
    }

    if InspectorContext.is-root-selection(): InspectorAppearanceFields {
        style: root.style;
        pane-width: root.width;
    }
}
