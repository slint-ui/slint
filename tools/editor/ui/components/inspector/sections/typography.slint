import { Properties, PropertyEditKind, PropertyValue } from "../../../properties.slint";

import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEditableField, InspectorEnumOptions, InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorTextFieldBase } from "../text-field-base.slint";
import { InspectorContext } from "context.slint";

export component InspectorTypographySection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <length> field-width;
    in property <length> popup-bottom;
    private property <bool> italic: Properties.editor-property-value-data("font-italic").value-bool;
    private property <PropertyValue> font-family-value: Properties.editor-property-value-data("font-family");

    title: @tr("Typography");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        if Properties.has-property("font-family"): InspectorTextFieldBase {
            accessible-name: @tr("Font family");
            value: root.font-family-value.code == "" ? @tr("Default font") : root.font-family-value.value-string;
            commit-key: InspectorContext.field-key("font-family");
            preview(text) => {
                if text == "" || !Properties.inspector-preview("font-family", { kind: PropertyEditKind.string, text: text }) {
                    Properties.inspector-cancel();
                }
            }
            style: Style.editable-field;
            width: root.field-width;
            accepted(text) => {
                return text != "" && InspectorContext.commit-value("font-family", { kind: PropertyEditKind.string, text: text });
            }
        }

        HorizontalLayout {
            spacing: root.style.column-gap;

            if Properties.has-property("font-weight"): InspectorComboBox {
                accessible-name: @tr("Font weight");
                fit-options: true;
                value: InspectorEnumOptions.text-font-weight-label();
                selected-index: InspectorEnumOptions.text-font-weight-index();
                options: InspectorEnumOptions.text-font-weight-options;
                popup-available-height: max(Style.inspector-field.height, root.popup-bottom - self.absolute-position.y - Metrics.space-medium);
                accepted(text) => {
                    return text.is-float() && InspectorContext.commit-value("font-weight", { kind: PropertyEditKind.integer, integer: text.to-float() });
                }
            }

            if Properties.has-property("font-size"): InspectorEditableField {
                accessible-name: @tr("Font size");
                value: InspectorContext.text-font-size-value();
                commit-key: InspectorContext.field-key("font-size");
                accepted(text) => {
                    return text.is-float()
                        ? InspectorContext.commit-number("font-size", text.to-float(), "px")
                        : InspectorContext.commit-code("font-size", text);
                }
            }
        }
    }

    if Properties.has-property("font-italic"): InspectorPropertyRow {
        label: @tr("Italic");

        InspectorSwitch {
            property <bool> italic: root.italic;
            changed italic => { self.checked = self.italic; }
            accessible-label: @tr("Italic");
            checked: root.italic;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.italic;
                InspectorContext.commit-boolean("font-italic", requested);
            }
        }
    }
}
