import { Properties, PropertyValueKind } from "../../../properties.slint";
import { Style, Metrics, Colors, Typography, InspectorStyle } from "../../../style.slint";
import { InspectorEnumOptions, InspectorComboOption, InspectorSection } from "../index.slint";
import { InspectorAlignmentGroup } from "../alignment-group.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextAlignmentSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <bool> show-vertical: true;
    private property <int> horizontal-option: root.effective-index("horizontal-alignment", "start", InspectorEnumOptions.text-horizontal-alignment-options);
    private property <int> horizontal-index: root.horizontal-option == 0 || root.horizontal-option == 2 ? 0
        : root.horizontal-option == 3 ? 1 : root.horizontal-option == 1 || root.horizontal-option == 4 ? 2 : -1;
    private property <int> vertical-index: root.effective-index("vertical-alignment", "top", InspectorEnumOptions.text-vertical-alignment-options);

    title: @tr("Alignment");

    pure function effective-index(name: string, fallback: string, options: [InspectorComboOption]) -> int {
        let property = Properties.editor-property-value-data(name);
        let value = property.value-kind == PropertyValueKind.enum && property.value-int >= 0 && property.value-int < property.visual-items.length
            ? property.visual-items[property.value-int] : fallback;
        let index = Properties.combo-option-index(value, options);
        return index >= 0 ? index : Properties.combo-option-index(fallback, options);
    }

    function set-horizontal(value: string) {
        if root.horizontal-option < 0 || InspectorEnumOptions.text-horizontal-alignment-options[root.horizontal-option].value != value {
            InspectorContext.commit-enum("horizontal-alignment", value);
        }
    }

    HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        spacing: Metrics.space-small + Metrics.space-tight;

        VerticalLayout {
            spacing: Metrics.space-compact;
            Text {
                text: @tr("Horizontal");
                color: Colors.muted;
                font-size: Typography.control.size;
            }
            ContextMenuArea {
                height: Metrics.control-small;
                horizontal-stretch: 1;
                min-width: 0px;
                Menu {
                    for option[index] in InspectorEnumOptions.text-horizontal-alignment-options: MenuItem {
                        title: option.label;
                        checkable: true;
                        checked: root.horizontal-option == index;
                        activated => { root.set-horizontal(option.value); }
                    }
                }
                InspectorAlignmentGroup {
                    accessible-name: @tr("Horizontal Alignment");
                    selected-index: root.horizontal-index;
                    chosen(index) => { root.set-horizontal(["left", "center", "right"][index]); }
                }
                Tooltip { text: @markdown("\{@tr("Right-click for Start and End alignment")}"); }
            }
        }

        if root.show-vertical: Rectangle {
            width: Metrics.border-width;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: Metrics.control-small; background: Colors.border; }
            }
        }

        if root.show-vertical: VerticalLayout {
            spacing: Metrics.space-compact;
            Text {
                text: @tr("Vertical");
                color: Colors.muted;
                font-size: Typography.control.size;
            }
            InspectorAlignmentGroup {
                vertical: true;
                accessible-name: @tr("Vertical Alignment");
                selected-index: root.vertical-index;
                chosen(index) => { if index != root.vertical-index { InspectorContext.commit-enum("vertical-alignment", ["top", "center", "bottom"][index]); } }
            }
        }
    }
}
