import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorFieldLabel, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextAlignmentSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <length> popup-bottom;

    title: @tr("Alignment");

    GridLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        Row {
            InspectorFieldLabel {
                text: @tr("Horizontal");
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            InspectorComboBox {
                accessible-name: @tr("Horizontal Alignment");
                value: InspectorEnumOptions.text-horizontal-alignment-label();
                selected-index: InspectorEnumOptions.text-horizontal-alignment-index();
                options: InspectorEnumOptions.text-horizontal-alignment-options;
                popup-available-height: max(Style.inspector-field.height, root.popup-bottom - self.absolute-position.y - Metrics.space-medium);
                accepted(text) => {
                    return text != "" && InspectorContext.commit-code("horizontal-alignment", text);
                }
            }

            Rectangle { }
        }

        Row {
            InspectorFieldLabel {
                text: @tr("Vertical");
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            InspectorComboBox {
                accessible-name: @tr("Vertical Alignment");
                value: InspectorEnumOptions.text-vertical-alignment-label();
                selected-index: InspectorEnumOptions.text-vertical-alignment-index();
                options: InspectorEnumOptions.text-vertical-alignment-options;
                popup-available-height: max(Style.inspector-field.height, root.popup-bottom - self.absolute-position.y - Metrics.space-medium);
                accepted(text) => {
                    return text != "" && InspectorContext.commit-code("vertical-alignment", text);
                }
            }

            Rectangle { }
        }
    }
}
