import { Style, Metrics, Colors, Typography, InspectorStyle } from "../../../style.slint";
import { InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorAlignmentGroup } from "../alignment-group.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextAlignmentSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <bool> show-vertical: true;
    private property <int> horizontal-option: InspectorEnumOptions.option-index("horizontal-alignment", "start", InspectorEnumOptions.text-horizontal-alignment-options);
    private property <int> horizontal-index: root.horizontal-option == 0 || root.horizontal-option == 2 ? 0
        : root.horizontal-option == 3 ? 1 : root.horizontal-option == 1 || root.horizontal-option == 4 ? 2 : -1;
    private property <int> vertical-index: InspectorEnumOptions.option-index("vertical-alignment", "top", InspectorEnumOptions.text-vertical-alignment-options);

    title: @tr("Alignment");

    HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        spacing: Metrics.space-small + Metrics.space-tight;

        VerticalLayout {
            spacing: Metrics.space-compact;
            Text {
                text: @tr("Horizontal");
                color: Colors.muted;
                font-size: Typography.control.size;
            }
            InspectorAlignmentGroup {
                accessible-name: @tr("Horizontal Alignment");
                selected-index: root.horizontal-index;
                chosen(index) => { InspectorContext.commit-code("horizontal-alignment", ["left", "center", "right"][index]); }
            }
        }

        if root.show-vertical: Rectangle {
            width: Metrics.border-width;
            VerticalLayout {
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: Metrics.control-medium; background: Colors.border; }
            }
        }

        if root.show-vertical: VerticalLayout {
            spacing: Metrics.space-compact;
            Text {
                text: @tr("Vertical");
                color: Colors.muted;
                font-size: Typography.control.size;
            }
            InspectorAlignmentGroup {
                vertical: true;
                accessible-name: @tr("Vertical Alignment");
                selected-index: root.vertical-index;
                chosen(index) => { InspectorContext.commit-code("vertical-alignment", ["top", "center", "bottom"][index]); }
            }
        }
    }
}
