import { Api } from "../../../api.slint";
import { InspectorEditableField, InspectorPropertyRow, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorCurrentIndexSection inherits InspectorSection {
    title: @tr("Selection");

    InspectorPropertyRow {
        label: @tr("Current Index");

        InspectorEditableField {
            accessible-name: @tr("Current index");
            value: Api.source-property-value("current-index", "-1");
            commit-key: InspectorContext.field-key("current-index");
            accepted(text) => {
                return text != "" && InspectorContext.commit-code("current-index", text);
            }
        }
    }
}
