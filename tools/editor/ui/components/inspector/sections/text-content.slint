import { Properties, PropertyEditKind } from "../../../properties.slint";

import { Style, InspectorStyle } from "../../../style.slint";

import { InspectorCodeField, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";
import { InspectorStringField } from "../string-field.slint";
import { InspectorAppearanceFields } from "appearance.slint";

export component InspectorTextContentSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    callback history-key(KeyEvent) -> EventResult;

    title: @tr("Text");
    accessible-role: groupbox;
    accessible-label: root.title;

    HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;

        if !InspectorContext.has-styled-text-property(): InspectorStringField {
            accessible-name: @tr("Text content");
            source-value: Properties.source-property-value-data("text", {});
            default-value: Properties.editor-property-value-data("text").value-string;
            commit-key: InspectorContext.field-key("text");
            expandable: true;
            accepted(text) => { return InspectorContext.commit-code("text", text); }
            preview(text) => { return Properties.inspector-preview("text", { kind: PropertyEditKind.string, text: text }); }
            canceled => { Properties.inspector-cancel(); }
            history-key(event) => { return root.history-key(event); }
        }

        if InspectorContext.has-styled-text-property(): InspectorCodeField {
            accessible-name: @tr("Text content");
            prefix: @tr("Text");
            fallback: "@markdown(\"\")";
            property-name: "text";
            commit-key: InspectorContext.field-key("text");
            accepted(text) => {
                return InspectorContext.commit-code("text", text);
            }
        }
    }

    if InspectorContext.is-text-selection(): InspectorAppearanceFields {
        style: root.style;
        pane-width: root.width;
    }
}
