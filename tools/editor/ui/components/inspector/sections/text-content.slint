import { Properties } from "../../../properties.slint";

import { Style, InspectorStyle } from "../../../style.slint";

import { InspectorCodeField, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextContentSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Content");

    HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;

        InspectorCodeField {
            accessible-name: @tr("Text content");
            prefix: @tr("Text");
            value: Properties.source-property-value("text", InspectorContext.has-styled-text-property() ? "@markdown(\"\")" : "\"\"");
            commit-key: InspectorContext.field-key("text");
            accepted(text) => {
                return InspectorContext.commit-code("text", text);
            }
        }
    }
}
