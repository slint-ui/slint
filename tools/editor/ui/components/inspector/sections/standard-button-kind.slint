import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorStandardButtonKindSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Kind");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            accessible-name: @tr("Button Kind");
            value: InspectorEnumOptions.option-label("kind", "ok", InspectorEnumOptions.standard-button-kind-options);
            selected-index: InspectorEnumOptions.option-index("kind", "ok", InspectorEnumOptions.standard-button-kind-options);
            options: InspectorEnumOptions.standard-button-kind-options;
            wide: true;
            accepted(text) => {
                return InspectorContext.commit-code("kind", text);
            }
        }
    }
}
