import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorFieldLabel, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorScrollBarPolicySection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Scroll Bars");

    GridLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        Row {
            InspectorFieldLabel {
                text: @tr("Horizontal");
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            InspectorComboBox {
                accessible-name: @tr("Horizontal Scroll Bar Policy");
                value: InspectorEnumOptions.option-label("horizontal-scrollbar-policy", "as-needed", InspectorEnumOptions.scrollbar-policy-options);
                selected-index: InspectorEnumOptions.option-index("horizontal-scrollbar-policy", "as-needed", InspectorEnumOptions.scrollbar-policy-options);
                options: InspectorEnumOptions.scrollbar-policy-options;
                accepted(text) => {
                    return text != "" && InspectorContext.commit-code("horizontal-scrollbar-policy", text);
                }
            }

            Rectangle { }
        }

        Row {
            InspectorFieldLabel {
                text: @tr("Vertical");
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            InspectorComboBox {
                accessible-name: @tr("Vertical Scroll Bar Policy");
                value: InspectorEnumOptions.option-label("vertical-scrollbar-policy", "as-needed", InspectorEnumOptions.scrollbar-policy-options);
                selected-index: InspectorEnumOptions.option-index("vertical-scrollbar-policy", "as-needed", InspectorEnumOptions.scrollbar-policy-options);
                options: InspectorEnumOptions.scrollbar-policy-options;
                accepted(text) => {
                    return text != "" && InspectorContext.commit-code("vertical-scrollbar-policy", text);
                }
            }

            Rectangle { }
        }
    }
}
