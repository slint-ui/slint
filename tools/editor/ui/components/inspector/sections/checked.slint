import { Api, PropertyValue } from "../../../api.slint";
import { InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorCheckedSection inherits InspectorSection {
    private property <PropertyValue> runtime-value: Api.runtime-property-value-data("checked", {});
    private property <PropertyValue> source-value: Api.source-property-value-data("checked", {});
    private property <bool> value: root.runtime-value.value-resolved
        ? root.runtime-value.value-bool
        : root.source-value.code != "" && root.source-value.value-bool;
    changed value => { toggle.checked = root.value; }

    title: @tr("State");

    InspectorPropertyRow {
        label: @tr("Checked");

        toggle := InspectorSwitch {
            accessible-label: @tr("Checked");
            checked: root.value;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.value;
                InspectorContext.commit-code("checked", requested ? "true" : "false");
            }
        }
    }
}
