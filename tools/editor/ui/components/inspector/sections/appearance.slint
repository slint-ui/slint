import { Style, Colors, Metrics, Typography, InspectorStyle } from "../../../style.slint";
import { Api } from "../../../api.slint";
import { InspectorColorField, InspectorCornerEditor, InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorAppearanceSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <length> pane-width;
    private property <bool> clip-value: Api.editor-property-value-data("clip").value-bool;

    title: @tr("APPEARANCE");
    use-shared-title: true;

    pure function corner-property(index: int) -> string {
        return ["border-top-left-radius", "border-top-right-radius", "border-bottom-left-radius", "border-bottom-right-radius"][index];
    }

    function preview-corner(index: int, value: float) -> bool {
        let accepted = index >= 0 ? InspectorContext.preview-number(root.corner-property(index), value, "px")
            : InspectorContext.preview-number(root.corner-property(0), value, "px")
                && InspectorContext.preview-number(root.corner-property(1), value, "px")
                && InspectorContext.preview-number(root.corner-property(2), value, "px")
                && InspectorContext.preview-number(root.corner-property(3), value, "px");
        if !accepted { Api.inspector-cancel(); }
        return accepted;
    }

    VerticalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        spacing: Metrics.space-small;

        Text {
            height: Metrics.icon-small;
            text: InspectorContext.is-text-selection() ? @tr("Color") : @tr("Fill");
            color: Colors.muted;
            font-size: Typography.control.size;
            vertical-alignment: center;
        }

        if InspectorContext.is-root-selection(): InspectorColorField {
            accessible-name: @tr("Root background");
            value: Api.source-property-value("background", "");
            swatch: InspectorContext.property-brush("background");
            commit-key: InspectorContext.field-key("background");
            preview-key: InspectorContext.field-key("background");
            session-key: InspectorContext.fill-session-key("background");
            property-name: "background";
            width: root.pane-width - 2 * root.style.padding;
            accepted(text) => {
                return InspectorContext.commit-code("background", text);
            }
        }

        if InspectorContext.is-rectangle-selection(): InspectorColorField {
            accessible-name: @tr("Rectangle background");
            element-rotation: Api.editor-number-property("transform-rotation", 0);
            target-size: { width: InspectorContext.selected-width(), height: InspectorContext.selected-height() };
            value: Api.source-property-value("background", "");
            swatch: InspectorContext.property-brush("background");
            commit-key: InspectorContext.field-key("background");
            preview-key: InspectorContext.field-key("background");
            session-key: InspectorContext.fill-session-key("background");
            property-name: "background";
            width: root.pane-width - 2 * root.style.padding;
            accepted(text) => {
                return InspectorContext.commit-code("background", text);
            }
        }

        if InspectorContext.is-text-selection(): InspectorColorField {
            accessible-name: @tr("Text color");
            target-size: { width: InspectorContext.selected-width(), height: InspectorContext.selected-height() };
            value: Api.source-property-value("color", "");
            swatch: InspectorContext.property-brush("color");
            commit-key: InspectorContext.field-key("color");
            preview-key: InspectorContext.field-key("color");
            session-key: InspectorContext.fill-session-key("color");
            property-name: "color";
            width: root.pane-width - 2 * root.style.padding;
            accepted(text) => {
                return InspectorContext.commit-code("color", text);
            }
        }
    }
    if InspectorContext.is-rectangle-selection(): HorizontalLayout {
        padding-left: root.style.padding;
        padding-right: root.style.padding;
        InspectorCornerEditor {
            width: root.pane-width - 2 * root.style.padding - Metrics.border-width;
            values: [Api.editor-number-property(root.corner-property(0), Api.editor-number-property("border-radius", 0)), Api.editor-number-property(root.corner-property(1), Api.editor-number-property("border-radius", 0)), Api.editor-number-property(root.corner-property(2), Api.editor-number-property("border-radius", 0)), Api.editor-number-property(root.corner-property(3), Api.editor-number-property("border-radius", 0))];
            source-values: [Api.number-property(root.corner-property(0), Api.number-property("border-radius", 0)), Api.number-property(root.corner-property(1), Api.number-property("border-radius", 0)), Api.number-property(root.corner-property(2), Api.number-property("border-radius", 0)), Api.number-property(root.corner-property(3), Api.number-property("border-radius", 0))];
            maximum: min(InspectorContext.selected-width(), InspectorContext.selected-height()) / 2px;
            selection-key: InspectorContext.selection-key;
            commit-key: InspectorContext.inspector-key;
            preview(index, value) => { return root.preview-corner(index, value); }
            accepted(index, value) => {
                if !root.preview-corner(index, value) { return false; }
                if !Api.inspector-commit() { Api.inspector-cancel(); return false; }
                return true;
            }
            canceled => { Api.inspector-cancel(); }
        }
    }

    if InspectorContext.is-rectangle-selection(): InspectorPropertyRow {
        private property <bool> value: root.clip-value;
        changed value => { clip-toggle.checked = self.value; }

        label: @tr("Clip");

        clip-toggle := InspectorSwitch {
            accessible-label: @tr("Clip");
            checked: root.clip-value;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.clip-value;
                InspectorContext.commit-code("clip", requested ? "true" : "false");
            }
        }
    }
}
