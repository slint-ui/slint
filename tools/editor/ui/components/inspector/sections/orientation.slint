import { Api } from "../../../api.slint";
import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorOrientationSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;
    property <string> default-orientation: Api.current-element.type-name == "RadioGroup" ? "vertical" : "horizontal";

    title: @tr("Orientation");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            accessible-name: @tr("Orientation");
            value: InspectorEnumOptions.option-label("orientation", root.default-orientation, InspectorEnumOptions.orientation-options);
            selected-index: InspectorEnumOptions.option-index("orientation", root.default-orientation, InspectorEnumOptions.orientation-options);
            options: InspectorEnumOptions.orientation-options;
            wide: true;
            accepted(text) => {
                return InspectorContext.commit-code("orientation", text);
            }
        }
    }
}
