import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorTextOverflowSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Text Overflow");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            commit-key: InspectorContext.inspector-key;
            accessible-name: @tr("Text Overflow");
            value: InspectorEnumOptions.option-label("overflow", "clip", InspectorEnumOptions.text-overflow-options);
            selected-index: InspectorEnumOptions.option-index("overflow", "clip", InspectorEnumOptions.text-overflow-options);
            options: InspectorEnumOptions.text-overflow-options;
            wide: true;
            accepted(text) => {
                return text != "" && InspectorContext.commit-enum("overflow", text);
            }
        }
    }
}
