import { Api, PropertyValue } from "../../../api.slint";
import { InspectorEditableField, InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorProgressSection inherits InspectorSection {
    private property <PropertyValue> runtime-indeterminate: Api.runtime-property-value-data("indeterminate", {});
    private property <PropertyValue> source-indeterminate: Api.source-property-value-data("indeterminate", {});
    private property <bool> indeterminate: root.runtime-indeterminate.value-resolved
        ? root.runtime-indeterminate.value-bool
        : root.source-indeterminate.code != "" && root.source-indeterminate.value-bool;
    changed indeterminate => { toggle.checked = root.indeterminate; }

    title: @tr("Progress");

    InspectorPropertyRow {
        label: @tr("Indeterminate");

        toggle := InspectorSwitch {
            accessible-label: @tr("Indeterminate");
            checked: root.indeterminate;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.indeterminate;
                InspectorContext.commit-code("indeterminate", requested ? "true" : "false");
            }
        }
    }

    InspectorPropertyRow {
        label: @tr("Progress");

        InspectorEditableField {
            accessible-name: @tr("Progress value");
            value: Api.source-property-value("progress", "0");
            commit-key: InspectorContext.field-key("progress");
            accepted(text) => {
                return text != "" && InspectorContext.commit-code("progress", text);
            }
        }
    }
}
