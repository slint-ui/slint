import { Style, Metrics, InspectorStyle } from "../../../style.slint";
import { InspectorComboBox, InspectorEnumOptions, InspectorSection } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorMouseCursorSection inherits InspectorSection {
    in property <InspectorStyle> style: Style.inspector-layout;

    title: @tr("Mouse Cursor");

    VerticalLayout {
        padding-left: root.style.padding;
        spacing: Metrics.space-compact;

        InspectorComboBox {
            accessible-name: @tr("Mouse Cursor");
            value: InspectorEnumOptions.option-label("mouse-cursor", "default", InspectorEnumOptions.mouse-cursor-options);
            selected-index: InspectorEnumOptions.option-index("mouse-cursor", "default", InspectorEnumOptions.mouse-cursor-options);
            options: InspectorEnumOptions.mouse-cursor-options;
            wide: true;
            accepted(text) => {
                return text != "" && InspectorContext.commit-code("mouse-cursor", text);
            }
        }
    }
}
