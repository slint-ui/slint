import { Properties, CodeBinding, PropertyValueKind, PropertyEditKind, PropertyEditValue } from "../../../properties.slint";

import { Api, CoordinateSpace, ElementInformation, SelectionRectangle } from "../../../api.slint";

export global InspectorContext {
    out property <ElementInformation> element-information: Api.current-element;
    out property <[SelectionRectangle]> selection-rects: Api.selection.highlight-index >= 0
        ? Api.highlight-positions(InspectorContext.element-information.source-uri, InspectorContext.element-information.offset)
        : [];
    out property <string> selection-key: InspectorContext.element-information.source-uri + ":" + InspectorContext.element-information.offset + ":" + Api.selection.highlight-index;
    out property <string> inspector-key: InspectorContext.element-information.source-uri + ":" + InspectorContext.element-information.source-version + ":" + InspectorContext.element-information.offset + ":" + Api.selection.highlight-index + ":" + Properties.inspector-generation;
    public function commit-value(name: string, value: PropertyEditValue) -> bool {
        if !Properties.inspector-preview(name, value) || !Properties.inspector-commit() {
            Properties.inspector-cancel();
            return false;
        }
        return true;
    }

    public function preview-number(name: string, value: float, unit: string) -> bool {
        return Properties.inspector-preview(name, { kind: PropertyEditKind.number, number: value, unit: unit });
    }

    public function commit-number(name: string, value: float, unit: string) -> bool {
        let property = Properties.source-property-value-data(name, {});
        return InspectorContext.commit-value(name, property.value-kind == PropertyValueKind.integer
            ? { kind: PropertyEditKind.integer, integer: value }
            : { kind: PropertyEditKind.number, number: value, unit: unit });
    }

    public function commit-boolean(name: string, value: bool) -> bool {
        return InspectorContext.commit-value(name, { kind: PropertyEditKind.boolean, boolean: value });
    }

    public function commit-enum(name: string, value: string) -> bool {
        return InspectorContext.commit-value(name, { kind: PropertyEditKind.enumeration, text: value });
    }

    public pure function has-backend-rect() -> bool {
        return Api.selection.highlight-index >= 0 && InspectorContext.selection-rects.length > Api.selection.highlight-index;
    }

    public pure function has-orientation-selection() -> bool {
        return InspectorContext.has-backend-rect() && (InspectorContext.element-information.type-name == "RadioGroup" || InspectorContext.element-information.type-name == "Slider" || InspectorContext.element-information.type-name == "TabWidget");
    }

    public pure function has-current-index-selection() -> bool {
        return InspectorContext.has-backend-rect()
            && (InspectorContext.element-information.type-name == "ComboBox"
                || InspectorContext.element-information.type-name == "RadioGroup"
                || InspectorContext.element-information.type-name == "TabWidget");
    }

    public pure function is-rectangle-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "Rectangle";
    }

    public pure function has-opacity-selection() -> bool {
        return InspectorContext.has-backend-rect() && Properties.has-property("opacity");
    }

    public pure function is-touch-area-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "TouchArea";
    }

    public pure function is-text-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "Text";
    }

    public pure function is-styled-text-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "StyledText";
    }

    public pure function has-styled-text-property() -> bool {
        return InspectorContext.element-information.type-name == "StyledText" || InspectorContext.element-information.type-name == "Tooltip";
    }

    public pure function is-image-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "Image";
    }

    public pure function is-root-selection() -> bool {
        return Api.selection.highlight-index >= 0 && InspectorContext.element-information.id == "root";
    }

    public pure function is-button-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "Button";
    }

    public pure function is-checkable() -> bool {
        return Properties.editor-property-value-data("checkable").value-bool;
    }

    public pure function is-checkbox-selection() -> bool {
        return Api.selection.highlight-index >= 0 && InspectorContext.element-information.type-name == "CheckBox";
    }

    public pure function is-checked-selection() -> bool {
        return InspectorContext.is-checkbox-selection()
            || (InspectorContext.is-button-selection() && InspectorContext.is-checkable());
    }

    public pure function is-slider-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "Slider";
    }

    public pure function is-spinbox-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "SpinBox";
    }

    public pure function is-progress-selection() -> bool {
        return InspectorContext.has-backend-rect()
            && (InspectorContext.element-information.type-name == "ProgressIndicator"
                || InspectorContext.element-information.type-name == "Spinner");
    }

    public pure function has-scrollbar-policy-selection() -> bool {
        return InspectorContext.has-backend-rect() && Properties.has-property("horizontal-scrollbar-policy");
    }

    public pure function is-resizable-selection() -> bool {
        return InspectorContext.has-backend-rect() && Api.selection.is-resizable;
    }

    public pure function has-text-property-selection() -> bool {
        return (Api.selection.highlight-index >= 0 && InspectorContext.element-information.type-name == "Tooltip")
            || (InspectorContext.has-backend-rect() && Properties.has-property("text"));
    }

    public pure function has-typography-selection() -> bool {
        return InspectorContext.has-backend-rect()
            && (InspectorContext.element-information.type-name == "Text"
                || InspectorContext.element-information.type-name == "LineEdit"
                || InspectorContext.element-information.type-name == "TextEdit"
                || InspectorContext.element-information.type-name == "SpinBox");
    }

    public pure function is-title-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && Properties.has-property("title");
    }

    public pure function is-lineedit-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "LineEdit";
    }

    public pure function has-placeholder-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && Properties.has-property("placeholder-text");
    }

    public pure function has-only-horizontal-alignment() -> bool {
        return InspectorContext.has-backend-rect()
            && (InspectorContext.element-information.type-name == "LineEdit"
                || InspectorContext.element-information.type-name == "SpinBox"
                || InspectorContext.element-information.type-name == "TextEdit");
    }

    public pure function is-standard-button-selection() -> bool {
        return InspectorContext.has-backend-rect() && InspectorContext.element-information.type-name == "StandardButton";
    }

    public pure function is-primary-selection() -> bool {
        return InspectorContext.is-button-selection() || InspectorContext.is-standard-button-selection();
    }

    public pure function is-interaction-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && (Properties.has-property("enabled") || Properties.has-property("mouse-drag-pan-enabled"));
    }

    public pure function has-enabled-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && Properties.has-property("enabled");
    }

    public pure function has-mouse-drag-pan-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && Properties.has-property("mouse-drag-pan-enabled");
    }

    public pure function is-read-only-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && Properties.has-property("read-only");
    }

    public pure function is-layout-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && (InspectorContext.element-information.type-name == "GridLayout"
                || InspectorContext.element-information.type-name == "HorizontalLayout"
                || InspectorContext.element-information.type-name == "VerticalLayout"
                || InspectorContext.element-information.type-name == "FlexboxLayout");
    }

    public pure function has-layout-alignment-selection() -> bool {
        return Api.selection.highlight-index >= 0
            && (InspectorContext.element-information.type-name == "HorizontalLayout"
                || InspectorContext.element-information.type-name == "VerticalLayout"
                || InspectorContext.element-information.type-name == "FlexboxLayout");
    }

    public pure function is-flexbox-layout-selection() -> bool {
        return Api.selection.highlight-index >= 0 && InspectorContext.element-information.type-name == "FlexboxLayout";
    }

    public pure function selected-x() -> length {
        return InspectorContext.has-backend-rect()
            ? InspectorContext.selection-rects[Api.selection.highlight-index].x
            : 0px;
    }

    public pure function selected-y() -> length {
        return InspectorContext.has-backend-rect()
            ? InspectorContext.selection-rects[Api.selection.highlight-index].y
            : 0px;
    }

    public pure function selected-width() -> length {
        if InspectorContext.has-backend-rect() {
            return InspectorContext.selection-rects[Api.selection.highlight-index].width;
        }
        return 0px;
    }

    public pure function selected-height() -> length {
        if InspectorContext.has-backend-rect() {
            return InspectorContext.selection-rects[Api.selection.highlight-index].height;
        }
        return 0px;
    }

    public pure function selected-transform-rotation() -> float {
        return InspectorContext.has-backend-rect()
            ? InspectorContext.selection-rects[Api.selection.highlight-index].transform-rotation / 1deg
            : 0;
    }

    public pure function selected-x-label() -> string {
        return (InspectorContext.selected-x() / 1px).to-fixed(0);
    }

    public pure function selected-y-label() -> string {
        return (InspectorContext.selected-y() / 1px).to-fixed(0);
    }

    public pure function selected-width-label() -> string {
        return (InspectorContext.selected-width() / 1px).to-fixed(0);
    }

    public pure function selected-height-label() -> string {
        return (InspectorContext.selected-height() / 1px).to-fixed(0);
    }

    public function commit-geometry(x-text: string, y-text: string, width-text: string, height-text: string) -> bool {
        if !x-text.is-float() || !y-text.is-float() || !width-text.is-float() || !height-text.is-float() {
            return false;
        }

        let new-position = {
            x: x-text.to-float() * 1px,
            y: y-text.to-float() * 1px,
        };
        let new-size = {
            width: width-text.to-float() * 1px,
            height: height-text.to-float() * 1px,
        };

        if new-size.width <= 0px || new-size.height <= 0px {
            return false;
        }

        if InspectorContext.has-backend-rect() {
            Api.selected-element-resize(new-position.x, new-position.y, new-size.width, new-size.height);
            return true;
        }

        return false;
    }

    public function preview-geometry-property(name: string, value: float) -> bool {
        if !InspectorContext.has-backend-rect() {
            return false;
        }
        Api.override-selected-element-geometry(
            name == "x" ? value * 1px : InspectorContext.selected-x(),
            name == "y" ? value * 1px : InspectorContext.selected-y(),
            name == "width" ? value * 1px : InspectorContext.selected-width(),
            name == "height" ? value * 1px : InspectorContext.selected-height(),
            CoordinateSpace.Root,
        );
        return true;
    }

    public function accept-geometry-scrub() -> bool {
        return Api.persist-selected-element-geometry();
    }

    public function commit-code(property-name: string, value: string) -> bool {
        return Properties.commit-code-binding(InspectorContext.element-information, property-name, value);
    }

    public function commit-px-code(property-name: string, value: string) -> bool {
        if !value.is-float() {
            return false;
        }
        return InspectorContext.commit-code(property-name, value + "px");
    }

    public function commit-size-code(property-name: string, value: string) -> bool {
        if !value.is-float() || value.to-float() <= 0 {
            return false;
        }
        return InspectorContext.commit-px-code(property-name, value);
    }

    public pure function field-key(property-name: string) -> string {
        return InspectorContext.inspector-key + ":" + property-name;
    }

    public pure function fill-session-key(property-name: string) -> string {
        return InspectorContext.selection-key + ":" + Properties.inspector-fill-generation + ":" + property-name;
    }

    public pure function property-number-label(property-name: string, fallback: string) -> string {
        let property = Properties.hooked-property-value-data(property-name, { value-string: Properties.source-property-value(property-name, fallback) });
        return property.value-kind == PropertyValueKind.float ? "\{property.value-float}" : property.value-string;
    }

    public pure function property-length-label(property-name: string, fallback: string) -> string {
        let property = Properties.source-property-value-data(property-name, {});
        let value = property.code == "" ? fallback
            : property.value-kind == PropertyValueKind.float || property.kind == PropertyValueKind.float
                ? property.value-float.to-fixed(0) : property.code;
        let hooked = Properties.hooked-property-value-data(property-name, { value-string: value, value-kind: PropertyValueKind.string });
        return hooked.value-kind == PropertyValueKind.float ? hooked.value-float.to-fixed(0) : hooked.value-string;
    }

    public function commit-codes(bindings: [CodeBinding]) -> bool {
        return Properties.set-code-bindings(
            InspectorContext.element-information.source-uri,
            InspectorContext.element-information.source-version,
            InspectorContext.element-information.offset,
            bindings,
        );
    }

    public function choose-image-source() {
        let expression = Properties.choose-image-file(InspectorContext.element-information.source-uri);
        if expression != "" {
            InspectorContext.commit-code("source", expression);
        }
    }

    public pure function text-font-size-value() -> string {
        let value = Properties.editor-property-value-data("font-size");
        if value.code == "" {
            return "\{Api.preview-default-font-size}";
        }
        if value.kind == PropertyValueKind.float && value.visual-items[value.value-int] == "px" {
            return "\{value.value-float}";
        }
        return value.code;
    }

    public function set-image-alignment(column: int, row: int) -> bool {
        if column < 0 || column > 2 || row < 0 || row > 2 {
            return false;
        }
        if !Properties.inspector-preview("horizontal-alignment", { kind: PropertyEditKind.enumeration, text: column == 0 ? "left" : column == 1 ? "center" : "right" })
            || !Properties.inspector-preview("vertical-alignment", { kind: PropertyEditKind.enumeration, text: row == 0 ? "top" : row == 1 ? "center" : "bottom" })
            || !Properties.inspector-commit() {
            Properties.inspector-cancel();
            return false;
        }
        return true;
    }
}
