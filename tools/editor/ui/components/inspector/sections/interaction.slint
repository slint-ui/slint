import { Api } from "../../../api.slint";
import { InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorInteractionSection inherits InspectorSection {
    private property <bool> value: Api.editor-property-value-data("enabled").value-bool;
    changed value => { toggle.checked = root.value; }
    private property <bool> read-only: Api.editor-property-value-data("read-only").value-bool;

    private property <bool> checkable: InspectorContext.is-checkable();

    title: @tr("Interaction");

    InspectorPropertyRow {
        label: @tr("Enabled");

        toggle := InspectorSwitch {
            accessible-label: @tr("Enabled");
            checked: root.value;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.value;
                InspectorContext.commit-code("enabled", requested ? "true" : "false");
            }
        }
    }

    if InspectorContext.is-read-only-selection(): InspectorPropertyRow {
        private property <bool> value: root.read-only;
        changed value => { read-only-toggle.checked = self.value; }

        label: @tr("Read-only");

        read-only-toggle := InspectorSwitch {
            accessible-label: @tr("Read-only");
            checked: root.read-only;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.read-only;
                InspectorContext.commit-code("read-only", requested ? "true" : "false");
            }
        }
    }

    if InspectorContext.is-button-selection(): InspectorPropertyRow {
        private property <bool> value: root.checkable;
        changed value => { checkable-toggle.checked = self.value; }

        label: @tr("Checkable");

        checkable-toggle := InspectorSwitch {
            accessible-label: @tr("Checkable");
            checked: root.checkable;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.checkable;
                InspectorContext.commit-code("checkable", requested ? "true" : "false");
            }
        }
    }
}
