import { Properties } from "../../../properties.slint";

import { InspectorPropertyRow, InspectorSection, InspectorSwitch } from "../index.slint";
import { InspectorContext } from "context.slint";

export component InspectorInteractionSection inherits InspectorSection {
    private property <bool> value: Properties.editor-property-value-data("enabled").value-bool;
    private property <bool> read-only: Properties.editor-property-value-data("read-only").value-bool;

    private property <bool> checkable: InspectorContext.is-checkable();
    private property <bool> mouse-drag-pan: Properties.editor-property-value-data("mouse-drag-pan-enabled").value-bool;

    title: @tr("Interaction");

    if InspectorContext.has-enabled-selection(): InspectorPropertyRow {
        private property <bool> value: root.value;
        changed value => { toggle.checked = self.value; }

        label: @tr("Enabled");

        toggle := InspectorSwitch {
            accessible-label: @tr("Enabled");
            checked: root.value;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.value;
                InspectorContext.commit-boolean("enabled", requested);
            }
        }
    }

    if InspectorContext.is-read-only-selection(): InspectorPropertyRow {
        private property <bool> value: root.read-only;
        changed value => { read-only-toggle.checked = self.value; }

        label: @tr("Read-only");

        read-only-toggle := InspectorSwitch {
            accessible-label: @tr("Read-only");
            checked: root.read-only;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.read-only;
                InspectorContext.commit-boolean("read-only", requested);
            }
        }
    }

    if InspectorContext.is-button-selection(): InspectorPropertyRow {
        private property <bool> value: root.checkable;
        changed value => { checkable-toggle.checked = self.value; }

        label: @tr("Checkable");

        checkable-toggle := InspectorSwitch {
            accessible-label: @tr("Checkable");
            checked: root.checkable;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.checkable;
                InspectorContext.commit-boolean("checkable", requested);
            }
        }
    }

    if InspectorContext.has-mouse-drag-pan-selection(): InspectorPropertyRow {
        private property <bool> value: root.mouse-drag-pan;
        changed value => { mouse-drag-pan-toggle.checked = self.value; }

        label: @tr("Mouse Drag Pan");

        mouse-drag-pan-toggle := InspectorSwitch {
            accessible-label: @tr("Mouse Drag Pan");
            checked: root.mouse-drag-pan;
            toggled => {
                self.focus();
                let requested = self.checked;
                self.checked = root.mouse-drag-pan;
                InspectorContext.commit-boolean("mouse-drag-pan-enabled", requested);
            }
        }
    }
}
