import { FillSession } from "fill-session.slint";

import { Api, FillData, BrushKind } from "../../api.slint";
import { EditorMetrics } from "../common.slint";
import { InspectorTokens } from "tokens.slint";
import { InspectorColorControls } from "color-controls.slint";

import { InspectorGradientGeometry } from "gradient-geometry.slint";
import { InspectorGradientStops } from "gradient-stops.slint";
import { InspectorRecentFills } from "recent-fills.slint";
import { InspectorPickerPanel } from "picker-panel.slint";
import { InspectorSegment } from "segment.slint";

export component InspectorFillPicker inherits Rectangle {
    visible: FillSession.open;
    picker-panel := Rectangle {
        width: FillSession.stop-panel-open && !FillSession.stacked ? 608px : 300px;
        x: FillSession.main-x - (FillSession.stop-panel-open && FillSession.stop-on-left && !FillSession.stacked ? 308px : 0px) - root.absolute-position.x;
        y: FillSession.anchor-position.y.clamp(8px, max(8px, EditorMetrics.window-height - self.height - 8px)) - root.absolute-position.y;
        height: group-content.height;

        picker-focus := FocusScope {
            capture-key-pressed(event) => {
                if (event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z") {
                    FillSession.apply-history(event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.Escape {
                    FillSession.close-picker(false, true);
                    return accept;
                }
                return reject;
            }
            group-content := Rectangle {
                width: parent.width;
                x: 0px;
                y: 0px;
                height: FillSession.stacked ? main-panel.height + 8px + (FillSession.stop-panel-open ? stop-panel.height : 0px) : max(main-panel.height, FillSession.stop-panel-open ? stop-panel.height : 0px);
                TouchArea {
                    clicked => {
                        FillSession.close-picker(true, true);
                    }
                }
                main-panel := InspectorPickerPanel {
                    x: FillSession.stop-panel-open && FillSession.stop-on-left && !FillSession.stacked ? 308px : 0px;
                    y: 0px;
                    height: min(self.preferred-height, max(200px, EditorMetrics.window-height - 16px - (FillSession.stacked ? stop-panel.height + 8px : 0px)));
                    title: "Custom";
                    closed => {
                        FillSession.close-picker(true, true);
                    }
                    if FillSession.unsupported: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: FillSession.expression;
                            color: InspectorTokens.text;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: "This expression cannot be edited as a fill.";
                            color: InspectorTokens.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    if FillSession.allow-gradient && FillSession.editable: HorizontalLayout {
                        spacing: 4px;
                        InspectorSegment {
                            kind: "text";
                            label: "Solid";
                            selected: FillSession.working-fill.kind == BrushKind.solid;
                            clicked => {
                                picker-focus.focus();
                                FillSession.select-kind(BrushKind.solid);
                            }
                        }
                        InspectorSegment {
                            kind: "text";
                            label: "Gradient";
                            selected: FillSession.working-fill.kind != BrushKind.solid;
                            clicked => {
                                picker-focus.focus();
                                FillSession.select-kind(FillSession.last-gradient);
                            }
                        }
                    }
                    if FillSession.editable && FillSession.working-fill.kind != BrushKind.solid: InspectorGradientGeometry {
                        value: FillSession.working-fill;
                        canvas-linear: FillSession.linear-active;
                        session-key: FillSession.session-key;
                        preview(fill) => {
                            return FillSession.preview-fill(fill);
                        }
                        center-mode-selected(custom) => {
                            picker-focus.focus();
                            return FillSession.set-custom-center(custom);
                        }
                        radius-mode-selected(custom) => {
                            picker-focus.focus();
                            return FillSession.set-custom-radius(custom);
                        }
                        type-selected(kind) => {
                            picker-focus.focus();
                            return FillSession.select-kind(kind);
                        }
                    }

                    if FillSession.editable && FillSession.working-fill.kind != BrushKind.solid: InspectorGradientStops {
                        value: FillSession.working-fill;
                        selected-index <=> FillSession.selected-stop;
                        focus-generation: FillSession.focus-stop-generation;
                        edit-color => {
                            FillSession.stop-panel-open = true;
                        }
                        session-key: FillSession.session-key;
                        preview(fill) => {
                            return FillSession.preview-fill(fill);
                        }
                    }
                    if !FillSession.unsupported && FillSession.working-fill.kind == BrushKind.solid: InspectorColorControls {
                        field-height: 170px;
                        value: FillSession.working-color;
                        editable: FillSession.editable;
                        session-key: FillSession.session-key + ":" + FillSession.selected-stop;
                        preview(c) => {
                            return FillSession.preview-color(c);
                        }
                    }

                    if !FillSession.unsupported: InspectorRecentFills {
                        allow-gradient: FillSession.allow-gradient;
                        editable: FillSession.editable;
                        chosen(fill) => {
                            picker-focus.focus();
                            FillSession.select-recent(fill);
                        }
                    }
                }
                stop-panel := InspectorPickerPanel {
                    visible: FillSession.stop-panel-open;
                    x: FillSession.stacked || FillSession.stop-on-left ? 0px : 308px;
                    y: FillSession.stacked ? main-panel.height + 8px : 0px;
                    title: "Stop color";
                    closed => {
                        picker-focus.focus();
                        FillSession.stop-panel-open = false;
                        FillSession.focus-stop-generation += 1;
                    }
                    InspectorColorControls {
                        value: FillSession.working-color;
                        editable: FillSession.editable && FillSession.stop-panel-open;
                        session-key: FillSession.session-key + ":" + FillSession.selected-stop + ":" + (FillSession.stop-panel-open ? "open" : "closed");
                        preview(c) => {
                            return FillSession.preview-color(c);
                        }
                    }
                    if !FillSession.unsupported: InspectorRecentFills {
                        allow-gradient: false;
                        editable: FillSession.editable;
                        chosen(fill) => {
                            FillSession.preview-color(fill.color);
                        }
                    }
                }
            }
        }
    }
}
