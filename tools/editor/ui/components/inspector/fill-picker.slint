import { Style, Metrics, Colors, Typography, FillPickerStyle } from "../../style.slint";
import { FillSession } from "fill-session.slint";

import { BrushKind } from "../../api.slint";
import { EditorWindow } from "../index.slint";

import { InspectorColorControls } from "color-controls.slint";

import { InspectorGradientGeometry } from "gradient-geometry.slint";
import { InspectorGradientStops } from "gradient-stops.slint";
import { InspectorRecentFills } from "recent-fills.slint";
import { InspectorPickerPanel } from "picker-panel.slint";
import { InspectorSegment } from "segment.slint";

export component InspectorFillPicker inherits Rectangle {
    in property <FillPickerStyle> style: Style.fill-picker;
    private property <length> panel-step: root.style.width + root.style.gap;
    private property <length> pair-width: root.style.width + root.panel-step;
    private property <length> margin: root.style.margin;
    private property <length> main-x: (FillSession.request.anchor-position.x >= root.panel-step + root.margin
        ? FillSession.request.anchor-position.x - root.panel-step
        : FillSession.request.anchor-position.x + FillSession.request.anchor-width + root.style.gap)
        .clamp(root.margin, max(root.margin, EditorWindow.width - root.style.width - root.margin));
    private property <bool> stop-on-left: root.main-x >= root.panel-step + root.margin;
    private property <bool> stacked: FillSession.stop-panel-open && !root.stop-on-left
        && root.main-x + root.pair-width > EditorWindow.width - root.margin;
    visible: FillSession.open;
    picker-panel := Rectangle {
        width: FillSession.stop-panel-open && !root.stacked ? root.pair-width : root.style.width;
        x: root.main-x - (FillSession.stop-panel-open && root.stop-on-left && !root.stacked ? root.panel-step : 0px) - root.absolute-position.x;
        y: FillSession.request.anchor-position.y.clamp(root.margin, max(root.margin, EditorWindow.height - self.height - root.margin)) - root.absolute-position.y;
        height: group-content.height;

        picker-focus := FocusScope {
            capture-key-pressed(event) => {
                if (event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z") {
                    FillSession.apply-history(event.modifiers.shift);
                    return accept;
                }
                if event.text == Key.Escape {
                    FillSession.close-picker(false, true);
                    return accept;
                }
                return reject;
            }
            group-content := Rectangle {
                height: root.stacked ? main-panel.height + root.style.gap + (FillSession.stop-panel-open ? stop-panel.height : 0px) : max(main-panel.height, FillSession.stop-panel-open ? stop-panel.height : 0px);
                TouchArea {
                    clicked => {
                        FillSession.close-picker(true, true);
                    }
                }
                main-panel := InspectorPickerPanel {
                    style: root.style;
                    x: FillSession.stop-panel-open && root.stop-on-left && !root.stacked ? root.panel-step : 0px;
                    y: 0px;
                    height: min(self.preferred-height, max(root.style.min-height, EditorWindow.height - 2 * root.margin - (root.stacked ? stop-panel.height + root.style.gap : 0px)));
                    title: "Custom";
                    closed => {
                        FillSession.close-picker(true, true);
                    }
                    if FillSession.request.unsupported: VerticalLayout {
                        spacing: Metrics.space-compact;
                        Text {
                            text: FillSession.request.expression;
                            color: Colors.foreground;
                            font-size: Typography.control.size;
                            overflow: elide;
                        }
                        Text {
                            text: "This expression cannot be edited as a fill.";
                            color: Colors.muted;
                            font-size: Typography.caption.size;
                            wrap: word-wrap;
                        }
                    }

                    if FillSession.request.allow-gradient && FillSession.editable: HorizontalLayout {
                        spacing: Metrics.space-small;
                        InspectorSegment {
                            kind: "text";
                            label: "Solid";
                            selected: FillSession.working-fill.kind == BrushKind.solid;
                            clicked => {
                                picker-focus.focus();
                                FillSession.select-kind(BrushKind.solid);
                            }
                        }
                        InspectorSegment {
                            kind: "text";
                            label: "Gradient";
                            selected: FillSession.working-fill.kind != BrushKind.solid;
                            clicked => {
                                picker-focus.focus();
                                FillSession.select-kind(FillSession.last-gradient);
                            }
                        }
                    }
                    if FillSession.editable && FillSession.working-fill.kind != BrushKind.solid: InspectorGradientGeometry {
                        value: FillSession.working-fill;
                        canvas-active: FillSession.canvas-active;
                        session-key: FillSession.request.target.session-key;
                        preview(fill) => {
                            return FillSession.preview-fill(fill);
                        }
                        center-mode-selected(custom) => {
                            picker-focus.focus();
                            return FillSession.set-custom-center(custom);
                        }
                        radius-mode-selected(custom) => {
                            picker-focus.focus();
                            return FillSession.set-custom-radius(custom);
                        }
                        type-selected(kind) => {
                            picker-focus.focus();
                            return FillSession.select-kind(kind);
                        }
                    }

                    if FillSession.editable && FillSession.working-fill.kind != BrushKind.solid: InspectorGradientStops {
                        edit-color => {
                            FillSession.stop-panel-open = true;
                        }
                    }
                    if !FillSession.request.unsupported && FillSession.working-fill.kind == BrushKind.solid: InspectorColorControls {
                        value: FillSession.working-color;
                        editable: FillSession.editable;
                        session-key: FillSession.request.target.session-key + ":" + FillSession.selected-stop;
                        preview(c) => {
                            return FillSession.preview-color(c);
                        }
                    }

                    if !FillSession.request.unsupported: InspectorRecentFills {
                        allow-gradient: FillSession.request.allow-gradient;
                        editable: FillSession.editable;
                        chosen(fill) => {
                            picker-focus.focus();
                            FillSession.select-recent(fill);
                        }
                    }
                }
                stop-panel := InspectorPickerPanel {
                    style: root.style;
                    visible: FillSession.stop-panel-open;
                    x: root.stacked || root.stop-on-left ? 0px : root.panel-step;
                    y: root.stacked ? main-panel.height + root.style.gap : 0px;
                    title: "Stop color";
                    closed => {
                        picker-focus.focus();
                        FillSession.stop-panel-open = false;
                        FillSession.focus-stop-generation += 1;
                    }
                    InspectorColorControls {
                        value: FillSession.working-color;
                        editable: FillSession.editable && FillSession.stop-panel-open;
                        session-key: FillSession.request.target.session-key + ":" + FillSession.selected-stop + ":" + (FillSession.stop-panel-open ? "open" : "closed");
                        preview(c) => {
                            return FillSession.preview-color(c);
                        }
                    }
                    if !FillSession.request.unsupported: InspectorRecentFills {
                        editable: FillSession.editable;
                        chosen(fill) => {
                            FillSession.preview-color(fill.color);
                        }
                    }
                }
            }
        }
    }
}
