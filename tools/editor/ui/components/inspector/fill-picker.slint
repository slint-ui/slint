import { Api, FillData, BrushKind } from "../../api.slint";
import { EditorMetrics } from "../common.slint";
import { InspectorTokens } from "tokens.slint";
import { InspectorColorControls } from "color-controls.slint";

import { InspectorGradientGeometry } from "gradient-geometry.slint";
import { InspectorGradientStops } from "gradient-stops.slint";
import { ScrollView } from "std-widgets.slint";
import { InspectorPickerPanel } from "picker-panel.slint";
import { InspectorSegment } from "segment.slint";

export component InspectorFillPicker inherits Rectangle {
    in property <FillData> value;
    in property <bool> allow-gradient;
    in property <float> target-width;
    in property <float> target-height;
    private property <FillData> linear-fill;
    private property <FillData> radial-fill;
    private property <FillData> conic-fill;
    private property <BrushKind> last-gradient: BrushKind.linear;
    in property <string> expression: "";
    in property <string> session-key: "";
    in property <string> target-key: "";
    in property <bool> bound: false;
    in property <bool> unsupported: false;
    in property <bool> open: false;
    callback accepted(string, FillData) -> bool;
    callback preview(string, FillData) -> bool;
    callback closed();
    callback restore-focus();
    in property <Point> anchor-position;
    in property <length> anchor-width;

    private property <[FillData]> recent-fills: Api.filter-recent-fills(Api.recent-fills, root.allow-gradient);
    private property <FillData> draft;
    private property <FillData> working-fill: root.value;
    private property <int> selected-stop;
    private property <bool> stop-panel-open;
    private property <length> main-x: (root.anchor-position.x >= 316px ? root.anchor-position.x - 308px : root.anchor-position.x + root.anchor-width + 8px).clamp(8px, max(8px, EditorMetrics.window-width - 308px));
    private property <bool> stop-on-left: root.main-x >= 316px;
    private property <bool> stacked: root.stop-panel-open && !root.stop-on-left && root.main-x + 608px > EditorMetrics.window-width - 8px;
    private property <int> focus-stop-generation;

    private property <color> working-color: root.working-fill.kind == BrushKind.solid ? root.working-fill.color : root.working-fill.stops[root.selected-stop].color;
    private property <bool> has-preview: false;
    private property <string> active-target;
    private property <bool> session-active: false;
    private property <bool> detach-requested: false;
    private property <FillData> original-fill: root.value;
    private property <bool> editable: root.open && !Api.inspector-color-refresh-pending && !root.unsupported && (!root.bound || root.detach-requested);
    private property <bool> popup-open: picker-popup.is-open;

    function preview-fill(fill: FillData) -> bool {
        if !root.session-active || !root.editable { return false; }
        if root.preview(root.active-target, fill) {
            root.has-preview = true;
            root.working-fill = fill;
            if fill.kind == BrushKind.linear { root.linear-fill = fill; }
            if fill.kind == BrushKind.radial { root.radial-fill = fill; }
            if fill.kind == BrushKind.conic { root.conic-fill = fill; }
            return true;
        }
        root.close-picker(false, false);
        return false;
    }
    function preview-color(c: color) -> bool {
        root.draft = root.working-fill;
        if root.draft.kind == BrushKind.solid { root.draft.color = c; }
        else {
            root.draft.stops = Api.clone-gradient-stops(root.working-fill.stops);
            root.draft.stops[root.selected-stop].color = c;
        }
        return root.preview-fill(root.draft);
    }
    function select-kind(kind: BrushKind) -> bool {
        if kind == BrushKind.solid { root.stop-panel-open = false; }
        root.draft = root.working-fill;
        if kind == BrushKind.solid { root.draft.color = root.working-color; root.draft.kind = kind; }
        else {
            root.draft = kind == BrushKind.linear ? root.linear-fill : kind == BrushKind.radial ? root.radial-fill : root.conic-fill;
            root.draft.stops = Api.clone-gradient-stops(root.working-fill.stops.length >= 2 ? root.working-fill.stops : [{color: root.working-color, position: 0}, {color: root.working-color, position: 1}]);
            root.draft.kind = kind;
            root.last-gradient = kind;
        }
        return root.preview-fill(root.draft);
    }

    function select-recent(fill: FillData) {
        root.stop-panel-open = false;
        root.selected-stop = 0;
        root.draft = fill;
        root.draft.stops = Api.clone-gradient-stops(fill.stops);
        root.last-gradient = fill.kind == BrushKind.solid ? root.last-gradient : fill.kind;
        root.preview-fill(root.draft);
    }

    function show-picker() {
        root.stop-panel-open = false;
        root.selected-stop = 0;
        root.working-fill = root.value;
        root.original-fill = root.value;
        root.original-fill.stops = Api.clone-gradient-stops(root.value.stops);
        root.working-fill.stops = Api.clone-gradient-stops(root.value.stops);
        root.linear-fill = {kind: BrushKind.linear, angle: 90};
        root.radial-fill = {kind: BrushKind.radial};
        root.conic-fill = {kind: BrushKind.conic};
        root.last-gradient = root.value.kind == BrushKind.solid ? BrushKind.linear : root.value.kind;
        if root.value.kind == BrushKind.linear { root.linear-fill = root.working-fill; }
        if root.value.kind == BrushKind.radial { root.radial-fill = root.working-fill; }
        if root.value.kind == BrushKind.conic { root.conic-fill = root.working-fill; }
        root.active-target = root.target-key;
        root.has-preview = false;
        root.detach-requested = false;
        root.session-active = true;
        picker-popup.show();
    }

    function close-picker(accept: bool, return-focus: bool) {
        if !root.session-active { return; }
        root.session-active = false;
        root.stop-panel-open = false;
        let changed = Api.fill-brush(root.working-fill) != Api.fill-brush(root.original-fill) || root.detach-requested;
        if !accept || !changed || !root.accepted(root.active-target, root.working-fill) {
            if root.has-preview { Api.inspector-cancel(); }
            root.working-fill = root.original-fill;
        }
        root.has-preview = false;
        root.closed();
        picker-popup.close();
        if return-focus { root.restore-focus(); }
    }

    changed value => {
        if !root.session-active { root.working-fill = root.value; }
    }

    changed session-key => {
        root.close-picker(false, false);
    }

    changed open => {
        if root.open {
            root.show-picker();
        } else {
            root.close-picker(false, false);
        }
    }

    changed popup-open => {
        if !root.popup-open && root.open {
            root.close-picker(root.active-target == root.target-key, false);
        }
    }

    picker-popup := PopupWindow {
        width: root.stop-panel-open && !root.stacked ? 608px : 300px;
        x: root.main-x - (root.stop-panel-open && root.stop-on-left && !root.stacked ? 308px : 0px) - root.absolute-position.x;
        y: root.anchor-position.y.clamp(8px, max(8px, EditorMetrics.window-height - self.height - 8px)) - root.absolute-position.y;
        height: min(group-content.height, max(200px, EditorMetrics.window-height - 16px));
        close-policy: close-on-click-outside;
        forward-focus: picker-focus;
        picker-focus := FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.close-picker(false, true); return accept; }
                return reject;
            }
            ScrollView {
                content-width: self.visible-width;
                content-height: group-content.height;
                group-content := Rectangle {
                    width: parent.visible-width;
                    height: root.stacked ? main-panel.height + 8px + (root.stop-panel-open ? stop-panel.height : 0px) : max(main-panel.height, root.stop-panel-open ? stop-panel.height : 0px);
                    TouchArea { clicked => { root.close-picker(true, true); } }
                    main-panel := InspectorPickerPanel {
                        x: root.stop-panel-open && root.stop-on-left && !root.stacked ? 308px : 0px;
                        title: "Custom";
                        closed => { root.close-picker(true, true); }
                    if root.unsupported: VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: root.expression;
                            color: InspectorTokens.text;
                            font-size: 12px;
                            overflow: elide;
                        }
                        Text {
                            text: "This expression cannot be edited as a fill.";
                            color: InspectorTokens.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    if root.bound && !root.detach-requested && !root.unsupported: HorizontalLayout {
                        height: 26px;
                        Text {
                            text: root.expression;
                            color: InspectorTokens.muted;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 58px;
                            height: 24px;
                            background: InspectorTokens.field-bg;
                            border-radius: InspectorTokens.field-radius;
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Detach color binding";
                                enabled: root.bound && !Api.inspector-color-refresh-pending;
                                function detach-binding() {
                                    if self.enabled {
                                        root.detach-requested = true;
                                    }
                                }
                                clicked => { self.detach-binding(); }
                                accessible-action-default => { self.detach-binding(); }
                                Text {
                                    text: "Detach";
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: InspectorTokens.muted;
                                    font-size: 11px;
                                }
                            }
                        }
                    }

                    if root.allow-gradient && root.editable: HorizontalLayout {
                        spacing: 4px;
                        InspectorSegment { kind: "text"; label: "Solid"; selected: root.working-fill.kind == BrushKind.solid; clicked => { root.select-kind(BrushKind.solid); } }
                        InspectorSegment { kind: "text"; label: "Gradient"; selected: root.working-fill.kind != BrushKind.solid; clicked => { root.select-kind(root.last-gradient); } }
                    }
                    if root.editable && root.working-fill.kind != BrushKind.solid: InspectorGradientGeometry {
                        value: root.working-fill;
                        target-width: root.target-width;
                        target-height: root.target-height;
                        session-key: root.session-key;
                        preview(fill) => { return root.preview-fill(fill); }
                        type-selected(kind) => { return root.select-kind(kind); }
                    }

                    if root.editable && root.working-fill.kind != BrushKind.solid: InspectorGradientStops {
                        value: root.working-fill;
                        selected-index <=> root.selected-stop;
                        focus-generation: root.focus-stop-generation;
                        edit-color => { root.stop-panel-open = true; }
                        session-key: root.session-key;
                        preview(fill) => { return root.preview-fill(fill); }
                    }
                    if !root.unsupported && root.working-fill.kind == BrushKind.solid: InspectorColorControls {
                        field-height: 170px;
                        value: root.working-color;
                        editable: root.editable;
                        session-key: root.session-key + ":" + root.selected-stop;
                        preview(c) => { return root.preview-color(c); }
                    }

                    if !root.unsupported: Text {
                        text: "Recent fills";
                        color: InspectorTokens.muted;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    if !root.unsupported && root.recent-fills.length == 0: Text {
                        text: "No recent fills";
                        color: InspectorTokens.muted;
                        font-size: 11px;
                    }
                    if !root.unsupported && root.recent-fills.length > 0: HorizontalLayout {
                        height: 22px;
                        spacing: 6px;
                        alignment: start;
                        for recent in root.recent-fills: Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: InspectorTokens.divider;
                            background: Api.fill-brush(recent);
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: root.editable;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Recent fill " + Api.fill-expression(recent);
                                clicked => {
                                    if self.enabled {
                                        root.select-recent(recent);
                                    }
                                }
                                accessible-action-default => {
                                    if self.enabled {
                                        root.select-recent(recent);
                                    }
                                }
                            }
                        }
                    }
                    }
                    stop-panel := InspectorPickerPanel {
                        visible: root.stop-panel-open;
                        x: root.stacked || root.stop-on-left ? 0px : 308px;
                        y: root.stacked ? main-panel.height + 8px : 0px;
                        title: "Stop color";
                        closed => { root.stop-panel-open = false; root.focus-stop-generation += 1; }
                        InspectorColorControls {
                            value: root.working-color;
                            editable: root.editable && root.stop-panel-open;
                            session-key: root.session-key + ":" + root.selected-stop + ":" + (root.stop-panel-open ? "open" : "closed");
                            preview(c) => { return root.preview-color(c); }
                        }
                    if !root.unsupported: Text {
                        text: "Recent fills";
                        color: InspectorTokens.muted;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    if !root.unsupported && Api.filter-recent-fills(Api.recent-fills, false).length == 0: Text {
                        text: "No recent fills";
                        color: InspectorTokens.muted;
                        font-size: 11px;
                    }
                    if !root.unsupported && Api.filter-recent-fills(Api.recent-fills, false).length > 0: HorizontalLayout {
                        height: 22px;
                        spacing: 6px;
                        alignment: start;
                        for recent in Api.filter-recent-fills(Api.recent-fills, false): Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: InspectorTokens.divider;
                            background: Api.fill-brush(recent);
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: root.editable;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Recent fill " + Api.fill-expression(recent);
                                clicked => {
                                    if self.enabled {
                                        root.preview-color(recent.color);
                                    }
                                }
                                accessible-action-default => {
                                    if self.enabled {
                                        root.preview-color(recent.color);
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}
