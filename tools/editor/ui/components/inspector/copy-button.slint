import { Style } from "../../style.slint";


export component InspectorCopyButton inherits Rectangle {
    in property <string> label: "Copy";
    callback clicked;

    width: Style.inspector.copy-width;
    height: Style.inspector.field-height;
    border-radius: Style.inspector.field-radius;
    background: touch.has-hover || button-focus.has-focus ? Style.inspector.field-bg-hover : Style.inspector.field-bg;
    border-width: button-focus.has-focus ? 2px : 1px;
    border-color: button-focus.has-focus ? Style.inspector.accent : Style.inspector.divider;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    button-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Text {
        text: "Copy";
        color: Style.inspector.text;
        font-size: Style.typography.section-heading.size;
        font-weight: Style.typography.section-heading.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
}
