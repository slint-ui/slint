import { Style, Metrics, Colors, Typography, ColorSliderStyle, ColorControlsStyle } from "../../style.slint";

import { InspectorColorValueField } from "color-value-field.slint";

component ColorSlider inherits Rectangle {
    in property <ColorSliderStyle> style: Style.color-slider;
    in property <bool> vertical;
    in property <Size> thumb-size;
    in property <string> label;
    in property <float> position;
    in property <bool> enabled;
    in property <bool> dragging;
    in property <color> thumb-shadow;
    callback started();
    callback moved(float);
    callback finished();
    callback canceled();

    height: root.style.height;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: (root.position * 100).to-fixed(1);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-action-set-value(value) => {
        if root.enabled && value.is-float() {
            root.started();
            root.moved((value.to-float() / 100).clamp(0, 1));
            root.finished();
        }
    }
    Rectangle {
        x: root.vertical ? Metrics.space-tight : 0px;
        width: root.width - (root.vertical ? 2 * Metrics.space-tight : 0px);
        border-radius: root.style.radius;
        clip: true;
        @children
    }
    TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.started();
                root.moved((root.vertical ? self.mouse-y / max(1px, self.height) : self.mouse-x / max(1px, self.width)).clamp(0, 1));
            } else if event.kind == PointerEventKind.move && root.dragging {
                root.moved((root.vertical ? self.mouse-y / max(1px, self.height) : self.mouse-x / max(1px, self.width)).clamp(0, 1));
            } else if event.kind == PointerEventKind.up && root.dragging {
                root.finished();
            } else if event.kind == PointerEventKind.cancel {
                root.canceled();
            }
        }
    }
    Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : root.position * (parent.width - self.width);
        y: root.vertical ? root.position * (parent.height - self.height) : (parent.height - self.height) / 2;
        width: root.thumb-size.width;
        height: root.thumb-size.height;
        border-radius: min(self.width, self.height) / 2;
        background: root.vertical ? transparent : Style.rotation-dial.ring;
        border-width: root.vertical ? Metrics.focus-width : Metrics.border-width;
        border-color: root.vertical ? root.style.thumb-border : Style.rotation-dial.ring-border;
        drop-shadow-color: root.thumb-shadow;
        drop-shadow-blur: root.style.shadow.blur;
        if !root.vertical: Rectangle {
            x: Metrics.border-width; y: Metrics.border-width;
            width: parent.width - 2 * Metrics.border-width;
            height: parent.height - 2 * Metrics.border-width;
            border-radius: parent.border-radius - Metrics.border-width;
            background: Style.rotation-dial.face;
            Rectangle {
                width: Metrics.space-small; height: Metrics.space-small;
                border-radius: Metrics.space-tight;
                background: Style.rotation-dial.dot;
            }
        }
    }
}

export component InspectorColorControls inherits Rectangle {
    in property <ColorControlsStyle> style: Style.color-controls;
    in property <color> value;
    private property <length> field-height: root.style.plane.height;
    in property <bool> editable;
    in property <string> session-key;
    callback preview(color) -> bool;
    private property <color> working-color: root.value;
    private property <float> hue;
    private property <float> saturation;
    private property <float> brightness;
    private property <int> alpha: 255;
    private property <bool> dragging;
    private property <color> gesture-color;
    changed value => { root.update-color(root.value); }
    changed session-key => { root.dragging = false; root.update-color(root.value); }
    height: root.field-height + root.style.value-offset + root.style.row-height;
    function color-at() -> color {
        return hsv(root.hue, root.saturation, root.brightness, root.alpha / 255);
    }

    function update-color(c: color) {
        // RGB cannot retain the selected hue at zero saturation or brightness.
        if c != hsv(root.hue, root.saturation, root.brightness, root.alpha / 255) {
            root.hue = c.to-hsv().hue;
            root.saturation = c.to-hsv().saturation;
            root.brightness = c.to-hsv().value;
        }
        root.working-color = c;
        root.alpha = c.alpha;
    }

    init => { root.update-color(root.value); }

    function cancel-gesture() {
        if root.dragging {
            root.dragging = false;
            root.preview-color(root.gesture-color);
        }
    }

    function preview-color(c: color) -> bool {
        if !root.editable {
            return false;
        }
        if root.preview(c) {
            root.update-color(c);
            return true;
        }
        return false;
    }

    function begin-gesture() {
        if root.editable {
            root.dragging = true;
            root.gesture-color = root.working-color;
        }
    }

    function finish-gesture() {
        root.dragging = false;
    }

    function update-saturation-brightness(x: length, y: length, width: length, height: length) {
        root.saturation = (x / max(1px, width)).clamp(0, 1);
        root.brightness = (1 - y / max(1px, height)).clamp(0, 1);
        root.preview-color(root.color-at());
    }

    Rectangle {
        HorizontalLayout {
            y: 0px;
            height: root.field-height;
            spacing: Metrics.space-regular;
            Rectangle {
                horizontal-stretch: 1;
                Rectangle {
                    border-radius: root.style.plane.radius;
                    clip: true;
                    background: hsv(root.hue, 1, 1);

                    Rectangle { background: Style.saturation-spectrum; }
                    Rectangle { background: Style.brightness-spectrum; }
                    Rectangle {
                        border-radius: root.style.plane.radius;
                        border-width: Metrics.border-width;
                        border-color: root.style.plane.border;
                    }
                }
                TouchArea {
                    enabled: root.editable;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                            root.begin-gesture();
                            root.update-saturation-brightness(self.mouse-x, self.mouse-y, self.width, self.height);
                        } else if event.kind == PointerEventKind.move && root.dragging {
                            root.update-saturation-brightness(self.mouse-x, self.mouse-y, self.width, self.height);
                        } else if event.kind == PointerEventKind.up && root.dragging {
                            root.finish-gesture();
                        } else if event.kind == PointerEventKind.cancel {
                            root.cancel-gesture();
                        }
                    }
                }
                Rectangle {
                    x: (root.saturation * parent.width).clamp(root.style.plane.thumb-size / 2, parent.width - root.style.plane.thumb-size / 2) - root.style.plane.thumb-size / 2;
                    y: ((1 - root.brightness) * parent.height).clamp(root.style.plane.thumb-size / 2, parent.height - root.style.plane.thumb-size / 2) - root.style.plane.thumb-size / 2;
                    width: root.style.plane.thumb-size;
                    height: root.style.plane.thumb-size;
                    border-radius: root.style.plane.radius;
                    border-width: Metrics.focus-width;
                    border-color: root.style.plane.thumb-border;
                    drop-shadow-color: root.style.plane.shadow.color;
                    drop-shadow-blur: root.style.plane.shadow.blur;
                }
            }

            ColorSlider {
                vertical: true;
                thumb-size: { width: root.style.hue-thumb-width, height: root.style.hue-thumb-height };
                height: root.field-height;
                label: @tr("Hue");
                width: root.style.hue-width;
                style: root.style.slider;
                position: root.hue / 360;
                enabled: root.editable;
                dragging: root.dragging;
                started => { root.begin-gesture(); }
                moved(position) => {
                    root.hue = 360 * position;
                    root.preview-color(root.color-at());
                }
                finished => { root.finish-gesture(); }
                canceled => { root.cancel-gesture(); }
                Rectangle {
                    background: Style.hue-spectrum;
                }
            }
        }
        HorizontalLayout {
            y: root.field-height + root.style.opacity-label-offset;
            height: Typography.caption.size;
            Text { text: @tr("Opacity"); color: Colors.muted; font-size: Typography.caption.size; }
            Text { text: @tr("{} %", (root.alpha / 255 * 100).round()); color: Colors.muted; font-size: Typography.caption.size; horizontal-alignment: right; }
        }

        ColorSlider {
            y: root.field-height + root.style.opacity-rail-offset;
            height: root.style.opacity-thumb-height - Metrics.space-compact;
            thumb-size: { width: root.style.opacity-thumb-width, height: root.style.opacity-thumb-height };
            label: @tr("Color opacity");
            style: root.style.slider;
            position: root.alpha / 255;
            enabled: root.editable;
            dragging: root.dragging;
            thumb-shadow: root.style.slider.shadow.color;
            started => { root.begin-gesture(); }
            moved(position) => {
                root.alpha = (255 * position).round();
                root.preview-color(root.color-at());
            }
            finished => { root.finish-gesture(); }
            canceled => { root.cancel-gesture(); }
            Rectangle {
                for row in 2: Rectangle {
                    y: row * Style.transparency-grid.cell-size;
                    height: Style.transparency-grid.cell-size;
                    for col in ceil(parent.width / Style.transparency-grid.cell-size): Rectangle {
                        x: col * Style.transparency-grid.cell-size;
                        width: Style.transparency-grid.cell-size;
                        background: (row + col).mod(2) == 0 ? root.style.plane.checker-light : root.style.plane.checker-dark;
                    }
                }
            }
            Rectangle {
                background: @linear-gradient(90deg, transparent, hsv(root.hue, root.saturation, root.brightness, 1));
            }
        }

        InspectorColorValueField {
            y: root.field-height + root.style.value-offset;
            height: root.style.row-height;
            accessible-name: @tr("Hex color");
            value: root.working-color;
            enabled: root.editable;
            live-edit: true;
            swatch-enabled: false;
            commit-key: root.session-key;
            preview(color) => { return root.preview-color(color); }
        }

    }
}
