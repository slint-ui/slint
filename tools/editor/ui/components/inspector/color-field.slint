import { InspectorTokens } from "tokens.slint";
import { InspectorTextFieldBase } from "text-field-base.slint";
import { FillSession } from "fill-session.slint";
import { Api, PropertyValue, PropertyValueKind } from "../../api.slint";

export component InspectorColorField inherits Rectangle {
    in property <string> accessible-name: "";
    in property <string> value;
    in property <brush> swatch;
    in property <Size> target-size: {
        width: Api.current-property-value-data("width").value-float * 1px,
        height: Api.current-property-value-data("height").value-float * 1px,
    };
    in property <bool> wide: false;
    in property <string> commit-key: "";
    in property <string> preview-key: "";
    in property <string> session-key: "";
    in property <string> property-name: "";
    callback accepted(string) -> bool;
    private property <PropertyValue> property-data: Api.current-property-value-data(root.property-name);


    width: wide ? InspectorTokens.wide-width : InspectorTokens.column-width;
    height: InspectorTokens.field-height;

    InspectorTextFieldBase {
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.value;
        commit-key: root.commit-key;
        field-padding-left: 7px;
        content-spacing: 6px;
        accepted(text) => {
            return root.accepted(text);
        }

        swatch-focus := FocusScope {
            width: 24px;
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " {
                    root.show-picker();
                    return accept;
                }
                return reject;
            }
            height: parent.height;
            Rectangle {
                x: 6px;
                y: (parent.height - 11px) / 2;
                width: 11px;
                height: 11px;
                border-radius: 2.5px;
                border-width: 1px;
                border-color: InspectorTokens.muted;
                background: root.swatch;

                for row in 3: Rectangle {
                    x: 2.5px + row * 2.5px;
                    y: 2.5px;
                    width: 1px;
                    height: 6px;
                    background: InspectorTokens.muted.with-alpha(0.35);
                }
                for col in 3: Rectangle {
                    x: 2.5px;
                    y: 2.5px + col * 2.5px;
                    width: 6px;
                    height: 1px;
                    background: InspectorTokens.muted.with-alpha(0.35);
                }
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                accessible-role: AccessibleRole.button;
                accessible-label: root.accessible-name + " color picker";
                clicked => {
                    root.show-picker();
                    swatch-focus.focus();
                }
                accessible-action-default => {
                    root.show-picker();
                    swatch-focus.focus();
                }
            }
        }
    }

    function show-picker() {
        FillSession.close-picker(true, false);
        FillSession.value = root.property-data.fill;
        FillSession.property-name = root.property-name;
        FillSession.target-key = root.preview-key;
        FillSession.session-key = root.session-key;
        FillSession.expression = root.value;
        FillSession.unsupported = !root.property-data.value-resolved;
        FillSession.allow-gradient = root.property-data.kind == PropertyValueKind.brush || root.property-data.value-kind == PropertyValueKind.brush;
        FillSession.canvas-target = root.property-name == "background" && Api.current-element.type-name == "Rectangle";
        FillSession.target-width = root.target-size.width / 1px;
        FillSession.target-height = root.target-size.height / 1px;
        FillSession.anchor-position = swatch-focus.absolute-position;
        FillSession.anchor-width = swatch-focus.width;
        FillSession.open = true;
    }

    private property <int> focus-generation: FillSession.focus-generation;
    changed focus-generation => {
        if FillSession.target-key == root.preview-key { swatch-focus.focus(); }
    }

    changed session-key => {
        if FillSession.open && FillSession.property-name == root.property-name && FillSession.session-key != root.session-key {
            FillSession.close-picker(false, false);
        }
    }
}
