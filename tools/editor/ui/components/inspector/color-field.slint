import { Properties, PropertyValue, PropertyEditKind, BrushKind, ColorFieldData, ColorFieldMode, FillData } from "../../properties.slint";

import { Style, Metrics, ColorFieldStyle } from "../../style.slint";
import { ColorIndicator } from "../../../../lsp/ui/components/widgets/color-indicator.slint";

import { InspectorColorValueField } from "color-value-field.slint";
import { InputSurface } from "../input-surface.slint";
import { InspectorTextFieldBase } from "text-field-base.slint";
import { FillSession } from "fill-session.slint";
import { Api } from "../../api.slint";

export component InspectorColorField inherits Rectangle {
    in property <ColorFieldStyle> style: Style.color-field;
    in property <string> accessible-name: "";
    in property <Size> target-size: {
        width: Properties.runtime-property-value-data("width", {}).value-float * 1px,
        height: Properties.runtime-property-value-data("height", {}).value-float * 1px,
    };
    in property <bool> wide: false;
    in property <string> commit-key: "";
    in property <string> preview-key: "";
    in property <string> session-key: "";
    in property <string> property-name: "";
    in property <float> element-rotation;
    callback accepted(string) -> bool;
    private property <PropertyValue> value: Properties.editor-property-value-data(root.property-name);
    private property <ColorFieldData> data: Properties.color-field-data(root.value);
    // Show the rendered color when the editor cannot resolve the property.
    private property <brush> swatch: root.value.value-resolved ? root.value.value-brush
        : Properties.runtime-property-value-data(root.property-name, {}).value-brush;
    private property <FillData> swatch-fill: Properties.brush-fill(root.swatch);
    private property <bool> is-literal-color: root.data.mode == ColorFieldMode.solid;
    private property <bool> is-gradient: root.data.mode == ColorFieldMode.gradient;

    width: wide ? Style.inspector-layout.content-width : Style.inspector-layout.column-width;
    height: root.style.field.height;

    solid-field := InspectorColorValueField {
        visible: root.is-literal-color;
        style: root.style;
        accessible-name: root.accessible-name;
        value: root.data.fill.color;
        swatch-visible: false;
        width: parent.width;
        commit-key: root.commit-key;
        accepted(color) => {
            return root.commit-color(color);
        }
        preview(color) => {
            return root.preview-color(color);
        }
        scrub-accepted(color) => {
            return root.commit-color(color);
        }
        scrub-canceled(color) => { Properties.inspector-cancel(); }
        swatch-activated => { root.show-picker(); }
    }

    if root.is-gradient: gradient-field := InputSurface {
        style: root.style.field;
        focused: swatch-focus.has-focus;
        hovered: gradient-touch.has-hover;

        HorizontalLayout {
            padding-left: root.style.field.padding-inline;
            padding-right: root.style.field.padding-inline;
            spacing: root.style.field.gap;
            cross-axis-alignment: center;
            Rectangle { width: root.style.swatch-slot-width; }
            Text {
                horizontal-stretch: 1;
                text: root.data.label;
                color: root.style.field.appearance.normal.foreground;
                font-size: root.style.field.text.size;
                font-weight: root.style.field.text.weight;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        gradient-touch := TouchArea {
            clicked => {
                root.show-picker();
                swatch-focus.focus();
            }
        }
    }

    if !root.is-literal-color && !root.is-gradient: InspectorTextFieldBase {
        style: root.style.field;
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.value.code;
        focused: self.input-focused || swatch-focus.has-focus;
        commit-key: root.commit-key;
        accepted(text) => { return root.accepted(text); }

        Rectangle { width: root.style.swatch-slot-width; }
    }

    swatch-focus := FocusScope {
        enabled: !root.is-literal-color;
        x: root.style.field.padding-inline;
        width: root.style.swatch-size;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape && FillSession.open && FillSession.request.target.key == root.preview-key {
                FillSession.close-picker(false, true);
                return accept;
            }
            if event.text == Key.Return || event.text == Key.Space {
                root.show-picker();
                return accept;
            }
            return reject;
        }

        swatch-circle := Rectangle {
            x: (parent.width - root.style.swatch-size) / 2;
            y: (parent.height - root.style.swatch-size) / 2;
            width: root.style.swatch-size;
            height: root.style.swatch-size;
            border-radius: self.width / 2;
            clip: true;

            if root.swatch-fill.kind == BrushKind.solid: ColorIndicator {
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                border-width: Metrics.border-width;
                outline-color: root.style.swatch-border;
                color: root.swatch-fill.color;
                checker-light: root.style.checker.light;
                checker-dark: root.style.checker.dark;
            }

            if root.swatch-fill.kind != BrushKind.solid: Rectangle {
                background: root.swatch;
                border-radius: parent.border-radius;
                border-width: Metrics.border-width;
                border-color: root.style.swatch-border;
            }
        }

        TouchArea {
            visible: !root.is-literal-color;
            accessible-role: AccessibleRole.button;
            accessible-label: @tr("{} color picker", root.accessible-name);
            clicked => {
                root.show-picker();
                swatch-focus.focus();
            }
            accessible-action-default => {
                root.show-picker();
                swatch-focus.focus();
            }
        }
    }

    function commit-color(color: color) -> bool {
        let fill = Properties.fill-with-color(root.data.fill, color);
        if !root.preview-color(color) || !Properties.inspector-commit() { Properties.inspector-cancel(); return false; }
        Properties.add-recent-fill(fill);
        return true;
    }

    function preview-color(color: color) -> bool {
        return Properties.inspector-preview(root.property-name, { kind: PropertyEditKind.fill, fill: Properties.fill-with-color(root.data.fill, color) });
    }

    function show-picker() {
        if FillSession.open && FillSession.request.target.key == root.preview-key
            && FillSession.request.target.session-key == root.session-key {
            return;
        }
        FillSession.begin({
            target: {
                key: root.preview-key,
                session-key: root.session-key,
                property-name: root.property-name,
                size: root.target-size,
                canvas: root.property-name == "background" && Api.current-element.type-name == "Rectangle",
                element-rotation: root.element-rotation,
            },
            anchor-position: root.absolute-position,
            anchor-size: { width: root.width, height: root.height },
            activation-position: root.is-gradient ? root.absolute-position : swatch-focus.absolute-position,
            activation-size: { width: root.is-gradient ? root.width : swatch-focus.width, height: root.height },
        });
    }

    private property <int> focus-generation: FillSession.focus-generation + FillSession.anchor-focus-generation;
    changed focus-generation => {
        if (FillSession.open || !FillSession.request.target.canvas) && FillSession.request.target.key == root.preview-key {
            if root.is-literal-color { solid-field.focus-swatch(); }
            else { swatch-focus.focus(); }
        }
    }
}
