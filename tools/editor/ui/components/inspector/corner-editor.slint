import { Style, Metrics, Colors, Typography, CornerEditorStyle } from "../../style.slint";

import { InspectorValueField } from "value-field.slint";
import { InspectorSlider } from "slider.slint";
import { InspectorCornerModeSelector } from "corner-mode-selector.slint";

export component InspectorCornerEditor inherits Rectangle {
    in property <CornerEditorStyle> style: Style.corner-editor;
    in property <[float]> values;
    in property <float> maximum;
    in property <string> commit-key;
    in property <string> selection-key;
    callback preview(int, float) -> bool;
    callback accepted(int, float) -> bool;
    callback canceled();
    private property <bool> unequal: root.values[0] != root.values[1] || root.values[0] != root.values[2] || root.values[0] != root.values[3];
    private property <bool> separate: root.unequal;
    changed selection-key => { root.separate = root.unequal; }
    changed unequal => { if root.unequal { root.separate = true; } }
    height: layout.preferred-height;
    horizontal-stretch: 1;
    layout := VerticalLayout {
        spacing: root.style.gap;
        HorizontalLayout {
            spacing: Metrics.space-tight;
            Text {
                text: @tr("Corner Radius");
                color: Colors.foreground;
                font-size: Typography.control.size;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            InspectorCornerModeSelector {
                style: root.style.mode;
                separate: root.separate;
                chosen(separate) => {
                    if separate {
                        root.canceled();
                        root.separate = true;
                    } else if root.separate {
                        root.canceled();
                        if root.accepted(-1, root.values[0]) { root.separate = false; }
                    }
                }
            }
        }
        if !root.separate: HorizontalLayout {
            spacing: Metrics.space-regular;
            cross-axis-alignment: center;
            slider := InspectorSlider {
                accessible-name: @tr("All corner radii slider");
                style: root.style.slider;
                value: root.values[0]; maximum: root.maximum; commit-key: root.commit-key;
                preview(value) => { return root.preview(-1, value); }
                accepted(value) => { return root.accepted(-1, value); }
                canceled => { root.canceled(); }
            }
            InspectorValueField {
                style: root.style.uniform-field;
                width: root.style.field-width;
                corner-index: 0;
                accessible-name: @tr("All corner radii");
                value: "\{slider.visual-value}";
                commit-key: root.commit-key;
                scrubbable: true;
                scrub-value: root.values[0];
                scrub-has-minimum: true;
                scrub-preview(value) => { return root.preview(-1, value); }
                scrub-accepted(value) => { return root.accepted(-1, value); }
                scrub-canceled(value) => { root.canceled(); }
                accepted(text) => { return text.is-float() && text.to-float() >= 0 && root.accepted(-1, text.to-float()); }
            }
        }
        if root.separate: VerticalLayout {
            spacing: root.style.gap;
            for row in 2: HorizontalLayout {
                spacing: root.style.gap;
                for column in 2: InspectorValueField {
                style: root.style.field;
                    property <int> index: row * 2 + column;
                    width: (root.width - root.style.gap) / 2;
                    accessible-name: index == 0 ? @tr("Top left corner radius") : index == 1 ? @tr("Top right corner radius") : index == 2 ? @tr("Bottom left corner radius") : @tr("Bottom right corner radius");
                    corner-index: self.index;
                    value: "\{root.values[index]}";
                    commit-key: root.commit-key;
                    scrubbable: true;
                    scrub-value: root.values[self.index];
                    scrub-has-minimum: true;
                    scrub-preview(value) => { return root.preview(self.index, value); }
                    scrub-accepted(value) => { return root.accepted(self.index, value); }
                    scrub-canceled(value) => { root.canceled(); }
                    accepted(text) => { return text.is-float() && text.to-float() >= 0 && root.accepted(self.index, text.to-float()); }
                }
            }
        }
    }
}
