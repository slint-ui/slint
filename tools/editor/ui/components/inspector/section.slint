import { Style } from "../../style.slint";
import { InspectorIconButton } from "icon-button.slint";

import { SectionTitle } from "../common.slint";

export component InspectorSection inherits Rectangle {
    in property <string> title;
    in property <bool> use-shared-title: false;
    in property <bool> show-appearance-icons: false;
    in property <bool> show-typography-icons: false;

    horizontal-stretch: 1;
    height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        width: root.width;
        padding-top: Style.spacing.regular;
        padding-bottom: Style.spacing.regular;
        spacing: Style.spacing.compact;

        Rectangle {
            height: 16px;

            if root.use-shared-title: SectionTitle {
                x: Style.inspector.side-padding;
                width: parent.width - 2 * Style.inspector.side-padding;
                height: parent.height;
                label: root.title;
                vertical-alignment: center;
            }

            if !root.use-shared-title: Text {
                x: Style.inspector.side-padding;
                text: root.title;
                color: Style.inspector.text;
                font-size: Style.inspector.section-title-size;
                font-weight: FontWeight.bold;
                vertical-alignment: center;
            }

            if root.show-appearance-icons: HorizontalLayout {
                x: parent.width - Style.inspector.side-padding - self.preferred-width;
                y: 0.5px;
                height: 18px;
                spacing: Style.spacing.regular;

                InspectorIconButton { kind: "eye"; }
                InspectorIconButton { kind: "drop"; }
            }

            if root.show-typography-icons: HorizontalLayout {
                x: parent.width - Style.inspector.side-padding - self.preferred-width;
                y: 0.5px;
                height: 18px;

                InspectorIconButton { kind: "type-grid"; }
            }
        }

        @children
    }

    Rectangle {
        y: root.height - 1px;
        height: 1px;
        background: Style.inspector.divider;
    }
}
