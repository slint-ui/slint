import { Style, Metrics, Typography, Colors } from "../../style.slint";

import { SectionTitle } from "../index.slint";

export component InspectorSection inherits Rectangle {
    in property <string> title;
    in property <bool> use-shared-title: false;

    horizontal-stretch: 1;
    height: section-layout.preferred-height;

    section-layout := VerticalLayout {
        width: root.width;
        padding-top: Metrics.space-regular;
        padding-bottom: Metrics.space-regular;
        spacing: Metrics.space-compact;

        Rectangle {
            height: Typography.section-heading.size + Metrics.space-small;

            if root.use-shared-title: SectionTitle {
                x: Style.inspector-layout.padding;
                width: parent.width - 2 * Style.inspector-layout.padding;
                height: parent.height;
                label: root.title;
                vertical-alignment: center;
            }

            if !root.use-shared-title: Text {
                x: Style.inspector-layout.padding;
                text: root.title;
                color: Colors.foreground;
                font-size: Typography.section-heading.size;
                font-weight: FontWeight.bold;
                vertical-alignment: center;
            }

        }

        @children
    }

    Rectangle {
        y: root.height - self.height;
        height: Metrics.border-width;
        background: Style.inspector-layout.divider;
    }
}
