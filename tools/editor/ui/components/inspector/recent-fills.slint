import { ButtonTemplate } from "../../../controls/src/templates.slint";
import {
    Style,
    Metrics,
    Colors,
    Typography,
    FillPickerStyle,
} from "../../style.slint";
import { Api, FillData } from "../../api.slint";

export component InspectorRecentFills inherits Rectangle {
    in property <FillPickerStyle> style: Style.fill-picker;
    in property <bool> allow-gradient;
    in property <bool> editable;
    callback chosen(FillData);
    private property <[FillData]> fills: Api.filter-recent-fills(Api.recent-fills, root.allow-gradient);
    height: layout.preferred-height;
    layout := VerticalLayout {
        spacing: Metrics.space-regular;
        Text {
            text: "Recent fills";
            color: Colors.muted;
            font-size: Typography.caption.size;
            font-weight: FontWeight.semi-bold;
        }

        if root.fills.length == 0: Text {
            text: "No recent fills";
            color: Colors.muted;
            font-size: Typography.caption.size;
        }
        if root.fills.length > 0: HorizontalLayout {
            spacing: Metrics.space-compact;
            alignment: start;
            for fill in root.fills: swatch := ButtonTemplate {
                width: root.style.recent-swatch-size;
                height: root.style.recent-swatch-size;
                enabled: root.editable;
                text: "Recent fill " + Api.fill-expression(fill);
                clicked => { root.chosen(fill); }
                background << Rectangle {
                    border-radius: Metrics.radius-small;
                    border-width: Metrics.border-width;
                    border-color: swatch.has-focus ? Colors.accent : Style.inspector-layout.divider;
                    background: Api.fill-brush(fill);
                }
            }
        }
    }
}
