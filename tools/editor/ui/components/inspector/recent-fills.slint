import { Style } from "../../style.slint";
import { Api, FillData } from "../../api.slint";


export component InspectorRecentFills inherits Rectangle {
    in property <bool> allow-gradient;
    in property <bool> editable;
    callback chosen(FillData);
    private property <[FillData]> fills: Api.filter-recent-fills(Api.recent-fills, root.allow-gradient);
    height: layout.preferred-height;
    layout := VerticalLayout {
        spacing: Style.spacing.regular;
        Text { text: "Recent fills"; color: Style.inspector.muted; font-size: Style.typography.caption.size; font-weight: FontWeight.semi-bold; }
        if root.fills.length == 0: Text { text: "No recent fills"; color: Style.inspector.muted; font-size: Style.typography.caption.size; }
        if root.fills.length > 0: HorizontalLayout {
            spacing: Style.spacing.compact;
            alignment: start;
            for fill in root.fills: FocusScope {
                width: Style.inspector.recent-swatch-size;
                height: Style.inspector.recent-swatch-size;
                key-pressed(event) => {
                    if root.editable && (event.text == Key.Return || event.text == Key.Space) {
                        root.chosen(fill);
                        return accept;
                    }
                    return reject;
                }
                Rectangle {
                    border-radius: Style.controls.compact-radius;
                    border-width: Style.controls.border-width;
                    border-color: parent.has-focus ? Style.inspector.accent : Style.inspector.divider;
                    background: Api.fill-brush(fill);
                }
                TouchArea {
                    enabled: root.editable;
                    accessible-role: button;
                    accessible-label: "Recent fill " + Api.fill-expression(fill);
                    clicked => { parent.focus(); root.chosen(fill); }
                    accessible-action-default => { if root.editable { root.chosen(fill); } }
                }
            }
        }
    }
}
