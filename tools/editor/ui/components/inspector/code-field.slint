import { Style, Typography, FieldStyle } from "../../style.slint";

import { InspectorTextFieldBase } from "text-field-base.slint";
import { Properties, PropertyEditKind, PropertyValue } from "../../properties.slint";
import { Api } from "../../api.slint";

export component InspectorCodeField inherits Rectangle {
    in property <FieldStyle> style: Style.code-field;
    in property <string> accessible-name: "";
    in property <string> prefix: "";
    private property <PropertyValue> editor-value: Properties.hooked-property-value-data(root.property-name,
        Properties.source-property-value-data(root.property-name, {}));
    in property <string> value: root.editor-value.code != "" ? root.editor-value.code : "\"\"";
    in property <string> commit-key: "";
    in property <string> property-name: "";
    callback accepted(string) -> bool;

    horizontal-stretch: 1;
    height: root.style.height;

    field := InspectorTextFieldBase {
        style: root.style;
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.value;
        commit-key: root.commit-key;
        preview(text) => {
            if root.property-name != "" && !Properties.inspector-preview(root.property-name, { kind: PropertyEditKind.code, text: text }) {
                Properties.inspector-cancel();
            }
        }
        accepted(text) => {
            if root.property-name != "" {
                if Properties.inspector-preview(root.property-name, { kind: PropertyEditKind.code, text: text }) {
                    if Properties.inspector-commit() { return true; }
                    Properties.inspector-cancel();
                    return false;
                }
                Properties.inspector-cancel();
                return Properties.commit-code-binding(Api.current-element, root.property-name, text);
            }
            return root.accepted(text);
        }

        if root.prefix != "": Text {
            text: root.prefix;
            color: field.paint-foreground;
            font-size: Typography.caption.size;
            vertical-alignment: center;
        }
    }
}
