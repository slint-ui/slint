import { Style, FieldStyle, Metrics } from "../../style.slint";

import { InspectorIconButton } from "icon-button.slint";
import { InspectorTextFieldBase } from "text-field-base.slint";

export component InspectorImageSourceField inherits Rectangle {
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> value;
    in property <string> edit-value;
    callback browse;
    callback accepted(string) -> bool;

    height: root.style.height;

    HorizontalLayout {
        spacing: Metrics.space-small;

        InspectorIconButton {
            kind: "folder";
            label: "Choose image file";
            focus-on-click: false;
            show-focus-ring: false;
            clicked => { root.browse(); }
        }

        source-field := InspectorTextFieldBase {
            horizontal-stretch: 1;
            accessible-name: "Image source";
            value: self.input-focused ? root.edit-value : root.value;
            normalize-accepted: true;
            clear-focus-on-accept: true;
            accepted(value) => { return root.accepted(value); }
            normalized(value) => { return root.value; }
        }
    }
}
