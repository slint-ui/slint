import { Style, FieldStyle } from "../../style.slint";

export component InspectorTextFieldBase inherits Rectangle {
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> accessible-name: "";
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> live-edit: false;
    in property <length> field-padding-left: root.style.padding-inline;
    in property <length> field-padding-right: root.style.padding-inline;
    in property <length> content-spacing: root.style.gap;
    in property <length> input-font-size: root.style.text.size;
    in property <color> input-color: root.enabled ? root.style.normal.foreground : root.style.muted;
    in property <string> commit-key: "";
    private property <string> active-commit-key: root.commit-key;
    private property <bool> edited: false;
    callback accepted(string) -> bool;

    height: root.style.height;
    border-radius: root.style.radius;
    background: !enabled ? root.style.disabled.background : input.has-focus ? root.style.focus.background : touch.has-hover ? root.style.hover.background : root.style.normal.background;
    border-width: input.has-focus ? root.style.border-width : 0px;
    border-color: root.style.focus-border;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.accessible-name;
    accessible-value: input.text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(value) => {
        if root.enabled {
            root.accept-input(value);
        }
    }
    accessible-action-default => {
        if root.enabled {
            input.focus();
        }
    }

    changed value => {
        if !input.has-focus || !root.edited {
            input.text = root.value;
        }
    }

    changed commit-key => {
        root.edited = false;
        input.text = root.value;
        root.active-commit-key = root.commit-key;
    }

    function accept-input(text: string) -> bool {
        if root.active-commit-key != root.commit-key {
            input.text = root.value;
            root.active-commit-key = root.commit-key;
            return false;
        }
        return root.accepted(text);
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: text;
        clicked => { input.focus(); }

        HorizontalLayout {
            padding-left: root.field-padding-left;
            padding-right: root.field-padding-right;
            spacing: root.content-spacing;
            cross-axis-alignment: center;

            @children

            input := TextInput {
                // Disable TextInput's built-in accessibility support as the frame takes care of that.
                accessible-role: none;
                horizontal-stretch: 1;
                text: root.value;
                enabled: root.enabled;
                single-line: true;
                wrap: no-wrap;
                color: root.input-color;
                font-size: root.input-font-size;
                font-weight: root.style.text.weight;
                vertical-alignment: center;
                selection-background-color: root.style.selection;
                text-cursor-width: root.style.border-width;

                edited => {
                    root.edited = true;
                    if root.live-edit { root.accept-input(self.text); }
                }

                accepted => {
                    if !root.accept-input(self.text) {
                        self.text = root.value;
                    }
                }

                changed has-focus => {
                    if self.has-focus {
                        root.active-commit-key = root.commit-key;
                        self.select-all();
                    }
                    if !self.has-focus && self.text != root.value {
                        if !root.accept-input(self.text) {
                            self.text = root.value;
                        }
                    }
                }
            }
        }
    }
}
