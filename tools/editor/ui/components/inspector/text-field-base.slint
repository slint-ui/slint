import { Style, Typography, FieldStyle, PaintStyle } from "../../style.slint";

export component InspectorTextFieldBase inherits Rectangle {
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> accessible-name: "";
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> live-edit: false;
    in property <length> radius: root.style.radius;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <string> suffix: "";
    in property <length> suffix-width: 0px;
    in property <bool> normalize-accepted: false;
    in property <bool> show-focus-border: true;
    private property <PaintStyle> paint: !root.enabled ? root.style.appearance.disabled
        : input.has-focus ? root.style.appearance.focus
        : touch.has-hover ? root.style.appearance.hover : root.style.appearance.normal;
    out property <color> paint-foreground: root.paint.foreground;
    out property <bool> input-focused: input.has-focus;
    in property <string> commit-key: "";
    private property <string> active-commit-key: root.commit-key;
    private property <bool> edited: false;
    callback accepted(string) -> bool;
    callback normalized(string) -> string;

    height: root.style.height;
    border-radius: root.radius;
    background: root.paint.background;
    border-width: root.show-focus-border && input.has-focus ? root.style.border-width : 0px;
    border-color: root.show-focus-border && input.has-focus
        ? root.style.appearance.focus.border
        : root.paint.border;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.accessible-name;
    accessible-value: input.text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(value) => {
        if root.enabled {
            root.accept-input(value);
        }
    }
    accessible-action-default => {
        if root.enabled {
            input.focus();
        }
    }

    changed value => {
        if !input.has-focus || !root.edited {
            input.text = root.value;
        }
    }

    changed commit-key => {
        root.edited = false;
        input.text = root.value;
        root.active-commit-key = root.commit-key;
    }

    function accept-input(text: string) -> bool {
        if root.active-commit-key != root.commit-key {
            input.text = root.value;
            root.active-commit-key = root.commit-key;
            return false;
        }
        let accepted = root.accepted(text);
        if accepted && root.normalize-accepted {
            input.text = root.normalized(text);
            root.edited = false;
        }
        return accepted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: text;
        clicked => { input.focus(); }

        HorizontalLayout {
            padding-left: root.style.padding-inline;
            padding-right: root.style.padding-inline + (root.suffix-width > 0px
                ? root.suffix-width + root.style.gap
                : 0px);
            spacing: root.style.gap;
            cross-axis-alignment: center;

            @children

            input := TextInput {
                // Disable TextInput's built-in accessibility support as the frame takes care of that.
                accessible-role: none;
                horizontal-stretch: 1;
                text: root.value;
                enabled: root.enabled;
                single-line: true;
                wrap: no-wrap;
                horizontal-alignment: root.horizontal-alignment;
                color: root.paint.foreground;
                font-size: root.style.text.size;
                font-weight: root.style.text.weight;
                vertical-alignment: center;
                selection-background-color: root.style.appearance.selection;
                text-cursor-width: root.style.border-width;

                edited => {
                    root.edited = true;
                    if root.live-edit { root.accept-input(self.text); }
                }

                accepted => {
                    if !root.accept-input(self.text) {
                        self.text = root.value;
                    }
                }

                changed has-focus => {
                    if self.has-focus {
                        root.active-commit-key = root.commit-key;
                        self.select-all();
                    }
                    if !self.has-focus && self.text != root.value {
                        if !root.accept-input(self.text) {
                            self.text = root.value;
                        }
                    }
                }
            }

            if root.suffix != "" && root.suffix-width == 0px: Text {
                text: root.suffix;
                color: root.style.appearance.muted;
                font-size: Typography.control.size;
                vertical-alignment: center;
            }

        }

        if root.suffix != "" && root.suffix-width > 0px: fixed-suffix := Text {
            x: parent.width - root.style.padding-inline - root.suffix-width;
            y: 0px;
            width: root.suffix-width;
            height: parent.height;
            text: root.suffix;
            color: root.style.appearance.muted;
            font-size: Typography.control.size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
