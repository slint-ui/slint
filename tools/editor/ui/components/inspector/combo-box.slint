import { Style, PaintStyle, Colors, Metrics, Typography, FieldStyle, ComboMenuStyle } from "../../style.slint";
import { InspectorComboOption } from "control-data.slint";
import { EditorIcons } from "../index.slint";

import { EditorScrollView } from "../editor-scroll-view.slint";

export component InspectorComboBox inherits Rectangle {
    in property <ComboMenuStyle> menu-style: Style.combo-menu;
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> accessible-name: "";
    in property <string> prefix: "";
    in property <string> value;
    in property <int> selected-index: -1;
    in property <[InspectorComboOption]> options;
    in property <bool> wide: false;
    in property <string> placeholder: "";
    in property <length> popup-available-height: root.menu-style.max-height;
    callback accepted(string) -> bool;
    private property <PaintStyle> paint: fallback-popup.is-open ? root.style.appearance.focus
        : native-menu-touch.has-hover || combo-focus.has-focus ? root.style.appearance.hover : root.style.appearance.normal;

    width: wide ? Style.inspector-layout.content-width : Style.inspector-layout.column-width;
    height: root.style.height;
    border-radius: root.style.radius;
    background: root.paint.background;
    border-width: fallback-popup.is-open || combo-focus.has-focus ? Metrics.border-width : 0px;
    border-color: fallback-popup.is-open || combo-focus.has-focus ? root.style.appearance.focus.border : root.paint.border;
    accessible-role: AccessibleRole.combobox;
    accessible-label: root.accessible-name;
    accessible-value: root.value;
    accessible-expanded: fallback-popup.is-open;
    accessible-action-expand => {
        root.show-popup();
    }
    accessible-action-default => {
        root.show-popup();
    }
    accessible-action-set-value(value) => {
        root.accepted(value);
    }

    private property <length> row-height: root.menu-style.row-height;
    private property <length> popup-padding: Metrics.space-small;
    private property <bool> can-open: root.options.length > 0;
    private property <int> highlighted-index: max(root.selected-index, 0);
    private property <bool> use-native-menu:
        Platform.os == OperatingSystemType.macos || Platform.os == OperatingSystemType.windows;

    changed selected-index => {
        if !fallback-popup.is-open {
            root.highlighted-index = max(root.selected-index, 0);
        }
    }

    function option-count() -> int {
        return root.options.length;
    }

    function full-popup-height() -> length {
        return root.option-count() * root.row-height + 2 * root.popup-padding;
    }

    function popup-height() -> length {
        return min(root.full-popup-height(), max(root.row-height + 2 * root.popup-padding, root.popup-available-height));
    }

    function move-highlight(delta: int) {
        if root.option-count() == 0 {
            return;
        }
        root.highlighted-index = (root.highlighted-index + delta).clamp(0, root.option-count() - 1);
    }

    function accept-highlighted() -> bool {
        if root.highlighted-index < 0 || root.highlighted-index >= root.option-count() {
            return false;
        }
        return root.accepted(root.options[root.highlighted-index].value);
    }

    function fallback-popup-y() -> length {
        if Platform.os == OperatingSystemType.macos && root.selected-index >= 0 {
            return root.height / 2
                - root.popup-padding
                - root.selected-index * root.row-height
                - root.row-height / 2;
        }
        return root.height + 2px;
    }

    function native-menu-y() -> length {
        if Platform.os == OperatingSystemType.macos && root.selected-index >= 0 {
            return root.height / 2 - root.selected-index * root.row-height - root.row-height / 2;
        }
        return root.height;
    }

    function show-popup() {
        if !root.can-open {
            return;
        }
        combo-focus.focus();
        root.highlighted-index = root.selected-index >= 0 ? root.selected-index : 0;
        if root.use-native-menu {
            native-menu.show({ x: 0px, y: root.native-menu-y() });
        } else {
            fallback-popup.show();
        }
    }

    combo-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space || event.text == Key.DownArrow {
                root.show-popup();
                return accept;
            }
            return reject;
        }
    }

    native-menu := ContextMenuArea {
        Menu {
            for option[index] in root.options: MenuItem {
                title: option.label;
                checkable: true;
                checked: index == root.selected-index;
                activated => {
                    root.accepted(option.value);
                }
            }
        }

        HorizontalLayout {
            padding-left: Metrics.space-regular;
            padding-right: Metrics.space-regular;
            spacing: Metrics.space-small;
            cross-axis-alignment: center;

            if root.prefix != "": Text {
                text: root.prefix;
                color: root.paint.foreground;
                font-size: Typography.caption.size;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.value != "" ? root.value : root.placeholder;
                color: root.value != "" ? root.paint.foreground : root.style.appearance.muted;
                font-size: root.style.text.size;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }

            Rectangle {
                width: Metrics.icon-medium;
                height: Metrics.icon-medium;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: EditorIcons.select-chevron;
                    colorize: root.style.appearance.muted;
                }
            }
        }

        native-menu-touch := TouchArea {
            mouse-cursor: root.can-open ? pointer : default;
            clicked => {
                root.show-popup();
            }
        }
    }

    fallback-popup := PopupWindow {
        x: 0px;
        y: root.fallback-popup-y();
        width: root.width;
        height: root.popup-height();
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        Rectangle {
            background: root.menu-style.background;
            border-width: Metrics.border-width;
            border-color: root.menu-style.border;
            border-radius: root.style.radius;
            drop-shadow-color: root.menu-style.shadow.color;
            drop-shadow-blur: root.menu-style.shadow.blur;
            drop-shadow-offset-y: root.menu-style.shadow.offset-y;
        }

        popup-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    combo-focus.focus();
                    fallback-popup.close();
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-highlight(-1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-highlight(1);
                    return accept;
                }
                if event.text == Key.Return || event.text == Key.Space {
                    if root.accept-highlighted() {
                        combo-focus.focus();
                        fallback-popup.close();
                    }
                    return accept;
                }
                return reject;
            }

            options-scroll := EditorScrollView {
                x: root.popup-padding;
                y: root.popup-padding;
                width: parent.width - 2 * root.popup-padding;
                height: parent.height - 2 * root.popup-padding;
                content-width: self.width;
                content-height: options-content.height;
                mouse-drag-pan-enabled: true;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                options-content := Rectangle {
                    width: options-scroll.width;
                    height: options-layout.preferred-height;

                    options-layout := VerticalLayout {
                        width: parent.width;
                        alignment: start;

                        for option[index] in root.options: Rectangle {
                            width: parent.width;
                            height: root.row-height;
                            border-radius: root.style.radius;
                            background: index == root.highlighted-index
                                ? Colors.selection
                                : row-touch.has-hover
                                ? root.style.appearance.hover.background
                                : transparent;
                            accessible-role: AccessibleRole.list-item;
                            accessible-label: option.label;

                            Text {
                                x: 7px;
                                width: 14px;
                                text: index == root.selected-index ? "✓" : "";
                                color: root.style.appearance.focus.border;
                                font-size: root.style.text.size;
                                font-weight: FontWeight.semi-bold;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            Text {
                                x: 25px;
                                width: parent.width - self.x - 8px;
                                text: option.label;
                                color: root.style.appearance.normal.foreground;
                                font-size: root.style.text.size;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                            }

                            row-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.highlighted-index = index;
                                    if root.accepted(option.value) {
                                        combo-focus.focus();
                                        fallback-popup.close();
                                    }
                                }

                                changed has-hover => {
                                    if self.has-hover {
                                        root.highlighted-index = index;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
