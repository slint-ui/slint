import { Style, Colors, Metrics, FieldStyle, PaintStyle, ComboMenuStyle } from "../../style.slint";
import { Properties } from "../../properties.slint";
import { InspectorComboOption } from "control-data.slint";
import { EditorWindow } from "../index.slint";

import { ComboBoxBase, ComboBoxPopupBase } from "../../../controls/src/headless.slint";

import { InputSurface } from "../input-surface.slint";
import { FloatingSurface } from "../floating-surface.slint";
import { EditorScrollView } from "../editor-scroll-view.slint";

export component InspectorComboBox inherits ComboBoxBase {
    in property <FieldStyle> style: Style.field;
    in property <ComboMenuStyle> menu-style: Style.combo-menu;
    in property <string> accessible-name: "";
    in property <string> value;
    in property <int> selected-index: -1;
    in property <[InspectorComboOption]> options;
    in property <bool> wide: false;
    in property <bool> popup-upwards: false;
    in property <string> commit-key;
    callback accepted(string) -> bool;
    callback popup-opening();
    out property <string> preview-value: root.expanded && root.highlighted-index >= 0 && root.highlighted-index < root.options.length
        ? root.options[root.highlighted-index].value : "";
    height: root.style.height;
    left-padding: root.style.padding-inline;
    right-padding: root.style.padding-end;
    spacing: Metrics.space-small;
    item-height: root.row-step;
    popup-padding: root.menu-style.padding;
    maximum-visible-items: max(1, floor((root.popup-height - 2 * root.popup-padding) / root.row-step));
    model: Properties.combo-option-values(root.options);
    current-index: root.selected-index;
    accessible-label: root.accessible-name;
    accessible-value: root.value;

    opening => {
        root.popup-opening();
        root.opening-key = root.commit-key;
        root.scroll-y = 0px;
        root.reveal-option(root.selected-index);
        root.popup-y = clamp(root.popup-upwards ? root.height - root.popup-height
                : (root.height - root.menu-style.row-height) / 2 - root.popup-padding
                    - max(0, root.selected-index) * root.row-step - root.scroll-y,
            Metrics.space-regular - root.absolute-position.y,
            EditorWindow.height - Metrics.space-regular - root.absolute-position.y - root.popup-height);
    }
    accept-selection(index) => {
        return index >= 0 && index < root.options.length
            && (!root.expanded || root.opening-key == root.commit-key)
            && root.accepted(root.options[index].value);
    }
    selected(value) => { root.current-index = root.selected-index; }
    highlighted(index) => { root.reveal-option(index); }
    changed selected-index => { root.current-index = root.selected-index; }
    changed commit-key => { root.close(); }
    changed options => { root.close(); }

    preferred-width: root.wide ? 0px : root.options-width;
    min-width: root.wide ? 0px : root.options-width;
    horizontal-stretch: root.wide ? 1 : 0;
    states [
        fitted when !root.wide: { root.max-width: root.options-width; }
    ]
    private property <PaintStyle> paint: !root.enabled ? root.style.appearance.disabled
        : root.focus-visible ? root.style.appearance.focus
        : root.hovered ? root.style.appearance.hover : root.style.appearance.normal;
    private property <length> options-width: options-measure.preferred-width
        + root.style.padding-inline + root.style.padding-end + Metrics.space-small + Metrics.icon-medium;
    private property <length> row-step: root.menu-style.row-height + root.menu-style.spacing;
    private property <length> full-popup-height: root.options.length * root.row-step
        - root.menu-style.spacing + 2 * root.popup-padding;
    popup-height: min(root.full-popup-height, root.menu-style.max-height,
        max(root.row-step + 2 * root.popup-padding, root.popup-upwards
            ? root.absolute-position.y + root.height - Metrics.space-regular
            : EditorWindow.height - 2 * Metrics.space-regular));
    private property <length> popup-y;
    private property <string> opening-key;
    private property <length> scroll-y;

    function reveal-option(index: int) {
        let top = max(0, index) * root.row-step;
        let bottom = top + root.menu-style.row-height;
        if top < -root.scroll-y { root.scroll-y = -top; }
        else if bottom > -root.scroll-y + (root.popup-height - 2 * root.popup-padding) {
            root.scroll-y = (root.popup-height - 2 * root.popup-padding) - bottom;
        }
    }

    Rectangle {
        width: 0px;
        height: 0px;
        clip: true;

        options-measure := VerticalLayout {
            for option in (root.wide ? [] : root.options): Text {
                text: option.label;
                font-size: root.style.text.size;
            }
        }
    }

    background << InputSurface {
        style: root.style;
        enabled: root.enabled;
        focused: root.focus-visible;
        hovered: root.hovered;
    }

    content << value-text := Text {
        horizontal-stretch: 1;
        text: root.value;
        color: root.paint.foreground;
        font-size: root.style.text.size;
        vertical-alignment: center;
        overflow: elide;
    }

    indicator << Rectangle {
        width: Metrics.icon-medium;
        Image {
            width: Metrics.icon-medium;
            height: Metrics.icon-medium;
            source: @image-url("../../assets/lucide/chevron-down.svg");
            transform-rotation: root.expanded ? 180deg : 0deg;
            colorize: root.style.appearance.muted;
        }
    }

    popup << combo-popup := ComboBoxPopupBase {
        popup-offset: root.popup-y - root.height;

        popup-surface := FloatingSurface {
            width: root.width;
            height: root.popup-height;
            background: root.menu-style.background;
            border-color: root.menu-style.border;
            border-radius: Metrics.radius-large;
        }

        options-scroll := EditorScrollView {
            x: root.popup-padding;
            y: root.popup-padding;
            width: root.width - 2 * root.popup-padding;
            height: root.popup-height - 2 * root.popup-padding;
            content-y <=> root.scroll-y;
            content-width: self.width;
            content-height: options-content.height;
            mouse-drag-pan-enabled: true;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            options-content := Rectangle {
                width: options-scroll.width;
                height: options-layout.preferred-height;

                options-layout := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    spacing: root.menu-style.spacing;

                    for option[index] in root.options: Rectangle {
                        width: parent.width;
                        height: root.menu-style.row-height;
                        border-radius: Metrics.radius-small + 1px;
                        background: index == root.highlighted-index ? root.menu-style.highlight
                            : index == root.selected-index ? Colors.selection.with-alpha(0.45) : transparent;
                        border-width: index == root.highlighted-index ? Metrics.border-width : 0px;
                        border-color: Colors.accent.with-alpha(0.26);
                        accessible-role: AccessibleRole.list-item;
                        accessible-label: option.label;
                        accessible-checkable: true;
                        accessible-checked: index == root.selected-index;
                        accessible-action-default => { combo-popup.selected(index); }

                        option-text := Text {
                            x: max(0px, root.style.padding-inline - root.popup-padding);
                            width: parent.width - self.x - max(0px, root.style.padding-end - root.popup-padding);
                            text: option.label;
                            color: root.style.appearance.normal.foreground;
                            font-size: root.style.text.size;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        TouchArea {
                            clicked => {
                                combo-popup.selected(index);
                            }

                            changed has-hover => {
                                if self.has-hover {
                                    combo-popup.highlight(index);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
