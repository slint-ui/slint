import { Style, Colors, Metrics, Typography, SegmentStyle } from "../../style.slint";
import { InspectorSegmentIcon } from "segment-icon.slint";

export component InspectorSegment inherits Rectangle {
    in property <SegmentStyle> style: Style.segment;
    in property <string> kind;
    in property <int> index;
    in property <bool> selected;
    in property <string> label: "\{root.kind} option \{root.index + 1}";
    callback clicked;

    height: root.style.height;
    horizontal-stretch: 1;
    background: selected ? root.style.selected-surface : touch.has-hover || segment-focus.has-focus ? root.style.hover : transparent;
    border-radius: selected ? root.style.radius : 0px;
    border-width: segment-focus.has-focus ? Metrics.focus-width : selected ? Metrics.border-width : 0px;
    border-color: segment-focus.has-focus ? root.style.focus-border : root.style.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    segment-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.kind == "text": Text {
        text: root.label;
        color: root.style.foreground;
        font-size: root.style.text.size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.kind != "text": InspectorSegmentIcon {
        kind: root.kind;
        index: root.index;
        selected: root.selected;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            segment-focus.focus();
            root.clicked();
        }
    }
}
