import { ButtonTemplate } from "../../../controls/src/templates.slint";
import { Style, Metrics, SegmentStyle } from "../../style.slint";
import { InspectorSegmentIcon } from "segment-icon.slint";

export component InspectorSegment inherits ButtonTemplate {
    in property <SegmentStyle> style: Style.segment;
    in property <string> kind;
    in property <int> index;
    in property <bool> selected;
    in property <string> label: "\{root.kind} option \{root.index + 1}";

    height: root.style.height;
    horizontal-stretch: 1;
    text: root.label;
    accessible-checked: root.selected;
    background {
        Rectangle {
            background: root.selected ? root.style.selected-surface : root.hovered || root.has-focus ? root.style.hover : transparent;
            border-radius: root.selected ? root.style.radius : 0px;
            border-width: root.has-focus ? Metrics.focus-width : root.selected ? Metrics.border-width : 0px;
            border-color: root.has-focus ? root.style.focus-border : root.style.border;
        }
    }

    content {
        Rectangle {
            if root.kind == "text": Text {
                text: root.label;
                color: root.style.foreground;
                font-size: root.style.text.size;
                font-weight: root.style.text.weight;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.kind != "text": InspectorSegmentIcon {
                style: root.style;
                kind: root.kind;
                index: root.index;
                selected: root.selected;
            }
        }
    }
}
