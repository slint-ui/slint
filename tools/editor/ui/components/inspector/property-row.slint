import { Style } from "../../style.slint";

export component InspectorPropertyRow inherits HorizontalLayout {
    in property <string> label;
    spacing: Style.inspector.row-gap;
    padding-left: Style.inspector.side-padding;
    padding-right: Style.inspector.side-padding;
    cross-axis-alignment: center;
    Text {
        width: Style.inspector.label-width;
        text: root.label;
        color: Style.inspector.muted;
        font-size: Style.typography.control.size;
        vertical-alignment: center;
    }
    @children
}
