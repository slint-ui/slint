import { Style } from "../../style.slint";
import { Api, FillData, BrushKind, GradientStop, GradientStopOrder } from "../../api.slint";
import { FillSession } from "fill-session.slint";

import { InspectorSegment } from "segment.slint";
import { InspectorTextFieldBase } from "text-field-base.slint";
import { ScrollView } from "std-widgets.slint";

import { GradientStopMarker } from "../../../../lsp/ui/components/widgets/gradient-stop-marker.slint";

export component InspectorGradientStops inherits Rectangle {
    private property <FillData> value: FillSession.working-fill;
    private property <string> session-key: FillSession.request.target.session-key;
    in-out property <int> selected-index <=> FillSession.selected-stop;
    callback edit-color();
    private property <int> focus-generation: FillSession.focus-stop-generation;
    private property <GradientStopOrder> order: Api.gradient-stop-order(root.value.stops, root.selected-index);
    private property <FillData> gesture-value;
    private property <bool> dragging;
    private property <float> units: root.value.kind == BrushKind.conic ? 360 : 100;
    private property <string> suffix: root.value.kind == BrushKind.conic ? "°" : "%";
    preferred-height: layout.preferred-height;
    min-height: layout.min-height;
    changed session-key => {
        root.dragging = false;
    }

    layout := VerticalLayout {
        spacing: Style.spacing.compact;
        ramp := FocusScope {
            height: Style.inspector.stop-ramp-height;
            key-pressed(event) => {
                if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    let step = (event.modifiers.shift ? 10 : 1) / root.units;
                    FillSession.move-stop-position((root.value.stops[root.selected-index].position + (event.text == Key.LeftArrow ? -step : step)).clamp(0, 1));
                    return accept;
                }
                if event.text == Key.UpArrow || event.text == Key.DownArrow {
                    root.selected-index = root.order.indices[(root.order.selected + (event.text == Key.UpArrow ? -1 : 1)).clamp(0, root.value.stops.length - 1)];
                    return accept;
                }
                if event.text == Key.Delete || event.text == Key.Backspace {
                    FillSession.remove-stop(root.selected-index);
                    return accept;
                }
                return reject;
            }
            Rectangle {
                x: Style.inspector.stop-ramp-inset;
                width: parent.width - 2 * Style.inspector.stop-ramp-inset;
                y: Style.spacing.small;
                height: Style.inspector.field-height;
                border-radius: Style.controls.field-radius;
                background: Api.create-brush(BrushKind.linear, 90, transparent, root.value.stops);
                border-width: ramp.has-focus ? Style.controls.border-width : 0px;
                border-color: Style.inspector.accent;
            }
            for stop[index] in root.value.stops: GradientStopMarker {
                marker-size: Style.inspector.stop-marker-size;
                marker-radius: Style.inspector.stop-marker-radius;
                inactive-color: Style.colors.marker-bg;
                active-color: Style.colors.marker-active;
                checker-light: Style.colors.checker-light;
                checker-dark: Style.colors.checker-dark;
                x: stop.position.clamp(0, 1) * (parent.width - Style.inspector.stop-marker-size);
                y: Style.inspector.field-height + Style.spacing.small;
                stop-color: stop.color;
                active: index == root.selected-index;
                z: self.active ? 1 : 0;
                accessible-role: AccessibleRole.slider;
                accessible-label: "Gradient stop " + (index + 1);
                accessible-value: (stop.position * root.units).to-fixed(1);
                accessible-action-set-value(text) => {
                    if text.is-float() {
                        root.selected-index = index;
                        FillSession.move-stop-position(text.to-float() / root.units);
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    let position = ((self.mouse-x - Style.inspector.stop-ramp-inset) / max(1px, self.width - Style.inspector.stop-marker-size)).clamp(0, 1);
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        ramp.focus();
                        root.gesture-value = root.value;
                        let index = Api.nearest-gradient-stop(root.value.stops, position);
                        if index >= 0 && abs(root.value.stops[index].position - position) * (self.width - Style.inspector.stop-marker-size) <= Style.inspector.stop-pick-distance {
                            root.selected-index = index;
                        } else { FillSession.add-stop-position(position); }
                        root.dragging = true;
                    } else if event.kind == PointerEventKind.move && root.dragging {
                        FillSession.move-stop-position(position);
                    } else if event.kind == PointerEventKind.up {
                        root.dragging = false;
                    } else if event.kind == PointerEventKind.cancel && root.dragging {
                        root.dragging = false;
                        root.selected-index = min(root.selected-index, root.gesture-value.stops.length - 1);
                        FillSession.preview-fill(root.gesture-value);
                    }
                }
            }
        }
        HorizontalLayout {
            Text { text: "Stops"; color: Style.inspector.text; font-size: Style.typography.control.size; vertical-alignment: center; }
            Rectangle { }
            InspectorSegment {
                kind: "text";
                label: "+";
                width: Style.inspector.stop-action-width;
                accessible-label: "Add gradient stop";
                clicked => {
                    FillSession.add-stop-position(Api.gradient-stop-gap(root.value.stops));
                }
            }
        }
        HorizontalLayout {
            spacing: Style.spacing.compact;
            Text { text: "Position " + root.suffix; width: Style.inspector.stop-position-width; color: Style.inspector.muted; font-size: Style.typography.caption.size; }
            Text { text: "Color"; horizontal-stretch: 1; color: Style.inspector.muted; font-size: Style.typography.caption.size; }
            Text { text: "Opacity"; width: Style.inspector.stop-opacity-width; color: Style.inspector.muted; font-size: Style.typography.caption.size; }
            Rectangle { width: Style.inspector.stop-action-width; }
        }
        ScrollView {
            preferred-height: rows.preferred-height;
            min-height: Style.inspector.stop-row-height;
            max-height: self.preferred-height;
            content-width: self.visible-width;
            rows := VerticalLayout {
                spacing: Style.spacing.tight;
                for index in root.order.indices: Rectangle {
                    private property <GradientStop> stop: root.value.stops[index];
                    height: Style.inspector.stop-row-height;
                    border-radius: Style.controls.field-radius;
                    background: index == root.selected-index ? Style.colors.selection-bg : transparent;
                    HorizontalLayout {
                        spacing: Style.spacing.compact;
                        InspectorTextFieldBase {
                            width: Style.inspector.stop-position-width;
                            accessible-name: "Stop " + (index + 1) + " position";
                            value: (stop.position * root.units).to-fixed(1);
                            commit-key: root.session-key;
                            accepted(text) => {
                                let number = text;
                                if !number.is-float() {
                                    return false;
                                }
                                root.selected-index = index;
                                return FillSession.move-stop-position(number.to-float() / root.units);
                            }
                        }
                        Rectangle {
                            color-focus := FocusScope {
                                property <int> focus-generation: root.focus-generation;
                                changed focus-generation => {
                                    if root.selected-index == index {
                                        self.focus();
                                    }
                                }
                                key-pressed(event) => {
                                    if event.text == Key.Return || event.text == Key.Space {
                                        root.selected-index = index;
                                        root.edit-color();
                                        return accept;
                                    }
                                    return reject;
                                }
                                HorizontalLayout {
                                    spacing: Style.spacing.compact;
                                    cross-axis-alignment: center;
                                    Rectangle { width: Style.inspector.stop-swatch-size; height: Style.inspector.stop-swatch-size; background: stop.color; border-radius: Style.controls.field-radius; }
                                    Text { text: Api.color-to-data(stop.color).short-text; color: Style.inspector.text; font-size: Style.typography.caption.size; vertical-alignment: center; }
                                }
                                TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Edit stop " + (index + 1) + " color";
                                    clicked => {
                                        parent.focus();
                                        root.selected-index = index;
                                        root.edit-color();
                                    }
                                    accessible-action-default => {
                                        root.selected-index = index;
                                        root.edit-color();
                                    }
                                }
                            }
                        }
                        Text { width: Style.inspector.stop-opacity-width; text: (stop.color.alpha * 100 / 255).to-fixed(0) + "%"; color: Style.inspector.text; font-size: Style.typography.caption.size; vertical-alignment: center; }
                        if root.value.stops.length > 2: InspectorSegment {
                            width: Style.inspector.stop-action-width;
                            kind: "text";
                            label: "−";
                            accessible-label: "Remove stop " + (index + 1);
                            clicked => {
                                FillSession.remove-stop(index);
                            }
                        }
                        if root.value.stops.length <= 2: Rectangle { width: Style.inspector.stop-action-width; }
                    }
                }
            }
        }
    }
}
