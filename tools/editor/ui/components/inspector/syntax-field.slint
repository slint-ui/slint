import { Style } from "../../style.slint";

import { ScrollView } from "std-widgets.slint";

export component InspectorSyntaxField inherits Rectangle {
    in property <string> value;
    in property <length> max-field-height: Style.inspector.syntax-max-height;

    horizontal-stretch: 1;
    height: min(max(Style.inspector.syntax-min-height, syntax-text.preferred-height + 2 * Style.spacing.compact), root.max-field-height);
    border-radius: Style.inspector.field-radius;
    background: Style.inspector.field-bg;
    clip: true;
    accessible-role: AccessibleRole.text;
    accessible-value: root.value;

    syntax-scroll := ScrollView {
        x: Style.spacing.regular;
        y: Style.spacing.compact;
        width: parent.width - 2 * Style.spacing.regular;
        height: parent.height - 2 * Style.spacing.compact;
        content-width: self.width;
        content-height: syntax-text.preferred-height;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        mouse-drag-pan-enabled: true;

        syntax-text := Text {
            width: syntax-scroll.width;
            text: root.value;
            color: Style.inspector.text;
            font-size: Style.typography.caption.size;
            wrap: word-wrap;
        }
    }
}
