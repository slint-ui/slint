import { Style } from "../../style.slint";


import { InspectorSegment } from "segment.slint";

export component InspectorPickerPanel inherits Rectangle {
    in property <string> title;
    callback closed();
    width: Style.inspector.picker-width;
    preferred-height: layout.preferred-height;
    height: self.preferred-height;
    background: Style.inspector.panel-bg;
    border-width: Style.controls.border-width;
    border-color: Style.inspector.divider;
    border-radius: Style.controls.panel-radius;
    drop-shadow-color: Style.shadows.picker.color;
    drop-shadow-blur: Style.shadows.picker.blur;
    drop-shadow-offset-y: Style.shadows.picker.offset-y;
    TouchArea { }
    layout := VerticalLayout {
        padding: Style.spacing.medium;
        spacing: Style.spacing.medium;
        alignment: start;
        HorizontalLayout {
            height: Style.inspector.field-height;
            Text { text: root.title; color: Style.inspector.text; font-size: Style.typography.body.size; font-weight: FontWeight.bold; vertical-alignment: center; }
            Rectangle { }
            InspectorSegment { kind: "text"; label: "Close"; width: Style.inspector.close-width; accessible-label: "Close " + root.title; clicked => { root.closed(); } }
        }
        Rectangle { height: 1px; background: Style.inspector.divider; }
        @children
    }
}
