import { Style, Colors, Metrics, Typography, FillPickerStyle } from "../../style.slint";
import { EditorWindow } from "../index.slint";
import { EditorScrollView } from "../editor-scroll-view.slint";
import { InspectorIconButton } from "icon-button.slint";

import { InspectorSegment } from "segment.slint";

import { FloatingSurface } from "../floating-surface.slint";

export component InspectorPickerPanel inherits FloatingSurface {
    in property <FillPickerStyle> style: Style.fill-picker;
    in property <string> title;
    in property <bool> show-fill-modes;
    in property <bool> gradient;
    callback mode-selected(bool);
    in-out property <Point> window-position;
    in property <Point> parent-origin;
    callback closed();
    callback activated();
    private property <length> horizontal-margin: min(root.style.margin, max(0px, root.available-space.width / 2));
    private property <length> vertical-margin: min(root.style.margin, max(0px, root.available-space.height / 2));
    private property <Size> available-space: { width: EditorWindow.width - root.width, height: EditorWindow.height - root.height };
    private property <Point> drag-offset;
    private property <length> mode-width: 2 * (Style.field.height + Metrics.space-small);

    pure function bounded-position(position: Point) -> Point {
        return {
            x: position.x.clamp(root.horizontal-margin, max(root.horizontal-margin, root.available-space.width - root.horizontal-margin)),
            y: position.y.clamp(root.vertical-margin, max(root.vertical-margin, root.available-space.height - root.vertical-margin)),
        };
    }

    public function place-next-to(position: Point, size: Size) {
        let left = position.x - root.style.gap - root.width;
        let right = position.x + size.width + root.style.gap;
        let below = position.y + size.height + root.style.gap;
        let above = position.y - root.style.gap - root.height;
        let candidate = left >= root.horizontal-margin ? { x: left, y: position.y }
            : right + root.width <= EditorWindow.width - root.horizontal-margin ? { x: right, y: position.y }
            : below + root.height <= EditorWindow.height - root.vertical-margin ? { x: position.x, y: below }
            : above >= root.vertical-margin ? { x: position.x, y: above }
            : { x: left, y: position.y };
        root.window-position = root.bounded-position(candidate);
    }

    changed available-space => { root.window-position = root.bounded-position(root.window-position); }

    x: root.window-position.x - root.parent-origin.x;
    y: root.window-position.y - root.parent-origin.y;
    width: min(root.style.width, max(0px, EditorWindow.width - 2 * root.style.margin));
    preferred-height: root.style.body-top + body-layout.preferred-height + Metrics.space-large;
    height: min(self.preferred-height, max(0px, EditorWindow.height - 2 * root.style.margin));
    background: root.style.background;
    border-width: Metrics.border-width;
    border-color: root.style.border;
    border-radius: root.style.radius;

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.activated(); }
        }
        scroll-event(event) => { return accept; }
    }

    header := Rectangle {
        x: Metrics.space-large;
        y: Metrics.space-medium;
        width: max(0px, parent.width - 2 * Metrics.space-large);
        height: Metrics.control-small;
        Text {
            x: 0px;
            width: max(0px, parent.width - close-button.width - Metrics.space-small - (root.show-fill-modes ? root.mode-width + Metrics.space-medium : 0px));
            text: root.title;
            color: Colors.foreground;
            font-size: Typography.action.size;
            font-weight: FontWeight.semi-bold;
            vertical-alignment: center;
        }
        drag-handle := TouchArea {
            width: max(0px, parent.width - close-button.width - Metrics.space-small - (root.show-fill-modes ? root.mode-width + Metrics.space-medium : 0px));
            mouse-cursor: self.pressed ? grabbing : grab;
            accessible-role: button;
            accessible-label: @tr("Move {} picker", root.title);
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.activated();
                    root.drag-offset = {
                        x: root.window-position.x - self.absolute-position.x - self.mouse-x,
                        y: root.window-position.y - self.absolute-position.y - self.mouse-y,
                    };
                } else if event.kind == PointerEventKind.move && self.pressed {
                    root.window-position = root.bounded-position({
                        x: self.absolute-position.x + self.mouse-x + root.drag-offset.x,
                        y: self.absolute-position.y + self.mouse-y + root.drag-offset.y,
                    });
                }
            }
        }
        if root.show-fill-modes: Rectangle {
            x: parent.width - close-button.width - Metrics.space-medium - self.width;
            width: root.mode-width; height: Style.field.height;
            for gradient[i] in [false, true]: InspectorSegment {
                x: i * (Style.field.height + Metrics.space-small);
                width: Style.field.height; height: Style.field.height;
                selected: root.gradient == gradient;
                label: gradient ? @tr("Gradient") : @tr("Solid");
                Image { width: 18px; height: 18px;
                    source: gradient ? @image-url("../../assets/fill-gradient.svg") : @image-url("../../assets/fill-solid.svg");
                    colorize: root.gradient == gradient ? Colors.foreground : Colors.muted;
                }
                clicked => { root.mode-selected(gradient); }
                Tooltip { text: @markdown("\{gradient ? @tr("Gradient") : @tr("Solid")}"); }
            }
        }
        close-button := InspectorIconButton {
            width: Style.field.height; height: Style.field.height;
            x: parent.width - self.width;
            kind: "close";
            label: @tr("Close {}", root.title);
            clicked => { root.closed(); }
        }
    }
    divider := Rectangle {
        x: Metrics.space-large;
        y: header.y + header.height + Metrics.space-tight;
        width: max(0px, parent.width - 2 * Metrics.space-large);
        height: Metrics.border-width;
        background: Style.inspector-layout.divider;
    }
    body := EditorScrollView {
        x: Metrics.space-large;
        y: root.style.body-top;
        width: max(0px, parent.width - 2 * Metrics.space-large);
        height: max(0px, parent.height - self.y - Metrics.space-medium);
        content-width: self.visible-width;
        content-height: body-content.height;
        body-content := Rectangle {
            width: body.visible-width;
            height: max(body.visible-height, body-layout.min-height);
            body-layout := VerticalLayout {
                spacing: Metrics.space-medium;
                alignment: start;
                @children
            }
        }
    }
}
