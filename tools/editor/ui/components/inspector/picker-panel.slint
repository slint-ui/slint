import { Style, Colors, Metrics, Typography, FillPickerStyle } from "../../style.slint";

import { InspectorSegment } from "segment.slint";

export component InspectorPickerPanel inherits Rectangle {
    in property <FillPickerStyle> style: Style.fill-picker;
    in property <string> title;
    callback closed();
    width: root.style.width;
    preferred-height: layout.preferred-height;
    height: self.preferred-height;
    background: root.style.background;
    border-width: Metrics.border-width;
    border-color: root.style.border;
    border-radius: root.style.radius;
    drop-shadow-color: root.style.shadow.color;
    drop-shadow-blur: root.style.shadow.blur;
    drop-shadow-offset-y: root.style.shadow.offset-y;
    TouchArea { }
    layout := VerticalLayout {
        padding: Metrics.space-medium;
        spacing: Metrics.space-medium;
        alignment: start;
        HorizontalLayout {
            height: Style.inspector-field.height;
            Text { text: root.title; color: Colors.foreground; font-size: Typography.body.size; font-weight: FontWeight.bold; vertical-alignment: center; }
            Rectangle { }
            InspectorSegment { kind: "text"; label: "Close"; width: root.style.close-width; accessible-label: "Close " + root.title; clicked => { root.closed(); } }
        }
        Rectangle { height: Metrics.border-width; background: root.style.border; }
        @children
    }
}
