import { Icons } from "../../icons/index.slint";
import { Style, SegmentStyle } from "../../style.slint";

export component InspectorSegmentIcon inherits Rectangle {
    in property <SegmentStyle> style: Style.segment;
    in property <string> kind;
    in property <int> index;
    in property <bool> selected;

    if root.kind == "horizontal" || root.kind == "vertical": Image {
        x: 0px;
        y: 0px;
        width: 18px;
        height: 18px;
        source: root.kind == "horizontal"
            ? (root.index == 0 ? Icons.segment-align-left : root.index == 1 ? Icons.segment-align-center : Icons.segment-align-right)
            : (root.index == 0 ? Icons.segment-align-top : root.index == 1 ? Icons.segment-align-middle : Icons.segment-align-bottom);
        colorize: root.selected ? root.style.foreground : root.style.muted;
    }
}
