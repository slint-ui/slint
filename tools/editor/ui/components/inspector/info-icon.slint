import { Style, Metrics, InfoIconStyle } from "../../style.slint";

export component InspectorInfoIcon inherits Rectangle {
    in property <InfoIconStyle> style: Style.info-icon;
    in property <string> label: "More information";
    callback activated;

    width: root.style.size;
    height: root.style.size;
    border-radius: root.style.size / 2;
    border-width: icon-focus.has-focus ? Metrics.focus-width : Metrics.border-width;
    border-color: touch.has-hover || icon-focus.has-focus ? root.style.accent : root.style.border;
    background: touch.has-hover || icon-focus.has-focus ? root.style.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.activated();
    }

    icon-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    Text {
        x: 0px;
        y: -0.5px;
        width: parent.width;
        height: parent.height;
        text: "i";
        color: touch.has-hover || icon-focus.has-focus ? root.style.accent : root.style.foreground;
        font-size: root.style.text.size;
        font-weight: root.style.text.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;

        clicked => {
            icon-focus.focus();
            root.activated();
        }
    }
}
