import { ButtonTemplate } from "../../../controls/src/templates.slint";
import { Style, Metrics, InfoIconStyle } from "../../style.slint";

export component InspectorInfoIcon inherits ButtonTemplate {
    in property <InfoIconStyle> style: Style.info-icon;
    in property <string> label: "More information";
    callback activated;

    width: root.style.size;
    height: root.style.size;
    text: root.label;
    clicked => { root.activated(); }
    background {
        Rectangle {
            border-radius: root.style.size / 2;
            border-width: root.has-focus ? Metrics.focus-width : Metrics.border-width;
            border-color: root.hovered || root.has-focus ? root.style.accent : root.style.border;
            background: root.hovered || root.has-focus ? root.style.hover : transparent;
        }
    }

    content {
        Rectangle {
            Text {
                x: 0px;
                y: -0.5px;
                width: parent.width;
                height: parent.height;
                text: "i";
                color: root.hovered || root.has-focus ? root.style.accent : root.style.foreground;
                font-size: root.style.text.size;
                font-weight: root.style.text.weight;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
