import { Style, Metrics, Typography, FieldStyle } from "../../style.slint";
import { EditorCursors } from "../index.slint";

import { InspectorTextFieldBase } from "text-field-base.slint";

export component InspectorValueField inherits FocusScope {
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> accessible-name: "";
    in property <string> prefix;
    in property <int> corner-index: -1;
    in property <string> value;
    in property <string> commit-key: "";
    in property <bool> scrubbable: false;
    in property <float> scrub-value;
    in property <bool> scrub-has-minimum: false;
    in property <float> scrub-minimum;
    callback accepted(string) -> bool;
    callback scrub-preview(float) -> bool;
    callback scrub-accepted(float) -> bool;
    callback scrub-canceled(float);
    private property <bool> scrubbing;
    private property <length> scrub-start-x;
    private property <float> scrub-initial-value;
    private property <float> scrub-drag-value;

    width: Style.inspector-layout.column-width;
    height: root.style.height;

    changed commit-key => { root.cancel-scrub(); }

    function cancel-scrub() {
        if root.scrubbing {
            root.scrubbing = false;
            root.scrub-canceled(root.scrub-initial-value);
        }
    }

    function update-scrub(mouse-x: length) {
        let delta = (mouse-x - root.scrub-start-x) / 1px;
        let stepped-value = (root.scrub-initial-value + delta).round();
        let value = root.scrub-has-minimum ? max(root.scrub-minimum, stepped-value) : stepped-value;
        root.scrub-drag-value = value;
        if !root.scrub-preview(value) {
            root.cancel-scrub();
        }
    }

    key-pressed(event) => {
        if event.text == Key.Escape && root.scrubbing {
            root.cancel-scrub();
            return accept;
        }
        return reject;
    }

    field := InspectorTextFieldBase {
        style: root.style;
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.scrubbing ? "\{root.scrub-drag-value}" : root.value;
        enabled: root.enabled;
        commit-key: root.commit-key;
        accepted(text) => {
            return root.accepted(text);
        }

        if root.corner-index >= 0: Path {
            width: Metrics.icon-small;
            height: Metrics.icon-small;
            // Top-left, top-right, bottom-left, and bottom-right corner outlines.
            commands: root.corner-index == 0 ? "M 2 11 L 2 6 Q 2 2 6 2 L 11 2"
                : root.corner-index == 1 ? "M 1 2 L 6 2 Q 10 2 10 6 L 10 11"
                : root.corner-index == 2 ? "M 2 1 L 2 6 Q 2 10 6 10 L 11 10"
                : "M 1 10 L 6 10 Q 10 10 10 6 L 10 1";
            stroke: root.style.appearance.muted;
            stroke-width: Metrics.border-width;
        }
        if root.corner-index < 0 && root.prefix != "": prefix-container := Rectangle {
            width: prefix-text.preferred-width;
            height: field.height;
            prefix-text := Text {
                width: self.preferred-width;
                height: parent.height;
                text: root.prefix;
                color: root.style.appearance.muted;
                font-size: Typography.caption.size - 1px;
                vertical-alignment: center;
            }
            if root.scrubbable: prefix-touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.custom(EditorCursors.scrub-horizontal-image(), 16, 16);
                accessible-role: AccessibleRole.slider;
                accessible-label: root.accessible-name + " scrubber";
                accessible-value: "\{root.scrub-value}";
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.focus();
                        root.scrubbing = true;
                        root.scrub-start-x = self.mouse-x;
                        root.scrub-initial-value = root.scrub-value;
                        root.scrub-drag-value = root.scrub-value;
                    } else if event.kind == PointerEventKind.move && root.scrubbing {
                        root.update-scrub(self.mouse-x);
                    } else if event.kind == PointerEventKind.up && root.scrubbing {
                        let value = root.scrub-drag-value;
                        root.scrubbing = false;
                        if value != root.scrub-initial-value {
                            if !root.scrub-accepted(value) {
                                root.scrub-canceled(root.scrub-initial-value);
                            }
                        } else {
                            root.scrub-canceled(root.scrub-initial-value);
                        }
                    } else if event.kind == PointerEventKind.cancel {
                        root.cancel-scrub();
                    }
                }
            }
        }
    }
}
