import { Style } from "../../style.slint";

import { InspectorCodeField } from "code-field.slint";

export component InspectorEditableField inherits InspectorCodeField {
    in property <bool> wide: false;

    style: Style.editable-field;
    width: wide ? Style.inspector-layout.content-width : Style.inspector-layout.column-width;
}
