import { Style } from "../../style.slint";

import { InspectorTextFieldBase } from "text-field-base.slint";

export component InspectorEditableField inherits Rectangle {
    in property <string> accessible-name: "";
    in property <string> prefix: "";
    in property <string> value;
    in property <bool> wide: false;
    in property <string> commit-key: "";
    callback accepted(string) -> bool;

    width: wide ? Style.inspector.wide-width : Style.inspector.column-width;
    height: Style.inspector.field-height;

    InspectorTextFieldBase {
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.value;
        commit-key: root.commit-key;
        field-padding-right: Style.spacing.regular;
        content-spacing: Style.spacing.small;
        accepted(text) => {
            return root.accepted(text);
        }

        if root.prefix != "": Text {
            text: root.prefix;
            color: Style.inspector.text;
            font-size: Style.typography.caption.size;
            vertical-alignment: center;
        }
    }
}
