import { Style, Metrics, Typography, FieldStyle } from "../../style.slint";

import { InspectorTextFieldBase } from "text-field-base.slint";

export component InspectorEditableField inherits Rectangle {
    in property <FieldStyle> style: Style.inspector-field;
    in property <string> accessible-name: "";
    in property <string> prefix: "";
    in property <string> value;
    in property <bool> wide: false;
    in property <string> commit-key: "";
    callback accepted(string) -> bool;

    width: wide ? Style.inspector-layout.content-width : Style.inspector-layout.column-width;
    height: root.style.height;

    InspectorTextFieldBase {
        style: root.style;
        accessible-name: root.accessible-name;
        width: parent.width;
        value: root.value;
        commit-key: root.commit-key;
        field-padding-right: Metrics.space-regular;
        content-spacing: Metrics.space-small;
        accepted(text) => {
            return root.accepted(text);
        }

        if root.prefix != "": Text {
            text: root.prefix;
            color: root.style.normal.foreground;
            font-size: Typography.caption.size;
            vertical-alignment: center;
        }
    }
}
