import { Style } from "../../style.slint";


export component InspectorReadOnlyField inherits Rectangle {
    in property <string> prefix;
    in property <string> value;
    in property <bool> wide: false;

    width: wide ? Style.inspector.wide-width : Style.inspector.column-width;
    height: Style.inspector.field-height;
    border-radius: Style.inspector.field-radius;
    background: Style.inspector.field-bg.with-alpha(0.65);

    HorizontalLayout {
        padding-left: Style.spacing.regular;
        padding-right: Style.spacing.regular;
        spacing: Style.spacing.compact;
        cross-axis-alignment: center;

        Text {
            text: root.prefix;
            color: Style.inspector.muted;
            font-size: Style.typography.caption.size;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Style.inspector.text;
            font-size: Style.typography.control.size;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
