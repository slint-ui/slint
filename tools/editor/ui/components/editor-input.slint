import { InputSurface } from "input-surface.slint";
import { ButtonBase } from "../../controls/src/headless.slint";
import { Metrics } from "../style.slint";

export component EditorInput inherits InputSurface {
    in property <string> accessible-name: "";
    in property <string> value;
    in property <bool> live-edit: false;
    in property <bool> preview-edit: false;
    in property <bool> select-all-on-focus: true;
    in property <bool> muted-value: false;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <string> suffix: "";
    in property <length> suffix-width: 0px;
    in property <bool> normalize-accepted: false;
    in property <bool> show-focus-border: true;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> clearable: false;
    in property <bool> multiline: false;
    in property <length> padding-block: Metrics.space-regular;
    in property <string> clear-label: @tr("Clear text");
    in property <MouseCursor> unfocused-cursor: MouseCursor.text;
    callback keyboard(KeyEvent) -> EventResult;
    callback focus-lost();
    callback text-edited(string);
    keyboard(event) => { return reject; }
    public function focus-input() { input.focus(); }
    public function select-range(start: int, end: int) { input.set-selection-offsets(start, end); }
    public function commit-value(value: string) -> bool { return root.accept-input(value, true); }
    public function take-draft() -> string {
        let draft = input.text;
        input.text = root.value;
        root.scroll-offset = 0px;
        root.edited = false;
        return draft;
    }
    focused: input.has-focus;
    hovered: touch.has-hover;
    framed: root.show-focus-border;
    out property <color> paint-foreground: root.paint.foreground;
    out property <bool> input-focused: input.has-focus;
    out property <string> input-value: input.text;
    in property <string> commit-key: "";
    private property <string> active-commit-key: root.commit-key;
    private property <bool> edited: false;
    private property <length> scroll-offset;
    out property <bool> has-uncommitted-edits: root.edited;
    callback edit-started();
    callback accepted(string) -> bool;
    callback preview(string);
    callback normalized(string) -> string;

    accessible-role: AccessibleRole.text-input;
    accessible-label: root.accessible-name;
    accessible-value: input.text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(value) => {
        if root.enabled {
            root.accept-input(value, true);
        }
    }
    accessible-action-default => {
        if root.enabled {
            input.focus();
        }
    }

    changed value => {
        if !input.has-focus || !root.edited {
            input.text = root.value;
        }
    }

    changed commit-key => {
        root.edited = false;
        input.text = root.value;
        root.scroll-offset = 0px;
        root.active-commit-key = root.commit-key;
    }

    function begin-edit() {
        if !root.edited {
            root.edit-started();
            root.edited = true;
        }
    }

    function accept-input(text: string, normalize: bool) -> bool {
        if root.active-commit-key != root.commit-key {
            input.text = root.value;
            root.active-commit-key = root.commit-key;
            return false;
        }
        root.begin-edit();
        let accepted = root.accepted(text);
        if accepted && normalize {
            input.text = root.normalize-accepted ? root.normalized(text) : text;
            root.edited = false;
        }
        return accepted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.unfocused-cursor;
        clicked => { input.focus(); }

        HorizontalLayout {
            x: 0px; y: 0px;
            width: 100%; height: 100%;
            padding-left: root.style.padding-inline;
            padding-right: root.style.padding-end + (root.suffix-width > 0px
                ? root.suffix-width + root.style.gap
                : 0px);
            spacing: root.style.gap;
            cross-axis-alignment: center;

            @children

            viewport := Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                height: parent.height - (root.multiline ? 2 * root.padding-block : 0px);
                clip: true;

                input := TextInput {
                    x: 0px; y: -root.scroll-offset;
                    width: parent.width;
                    height: root.multiline ? max(parent.height, self.preferred-height) : parent.height;
                    // Disable TextInput's built-in accessibility support as the frame takes care of that.
                    accessible-role: none;
                    text: root.value;
                    enabled: root.enabled;
                    horizontal-alignment: root.horizontal-alignment;
                    color: root.muted-value ? root.style.appearance.muted : root.paint.foreground;
                    font-size: root.style.text.size;
                    font-weight: root.style.text.weight;
                    vertical-alignment: root.multiline ? top : center;
                    single-line: !root.multiline;
                    wrap: root.multiline ? word-wrap : no-wrap;
                    selection-background-color: root.style.appearance.selection;
                    selection-foreground-color: root.style.appearance.selection-foreground;
                    text-cursor-width: 1phx;
                    input-type: root.input-type;
                    key-pressed(event) => { return root.keyboard(event); }
                    cursor-position-changed(position) => {
                        if root.multiline {
                            let line-height = self.font-metrics.ascent - self.font-metrics.descent;
                            let maximum = max(0px, self.height - viewport.height);
                            if position.y < root.scroll-offset {
                                root.scroll-offset = clamp(position.y, 0px, maximum);
                            } else if position.y + line-height > root.scroll-offset + viewport.height {
                                root.scroll-offset = clamp(position.y + line-height - viewport.height, 0px, maximum);
                            }
                        }
                    }

                    if input.text == "": placeholder-text := Text {
                        x: 0px; y: 0px;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: root.horizontal-alignment;
                        text: root.placeholder;
                        color: root.style.appearance.muted;
                        font-size: root.style.text.size;
                        vertical-alignment: root.multiline ? top : center;
                        font-weight: root.style.text.weight;
                    }

                    edited => {
                        root.begin-edit();
                        root.text-edited(self.text);
                        if root.preview-edit { root.preview(self.text); }
                        if root.live-edit { root.accept-input(self.text, false); }
                    }

                    accepted => {
                        if !root.accept-input(self.text, true) {
                            self.text = root.value;
                        }
                    }

                    TouchArea {
                        enabled: root.enabled && !input.has-focus;
                        mouse-cursor: root.unfocused-cursor;
                        clicked => { input.focus(); }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.middle {
                                input.focus();
                            }
                        }
                    }

                    changed has-focus => {
                        if self.has-focus {
                            root.active-commit-key = root.commit-key;
                            if root.select-all-on-focus { self.select-all(); }
                        }
                        if !self.has-focus && root.edited && (self.text != root.value || root.preview-edit) {
                            if !root.accept-input(self.text, true) {
                                self.text = root.value;
                            }
                        }
                        if !self.has-focus { root.edited = false; root.focus-lost(); }
                    }
                }
            }

            if root.clearable && input.text != "": clear := ButtonBase {
                width: Metrics.icon-large;
                height: Metrics.icon-large;
                accessible-label: root.clear-label;
                background << Rectangle {
                    border-radius: root.style.radius;
                    background: clear.hovered || clear.has-focus ? root.style.appearance.hover.background : transparent;
                }
                content << Image {
                    width: Metrics.icon-medium;
                    height: self.width;
                    source: @image-url("../assets/lucide/x.svg");
                    colorize: root.paint.foreground;
                }
                clicked => {
                    if root.accept-input("", true) {
                        input.text = "";
                    } else {
                        input.text = root.value;
                    }
                    input.focus();
                }
                Tooltip { text: @markdown("\{root.clear-label}"); }
            }

            if root.suffix != "" && root.suffix-width == 0px: Text {
                text: root.suffix;
                color: root.style.appearance.muted;
                font-size: root.style.text.size;
                vertical-alignment: center;
            }

        }

        if root.suffix != "" && root.suffix-width > 0px: fixed-suffix := Text {
            x: parent.width - root.style.padding-end - root.suffix-width;
            y: 0px;
            width: root.suffix-width;
            height: parent.height;
            text: root.suffix;
            color: root.style.appearance.muted;
            font-size: root.style.text.size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
