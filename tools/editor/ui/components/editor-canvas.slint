import { EditorGrid } from "editor-grid.slint";
import { Style, Metrics, ArtboardStyle, CanvasSurfaceStyle } from "../style.slint";
import { Api, DropMark } from "../api.slint";
import { AppState, EditorCursors, ElementKind, PreviewMetrics } from "common.slint";
import { CanvasInteractionLayer } from "canvas-interaction-layer.slint";

component PhoneChrome inherits Rectangle {
    in property <ArtboardStyle> style: Style.artboard;
    background: root.style.background;
    clip: true;

    Rectangle {
        x: root.style.padding;
        y: root.style.padding;
        width: parent.width - (2 * root.style.padding);
        height: parent.height - (2 * root.style.padding);
        accessible-role: AccessibleRole.region;
        accessible-label: "Artboard";

        @children
    }
}

export component EditorCanvas inherits Rectangle {
    in property <ArtboardStyle> artboard-style: Style.artboard;
    in property <CanvasSurfaceStyle> style: Style.canvas-surface;
    in property <bool> shift-pressed;
    private property <length> phone-canvas-top: max(
        root.artboard-style.top-minimum,
        (root.height - PreviewMetrics.phone-portrait-height) / 2,
    );

    accessible-role: AccessibleRole.main;
    accessible-label: "Editor canvas";

    callback real-element-selected();

    background: root.style.background;

    EditorGrid { style: root.style.grid; }

    TouchArea {
        mouse-cursor: EditorCursors.canvas-default;

        clicked => {
            Api.unselect();
        }
    }

    Rectangle {
        x: (parent.width - phone.width) / 2;
        y: root.phone-canvas-top + root.artboard-style.shadow.offset-y;
        width: phone.width;
        height: phone.height;
        border-radius: root.artboard-style.radius;
        drop-shadow-color: root.artboard-style.shadow.color;
        drop-shadow-blur: root.artboard-style.shadow.blur;
        drop-shadow-offset-y: root.artboard-style.shadow.offset-y;
    }

    phone := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.phone-canvas-top;
        width: PreviewMetrics.phone-portrait-width;
        height: PreviewMetrics.phone-portrait-height;
        border-radius: root.artboard-style.radius;
        border-width: Metrics.border-width;
        border-color: root.artboard-style.border;

        TouchArea {
            mouse-cursor: EditorCursors.canvas-default;
            clicked => {
                Api.unselect();
            }
        }

        PhoneChrome {
            style: root.artboard-style;
            ComponentContainer {
                width: 100%;
                height: 100%;
                component-factory: Api.preview-area;
            }

            DropArea {
                can-drop(event) => {
                    if AppState.palette-drag-cancelled {
                        return DragAction.none;
                    }
                    if AppState.palette-drag-kind != ElementKind.none {
                        AppState.update-palette-drag(
                            AppState.palette-drag-kind,
                            {
                                x: self.absolute-position.x + event.position.x,
                                y: self.absolute-position.y + event.position.y,
                            },
                        );
                        return DragAction.copy;
                    }
                    return Api.can-drop(event.data, event.position.x, event.position.y, true)
                        ? DragAction.copy : DragAction.none;
                }
                dropped(event) => {
                    if AppState.palette-drag-kind != ElementKind.none {
                        let size = AppState.palette-drag-size;
                        Api.drop-with-geometry(
                            event.data,
                            event.position,
                            {
                                x: event.position.x - size.width / 2,
                                y: event.position.y - size.height / 2,
                            },
                            size,
                        );
                    } else {
                        Api.drop(event.data, event.position.x, event.position.y);
                    }
                    return event.proposed-action;
                }
            }

            property <DropMark> drop-mark: Api.drop-mark;
            if drop-mark.x1 >= 0.0 || drop-mark.y1 >= 0.0 || drop-mark.x2 >= 0.0 || drop-mark.y2 >= 0.0: Rectangle {
                x: min(drop-mark.x1, drop-mark.x2);
                y: min(drop-mark.y1, drop-mark.y2);
                width: max((drop-mark.x2 - drop-mark.x1).abs(), 2px);
                height: max((drop-mark.y2 - drop-mark.y1).abs(), 2px);
                border-color: root.style.drop-indicator.foreground;
                background: root.style.drop-indicator.background;
                accessible-role: AccessibleRole.region;
                accessible-label: "Canvas drop marker";
            }
        }

        CanvasInteractionLayer {
            x: root.artboard-style.padding;
            y: root.artboard-style.padding;
            width: parent.width - 2 * root.artboard-style.padding;
            height: parent.height - 2 * root.artboard-style.padding;
            shift-pressed: root.shift-pressed;
            real-element-selected => {
                root.real-element-selected();
            }
        }
    }
}
