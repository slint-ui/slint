import { CanvasView } from "canvas-view.slint";
import { EditorGrid } from "editor-grid.slint";
import { Style, Metrics, ArtboardStyle, CanvasSurfaceStyle } from "../style.slint";
import { Api, DropMark } from "../api.slint";
import { AppState, EditorCursors, ElementKind, PreviewMetrics } from "common.slint";
import { CanvasInteractionLayer } from "canvas-interaction-layer.slint";

component PhoneChrome inherits Rectangle {
    in property <ArtboardStyle> style: Style.artboard;
    background: root.style.background;
    clip: true;

    Rectangle {
        x: root.style.padding;
        y: root.style.padding;
        width: parent.width - (2 * root.style.padding);
        height: parent.height - (2 * root.style.padding);
        accessible-role: AccessibleRole.region;
        accessible-label: "Artboard";

        @children
    }
}

export component EditorCanvas inherits TouchArea {
    in property <ArtboardStyle> artboard-style: Style.artboard;
    in property <CanvasSurfaceStyle> style: Style.canvas-surface;
    in property <bool> shift-pressed;
    private property <Size> viewport-size: { width: root.width, height: root.height };
    private property <Point> phone-origin: CanvasView.phone-origin(root.viewport-size);
    private property <Point> preview-origin: {
        x: root.phone-origin.x + root.artboard-style.padding * CanvasView.zoom,
        y: root.phone-origin.y + root.artboard-style.padding * CanvasView.zoom,
    };
    init => { CanvasView.viewport-size = root.viewport-size; }
    changed viewport-size => { CanvasView.viewport-size = root.viewport-size; }

    accessible-role: AccessibleRole.main;
    accessible-label: "Editor canvas";
    accessible-value: "\{(CanvasView.zoom * 100).round()}%";

    callback real-element-selected();

    scroll-event(event) => {
        return CanvasView.scroll({ x: event.delta-x, y: event.delta-y });
    }
    Rectangle { background: root.style.background; }

    EditorGrid { style: root.style.grid; }

    TouchArea {
        mouse-cursor: EditorCursors.canvas-default;

        clicked => {
            Api.unselect();
        }
    }

    Rectangle {
        x: root.phone-origin.x;
        y: root.phone-origin.y + root.artboard-style.shadow.offset-y * CanvasView.zoom;
        width: phone.width * CanvasView.zoom;
        height: phone.height * CanvasView.zoom;
        border-radius: root.artboard-style.radius * CanvasView.zoom;
        drop-shadow-color: root.artboard-style.shadow.color;
        drop-shadow-blur: root.artboard-style.shadow.blur * CanvasView.zoom;
        drop-shadow-offset-y: root.artboard-style.shadow.offset-y * CanvasView.zoom;
    }

    phone := Rectangle {
        transform-origin: { x: 0px, y: 0px };
        transform-scale: CanvasView.zoom;
        x: root.phone-origin.x;
        y: root.phone-origin.y;
        width: PreviewMetrics.phone-portrait-width;
        height: PreviewMetrics.phone-portrait-height;
        border-radius: root.artboard-style.radius;
        border-width: Metrics.border-width;
        border-color: root.artboard-style.border;

        TouchArea {
            mouse-cursor: EditorCursors.canvas-default;
            clicked => {
                Api.unselect();
            }
        }

        PhoneChrome {
            style: root.artboard-style;
            ComponentContainer {
                width: 100%;
                height: 100%;
                component-factory: Api.preview-area;
            }

        }
    }

    Rectangle {
        x: root.preview-origin.x;
        y: root.preview-origin.y;
        width: (PreviewMetrics.phone-portrait-width - 2 * root.artboard-style.padding) * CanvasView.zoom;
        height: (PreviewMetrics.phone-portrait-height - 2 * root.artboard-style.padding) * CanvasView.zoom;
        DropArea {
            can-drop(event) => {
                if AppState.palette-drag-cancelled {
                    return DragAction.none;
                }
                if AppState.palette-drag-kind != ElementKind.none {
                    AppState.update-palette-drag(
                        AppState.palette-drag-kind,
                        {
                            x: self.absolute-position.x + event.position.x,
                            y: self.absolute-position.y + event.position.y,
                        },
                    );
                    return DragAction.copy;
                }
                let preview = CanvasView.to-preview(event.position);
                return Api.can-drop(event.data, preview.x, preview.y, true)
                    ? DragAction.copy : DragAction.none;
            }
            dropped(event) => {
                let preview = CanvasView.to-preview(event.position);
                if AppState.palette-drag-kind != ElementKind.none {
                    let size = AppState.palette-drag-size;
                    Api.drop-with-geometry(
                        event.data,
                        preview,
                        {
                            x: preview.x - size.width / 2,
                            y: preview.y - size.height / 2,
                        },
                        size,
                    );
                } else {
                    Api.drop(event.data, preview.x, preview.y);
                }
                return event.proposed-action;
            }
        }

        property <DropMark> drop-mark: Api.drop-mark;
        if drop-mark.x1 >= 0.0 || drop-mark.y1 >= 0.0 || drop-mark.x2 >= 0.0 || drop-mark.y2 >= 0.0: Rectangle {
            x: min(drop-mark.x1, drop-mark.x2) * CanvasView.zoom;
            y: min(drop-mark.y1, drop-mark.y2) * CanvasView.zoom;
            width: max((drop-mark.x2 - drop-mark.x1).abs() * CanvasView.zoom, 2px);
            height: max((drop-mark.y2 - drop-mark.y1).abs() * CanvasView.zoom, 2px);
            border-color: root.style.drop-indicator.foreground;
            background: root.style.drop-indicator.background;
            accessible-role: AccessibleRole.region;
            accessible-label: "Canvas drop marker";
        }

        CanvasInteractionLayer {
            shift-pressed: root.shift-pressed;
            real-element-selected => { root.real-element-selected(); }
        }
    }
}
