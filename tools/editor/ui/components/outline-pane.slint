import { Style, Metrics, Colors, Typography, TreeDropStyle } from "../style.slint";
import { Api, DropLocation, EditorSurfaceMode, OutlineTreeNode } from "../api.slint";
import { EditorTreeView } from "editor-tree-view.slint";

import { AppState, SectionTitle } from "common.slint";

export component OutlinePane inherits Rectangle {
    in property <TreeDropStyle> style: Style.tree-drop;
    property <[OutlineTreeNode]> outline-data <=> Api.outline;
    property <bool> image-mode: Api.editor-surface-mode == EditorSurfaceMode.image;
    callback element-selected();
    callback drag-started();

    // background: Style.tree-row.hover-background;

    VerticalLayout {
        padding-right: Metrics.space-medium;
        padding-top: Metrics.space-medium;
        padding-bottom: Metrics.space-medium;
        spacing: Metrics.space-small;

        HorizontalLayout {
            alignment: start;
            cross-axis-alignment: center;
            padding-left: Metrics.space-large;

            SectionTitle {
                label: "OUTLINE";
            }
        }

        if root.image-mode || root.outline-data.length == 0: Rectangle {
            vertical-stretch: 1;

            Text {
                x: Metrics.space-large;
                width: parent.width - 2 * Metrics.space-large;
                text: root.image-mode ? "Nothing to Outline" : "No outline available";
                color: Colors.muted;
                font-size: Typography.control.size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.image-mode && root.outline-data.length > 0: Rectangle {
            vertical-stretch: 1;
            clip: true;

            tree-drag-tracker := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    if AppState.outline-drag-cancelled {
                        return DragAction.none;
                    }
                    AppState.update-outline-drag-position({
                        x: self.absolute-position.x + event.position.x,
                        y: self.absolute-position.y + event.position.y,
                    });
                    return DragAction.none;
                }
                dropped(event) => {
                    if AppState.outline-drag-cancelled {
                        AppState.finish-outline-drag();
                        return DragAction.none;
                    }
                    AppState.update-outline-drag-position({
                        x: self.absolute-position.x + event.position.x,
                        y: self.absolute-position.y + event.position.y,
                    });
                    AppState.finish-outline-drag();
                    return DragAction.none;
                }
            }

            tree-hover-touch := TouchArea {
                width: parent.width;
                height: parent.height;
            }

            VerticalLayout {
                root-drop-target := Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: root-drop-area.has-drag ? Metrics.control-small : root.style.root-drop-height;
                    border-radius: Style.tree-row.radius;
                    border-width: root-drop-area.has-drag && self.drop-allowed
                        ? root.style.drop-border-width
                        : 0px;
                    border-color: Style.tree-row.accent;
                    background: root-drop-area.has-drag && self.drop-allowed
                        ? root.style.drop-background
                        : transparent;
                    property <bool> drop-allowed: false;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: "Outline root drop target";

                    root-drop-area := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            if AppState.outline-drag-cancelled {
                                root-drop-target.drop-allowed = false;
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position({
                                x: self.absolute-position.x + event.position.x,
                                y: self.absolute-position.y + event.position.y,
                            });
                            root-drop-target.drop-allowed = Api.outline-can-drop(
                                event.data,
                                root.outline-data[0].uri,
                                root.outline-data[0].offset,
                                DropLocation.onto,
                            );
                            return root-drop-target.drop-allowed
                                ? DragAction.move
                                : DragAction.none;
                        }
                        dropped(event) => {
                            if AppState.outline-drag-cancelled {
                                root-drop-target.drop-allowed = false;
                                AppState.finish-outline-drag();
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position({
                                x: self.absolute-position.x + event.position.x,
                                y: self.absolute-position.y + event.position.y,
                            });
                            root-drop-target.drop-allowed = false;
                            Api.outline-drop(
                                event.data,
                                root.outline-data[0].uri,
                                root.outline-data[0].offset,
                                DropLocation.onto,
                            );
                            AppState.finish-outline-drag();
                            return DragAction.move;
                        }
                    }

                    Text {
                        visible: root-drop-area.has-drag && root-drop-target.drop-allowed;
                        x: Style.tree-row.padding-inline;
                        width: parent.width - 2 * self.x;
                        text: "Drop as child of root";
                        color: Style.tree-row.foreground;
                        font-size: Typography.control.size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                outline-tree := EditorTreeView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    accessible-name: "Current file outline";
                    rows: root.outline-data;
                    current-source-uri: Api.current-element.source-uri;
                    current-offset: Api.current-element.offset;
                    max-gutter-columns: 12;
                    content-has-hover: tree-hover-touch.has-hover;
                    make-row-drag-data(uri, offset) => {
                        return Api.move-element-instance-data(uri, offset);
                    }
                    row-can-drop(event, uri, offset, location) => {
                        return Api.outline-can-drop(event.data, uri, offset, location)
                            ? DragAction.move
                            : DragAction.none;
                    }
                    row-dropped(event, uri, offset, location) => {
                        Api.outline-drop(event.data, uri, offset, location);
                        return DragAction.move;
                    }
                    row-current-requested(uri, offset) => {
                        Api.outline-select-element(uri, offset, true);
                        root.element-selected();
                    }
                    row-expanded-changed(row-index, expanded) => {
                        Api.outline-set-expanded(row-index, expanded);
                    }
                    drag-started => {
                        root.drag-started();
                    }
                }
            }
        }
    }
}
