import { Style, Metrics, Colors, Typography, TreeStyle } from "../style.slint";
import { Api, Hover, DropLocation, EditorSurfaceMode, OutlineTreeNode } from "../api.slint";
import { DragPreview } from "drag-preview.slint";
import { EditorTreeView } from "editor-tree-view.slint";

import { AppState, ElementKind, SectionTitle } from "common.slint";

export component OutlinePane inherits Rectangle {
    in property <TreeStyle> style: Style.tree;
    property <[OutlineTreeNode]> outline-data <=> Api.outline;
    property <bool> image-mode: Api.editor-surface-mode == EditorSurfaceMode.image;
    private property <Point> palette-pointer: AppState.palette-drag-pointer-position();
    out property <bool> palette-drag-in-outline: !root.image-mode && root.outline-data.length > 0
        && AppState.palette-drag-kind != ElementKind.none
        && root.palette-pointer.x >= root.absolute-position.x
        && root.palette-pointer.x < root.absolute-position.x + root.width
        && root.palette-pointer.y >= root.absolute-position.y
        && root.palette-pointer.y < root.absolute-position.y + root.height;
    callback drag-started();

    // background: root.style.row.hover-background;

    VerticalLayout {
        padding-right: Metrics.space-medium;
        padding-top: Metrics.space-medium;
        padding-bottom: Metrics.space-medium;
        spacing: Metrics.space-small;

        HorizontalLayout {
            alignment: start;
            cross-axis-alignment: center;
            padding-left: Metrics.space-large;

            SectionTitle {
                label: "OUTLINE";
            }
        }

        if root.image-mode || root.outline-data.length == 0: Rectangle {
            vertical-stretch: 1;

            Text {
                x: Metrics.space-large;
                width: parent.width - 2 * Metrics.space-large;
                text: root.image-mode ? "Nothing to Outline" : "No outline available";
                color: Colors.muted;
                font-size: Typography.control.size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.image-mode && root.outline-data.length > 0: Rectangle {
            vertical-stretch: 1;
            clip: true;

            tree-drag-tracker := DropArea {
                width: parent.width;
                height: parent.height;
                can-drop(event) => {
                    if AppState.drag-cancelled() {
                        return DragAction.none;
                    }
                    AppState.update-outline-drag-position({
                        x: self.absolute-position.x + event.position.x,
                        y: self.absolute-position.y + event.position.y,
                    });
                    return DragAction.none;
                }
                dropped(event) => {
                    if AppState.drag-cancelled() {
                        AppState.finish-outline-drag();
                        return DragAction.none;
                    }
                    AppState.update-outline-drag-position({
                        x: self.absolute-position.x + event.position.x,
                        y: self.absolute-position.y + event.position.y,
                    });
                    AppState.finish-outline-drag();
                    return DragAction.none;
                }
            }

            tree-hover-touch := TouchArea {
                width: parent.width;
                height: parent.height;
            }

            VerticalLayout {
                root-drop-target := Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    height: root-drop-area.has-drag ? Metrics.control-small : root.style.root-drop-height;
                    border-radius: root.style.row.radius;
                    border-width: root-drop-area.has-drag && self.drop-allowed
                        ? root.style.drop-border-width
                        : 0px;
                    border-color: root.style.row.accent;
                    background: root-drop-area.has-drag && self.drop-allowed
                        ? root.style.drop-background
                        : transparent;
                    property <bool> drop-allowed: false;
                    accessible-role: AccessibleRole.list-item;
                    accessible-label: "Outline root drop target";

                    root-drop-area := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            if AppState.drag-cancelled() {
                                root-drop-target.drop-allowed = false;
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position({
                                x: self.absolute-position.x + event.position.x,
                                y: self.absolute-position.y + event.position.y,
                            });
                            root-drop-target.drop-allowed = Api.outline-can-drop(
                                event.data,
                                root.outline-data[0].uri,
                                root.outline-data[0].offset,
                                DropLocation.onto,
                            );
                            return root-drop-target.drop-allowed
                                ? event.proposed-action
                                : DragAction.none;
                        }
                        dropped(event) => {
                            if AppState.drag-cancelled() {
                                root-drop-target.drop-allowed = false;
                                AppState.finish-outline-drag();
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position({
                                x: self.absolute-position.x + event.position.x,
                                y: self.absolute-position.y + event.position.y,
                            });
                            root-drop-target.drop-allowed = false;
                            Api.outline-drop(
                                event.data,
                                root.outline-data[0].uri,
                                root.outline-data[0].offset,
                                DropLocation.onto,
                            );
                            AppState.finish-outline-drag();
                            return event.proposed-action;
                        }
                    }

                    Text {
                        visible: root-drop-area.has-drag && root-drop-target.drop-allowed;
                        x: root.style.row.padding-inline;
                        width: parent.width - 2 * self.x;
                        text: "Drop as child of root";
                        color: root.style.row.foreground;
                        font-size: Typography.control.size;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                outline-tree := EditorTreeView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    accessible-name: "Current file outline";
                    rows: root.outline-data;
                    current-source-uri: Api.current-element.source-uri;
                    current-offset: Api.current-element.offset;
                    max-gutter-columns: 12;
                    content-has-hover: tree-hover-touch.has-hover;
                    hovered-source-uri: Hover.element.valid ? Hover.element.source-uri : "";
                    hovered-offset: Hover.element.element-offset;
                    row-hovered(uri, offset, type-name) => {
                        Hover.tree-source-uri = uri;
                        Hover.tree-offset = offset;
                        Hover.tree-type-name = type-name;
                    }
                    make-row-drag-data(uri, offset) => {
                        return Api.move-element-instance-data(uri, offset);
                    }
                    row-can-drop(event, uri, offset, location) => {
                        return Api.outline-can-drop(event.data, uri, offset, location)
                            ? event.proposed-action
                            : DragAction.none;
                    }
                    row-dropped(event, uri, offset, location) => {
                        Api.outline-drop(event.data, uri, offset, location);
                        return event.proposed-action;
                    }
                    row-current-requested(uri, offset) => {
                        Api.outline-select-element(uri, offset, true);
                    }
                    row-expanded-changed(row-index, expanded) => {
                        Api.outline-set-expanded(row-index, expanded);
                    }
                    drag-started => {
                        Hover.tree-source-uri = "";
                        root.drag-started();
                    }
                }
            }
        }
    }

    Rectangle {
        width: root.width;
        height: root.height;
        clip: true;

        DragPreview {
            parent-origin: parent.absolute-position;
            palette-outline-preview: true;
            visible: root.palette-drag-in-outline;
            width: min(AppState.outline-drag-preview-size.width, parent.width - 2 * Metrics.space-medium);
            x: min(max(Metrics.space-medium, root.palette-pointer.x - root.absolute-position.x + Metrics.radius-medium), parent.width - self.width - Metrics.space-medium);
            y: min(max(0px, root.palette-pointer.y - root.absolute-position.y + Metrics.radius-medium), parent.height - self.height);
        }
    }
}
