import { Style } from "../style.slint";
import { AppState, ElementKind } from "common.slint";
import { ElementPresentation, ElementVisuals } from "element-presentation.slint";

component PalettePlaceholderDragPreview inherits Rectangle {
    in property <bool> show-thumbnail: true;
    in property <length> corner-radius;
    border-radius: root.corner-radius;
    background: Style.colors.object-subtle;
    border-width: Style.controls.border-width;
    border-color: Style.colors.object-border;

    if root.show-thumbnail: Rectangle {
        width: 48px;
        height: 36px;
        border-radius: Style.controls.row-radius;
        border-width: Style.controls.focus-width;
        border-color: Style.colors.object-muted.with-alpha(0.65);

        Rectangle {
            x: 30px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: Style.colors.object-muted.with-alpha(0.7);
        }

        Rectangle {
            x: 9px;
            y: 22px;
            width: 30px;
            height: 5px;
            border-radius: 2.5px;
            background: Style.colors.object-muted.with-alpha(0.55);
        }
    }
}

export component DragPreview inherits Rectangle {
    in property <Point> parent-origin;
    private property <ElementPresentation> presentation: ElementVisuals.for-kind(AppState.palette-drag-kind);
    private property <bool> palette-drag-active: AppState.palette-drag-kind != ElementKind.none;
    visible: AppState.outline-drag-active || root.palette-drag-active;
    width: AppState.outline-drag-active
        ? AppState.outline-drag-preview-size.width
        : AppState.palette-drag-size.width;
    height: AppState.outline-drag-active
        ? AppState.outline-drag-preview-size.height
        : AppState.palette-drag-size.height;
    x: (AppState.outline-drag-active
        ? AppState.outline-drag-position.x
        : AppState.palette-drag-preview-position.x) - root.parent-origin.x;
    y: (AppState.outline-drag-active
        ? AppState.outline-drag-position.y
        : AppState.palette-drag-preview-position.y) - root.parent-origin.y;
    border-radius: AppState.outline-drag-active
        ? Style.tree.row-radius
        : root.presentation.corner-radius;
    background: transparent;
    opacity: AppState.outline-drag-active ? Style.controls.drag-ghost-opacity : 1;
    drop-shadow-blur: Style.shadows.drag.blur;
    drop-shadow-offset-y: Style.shadows.drag.offset-y;
    drop-shadow-color: Style.shadows.drag.color;
    accessible-role: AccessibleRole.region;
    accessible-label: AppState.outline-drag-active ? "Outline drag preview" : root.presentation.drag-label;

    if AppState.outline-drag-active: Rectangle {
        border-radius: Style.tree.row-radius;
        background: Style.tree.row-bg-hover;
        border-width: Style.controls.border-width;
        border-color: Style.tree.guide;

        HorizontalLayout {
            padding-left: Style.tree.row-padding-inline;
            padding-right: Style.tree.row-padding-inline;
            spacing: Style.tree.content-gap;
            cross-axis-alignment: center;

            Image {
                width: Style.tree.icon-size;
                height: Style.tree.icon-size;
                source: AppState.outline-drag-icon;
                colorize: Style.tree.text;
                opacity: Style.controls.drag-content-opacity;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: AppState.outline-drag-label;
                color: Style.tree.text;
                font-size: Style.typography.body.size;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }
    }

    if !AppState.outline-drag-active && AppState.palette-drag-kind == ElementKind.rectangle: Rectangle {
        border-radius: root.presentation.corner-radius;
        background: Style.colors.object-bg;
        border-width: Style.controls.border-width;
        border-color: Style.colors.object-border;
    }

    if !AppState.outline-drag-active && AppState.palette-drag-kind == ElementKind.text: Text {
        text: "Text";
        color: Style.colors.phone-text;
        font-size: Style.typography.symbol.size;
        font-weight: FontWeight.extra-bold;
        vertical-alignment: center;
    }

    if !AppState.outline-drag-active && (AppState.palette-drag-kind == ElementKind.image || AppState.palette-drag-kind == ElementKind.touch-area): PalettePlaceholderDragPreview {
        corner-radius: root.border-radius;
        show-thumbnail: root.presentation.show-thumbnail;
    }
}
