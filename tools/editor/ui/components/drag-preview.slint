import { Style, Metrics, Typography, TreeRowStyle, DragPreviewStyle } from "../style.slint";
import { ElementKind } from "../api.slint";
import { AppState } from "index.slint";
import { ElementPresentation, ElementVisuals } from "element-presentation.slint";

component PalettePlaceholderDragPreview inherits Rectangle {
    in property <DragPreviewStyle> style: Style.drag-preview;
    in property <bool> show-thumbnail: true;
    in property <length> corner-radius;
    border-radius: root.corner-radius;
    background: root.style.subtle;
    border-width: Metrics.border-width;
    border-color: root.style.border;

    if root.show-thumbnail: Rectangle {
        width: 48px;
        height: 36px;
        border-radius: Metrics.radius-medium;
        border-width: Metrics.focus-width;
        border-color: root.style.muted.with-alpha(0.65);

        Rectangle {
            x: 30px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: root.style.muted.with-alpha(0.7);
        }

        Rectangle {
            x: 9px;
            y: 22px;
            width: 30px;
            height: 5px;
            border-radius: 2.5px;
            background: root.style.muted.with-alpha(0.55);
        }
    }
}

export component OutlineDragRow inherits Rectangle {
    in property <TreeRowStyle> style: Style.tree.row;
    in property <length> content-inset: AppState.outline-drag-content-inset;
    in property <brush> row-background: AppState.outline-drag-background;
    opacity: Style.drag-preview.ghost-opacity;

    Rectangle {
        x: root.style.hit-size;
        width: parent.width - self.x;
        height: root.style.height - 4px;
        border-radius: root.style.radius;
        background: root.row-background;
    }

    HorizontalLayout {
        padding-left: root.content-inset;
        padding-right: root.style.padding-inline * 2;
        spacing: root.style.gap;
        cross-axis-alignment: center;

        Image {
            width: root.style.icon-size;
            height: root.style.icon-size;
            source: AppState.outline-drag-icon;
            colorize: root.style.foreground;
            opacity: AppState.outline-drag-icon-opacity;
        }

        Text {
            horizontal-stretch: 1;
            text: AppState.outline-drag-label;
            color: root.style.foreground;
            font-size: root.style.font-size;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

export component DragPreview inherits Rectangle {
    in property <DragPreviewStyle> style: Style.drag-preview;
    in property <Point> parent-origin;
    in property <bool> palette-outline-preview: false;
    in property <bool> show-outline: true;
    in property <bool> show-palette: true;
    private property <bool> row-preview: AppState.outline-drag-active || root.palette-outline-preview;
    private property <ElementPresentation> presentation: ElementVisuals.for-kind(AppState.palette-drag-kind);
    private property <bool> palette-drag-active: AppState.palette-drag-kind != ElementKind.none;
    visible: (root.show-outline && AppState.outline-drag-active) || (root.show-palette && root.palette-drag-active);
    width: root.row-preview
        ? AppState.outline-drag-preview-size.width
        : AppState.palette-drag-size.width;
    height: root.row-preview
        ? AppState.outline-drag-preview-size.height
        : AppState.palette-drag-size.height;
    x: (root.row-preview
        ? AppState.outline-drag-position.x
        : AppState.palette-drag-preview-position.x) - root.parent-origin.x;
    y: (root.row-preview
        ? AppState.outline-drag-position.y
        : AppState.palette-drag-preview-position.y) - root.parent-origin.y;
    border-radius: root.row-preview
        ? root.style.row.radius
        : root.presentation.corner-radius;
    background: transparent;
    opacity: root.palette-outline-preview ? root.style.ghost-opacity : 1;
    drop-shadow-blur: root.style.shadow.blur;
    drop-shadow-offset-y: root.style.shadow.offset-y;
    drop-shadow-color: AppState.outline-drag-active ? transparent : root.style.shadow.color;
    accessible-role: AccessibleRole.region;
    accessible-label: root.row-preview ? "Outline drag preview" : root.presentation.label + " drag preview";

    if root.palette-outline-preview && !AppState.outline-drag-active: Rectangle {
        border-radius: root.style.row.radius;
        background: root.style.row.hover-background;
        border-width: Metrics.border-width;
        border-color: root.style.row-border;

        HorizontalLayout {
            padding-left: root.style.row.padding-inline;
            padding-right: root.style.row.padding-inline;
            spacing: root.style.row.gap;
            cross-axis-alignment: center;

            Image {
                width: root.style.row.icon-size;
                height: root.style.row.icon-size;
                source: root.presentation.icon;
                colorize: root.style.row.foreground;
                opacity: root.style.content-opacity;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: root.presentation.label;
                color: root.style.row.foreground;
                font-size: Typography.body.size;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }
    }
    if AppState.outline-drag-active: OutlineDragRow {}

    if !root.row-preview && AppState.palette-drag-kind == ElementKind.rectangle: Rectangle {
        border-radius: root.presentation.corner-radius;
        background: root.style.background;
        border-width: Metrics.border-width;
        border-color: root.style.border;
    }

    if !root.row-preview && AppState.palette-drag-kind == ElementKind.text: Text {
        text: "Text";
        color: root.style.foreground;
        font-size: root.style.text.size;
        font-weight: root.style.text.weight;
        vertical-alignment: center;
    }

    if !root.row-preview && (AppState.palette-drag-kind == ElementKind.image || AppState.palette-drag-kind == ElementKind.touch-area): PalettePlaceholderDragPreview {
            style: root.style;
        corner-radius: root.border-radius;
        show-thumbnail: root.presentation.show-thumbnail;
    }
}
