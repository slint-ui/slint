import { AppState, PaletteComponentKind, StudioTheme } from "common.slint";
import { EditorTreeTokens } from "editor-tree-tokens.slint";

component PaletteImageDragPreview inherits Rectangle {
    border-radius: 16px;
    background: StudioTheme.object-subtle;
    border-width: 1px;
    border-color: StudioTheme.object-border;

    Rectangle {
        width: 48px;
        height: 36px;
        border-radius: 6px;
        border-width: 2px;
        border-color: StudioTheme.object-muted.with-alpha(0.65);

        Rectangle {
            x: 30px;
            y: 8px;
            width: 7px;
            height: 7px;
            border-radius: 3.5px;
            background: StudioTheme.object-muted.with-alpha(0.7);
        }

        Rectangle {
            x: 9px;
            y: 22px;
            width: 30px;
            height: 5px;
            border-radius: 2.5px;
            background: StudioTheme.object-muted.with-alpha(0.55);
        }
    }
}

export component DragPreview inherits Rectangle {
    private property <bool> palette-drag-active: AppState.palette-drag-kind != PaletteComponentKind.none;
    visible: AppState.outline-drag-active || root.palette-drag-active;
    width: AppState.outline-drag-active
        ? AppState.outline-drag-preview-size.width
        : AppState.palette-drag-size.width;
    height: AppState.outline-drag-active
        ? AppState.outline-drag-preview-size.height
        : AppState.palette-drag-size.height;
    x: AppState.outline-drag-active
        ? AppState.outline-drag-position.x
        : AppState.palette-drag-preview-position.x;
    y: AppState.outline-drag-active
        ? AppState.outline-drag-position.y
        : AppState.palette-drag-preview-position.y;
    border-radius: AppState.outline-drag-active
        ? EditorTreeTokens.row-radius
        : AppState.palette-drag-kind == PaletteComponentKind.image ? 16px : 8px;
    background: transparent;
    opacity: AppState.outline-drag-active ? 0.5 : 1;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: StudioTheme.dark ? #00000055 : #33415535;
    accessible-role: AccessibleRole.region;
    accessible-label: AppState.palette-drag-kind == PaletteComponentKind.rectangle ? "Rectangle drag preview"
        : AppState.palette-drag-kind == PaletteComponentKind.text ? "Text drag preview"
        : AppState.palette-drag-kind == PaletteComponentKind.image ? "Image drag preview"
        : "Outline drag preview";

    if AppState.outline-drag-active: Rectangle {
        border-radius: EditorTreeTokens.row-radius;
        background: EditorTreeTokens.row-bg-hover;
        border-width: 1px;
        border-color: EditorTreeTokens.guide;

        HorizontalLayout {
            padding-left: EditorTreeTokens.row-padding-inline;
            padding-right: EditorTreeTokens.row-padding-inline;
            spacing: EditorTreeTokens.content-gap;
            cross-axis-alignment: center;

            Image {
                width: EditorTreeTokens.icon-size;
                height: EditorTreeTokens.icon-size;
                source: AppState.outline-drag-icon;
                colorize: EditorTreeTokens.text;
                opacity: 0.72;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 1;
                text: AppState.outline-drag-label;
                color: EditorTreeTokens.text;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }
        }
    }

    if !AppState.outline-drag-active && AppState.palette-drag-kind == PaletteComponentKind.rectangle: Rectangle {
        border-radius: 8px;
        background: StudioTheme.object-bg;
        border-width: 1px;
        border-color: StudioTheme.object-border;
    }

    if !AppState.outline-drag-active && AppState.palette-drag-kind == PaletteComponentKind.text: Text {
        text: "Text";
        color: StudioTheme.phone-text;
        font-size: 24px;
        font-weight: 800;
        vertical-alignment: center;
    }

    if !AppState.outline-drag-active && AppState.palette-drag-kind == PaletteComponentKind.image: PaletteImageDragPreview { }
}
