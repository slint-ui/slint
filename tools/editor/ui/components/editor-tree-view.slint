import { Style, Metrics, TreeStyle } from "../style.slint";
import { DropLocation, OutlineTreeNode } from "../api.slint";
import { AppState } from "index.slint";
import { ElementVisuals } from "element-presentation.slint";
import { OutlineDragRow } from "drag-preview.slint";
import { EditorTreeIcons } from "editor-tree-icons.slint";

import { ListView } from "std-widgets.slint";
import { EditorScrollIndicators } from "editor-scroll-view.slint";

component EditorTreeRow {
    in property <TreeStyle> style: Style.tree;
    in-out property <OutlineTreeNode> node;
    in property <string> current-source-uri;
    in property <int> current-offset;
    in property <int> max-gutter-columns;
    in property <bool> show-hierarchy-guides: false;
    in property <bool> tree-has-hover: false;
    in property <bool> content-has-hover;
    in property <Point> tree-pointer;
    in property <int> row-index: -1;
    in property <string> hovered-source-uri;
    in property <int> hovered-offset: -1;

    in property <bool> hide-drag-source;
    in property <bool> gap-before;
    in property <bool> gap-after;
    in property <OutlineTreeNode> gap-target;
    in property <int> gap-target-index;
    in property <DropLocation> gap-location;
    callback drop-target-changed(int, DropLocation, bool);

    pure callback make-drag-data(string, int) -> data-transfer;
    callback can-drop(DropEvent, string, int, DropLocation) -> DragAction;
    callback dropped(DropEvent, string, int, DropLocation) -> DragAction;
    callback current-requested(string, int);
    callback drag-started();
    callback row-hover-changed(int, bool);
    callback expanded-changed(int, bool);

    property <bool> current: node.uri == current-source-uri && node.offset == current-offset;
    property <int> level-safe: max(1, node.indent-level + 1);
    property <int> gutter-segments: max(0, level-safe - 1);
    property <bool> row-has-hover: !AppState.has-active-drag() && root.content-has-hover
        && root.tree-pointer.x >= root.absolute-position.x
        && root.tree-pointer.x < root.absolute-position.x + root.width
        && root.tree-pointer.y >= root.absolute-position.y + root.content-y
        && root.tree-pointer.y < root.absolute-position.y + root.content-y + root.style.row.height - 4px;
    property <string> row-label: node.element-id != "" ? node.element-id : node.element-type;
    property <DropLocation> active-drop-location: DropLocation.onto;
    property <bool> drop-allowed: false;
    property <Point> grab-offset;
    property <bool> pointer-in-gap: false;
    property <length> gap-height: root.gap-before || root.gap-after ? root.style.row.height : 0px;
    property <length> content-y: root.gap-before ? root.gap-height : 0px;
    property <image> row-icon: ElementVisuals.for-kind(node.icon-kind).icon;

    height: root.style.row.height + root.gap-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.row-label;
    accessible-description: "Hierarchy level \{root.level-safe}";
    accessible-item-selectable: true;
    accessible-item-selected: root.current;
    accessible-expanded: root.node.has-children && root.node.is-expanded;
    accessible-action-default => {
        root.select();
    }
    accessible-action-expand => {
        root.toggle-expanded();
    }

    changed row-has-hover => {
        root.row-hover-changed(root.row-index, root.row-has-hover);
    }

    changed node => {
        if root.row-has-hover {
            root.row-hover-changed(root.row-index, true);
        }
    }

    function select() {
        root.current-requested(root.node.uri, root.node.offset);
    }

    function toggle-expanded() {
        if root.node.has-children {
            root.expanded-changed(root.row-index, !root.node.is-expanded);
        }
    }

    function drop-location-for-y(y: length) -> DropLocation {
        if root.gap-before && y < root.gap-height {
            return y > root.style.row.height * 2 / 3 ? DropLocation.after : root.gap-location;
        }
        if root.gap-after && y >= root.style.row.height - 4px {
            return root.gap-location;
        }
        let content-y = y - root.content-y;
        if content-y < root.style.row.height / 3 {
            return DropLocation.before;
        }
        if content-y > root.style.row.height * 2 / 3 {
            return DropLocation.after;
        }
        return DropLocation.onto;
    }

    function in-gap(y: length) -> bool {
        return (root.gap-before && y < root.gap-height)
            || (root.gap-after && y >= root.style.row.height - 4px);
    }

    function can-use-drop-location(location: DropLocation) -> bool {
        return root.node.indent-level > 0 || location == DropLocation.onto;
    }

    function pointer-window-position() -> Point {
        return {
            x: row-touch.absolute-position.x + row-touch.mouse-x,
            y: row-touch.absolute-position.y + row-touch.mouse-y,
        };
    }

    function drop-event-window-position(event: DropEvent) -> Point {
        return {
            x: row-drop.absolute-position.x + event.position.x,
            y: row-drop.absolute-position.y + event.position.y,
        };
    }

    VerticalLayout {
        alignment: start;
        horizontal-stretch: 1;

        Rectangle {
            height: root.height;
            vertical-stretch: 0;
            horizontal-stretch: 1;

            row-chrome := Rectangle {
                opacity: root.hide-drag-source && row-drag.dragging ? 0 : 1;
                horizontal-stretch: 1;
                height: root.style.row.height - 4px + root.gap-height;
                background: transparent;

                row-highlight := Rectangle {
                    x: root.style.row.hit-size;
                    width: parent.width - self.x;
                    y: root.content-y;
                    height: root.style.row.height - 4px;
                    border-radius: root.style.row.radius;
                    border-width: row-drop.has-drag
                        && root.drop-allowed
                        && root.active-drop-location == DropLocation.onto
                        && !root.pointer-in-gap
                        ? root.style.drop-border-width
                        : 0px;
                    border-color: root.style.row.accent;
                    background: root.current
                        ? root.style.row.selected-background
                        : row-drop.has-drag
                        && root.drop-allowed
                        && root.active-drop-location == DropLocation.onto
                        && !root.pointer-in-gap
                        ? root.style.drop-background
                        : root.row-has-hover
                            || (root.node.uri == root.hovered-source-uri && root.node.offset == root.hovered-offset)
                        ? root.style.row.hover-background
                        : transparent;
                }

                row-drag := DragArea {
                    width: parent.width;
                    height: parent.height;
                    data: root.make-drag-data(root.node.uri, root.node.offset);
                    allow-move: true;
                    opacity: self.dragging ? root.style.row.drag-opacity : 1;

                    changed dragging => {
                        if self.dragging {
                            AppState.outline-drag-icon-opacity = root.current ? 1 : root.style.row.icon-opacity;
                            root.drag-started();
                            AppState.outline-drag-grab-offset = root.grab-offset;
                            AppState.outline-drag-preview-size = { width: root.width, height: root.style.row.height };
                            AppState.outline-drag-content-inset = row-content.absolute-position.x - root.absolute-position.x;
                            AppState.start-outline-drag(
                                root.row-label,
                                root.row-icon,
                                root.pointer-window-position(),
                            );
                        } else {
                            AppState.finish-outline-drag();
                        }
                    }

                    row-drop := DropArea {
                        width: parent.width;
                        height: parent.height;
                        can-drop(event) => {
                            if AppState.drag-cancelled() || row-drag.dragging {
                                root.drop-allowed = false;
                                root.drop-target-changed(root.row-index, root.active-drop-location, false);
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position(root.drop-event-window-position(event));
                            let gap = root.in-gap(event.position.y);
                            root.pointer-in-gap = gap;
                            let target = gap ? root.gap-target : root.node;
                            let target-index = gap ? root.gap-target-index : root.row-index;
                            root.active-drop-location = root.drop-location-for-y(event.position.y);
                            if !root.can-use-drop-location(root.active-drop-location) {
                                root.drop-allowed = false;
                                root.drop-target-changed(root.row-index, root.active-drop-location, false);
                                return DragAction.none;
                            }
                            let action = root.can-drop(
                                event,
                                target.uri,
                                target.offset,
                                root.active-drop-location,
                            );
                            root.drop-allowed = action != DragAction.none;
                            root.drop-target-changed(target-index, root.active-drop-location, root.drop-allowed);
                            return action;
                        }
                        dropped(event) => {
                            if AppState.drag-cancelled() {
                                root.drop-allowed = false;
                                AppState.finish-outline-drag();
                                return DragAction.none;
                            }
                            AppState.update-outline-drag-position(root.drop-event-window-position(event));
                            let gap = root.in-gap(event.position.y);
                            root.pointer-in-gap = gap;
                            let target = gap ? root.gap-target : root.node;
                            root.active-drop-location = root.drop-location-for-y(event.position.y);
                            if !root.can-use-drop-location(root.active-drop-location) {
                                root.drop-allowed = false;
                                root.drop-target-changed(root.row-index, root.active-drop-location, false);
                                return DragAction.none;
                            }
                            root.drop-allowed = false;
                            AppState.finish-outline-drag();
                            return root.dropped(
                                event,
                                target.uri,
                                target.offset,
                                root.active-drop-location,
                            );
                        }
                    }

                    row-touch := TouchArea {
                        width: parent.width;
                        y: root.content-y;
                        height: root.style.row.height - 4px;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                AppState.outline-drag-background = row-highlight.background;
                                let position = root.pointer-window-position();
                                root.grab-offset = {
                                    x: position.x - root.absolute-position.x,
                                    y: position.y - root.absolute-position.y,
                                };
                            }
                        }
                        clicked => {
                            root.select();
                        }
                    }

                    HorizontalLayout {
                        x: 0px;
                        y: root.content-y;
                        width: parent.width;
                        height: root.style.row.height - 4px;
                        alignment: start;
                        cross-axis-alignment: center;
                        padding-left: root.style.row.padding-inline;
                        padding-right: root.style.row.padding-inline;
                        min-height: root.style.row.height;

                        if root.gutter-segments > 0: HorizontalLayout {
                            alignment: start;

                            for slot[index] in root.max-gutter-columns: Rectangle {
                                width: index < root.gutter-segments ? root.style.row.toggle-width : 0px;
                                height: root.style.row.height;

                                if root.show-hierarchy-guides && index < root.gutter-segments: Rectangle {
                                    x: (parent.width - root.style.guide-width) / 2
                                        + (index >= 1 ? root.style.row.gap : 0px);
                                    width: root.style.guide-width;
                                    height: root.style.row.height;
                                    background: root.style.guide;
                                }
                            }
                        }

                        Rectangle {
                            width: root.style.row.hit-size;
                            height: root.style.row.height;

                            disclosure-touch := TouchArea {
                                width: root.style.row.hit-size;
                                height: root.style.row.hit-size;
                                y: (parent.height - self.height) / 2;
                                mouse-cursor: root.node.has-children ? MouseCursor.pointer : MouseCursor.default;
                                clicked => {
                                    root.toggle-expanded();
                                }
                            }

                            Image {
                                visible: root.node.has-children;
                                opacity: root.tree-has-hover ? 1 : 0;
                                width: Metrics.icon-small;
                                height: Metrics.icon-small;
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                source: root.node.is-expanded ? EditorTreeIcons.chevron-down : EditorTreeIcons.chevron-right;
                                colorize: root.style.row.muted;
                            }
                        }

                        row-content := HorizontalLayout {
                            spacing: root.style.row.gap;
                            alignment: start;
                            cross-axis-alignment: center;
                            padding-right: root.style.row.padding-inline;
                            min-height: root.style.row.height;

                            Image {
                                width: root.style.row.icon-size;
                                height: root.style.row.icon-size;
                                vertical-alignment: center;
                                source: root.row-icon;
                                colorize: root.style.row.foreground;
                                opacity: root.current ? 1 : root.style.row.icon-opacity;
                            }

                            Text {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                text: root.row-label;
                                color: root.style.row.foreground;
                                font-size: root.style.row.font-size;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                        }
                    }

                    if root.gap-before || root.gap-after: OutlineDragRow {
                        style: root.style.row;
                        row-background: root.style.row.hover-background;
                        y: root.gap-before ? 0px : root.style.row.height - 4px;
                        width: parent.width;
                        height: root.gap-height;
                        content-inset: root.style.row.padding-inline
                            + (root.gap-target.indent-level + (root.gap-location == DropLocation.onto ? 1 : 0)) * root.style.row.toggle-width
                            + root.style.row.hit-size;
                        accessible-role: AccessibleRole.region;
                        accessible-label: "Outline insertion preview";
                    }
                }
            }
        }
    }
}

export component EditorTreeView inherits FocusScope {
    in property <TreeStyle> style: Style.tree;
    in property <[OutlineTreeNode]> rows: [];
    in property <string> current-source-uri: "";
    in property <int> current-offset: -1;
    in property <string> accessible-name: "";
    in property <int> max-gutter-columns: 12;
    in property <bool> show-hierarchy-guides: false;
    in property <bool> content-has-hover: false;
    in property <Point> pointer-position;
    in property <string> hovered-source-uri;
    in property <int> hovered-offset: -1;
    callback row-hovered(string, int, string);
    private property <int> drop-row: -1;
    private property <DropLocation> drop-location: DropLocation.onto;
    private property <Point> drag-pointer: AppState.outline-drag-pointer-position;
    private property <bool> show-gap: AppState.outline-drag-active
        && !AppState.outline-drag-cancelled && root.drop-row >= 0
        && root.drag-pointer.x >= tree.absolute-position.x
        && root.drag-pointer.x < tree.absolute-position.x + tree.width
        && root.drag-pointer.y >= tree.absolute-position.y
        && root.drag-pointer.y < tree.absolute-position.y + tree.height;
    private property <int> hovered-row-index: -1;
    private property <int> focused-row-index: 0;

    pure callback make-row-drag-data(string, int) -> data-transfer;
    callback row-can-drop(DropEvent, string, int, DropLocation) -> DragAction;
    callback row-dropped(DropEvent, string, int, DropLocation) -> DragAction;
    callback row-current-requested(string, int);
    callback drag-started();
    callback row-expanded-changed(int, bool);

    horizontal-stretch: 1;
    accessible-role: AccessibleRole.list;
    accessible-label: root.accessible-name;
    accessible-delegate-focus: root.focused-row-index;
    accessible-item-count: root.rows.length;

    changed show-gap => {
        if !root.show-gap {
            root.drop-row = -1;
        }
    }

    public function clear-drop-target() {
        root.drop-row = -1;
    }

    function focus-row(index: int) {
        root.focused-row-index = index;
        let height = tree.content-height / root.rows.length;
        let y = tree.content-y + index * height;
        if y < 0px {
            tree.content-y -= y;
        } else if y + height > tree.visible-height {
            tree.content-y -= y + height - tree.visible-height;
        }
    }

    key-pressed(event) => {
        if event.text == Key.Tab {
            let next = root.focused-row-index + (event.modifiers.shift ? -1 : 1);
            if next >= 0 && next < root.rows.length {
                root.focus-row(next);
                return accept;
            }
        }
        if (event.text == Key.Return || event.text == Key.Space)
            && root.focused-row-index >= 0 && root.focused-row-index < root.rows.length {
            let node = root.rows[root.focused-row-index];
            root.row-current-requested(node.uri, node.offset);
            return accept;
        }
        return reject;
    }

    tree := ListView {
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        for row[i] in root.rows: EditorTreeRow {
            style: root.style;
            width: tree.visible-width;
            node <=> row;
            row-index: i;
            hovered-source-uri: root.hovered-source-uri;
            hovered-offset: root.hovered-offset;
            hide-drag-source: root.show-gap;
            gap-before: root.show-gap && root.drop-location == DropLocation.before && i == root.drop-row;
            gap-after: root.show-gap
                && root.drop-location != DropLocation.before
                && i >= root.drop-row
                && (i == root.drop-row || row.indent-level > root.rows[root.drop-row].indent-level)
                && (i + 1 == root.rows.length || root.rows[i + 1].indent-level <= root.rows[root.drop-row].indent-level);
            gap-target: root.drop-row >= 0 ? root.rows[root.drop-row] : row;
            gap-target-index: root.drop-row;
            gap-location: root.drop-location;
            drop-target-changed(index, location, allowed) => {
                if allowed {
                    root.drop-row = index;
                    root.drop-location = location;
                } else {
                    root.drop-row = -1;
                }
            }
            current-source-uri: root.current-source-uri;
            current-offset: root.current-offset;
            max-gutter-columns: root.max-gutter-columns;
            show-hierarchy-guides: root.show-hierarchy-guides;
            tree-has-hover: root.content-has-hover;
            content-has-hover: root.content-has-hover;
            tree-pointer: root.pointer-position;
            make-drag-data(uri, offset) => {
                return root.make-row-drag-data(uri, offset);
            }
            can-drop(event, uri, offset, location) => {
                return root.row-can-drop(event, uri, offset, location);
            }
            dropped(event, uri, offset, location) => {
                return root.row-dropped(event, uri, offset, location);
            }
            current-requested(uri, offset) => {
                root.focus-row(i);
                root.row-current-requested(uri, offset);
                root.focus();
            }
            drag-started => {
                root.drag-started();
            }
            row-hover-changed(row-index, has-hover) => {
                if has-hover {
                    root.hovered-row-index = row-index;
                    root.row-hovered(row.uri, row.offset, row.element-type);
                } else if root.hovered-row-index == row-index {
                    root.hovered-row-index = -1;
                    root.row-hovered("", -1, "");
                }
            }
            expanded-changed(row-index, expanded) => {
                root.row-expanded-changed(row-index, expanded);
            }
        }
    }

    scroll-indicators := EditorScrollIndicators {
        content-width: tree.content-width;
        content-height: tree.content-height;
        visible-width: tree.visible-width;
        visible-height: tree.visible-height;
        content-x <=> tree.content-x;
        content-y <=> tree.content-y;
        scrolled => { tree.scrolled(); }
    }
}
