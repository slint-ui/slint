import { EditorInput } from "editor-input.slint";
import { ButtonBase } from "../../controls/src/headless.slint";
import { Springboard, ConnectionState, ManualEndpointState } from "@springboard";
import { Preview } from "../preview.slint";
import { ViewerStyle, Chevron, ViewerIcon } from "viewer-style.slint";
import { EditorScrollView } from "editor-scroll-view.slint";

component DeviceAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> hovered: button.hovered;
    callback activated();
    button := ButtonBase {
        mouse-cursor: MouseCursor.default;
        width: parent.width; height: parent.height;
        enabled: root.enabled; text: root.label;
        clicked => { root.activated(); }
        background << Rectangle {
            border-radius: (9px * ViewerStyle.scale);
            border-width: button.has-focus ? (1px * ViewerStyle.scale) : (0px * ViewerStyle.scale);
            border-color: ViewerStyle.accent;
        }
        content << Rectangle { @children }
    }
}

component SoftButton inherits DeviceAction {
    in property <bool> primary;
    Rectangle {
        border-radius: (10px * ViewerStyle.scale);
        border-width: (1px * ViewerStyle.scale);
        border-color: ViewerStyle.field-border;
        background: root.hovered ? ViewerStyle.field-hover : ViewerStyle.field;
        opacity: root.enabled ? 1 : 0.45;
    }
    Text { text: root.label; color: !root.enabled ? ViewerStyle.unavailable : root.primary ? ViewerStyle.accent : ViewerStyle.ink; font-size: 13px; font-weight: 500; }
}

component DeviceField inherits EditorInput {
    in-out property <string> text;
    in property <bool> numeric;
    value: root.text;
    accessible-name: root.placeholder;
    input-type: root.numeric ? InputType.number : InputType.text;
    live-edit: true;
    accepted(value) => { root.text = value; return true; }
}

export component DeviceManager inherits Rectangle {
    callback closed();
    private property <int> page;
    // Index into `Springboard.saved-endpoints`, or -1.
    private property <int> removing: -1;
    private property <length> confirm-x;
    private property <length> confirm-y;
    private property <string> host;
    private property <string> port: "9000";
    private property <string> code;
    private property <string> message;
    private property <bool> pairing-required: Springboard.connection.state == ConnectionState.PairingRequired
        || Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired;
    private property <bool> connected: Springboard.connection.state == ConnectionState.Connected;
    init => {
        root.page = root.pairing-required ? 3 : 0;
        Springboard.discover-devices();
    }
    changed pairing-required => { if root.pairing-required { root.page = 3; } }
    changed connected => {
        if root.connected && root.page == 3 {
            root.message = @tr("{} connected", Springboard.selected-endpoint.name);
            root.page = 0;
        }
    }
    changed host => { root.probe(); }
    changed port => { root.probe(); }
    changed page => { root.probe(); root.removing = -1; }
    // TODO: only probe once the host is a complete IP address or looks like a
    // host name, not on every keystroke.
    function probe() {
        if root.page == 2 && root.host != "" && root.port != "" {
            Springboard.probe-address(root.host, root.port.to-float());
        } else {
            Springboard.probe-address("", 0);
        }
    }
    function begin-pairing(index: int) {
        root.code = "";
        if !Preview.is-running { Preview.run(); }
        Springboard.pair-endpoint(index);
        root.page = 3;
    }
    TouchArea { }
    if root.page != 0: back := DeviceAction {
        x: (16px * ViewerStyle.scale); y: (20px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: @tr("Back");
        activated => { if root.page == 3 { Springboard.cancel-pairing(); } root.page = root.page == 3 ? 1 : 0; }
        Rectangle { border-radius: (8px * ViewerStyle.scale); background: back.hovered ? ViewerStyle.pill-hover : transparent; }
        Chevron { transform-rotation: 90deg; }
    }
    Text {
        x: root.page == 0 ? (24px * ViewerStyle.scale) : (58px * ViewerStyle.scale); y: (23px * ViewerStyle.scale);
        text: root.page == 0 ? @tr("Devices") : root.page == 1 ? @tr("Pair nearby device") : root.page == 2 ? @tr("Enter IP address") : @tr("Pair device");
        color: ViewerStyle.ink; font-size: (21px * ViewerStyle.scale); font-weight: 600;
    }
    close := DeviceAction {
        x: parent.width - (48px * ViewerStyle.scale); y: (20px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: @tr("Close device manager");
        activated => { root.closed(); }
        Rectangle { border-radius: (8px * ViewerStyle.scale); background: close.hovered ? ViewerStyle.pill-hover : transparent; }
        Image { width: (24px * ViewerStyle.scale); height: (24px * ViewerStyle.scale); source: @image-url("../assets/lucide/x.svg"); colorize: ViewerStyle.muted; }
    }

    if root.page == 0: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (62px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: root.message == "" ? @tr("Your saved viewers") : root.message; font-size: (14px * ViewerStyle.scale); color: ViewerStyle.muted; overflow: elide; }
        Rectangle {
            x: (16px * ViewerStyle.scale); y: (92px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (228px * ViewerStyle.scale);
            border-radius: (11px * ViewerStyle.scale); border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.title-border;
            background: ViewerStyle.device-row;
            clip: true;
            EditorScrollView {
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                x: (1px * ViewerStyle.scale); y: (1px * ViewerStyle.scale); width: parent.width - (2px * ViewerStyle.scale); height: parent.height - (2px * ViewerStyle.scale);
                content-width: self.width; content-height: saved-list.preferred-height;
                saved-list := VerticalLayout {
                    width: parent.width;
                    for device[index] in Springboard.saved-endpoints: Rectangle {
                        height: 75px * ViewerStyle.scale;
                        ViewerIcon { x: (16px * ViewerStyle.scale); y: (23px * ViewerStyle.scale); height: (28px * ViewerStyle.scale); remote: index > 0; ink: device.unavailable-reason == "" ? ViewerStyle.strong-icon : ViewerStyle.unavailable; }
                        Text { x: (58px * ViewerStyle.scale); y: (15px * ViewerStyle.scale); width: parent.width - (160px * ViewerStyle.scale); text: index == 0 ? Preview.local-name : device.name; color: (device.unavailable-reason == "") ? ViewerStyle.ink : ViewerStyle.unavailable; font-size: (16px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
                        Text {
                            x: (58px * ViewerStyle.scale); y: (41px * ViewerStyle.scale); width: parent.width - (85px * ViewerStyle.scale);
                            text: index == 0 ? @tr("This computer") : device.unavailable-reason != "" ? device.unavailable-reason : @tr("Available · {}", device.address);
                            color: ViewerStyle.muted; font-size: 11px; overflow: elide;
                            if device.unavailable-reason != "": Tooltip { text: @markdown("\{device.unavailable-reason}"); }
                        }
                        if index == 0: Text { x: parent.width - (73px * ViewerStyle.scale); y: (19px * ViewerStyle.scale); text: @tr("Built-in"); font-size: 11px; color: ViewerStyle.muted; }
                        if index > 0 && root.removing != index: trash := DeviceAction {
                            x: parent.width - (45px * ViewerStyle.scale); y: (14px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: @tr("Remove {}", device.name);
                            activated => {
                                root.confirm-x = trash.absolute-position.x - root.absolute-position.x - (46px * ViewerStyle.scale);
                                root.confirm-y = trash.absolute-position.y - root.absolute-position.y;
                                root.removing = index;
                            }
                            Rectangle { border-radius: (8px * ViewerStyle.scale); background: trash.hovered ? ViewerStyle.pill-hover : transparent; }
                            Image { width: (22px * ViewerStyle.scale); height: (22px * ViewerStyle.scale); source: @image-url("../assets/lucide/trash.svg"); colorize: ViewerStyle.muted; }
                        }
                        if index < Springboard.saved-endpoints.length - 1: Rectangle { x: (58px * ViewerStyle.scale); y: parent.height - (1px * ViewerStyle.scale); width: parent.width - (74px * ViewerStyle.scale); height: (1px * ViewerStyle.scale); background: ViewerStyle.title-border.with-alpha(0.5); }
                    }
                }
            }
        }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (344px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale);
            label: @tr("Pair nearby device"); primary: true;
            activated => { root.page = 1; Springboard.discover-devices(); }
        }
    }
    else if root.page == 1: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (64px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: @tr("Open Slint Preview on your phone or tablet.\nUse the same Wi-Fi network as this computer."); color: ViewerStyle.muted; font-size: (14px * ViewerStyle.scale); wrap: word-wrap; }
        Rectangle { x: (25px * ViewerStyle.scale); y: (117px * ViewerStyle.scale); width: (6px * ViewerStyle.scale); height: (6px * ViewerStyle.scale); border-radius: (3px * ViewerStyle.scale); background: ViewerStyle.connected; }
        Text { x: (40px * ViewerStyle.scale); y: (112px * ViewerStyle.scale); text: @tr("Looking for nearby viewers"); color: ViewerStyle.muted; font-size: 11px; }
        Rectangle {
            x: (16px * ViewerStyle.scale); y: (138px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (184px * ViewerStyle.scale);
            border-radius: (11px * ViewerStyle.scale); border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.field-border; background: ViewerStyle.field;
            clip: true;
            EditorScrollView {
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                x: (1px * ViewerStyle.scale); y: (1px * ViewerStyle.scale); width: parent.width - (2px * ViewerStyle.scale); height: parent.height - (2px * ViewerStyle.scale);
                content-width: self.width; content-height: nearby-list.preferred-height;
                nearby-list := VerticalLayout {
                    width: parent.width;
                    for device[index] in Springboard.discovered-endpoints: Rectangle {
                        height: (device.version-mismatch != "" ? 120px : 80px) * ViewerStyle.scale;
                        ViewerIcon { x: (16px * ViewerStyle.scale); y: 20px * ViewerStyle.scale; remote: true; }
                        Text { x: (58px * ViewerStyle.scale); y: (18px * ViewerStyle.scale); width: parent.width - (160px * ViewerStyle.scale); text: device.name; color: ViewerStyle.ink; font-size: (17px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
                        Text {
                            x: 58px * ViewerStyle.scale; y: 46px * ViewerStyle.scale; width: parent.width - 160px * ViewerStyle.scale;
                            text: device.version-mismatch != "" ? @tr("Incompatible viewer version") : device.unavailable-reason != "" ? device.unavailable-reason : device.saved ? @tr("Saved viewer") : device.address;
                            color: device.unavailable-reason != "" ? ViewerStyle.warning : ViewerStyle.muted;
                            font-size: device.version-mismatch != "" ? 12px : 11px;
                            font-weight: device.version-mismatch != "" ? 500 : 400;
                            overflow: elide;
                            if device.unavailable-reason != "": Tooltip { text: @markdown("\{device.unavailable-reason}"); }
                        }
                        if device.version-mismatch != "": Text {
                            x: 58px * ViewerStyle.scale; y: 68px * ViewerStyle.scale; width: parent.width - 74px * ViewerStyle.scale;
                            text: Springboard.version-description(device.version-mismatch); color: ViewerStyle.muted; font-size: 11px; overflow: elide;
                        }
                        if device.version-mismatch != "": Text {
                            x: 58px * ViewerStyle.scale; y: 89px * ViewerStyle.scale; width: parent.width - 74px * ViewerStyle.scale;
                            text: @tr("Update Slint Preview on this device."); color: ViewerStyle.muted; font-size: 11px;
                        }
                        SoftButton { x: parent.width - (86px * ViewerStyle.scale); y: (22px * ViewerStyle.scale); width: (70px * ViewerStyle.scale); height: (36px * ViewerStyle.scale); label: device.saved ? @tr("Saved") : @tr("Pair"); primary: true; enabled: !device.saved && device.unavailable-reason == ""; activated => { root.begin-pairing(index); } }
                        if index < Springboard.discovered-endpoints.length - 1: Rectangle { x: (58px * ViewerStyle.scale); y: parent.height - (1px * ViewerStyle.scale); width: parent.width - (74px * ViewerStyle.scale); height: (1px * ViewerStyle.scale); background: ViewerStyle.title-border.with-alpha(0.5); }
                    }
                }
            }
        }
        Text { x: (24px * ViewerStyle.scale); y: (336px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: @tr("Don't see your device?"); color: ViewerStyle.ink; font-size: (14px * ViewerStyle.scale); }
        manual-fallback := DeviceAction {
            x: (16px * ViewerStyle.scale); y: (360px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (30px * ViewerStyle.scale); label: @tr("Enter IP address...");
            activated => { root.page = 2; }
            Rectangle { border-radius: (9px * ViewerStyle.scale); background: manual-fallback.hovered ? ViewerStyle.pill-hover : transparent; }
            Text { x: (8px * ViewerStyle.scale); text: manual-fallback.label; color: ViewerStyle.action-text; font-size: (15px * ViewerStyle.scale); }
            Chevron { x: parent.width - (28px * ViewerStyle.scale); transform-rotation: -90deg; }
        }
    }
    else if root.page == 2: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (76px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: @tr("Enter the address shown in Slint Preview\non your device."); color: ViewerStyle.muted; font-size: (15px * ViewerStyle.scale); }
        Text { x: (24px * ViewerStyle.scale); y: (150px * ViewerStyle.scale); text: @tr("IP address"); color: ViewerStyle.muted; font-size: 11px; }
        Text { x: parent.width - (122px * ViewerStyle.scale); y: (150px * ViewerStyle.scale); text: @tr("Port"); color: ViewerStyle.muted; font-size: 11px; }
        DeviceField { x: (24px * ViewerStyle.scale); y: (175px * ViewerStyle.scale); width: parent.width - (162px * ViewerStyle.scale); text <=> root.host; placeholder: "192.168.1.42"; }
        DeviceField { x: parent.width - (122px * ViewerStyle.scale); y: (175px * ViewerStyle.scale); width: (98px * ViewerStyle.scale); text <=> root.port; placeholder: "9000"; numeric: true; }
        Text {
            x: 24px * ViewerStyle.scale; y: 242px * ViewerStyle.scale; width: parent.width - 48px * ViewerStyle.scale;
            text: Springboard.manual-endpoint.state == ManualEndpointState.Idle ? @tr("Enter an address and port")
                : Springboard.manual-endpoint.state == ManualEndpointState.Probing ? @tr("Looking for Slint Preview…")
                : Springboard.manual-endpoint.state == ManualEndpointState.Unreachable ? @tr("Couldn’t connect to this address")
                : Springboard.manual-endpoint.state == ManualEndpointState.Incompatible ? @tr("Incompatible Slint version") : @tr("Slint Preview found");
            color: Springboard.manual-endpoint.state == ManualEndpointState.Unreachable || Springboard.manual-endpoint.state == ManualEndpointState.Incompatible ? ViewerStyle.warning : ViewerStyle.ink;
            font-size: 12px; font-weight: 500;
        }
        Text {
            x: 24px * ViewerStyle.scale; y: 268px * ViewerStyle.scale; width: parent.width - 48px * ViewerStyle.scale; height: 54px * ViewerStyle.scale;
            text: Springboard.manual-endpoint.state == ManualEndpointState.Idle ? @tr("Use the address shown on your device.")
                : Springboard.manual-endpoint.state == ManualEndpointState.Probing ? @tr("Checking the viewer at this address.")
                : Springboard.manual-endpoint.state == ManualEndpointState.Unreachable ? @tr("Check the IP address and port, and make sure\nSlint Preview is open on your device.")
                : Springboard.manual-endpoint.state == ManualEndpointState.Incompatible ? Springboard.version-description(Springboard.manual-endpoint.version) + "\n" + @tr("Update Slint Preview on this device.") : @tr("Connect to pair with this device.");
            color: ViewerStyle.muted; font-size: 11px; wrap: word-wrap;
        }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (344px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale);
            label: Springboard.manual-endpoint.state == ManualEndpointState.Unreachable ? @tr("Search again") : Springboard.manual-endpoint.state == ManualEndpointState.Probing ? @tr("Searching…") : @tr("Connect"); primary: true;
            enabled: Springboard.manual-endpoint.state == ManualEndpointState.Reachable || Springboard.manual-endpoint.state == ManualEndpointState.Unreachable;
            activated => {
                if Springboard.manual-endpoint.state == ManualEndpointState.Reachable {
                    if !Preview.is-running { Preview.run(); }
                    Springboard.connect-manual-endpoint();
                    root.page = 3;
                } else { root.probe(); }
            }
        }
    }
    else if root.page == 3: Rectangle {
        Rectangle {
            x: (24px * ViewerStyle.scale); y: (80px * ViewerStyle.scale); width: (52px * ViewerStyle.scale); height: (52px * ViewerStyle.scale); border-radius: (13px * ViewerStyle.scale);
            background: ViewerStyle.pill-face; border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.title-border;
            ViewerIcon { width: (25px * ViewerStyle.scale); height: (29px * ViewerStyle.scale); remote: true; }
        }
        Text { x: (91px * ViewerStyle.scale); y: (85px * ViewerStyle.scale); width: parent.width - (115px * ViewerStyle.scale); text: Springboard.selected-endpoint.name; color: ViewerStyle.ink; font-size: (17px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
        Text { x: (91px * ViewerStyle.scale); y: (112px * ViewerStyle.scale); text: Springboard.selected-endpoint.address; color: ViewerStyle.muted; font-size: 11px; }
        Text { x: (24px * ViewerStyle.scale); y: (166px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired ? @tr("This viewer does not encrypt its connection.") : Springboard.connection.state == ConnectionState.Connecting ? @tr("Connecting to your viewer…") : @tr("Enter the code shown on your device."); color: ViewerStyle.muted; font-size: (15px * ViewerStyle.scale); }
        if Springboard.connection.state == ConnectionState.PairingRequired: DeviceField { x: (24px * ViewerStyle.scale); y: (204px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text <=> root.code; placeholder: @tr("{}-digit pairing code", Springboard.connection.pairing-code-length); numeric: true; }
        Text { x: (24px * ViewerStyle.scale); y: (274px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: Springboard.connection.error; wrap: word-wrap; color: ViewerStyle.error; font-size: 11px; }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (315px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale); label: Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired ? @tr("Connect unencrypted") : @tr("Pair device"); primary: true; enabled: Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired || (Springboard.connection.state == ConnectionState.PairingRequired && root.code.character-count == Springboard.connection.pairing-code-length);
            activated => {
                if Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired {
                    Springboard.accept-unpaired-connection();
                } else { Springboard.submit-pairing-code(root.code); root.code = ""; }
            }
        }
        Text { x: (24px * ViewerStyle.scale); y: (385px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: @tr("A restart may require a new pairing code."); color: ViewerStyle.muted; font-size: 11px; horizontal-alignment: center; }
    }
    if root.removing >= 0: Rectangle {
        TouchArea { clicked => { root.removing = -1; } }
        SoftButton {
            x: root.confirm-x; y: root.confirm-y; width: (78px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: @tr("Confirm");
            activated => { Springboard.forget-device(root.removing); root.removing = -1; }
        }
    }
}
