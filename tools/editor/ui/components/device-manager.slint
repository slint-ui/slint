import { ButtonBase } from "../../controls/src/headless.slint";
import { Springboard, ConnectionState } from "@springboard";
import { Preview } from "../preview.slint";
import { ViewerStyle, Chevron, ViewerIcon } from "viewer-style.slint";
import { EditorScrollView } from "editor-scroll-view.slint";

export global DeviceManagerSession {
    in-out property <bool> open;
}

component DeviceAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    out property <bool> hovered: button.hovered;
    callback activated();
    button := ButtonBase {
        mouse-cursor: MouseCursor.default;
        width: parent.width; height: parent.height;
        enabled: root.enabled; text: root.label;
        clicked => { root.activated(); }
        background << Rectangle {
            border-radius: (9px * ViewerStyle.scale);
            border-width: button.has-focus ? (1px * ViewerStyle.scale) : (0px * ViewerStyle.scale);
            border-color: ViewerStyle.accent;
        }
        content << Rectangle { @children }
    }
}

component SoftButton inherits DeviceAction {
    in property <bool> primary;
    Rectangle {
        border-radius: (10px * ViewerStyle.scale);
        border-width: (1px * ViewerStyle.scale);
        border-color: ViewerStyle.field-border;
        background: root.hovered ? ViewerStyle.field-hover : ViewerStyle.field;
        opacity: root.enabled ? 1 : 0.45;
    }
    Text { text: root.label; color: root.primary ? ViewerStyle.accent : ViewerStyle.ink; font-size: 13px; font-weight: 500; }
}

component DeviceField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> numeric;
    border-radius: (10px * ViewerStyle.scale);
    background: ViewerStyle.pill-face;
    border-width: (1px * ViewerStyle.scale);
    border-color: input.has-focus ? ViewerStyle.accent : ViewerStyle.field-border;
    if root.text == "": Text { x: (14px * ViewerStyle.scale); height: parent.height; vertical-alignment: center; text: root.placeholder; color: ViewerStyle.muted; font-size: (16px * ViewerStyle.scale); }
    input := TextInput {
        x: (14px * ViewerStyle.scale); width: parent.width - (28px * ViewerStyle.scale); height: parent.height;
        text <=> root.text;
        color: ViewerStyle.ink; font-size: (16px * ViewerStyle.scale);
        vertical-alignment: center;
        input-type: root.numeric ? InputType.number : InputType.text;
        accessible-label: root.placeholder;
    }
}

export component DeviceManager inherits Rectangle {
    callback closed();
    private property <bool> open: DeviceManagerSession.open;
    private property <int> page;
    private property <string> removing;
    private property <length> confirm-x;
    private property <length> confirm-y;
    private property <string> host;
    private property <string> port: "9000";
    private property <string> code;
    private property <string> message;
    private property <bool> pairing-required: Springboard.connection-state == ConnectionState.PairingRequired
        || Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired;
    private property <bool> connected: Springboard.connection-state == ConnectionState.Connected;
    changed open => {
        root.removing = "";
        if root.open {
            root.page = root.pairing-required ? 3 : 0;
            Springboard.discover-devices();
        } else { Springboard.cancel-pairing(); }
    }
    changed pairing-required => { if root.pairing-required { root.page = 3; } }
    changed connected => {
        if root.connected && root.page == 3 {
            root.message = Springboard.selected-endpoint.name + " connected";
            root.page = 0;
        }
    }
    changed host => { root.search(); }
    changed port => { root.search(); }
    changed page => { root.search(); root.removing = ""; }
    function search() {
        Springboard.search-address(root.page == 2 && root.host != "" ? root.host + ":" + root.port : "");
    }
    function begin-pairing(index: int) {
        root.code = "";
        Springboard.select-endpoint(index);
        root.page = 3;
    }
    Rectangle {
        border-radius: ViewerStyle.radius;
        background: ViewerStyle.popup;
        drop-shadow-color: ViewerStyle.popup-ambient-shadow;
        drop-shadow-blur: (20px * ViewerStyle.scale); drop-shadow-offset-y: (8px * ViewerStyle.scale);
    }
    Rectangle {
        border-radius: ViewerStyle.radius;
        border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.border;
        background: ViewerStyle.popup;
        drop-shadow-color: ViewerStyle.popup-key-shadow;
        drop-shadow-blur: (3px * ViewerStyle.scale); drop-shadow-offset-y: (1px * ViewerStyle.scale);
    }
    TouchArea { }
    if root.page != 0: back := DeviceAction {
        x: (16px * ViewerStyle.scale); y: (20px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: "Back";
        activated => { if root.page == 3 { Springboard.cancel-pairing(); } root.page = root.page == 3 ? 1 : 0; }
        Rectangle { border-radius: (8px * ViewerStyle.scale); background: back.hovered ? ViewerStyle.pill-hover : transparent; }
        Chevron { transform-rotation: 90deg; }
    }
    Text {
        x: root.page == 0 ? (24px * ViewerStyle.scale) : (58px * ViewerStyle.scale); y: (23px * ViewerStyle.scale);
        text: root.page == 0 ? "Devices" : root.page == 1 ? "Pair nearby device" : root.page == 2 ? "Enter IP address" : "Pair device";
        color: ViewerStyle.ink; font-size: (21px * ViewerStyle.scale); font-weight: 600;
    }
    close := DeviceAction {
        x: parent.width - (48px * ViewerStyle.scale); y: (20px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: "Close device manager";
        activated => { root.closed(); }
        Rectangle { border-radius: (8px * ViewerStyle.scale); background: close.hovered ? ViewerStyle.pill-hover : transparent; }
        Path { width: (12px * ViewerStyle.scale); height: (12px * ViewerStyle.scale); commands: "M 0 0 L 12 12 M 12 0 L 0 12"; stroke: ViewerStyle.muted; stroke-width: (1.5px * ViewerStyle.scale); }
    }

    if root.page == 0: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (62px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: root.message == "" ? "Your saved viewers" : root.message; font-size: (14px * ViewerStyle.scale); color: ViewerStyle.muted; overflow: elide; }
        Rectangle {
            x: (16px * ViewerStyle.scale); y: (92px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (228px * ViewerStyle.scale);
            border-radius: (11px * ViewerStyle.scale); border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.title-border;
            background: ViewerStyle.dark ? #ffffff03 : #ffffff65;
            clip: true;
            EditorScrollView {
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                x: (1px * ViewerStyle.scale); y: (1px * ViewerStyle.scale); width: parent.width - (2px * ViewerStyle.scale); height: parent.height - (2px * ViewerStyle.scale);
                content-width: self.width; content-height: saved-list.preferred-height;
                saved-list := VerticalLayout {
                    width: parent.width;
                    for device[index] in Springboard.endpoints: Rectangle {
                        height: device.saved ? (75px * ViewerStyle.scale) : (0px * ViewerStyle.scale);
                        visible: device.saved;
                        ViewerIcon { x: (16px * ViewerStyle.scale); y: (23px * ViewerStyle.scale); height: (28px * ViewerStyle.scale); remote: index > 0; ink: device.unavailable-reason == "" ? ViewerStyle.strong-icon : ViewerStyle.unavailable; }
                        Text { x: (58px * ViewerStyle.scale); y: (15px * ViewerStyle.scale); width: parent.width - (160px * ViewerStyle.scale); text: index == 0 ? Preview.local-name : device.name; color: (device.unavailable-reason == "") ? ViewerStyle.ink : ViewerStyle.unavailable; font-size: (16px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
                        Text {
                            x: (58px * ViewerStyle.scale); y: (41px * ViewerStyle.scale); width: parent.width - (85px * ViewerStyle.scale);
                            text: index == 0 ? "This computer" : device.unavailable-reason != "" ? "Unavailable" : "Available · " + device.address;
                            color: ViewerStyle.muted; font-size: 11px; overflow: elide;
                        }
                        if index == 0: Text { x: parent.width - (73px * ViewerStyle.scale); y: (19px * ViewerStyle.scale); text: "Built-in"; font-size: 11px; color: ViewerStyle.muted; }
                        if index > 0 && root.removing != device.id: trash := DeviceAction {
                            x: parent.width - (45px * ViewerStyle.scale); y: (14px * ViewerStyle.scale); width: (32px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: "Remove " + device.name;
                            activated => {
                                root.confirm-x = trash.absolute-position.x - root.absolute-position.x - (46px * ViewerStyle.scale);
                                root.confirm-y = trash.absolute-position.y - root.absolute-position.y;
                                root.removing = device.id;
                            }
                            Rectangle { border-radius: (8px * ViewerStyle.scale); background: trash.hovered ? ViewerStyle.pill-hover : transparent; }
                            Path { width: (15px * ViewerStyle.scale); height: (17px * ViewerStyle.scale); commands: "M 1 4 L 14 4 M 5 4 L 5 1 L 10 1 L 10 4 M 3 4 L 4 16 L 11 16 L 12 4 M 6 7 L 6 13 M 9 7 L 9 13"; stroke: ViewerStyle.muted; stroke-width: (1.3px * ViewerStyle.scale); }
                        }
                        if index < Springboard.endpoints.length - 1: Rectangle { x: (58px * ViewerStyle.scale); y: parent.height - (1px * ViewerStyle.scale); width: parent.width - (74px * ViewerStyle.scale); height: (1px * ViewerStyle.scale); background: ViewerStyle.title-border.with-alpha(0.5); }
                    }
                }
            }
        }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (344px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale);
            label: "Pair nearby device"; primary: true;
            activated => { root.page = 1; Springboard.discover-devices(); }
        }
    }

    if root.page == 1: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (64px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: "Open Slint Preview on your phone or tablet.\nUse the same Wi-Fi network as this computer."; color: ViewerStyle.muted; font-size: (14px * ViewerStyle.scale); wrap: word-wrap; }
        Rectangle { x: (25px * ViewerStyle.scale); y: (117px * ViewerStyle.scale); width: (6px * ViewerStyle.scale); height: (6px * ViewerStyle.scale); border-radius: (3px * ViewerStyle.scale); background: ViewerStyle.connected; }
        Text { x: (40px * ViewerStyle.scale); y: (112px * ViewerStyle.scale); text: "Looking for nearby viewers"; color: ViewerStyle.muted; font-size: 11px; }
        Rectangle {
            x: (16px * ViewerStyle.scale); y: (138px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (184px * ViewerStyle.scale);
            border-radius: (11px * ViewerStyle.scale); border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.field-border; background: ViewerStyle.field;
            clip: true;
            EditorScrollView {
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                x: (1px * ViewerStyle.scale); y: (1px * ViewerStyle.scale); width: parent.width - (2px * ViewerStyle.scale); height: parent.height - (2px * ViewerStyle.scale);
                content-width: self.width; content-height: nearby-list.preferred-height;
                nearby-list := VerticalLayout {
                    width: parent.width;
                    for device[index] in Springboard.endpoints: Rectangle {
                        height: device.nearby ? (80px * ViewerStyle.scale) : (0px * ViewerStyle.scale);
                        visible: device.nearby;
                        ViewerIcon { x: (16px * ViewerStyle.scale); remote: true; }
                        Text { x: (58px * ViewerStyle.scale); y: (18px * ViewerStyle.scale); width: parent.width - (160px * ViewerStyle.scale); text: device.name; color: ViewerStyle.ink; font-size: (17px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
                        Text { x: (58px * ViewerStyle.scale); y: (46px * ViewerStyle.scale); text: device.saved ? "Saved viewer" : device.address; color: ViewerStyle.muted; font-size: 11px; }
                        SoftButton { x: parent.width - (86px * ViewerStyle.scale); y: (22px * ViewerStyle.scale); width: (70px * ViewerStyle.scale); height: (36px * ViewerStyle.scale); label: device.saved ? "Saved" : "Pair"; primary: true; enabled: !device.saved && device.unavailable-reason == ""; activated => { root.begin-pairing(index); } }
                        if index < Springboard.endpoints.length - 1: Rectangle { x: (58px * ViewerStyle.scale); y: parent.height - (1px * ViewerStyle.scale); width: parent.width - (74px * ViewerStyle.scale); height: (1px * ViewerStyle.scale); background: ViewerStyle.title-border.with-alpha(0.5); }
                    }
                }
            }
        }
        Text { x: (24px * ViewerStyle.scale); y: (336px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: "Don't see your device?"; color: ViewerStyle.ink; font-size: (14px * ViewerStyle.scale); }
        manual-fallback := DeviceAction {
            x: (16px * ViewerStyle.scale); y: (360px * ViewerStyle.scale); width: parent.width - (32px * ViewerStyle.scale); height: (30px * ViewerStyle.scale); label: "Enter IP address...";
            activated => { root.page = 2; }
            Rectangle { border-radius: (9px * ViewerStyle.scale); background: manual-fallback.hovered ? ViewerStyle.pill-hover : transparent; }
            Text { x: (8px * ViewerStyle.scale); text: "Enter IP address..."; color: ViewerStyle.action-text; font-size: (15px * ViewerStyle.scale); }
            Chevron { x: parent.width - (28px * ViewerStyle.scale); transform-rotation: -90deg; }
        }
    }

    if root.page == 2: Rectangle {
        Text { x: (24px * ViewerStyle.scale); y: (76px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: "Enter the address shown in Slint Preview\non your device."; color: ViewerStyle.muted; font-size: (15px * ViewerStyle.scale); }
        Text { x: (24px * ViewerStyle.scale); y: (150px * ViewerStyle.scale); text: "IP address"; color: ViewerStyle.muted; font-size: 11px; }
        Text { x: parent.width - (122px * ViewerStyle.scale); y: (150px * ViewerStyle.scale); text: "Port"; color: ViewerStyle.muted; font-size: 11px; }
        DeviceField { x: (24px * ViewerStyle.scale); y: (175px * ViewerStyle.scale); width: parent.width - (162px * ViewerStyle.scale); height: (46px * ViewerStyle.scale); text <=> root.host; placeholder: "192.168.1.42"; }
        DeviceField { x: parent.width - (122px * ViewerStyle.scale); y: (175px * ViewerStyle.scale); width: (98px * ViewerStyle.scale); height: (46px * ViewerStyle.scale); text <=> root.port; placeholder: "9000"; numeric: true; }
        Text { x: (24px * ViewerStyle.scale); y: (238px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: Springboard.search-error != "" ? Springboard.search-error : Springboard.device-found ? "Slint Preview found · " + root.host : root.host == "" ? "Enter an address to search for a viewer." : "Looking for Slint Preview at this address…"; color: ViewerStyle.muted; font-size: 11px; overflow: elide; }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (297px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale); label: Springboard.device-found ? "Connect" : Springboard.search-error != "" ? "Search again" : "Searching…"; primary: true;
            enabled: Springboard.device-found || Springboard.search-error != "";
            activated => {
                if Springboard.device-found {
                    Springboard.connect-found-device();
                    root.page = 3;
                } else { root.search(); }
            }
        }
    }

    if root.page == 3: Rectangle {
        Rectangle {
            x: (24px * ViewerStyle.scale); y: (80px * ViewerStyle.scale); width: (52px * ViewerStyle.scale); height: (52px * ViewerStyle.scale); border-radius: (13px * ViewerStyle.scale);
            background: ViewerStyle.pill-face; border-width: (1px * ViewerStyle.scale); border-color: ViewerStyle.title-border;
            ViewerIcon { width: (25px * ViewerStyle.scale); height: (29px * ViewerStyle.scale); remote: true; }
        }
        Text { x: (91px * ViewerStyle.scale); y: (85px * ViewerStyle.scale); width: parent.width - (115px * ViewerStyle.scale); text: Springboard.selected-endpoint.name; color: ViewerStyle.ink; font-size: (17px * ViewerStyle.scale); font-weight: 500; overflow: elide; }
        Text { x: (91px * ViewerStyle.scale); y: (112px * ViewerStyle.scale); text: Springboard.selected-endpoint.address; color: ViewerStyle.muted; font-size: 11px; }
        Text { x: (24px * ViewerStyle.scale); y: (166px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired ? "This viewer does not encrypt its connection." : Springboard.connection-state == ConnectionState.Connecting ? "Connecting to your viewer…" : "Enter the code shown on your device."; color: ViewerStyle.muted; font-size: (15px * ViewerStyle.scale); }
        if Springboard.connection-state == ConnectionState.PairingRequired: DeviceField { x: (24px * ViewerStyle.scale); y: (204px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (52px * ViewerStyle.scale); text <=> root.code; placeholder: "\{Springboard.pairing-code-digits}-digit pairing code"; numeric: true; }
        Text { x: (24px * ViewerStyle.scale); y: (274px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: Springboard.error-message; wrap: word-wrap; color: ViewerStyle.dark ? #edaaa3 : #a94d46; font-size: 11px; }
        SoftButton {
            x: (24px * ViewerStyle.scale); y: (315px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); height: (46px * ViewerStyle.scale); label: Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired ? "Connect unencrypted" : "Pair device"; primary: true; enabled: Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired || (Springboard.connection-state == ConnectionState.PairingRequired && root.code.character-count == Springboard.pairing-code-digits);
            activated => {
                if Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired {
                    Springboard.accept-unpaired-connection();
                } else { Springboard.submit-pairing-code(root.code); root.code = ""; }
            }
        }
        Text { x: (24px * ViewerStyle.scale); y: (385px * ViewerStyle.scale); width: parent.width - (48px * ViewerStyle.scale); text: "A restart may require a new pairing code."; color: ViewerStyle.muted; font-size: 11px; horizontal-alignment: center; }
    }
    if root.removing != "": Rectangle {
        TouchArea { clicked => { root.removing = ""; } }
        SoftButton {
            x: root.confirm-x; y: root.confirm-y; width: (78px * ViewerStyle.scale); height: (32px * ViewerStyle.scale); label: "Confirm";
            activated => { Springboard.forget-device(root.removing); root.removing = ""; }
        }
    }
}
