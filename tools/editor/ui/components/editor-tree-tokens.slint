import { Style } from "../style.slint";
import { StudioTheme } from "common.slint";
import { Palette } from "std-widgets.slint";

export global EditorTreeTokens {
    out property <color> row-bg-hover: Style.tree.row-bg-hover;
    out property <color> row-bg-current: Style.tree.row-bg-current;
    out property <color> drop-target-bg: Style.tree.drop-target-bg;
    out property <color> text: Style.tree.text;
    out property <color> muted-text: Style.tree.muted-text;
    out property <color> accent: Style.tree.accent;
    out property <color> guide: Style.tree.guide;
    out property <color> directory-icon: Style.tree.directory-icon;
    out property <length> row-height: Style.tree.row-height;
    out property <length> row-font-size: Style.tree.row-font-size;
    out property <length> row-radius: Style.tree.row-radius;
    out property <length> row-padding-inline: Style.tree.row-padding-inline;
    out property <length> content-gap: Style.tree.content-gap;
    out property <length> toggle-width: Style.tree.toggle-width;
    out property <length> disclosure-hit-size: Style.tree.disclosure-hit-size;
    out property <length> icon-size: Style.tree.icon-size;
    out property <length> current-indicator-width: Style.tree.current-indicator-width;
    out property <length> current-indicator-height: Style.tree.current-indicator-height;
    out property <length> guide-width: Style.tree.guide-width;
    out property <length> focus-ring-width: Style.tree.focus-ring-width;
    out property <length> drop-target-border-width: Style.tree.drop-target-border-width;
    out property <length> drop-indicator-height: Style.tree.drop-indicator-height;
    out property <length> root-drop-height: Style.tree.root-drop-height;
}
