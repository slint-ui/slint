import { Style } from "../style.slint";
import { Api, EditorSurfaceMode } from "../api.slint";
import { Preview } from "../preview.slint";
import { EditorMetrics } from "common.slint";
import { Project } from "../project.slint";

component RunButton inherits Rectangle {
    in property <bool> enabled;
    in property <bool> running;
    callback clicked;

    width: bt.width + 2 * Style.spacing.regular;
    height: Style.controls.height;
    border-radius: Style.controls.row-radius;
    background: enabled
        ? touch.pressed ? Style.colors.action-pressed : touch.has-hover ? Style.colors.action-hover : Style.colors.action-bg
        : Style.colors.panel-subtle;
    opacity: enabled ? 1 : Style.controls.disabled-opacity;

    bt := Text {
        text: root.running ? "Running" : "Run";
        color: enabled ? Style.colors.action-text : Style.colors.muted;
        font-size: Style.typography.strong-body.size;
        font-weight: Style.typography.strong-body.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.running ? "Running" : "Run";
        clicked => { root.clicked(); }
    }
}

export component EditorTopBar inherits Rectangle {
    height: EditorMetrics.top-bar-height;
    background: Style.colors.panel-bg;

    Rectangle {
        y: parent.height - 1px;
        height: Style.controls.border-width;
        background: Style.colors.border;
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Project.selected-project-file;
            color: Style.colors.muted;
            font-size: Style.typography.body.size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    RunButton {
        x: parent.width - self.width - Style.spacing.large;
        y: (parent.height - self.height) / 2;
        enabled: Preview.can-run && Api.editor-surface-mode == EditorSurfaceMode.component;
        running: Preview.is-running;
        clicked => { Preview.run(); }
    }
}
