import { Style, Metrics, Colors, Typography } from "../style.slint";
import { ViewerControls } from "viewer-controls.slint";
import { Api, EditorSurfaceMode } from "../api.slint";
import { Diagnostics } from "../diagnostics.slint";
import { Preview } from "../preview.slint";

import { Project } from "../project.slint";

export component EditorTopBar inherits Rectangle {
    height: Style.shell.top-bar-height;
    background: Colors.surface;

    Rectangle {
        y: parent.height - 1px;
        height: Metrics.border-width;
        background: Colors.border;
    }

    HorizontalLayout {
        x: viewer.width + Metrics.space-large;
        width: max(0px, parent.width - 2 * self.x);
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Project.selected-project-file;
            color: Colors.muted;
            font-size: Typography.body.size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    viewer := ViewerControls {
        x: parent.width - self.width - Metrics.space-large;
        y: (parent.height - self.height) / 2;
        busy: !Diagnostics.preview-editable;
        can-start: Preview.can-run && !Diagnostics.preview-status-visible
            && Api.editor-surface-mode == EditorSurfaceMode.component;
    }
}
