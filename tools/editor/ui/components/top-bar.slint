import { Api, EditorSurfaceMode } from "../api.slint";
import { Preview } from "../preview.slint";
import { EditorMetrics, StudioTheme } from "common.slint";
import { Project } from "../project.slint";

component RunButton inherits Rectangle {
    in property <bool> enabled;
    callback clicked;

    width: 68px;
    height: 32px;
    border-radius: 6px;
    background: enabled
        ? touch.has-hover ? StudioTheme.accent-strong : StudioTheme.accent
        : StudioTheme.panel-subtle;
    opacity: enabled ? 1 : 0.55;

    Text {
        text: "Run";
        color: enabled ? white : StudioTheme.muted;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Run";
        clicked => { root.clicked(); }
    }
}

export component EditorTopBar inherits Rectangle {
    height: EditorMetrics.top-bar-height;
    background: StudioTheme.panel-bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: StudioTheme.border;
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Project.selected-project-file;
            color: StudioTheme.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    RunButton {
        x: parent.width - self.width - 16px;
        y: (parent.height - self.height) / 2;
        enabled: Preview.can-run && Api.editor-surface-mode == EditorSurfaceMode.component;
        clicked => { Preview.run(); }
    }
}
