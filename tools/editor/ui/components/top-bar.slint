import { Style, PaintStyle, Metrics, Colors, Typography, ButtonStyle } from "../style.slint";
import { Api, EditorSurfaceMode } from "../api.slint";
import { Preview } from "../preview.slint";

import { Project } from "../project.slint";
import { Button } from "std-widgets.slint";

export component AnnotationSendError inherits Rectangle {
    height: error-layout.preferred-height;
    background: Colors.subtle;
    accessible-role: AccessibleRole.region;
    accessible-label: "Annotation send error";
    accessible-value: Api.annotation-send-error;

    error-layout := HorizontalLayout {
        padding: Metrics.space-small;
        padding-left: Metrics.space-large;
        padding-right: Metrics.space-large;
        spacing: Metrics.space-medium;
        cross-axis-alignment: center;
        Text {
            text: "Could not send annotations: " + Api.annotation-send-error;
            color: Colors.danger;
            font-size: Typography.caption.size;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        Button {
            text: "×";
            accessible-label: "Dismiss annotation send error";
            clicked => { Api.dismiss-annotation-send-error(); }
        }
    }
}

component RunButton inherits Rectangle {
    in property <ButtonStyle> style: Style.primary-button;
    in property <bool> enabled;
    in property <bool> running;
    callback clicked;
    private property <PaintStyle> paint: !root.enabled ? root.style.appearance.disabled
        : touch.pressed ? root.style.appearance.pressed
        : touch.has-hover ? root.style.appearance.hover : root.style.appearance.normal;

    width: bt.width + 2 * root.style.padding-inline;
    height: root.style.height;
    border-radius: root.style.radius;
    background: root.paint.background;
    border-color: root.paint.border;
    opacity: enabled ? 1 : root.style.disabled-opacity;

    bt := Text {
        text: root.running ? "Running" : "Run";
        color: root.paint.foreground;
        font-size: root.style.text.size;
        font-weight: root.style.text.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.running ? "Running" : "Run";
        clicked => { root.clicked(); }
    }
}

export component EditorTopBar inherits Rectangle {
    height: Style.shell.top-bar-height;
    background: Colors.surface;

    Rectangle {
        y: parent.height - 1px;
        height: Metrics.border-width;
        background: Colors.border;
    }

    HorizontalLayout {
        width: max(0px, actions.x - Metrics.space-medium);
        padding-left: Metrics.space-large;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Project.selected-project-file;
            color: Colors.muted;
            font-size: Typography.body.size;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    actions := HorizontalLayout {
        width: self.preferred-width;
        x: parent.width - self.width - Metrics.space-large;
        y: (parent.height - self.height) / 2;
        height: Style.primary-button.height;
        spacing: Metrics.space-medium;
        cross-axis-alignment: center;

        Rectangle {
            width: 220px;
            height: Style.primary-button.height;
            border-radius: Metrics.radius-medium;
            background: Colors.subtle;
            accessible-role: AccessibleRole.region;
            accessible-label: "Annotation destination";
            accessible-value: Api.agent-registered ? Api.agent-chat-name + " · Registered" : "No chat registered";

            HorizontalLayout {
                padding-left: Metrics.space-medium;
                padding-right: Metrics.space-medium;
                spacing: Metrics.space-small;
                cross-axis-alignment: center;
                Image {
                    width: 18px;
                    height: 18px;
                    source: @image-url("../assets/openai.svg");
                    colorize: Colors.foreground;
                }
                Text {
                    text: Api.agent-registered ? Api.agent-chat-name : "No chat registered";
                    color: Colors.foreground;
                    font-size: Typography.caption.size;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Api.agent-registered ? Colors.accent : Colors.muted;
                }
            }
        }
        Button {
            text: Api.annotations-sending ? "Sending…" : "↑ Send \{Api.pending-annotation-count}";
            accessible-label: "Send pending annotations";
            accessible-value: "\{Api.pending-annotation-count}";
            enabled: Api.agent-registered && Api.pending-annotation-count > 0 && !Api.annotations-sending;
            clicked => { Api.send-pending-annotations(); }
        }
        RunButton {
            enabled: Preview.can-run && Api.editor-surface-mode == EditorSurfaceMode.component;
            running: Preview.is-running;
            clicked => { Preview.run(); }
        }
    }
}
