import { Api, FillData, LinearGradientAxis, SelectionRectangle } from "../api.slint";
import { FillSession } from "inspector/fill-session.slint";
import { StudioTheme } from "common.slint";
import { GradientStopMarker } from "../../../lsp/ui/components/widgets/gradient-stop-marker.slint";

enum GradientGestureKind {
    start-handle,
    end-handle,
    axis,
    stop,
}

component GradientHandle inherits FocusScope {
    in property <string> label;
    in property <color> color;
    in property <bool> selected;
    in property <bool> endpoint;
    in property <int> focus-generation;
    callback window-point(Point) -> Point;
    changed focus-generation => { if root.selected { root.focus(); } }
    callback started(Point);
    callback dragged(Point);
    callback finished();
    callback focused();
    callback keyboard(KeyEvent) -> EventResult;
    width: 32px;
    height: 32px;
    z: touch.pressed ? 3 : root.selected || root.has-focus ? 2 : 1;
    key-pressed(event) => { return root.keyboard(event); }
    changed has-focus => { if root.has-focus { root.focused(); } }
    if !root.endpoint: GradientStopMarker {
        x: (parent.width - self.width) / 2;
        y: 0px;
        active: root.selected || root.has-focus;
        stop-color: root.color;
    }
    if root.endpoint: Rectangle {
        x: 10px;
        y: 10px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
        border-width: root.has-focus ? 2px : 0px;
        border-color: StudioTheme.accent-strong;
        drop-shadow-blur: 3px;
        drop-shadow-color: #0008;
    }
    touch := TouchArea {
        mouse-cursor: grab;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        accessible-action-default => { root.focus(); root.focused(); }
        changed pressed => {
            if self.pressed {
                root.focus();
                root.focused();
                root.started(root.window-point({ x: self.mouse-x, y: self.mouse-y }));
            } else {
                root.finished();
            }
        }
        moved => {
            if self.pressed {
                root.dragged(root.window-point({ x: self.mouse-x, y: self.mouse-y }));
            }
        }
    }
}

export component GradientOverlay inherits FocusScope {
    focus-on-click: false;
    in property <SelectionRectangle> selection;
    private property <LinearGradientAxis> axis: FillSession.axis;
    private property <bool> radial: FillSession.radial-active;
    private property <bool> conic: FillSession.conic-active;
    private property <Point> start: root.to-canvas(root.axis.start);
    private property <Point> end: root.to-canvas(root.axis.end);
    private property <length> dx: root.end.x - root.start.x;
    private property <length> dy: root.end.y - root.start.y;
    private property <length> axis-length: max(1px, sqrt((root.dx * root.dx + root.dy * root.dy) / (1px * 1px)) * 1px);
    private property <angle> direction: atan2(root.dy / 1px, root.dx / 1px);
    private property <bool> dragging;
    private property <GradientGestureKind> drag-kind;
    private property <Point> press;
    private property <LinearGradientAxis> original-axis;
    private property <FillData> original-fill;
    private property <Point> original-stop;
    private property <int> original-selected;
    private property <int> focus-request: FillSession.focus-stop-generation;
    private property <int> focus-epoch;
    private property <int> stop-count: FillSession.working-fill.stops.length;
    // Preview model replacement must not rebuild the captured handle.
    private property <int> handle-count;
    init => { root.handle-count = root.stop-count; }
    changed stop-count => { root.handle-count = root.stop-count; }
    changed focus-request => { focus-timer.start(); }
    focus-timer := Timer {
        interval: 0ms;
        triggered => {
            self.stop();
            root.focus-epoch += 1;
        }
    }

    pure function to-canvas(p: Point) -> Point {
        let cx = root.selection.width / 2;
        let cy = root.selection.height / 2;
        return {
            x: root.selection.x + cx + (p.x - cx) * cos(root.selection.angle) - (p.y - cy) * sin(root.selection.angle),
            y: root.selection.y + cy + (p.x - cx) * sin(root.selection.angle) + (p.y - cy) * cos(root.selection.angle),
        };
    }
    pure function to-local(p: Point) -> Point {
        let x = p.x - root.absolute-position.x - root.selection.x - root.selection.width / 2;
        let y = p.y - root.absolute-position.y - root.selection.y - root.selection.height / 2;
        return {
            x: root.selection.width / 2 + x * cos(root.selection.angle) + y * sin(root.selection.angle),
            y: root.selection.height / 2 - x * sin(root.selection.angle) + y * cos(root.selection.angle),
        };
    }
    function begin(kind: GradientGestureKind, p: Point) {
        root.drag-kind = kind;
        root.original-selected = FillSession.selected-stop;
        root.press = root.to-local(p);
        root.original-axis = root.axis;
        root.original-fill = FillSession.working-fill;
        root.original-stop = FillSession.stop-point(FillSession.working-fill.stops[FillSession.selected-stop].position);
        root.dragging = true;
    }
    function drag(p: Point) {
        if !root.dragging { return; }
        let local = root.to-local(p);
        let delta = { x: local.x - root.press.x, y: local.y - root.press.y };
        if root.conic && root.drag-kind != GradientGestureKind.start-handle {
            let degrees = Api.gradient-angular-delta(root.axis.start, root.press, local);
            root.press = local;
            if root.drag-kind == GradientGestureKind.stop {
                FillSession.move-stop-position((FillSession.working-fill.stops[FillSession.selected-stop].position + degrees / 360).clamp(0, 1));
            } else {
                FillSession.move-axis(FillSession.working-fill, root.axis, {
                    start: root.axis.start,
                    end: Api.conic-gradient-point(root.axis, degrees / 360),
                });
            }
            return;
        }
        if root.drag-kind == GradientGestureKind.stop {
            FillSession.move-stop({ x: root.original-stop.x + delta.x, y: root.original-stop.y + delta.y });
            return;
        }
        let next = {
            start: root.drag-kind == GradientGestureKind.end-handle ? root.original-axis.start : { x: root.original-axis.start.x + delta.x, y: root.original-axis.start.y + delta.y },
            end: root.drag-kind == GradientGestureKind.start-handle && !root.radial && !root.conic ? root.original-axis.end : { x: root.original-axis.end.x + delta.x, y: root.original-axis.end.y + delta.y },
        };
        FillSession.move-axis(root.original-fill, root.original-axis, next);
    }
    function handle-key(kind: GradientGestureKind, event: KeyEvent) -> EventResult {
        if kind == GradientGestureKind.stop && (event.text == Key.Delete || event.text == Key.Backspace) {
            FillSession.remove-stop(FillSession.selected-stop);
            FillSession.focus-stop-generation += 1;
            return accept;
        }
        if event.text != Key.LeftArrow && event.text != Key.RightArrow && event.text != Key.UpArrow && event.text != Key.DownArrow {
            return reject;
        }
        let step = event.modifiers.shift ? 10 : 1;
        if root.conic && kind != GradientGestureKind.start-handle {
            let amount = (event.text == Key.LeftArrow || event.text == Key.DownArrow ? -step : step) / 360;
            if kind == GradientGestureKind.stop {
                FillSession.move-stop-position((FillSession.working-fill.stops[FillSession.selected-stop].position + amount).clamp(0, 1));
                FillSession.focus-stop-generation += 1;
            } else {
                FillSession.move-axis(FillSession.working-fill, root.axis, {
                    start: root.axis.start,
                    end: Api.conic-gradient-point(root.axis, amount),
                });
            }
            return accept;
        }
        if kind == GradientGestureKind.stop {
            let amount = (event.text == Key.LeftArrow || event.text == Key.DownArrow ? -step : step) / 100;
            let p = FillSession.stop-point(FillSession.working-fill.stops[FillSession.selected-stop].position);
            FillSession.move-stop({
                x: p.x + amount * (root.axis.end.x - root.axis.start.x),
                y: p.y + amount * (root.axis.end.y - root.axis.start.y),
            });
            FillSession.focus-stop-generation += 1;
        } else {
            let delta = {
                x: (event.text == Key.LeftArrow ? -step : event.text == Key.RightArrow ? step : 0) * 1px,
                y: (event.text == Key.UpArrow ? -step : event.text == Key.DownArrow ? step : 0) * 1px,
            };
            let next = {
                start: kind == GradientGestureKind.start-handle ? { x: root.axis.start.x + delta.x, y: root.axis.start.y + delta.y } : root.axis.start,
                end: kind == GradientGestureKind.end-handle || root.radial || root.conic ? { x: root.axis.end.x + delta.x, y: root.axis.end.y + delta.y } : root.axis.end,
            };
            FillSession.move-axis(FillSession.working-fill, root.axis, next);
        }
        return accept;
    }
    key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z") {
            FillSession.apply-history(event.modifiers.shift);
            return accept;
        }
        if event.text == Key.Escape {
            if root.dragging {
                root.dragging = false;
                FillSession.preview-fill(root.original-fill);
                FillSession.axis = root.original-axis;
                if root.radial { FillSession.radial-direction = atan2((root.axis.end.y - root.axis.start.y) / 1px, (root.axis.end.x - root.axis.start.x) / 1px); }
                FillSession.selected-stop = root.original-selected;
            } else {
                FillSession.close-picker(false, true);
            }
            return accept;
        }
        if root.conic && root.has-focus && !root.dragging { return root.handle-key(GradientGestureKind.end-handle, event); }
        return reject;
    }

    if root.radial || root.conic: Rectangle {
        x: root.start.x - root.axis-length;
        y: root.start.y - root.axis-length;
        width: root.axis-length * 2;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #ffffff90;
    }
    group := Rectangle {
        x: root.start.x;
        y: root.start.y;
        width: root.axis-length;
        height: 0px;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: root.direction;
        pure function window-point(p: Point) -> Point {
            return {
                x: root.absolute-position.x + root.start.x + p.x * cos(root.direction) - p.y * sin(root.direction),
                y: root.absolute-position.y + root.start.y + p.x * sin(root.direction) + p.y * cos(root.direction),
            };
        }
        for segment in (root.conic ? 96 : 0): TouchArea {
            private property <angle> angle: segment * 360deg / 96;
            private property <angle> tangent: self.angle + 90deg;
            width: 2 * 3.141593 * root.axis-length / 96 + 1px;
            height: 12px;
            x: root.axis-length * cos(self.angle) - self.width / 2;
            y: root.axis-length * sin(self.angle) - self.height / 2;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: self.tangent;
            mouse-cursor: crosshair;
            clicked => { root.focus(); }
            double-clicked => {
                let dx = self.mouse-x - self.width / 2;
                let dy = self.mouse-y - self.height / 2;
                FillSession.add-stop(root.to-local(group.window-point({
                    x: root.axis-length * cos(self.angle) + dx * cos(self.tangent) - dy * sin(self.tangent),
                    y: root.axis-length * sin(self.angle) + dx * sin(self.tangent) + dy * cos(self.tangent),
                })));
            }
        }
        line := Rectangle {
            y: -5px;
            width: parent.width;
            height: 10px;
            Rectangle {
                y: 4px;
                height: 2px;
                background: white;
                drop-shadow-blur: 2px;
                drop-shadow-color: #000a;
            }
            touch := TouchArea {
                mouse-cursor: grab;
                accessible-role: AccessibleRole.button;
                accessible-label: "Gradient axis";
                pure function pointer() -> Point {
                    return group.window-point({ x: self.mouse-x, y: self.mouse-y - 5px });
                }
                changed pressed => {
                    if self.pressed { root.focus(); root.begin(GradientGestureKind.axis, self.pointer()); }
                    else { root.dragging = false; }
                }
                moved => { if self.pressed { root.drag(self.pointer()); } }
                double-clicked => { if !root.conic { FillSession.add-stop(root.to-local(self.pointer())); } }
            }
        }
        for endpoint in 2: GradientHandle {
            private property <GradientGestureKind> gesture-kind: endpoint == 0 ? GradientGestureKind.start-handle : GradientGestureKind.end-handle;
            x: (endpoint == 0 ? 0px : root.axis-length) - self.width / 2;
            y: -self.height / 2;
            endpoint: true;
            color: white;
            label: root.conic ? (endpoint == 0 ? "Gradient center handle" : "Gradient rotation handle") : root.radial ? (endpoint == 0 ? "Gradient center handle" : "Gradient radius handle") : (endpoint == 0 ? "Gradient start" : "Gradient end");
            window-point(p) => { return group.window-point({ x: self.x + p.x, y: self.y + p.y }); }
            keyboard(event) => { return root.handle-key(self.gesture-kind, event); }
            started(p) => { root.begin(self.gesture-kind, p); }
            dragged(p) => { root.drag(p); }
            finished => { root.dragging = false; }
        }
        for index in root.handle-count: GradientHandle {
            private property <float> position: FillSession.working-fill.stops[index].position;
            private property <angle> stop-angle: self.position * 360deg;
            private property <angle> marker-angle: root.conic ? self.stop-angle + (self.position >= 1 ? 90deg : -90deg) : 0deg;
            private property <Point> canonical: FillSession.stop-point(FillSession.working-fill.stops[index].position);
            private property <float> relative: ((self.canonical.x - root.axis.start.x) * (root.axis.end.x - root.axis.start.x)
                + (self.canonical.y - root.axis.start.y) * (root.axis.end.y - root.axis.start.y))
                / max(1px * 1px, (root.axis.end.x - root.axis.start.x) * (root.axis.end.x - root.axis.start.x)
                    + (root.axis.end.y - root.axis.start.y) * (root.axis.end.y - root.axis.start.y));
            x: (root.conic ? root.axis-length * cos(self.stop-angle) : self.relative * root.axis-length) - self.width / 2;
            y: root.conic ? root.axis-length * sin(self.stop-angle) + 6px : 5px;
            transform-origin: { x: self.width / 2, y: -6px };
            transform-rotation: self.marker-angle;
            color: FillSession.working-fill.stops[index].color;
            selected: index == FillSession.selected-stop;
            label: "Gradient stop " + (index + 1);
            focus-generation: root.focus-epoch;
            window-point(p) => {
                let dx = p.x - self.width / 2;
                let dy = p.y + 6px;
                return group.window-point({
                    x: self.x + self.width / 2 + dx * cos(self.marker-angle) - dy * sin(self.marker-angle),
                    y: self.y - 6px + dx * sin(self.marker-angle) + dy * cos(self.marker-angle),
                });
            }
            keyboard(event) => { return root.handle-key(GradientGestureKind.stop, event); }
            focused => { FillSession.selected-stop = index; }
            started(p) => { root.begin(GradientGestureKind.stop, p); }
            dragged(p) => { root.drag(p); }
            finished => { root.dragging = false; }
        }
    }
}
