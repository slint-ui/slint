import { CanvasView } from "canvas-view.slint";
import { Style, Metrics, Colors, GradientOverlayStyle } from "../style.slint";
import { Api, FillData, LinearGradientAxis, SelectionRectangle } from "../api.slint";
import { FillSession } from "inspector/index.slint";

import { EditorGradientStopMarker } from "gradient-stop-marker.slint";

enum GradientGestureKind {
    start-handle,
    end-handle,
    y-radius,
    axis,
    stop,
}

component GradientHandle inherits FocusScope {
    in property <GradientOverlayStyle> style: Style.gradient-overlay;
    in property <string> label;
    in property <color> color;
    in property <bool> selected;
    in property <bool> endpoint;
    in property <int> focus-generation;
    callback window-point(Point) -> Point;
    changed focus-generation => { if root.selected { root.focus(); } }
    callback started(Point);
    callback dragged(Point);
    callback finished();
    callback selection-requested();
    callback activated();
    callback keyboard(KeyEvent) -> EventResult;
    width: root.endpoint ? root.style.hit-size : max(root.style.hit-size, root.style.marker.size);
    height: root.endpoint ? root.style.hit-size : max(root.style.hit-size, root.style.marker.size);
    z: touch.pressed ? 3 : root.selected || root.has-focus ? 2 : 1;
    key-pressed(event) => { return root.keyboard(event); }
    changed has-focus => { if root.has-focus { root.selection-requested(); } }
    if !root.endpoint: EditorGradientStopMarker {
        style: root.style.marker;
        x: (parent.width - self.width) / 2;
        y: 0px;
        active: root.selected || root.has-focus;
        stop-color: root.color;
    }
    if root.endpoint: Rectangle {
        width: root.style.endpoint-size;
        height: root.style.endpoint-size;
        border-radius: self.width / 2;
        background: root.style.endpoint-background;
        border-width: root.has-focus ? Metrics.focus-width : 0px;
        border-color: root.style.focus-border;
        drop-shadow-blur: root.style.endpoint-shadow.blur;
        drop-shadow-color: root.style.endpoint-shadow.color;
    }
    touch := TouchArea {
        private property <bool> dragged;
        private property <length> drag-threshold: 2px;
        mouse-cursor: grab;
        accessible-role: AccessibleRole.button;
        accessible-label: root.label;
        accessible-action-default => {
            root.focus();
            if !root.endpoint { root.activated(); }
        }
        changed pressed => {
            if self.pressed {
                self.dragged = false;
                root.selection-requested();
                root.focus();
                root.started(root.window-point({ x: self.mouse-x, y: self.mouse-y }));
            } else {
                root.finished();
            }
        }
        moved => {
            if self.pressed {
                if root.endpoint || self.dragged || abs(self.mouse-x - self.pressed-x) >= self.drag-threshold || abs(self.mouse-y - self.pressed-y) >= self.drag-threshold {
                    self.dragged = true;
                    root.dragged(root.window-point({ x: self.mouse-x, y: self.mouse-y }));
                }
            }
        }
        clicked => {
            if !root.endpoint && !self.dragged {
                root.activated();
            }
        }
    }
}

export component GradientOverlay inherits FocusScope {
    in property <GradientOverlayStyle> style: Style.gradient-overlay;
    in property <bool> shift-pressed;
    focus-on-click: false;
    in property <SelectionRectangle> selection;
    private property <LinearGradientAxis> axis: FillSession.axis;
    private property <bool> radial: FillSession.radial-active;
    private property <bool> ellipse: root.radial && FillSession.working-fill.radial-ellipse;
    private property <bool> conic: FillSession.conic-active;
    private property <LinearGradientAxis> y-axis: FillSession.y-axis;
    private property <angle> canvas-angle: FillSession.canvas-rotation;
    private property <Point> start: root.to-canvas(root.axis.start);
    private property <Point> end: root.to-canvas(root.axis.end);
    private property <length> dx: root.end.x - root.start.x;
    private property <length> dy: root.end.y - root.start.y;
    private property <length> axis-length: max(1px, sqrt((root.dx * root.dx + root.dy * root.dy) / (1px * 1px)) * 1px);
    private property <angle> direction: atan2(root.dy / 1px, root.dx / 1px);
    private property <Point> y-end: root.to-canvas(root.y-axis.end);
    private property <length> y-dx: root.y-end.x - root.start.x;
    private property <length> y-dy: root.y-end.y - root.start.y;
    private property <length> y-axis-length: max(1px, sqrt((root.y-dx * root.y-dx + root.y-dy * root.y-dy) / (1px * 1px)) * 1px);
    private property <angle> y-direction: atan2(root.y-dy / 1px, root.y-dx / 1px);
    private property <bool> dragging;
    changed dragging => { CanvasView.manipulating = root.dragging; }
    private property <GradientGestureKind> drag-kind;
    private property <Point> press;
    private property <Point> press-window;
    private property <Point> original-end-window;
    private property <float> original-rotation;
    private property <angle> previous-drag-angle;
    private property <angle> accumulated-angle;
    private property <LinearGradientAxis> original-axis;
    private property <LinearGradientAxis> original-y-axis;
    private property <FillData> original-fill;
    private property <Point> original-stop;
    private property <int> original-selected;
    private property <int> focus-request: FillSession.focus-stop-generation;
    private property <int> focus-epoch;
    private property <int> stop-count: FillSession.working-fill.stops.length;
    // Preview model replacement must not rebuild the captured handle.
    private property <int> handle-count;
    init => { root.handle-count = root.stop-count; }
    changed stop-count => { root.handle-count = root.stop-count; }
    changed focus-request => { focus-timer.start(); }
    focus-timer := Timer {
        interval: 0ms;
        triggered => {
            self.stop();
            root.focus-epoch += 1;
        }
    }

    pure function to-canvas(p: Point) -> Point {
        let cx = root.selection.width / 2;
        let cy = root.selection.height / 2;
        return {
            x: (root.selection.x + cx + (p.x - cx) * cos(root.canvas-angle) - (p.y - cy) * sin(root.canvas-angle)) * CanvasView.zoom,
            y: (root.selection.y + cy + (p.x - cx) * sin(root.canvas-angle) + (p.y - cy) * cos(root.canvas-angle)) * CanvasView.zoom,
        };
    }
    pure function to-local(p: Point) -> Point {
        let preview = CanvasView.to-preview({ x: p.x - root.absolute-position.x, y: p.y - root.absolute-position.y });
        let x = preview.x - root.selection.x - root.selection.width / 2;
        let y = preview.y - root.selection.y - root.selection.height / 2;
        return {
            x: root.selection.width / 2 + x * cos(root.canvas-angle) + y * sin(root.canvas-angle),
            y: root.selection.height / 2 - x * sin(root.canvas-angle) + y * cos(root.canvas-angle),
        };
    }
    function begin(kind: GradientGestureKind, p: Point) {
        root.drag-kind = kind;
        root.original-selected = FillSession.selected-stop;
        root.press = root.to-local(p);
        root.press-window = p;
        root.original-end-window = { x: root.absolute-position.x + root.end.x, y: root.absolute-position.y + root.end.y };
        root.original-rotation = FillSession.element-rotation;
        root.previous-drag-angle = root.canvas-angle;
        root.accumulated-angle = 0deg;
        root.original-axis = root.axis;
        root.original-y-axis = root.y-axis;
        root.original-fill = FillSession.working-fill;
        root.original-stop = FillSession.stop-point(FillSession.working-fill.stops[FillSession.selected-stop].position);
        root.dragging = true;
    }
    function drag(p: Point) {
        if !root.dragging { return; }
        if root.radial && root.drag-kind == GradientGestureKind.end-handle {
            let target = CanvasView.to-preview({
                x: root.original-end-window.x + p.x - root.press-window.x - root.absolute-position.x,
                y: root.original-end-window.y + p.y - root.press-window.y - root.absolute-position.y,
            });
            let pivot = { x: root.selection.x + root.selection.width / 2, y: root.selection.y + root.selection.height / 2 };
            let vx = (target.x - pivot.x) / 1px;
            let vy = (target.y - pivot.y) / 1px;
            let qx = (root.original-axis.start.x - root.selection.width / 2) / 1px;
            let qy = (root.original-axis.start.y - root.selection.height / 2) / 1px;
            let squared = vx * vx + vy * vy - qy * qy;
            if squared <= 0 { return; }
            let projection = sqrt(squared);
            let local-x = vx * cos(root.canvas-angle) + vy * sin(root.canvas-angle);
            let projected = local-x < 0 && -projection - qx >= 1 ? -projection : projection;
            let radius = projected - qx;
            if radius < 1 { return; }
            let angle = atan2(vy, vx) - atan2(qy, projected);
            let raw-step = angle - root.previous-drag-angle;
            let step = raw-step > 180deg ? raw-step - 360deg : raw-step < -180deg ? raw-step + 360deg : raw-step;
            root.accumulated-angle += step;
            root.previous-drag-angle = angle;
            FillSession.move-rotated-axis(root.original-fill, root.original-axis, {
                start: root.original-axis.start,
                end: { x: root.original-axis.start.x + radius * 1px, y: root.original-axis.start.y },
            }, root.original-rotation + root.accumulated-angle / 1deg, root.shift-pressed);
            return;
        }
        let local = root.to-local(p);
        let delta = { x: local.x - root.press.x, y: local.y - root.press.y };
        if root.drag-kind == GradientGestureKind.y-radius {
            FillSession.move-y-axis(root.original-fill, root.original-y-axis, {
                start: root.original-y-axis.start,
                end: { x: root.original-y-axis.end.x, y: root.original-y-axis.end.y + delta.y },
            }, root.shift-pressed);
            return;
        }
        if root.conic && root.drag-kind != GradientGestureKind.start-handle {
            let degrees = Api.gradient-angular-delta(root.axis.start, root.press, local);
            root.press = local;
            if root.drag-kind == GradientGestureKind.stop {
                FillSession.move-stop-position((FillSession.working-fill.stops[FillSession.selected-stop].position + degrees / 360).clamp(0, 1));
            } else {
                FillSession.move-axis(FillSession.working-fill, root.axis, {
                    start: root.axis.start,
                    end: Api.conic-gradient-point(root.axis, degrees / 360),
                });
            }
            return;
        }
        if root.drag-kind == GradientGestureKind.stop {
            FillSession.move-stop({ x: root.original-stop.x + delta.x, y: root.original-stop.y + delta.y });
            return;
        }
        let next = {
            start: root.drag-kind == GradientGestureKind.end-handle ? root.original-axis.start : { x: root.original-axis.start.x + delta.x, y: root.original-axis.start.y + delta.y },
            end: root.drag-kind == GradientGestureKind.start-handle && !root.radial && !root.conic ? root.original-axis.end : { x: root.original-axis.end.x + delta.x, y: root.original-axis.end.y + delta.y },
        };
        FillSession.move-axis(root.original-fill, root.original-axis, next);
    }
    function handle-key(kind: GradientGestureKind, event: KeyEvent) -> EventResult {
        if kind == GradientGestureKind.stop && (event.text == Key.Delete || event.text == Key.Backspace) {
            FillSession.remove-stop(FillSession.selected-stop);
            FillSession.focus-stop-generation += 1;
            return accept;
        }
        if event.text != Key.LeftArrow && event.text != Key.RightArrow && event.text != Key.UpArrow && event.text != Key.DownArrow {
            return reject;
        }
        let step = event.modifiers.shift ? 10 : 1;
        if kind == GradientGestureKind.y-radius {
            if event.text != Key.UpArrow && event.text != Key.DownArrow { return reject; }
            let amount = (event.text == Key.UpArrow ? -step : step) * 1px;
            FillSession.move-y-axis(FillSession.working-fill, root.y-axis, {
                start: root.y-axis.start,
                end: { x: root.y-axis.end.x, y: root.y-axis.end.y + amount },
            }, event.modifiers.shift);
            return accept;
        }
        if root.radial && kind == GradientGestureKind.end-handle {
            if event.text != Key.LeftArrow && event.text != Key.RightArrow { return reject; }
            let amount = (event.text == Key.LeftArrow ? -step : step) * 1px;
            FillSession.move-rotated-axis(FillSession.working-fill, root.axis, {
                start: root.axis.start,
                end: { x: max(root.axis.start.x + 1px, root.axis.end.x + amount), y: root.axis.end.y },
            }, FillSession.element-rotation, event.modifiers.shift);
            return accept;
        }
        if root.conic && kind != GradientGestureKind.start-handle {
            let amount = (event.text == Key.LeftArrow || event.text == Key.DownArrow ? -step : step) / 360;
            if kind == GradientGestureKind.stop {
                FillSession.move-stop-position((FillSession.working-fill.stops[FillSession.selected-stop].position + amount).clamp(0, 1));
                FillSession.focus-stop-generation += 1;
            } else {
                FillSession.move-axis(FillSession.working-fill, root.axis, {
                    start: root.axis.start,
                    end: Api.conic-gradient-point(root.axis, amount),
                });
            }
            return accept;
        }
        if kind == GradientGestureKind.stop {
            let amount = (event.text == Key.LeftArrow || event.text == Key.DownArrow ? -step : step) / 100;
            let p = FillSession.stop-point(FillSession.working-fill.stops[FillSession.selected-stop].position);
            FillSession.move-stop({
                x: p.x + amount * (root.axis.end.x - root.axis.start.x),
                y: p.y + amount * (root.axis.end.y - root.axis.start.y),
            });
            FillSession.focus-stop-generation += 1;
        } else {
            let delta = {
                x: (event.text == Key.LeftArrow ? -step : event.text == Key.RightArrow ? step : 0) * 1px,
                y: (event.text == Key.UpArrow ? -step : event.text == Key.DownArrow ? step : 0) * 1px,
            };
            let next = {
                start: kind == GradientGestureKind.start-handle ? { x: root.axis.start.x + delta.x, y: root.axis.start.y + delta.y } : root.axis.start,
                end: kind == GradientGestureKind.end-handle || root.radial || root.conic ? { x: root.axis.end.x + delta.x, y: root.axis.end.y + delta.y } : root.axis.end,
            };
            FillSession.move-axis(FillSession.working-fill, root.axis, next);
        }
        return accept;
    }
    key-pressed(event) => {
        if (event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z") {
            FillSession.apply-history(event.modifiers.shift);
            return accept;
        }
        if event.text == Key.Escape {
            if root.dragging {
                root.dragging = false;
                FillSession.restore-gesture(root.original-fill, root.original-rotation);
                FillSession.axis = root.original-axis;
                FillSession.selected-stop = root.original-selected;
            } else {
                FillSession.close-picker(false, true);
            }
            return accept;
        }
        if root.conic && root.has-focus && !root.dragging { return root.handle-key(GradientGestureKind.end-handle, event); }
        return reject;
    }

    if (root.radial && !root.ellipse) || root.conic: Rectangle {
        x: root.start.x - root.axis-length;
        y: root.start.y - root.axis-length;
        width: root.axis-length * 2;
        height: self.width;
        border-radius: self.width / 2;
        border-width: Metrics.border-width;
        border-color: root.style.halo;
    }
    if root.ellipse: Path {
        x: root.start.x - root.axis-length;
        y: root.start.y - root.y-axis-length;
        width: root.axis-length * 2;
        height: root.y-axis-length * 2;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.canvas-angle;
        stroke: root.style.halo;
        stroke-width: Metrics.border-width;
        MoveTo { x: parent.viewbox-width; y: parent.viewbox-height / 2; }
        ArcTo { radius-x: parent.viewbox-width / 2; radius-y: parent.viewbox-height / 2; sweep: true; x: 0; y: parent.viewbox-height / 2; }
        ArcTo { radius-x: parent.viewbox-width / 2; radius-y: parent.viewbox-height / 2; sweep: true; x: parent.viewbox-width; y: parent.viewbox-height / 2; }
    }
    group := Rectangle {
        x: root.start.x;
        y: root.start.y;
        width: root.axis-length;
        height: 0px;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: root.direction;
        pure function window-point(p: Point) -> Point {
            return {
                x: root.absolute-position.x + root.start.x + p.x * cos(root.direction) - p.y * sin(root.direction),
                y: root.absolute-position.y + root.start.y + p.x * sin(root.direction) + p.y * cos(root.direction),
            };
        }
        for segment in (root.conic ? 96 : 0): TouchArea {
            private property <angle> angle: segment * 360deg / 96;
            private property <angle> tangent: self.angle + 90deg;
            width: 2 * 3.141593 * root.axis-length / 96 + 1px;
            height: root.style.endpoint-size;
            x: root.axis-length * cos(self.angle) - self.width / 2;
            y: root.axis-length * sin(self.angle) - self.height / 2;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: self.tangent;
            mouse-cursor: crosshair;
            clicked => { root.focus(); }
            double-clicked => {
                let dx = self.mouse-x - self.width / 2;
                let dy = self.mouse-y - self.height / 2;
                FillSession.add-stop(root.to-local(group.window-point({
                    x: root.axis-length * cos(self.angle) + dx * cos(self.tangent) - dy * sin(self.tangent),
                    y: root.axis-length * sin(self.angle) + dx * sin(self.tangent) + dy * cos(self.tangent),
                })));
            }
        }
        line := Rectangle {
            height: root.style.axis-hit-size;
            Rectangle {
                height: root.style.axis-width;
                background: Style.selection-frame.handle-background;
                drop-shadow-blur: root.style.axis-shadow.blur;
                drop-shadow-color: root.style.axis-shadow.color;
            }
            touch := TouchArea {
                mouse-cursor: grab;
                accessible-role: AccessibleRole.button;
                accessible-label: "Gradient axis";
                pure function pointer() -> Point {
                    return group.window-point({ x: self.mouse-x, y: self.mouse-y - root.style.axis-hit-size / 2 });
                }
                changed pressed => {
                    if self.pressed { root.focus(); root.begin(GradientGestureKind.axis, self.pointer()); }
                    else { root.dragging = false; }
                }
                moved => { if self.pressed { root.drag(self.pointer()); } }
                double-clicked => { if !root.conic { FillSession.add-stop(root.to-local(self.pointer())); } }
            }
        }
        for endpoint in 2: GradientHandle {
            style: root.style;
            private property <GradientGestureKind> gesture-kind: endpoint == 0 ? GradientGestureKind.start-handle : GradientGestureKind.end-handle;
            x: (endpoint == 0 ? 0px : root.axis-length) - self.width / 2;
            endpoint: true;
            color: Colors.on-accent;
            label: root.conic ? (endpoint == 0 ? "Gradient center handle" : "Gradient rotation handle") : root.radial ? (endpoint == 0 ? "Gradient center handle" : "Gradient radius X and rectangle rotation handle") : (endpoint == 0 ? "Gradient start" : "Gradient end");
            window-point(p) => { return group.window-point({ x: self.x + p.x, y: self.y + p.y }); }
            keyboard(event) => { return root.handle-key(self.gesture-kind, event); }
            started(p) => { root.begin(self.gesture-kind, p); }
            dragged(p) => { root.drag(p); }
            finished => { root.dragging = false; }
        }
        for index in root.handle-count: GradientHandle {
            style: root.style;
            private property <float> position: FillSession.working-fill.stops[index].position;
            private property <angle> stop-angle: self.position * 360deg;
            private property <angle> marker-angle: root.conic ? self.stop-angle + (self.position >= 1 ? 90deg : -90deg) : 0deg;
            private property <Point> canonical: FillSession.stop-point(FillSession.working-fill.stops[index].position);
            private property <float> relative: ((self.canonical.x - root.axis.start.x) * (root.axis.end.x - root.axis.start.x)
                + (self.canonical.y - root.axis.start.y) * (root.axis.end.y - root.axis.start.y))
                / max(1px * 1px, (root.axis.end.x - root.axis.start.x) * (root.axis.end.x - root.axis.start.x)
                    + (root.axis.end.y - root.axis.start.y) * (root.axis.end.y - root.axis.start.y));
            x: (root.conic ? root.axis-length * cos(self.stop-angle) : self.relative * root.axis-length) - self.width / 2;
            y: root.conic ? root.axis-length * sin(self.stop-angle) + root.style.stop-offset : root.style.axis-hit-size / 2;
            transform-origin: { x: self.width / 2, y: -root.style.stop-offset };
            transform-rotation: self.marker-angle;
            color: FillSession.working-fill.stops[index].color;
            selected: index == FillSession.selected-stop;
            label: "Gradient stop " + (index + 1);
            focus-generation: root.focus-epoch;
            window-point(p) => {
                let dx = p.x - self.width / 2;
                let dy = p.y + root.style.stop-offset;
                return group.window-point({
                    x: self.x + self.width / 2 + dx * cos(self.marker-angle) - dy * sin(self.marker-angle),
                    y: self.y - root.style.stop-offset + dx * sin(self.marker-angle) + dy * cos(self.marker-angle),
                });
            }
            keyboard(event) => { return root.handle-key(GradientGestureKind.stop, event); }
            selection-requested => { FillSession.selected-stop = index; }
            activated => { FillSession.edit-stop-color(index); }
            started(p) => { root.begin(GradientGestureKind.stop, p); }
            dragged(p) => { root.drag(p); }
            finished => { root.dragging = false; }
        }
    }
    if root.radial: Rectangle {
        x: root.start.x;
        y: root.start.y;
        width: root.y-axis-length;
        height: 0px;
        transform-origin: { x: 0px, y: 0px };
        transform-rotation: root.y-direction;
        Rectangle {
            height: root.style.axis-width;
            background: Style.selection-frame.handle-background;
            drop-shadow-blur: root.style.axis-shadow.blur;
            drop-shadow-color: root.style.axis-shadow.color;
        }
        GradientHandle {
            style: root.style;
            x: root.y-axis-length - self.width / 2;
            endpoint: true;
            color: Colors.on-accent;
            label: "Gradient radius Y handle";
            window-point(p) => {
                return {
                    x: root.absolute-position.x + root.start.x + (self.x + p.x) * cos(root.y-direction) - (self.y + p.y) * sin(root.y-direction),
                    y: root.absolute-position.y + root.start.y + (self.x + p.x) * sin(root.y-direction) + (self.y + p.y) * cos(root.y-direction),
                };
            }
            keyboard(event) => { return root.handle-key(GradientGestureKind.y-radius, event); }
            started(p) => { root.begin(GradientGestureKind.y-radius, p); }
            dragged(p) => { root.drag(p); }
            finished => { root.dragging = false; }
        }
    }
}
