import { ButtonBase } from "../../controls/src/headless.slint";
import { Style, Metrics, Typography, Motion } from "../style.slint";
import { Preview } from "../preview.slint";
import { Springboard, ConnectionState } from "@springboard";
import { EditorScrollView } from "editor-scroll-view.slint";
import { ViewerStyle, ViewerPopup, ViewerButton, ViewerIcon, Chevron, Checkmark } from "viewer-style.slint";
import { FloatingSurface } from "floating-surface.slint";
import { DeviceManager } from "device-manager.slint";

export component ViewerControls inherits Rectangle {
    private property <string> error: Springboard.connection.error != "" ? Springboard.connection.error : Springboard.discovery-error;
    in property <bool> can-start;
    in property <bool> busy;
    width: 252px;
    height: Metrics.control-large;
    border-radius: Metrics.radius-large;
    background: ViewerStyle.pill-rim;

    Rectangle {
        x: Metrics.border-width;
        y: Metrics.border-width;
        width: parent.width - 2 * Metrics.border-width;
        height: parent.height - 2 * Metrics.border-width;
        border-radius: Metrics.radius-large - Metrics.border-width;
        background: ViewerStyle.pill-face;
    }
    launcher := ButtonBase {
        width: parent.width;
        height: parent.height;
        text: @tr("Viewer controls");
        accessible-expanded: popup.is-open;
        enabled: root.can-start || Preview.is-running;
        clicked => { if popup.is-open { popup.close(); } else { popup.show(); } }
        background << Rectangle {
            x: Metrics.border-width;
            y: Metrics.border-width;
            width: parent.width - 2 * Metrics.border-width;
            height: parent.height - 2 * Metrics.border-width;
            background: launcher.hovered && !transport.hovered ? ViewerStyle.pill-hover : transparent;
            animate background { duration: Motion.fast; }
            border-radius: Metrics.radius-large - Metrics.border-width;
            border-width: launcher.has-focus ? Metrics.border-width : 0px;
            border-color: ViewerStyle.accent;
        }
        content << HorizontalLayout {
            padding-left: Metrics.space-medium;
            padding-right: Metrics.control-small + 2 * Metrics.space-regular;
            spacing: Metrics.space-regular;
            cross-axis-alignment: center;
            ViewerIcon { remote: !Preview.local; ink: ViewerStyle.icon; }
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: Preview.endpoint-name;
                    color: ViewerStyle.pill-text;
                    font-size: Typography.control.size;
                    font-weight: FontWeight.medium;
                    overflow: elide;
                }
                Text {
                    text: Preview.status;
                    color: ViewerStyle.muted;
                    font-size: Typography.caption.size;
                    overflow: elide;
                }
            }
        }
    }
    transport := ButtonBase {
        x: parent.width - self.width - Metrics.space-small;
        y: Metrics.space-small;
        width: Metrics.control-small;
        height: Metrics.control-small;
        text: Preview.is-running ? @tr("Stop preview") : @tr("Start preview");
        enabled: Preview.is-running || (root.can-start && !root.busy);
        opacity: Preview.is-running || root.can-start ? 1 : Metrics.disabled-opacity;
        clicked => { if Preview.is-running { Springboard.close(); } else { Preview.run(); } }
        background << Rectangle {
            border-radius: self.height / 2;
            background: ViewerStyle.dial-ring;
            border-width: Metrics.border-width;
            border-color: transport.has-focus ? ViewerStyle.accent : Preview.connected ? ViewerStyle.connected : ViewerStyle.border;
            Rectangle {
                x: Metrics.border-width;
                y: Metrics.border-width;
                width: parent.width - 2 * Metrics.border-width;
                height: parent.height - 2 * Metrics.border-width;
                border-radius: self.height / 2;
                background: transport.hovered ? ViewerStyle.dial-hover : ViewerStyle.dial-face;
                border-width: Metrics.border-width;
                border-color: ViewerStyle.dial-border;
            }
        }
        content << Rectangle {
            Image {
                width: Metrics.icon-small;
                height: Metrics.icon-small;
                source: Preview.is-running ? @image-url("../assets/lucide/square-filled.svg") : @image-url("../assets/lucide/play-filled.svg");
                colorize: ViewerStyle.accent;
            }
        }
    }

    popup := ViewerPopup {
        anchor-width: root.width;
        anchor-height: root.height;
        label: @tr("Viewer options");
        panel-height: options.preferred-height;
        options := VerticalLayout {
            width: popup.panel-width;
            height: self.preferred-height;
            padding: Metrics.space-medium;
            spacing: Metrics.space-regular;
            selector := ViewerButton {
                text: @tr("Choose viewer");
                accessible-role: combobox;
                accessible-value: Preview.endpoint-name;
                accessible-expanded: viewers.is-open;
                clicked => { viewers.show(); }
                body << HorizontalLayout {
                    padding-left: Metrics.space-medium;
                    padding-right: Metrics.space-medium;
                    spacing: Metrics.space-medium;
                    cross-axis-alignment: center;
                    ViewerIcon { remote: !Preview.local; }
                    Text {
                        horizontal-stretch: 1;
                        text: Preview.endpoint-name;
                        color: ViewerStyle.ink;
                        font-size: Typography.body.size;
                        font-weight: FontWeight.medium;
                        overflow: elide;
                    }
                    Chevron { transform-rotation: viewers.is-open ? 180deg : 0deg; }
                }
                viewers := PopupWindow {
                    close-policy: close-on-click-outside;
                    y: selector.height + Metrics.space-tight;
                    width: selector.width;
                    height: min(Style.combo-menu.max-height, Springboard.saved-endpoints.length * Style.combo-menu.row-height + 2 * Metrics.space-small);
                    FloatingSurface {
                        background: Style.combo-menu.background;
                        border-color: Style.combo-menu.border;
                        border-radius: Style.field.radius;
                    }
                    EditorScrollView {
                        x: Metrics.space-small;
                        y: Metrics.space-small;
                        width: parent.width - 2 * Metrics.space-small;
                        height: parent.height - 2 * Metrics.space-small;
                        content-width: self.width;
                        content-height: Springboard.saved-endpoints.length * Style.combo-menu.row-height;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        VerticalLayout {
                            width: parent.width;
                            for endpoint[index] in Springboard.saved-endpoints: option := ButtonBase {
                                width: parent.width;
                                height: Style.combo-menu.row-height;
                                text: index == 0 ? Preview.local-name : endpoint.name;
                                enabled: endpoint.unavailable-reason == "";
                                accessible-description: endpoint.unavailable-reason;
                                clicked => {
                                    if !Preview.is-running { Preview.run(); }
                                    Springboard.select-endpoint(index);
                                    viewers.close();
                                }
                                background << Rectangle {
                                    border-radius: Style.field.radius;
                                    border-width: option.has-focus ? Metrics.border-width : 0px;
                                    border-color: ViewerStyle.accent;
                                    background: option.hovered ? ViewerStyle.selected-hover : Springboard.selected-endpoint-index == index ? ViewerStyle.selected : transparent;
                                }
                                content << HorizontalLayout {
                                    padding-left: Metrics.space-regular;
                                    padding-right: Metrics.space-regular;
                                    spacing: Metrics.space-medium;
                                    cross-axis-alignment: center;
                                    ViewerIcon { remote: index > 0; ink: option.enabled ? ViewerStyle.strong-icon : ViewerStyle.unavailable; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: option.text;
                                        color: option.enabled ? ViewerStyle.ink : ViewerStyle.unavailable;
                                        font-size: Typography.control.size;
                                        overflow: elide;
                                    }
                                    if !option.enabled: Text {
                                        max-width: parent.width / 2;
                                        text: endpoint.unavailable-reason;
                                        color: ViewerStyle.unavailable;
                                        font-size: Typography.caption.size;
                                        overflow: elide;
                                        Tooltip { text: @markdown("\{endpoint.unavailable-reason}"); }
                                    }
                                    if option.enabled && Springboard.selected-endpoint-index == index: Checkmark { }
                                }
                            }
                        }
                    }
                }
            }
            device-manager := ViewerButton {
                height: Metrics.control-medium;
                ghost: true;
                text: @tr("Manage devices...");
                clicked => { popup.close(); manager.show(); }
                body << HorizontalLayout {
                    padding-left: Metrics.space-medium;
                    padding-right: Metrics.space-medium;
                    Text {
                        text: device-manager.text;
                        color: ViewerStyle.action-text;
                        font-size: Typography.body.size;
                        vertical-alignment: center;
                    }
                }
            }
            if root.error != "": Text {
                text: root.error;
                color: ViewerStyle.muted;
                font-size: Typography.caption.size;
                overflow: elide;
            }
        }
    }
    manager := ViewerPopup {
        changed is-open => { if !self.is-open { Springboard.cancel-pairing(); } }
        anchor-width: root.width;
        anchor-height: root.height;
        label: @tr("Device manager");
        panel-height: 331px;
        DeviceManager {
            width: manager.panel-width;
            height: manager.panel-height;
            closed => { manager.close(); }
        }
    }
    private property <bool> pairing-required: Springboard.connection.state == ConnectionState.PairingRequired
        || Springboard.connection.state == ConnectionState.UnpairedConfirmationRequired;
    changed pairing-required => { if root.pairing-required { popup.close(); manager.show(); } }
}
