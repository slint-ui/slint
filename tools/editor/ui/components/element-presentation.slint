import { ElementKind } from "../api.slint";
import { EditorTreeIcons } from "editor-tree-icons.slint";
import { Icons } from "icons.slint";

export struct ElementPresentation {
    icon: image,
    preview-size: Size,
    corner-radius: length,
    show-thumbnail: bool,
    label: string,
}

// Primitive identity and grouping are defined in preview/element_catalog.rs.
export global ElementVisuals {
    pure function primitive(icon: image, label: string) -> ElementPresentation {
        return {
            icon: icon,
            preview-size: { width: 160px, height: 96px },
            corner-radius: 0px,
            show-thumbnail: false,
            label: label,
        };
    }

    public pure function for-kind(kind: ElementKind) -> ElementPresentation {
        if kind == ElementKind.rectangle {
            return {
                icon: EditorTreeIcons.rectangle,
                preview-size: { width: 160px, height: 64px },
                corner-radius: 8px,
                show-thumbnail: false,
                label: "Rectangle",
            };
        }
        if kind == ElementKind.text {
            return {
                icon: EditorTreeIcons.text,
                preview-size: {},
                corner-radius: 8px,
                show-thumbnail: false,
                label: "Text",
            };
        }
        if kind == ElementKind.styled-text {
            return {
                icon: EditorTreeIcons.styled-text,
                preview-size: {},
                corner-radius: 8px,
                show-thumbnail: false,
                label: "StyledText",
            };
        }
        if kind == ElementKind.image {
            return {
                icon: Icons.image,
                preview-size: { width: 160px, height: 96px },
                corner-radius: 16px,
                show-thumbnail: true,
                label: "Image",
            };
        }
        if kind == ElementKind.touch-area {
            return {
                icon: EditorTreeIcons.touch-area,
                preview-size: { width: 160px, height: 96px },
                corner-radius: 0px,
                show-thumbnail: false,
                label: "TouchArea",
            };
        }
        if kind == ElementKind.flickable {
            return root.primitive(EditorTreeIcons.flickable, "Flickable");
        }
        if kind == ElementKind.swipe-gesture-handler {
            return root.primitive(EditorTreeIcons.swipe-gesture-handler, "SwipeGestureHandler");
        }
        if kind == ElementKind.scale-rotate-gesture-handler {
            return root.primitive(EditorTreeIcons.scale-rotate-gesture-handler, "ScaleRotateGestureHandler");
        }
        if kind == ElementKind.drag-area {
            return root.primitive(EditorTreeIcons.drag-area, "DragArea");
        }
        if kind == ElementKind.drop-area {
            return root.primitive(EditorTreeIcons.drop-area, "DropArea");
        }
        if kind == ElementKind.focus-scope {
            return root.primitive(EditorTreeIcons.focus-scope, "FocusScope");
        }
        if kind == ElementKind.text-input {
            return root.primitive(EditorTreeIcons.text-input, "TextInput");
        }
        if kind == ElementKind.horizontal-layout {
            return root.primitive(EditorTreeIcons.horizontal-layout, "HorizontalLayout");
        }
        if kind == ElementKind.vertical-layout {
            return root.primitive(EditorTreeIcons.vertical-layout, "VerticalLayout");
        }
        if kind == ElementKind.grid-layout {
            return root.primitive(EditorTreeIcons.grid-layout, "GridLayout");
        }
        if kind == ElementKind.flexbox-layout {
            return root.primitive(EditorTreeIcons.flexbox-layout, "FlexboxLayout");
        }
        if kind == ElementKind.window-move-area {
            return root.primitive(EditorTreeIcons.window-move-area, "WindowMoveArea");
        }
        if kind == ElementKind.widget {
            return {
                icon: EditorTreeIcons.default-item,
                preview-size: { width: 120px, height: 32px },
                corner-radius: 4px,
                show-thumbnail: false,
                label: "Widget",
            };
        }
        return {
            icon: EditorTreeIcons.default-item,
            preview-size: { width: 96px, height: 48px },
            corner-radius: 8px,
            show-thumbnail: false,
            label: "",
        };
    }
}
