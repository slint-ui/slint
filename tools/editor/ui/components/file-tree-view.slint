import { Style, Colors, Metrics, Typography, TreeStyle } from "../style.slint";
import { EditorInput } from "editor-input.slint";
import { FileTreeIcons } from "file-tree-icons.slint";
import { Icons } from "icons.slint";

import { Api, FileTreeNode, FileTreeNodeKind } from "../api.slint";
import { Project } from "../project.slint";
import { Diagnostics, FileDiagnosticSummary } from "../diagnostics.slint";
import { ListView } from "std-widgets.slint";
import { EditorScrollIndicators } from "editor-scroll-view.slint";

component FileTreeRow inherits Rectangle {
    in property <TreeStyle> style: Style.tree;
    in property <FileTreeNode> node;
    in property <string> display-label: root.node.label;
    in property <bool> expanded: root.node.is-expanded;
    in property <bool> keyboard-current: false;
    in property <bool> editing: false;
    in property <length> rename-right-extension;
    in-out property <string> rename-name;
    in property <string> rename-error;

    property <bool> folder: node.kind == FileTreeNodeKind.folder;
    private property <bool> asset: node.kind == FileTreeNodeKind.image || node.kind == FileTreeNodeKind.font;
    private property <length> row-height: root.asset ? 44px : root.style.row.height;
    private property <length> icon-size: root.asset ? 32px : root.style.row.icon-size;
    property <color> error-color: Colors.danger;
    private property <FileDiagnosticSummary> diagnostic-summary: Diagnostics.file-diagnostics(node.path);
    private property <string> diagnostic-description: diagnostic-summary.error-count == 0 && diagnostic-summary.warning-count == 0 ? "" : "\{diagnostic-summary.error-count} errors, \{diagnostic-summary.warning-count} warnings in the active preview";

    callback row-focus-requested(string);
    callback rename-started(string);
    callback rename-finished();
    callback rename-submitted();

    function focus-if-current() {
        if root.keyboard-current && !root.editing {
            row-focus.focus();
        }
    }

    init => {
        focus-if-current();
    }

    changed keyboard-current => {
        focus-if-current();
    }

    height: root.row-height + (rename-error == "" ? 0px : root.style.row.height);
    horizontal-stretch: 1;
    border-radius: root.style.row.radius;
    background: node.is-selected || row-focus.has-focus || root.keyboard-current ? root.style.row.selected-background : touch.has-hover ? root.style.row.hover-background : transparent;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.node.path;
    accessible-description: root.diagnostic-description;
    accessible-item-selectable: !root.folder;
    accessible-item-selected: root.node.is-selected;
    accessible-expanded: root.folder && root.expanded;
    accessible-action-default => {
        root.focus-row();
        root.activate();
    }
    accessible-action-expand => {
        if root.folder {
            Api.file-tree-toggle(root.node.path);
        }
    }

    function activate() {
        if root.folder {
            Api.file-tree-toggle(root.node.path);
        } else {
            Api.file-tree-select(root.node.path);
        }
    }

    function focus-row() {
        root.row-focus-requested(root.node.path);
        row-focus.focus();
    }

    function begin-rename() {
        if !root.folder {
            root.rename-name = root.node.label;
            root.rename-started(root.node.path);
        }
    }

    function open-in-file-manager-name() -> string {
        if (Platform.os == OperatingSystemType.macos) {
            return @tr("Reveal in Finder");
        }
        if (Platform.os == OperatingSystemType.windows) {
            return @tr("Reveal in File Explorer");
        }
        return @tr("Open Containing Folder");
    }

    row-focus := FocusScope {
        focus-on-click: false;

        key-pressed(event) => {
            if !root.folder && ((Platform.os == OperatingSystemType.macos && event.text == Key.Return)
                    || (Platform.os != OperatingSystemType.macos && event.text == Key.F2)) {
                root.begin-rename();
                return accept;
            }
            if Platform.os != OperatingSystemType.macos && event.text == Key.Return {
                root.activate();
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            cross-axis-alignment: center;
            padding-left: root.style.row.padding-inline;
            padding-right: root.style.row.padding-inline;

            Rectangle {
                horizontal-stretch: 0;
                width: root.folder ? root.style.row.hit-size : 0px;
                height: root.style.row.height;

                Image {
                    visible: root.folder && root.node.has-children;
                    width: Metrics.icon-small;
                    height: Metrics.icon-small;
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    source: root.expanded ? Icons.chevron-down : Icons.chevron-right;
                    colorize: root.style.row.muted;
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: root.folder ? 0px : root.style.row.gap;
                cross-axis-alignment: center;
                padding-right: root.style.row.padding-inline;
                min-height: root.style.row.height;

                Rectangle {
                    horizontal-stretch: 0;
                    width: root.folder
                        ? root.diagnostic-summary.error-count > 0 || root.diagnostic-summary.warning-count > 0 ? root.style.row.icon-size : 0px
                        : root.icon-size;
                    height: root.icon-size;
                    clip: root.asset;
                    border-radius: Metrics.radius-small;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        visible: root.node.kind == FileTreeNodeKind.file;
                        source: FileTreeIcons.file-slint;
                        colorize: root.style.row.muted;
                    }
                    if root.node.kind == FileTreeNodeKind.image: Image {
                        width: parent.width;
                        height: parent.height;
                        source: Api.file-tree-thumbnail(root.node.path);
                        image-fit: cover;
                    }
                    if root.node.kind == FileTreeNodeKind.font: Text {
                        text: "Aa";
                        color: Colors.foreground;
                        font-size: 20px;
                    }
                    if root.diagnostic-summary.error-count > 0 || root.diagnostic-summary.warning-count > 0: Rectangle {
                        x: root.folder ? (parent.width - self.width) / 2 : parent.width - self.width + 2px;
                        y: parent.height - self.height + 2px;
                        width: 11px;
                        height: 11px;
                        border-radius: self.width / 2;
                        background: root.style.row.selected-background;
                        Image {
                            source: Icons.alert;
                            width: parent.width;
                            height: parent.height;
                            colorize: root.diagnostic-summary.error-count > 0 ? Colors.danger : Colors.warning;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: root.row-height;

                    VerticalLayout {
                        alignment: center;
                        spacing: Metrics.space-tight;
                        visible: !root.editing;
                        Text {
                            text: root.display-label;
                            color: root.folder ? Colors.muted : root.style.row.foreground;
                            font-size: root.style.row.font-size;
                            overflow: elide;
                        }
                        if root.asset: Text {
                            text: root.node.kind == FileTreeNodeKind.font ? @tr("Font") : @tr("Image");
                            color: Colors.muted;
                            font-size: Typography.caption.size;
                        }
                    }
                }
            }
        }

        if root.editing: input := EditorInput {
            x: root.style.row.padding-inline
                + root.icon-size
                + root.style.row.gap;
            y: (root.row-height - Style.field.height) / 2;
            width: root.width + root.rename-right-extension - self.x;
            value: root.rename-name;
            live-edit: true;
            select-all-on-focus: false;
            accessible-name: @tr("Rename {}", root.node.label);
            border-color: root.rename-error == "" ? self.paint.border : root.error-color;
            init => {
                self.focus-input();
                self.select-range(0, root.node.rename-selection-end);
            }
            accepted(value) => { root.rename-name = value; return true; }
            focus-lost => { if root.editing { root.rename-submitted(); } }
            keyboard(event) => {
                if event.text == Key.Return {
                    root.rename-submitted();
                    return accept;
                }
                if event.text == Key.Escape {
                    root.rename-finished();
                    row-focus.focus();
                    return accept;
                }
                return reject;
            }
        }
    }

    if root.rename-error != "": Text {
        x: root.style.row.hit-size + root.style.row.icon-size;
        y: root.row-height;
        width: parent.width - self.x;
        height: root.style.row.height;
        text: root.rename-error;
        color: root.error-color;
        font-size: root.style.row.font-size;
        overflow: elide;
    }

    context-menu := ContextMenuArea {
        enabled: false;

        Menu {
            MenuItem {
                title: @tr("Rename");
                activated => {
                    root.focus-row();
                    root.begin-rename();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Copy Path");
                activated => { Api.copy-file-path(root.node.path); }
            }
            MenuSeparator {}
            MenuItem {
                title: @tr("Open Slint File");
                enabled: root.node.is-slint-file;
                activated => { Api.open-file(root.node.path); }
            }
            MenuSeparator {}
            MenuItem {
                title: open-in-file-manager-name();
                activated => { Api.open-file-manager(root.node.path); }
            }
        }

        touch := TouchArea {
            enabled: !root.editing;
            clicked => {
                root.focus-row();
                root.activate();
            }
            pointer-event(event) => {
                if !root.folder && event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.focus-row();
                    context-menu.show({ x: self.mouse-x, y: self.mouse-y });
                }
            }
        }
    }
    Tooltip {
        text: root.diagnostic-description != ""
            ? @markdown("\{root.diagnostic-description}")
            : @markdown("\{root.node.path}");
    }
}

export component FileTreeView inherits Rectangle {
    in property <TreeStyle> style: Style.tree;
    in property <length> rename-right-extension;
    in property <bool> assets;
    in property <string> query;
    private property <string> focused-row-key: "";
    private property <string> editing-row-key: "";
    private property <string> rename-name: "";
    private property <string> rename-error: "";

    changed query => { root.focused-row-key = ""; root.submit-rename(); }
    changed assets => { root.focused-row-key = ""; root.submit-rename(); }

    horizontal-stretch: 1;
    accessible-role: AccessibleRole.tree;
    accessible-label: @tr("Files");

    tree := ListView {
        width: parent.width;
        height: parent.height;
        accessible-role: AccessibleRole.none;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;

        for row in Project.file-tree: Rectangle {
            height: !root.row-visible(row) ? 0px
                : (row.kind == FileTreeNodeKind.image || row.kind == FileTreeNodeKind.font ? 44px : root.style.row.height)
                + (row.path == root.editing-row-key && root.rename-error != "" ? root.style.row.height : 0px);
            if root.row-visible(row): FileTreeRow {
                style: root.style;
                width: tree.visible-width - root.rename-right-extension;
                node: row;
                display-label: row.kind == FileTreeNodeKind.folder ? root.relative-path(row).replace-all("/", " / ") : row.label;
                expanded: root.query != "" || row.is-expanded;
                keyboard-current: row.path == root.focused-row-key;
                editing: row.path == root.editing-row-key;
                rename-right-extension: root.rename-right-extension;
                rename-name <=> root.rename-name;
                rename-error: row.path == root.editing-row-key ? root.rename-error : "";
                row-focus-requested(path) => {
                    if root.editing-row-key != "" && root.editing-row-key != path {
                        root.submit-rename();
                    }
                    root.focused-row-key = path;
                }
                rename-started(path) => {
                    root.rename-error = "";
                    root.editing-row-key = path;
                }
                rename-finished => {
                    root.rename-error = "";
                    root.editing-row-key = "";
                }
                rename-submitted => { root.submit-rename(); }
            }
        }
    }

    scroll-indicators := EditorScrollIndicators {
        content-width: tree.content-width;
        content-height: tree.content-height;
        visible-width: tree.visible-width;
        visible-height: tree.visible-height;
        content-x <=> tree.content-x;
        content-y <=> tree.content-y;
        scrolled => { tree.scrolled(); }
    }

    function submit-rename() {
        if root.editing-row-key == "" {
            return;
        }
        root.rename-error = Api.file-tree-rename(root.editing-row-key, root.rename-name);
        if root.rename-error == "" {
            root.editing-row-key = "";
        }
    }

    pure function relative-path(row: FileTreeNode) -> string {
        let path = row.path.replace-all("\\", "/");
        let base = Project.file-tree[0].path.replace-all("\\", "/");
        return row.path == Project.file-tree[0].path ? row.label : path.replace-all(base + "/", "");
    }

    pure function file-matches(row: FileTreeNode) -> bool {
        let kind-matches = root.assets ? row.kind == FileTreeNodeKind.image || row.kind == FileTreeNodeKind.font : row.is-slint-file;
        let path = root.relative-path(row).to-lowercase();
        return kind-matches && (root.query == "" || path.replace-all(root.query, "") != path);
    }

    pure function row-visible(row: FileTreeNode) -> bool {
        return row.kind == FileTreeNodeKind.folder
            ? Project.file-tree.any((file) => file.parent-path == row.path && root.file-matches(file))
            : root.file-matches(row) && (root.query != "" || Project.file-tree.any((folder) => folder.path == row.parent-path && folder.is-expanded));
    }

    if !Project.file-tree.any((row) => root.file-matches(row)): Text {
        text: @tr("No Results");
        color: Colors.muted;
        font-size: Typography.control.size;
    }
}
