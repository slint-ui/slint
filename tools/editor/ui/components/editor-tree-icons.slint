export global EditorTreeIcons {
    out property <image> default-item: @image-url("../assets/lucide/panels-top-left.svg");
    out property <image> rectangle: @image-url("../assets/lucide/square.svg");
    out property <image> touch-area: @image-url("../assets/lucide/pointer.svg");
    out property <image> text: @image-url("../assets/lucide/type.svg");
    out property <image> styled-text: @image-url("../assets/lucide/a-large-small.svg");
    out property <image> flickable: @image-url("../assets/lucide/hand.svg");
    out property <image> swipe-gesture-handler: @image-url("../assets/lucide/move-horizontal.svg");
    out property <image> scale-rotate-gesture-handler: @image-url("../assets/lucide/scaling.svg");
    out property <image> drag-area: @image-url("../assets/lucide/grip.svg");
    out property <image> drop-area: @image-url("../assets/lucide/square-dashed-mouse-pointer.svg");
    out property <image> focus-scope: @image-url("../assets/lucide/focus.svg");
    out property <image> text-input: @image-url("../assets/lucide/text-cursor-input.svg");
    out property <image> horizontal-layout: @image-url("../assets/lucide/columns-3.svg");
    out property <image> vertical-layout: @image-url("../assets/lucide/rows-3.svg");
    out property <image> grid-layout: @image-url("../assets/lucide/grid-2x2.svg");
    out property <image> flexbox-layout: @image-url("../assets/lucide/layout-grid.svg");
    out property <image> window-move-area: @image-url("../assets/lucide/move.svg");
}
