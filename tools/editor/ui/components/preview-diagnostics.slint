import { ButtonBase } from "../../controls/src/headless.slint";
import { Api } from "../api.slint";
import { Diagnostics, Diagnostic, PreviewAvailability } from "../diagnostics.slint";
import { Style, Colors, Metrics, Typography, Theme, ButtonStyle, PaintStyle, PreviewDiagnosticsStyle } from "../style.slint";
import { DiagnosticBadge } from "icons.slint";
import { EditorScrollView } from "editor-scroll-view.slint";
import { FloatingSurface } from "floating-surface.slint";

component DiagnosticAction inherits ButtonBase {
    in property <ButtonStyle> style: Style.compact-button;
    in property <bool> quiet;
    private property <PaintStyle> paint: !root.enabled ? root.style.appearance.disabled
        : root.pressed ? root.style.appearance.pressed
        : root.hovered ? root.style.appearance.hover : root.style.appearance.normal;
    height: root.style.height;
    background << Rectangle {
        background: root.quiet && !root.hovered ? transparent : root.paint.background;
        border-color: root.focus-visible ? Colors.focus : root.quiet ? transparent : root.paint.border;
        border-width: root.style.border-width;
        border-radius: root.style.radius;
    }
    content << HorizontalLayout {
        padding-left: root.style.padding-inline;
        padding-right: root.style.padding-inline;
        Text {
            text: root.text;
            color: root.paint.foreground;
            font-size: root.style.text.size;
            font-weight: root.style.text.weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component PreviewDiagnostics inherits Rectangle {
    in property <PreviewDiagnosticsStyle> style: Style.preview-diagnostics;
    private property <bool> empty: Diagnostics.preview-availability == PreviewAvailability.NoComponent;
    private property <bool> stale: Diagnostics.preview-availability == PreviewAvailability.Stale;
    private property <bool> warnings-open;
    private property <bool> advanced-open;
    private property <string> file-name: Diagnostics.file-name;
    changed file-name => { root.advanced-open = false; }

    if !Diagnostics.preview-editable: TouchArea { }

    if Diagnostics.preview-status-visible: Rectangle {
        background: root.style.veil;

        card := FloatingSurface {
            width: max(0px, min(root.style.max-width, root.width - 2 * root.style.margin));
            height: min(content.preferred-height, max(0px, root.height - 2 * root.style.margin));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: root.style.radius;
            accessible-role: AccessibleRole.region;
            accessible-label: root.empty ? @tr("No component to preview") : root.stale ? @tr("Stale preview") : @tr("Preview unavailable");

            content := VerticalLayout {
                padding: root.style.padding;
                spacing: Metrics.space-large;
                HorizontalLayout {
                    spacing: Metrics.space-medium;
                    cross-axis-alignment: center;
                    if !root.empty: Rectangle {
                        width: 32px;
                        height: 34px;
                        Image {
                            x: 0px; y: 0px;
                            source: @image-url("../assets/primer-file-code.svg");
                            width: 27px;
                            height: 28px;
                            colorize: root.style.muted;
                        }
                        DiagnosticBadge {
                            x: 18px; y: 18px;
                            width: 16px; height: 16px;
                            icon-inset: 2px;
                            background: Style.floating-surface.background;
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.empty ? @tr("Nothing to preview") : root.file-name;
                        color: root.style.foreground;
                        font-size: Typography.heading.size;
                        font-weight: 600;
                        wrap: char-wrap;
                    }
                }
                Text {
                    text: root.empty
                        ? @tr("No component is available for this preview. Select another file or component to continue.")
                        : @tr("This file has an error and can’t be displayed.");
                    color: root.style.muted;
                    font-size: Typography.body.size;
                    wrap: word-wrap;
                }
                if !root.empty: HorizontalLayout {
                    spacing: Metrics.space-regular;
                    cross-axis-alignment: center;
                    if Diagnostics.can-undo-change && Api.undo-enabled: DiagnosticAction {
                        text: @tr("Undo change");
                        style: Style.primary-button;
                        clicked => { Api.undo(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    DiagnosticAction {
                        text: @tr("Advanced…");
                        quiet: true;
                        accessible-label: @tr("Toggle advanced error details");
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                }
                if !root.empty && root.advanced-open: Rectangle {
                    height: advanced.preferred-height;
                    background: Theme.surfaces.recessed;
                    border-radius: Metrics.radius-medium;
                    advanced := VerticalLayout {
                        padding: Metrics.space-large;
                        spacing: Metrics.space-medium;
                        Text {
                            text: @tr("Error details");
                            color: root.style.foreground;
                            font-size: Typography.control.size;
                            font-weight: 600;
                        }
                        details := EditorScrollView {
                            height: min(errors.preferred-height, root.style.max-details-height, max(40px, root.height - 320px));
                            content-width: self.width;
                            content-height: errors.preferred-height;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            errors := VerticalLayout {
                                width: details.width;
                                spacing: Metrics.space-medium;
                                for index in min(3, Diagnostics.errors.length): VerticalLayout {
                                    private property <Diagnostic> diagnostic: Diagnostics.errors[index];
                                    spacing: Metrics.space-small;
                                    Text {
                                        text: Diagnostics.format-location(diagnostic);
                                        color: root.style.muted;
                                        font-size: Typography.caption.size;
                                        wrap: char-wrap;
                                    }
                                    Text {
                                        text: diagnostic.message;
                                        color: root.style.foreground;
                                        font-size: Typography.control.size;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        if Diagnostics.errors.length > 3: Text {
                            text: "\{Diagnostics.errors.length - 3} more errors. Copy diagnostics to see all messages.";
                            color: root.style.muted;
                            font-size: Typography.control.size;
                            wrap: word-wrap;
                        }
                        FlexboxLayout {
                            spacing: Metrics.space-regular;
                            DiagnosticAction {
                                text: @tr("Copy diagnostics");
                                accessible-label: @tr("Copy preview diagnostics");
                                clicked => { Diagnostics.copy-to-clipboard(); }
                            }
                            DiagnosticAction {
                                text: @tr("Open in editor");
                                clicked => { Diagnostics.open-in-editor(); }
                            }
                        }
                    }
                }
            }
        }
    }

    if !Diagnostics.preview-status-visible && Diagnostics.warnings.length > 0: Rectangle {
        width: min(root.style.max-width, root.width - 2 * root.style.margin);
        height: warning-layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - root.style.margin;
        background: root.style.background;
        border-width: Metrics.border-width;
        border-color: Colors.warning.with-alpha(0.6);
        border-radius: root.style.radius;
        accessible-role: AccessibleRole.region;
        accessible-label: @tr("Preview warnings");
        accessible-description: @tr("Warnings do not prevent editing");
        warning-layout := VerticalLayout {
            padding: Metrics.space-medium;
            spacing: Metrics.space-small;
            HorizontalLayout {
                spacing: Metrics.space-small;
                cross-axis-alignment: center;
                Text {
                    horizontal-stretch: 1;
                    text: "\{Diagnostics.warnings.length} \{Diagnostics.warnings.length == 1 ? "warning" : "warnings"} · Preview up to date";
                    color: Colors.warning;
                    font-size: Typography.body.size;
                    wrap: word-wrap;
                }
                DiagnosticAction {
                    text: root.warnings-open ? @tr("Hide") : @tr("Details");
                    accessible-label: @tr("Toggle preview warning details");
                    clicked => { root.warnings-open = !root.warnings-open; }
                }
                DiagnosticAction {
                    text: @tr("Copy");
                    accessible-label: @tr("Copy preview diagnostics");
                    clicked => { Diagnostics.copy-to-clipboard(); }
                }
            }
            if root.warnings-open: warning-details := EditorScrollView {
                height: min(warnings.preferred-height, root.style.max-details-height);
                content-width: self.width;
                content-height: warnings.preferred-height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                warnings := VerticalLayout {
                    width: warning-details.width;
                    spacing: Metrics.space-small;
                    for index in min(3, Diagnostics.warnings.length): Text {
                        private property <Diagnostic> diagnostic: Diagnostics.warnings[index];
                        text: Diagnostics.format-location(diagnostic) + "\n" + diagnostic.message;
                        color: root.style.foreground;
                        font-size: Typography.body.size;
                        wrap: word-wrap;
                    }
                    if Diagnostics.warnings.length > 3: Text {
                        text: "\{Diagnostics.warnings.length - 3} more warnings. Copy diagnostics to see all messages.";
                        color: root.style.muted;
                        font-size: Typography.body.size;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
