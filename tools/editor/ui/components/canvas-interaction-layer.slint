import { Style } from "../style.slint";
import { FillSession } from "inspector/fill-session.slint";
import { Api, Hover, PropertyValueKind, SelectionRectangle } from "../api.slint";
import { EditorAngles, EditorCursors, EditorMetrics } from "common.slint";
import { BorderRadiusFrame } from "border-radius-frame.slint";
import { MoveResizeFrame } from "move-resize-frame.slint";

component CanvasValueTooltip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> suffix;
    in property <string> value-label;
    in property <Point> pointer-position;

    x: root.pointer-position.x - self.width - Style.canvas.tooltip-offset;
    y: root.pointer-position.y - self.height - Style.canvas.tooltip-offset;
    width: tip.width + 2 * Style.canvas.tooltip-padding-inline;
    height: tip.height + 2 * Style.canvas.tooltip-padding-block;
    border-radius: Style.controls.row-radius;
    background: Style.colors.accent-strong;
    drop-shadow-blur: Style.shadows.tooltip.blur;
    drop-shadow-offset-y: Style.shadows.tooltip.offset-y;
    drop-shadow-color: Style.shadows.tooltip.color;
    accessible-role: AccessibleRole.text;
    accessible-label: root.value-label;
    accessible-value: root.value;

    tip := Text {
        text: root.label + " " + root.value + root.suffix;
        color: Style.colors.action-text;
        font-size: Style.typography.control.size;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component SelectedCanvasFrame inherits Rectangle {
    in property <SelectionRectangle> selection;
    in property <bool> primary;
    in property <bool> shift-pressed;
    in property <bool> interaction-disabled;
    callback pointer-hovered(Point);
    callback double-clicked();

    private property <bool> geometry-drag-active;
    private property <Point> geometry-drag-position;
    private property <Size> geometry-drag-size;
    private property <bool> rotation-active;
    private property <angle> pending-rotation;
    private property <bool> radius-drag-active;

    function current-corner-radius(property-name: string) -> length {
        let corner = Api.current-property-value-data(property-name);
        return corner.code != ""
            ? corner.value-float * 1px
            : Api.current-property-value-data("border-radius").value-float * 1px;
    }

    function has-independent-corner-radii() -> bool {
        return Api.current-property-value-data("border-top-left-radius").code != ""
            || Api.current-property-value-data("border-top-right-radius").code != ""
            || Api.current-property-value-data("border-bottom-right-radius").code != ""
            || Api.current-property-value-data("border-bottom-left-radius").code != "";
    }

    function preview-geometry(position: Point, size: Size) {
        root.geometry-drag-active = true;
        root.geometry-drag-position = position;
        root.geometry-drag-size = size;
        // Push live geometry so the previewed element follows the drag through
        // debug-hook overrides without writing to disk.
        Api.override-selected-element-geometry(
            position.x,
            position.y,
            size.width,
            size.height,
        );
    }

    function finish-interaction() {
        if root.geometry-drag-active {
            Api.persist-selected-element-geometry();
        }
        if root.rotation-active {
            Api.selected-element-rotate(root.pending-rotation);
        }
        if root.radius-drag-active {
            Api.persist-selected-element-border-radius();
        }
        root.geometry-drag-active = false;
        root.rotation-active = false;
        root.radius-drag-active = false;
    }

    frame := BorderRadiusFrame {
        x: root.selection.x;
        y: root.selection.y;
        width: root.selection.width;
        height: root.selection.height;
        rotation: root.selection.angle;
        accessible-prefix: Api.current-element.type-name;
        active: !root.interaction-disabled;
        shift-pressed: root.shift-pressed;
        show-resize-handles: root.primary;
        show-rotation-handles: root.primary;
        enable-border-radius-edits: root.primary && Api.current-element.type-name == "Rectangle";
        independent-corner-radii: root.has-independent-corner-radii();
        top-left-radius: root.current-corner-radius("border-top-left-radius");
        top-right-radius: root.current-corner-radius("border-top-right-radius");
        bottom-right-radius: root.current-corner-radius("border-bottom-right-radius");
        bottom-left-radius: root.current-corner-radius("border-bottom-left-radius");
        // Only allow move/resize for elements that have geometry outside a layout, and whose
        // frame describes them.
        resizable: root.primary && Api.selection.is-resizable && root.selection.describes-element;
        moveable: root.primary && Api.selection.is-moveable && root.selection.describes-element;
        accessible-role: AccessibleRole.region;
        accessible-label: "Selected " + Api.current-element.type-name;

        double-clicked => {
            if root.primary {
                root.double-clicked();
            }
        }

        rotated-to(rotation) => {
            root.rotation-active = true;
            root.pending-rotation = rotation;
            Api.override-selected-element-rotation(rotation);
        }
        control-hovered => { Hover.element = {}; }
        move-press-started(position) => { Hover.element = {}; }
        interaction-started => {
            root.rotation-active = false;
            root.radius-drag-active = false;
            Hover.element = {};
        }
        pointer-moved(position) => {
            if !self.move-pressed {
                root.pointer-hovered(position);
            }
        }
        radius-changed(corner, radius, single-corner) => {
            root.radius-drag-active = true;
            Api.override-selected-element-border-radius(corner, radius, single-corner);
        }
        resized-to(corner, position, size) => {
            root.preview-geometry(position, size);
        }
        moved-to(position) => {
            root.preview-geometry(position, {
                width: root.selection.width,
                height: root.selection.height,
            });
        }
        interaction-ended => {
            root.finish-interaction();
        }
    }

    states [
        geometry-dragging when root.geometry-drag-active: {
            frame.x: root.geometry-drag-position.x;
            frame.y: root.geometry-drag-position.y;
            frame.width: root.geometry-drag-size.width;
            frame.height: root.geometry-drag-size.height;
        }
        rotation-dragging when root.rotation-active: {
            frame.rotation: root.pending-rotation;
        }
    ]

    if frame.radius-tooltip-visible: CanvasValueTooltip {
        label: "Radius";
        value: (frame.radius-tooltip-value / 1px).to-fixed(0);
        value-label: "Radius value";
        pointer-position: {
            x: frame.x + frame.radius-tooltip-position.x,
            y: frame.y + frame.radius-tooltip-position.y,
        };
    }

    if frame.rotation-tooltip-visible: CanvasValueTooltip {
        private property <angle> normalized-angle: EditorAngles.normalize((frame.rotation-tooltip-value / 1deg).round() * 1deg);
        label: "Rotation";
        value: "\{(self.normalized-angle / 1deg).round()}";
        suffix: "°";
        value-label: "Rotation angle";
        pointer-position: frame.rotation-tooltip-position;
    }
}

component HoverCanvasFrame inherits MoveResizeFrame {
    show-outline: false;
    in property <SelectionRectangle> geometry;
    in property <bool> gesture-active;
    in property <bool> selection-area-has-hover;
    callback gesture-started();
    callback gesture-ended();
    callback pointer-hovered(Point);
    callback real-element-selected();

    private property <Point> geometry-drag-position;

    visible: Hover.element.valid;
    enabled: root.visible
        && !Hover.element.is-selected
        && !Hover.element.is-over-selected-element
        && (!root.gesture-active || root.move-pressed);
    x: root.geometry.x;
    y: root.geometry.y;
    width: root.geometry.width;
    height: root.geometry.height;
    rotation: root.geometry.angle;
    active: !root.gesture-active || root.move-pressed;
    moveable: root.geometry.describes-element;
    resizable: false;
    show-resize-handles: false;
    show-rotation-handles: false;
    accessible-prefix: "Hovered " + Hover.element.type-name;
    accessible-role: AccessibleRole.region;
    accessible-label: root.accessible-prefix;

    function preview-geometry(position: Point) {
        root.geometry-drag-position = position;
        Api.override-selected-element-geometry(
            position.x,
            position.y,
            root.geometry.width,
            root.geometry.height,
        );
    }

    function finish-interaction(position: Point) {
        let was-dragging = root.move-dragging;
        if was-dragging {
            Api.persist-selected-element-geometry();
        }
        root.gesture-ended();
        if was-dragging {
            Hover.element = {};
        } else {
            root.pointer-hovered(position);
        }
    }

    changed frame-hover => {
        if !root.frame-hover && !root.selection-area-has-hover && !root.gesture-active
            && !Hover.element.is-selected {
            Hover.element = {};
        }
    }
    move-press-started(position) => {
        if !root.gesture-active {
            root.gesture-started();
            Api.select-element(
                Hover.element.element-path,
                Hover.element.element-offset,
                position.x,
                position.y,
            );
            root.real-element-selected();
        }
    }
    moved-to(position) => {
        root.preview-geometry(position);
    }
    move-released(position) => {
        if root.gesture-active {
            root.finish-interaction(position);
        }
    }
    pointer-moved(position) => {
        if !root.gesture-active {
            root.pointer-hovered(position);
        }
    }

    states [
        dragging when root.move-dragging: {
            x: root.geometry-drag-position.x;
            y: root.geometry-drag-position.y;
        }
    ]
}

export component CanvasInteractionLayer inherits Rectangle {
    in property <bool> shift-pressed;
    // Coordinates the selected and hover frames while a hovered item owns the pointer gesture.
    private property <bool> hover-selection-active;
    private property <bool> text-editing;
    private property <string> text-edit-value;
    private property <string> text-edit-original;
    private property <string> text-edit-url;
    private property <string> text-edit-override-id;
    private property <int> text-edit-version;
    private property <int> text-edit-offset;
    private property <Point> text-edit-position;
    private property <Size> text-edit-size;
    private property <float> text-edit-scale-x: 1;
    private property <float> text-edit-scale-y: 1;
    // Guard on highlight-index >= 0: after Api.unselect(), the backend still populates
    // current-element with the component root. Its frame would intercept future selections.
    private property <[SelectionRectangle]> selections: Api.selection.highlight-index >= 0
        ? Api.highlight-positions(Api.current-element.source-uri, Api.current-element.offset)
        : [];

    private property <Point> canvas-origin: root.absolute-position;
    private property <Size> canvas-size: { width: root.width, height: root.height };
    private property <SelectionRectangle> primary-selection: root.selections[Api.selection.highlight-index];
    init => {
        FillSession.canvas-origin = root.canvas-origin;
        FillSession.canvas-size = root.canvas-size;
        FillSession.selection = root.primary-selection;
    }
    changed canvas-origin => { FillSession.canvas-origin = root.canvas-origin; }
    changed canvas-size => { FillSession.canvas-size = root.canvas-size; }
    changed primary-selection => { FillSession.selection = root.primary-selection; }

    callback real-element-selected();

    pure function horizontal-text-alignment(index: int) -> TextHorizontalAlignment {
        if index == 0 { return TextHorizontalAlignment.start; }
        if index == 1 { return TextHorizontalAlignment.end; }
        if index == 2 { return TextHorizontalAlignment.left; }
        if index == 3 { return TextHorizontalAlignment.center; }
        if index == 4 { return TextHorizontalAlignment.right; }
        debug("Error: unexpected", "horizontal-text-alignment: " + index);
        return TextHorizontalAlignment.start;
    }

    pure function vertical-text-alignment(index: int) -> TextVerticalAlignment {
        if index == 1 { return TextVerticalAlignment.center; }
        if index == 2 { return TextVerticalAlignment.bottom; }
        return TextVerticalAlignment.top;
    }

    function begin-text-edit() {
        let text = Api.current-property-value-data("text");
        let width = Api.current-property-value-data("width").value-float;
        let height = Api.current-property-value-data("height").value-float;
        let scale-x = width > 0
            ? root.primary-selection.width / 1px / width
            : 1;
        let scale-y = height > 0
            ? root.primary-selection.height / 1px / height
            : 1;
        if root.text-editing
            || Api.current-element.type-name != "Text"
            || !root.primary-selection.describes-element
            || root.primary-selection.angle != 0deg
            || text.kind != PropertyValueKind.string
            || text.is-translatable
            || text.code == ""
            || !Api.string-is-single-line(text.value-string)
            || Api.current-property-value-data("wrap").value-int != 0
            || (scale-x - scale-y).abs() > 0.001 {
            return;
        }
        root.text-edit-override-id = Api.override-element-text("", "");
        if root.text-edit-override-id == "" {
            return;
        }
        root.text-edit-original = text.value-string;
        root.text-edit-value = root.text-edit-original;
        root.text-edit-url = Api.current-element.source-uri;
        root.text-edit-version = Api.current-element.source-version;
        root.text-edit-offset = Api.current-element.offset;
        root.text-edit-position = { x: root.primary-selection.x, y: root.primary-selection.y };
        root.text-edit-size = {
            width: root.primary-selection.width,
            height: root.primary-selection.height,
        };
        root.text-edit-scale-x = scale-x;
        root.text-edit-scale-y = scale-y;
        root.text-editing = true;
    }

    function commit-text-edit() -> bool {
        if !root.text-editing {
            return true;
        }
        let code = Api.string-to-code(root.text-edit-value, false, "", "", "");
        if root.text-edit-value != root.text-edit-original
            && !Api.set-code-binding(
                root.text-edit-url,
                root.text-edit-version,
                root.text-edit-offset,
                "text",
                code,
            ) {
            return false;
        }
        Api.override-element-text(root.text-edit-override-id, root.text-edit-value);
        root.text-editing = false;
        return true;
    }

    function update-hover(position: Point) {
        if root.text-editing || FillSession.canvas-active || root.hover-selection-active || selection-area.pressed {
            return;
        }
        Hover.element = Hover.element-at(position.x, position.y, false);
    }

    // Click to select the real previewed element. This sits on top of the live
    // preview so it intercepts clicks. Its pointer positions are in content coordinates.
    selection-area := TouchArea {
        width: root.width;
        height: root.height;
        mouse-cursor: EditorCursors.canvas-default;
        clicked => {
            if root.text-editing && !root.commit-text-edit() {
                return;
            }
            Api.unselect();
            Api.select-at(self.pressed-x, self.pressed-y, false);
            root.real-element-selected();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.update-hover({ x: self.mouse-x, y: self.mouse-y });
            }
        }
    }

    for geometry in Hover.element.geometry: Rectangle {
        x: geometry.x;
        y: geometry.y;
        width: geometry.width;
        height: geometry.height;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: geometry.angle;
        visible: Hover.element.valid && !root.hover-selection-active;
        Rectangle {
            x: -EditorMetrics.hover-outline-width;
            y: -EditorMetrics.hover-outline-width;
            width: parent.width + 2 * EditorMetrics.hover-outline-width;
            height: parent.height + 2 * EditorMetrics.hover-outline-width;
            border-width: EditorMetrics.hover-outline-width;
            border-color: Style.colors.canvas-outline;
            border-top-left-radius: geometry.top-left-radius > 0px ? geometry.top-left-radius + self.border-width : 0px;
            border-top-right-radius: geometry.top-right-radius > 0px ? geometry.top-right-radius + self.border-width : 0px;
            border-bottom-left-radius: geometry.bottom-left-radius > 0px ? geometry.bottom-left-radius + self.border-width : 0px;
            border-bottom-right-radius: geometry.bottom-right-radius > 0px ? geometry.bottom-right-radius + self.border-width : 0px;
        }
    }

    for selection[idx] in root.selections: SelectedCanvasFrame {
        selection: selection;
        primary: idx == Api.selection.highlight-index;
        shift-pressed: root.shift-pressed;
        interaction-disabled: root.text-editing || root.hover-selection-active || FillSession.canvas-active;
        pointer-hovered(position) => {
            root.update-hover(position);
        }
        double-clicked => {
            root.begin-text-edit();
        }
    }

    for geometry in (FillSession.canvas-active ? [] : Hover.element.geometry): HoverCanvasFrame {
        geometry: geometry;
        gesture-active: root.hover-selection-active;
        selection-area-has-hover: selection-area.has-hover;
        gesture-started => {
            root.hover-selection-active = true;
        }
        gesture-ended => {
            root.hover-selection-active = false;
        }
        pointer-hovered(position) => {
            root.update-hover(position);
        }
        real-element-selected => {
            root.real-element-selected();
        }
    }

    if root.text-editing: FocusScope {
        x: root.text-edit-position.x;
        y: root.text-edit-position.y;
        width: root.text-edit-size.width;
        height: root.text-edit-size.height;
        init => {
            input.focus();
            input.select-all();
        }

        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.commit-text-edit();
                return accept;
            }
            reject
        }

        input := TextInput {
            width: parent.width;
            height: parent.height;
            text <=> root.text-edit-value;
            color: Api.current-property-value-data("color").value-brush;
            font-family: Api.current-property-value-data("font-family").value-string;
            font-size: Api.current-property-value-data("font-size").value-float
                * root.text-edit-scale-y * 1px;
            font-weight: Api.current-property-value-data("font-weight").value-int;
            font-italic: Api.current-property-value-data("font-italic").value-bool;
            horizontal-alignment: root.horizontal-text-alignment(
                Api.current-property-value-data("horizontal-alignment").value-int,
            );
            vertical-alignment: root.vertical-text-alignment(
                Api.current-property-value-data("vertical-alignment").value-int,
            );
            letter-spacing: Api.current-property-value-data("letter-spacing").value-float
                * root.text-edit-scale-x * 1px;
            line-height-factor: Api.current-property-value-data("line-height-factor").value-float;
            single-line: true;
            wrap: no-wrap;
            accessible-label: "Inline text editor";

            accepted => { root.commit-text-edit(); }
            changed has-focus => {
                if !self.has-focus && !root.commit-text-edit() {
                    self.focus();
                }
            }
        }
    }
}
