import { CanvasValueTooltip } from "canvas-value-tooltip.slint";
import { CanvasView } from "canvas-view.slint";
import { Style } from "../style.slint";
import { FillSession, ShadowSession } from "inspector/index.slint";
import { Api, Hover, InlineTextEdit, SelectionRectangle } from "../api.slint";
import { EditorAngles, EditorCursors } from "index.slint";
import { BorderRadiusFrame } from "border-radius-frame.slint";
import { MoveResizeFrame } from "move-resize-frame.slint";

component SelectedCanvasFrame inherits Rectangle {
    in property <SelectionRectangle> selection;
    in property <bool> primary;
    in property <bool> shift-pressed;
    in property <bool> interaction-disabled;
    in property <bool> show-outline-while-moving;
    callback pointer-hovered(Point);
    callback hover-suppressed();
    callback clicked(Point);
    callback double-clicked();
    callback focus-requested();

    private property <bool> geometry-drag-active;
    private property <Point> geometry-drag-position;
    private property <Size> geometry-drag-size;
    private property <bool> rotation-active;
    private property <angle> pending-rotation;
    private property <bool> radius-drag-active;
    private property <bool> pointer-active: frame.pointer-active || frame.radius-tooltip-visible;
    changed pointer-active => {
        CanvasView.manipulating = root.pointer-active;
        if root.pointer-active { root.focus-requested(); }
    }

    function current-corner-radius(property-name: string) -> length {
        let corner = Api.source-property-value-data(property-name, {});
        return corner.code != ""
            ? corner.value-float * 1px
            : Api.source-property-value-data("border-radius", {}).value-float * 1px;
    }

    function has-independent-corner-radii() -> bool {
        return Api.source-property-value-data("border-top-left-radius", {}).code != ""
            || Api.source-property-value-data("border-top-right-radius", {}).code != ""
            || Api.source-property-value-data("border-bottom-right-radius", {}).code != ""
            || Api.source-property-value-data("border-bottom-left-radius", {}).code != "";
    }

    function preview-geometry(position: Point, size: Size) {
        root.geometry-drag-active = true;
        root.geometry-drag-position = position;
        root.geometry-drag-size = size;
        // Push live geometry so the previewed element follows the drag through
        // debug-hook overrides without writing to disk.
        Api.override-selected-element-geometry(
            position.x / CanvasView.zoom,
            position.y / CanvasView.zoom,
            size.width / CanvasView.zoom,
            size.height / CanvasView.zoom,
        );
    }

    function finish-interaction() {
        if root.geometry-drag-active {
            Api.persist-selected-element-geometry();
        }
        if root.rotation-active {
            Api.selected-element-rotate(root.pending-rotation);
        }
        if root.radius-drag-active {
            Api.persist-selected-element-border-radius();
        }
        root.geometry-drag-active = false;
        root.rotation-active = false;
        root.radius-drag-active = false;
    }

    frame := BorderRadiusFrame {
        x: root.selection.x * CanvasView.zoom;
        y: root.selection.y * CanvasView.zoom;
        width: root.selection.width * CanvasView.zoom;
        height: root.selection.height * CanvasView.zoom;
        geometry-scale: CanvasView.zoom;
        rotation: root.selection.angle;
        accessible-prefix: Api.current-element.type-name;
        active: !root.interaction-disabled;
        shift-pressed: root.shift-pressed;
        show-resize-handles: root.primary;
        show-rotation-handles: root.primary && Api.current-element.id != "root";
        show-outline-while-moving: root.show-outline-while-moving;
        enable-border-radius-edits: root.primary && Api.current-element.type-name == "Rectangle";
        independent-corner-radii: root.has-independent-corner-radii();
        top-left-radius: root.current-corner-radius("border-top-left-radius");
        top-right-radius: root.current-corner-radius("border-top-right-radius");
        bottom-right-radius: root.current-corner-radius("border-bottom-right-radius");
        bottom-left-radius: root.current-corner-radius("border-bottom-left-radius");
        // Only allow move/resize for elements that have geometry outside a layout, and whose
        // frame describes them.
        resizable: root.primary && Api.selection.is-resizable && root.selection.describes-element;
        moveable: root.primary && Api.selection.is-moveable && root.selection.describes-element;
        accessible-role: AccessibleRole.region;
        accessible-label: @tr("Selected {}", Api.current-element.type-name);

        double-clicked => {
            if root.primary {
                root.double-clicked();
            }
        }

        rotated-to(rotation) => {
            root.rotation-active = true;
            root.pending-rotation = rotation;
            Api.override-selected-element-rotation(rotation);
        }
        control-hovered => { root.hover-suppressed(); }
        move-press-started(position) => { root.hover-suppressed(); }
        move-released(position) => {
            if !self.move-dragging && !root.interaction-disabled {
                let preview = CanvasView.to-preview(position);
                Api.select-at(preview.x, preview.y, false);
                root.focus-requested();
                root.pointer-hovered(position);
                root.clicked(position);
            }
        }
        interaction-started => {
            root.rotation-active = false;
            root.radius-drag-active = false;
            root.hover-suppressed();
        }
        pointer-moved(position) => {
            if !self.move-pressed {
                root.pointer-hovered(position);
            }
        }
        radius-changed(corner, radius, single-corner) => {
            root.radius-drag-active = true;
            Api.override-selected-element-border-radius(corner, radius, single-corner);
        }
        radius-reset(corner) => {
            Api.reset-selected-element-border-radius(corner);
        }
        resized-to(position, size) => {
            root.preview-geometry(position, size);
        }
        moved-to(position) => {
            root.preview-geometry(position, {
                width: root.selection.width * CanvasView.zoom,
                height: root.selection.height * CanvasView.zoom,
            });
        }
        interaction-ended => {
            root.finish-interaction();
        }
    }

    states [
        geometry-dragging when root.geometry-drag-active: {
            frame.x: root.geometry-drag-position.x;
            frame.y: root.geometry-drag-position.y;
            frame.width: root.geometry-drag-size.width;
            frame.height: root.geometry-drag-size.height;
        }
        nudging when root.primary && CanvasView.nudging: {
            frame.x: CanvasView.nudge-position.x * CanvasView.zoom;
            frame.y: CanvasView.nudge-position.y * CanvasView.zoom;
        }
        rotation-dragging when root.rotation-active: {
            frame.rotation: root.pending-rotation;
        }
    ]

    if frame.radius-tooltip-visible: CanvasValueTooltip {
        private property <Point> corner-position: frame.local-point-to-parent({
            x: frame.corner-on-left(frame.radius-edit-corner) ? 0px : frame.width,
            y: frame.corner-on-top(frame.radius-edit-corner) ? 0px : frame.height,
        });
        private property <length> corner-clearance: frame.radius-tooltip-value * frame.geometry-scale;
        label: @tr("Radius");
        value: (frame.radius-tooltip-value / 1px).to-fixed(0);
        value-label: @tr("Radius value");
        pointer-position: frame.local-point-to-parent(frame.radius-tooltip-position);
        x: self.corner-position.x <= frame.x + frame.width / 2
            ? max(self.pointer-position.x, self.corner-position.x + self.corner-clearance) + self.style.offset
            : min(self.pointer-position.x, self.corner-position.x - self.corner-clearance) - self.width - self.style.offset;
    }

    if frame.rotation-tooltip-visible: CanvasValueTooltip {
        label: @tr("Rotation");
        value: EditorAngles.rounded(frame.rotation-tooltip-value).to-fixed(0);
        suffix: "°";
        value-label: @tr("Rotation angle");
        pointer-position: frame.rotation-tooltip-position;
    }
}

component HoverCanvasFrame inherits MoveResizeFrame {
    in property <SelectionRectangle> geometry;
    in property <bool> gesture-active;
    callback gesture-started();
    callback gesture-ended();
    callback pointer-hovered(Point);
    callback real-element-selected();
    callback text-clicked(string, int, Point);

    private property <Point> geometry-drag-position;
    private property <bool> text-click-candidate;
    private property <string> text-click-source-uri;
    private property <int> text-click-offset: -1;
    private property <Point> text-click-position;

    visible: Hover.element.valid;
    enabled: root.visible
        && !Hover.element.is-selected
        && !Hover.element.is-over-selected-element
        && (!root.gesture-active || root.move-pressed);
    x: root.geometry.x * CanvasView.zoom;
    y: root.geometry.y * CanvasView.zoom;
    width: root.geometry.width * CanvasView.zoom;
    height: root.geometry.height * CanvasView.zoom;
    geometry-scale: CanvasView.zoom;
    changed pointer-active => { CanvasView.manipulating = root.pointer-active; }
    rotation: root.geometry.angle;
    active: !root.gesture-active || root.move-pressed;
    moveable: root.geometry.describes-element;
    resizable: false;
    show-resize-handles: false;
    show-rotation-handles: false;
    show-outline: root.show-outline-while-moving && root.move-dragging;
    accessible-prefix: @tr("Hovered {}", Hover.element.type-name);
    accessible-role: AccessibleRole.region;
    accessible-label: root.accessible-prefix;

    function preview-geometry(position: Point) {
        root.geometry-drag-position = position;
        Api.override-selected-element-geometry(
            position.x / CanvasView.zoom,
            position.y / CanvasView.zoom,
            root.geometry.width,
            root.geometry.height,
        );
    }

    function finish-interaction(position: Point) {
        let was-dragging = root.move-dragging;
        if was-dragging {
            Api.persist-selected-element-geometry();
        }
        root.gesture-ended();
        if was-dragging {
            Hover.element = {};
        } else {
            root.pointer-hovered(position);
        }
    }

    move-press-started(position) => {
        if !root.gesture-active {
            root.text-click-candidate = Hover.element.type-name == "Text";
            root.text-click-source-uri = Hover.element.source-uri;
            root.text-click-offset = Hover.element.element-offset;
            root.text-click-position = position;
            root.gesture-started();
            Api.select-element(
                Hover.element.element-path,
                Hover.element.element-offset,
                position.x / CanvasView.zoom,
                position.y / CanvasView.zoom,
            );
            root.real-element-selected();
        }
    }
    moved-to(position) => {
        root.preview-geometry(position);
    }
    move-released(position) => {
        if root.gesture-active {
            let text-click-candidate = root.text-click-candidate && !root.move-dragging;
            let text-click-source-uri = root.text-click-source-uri;
            let text-click-offset = root.text-click-offset;
            let text-click-position = root.text-click-position;
            root.finish-interaction(position);
            if text-click-candidate {
                root.text-clicked(text-click-source-uri, text-click-offset, text-click-position);
            }
        }
        root.text-click-candidate = false;
    }
    pointer-moved(position) => {
        if !root.gesture-active {
            root.pointer-hovered(position);
        }
    }

    states [
        dragging when root.move-dragging: {
            x: root.geometry-drag-position.x;
            y: root.geometry-drag-position.y;
        }
    ]
}

export component CanvasInteractionLayer inherits TouchArea {
    in property <bool> shift-pressed;
    // The preview area, in the layer's coordinates.
    // The layer itself covers the whole canvas, so elements placed outside the root stay reachable.
    in property <Point> content-origin;
    in property <Size> content-size;
    private property <bool> hover-enabled;
    private property <int> preview-generation: Hover.preview-generation;
    mouse-cursor: EditorCursors.canvas-default;

    changed preview-generation => {
        root.refresh-hover();
    }
    changed has-hover => {
        if !root.has-hover && !root.hover-selection-active {
            root.suppress-hover();
        }
    }
    // Coordinates the selected and hover frames while a hovered item owns the pointer gesture.
    private property <bool> hover-selection-active;
    private property <bool> unselected-text-click-pending;
    private property <string> unselected-text-source-uri;
    private property <int> unselected-text-offset: -1;
    private property <Point> unselected-text-click-position;
    private property <bool> text-editing;
    private property <bool> text-edit-starting;
    private property <bool> text-edit-had-focus;
    private property <string> text-edit-value;
    private property <brush> text-edit-color;
    private property <Point> text-edit-position: { x: root.primary-selection.x, y: root.primary-selection.y };
    private property <Size> text-edit-size: { width: root.primary-selection.width, height: root.primary-selection.height };
    private property <bool> text-edit-active: InlineTextEdit.active;
    changed text-edit-active => {
        if root.text-edit-active {
            root.begin-text-edit();
        } else {
            root.text-editing = false;
            root.text-edit-had-focus = false;
        }
    }
    unselected-text-click-timeout := Timer {
        interval: 500ms;
        triggered => {
            self.stop();
            root.unselected-text-click-pending = false;
        }
    }
    private property <[SelectionRectangle]> selections:
        Api.highlight-positions(Api.current-element.source-uri, Api.current-element.offset);

    private property <Point> hover-window-position;
    private property <float> zoom: CanvasView.zoom;
    changed zoom => { root.refresh-hover(); }
    private property <Point> canvas-origin: content.absolute-position;
    private property <Size> canvas-size: root.content-size;
    private property <SelectionRectangle> primary-selection: root.selections[Api.selection.highlight-index];
    init => {
        FillSession.canvas-origin = root.canvas-origin;
        FillSession.canvas-size = root.canvas-size;
        FillSession.selection = root.primary-selection;
        CanvasView.selection = root.primary-selection;
    }
    changed canvas-origin => {
        FillSession.canvas-origin = root.canvas-origin;
        root.refresh-hover();
    }
    changed canvas-size => { FillSession.canvas-size = root.canvas-size; }
    changed primary-selection => {
        FillSession.selection = root.primary-selection;
        CanvasView.selection = root.primary-selection;
    }

    callback real-element-selected();

    pure function keep-selection-outline-while-moving(type-name: string) -> bool {
        return type-name == "TouchArea" || type-name == "Image";
    }

    pure function horizontal-text-alignment(index: int) -> TextHorizontalAlignment {
        if index == 0 { return TextHorizontalAlignment.start; }
        if index == 1 { return TextHorizontalAlignment.end; }
        if index == 2 { return TextHorizontalAlignment.left; }
        if index == 3 { return TextHorizontalAlignment.center; }
        if index == 4 { return TextHorizontalAlignment.right; }
        debug("Error: unexpected", "horizontal-text-alignment: " + index);
        return TextHorizontalAlignment.start;
    }

    pure function vertical-text-alignment(index: int) -> TextVerticalAlignment {
        if index == 1 { return TextVerticalAlignment.center; }
        if index == 2 { return TextVerticalAlignment.bottom; }
        return TextVerticalAlignment.top;
    }

    function begin-text-edit() {
        if root.text-editing || root.text-edit-starting { return; }
        root.text-edit-starting = true;
        let start = InlineTextEdit.begin();
        root.text-edit-starting = false;
        if !start.success { return; }
        root.text-edit-value = start.text;
        root.text-edit-color = start.color;
        root.text-edit-had-focus = false;
        root.text-editing = true;
        root.suppress-hover();
    }

    function commit-text-edit() -> bool {
        if !root.text-editing { return true; }
        return InlineTextEdit.commit(root.text-edit-value);
    }

    function select-at-position(position: Point) {
        let preview = CanvasView.to-preview(position);
        Api.select-at(preview.x, preview.y, false);
        root.real-element-selected();
    }

    function refresh-hover() {
        if root.has-hover && root.hover-enabled {
            root.update-hover({
                x: root.hover-window-position.x - canvas-origin.x,
                y: root.hover-window-position.y - canvas-origin.y,
            });
        }
    }

    function update-hover(position: Point) {
        root.hover-window-position = {
            x: canvas-origin.x + position.x,
            y: canvas-origin.y + position.y,
        };
        if root.text-editing || FillSession.canvas-active || ShadowSession.canvas-visible || root.hover-selection-active || root.pressed {
            return;
        }
        root.hover-enabled = true;
        let preview = CanvasView.to-preview(position);
        Hover.element = Hover.element-at(preview.x, preview.y, false);
    }

    function suppress-hover() {
        root.hover-enabled = false;
        Hover.element = {};
    }

    clicked => {
        let position = {
            x: self.pressed-x - root.content-origin.x,
            y: self.pressed-y - root.content-origin.y,
        };
        if root.text-editing {
            if !root.commit-text-edit() { return; }
            if InlineTextEdit.active {
                InlineTextEdit.defer-selection(CanvasView.to-preview(position));
                return;
            }
        }
        root.select-at-position(position);
    }
    pointer-event(event) => {
        if event.kind == PointerEventKind.move {
            root.update-hover({
                x: self.mouse-x - root.content-origin.x,
                y: self.mouse-y - root.content-origin.y,
            });
        }
    }

    content := Rectangle {
        x: root.content-origin.x;
        y: root.content-origin.y;
        width: root.content-size.width;
        height: root.content-size.height;

        for geometry in (root.text-editing ? [] : Hover.geometry): Rectangle {
            x: geometry.x * CanvasView.zoom;
            y: geometry.y * CanvasView.zoom;
            width: geometry.width * CanvasView.zoom;
            height: geometry.height * CanvasView.zoom;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: geometry.angle;
            visible: !root.hover-selection-active;
            accessible-role: AccessibleRole.region;
            // HoverCanvasFrame labels canvas hover; tree hover uses only this passive outline.
            accessible-label: Hover.tree-source-uri != "" ? "Hovered " + Hover.tree-type-name : "";
            Rectangle {
                x: -Style.selection-frame.hover-width;
                y: -Style.selection-frame.hover-width;
                width: parent.width + 2 * Style.selection-frame.hover-width;
                height: parent.height + 2 * Style.selection-frame.hover-width;
                border-width: Style.selection-frame.hover-width;
                border-color: Style.selection-frame.accent;
                border-top-left-radius: geometry.top-left-radius > 0px ? geometry.top-left-radius * CanvasView.zoom + self.border-width : 0px;
                border-top-right-radius: geometry.top-right-radius > 0px ? geometry.top-right-radius * CanvasView.zoom + self.border-width : 0px;
                border-bottom-left-radius: geometry.bottom-left-radius > 0px ? geometry.bottom-left-radius * CanvasView.zoom + self.border-width : 0px;
                border-bottom-right-radius: geometry.bottom-right-radius > 0px ? geometry.bottom-right-radius * CanvasView.zoom + self.border-width : 0px;
            }
        }

        for selection[idx] in root.selections: SelectedCanvasFrame {
            visible: !root.text-editing;
            selection: selection;
            primary: idx == Api.selection.highlight-index;
            shift-pressed: root.shift-pressed;
            interaction-disabled: root.text-editing || root.hover-selection-active || FillSession.canvas-active || ShadowSession.canvas-visible;
            show-outline-while-moving: root.keep-selection-outline-while-moving(
                Api.current-element.type-name,
            );
            pointer-hovered(position) => {
                root.update-hover(position);
            }
            hover-suppressed => { root.suppress-hover(); }
            focus-requested => { root.real-element-selected(); }
            clicked(position) => {
                let delta-x = (position.x - root.unselected-text-click-position.x) / 1px;
                let delta-y = (position.y - root.unselected-text-click-position.y) / 1px;
                let target-matches = root.unselected-text-click-pending
                    && Api.current-element.type-name == "Text"
                    && Api.current-element.source-uri == root.unselected-text-source-uri
                    && Api.current-element.offset == root.unselected-text-offset
                    && delta-x * delta-x + delta-y * delta-y < 100;
                root.unselected-text-click-pending = false;
                unselected-text-click-timeout.stop();
                if target-matches {
                    root.begin-text-edit();
                }
            }
            double-clicked => {
                root.begin-text-edit();
            }
        }

        for geometry in (FillSession.canvas-active || ShadowSession.canvas-visible ? [] : Hover.element.geometry): HoverCanvasFrame {
            geometry: geometry;
            gesture-active: root.hover-selection-active;
            show-outline-while-moving: root.keep-selection-outline-while-moving(
                Hover.element.type-name,
            );
            gesture-started => {
                root.hover-enabled = false;
                root.hover-selection-active = true;
            }
            gesture-ended => {
                root.hover-selection-active = false;
            }
            pointer-hovered(position) => {
                root.update-hover(position);
            }
            real-element-selected => {
                root.real-element-selected();
            }
            text-clicked(source-uri, offset, position) => {
                root.unselected-text-source-uri = source-uri;
                root.unselected-text-offset = offset;
                root.unselected-text-click-position = position;
                root.unselected-text-click-pending = true;
                unselected-text-click-timeout.start();
            }
        }

        if root.text-editing: FocusScope {
            x: root.text-edit-position.x * CanvasView.zoom;
            y: root.text-edit-position.y * CanvasView.zoom;
            width: InlineTextEdit.grow-width
                ? max(root.text-edit-size.width * CanvasView.zoom, input.preferred-width + input.text-cursor-width)
                : root.text-edit-size.width * CanvasView.zoom;
            height: root.text-edit-size.height * CanvasView.zoom;
            init => {
                input.focus();
                if input.has-focus {
                    input.select-all();
                    root.text-edit-had-focus = true;
                } else {
                    root.commit-text-edit();
                }
            }

            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    root.commit-text-edit();
                    return accept;
                }
                reject
            }

            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text-edit-value;
                color: root.text-edit-color;
                selection-background-color: Style.field.appearance.selection;
                selection-foreground-color: Style.field.appearance.focus.foreground;
                font-family: Api.runtime-property-value-data("font-family", {
                    value-string: Api.preview-default-font-family,
                }).value-string;
                font-size: Api.runtime-property-value-data("font-size", {
                    value-float: Api.preview-default-font-size,
                }).value-float
                    * InlineTextEdit.scale * CanvasView.zoom * 1px;
                font-weight: Api.runtime-property-value-data("font-weight", {
                    value-int: Api.preview-default-font-weight,
                }).value-int;
                font-italic: Api.runtime-property-value-data("font-italic", {}).value-bool;
                horizontal-alignment: root.horizontal-text-alignment(
                    Api.runtime-property-value-data("horizontal-alignment", {}).value-int,
                );
                vertical-alignment: root.vertical-text-alignment(
                    Api.runtime-property-value-data("vertical-alignment", {}).value-int,
                );
                letter-spacing: Api.runtime-property-value-data("letter-spacing", {}).value-float
                    * InlineTextEdit.scale * CanvasView.zoom * 1px;
                line-height-factor: Api.runtime-property-value-data("line-height-factor", {
                    value-float: 1,
                }).value-float;
                read-only: InlineTextEdit.commit-pending;
                private property <bool> commit-pending: InlineTextEdit.commit-pending;
                changed commit-pending => {
                    if !self.commit-pending && InlineTextEdit.active { self.focus(); }
                }
                accessible-label: @tr("Inline text editor");

                accepted => { root.commit-text-edit(); }
                changed has-focus => {
                    if self.has-focus {
                        root.text-edit-had-focus = true;
                    } else if root.text-edit-had-focus && !root.commit-text-edit() {
                        self.focus();
                    }
                }
            }
        }
    }
}
