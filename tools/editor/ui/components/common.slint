import { Palette } from "std-widgets.slint";
import { ElementVisuals } from "element-presentation.slint";
import { Api, CanvasCorner, ElementKind } from "../api.slint";

export { CanvasCorner, ElementKind }

export global StudioTheme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> app-bg: dark ? #2c2c2c : #f6f8fa;
    out property <color> panel-bg: dark ? #2c2c2c : #ffffff;
    out property <color> panel-subtle: dark ? #383838 : #f6f8fa;
    out property <color> text: dark ? #f1f1f1 : #1f2328;
    out property <color> muted: dark ? #b7b7b7 : #6e7781;
    out property <color> border: dark ? #494949 : #d0d7de;
    out property <color> soft-border: dark ? #3f3f3f : #eaeef2;
    out property <color> accent: dark ? #2379f4 : #0d99ff;
    out property <color> accent-strong: dark ? accent.mix(#ffffff, 0.75) : #52aeff;
    out property <color> canvas: dark ? #1f1f1f : #eef2f7;
    out property <color> phone-bg: dark ? #f7f8fb : #ffffff;
    out property <color> phone-text: #20252d;
    out property <color> object-bg: #ffffff;
    out property <color> object-subtle: #f6f8fa;
    out property <color> object-border: #d0d7de;
    out property <color> object-muted: #6e7781;
    out property <brush> drop-mark-background: #ffffff;
    out property <brush> drop-mark-foreground: #ffffff;
}

export global EditorIcons {
    out property <image> select-chevron: @image-url("../assets/octicons/select-chevron.svg");
}

export global EditorCursors {
    pure callback rotation-image(angle) -> image;
    out property <MouseCursor> canvas-default: MouseCursor.custom(
        @image-url("../assets/cursors/default-32.png"),
        14,
        14,
    );
}

export global EditorAngles {
    public pure function normalize(value: angle) -> angle {
        let normalized = value.mod(360deg);
        return normalized < 0deg ? normalized + 360deg : normalized;
    }
}

export global EditorMetrics {
    in-out property <length> window-width;
    in-out property <length> window-height;
    out property <length> left-pane-width: 286px;
    out property <length> inspector-pane-width: 232px;
    out property <length> top-bar-height: 54px;
    out property <length> status-bar-height: 26px;
    out property <length> phone-portrait-width: 390px;
    out property <length> phone-portrait-height: 720px;
    out property <length> phone-frame-radius: 34px;
    out property <length> phone-outer-padding: 1px;
    out property <length> selection-outline-width: 2px;
    out property <length> selection-handle-size: 12px;
    out property <length> rotation-zone-size: 22px;
    out property <length> radius-handle-size: 10px;
    out property <length> radius-handle-inset: 10px;
}

export component EdgeDivider inherits Rectangle {
    width: 1px;
    background: StudioTheme.border;
}

export component HorizontalResizeDivider inherits FocusScope {
    in property <string> resize-label;
    in property <color> line-color: StudioTheme.border;
    in property <length> value: 120px;
    in property <length> value-minimum: 120px;
    in property <length> value-maximum: 120px;
    in property <length> value-step: 8px;
    callback drag-started();
    callback dragged(length);
    callback drag-finished(length);
    callback value-set(length);
    callback reset-requested();

    height: 6px;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.resize-label;
    accessible-description: "Lower pane height. Arrow keys adjust by 8 px; Home and End clamp; Ctrl+Home or double-click resets.";
    accessible-value: "\{(root.value / 1px).round()} px";
    accessible-value-minimum: root.value-minimum / 1px;
    accessible-value-maximum: root.value-maximum / 1px;
    accessible-value-step: root.value-step / 1px;
    accessible-action-increment => {
        root.value-set(min(root.value + root.value-step, root.value-maximum));
    }
    accessible-action-decrement => {
        root.value-set(max(root.value - root.value-step, root.value-minimum));
    }
    key-pressed(event) => {
        if event.modifiers.control && event.text == Key.Home {
            root.reset-requested();
            return accept;
        }
        if event.text == Key.UpArrow {
            root.value-set(min(root.value + root.value-step, root.value-maximum));
            return accept;
        }
        if event.text == Key.DownArrow {
            root.value-set(max(root.value - root.value-step, root.value-minimum));
            return accept;
        }
        if event.text == Key.Home {
            root.value-set(root.value-minimum);
            return accept;
        }
        if event.text == Key.End {
            root.value-set(root.value-maximum);
            return accept;
        }
        return reject;
    }

    accessible-action-set-value(value) => {
        if value.is-float() {
            root.value-set(value.to-float().clamp(
                root.value-minimum / 1px,
                root.value-maximum / 1px,
            ) * 1px);
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: root.has-focus ? 1px : 0px;
        border-color: StudioTheme.accent-strong;
        background: touch.has-hover || touch.pressed
            ? StudioTheme.accent.with-alpha(0.12)
            : transparent;
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 1px;
        background: root.line-color;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: ns-resize;
        private property <length> press-absolute-y;

        changed pressed => {
            if self.pressed {
                root.focus();
                self.press-absolute-y = self.absolute-position.y + self.mouse-y;
                root.drag-started();
            } else {
                root.drag-finished(self.absolute-position.y + self.mouse-y - self.press-absolute-y);
                root.clear-focus();
            }
        }

        moved => {
            if self.pressed {
                root.dragged(self.absolute-position.y + self.mouse-y - self.press-absolute-y);
            }
        }

        double-clicked => {
            root.reset-requested();
        }

    }
}

export component BodyLabel inherits Text {
    color: StudioTheme.text;
    font-size: 13px;
    font-weight: 500;
    overflow: elide;
}

export component MutedLabel inherits Text {
    color: StudioTheme.muted;
    font-size: 12px;
    overflow: elide;
}

export component SectionTitle inherits Text {
    in property <string> label;
    text: label;
    color: StudioTheme.muted;
    font-size: 11px;
    font-weight: 700;
}

export component PrimerTextInput inherits Rectangle {
    in-out property <string> text <=> editor.text;
    in property <string> placeholder: "";
    in property <string> leading-text: "";
    in property <string> accessible-name: "";

    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: editor.has-focus ? StudioTheme.accent-strong : StudioTheme.border;
    background: StudioTheme.panel-bg;
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        if root.leading-text != "": Text {
            text: root.leading-text;
            color: StudioTheme.muted;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;

            editor := TextInput {
                width: parent.width;
                height: parent.height;
                text: "";
                color: StudioTheme.text;
                font-size: 13px;
                accessible-label: root.accessible-name;
                single-line: true;
                wrap: no-wrap;
                vertical-alignment: center;
                selection-background-color: StudioTheme.accent.with-alpha(0.28);
            }

            if editor.text == "": Text {
                x: editor.x;
                y: editor.y;
                width: editor.width;
                height: editor.height;
                text: root.placeholder;
                color: StudioTheme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

export component SidebarToggleButton inherits Rectangle {
    in property <bool> active: false;
    callback clicked;

    width: 34px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? StudioTheme.accent-strong : StudioTheme.border;
    background: active ? StudioTheme.accent.with-alpha(0.14) : touch.has-hover ? StudioTheme.panel-subtle : StudioTheme.panel-bg;
    animate background, border-color { duration: 120ms; }

    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 16px;
        border-radius: 3px;
        border-width: 2px;
        border-color: root.active ? StudioTheme.accent-strong : StudioTheme.text;
        background: transparent;

        Rectangle {
            x: 7px;
            width: 2px;
            height: parent.height;
            background: root.active ? StudioTheme.accent-strong : StudioTheme.text;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component PrimerNavRow inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    in property <length> indent: 0px;

    height: 30px;
    border-radius: 6px;
    background: selected ? StudioTheme.accent.with-alpha(0.13) : touch.has-hover ? StudioTheme.panel-subtle : transparent;

    HorizontalLayout {
        padding-left: 8px + root.indent;
        padding-right: 8px;
        spacing: 8px;

        Text {
            text: root.glyph;
            color: root.selected ? StudioTheme.accent-strong : StudioTheme.muted;
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.selected ? StudioTheme.text : StudioTheme.muted;
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
    }
}

export component ComponentPaletteRow inherits Rectangle {
    in property <ElementKind> kind;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> drag-enabled: true;
    callback drag-started();

    property <bool> dragging: dragger.dragging;
    property <bool> active: root.enabled && (root.dragging || touch.pressed);
    property <bool> hovered: root.enabled && touch.has-hover && !root.dragging;

    height: 36px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: root.active ? StudioTheme.accent.with-alpha(0.10) : root.hovered ? StudioTheme.panel-subtle : transparent;
    opacity: !root.enabled ? 0.58 : root.dragging ? 0.56 : 1;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.label;
    accessible-enabled: root.enabled && root.drag-enabled;
    animate background, opacity { duration: 140ms; easing: ease-out-quad; }

    function pointer-window-position() -> Point {
        return {
            x: touch.absolute-position.x + touch.mouse-x,
            y: touch.absolute-position.y + touch.mouse-y,
        };
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 8px;
        cross-axis-alignment: center;

        Image {
            width: 18px;
            height: 18px;
            source: ElementVisuals.for-kind(root.kind).icon;
            colorize: root.active ? StudioTheme.accent-strong : StudioTheme.text;
            opacity: root.active ? 1 : 0.5;
        }

        Text {
            text: root.label;
            overflow: elide;
            color: root.active ? StudioTheme.accent-strong : StudioTheme.text;
            font-size: 12px;
            horizontal-stretch: 1;
        }
    }

    dragger := DragArea {
        enabled: root.enabled && root.drag-enabled && !AppState.palette-drag-cancelled;
        data: Api.new-component-data-for-kind(root.kind);
        allow-copy: true;

        changed dragging => {
            if self.dragging {
                AppState.palette-drag-cancelled = false;
                AppState.update-palette-drag(root.kind, root.pointer-window-position());
                root.drag-started();
            } else {
                AppState.finish-palette-drag();
            }
        }

        touch := TouchArea {
            enabled: root.enabled && root.drag-enabled;
            mouse-cursor: self.enabled ? pointer : default;
        }
    }
}

export global AppState {
    in-out property <ElementKind> palette-drag-kind: ElementKind.none;
    in-out property <Point> palette-drag-preview-position: { x: 0px, y: 0px };
    in-out property <Size> palette-drag-size: ElementVisuals.for-kind(ElementKind.none).preview-size;
    in-out property <bool> palette-drag-cancelled: false;
    in-out property <bool> outline-drag-active: false;
    in-out property <bool> outline-drag-cancelled: false;
    in-out property <string> outline-drag-label: "";
    in-out property <image> outline-drag-icon;
    in-out property <Point> outline-drag-position: { x: 0px, y: 0px };
    in-out property <Size> outline-drag-preview-size: { width: 216px, height: 32px };

    public pure function has-active-drag() -> bool {
        return self.palette-drag-kind != ElementKind.none || self.outline-drag-active;
    }

    public function update-palette-drag(kind: ElementKind, window-position: Point) {
        if !self.palette-drag-cancelled {
            self.palette-drag-kind = kind;
            self.palette-drag-size = ElementVisuals.for-kind(kind).preview-size;
            self.palette-drag-preview-position = {
                x: window-position.x - self.palette-drag-size.width / 2,
                y: window-position.y - self.palette-drag-size.height / 2,
            };
        }
    }

    public function finish-palette-drag() {
        self.palette-drag-kind = ElementKind.none;
        self.palette-drag-cancelled = false;
    }

    public function cancel-palette-drag() {
        if self.palette-drag-kind != ElementKind.none {
            self.palette-drag-cancelled = true;
            self.palette-drag-kind = ElementKind.none;
        }
    }

    public function cancel-outline-drag() {
        if self.outline-drag-active {
            self.outline-drag-cancelled = true;
            self.outline-drag-active = false;
        }
    }

    public function cancel-active-drags() {
        self.cancel-palette-drag();
        self.cancel-outline-drag();
    }

    pure function outline-drag-pointer-gap() -> length {
        return 6px;
    }

    public function update-outline-drag-position(window-position: Point) {
        self.outline-drag-position = {
            x: window-position.x + self.outline-drag-pointer-gap(),
            y: window-position.y + self.outline-drag-pointer-gap(),
        };
    }

    public function start-outline-drag(label: string, icon: image, window-position: Point) {
        self.outline-drag-cancelled = false;
        self.outline-drag-active = true;
        self.outline-drag-label = label;
        self.outline-drag-icon = icon;
        self.update-outline-drag-position(window-position);
    }

    public function finish-outline-drag() {
        self.outline-drag-active = false;
    }
}

export component PropertyField inherits Rectangle {
    in property <string> name;
    in property <string> value;

    height: 34px;

    HorizontalLayout {
        spacing: 10px;

        Text {
            width: 80px;
            text: root.name;
            color: StudioTheme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: StudioTheme.border;
            background: StudioTheme.panel-subtle;

            Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.value;
                color: StudioTheme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component ColorPropertyField inherits Rectangle {
    in property <string> name;
    in property <color> color-value;
    in property <string> value;

    height: 34px;

    HorizontalLayout {
        spacing: 10px;

        Text {
            width: 80px;
            text: root.name;
            color: StudioTheme.muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: StudioTheme.border;
            background: StudioTheme.panel-subtle;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 8px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: StudioTheme.border;
                    background: root.color-value;
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.value;
                    color: StudioTheme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component InspectorSection inherits VerticalLayout {
    in property <string> title;
    spacing: 10px;

    SectionTitle {
        label: root.title;
    }

    @children
}
