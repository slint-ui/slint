import { Colors } from "../style.slint";

export global Icons {
    out property <image> alert: @image-url("../assets/diagnostic-alert.svg");
    out property <image> chevron-down: @image-url("../assets/octicons/chevron-down.svg");
    out property <image> chevron-right: @image-url("../assets/octicons/chevron-right.svg");
    out property <image> image: @image-url("../assets/lucide/image.svg");
    out property <image> plus: @image-url("../assets/lucide/plus.svg");
}

export component DiagnosticBadge inherits Rectangle {
    in property <color> foreground: Colors.danger;
    in property <length> icon-inset;
    background: Colors.surface;
    border-radius: self.width / 2;
    Image {
        source: Icons.alert;
        width: parent.width - 2 * root.icon-inset;
        height: parent.height - 2 * root.icon-inset;
        colorize: root.foreground;
    }
}
