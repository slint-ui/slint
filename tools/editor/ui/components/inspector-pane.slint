import { Style, Colors, Metrics, Typography, InspectorStyle } from "../style.slint";
import { Api } from "../api.slint";
import { CanvasPresetsSection } from "inspector/canvas-presets.slint";
import { Diagnostics } from "../diagnostics.slint";
import { EdgeDivider, HorizontalResizeDivider } from "index.slint";
import { OutlinePane } from "outline-pane.slint";
import {
    InspectorAppearanceSection, InspectorBorderSection, InspectorCheckedSection, InspectorContext, InspectorCurrentIndexSection,
    InspectorEffectsSection, InspectorGeometrySection, InspectorImageSection, InspectorInputTypeSection, InspectorInteractionSection,
    InspectorLayoutAlignmentSection, InspectorLayoutSection, InspectorMouseCursorSection,
    InspectorOrientationSection, InspectorPlaceholderSection, InspectorPrimarySection, InspectorProgressSection, InspectorRangeSection, InspectorScrollBarPolicySection,
    InspectorStandardButtonKindSection, InspectorTextAlignmentSection, InspectorTextContentSection, InspectorTextWrapSection, InspectorTitleSection,
    InspectorTypographySection,
} from "inspector/sections/index.slint";
import { EditorScrollView } from "editor-scroll-view.slint";

export component InspectorPane inherits Rectangle {
    in property <InspectorStyle> style: Style.inspector-layout;
    out property <bool> palette-drag-in-outline: outline-pane.palette-drag-in-outline;

    callback outline-drag-started();
    callback outline-pane-resized(length);
    callback outline-pane-reset();

    width: Style.panes.inspector-width;
    background: Style.panel-background;
    accessible-role: AccessibleRole.complementary;
    accessible-label: @tr("Inspector and outline");
    accessible-enabled: Diagnostics.preview-editable;
    property <length> content-x: Metrics.border-width;
    private property <length> field-width: root.width - root.content-x - 2 * root.style.padding;
    in property <length> outline-pane-height: 0px;
    property <length> split-height: Style.panes.splitter-size;
    property <length> default-outline-height: (root.height - root.split-height) / 2;
    property <length> requested-outline-height: root.outline-pane-height > 0px
        ? root.outline-pane-height
        : root.default-outline-height;
    private property <length> dragged-outline-height: 0px;
    property <length> outline-height: min(
        max(Style.panes.minimum, root.dragged-outline-height > 0px ? root.dragged-outline-height : root.requested-outline-height),
        max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum),
    );
    property <length> inspector-height: root.height - root.split-height - root.outline-height;
    private property <length> drag-start-height;

    changed outline-pane-height => {
        root.dragged-outline-height = 0px;
    }
    in-out property <length> inspector-scroll-y: 0px;

    function clamp-outline-height(height: length) -> length {
        return min(height, max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum));
    }

    EdgeDivider {
        x: 0px;
        background: root.style.divider;
    }

    inspector-scroll := EditorScrollView {
        x: root.content-x;
        y: 0px;
        width: root.width - root.content-x;
        height: root.inspector-height;
        content-width: self.width;
        content-height: content.height;
        content-y <=> root.inspector-scroll-y;
        mouse-drag-pan-enabled: false;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        content := Rectangle {
            width: parent.width;
            height: content-layout.preferred-height;

            content-layout := VerticalLayout {
                width: parent.width;
                alignment: start;

                if Api.selection.highlight-index < 0: CanvasPresetsSection { }

                if InspectorContext.has-backend-rect(): InspectorGeometrySection { }

                if InspectorContext.is-title-selection(): InspectorTitleSection { }

                if InspectorContext.has-text-property-selection(): InspectorTextContentSection { }

                if ((InspectorContext.is-root-selection() && !InspectorContext.is-title-selection()) || InspectorContext.is-rectangle-selection()): InspectorAppearanceSection {
                    pane-width: root.width;
                }

                if InspectorContext.is-interaction-selection(): InspectorInteractionSection { }

                if InspectorContext.is-checked-selection(): InspectorCheckedSection { }

                if InspectorContext.has-current-index-selection(): InspectorCurrentIndexSection { }

                if InspectorContext.is-touch-area-selection(): InspectorMouseCursorSection { }

                if InspectorContext.is-primary-selection(): InspectorPrimarySection { }

                if InspectorContext.is-lineedit-selection(): InspectorInputTypeSection { }

                if InspectorContext.is-standard-button-selection(): InspectorStandardButtonKindSection { }

                if InspectorContext.is-layout-selection(): InspectorLayoutSection { }

                if InspectorContext.has-layout-alignment-selection(): InspectorLayoutAlignmentSection { }

                if InspectorContext.is-slider-selection() || InspectorContext.is-spinbox-selection(): InspectorRangeSection { }

                if InspectorContext.is-progress-selection(): InspectorProgressSection { }

                if InspectorContext.has-orientation-selection(): InspectorOrientationSection { }

                if InspectorContext.has-scrollbar-policy-selection(): InspectorScrollBarPolicySection { }

                if InspectorContext.is-rectangle-selection(): InspectorBorderSection {
                    pane-width: root.width;
                }

                if InspectorContext.is-rectangle-selection(): InspectorEffectsSection {
                    field-width: root.field-width;
                }

                if InspectorContext.is-image-selection(): InspectorImageSection {
                    field-width: root.field-width;
                }

                if InspectorContext.has-placeholder-selection(): InspectorPlaceholderSection { }

                if InspectorContext.has-typography-selection(): InspectorTypographySection {
                    field-width: root.field-width;
                }
                if InspectorContext.is-text-selection() || InspectorContext.is-styled-text-selection() || InspectorContext.has-only-horizontal-alignment(): InspectorTextAlignmentSection {
                    show-vertical: !InspectorContext.has-only-horizontal-alignment();
                }
                if InspectorContext.is-text-selection(): InspectorTextWrapSection { }
            }
        }
    }

    HorizontalResizeDivider {
        resize-label: @tr("Outline pane resize");
        value: root.outline-height;
        value-maximum: max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum);
        x: root.content-x;
        y: root.inspector-height;
        width: root.width - root.content-x;
        drag-started => {
            root.drag-start-height = root.outline-height;
        }
        dragged(delta) => {
            root.dragged-outline-height = root.clamp-outline-height(
                max(Style.panes.minimum, root.drag-start-height - delta),
            );
        }
        drag-finished(delta) => {
            if delta != 0px {
                root.outline-pane-resized(root.clamp-outline-height(
                    max(Style.panes.minimum, root.drag-start-height - delta),
                ));
            }
        }
        value-set(height) => {
            let clamped-height = root.clamp-outline-height(max(Style.panes.minimum, height));
            root.dragged-outline-height = clamped-height;
            root.outline-pane-resized(clamped-height);
        }
        reset-requested => {
            root.outline-pane-reset();
        }
    }

    outline-pane := OutlinePane {
        x: root.content-x;
        y: root.inspector-height + root.split-height;
        width: root.width - root.content-x;
        height: root.outline-height;
        drag-started => { root.outline-drag-started(); }
    }
    if !Diagnostics.preview-editable: Rectangle {
        background: Diagnostics.preview-status-visible ? Colors.surface.with-alpha(0.75) : transparent;
        TouchArea { }
        if Diagnostics.preview-status-visible: Text {
            width: parent.width - 2 * root.style.padding;
            text: @tr("Editing paused until the preview is available");
            color: Colors.muted;
            font-size: Typography.body.size;
            wrap: word-wrap;
            accessible-role: AccessibleRole.text;
            accessible-label: self.text;
        }
    }
}
