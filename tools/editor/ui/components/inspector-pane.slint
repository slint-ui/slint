import { Style, Colors, Metrics, Typography, InspectorStyle } from "../style.slint";
import { Project } from "../project.slint";
import { Api, CodeBinding, ElementInformation, InspectorNumberChange, PropertyValue, PropertyValueKind, SelectionRectangle } from "../api.slint";
import { EdgeDivider, EditorAngles, HorizontalResizeDivider } from "index.slint";
import { OutlinePane } from "outline-pane.slint";
import {
    InspectorCodeField, InspectorColorField, InspectorComboBox, InspectorComboOption,
    InspectorCornerEditor, InspectorEditableField, InspectorEffectDial, InspectorEffectSlider,
    InspectorImageAlignment, InspectorInfoIcon, InspectorPropertyRow, InspectorRotationKnob, InspectorSection,
    InspectorValueField,
} from "inspector/index.slint";
import { EditorScrollView } from "editor-scroll-view.slint";

export component InspectorPane inherits Rectangle {
    in property <InspectorStyle> style: Style.inspector-layout;
    in property <ElementInformation> element-information;
    private property <angle> shadow-drag-angle;
    private property <bool> shadow-distance-dragging;

    out property <bool> palette-drag-in-outline: outline-pane.palette-drag-in-outline;

    callback outline-drag-started();
    callback outline-pane-resized(length);
    callback outline-pane-reset();

    width: Style.panes.inspector-width;
    background: Colors.surface;
    accessible-role: AccessibleRole.complementary;
    accessible-label: "Inspector and outline";
    property <length> content-x: Metrics.border-width;
    in property <length> outline-pane-height: 0px;
    property <length> split-height: Style.panes.splitter-size;
    property <length> default-outline-height: (root.height - root.split-height) / 2;
    property <length> requested-outline-height: root.outline-pane-height > 0px
        ? root.outline-pane-height
        : root.default-outline-height;
    private property <length> dragged-outline-height: 0px;
    property <length> outline-height: min(
        max(Style.panes.minimum, root.dragged-outline-height > 0px ? root.dragged-outline-height : root.requested-outline-height),
        max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum),
    );
    property <length> inspector-height: root.height - root.split-height - root.outline-height;
    private property <length> drag-start-height;

    changed outline-pane-height => {
        root.dragged-outline-height = 0px;
    }
    in-out property <length> inspector-scroll-y: 0px;

    property <[SelectionRectangle]> selection-rects: Api.selection.highlight-index >= 0
        ? Api.highlight-positions(root.element-information.source-uri, root.element-information.offset)
        : [];
    property <[InspectorComboOption]> image-fit-options: [
        { value: "fill", label: "fill" },
        { value: "preserve", label: "preserve" },
        { value: "contain", label: "contain" },
        { value: "cover", label: "cover" },
    ];
    property <[InspectorComboOption]> text-font-weight-options: [
        { value: "100", label: "Thin" },
        { value: "200", label: "Extra Light" },
        { value: "300", label: "Light" },
        { value: "400", label: "Normal" },
        { value: "500", label: "Medium" },
        { value: "600", label: "Semi Bold" },
        { value: "700", label: "Bold" },
        { value: "800", label: "Extra Bold" },
        { value: "900", label: "Black" },
    ];
    property <[InspectorComboOption]> rectangle-effect-options: [
        { value: "none", label: "None" },
        { value: "drop", label: "Drop Shadow" },
        { value: "inner", label: "Inner Shadow" },
    ];

    property <string> selection-key: root.element-information.source-uri + ":" + root.element-information.offset + ":" + Api.selection.highlight-index;
    property <string> inspector-key: root.element-information.source-uri + ":" + root.element-information.source-version + ":" + root.element-information.offset + ":" + Api.selection.highlight-index + ":" + Api.inspector-generation;
    property <[float]> control-values: Api.inspector-values(root.inspector-key);
    function commit-inspector(name: string, value: float) -> bool {
        return Api.inspector-commit(root.inspector-key, name, value);
    }

    function has-backend-rect() -> bool {
        return Api.selection.highlight-index >= 0 && root.selection-rects.length > Api.selection.highlight-index;
    }

    function clamp-outline-height(height: length) -> length {
        return min(height, max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum));
    }

    function is-rectangle-selection() -> bool {
        return root.has-backend-rect() && root.element-information.type-name == "Rectangle";
    }

    function is-text-selection() -> bool {
        return root.has-backend-rect() && root.element-information.type-name == "Text";
    }

    function is-image-selection() -> bool {
        return root.has-backend-rect() && root.element-information.type-name == "Image";
    }

    function has-backend-image-selection() -> bool {
        return root.has-backend-rect() && root.element-information.type-name == "Image";
    }

    function is-root-selection() -> bool {
        return Api.selection.highlight-index >= 0 && Api.selection.is-root;
    }

    function selected-x() -> length {
        return root.has-backend-rect()
            ? root.selection-rects[Api.selection.highlight-index].x
            : 0px;
    }

    function selected-y() -> length {
        return root.has-backend-rect()
            ? root.selection-rects[Api.selection.highlight-index].y
            : 0px;
    }

    function selected-width() -> length {
        if root.has-backend-rect() {
            return root.selection-rects[Api.selection.highlight-index].width;
        }
        return 0px;
    }

    function selected-height() -> length {
        if root.has-backend-rect() {
            return root.selection-rects[Api.selection.highlight-index].height;
        }
        return 0px;
    }

    function selected-x-label() -> string {
        return (root.selected-x() / 1px).to-fixed(0);
    }

    function selected-y-label() -> string {
        return (root.selected-y() / 1px).to-fixed(0);
    }

    function selected-width-label() -> string {
        return (root.selected-width() / 1px).to-fixed(0);
    }

    function selected-height-label() -> string {
        return (root.selected-height() / 1px).to-fixed(0);
    }

    function commit-geometry(x-text: string, y-text: string, width-text: string, height-text: string) -> bool {
        if !x-text.is-float() || !y-text.is-float() || !width-text.is-float() || !height-text.is-float() {
            return false;
        }

        let new-position = {
            x: x-text.to-float() * 1px,
            y: y-text.to-float() * 1px,
        };
        let new-size = {
            width: width-text.to-float() * 1px,
            height: height-text.to-float() * 1px,
        };

        if new-size.width <= 0px || new-size.height <= 0px {
            return false;
        }

        if root.has-backend-rect() {
            Api.selected-element-resize(new-position.x, new-position.y, new-size.width, new-size.height);
            return true;
        }

        return false;
    }

    function preview-geometry-property(name: string, value: float) -> bool {
        if !root.has-backend-rect() {
            return false;
        }
        Api.override-selected-element-geometry(
            name == "x" ? value * 1px : root.selected-x(),
            name == "y" ? value * 1px : root.selected-y(),
            name == "width" ? value * 1px : root.selected-width(),
            name == "height" ? value * 1px : root.selected-height(),
        );
        return true;
    }

    function accept-geometry-scrub() -> bool {
        return Api.persist-selected-element-geometry();
    }

    function commit-code(property-name: string, value: string) -> bool {
        if value == "" || root.element-information.source-uri == "" {
            return false;
        }
        if !Api.test-code-binding(
            root.element-information.source-uri,
            root.element-information.source-version,
            root.element-information.offset,
            property-name,
            value,
        ) {
            return false;
        }
        return Api.set-code-binding(
            root.element-information.source-uri,
            root.element-information.source-version,
            root.element-information.offset,
            property-name,
            value,
        );
    }

    function commit-px-code(property-name: string, value: string) -> bool {
        if !value.is-float() {
            return false;
        }
        return root.commit-code(property-name, value + "px");
    }

    function field-key(property-name: string) -> string {
        return root.inspector-key + ":" + property-name;
    }

    function fill-session-key(property-name: string) -> string {
        return root.selection-key + ":" + Api.inspector-fill-generation + ":" + property-name;
    }

    function property-brush(property-name: string) -> brush {
        let property = Api.current-property-value-data(property-name);
        return property.value-resolved ? property.value-brush : transparent;
    }

    function property-string(property-name: string, fallback: string) -> string {
        let property = Api.current-property-value-data(property-name);
        if property.code == "" {
            return fallback;
        }
        if property.value-kind == PropertyValueKind.string && property.value-string != "" {
            return property.value-string;
        }
        if property.display-string != "" {
            return property.display-string;
        }
        return property.code;
    }

    function property-length-label(property-name: string, fallback: string) -> string {
        let property = Api.current-property-value-data(property-name);
        if property.code == "" {
            return fallback;
        }
        if property.value-kind == PropertyValueKind.float || property.kind == PropertyValueKind.float {
            return property.value-float.to-fixed(0);
        }
        return property.code;
    }

    function commit-codes(bindings: [CodeBinding]) -> bool {
        return Api.set-code-bindings(
            root.element-information.source-uri,
            root.element-information.source-version,
            root.element-information.offset,
            bindings,
        );
    }

    function has-shadow-property(prefix: string) -> bool {
        return Api.current-property-value-data(prefix + "color").code != ""
            || Api.current-property-value-data(prefix + "blur").code != ""
            || Api.current-property-value-data(prefix + "spread").code != ""
            || Api.current-property-value-data(prefix + "offset-x").code != ""
            || Api.current-property-value-data(prefix + "offset-y").code != "";
    }

    function rectangle-effect-index() -> int {
        if root.has-shadow-property("drop-shadow-") {
            return 1;
        }
        if root.has-shadow-property("inner-shadow-") {
            return 2;
        }
        return 0;
    }

    function rectangle-effect-value() -> string {
        let index = root.rectangle-effect-index();
        return root.rectangle-effect-options[index].label;
    }

    function current-shadow-prefix() -> string {
        return root.rectangle-effect-index() == 2 ? "inner-shadow-" : "drop-shadow-";
    }

    function shadow-number(property-name: string, fallback: float) -> float {
        let property = Api.current-property-value-data(property-name);
        if property.code == "" {
            return fallback;
        }
        if property.kind == PropertyValueKind.float || property.value-kind == PropertyValueKind.float {
            return property.value-float;
        }
        return fallback;
    }

    function shadow-color-code() -> string {
        return Api.current-property-value(root.current-shadow-prefix() + "color", "");
    }

    function shadow-color-swatch() -> brush {
        return root.property-brush(root.current-shadow-prefix() + "color");
    }

    function shadow-blur() -> float {
        return root.shadow-number(root.current-shadow-prefix() + "blur", 16);
    }

    function shadow-spread() -> float {
        return root.shadow-number(root.current-shadow-prefix() + "spread", 0);
    }

    function shadow-offset-x() -> float {
        return root.shadow-number(root.current-shadow-prefix() + "offset-x", 0);
    }

    function shadow-offset-y() -> float {
        return root.shadow-number(root.current-shadow-prefix() + "offset-y", 8);
    }

    function shadow-distance() -> float {
        let x = root.shadow-offset-x();
        let y = root.shadow-offset-y();
        return sqrt(x * x + y * y).round();
    }

    function normalized-angle(value: angle) -> angle {
        let normalized = value.mod(360deg);
        return normalized < 0deg ? normalized + 360deg : normalized;
    }

    function shadow-angle() -> angle {
        let distance = root.shadow-distance();
        return distance == 0 ? 90deg : root.normalized-angle(atan2(root.shadow-offset-y(), root.shadow-offset-x()));
    }

    function commit-shadow-number(property-name: string, value: float) -> bool {
        return Api.inspector-commit-shadow(root.inspector-key, [{ name: property-name, value: value.round() }]);
    }

    pure function shadow-offset-changes(angle: angle, distance: float) -> [InspectorNumberChange] {
        let prefix = root.current-shadow-prefix();
        let x = (angle.cos() * distance).round();
        let y = (angle.sin() * distance).round();
        return [
            { name: prefix + "offset-x", value: x == 0 ? 0 : x },
            { name: prefix + "offset-y", value: y == 0 ? 0 : y },
        ];
    }

    function commit-shadow-offsets(angle: angle, distance: float) -> bool {
        return Api.inspector-commit-shadow(root.inspector-key, root.shadow-offset-changes(angle, distance));
    }

    function shadow-code(property-name: string, fallback: string) -> string {
        let code = Api.current-property-value-data(property-name).code;
        return code != "" ? code : fallback;
    }

    function shadow-bindings(prefix: string, enabled: bool) -> [CodeBinding] {
        let color = prefix == "inner-shadow-" ? "#00000030" : "#00000040";
        return [
            { name: prefix + "color", value: enabled ? root.shadow-code(prefix + "color", color) : "" },
            { name: prefix + "blur", value: enabled ? root.shadow-code(prefix + "blur", "16px") : "" },
            { name: prefix + "spread", value: enabled ? root.shadow-code(prefix + "spread", "0px") : "" },
            { name: prefix + "offset-x", value: enabled ? root.shadow-code(prefix + "offset-x", "0px") : "" },
            { name: prefix + "offset-y", value: enabled ? root.shadow-code(prefix + "offset-y", "8px") : "" },
        ];
    }

    function set-rectangle-effect(value: string) -> bool {
        if value != "none" && value != "drop" && value != "inner" {
            return false;
        }
        Api.inspector-cancel();
        root.shadow-distance-dragging = false;
        let drop = root.shadow-bindings("drop-shadow-", value == "drop");
        let inner = root.shadow-bindings("inner-shadow-", value == "inner");
        return root.commit-codes([
            drop[0], drop[1], drop[2], drop[3], drop[4],
            inner[0], inner[1], inner[2], inner[3], inner[4],
        ]);
    }

    function quote(value: string) -> string {
        return "\"" + value + "\"";
    }

    function image-source-value() -> string {
        return Api.current-property-value("source", "");
    }

    function rectangle-background-code() -> string {
        return Api.current-property-value("background", "");
    }

    function rectangle-background-swatch() -> brush {
        return root.property-brush("background");
    }

    function text-color-code() -> string {
        return Api.current-property-value("color", "");
    }

    function text-color-swatch() -> brush {
        return root.property-brush("color");
    }

    function text-content-code() -> string {
        return Api.current-property-value("text", "\"\"");
    }

    function text-font-family-value() -> string {
        return root.property-string("font-family", "Default font");
    }

    function text-font-size-value() -> string {
        return root.property-length-label("font-size", "Default size");
    }

    function image-fit-index() -> int {
        let value = Api.current-property-value("image-fit", "fill");
        if value == "fill" {
            return 0;
        }
        if value == "preserve" {
            return 1;
        }
        if value == "contain" {
            return 2;
        }
        if value == "cover" {
            return 3;
        }
        return -1;
    }

    function image-fit-value() -> string {
        let index = root.image-fit-index();
        return index >= 0 ? root.image-fit-options[index].value : "fill";
    }

    function image-horizontal-alignment-index() -> int {
        let value = Api.current-property-value("horizontal-alignment", "center");
        if value == "left" {
            return 0;
        }
        if value == "center" {
            return 1;
        }
        if value == "right" {
            return 2;
        }
        return -1;
    }

    function image-vertical-alignment-index() -> int {
        let value = Api.current-property-value("vertical-alignment", "center");
        if value == "top" {
            return 0;
        }
        if value == "center" {
            return 1;
        }
        if value == "bottom" {
            return 2;
        }
        return -1;
    }

    function set-image-alignment(column: int, row: int) -> bool {
        if column < 0 || column > 2 || row < 0 || row > 2 {
            return false;
        }
        if column == root.image-horizontal-alignment-index() && row == root.image-vertical-alignment-index() {
            return true;
        }
        return root.commit-codes([
            { name: "horizontal-alignment", value: column == 0 ? "left" : column == 1 ? "center" : "right" },
            { name: "vertical-alignment", value: row == 0 ? "top" : row == 1 ? "center" : "bottom" },
        ]);
    }

    function text-font-weight-index() -> int {
        let value = Api.current-property-value("font-weight", "400");
        if value == "100" || value == "FontWeight.thin" || value == "thin" {
            return 0;
        }
        if value == "200" || value == "FontWeight.extra-light" || value == "extra-light" {
            return 1;
        }
        if value == "300" || value == "FontWeight.light" || value == "light" {
            return 2;
        }
        if value == "400" || value == "FontWeight.normal" || value == "normal" {
            return 3;
        }
        if value == "500" || value == "FontWeight.medium" || value == "medium" {
            return 4;
        }
        if value == "600" || value == "FontWeight.semi-bold" || value == "semi-bold" {
            return 5;
        }
        if value == "700" || value == "FontWeight.bold" || value == "bold" {
            return 6;
        }
        if value == "800" || value == "FontWeight.extra-bold" || value == "extra-bold" {
            return 7;
        }
        if value == "900" || value == "FontWeight.black" || value == "black" {
            return 8;
        }
        return -1;
    }

    function text-font-weight-label() -> string {
        let index = root.text-font-weight-index();
        return index >= 0 ? root.text-font-weight-options[index].label : "Normal";
    }

    EdgeDivider {
        x: 0px;
        background: root.style.divider;
    }

    inspector-scroll := EditorScrollView {
        x: root.content-x;
        y: 0px;
        width: root.width - root.content-x;
        height: root.inspector-height;
        content-width: self.width;
        content-height: content.height;
        content-y <=> root.inspector-scroll-y;
        mouse-drag-pan-enabled: false;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

        content := Rectangle {
            width: parent.width;
            height: content-layout.preferred-height;

            content-layout := VerticalLayout {
                width: parent.width;
                alignment: start;

                if Api.selection.highlight-index < 0 && Project.settings-available: InspectorSection {
                    title: "Project";
                    for name in ["width", "height"]: InspectorPropertyRow {
                        label: name;
                        InspectorValueField {
                            accessible-name: "Project " + name;
                            value: "\{(name == "width" ? Project.canvas-width : Project.canvas-height) / 1px}";
                            commit-key: Project.settings-key;
                            enabled: Project.settings-editable;
                            accepted(text) => { return Project.commit-canvas-dimension(self.commit-key, name, text); }
                        }
                    }
                    if Project.settings-error != "": Text {
                        text: Project.settings-error;
                        wrap: word-wrap;
                        color: Colors.muted;
                        font-size: Typography.control.size;
                        accessible-label: "Project settings error";
                    }
                }

                if root.is-root-selection(): InspectorSection {
                    title: "Size";
                    for name in ["width", "height"]: InspectorPropertyRow {
                        label: name;
                        InspectorCodeField {
                            accessible-name: "Root " + name;
                            value: Api.current-property-value-data(name).code;
                            commit-key: root.field-key(name);
                            accepted(text) => { return root.commit-code(name, text); }
                        }
                    }
                }

                if !root.is-root-selection() && (root.is-rectangle-selection() || root.is-text-selection() || root.is-image-selection()): InspectorSection {
                    title: "Geometry";
                    InspectorPropertyRow {
                        label: "Position";
                        InspectorValueField {
                            width: (parent.width - root.style.label-width - 2 * root.style.padding - 2 * root.style.row-gap) / 2;
                            accessible-name: "Position X"; prefix: "X";
                            value: root.selected-x-label(); commit-key: root.field-key("x");
                            scrubbable: true; scrub-value: root.selected-x() / 1px;
                            scrub-preview(value) => { return root.preview-geometry-property("x", value); }
                            scrub-accepted(value) => { return root.accept-geometry-scrub(); }
                            scrub-canceled(value) => { root.preview-geometry-property("x", value); }
                            accepted(text) => { return root.commit-geometry(text, root.selected-y-label(), root.selected-width-label(), root.selected-height-label()); }
                        }
                        InspectorValueField {
                            width: (parent.width - root.style.label-width - 2 * root.style.padding - 2 * root.style.row-gap) / 2;
                            accessible-name: "Position Y"; prefix: "Y";
                            value: root.selected-y-label(); commit-key: root.field-key("y");
                            scrubbable: true; scrub-value: root.selected-y() / 1px;
                            scrub-preview(value) => { return root.preview-geometry-property("y", value); }
                            scrub-accepted(value) => { return root.accept-geometry-scrub(); }
                            scrub-canceled(value) => { root.preview-geometry-property("y", value); }
                            accepted(text) => { return root.commit-geometry(root.selected-x-label(), text, root.selected-width-label(), root.selected-height-label()); }
                        }
                    }
                    InspectorPropertyRow {
                        label: "Size";
                        InspectorValueField {
                            width: (parent.width - root.style.label-width - 2 * root.style.padding - 2 * root.style.row-gap) / 2;
                            accessible-name: "Width"; prefix: "W";
                            value: root.selected-width-label(); commit-key: root.field-key("width");
                            scrubbable: true; scrub-value: root.selected-width() / 1px;
                            scrub-has-minimum: true; scrub-minimum: 1;
                            scrub-preview(value) => { return root.preview-geometry-property("width", value); }
                            scrub-accepted(value) => { return root.accept-geometry-scrub(); }
                            scrub-canceled(value) => { root.preview-geometry-property("width", value); }
                            accepted(text) => { return root.commit-geometry(root.selected-x-label(), root.selected-y-label(), text, root.selected-height-label()); }
                        }
                        InspectorValueField {
                            width: (parent.width - root.style.label-width - 2 * root.style.padding - 2 * root.style.row-gap) / 2;
                            accessible-name: "Height"; prefix: "H";
                            value: root.selected-height-label(); commit-key: root.field-key("height");
                            scrubbable: true; scrub-value: root.selected-height() / 1px;
                            scrub-has-minimum: true; scrub-minimum: 1;
                            scrub-preview(value) => { return root.preview-geometry-property("height", value); }
                            scrub-accepted(value) => { return root.accept-geometry-scrub(); }
                            scrub-canceled(value) => { root.preview-geometry-property("height", value); }
                            accepted(text) => { return root.commit-geometry(root.selected-x-label(), root.selected-y-label(), root.selected-width-label(), text); }
                        }
                    }
                    InspectorPropertyRow {
                        label: "Rotation";
                        height: Metrics.control-large;
                        knob := InspectorRotationKnob {
                            value: root.control-values[0];
                            commit-key: root.inspector-key;
                            preview(value) => { return Api.inspector-preview(root.inspector-key, "transform-rotation", value); }
                            accepted(value) => { return root.commit-inspector("transform-rotation", value); }
                            canceled => { Api.inspector-cancel(); }
                        }
                        InspectorValueField {
                            width: parent.width - root.style.label-width - 2 * root.style.padding - 2 * root.style.row-gap - knob.width;
                            accessible-name: "Rotation"; prefix: "°";
                            value: "\{EditorAngles.normalize(knob.visual-value * 1deg) / 1deg}";
                            commit-key: root.inspector-key;
                            scrubbable: true; scrub-value: knob.visual-value;
                            scrub-preview(value) => { return Api.inspector-preview(root.inspector-key, "transform-rotation", value); }
                            scrub-accepted(value) => { return root.commit-inspector("transform-rotation", value); }
                            scrub-canceled(value) => { Api.inspector-cancel(); }
                            accepted(text) => { return text.is-float() && root.commit-inspector("transform-rotation", text.to-float()); }
                        }
                    }
                }

                if (root.is-root-selection() || root.is-rectangle-selection() || root.is-text-selection()): InspectorSection {
                    title: "APPEARANCE";
                    use-shared-title: true;

                    VerticalLayout {
                        padding-left: root.style.padding;
                        padding-right: root.style.padding;
                        spacing: Metrics.space-small;

                        Text {
                            height: Metrics.icon-small;
                            text: root.is-text-selection() ? "Color" : "Fill";
                            color: Colors.muted;
                            font-size: Typography.control.size;
                            vertical-alignment: center;
                        }

                        if root.is-root-selection(): InspectorColorField {
                            property <PropertyValue> background-value: Api.current-property-value-data("background");
                            accessible-name: "Root background";
                            value: Api.current-property-value("background", "");
                            swatch: background-value.value-resolved ? background-value.value-brush : transparent;
                            commit-key: root.field-key("background");
                            preview-key: root.field-key("background");
                            session-key: root.fill-session-key("background");
                            property-name: "background";
                            picker-anchor-x: root.style.label-width + root.style.row-gap + Style.inspector-field.padding-inline;
                            picker-anchor-y: -Metrics.icon-small - Metrics.space-small;
                            width: root.width - 2 * root.style.padding;
                            accepted(text) => {
                                return root.commit-code("background", text);
                            }
                        }

                        if root.is-rectangle-selection(): InspectorColorField {
                            accessible-name: "Rectangle background";
                            target-size: { width: root.selected-width(), height: root.selected-height() };
                            value: root.rectangle-background-code();
                            swatch: root.rectangle-background-swatch();
                            commit-key: root.field-key("background");
                            preview-key: root.field-key("background");
                            session-key: root.fill-session-key("background");
                            property-name: "background";
                            picker-anchor-x: root.style.label-width + root.style.row-gap + Style.inspector-field.padding-inline;
                            picker-anchor-y: -Metrics.icon-small - Metrics.space-small;
                            width: root.width - 2 * root.style.padding;
                            accepted(text) => {
                                return root.commit-code("background", text);
                            }
                        }

                        if root.is-text-selection(): InspectorColorField {
                            accessible-name: "Text color";
                            target-size: { width: root.selected-width(), height: root.selected-height() };
                            value: root.text-color-code();
                            swatch: root.text-color-swatch();
                            commit-key: root.field-key("color");
                            preview-key: root.field-key("color");
                            session-key: root.fill-session-key("color");
                            property-name: "color";
                            picker-anchor-x: root.style.label-width + root.style.row-gap + Style.inspector-field.padding-inline;
                            picker-anchor-y: -Metrics.icon-small - Metrics.space-small;
                            width: root.width - 2 * root.style.padding;
                            accepted(text) => {
                                return root.commit-code("color", text);
                            }
                        }
                    }
                    if root.is-rectangle-selection(): HorizontalLayout {
                        padding-left: root.style.padding;
                        padding-right: root.style.padding;
                        InspectorCornerEditor {
                            width: root.width - 2 * root.style.padding - Metrics.border-width;
                            values: [root.control-values[1], root.control-values[2], root.control-values[3], root.control-values[4]];
                            maximum: min(root.selected-width(), root.selected-height()) / 2px;
                            selection-key: root.selection-key;
                            commit-key: root.inspector-key;
                            preview(value) => { return Api.inspector-preview(root.inspector-key, "all-corners", value); }
                            accepted(index, value) => {
                                return root.commit-inspector(index < 0 ? "all-corners" : index == 0 ? "border-top-left-radius" : index == 1 ? "border-top-right-radius" : index == 2 ? "border-bottom-left-radius" : "border-bottom-right-radius", value);
                            }
                            canceled => { Api.inspector-cancel(); }
                        }
                    }
                }

                if root.is-rectangle-selection(): InspectorSection {
                    title: "Effects";

                    VerticalLayout {
                        padding-left: root.style.padding;
                        padding-right: root.style.padding;
                        spacing: Metrics.space-compact;

                        InspectorComboBox {
                            accessible-name: "Rectangle effect";
                            value: root.rectangle-effect-value();
                            selected-index: root.rectangle-effect-index();
                            options: root.rectangle-effect-options;
                            wide: true;
                            popup-available-height: max(Style.inspector-field.height, root.absolute-position.y + root.height - self.absolute-position.y - Metrics.space-medium);
                            accepted(text) => {
                                return root.set-rectangle-effect(text);
                            }
                        }

                        if root.rectangle-effect-index() != 0: HorizontalLayout {
                            spacing: root.style.column-gap;
                            cross-axis-alignment: center;

                            InspectorEffectDial {
                                accessible-name: "Shadow angle";
                                commit-key: root.inspector-key + ":" + root.current-shadow-prefix();
                                value: root.shadow-angle();
                                preview(angle) => {
                                    return Api.inspector-preview-shadow(root.inspector-key, root.shadow-offset-changes(angle, root.shadow-distance()));
                                }
                                accepted(angle) => {
                                    return root.commit-shadow-offsets(angle, root.shadow-distance());
                                }
                                canceled => { Api.inspector-cancel(); }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Metrics.space-small;

                                Text {
                                    height: Metrics.icon-small;
                                    text: "Color";
                                    color: Colors.foreground;
                                    font-size: Typography.caption.size;
                                    font-weight: FontWeight.semi-bold;
                                    vertical-alignment: center;
                                }

                                InspectorColorField {
                                    accessible-name: "Shadow color";
                                    target-size: { width: root.selected-width(), height: root.selected-height() };
                                    value: root.shadow-color-code();
                                    swatch: root.shadow-color-swatch();
                                    commit-key: root.field-key(root.current-shadow-prefix() + "color");
                                    preview-key: root.field-key(root.current-shadow-prefix() + "color");
                                    session-key: root.fill-session-key(root.current-shadow-prefix() + "color");
                                    property-name: root.current-shadow-prefix() + "color";
                                    accepted(text) => {
                                        return root.commit-code(root.current-shadow-prefix() + "color", text);
                                    }
                                }
                            }
                        }

                        if root.rectangle-effect-index() != 0: InspectorEffectSlider {
                            accessible-name: "Shadow distance";
                            label: "Distance";
                            value: root.shadow-distance();
                            minimum: 0;
                            maximum: 96;
                            commit-key: root.field-key(root.current-shadow-prefix() + "offset");
                            started => {
                                root.shadow-drag-angle = root.shadow-angle();
                                root.shadow-distance-dragging = true;
                            }
                            preview(value) => {
                                return Api.inspector-preview-shadow(root.inspector-key, root.shadow-offset-changes(root.shadow-drag-angle, value));
                            }
                            accepted(value) => {
                                let accepted = root.commit-shadow-offsets(root.shadow-distance-dragging ? root.shadow-drag-angle : root.shadow-angle(), value);
                                root.shadow-distance-dragging = false;
                                return accepted;
                            }
                            canceled => { root.shadow-distance-dragging = false; Api.inspector-cancel(); }
                        }

                        if root.rectangle-effect-index() != 0: InspectorEffectSlider {
                            accessible-name: "Shadow blur";
                            label: "Blur";
                            value: root.shadow-blur();
                            minimum: 0;
                            maximum: 128;
                            commit-key: root.field-key(root.current-shadow-prefix() + "blur");
                            preview(value) => {
                                return Api.inspector-preview-shadow(root.inspector-key, [{ name: root.current-shadow-prefix() + "blur", value: value }]);
                            }
                            accepted(value) => {
                                return root.commit-shadow-number(root.current-shadow-prefix() + "blur", value);
                            }
                            canceled => { Api.inspector-cancel(); }
                        }

                        if root.rectangle-effect-index() != 0: InspectorEffectSlider {
                            accessible-name: "Shadow spread";
                            label: "Spread";
                            value: root.shadow-spread();
                            minimum: -64;
                            maximum: 64;
                            commit-key: root.field-key(root.current-shadow-prefix() + "spread");
                            preview(value) => {
                                return Api.inspector-preview-shadow(root.inspector-key, [{ name: root.current-shadow-prefix() + "spread", value: value }]);
                            }
                            accepted(value) => {
                                return root.commit-shadow-number(root.current-shadow-prefix() + "spread", value);
                            }
                            canceled => { Api.inspector-cancel(); }
                        }
                    }
                }

                if root.has-backend-image-selection(): InspectorSection {
                    title: "Image";

                    VerticalLayout {
                        padding-left: root.style.padding;
                        padding-right: root.style.padding;
                        spacing: Metrics.space-compact;

                        InspectorCodeField {
                            accessible-name: "Image source";
                            prefix: "Source";
                            value: root.image-source-value();
                            commit-key: root.field-key("source");
                            accepted(text) => {
                                return root.commit-code("source", text);
                            }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-compact;

                            HorizontalLayout {
                                spacing: Metrics.space-compact;
                                cross-axis-alignment: center;

                                Text {
                                    text: "Image fit";
                                    color: Colors.foreground;
                                    font-size: Typography.caption.size;
                                    font-weight: FontWeight.semi-bold;
                                    vertical-alignment: center;
                                }

                                InspectorInfoIcon {
                                    activated => {
                                        Platform.open-url("https://docs.slint.dev/latest/docs/slint/reference/elements/image/#image-fit");
                                    }
                                }
                            }

                            InspectorComboBox {
                                accessible-name: "Image fit";
                                value: root.image-fit-value();
                                selected-index: root.image-fit-index();
                                options: root.image-fit-options;
                                wide: true;
                                popup-available-height: max(Style.inspector-field.height, root.absolute-position.y + root.height - self.absolute-position.y - Metrics.space-medium);
                                accepted(text) => {
                                    return text != "" && root.commit-code("image-fit", text);
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Metrics.space-compact;

                            HorizontalLayout {
                                width: root.style.content-width;
                                spacing: Metrics.space-compact;

                                Text {
                                    text: @tr("Alignment");
                                    color: Colors.foreground;
                                    font-size: Typography.caption.size;
                                    font-weight: FontWeight.semi-bold;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: alignment.selected-label == "" ? @tr("Custom") : alignment.selected-label;
                                    color: Colors.muted;
                                    font-size: Typography.caption.size;
                                    horizontal-alignment: right;
                                }
                            }

                            alignment := InspectorImageAlignment {
                                selected-column: root.image-horizontal-alignment-index();
                                selected-row: root.image-vertical-alignment-index();
                                chosen(column, row) => { root.set-image-alignment(column, row); }
                            }
                        }
                    }
                }

                if root.is-text-selection(): InspectorSection {
                    title: "Content";

                    HorizontalLayout {
                        padding-left: root.style.padding;
                        padding-right: root.style.padding;

                        InspectorCodeField {
                            accessible-name: "Text content";
                            prefix: "Text";
                            value: root.text-content-code();
                            commit-key: root.field-key("text");
                            accepted(text) => {
                                return root.commit-code("text", text);
                            }
                        }
                    }
                }

                if root.is-text-selection(): InspectorSection {
                    title: "Typography";

                    VerticalLayout {
                        padding-left: root.style.padding;
                        spacing: Metrics.space-compact;

                        InspectorEditableField {
                            accessible-name: "Font family";
                            value: root.text-font-family-value();
                            commit-key: root.field-key("font-family");
                            wide: true;
                            accepted(text) => {
                                return text != "" && root.commit-code("font-family", root.quote(text));
                            }
                        }

                        HorizontalLayout {
                            spacing: root.style.column-gap;

                            InspectorComboBox {
                                accessible-name: "Font weight";
                                value: root.text-font-weight-label();
                                selected-index: root.text-font-weight-index();
                                options: root.text-font-weight-options;
                                popup-available-height: max(Style.inspector-field.height, root.absolute-position.y + root.height - self.absolute-position.y - Metrics.space-medium);
                                accepted(text) => {
                                    return text != "" && root.commit-code("font-weight", text);
                                }
                            }

                            InspectorEditableField {
                                accessible-name: "Font size";
                                value: root.text-font-size-value();
                                commit-key: root.field-key("font-size");
                                accepted(text) => {
                                    return text.is-float()
                                        ? root.commit-px-code("font-size", text)
                                        : root.commit-code("font-size", text);
                                }
                            }
                        }

                    }
                }
            }
        }
    }

    HorizontalResizeDivider {
        resize-label: "Outline pane resize";
        value: root.outline-height;
        value-maximum: max(Style.panes.minimum, root.height - root.split-height - Style.panes.minimum);
        x: root.content-x;
        y: root.inspector-height;
        width: root.width - root.content-x;
        height: root.split-height;
        drag-started => {
            root.drag-start-height = root.outline-height;
        }
        dragged(delta) => {
            root.dragged-outline-height = root.clamp-outline-height(
                max(Style.panes.minimum, root.drag-start-height - delta),
            );
        }
        drag-finished(delta) => {
            if delta != 0px {
                root.outline-pane-resized(root.clamp-outline-height(
                    max(Style.panes.minimum, root.drag-start-height - delta),
                ));
            }
        }
        value-set(height) => {
            let clamped-height = root.clamp-outline-height(max(Style.panes.minimum, height));
            root.dragged-outline-height = clamped-height;
            root.outline-pane-resized(clamped-height);
        }
        reset-requested => {
            root.outline-pane-reset();
        }
    }

    outline-pane := OutlinePane {
        x: root.content-x;
        y: root.inspector-height + root.split-height;
        width: root.width - root.content-x;
        height: root.outline-height;
        drag-started => { root.outline-drag-started(); }
    }
}
