import { Style, Metrics, Colors } from "../style.slint";

export component ShellTitleBar inherits WindowMoveArea {
    callback zoom-requested();

    height: Style.shell.top-bar-height;

    Rectangle {
        background: Style.titlebar-background;
    }

    Rectangle {
        y: parent.height - 1px;
        height: Metrics.border-width;
        background: Colors.border;
    }

    touch-area := TouchArea {
        double-clicked => { root.zoom-requested(); }
    }

    @children
}
