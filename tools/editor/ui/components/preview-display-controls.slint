import { PreviewDisplays } from "../preview-displays.slint";
import { Colors, Metrics, Style, SegmentStyle } from "../style.slint";
import { InputSurface } from "input-surface.slint";
import { EditorIcons } from "index.slint";
import { DisplayManager } from "display-manager.slint";
import { ButtonBase } from "../../controls/src/headless.slint";

component OrientationSegment inherits ButtonBase {
    in property <SegmentStyle> style: Style.segment;
    in property <bool> landscape;
    in property <bool> selected;
    in property <string> label;
    private property <string> tooltip: PreviewDisplays.can-rotate ? root.label
        : @tr("Not supported for {}", PreviewDisplays.selected-name);
    text: root.label;
    focus-on-click: true;
    horizontal-stretch: 1;
    accessible-checked: root.selected;
    accessible-description: root.tooltip;
    background << Rectangle {
        background: root.selected ? root.style.selected-surface : root.hovered ? root.style.hover : transparent;
        border-radius: root.style.radius;
        border-width: root.selected ? Metrics.border-width : 0px;
        border-color: root.style.border;
        if root.focus-visible: focus-ring := Rectangle {
            border-radius: root.style.radius;
            border-width: Metrics.focus-width;
            border-color: root.style.focus-border;
        }
    }
    content << Image {
        width: 16px; height: 16px;
        source: @image-url("../assets/lucide/smartphone.svg");
        transform-rotation: root.landscape ? 90deg : 0deg;
        colorize: root.selected ? Colors.accent : Colors.muted;
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }
}

export component PreviewDisplayControls inherits Rectangle {
    in property <bool> enabled: true;
    width: 296px;
    height: Style.field.height;

    selector := InputSurface {
        x: 0px; y: 0px;
        width: 208px;
        enabled: root.enabled;
        focused: selector-button.focus-visible;
        forward-focus: selector-button;
        hovered: selector-button.hovered;
        accessible-role: combobox;
        accessible-label: @tr("Preview display");
        accessible-value: PreviewDisplays.selected-name;
        accessible-expanded: popup.is-open;
        accessible-action-expand => { if root.enabled { popup.show(); } }
        accessible-action-default => { if root.enabled { popup.show(); } }

        HorizontalLayout {
            padding-left: selector.style.padding-inline;
            padding-right: selector.style.padding-end;
            spacing: Metrics.space-small;
            cross-axis-alignment: center;
            Text {
                horizontal-stretch: 1;
                text: PreviewDisplays.selected-name;
                color: selector.paint.foreground;
                font-size: selector.style.text.size;
                vertical-alignment: center;
                overflow: elide;
            }
            Image {
                width: Metrics.icon-medium; height: Metrics.icon-medium;
                source: EditorIcons.select-chevron;
                colorize: selector.style.appearance.muted;
            }
        }
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if root.enabled && event.text == Key.DownArrow {
                    popup.show();
                    return accept;
                }
                return reject;
            }
            selector-button := ButtonBase {
                width: parent.width; height: parent.height;
                enabled: root.enabled;
                focus-on-click: true;
                accessible-role: none;
                clicked => {
                    if popup.is-open { popup.close(); } else { popup.show(); }
                }
            }
        }
        popup := PopupWindow {
            x: -12px; y: selector.height - 4px;
            width: 344px; height: manager.height + 24px;
            close-policy: close-on-click-outside;
            manager := DisplayManager {
                x: 12px; y: 8px;
                closed => { popup.close(); }
            }
        }
    }

    orientation := InputSurface {
        x: selector.width + 12px; y: 0px;
        width: 76px;
        enabled: root.enabled && PreviewDisplays.can-rotate;
        opacity: self.enabled ? 1 : 0.2;
        accessible-role: groupbox;
        accessible-label: @tr("Preview orientation");
        HorizontalLayout {
            x: 2px; y: 2px;
            width: parent.width - 4px; height: parent.height - 4px;
            spacing: 0px;
            OrientationSegment {
                enabled: orientation.enabled;
                height: parent.height;
                label: @tr("Portrait");
                selected: PreviewDisplays.can-rotate && !PreviewDisplays.landscape;
                clicked => { if root.enabled { PreviewDisplays.set-landscape(false); } }
            }
            OrientationSegment {
                enabled: orientation.enabled;
                height: parent.height;
                label: @tr("Landscape");
                landscape: true;
                selected: PreviewDisplays.can-rotate && PreviewDisplays.landscape;
                clicked => { if root.enabled { PreviewDisplays.set-landscape(true); } }
            }
        }
    }
}
