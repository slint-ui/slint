import { PropertyValue } from "properties.slint";
import { Range, ElementInformation } from "editor-types.slint";
export { Range, ElementInformation } from "editor-types.slint";

export enum CoordinateSpace { Root, Parent }

export enum ResizeHandle { top, right, bottom, left, top-left, top-right, bottom-right, bottom-left }

export struct Geometry {
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct GeometryResult {
    valid: bool,
    geometry: Geometry,
}

export enum CanvasCorner {
    top-left,
    top-right,
    bottom-right,
    bottom-left,
}

export enum ElementKind {
    none,
    component,
    rectangle,
    text,
    styled-text,
    image,
    touch-area,
    flickable,
    swipe-gesture-handler,
    scale-rotate-gesture-handler,
    drag-area,
    drop-area,
    focus-scope,
    text-input,
    horizontal-layout,
    vertical-layout,
    grid-layout,
    flexbox-layout,
    window-move-area,
    widget,
}

export enum ElementLibrarySection { primitives, libraries, project }

/// A palette item whose kind selects its icon and drag payload.
export struct ElementLibraryEntry {
    label: string,
    kind: ElementKind,
    source-uri: string,
}

/// A named palette group with entries sorted by label.
export struct ElementLibraryGroup {
    section: ElementLibrarySection,
    label: string,
    entries: [ElementLibraryEntry],
}

/// One device discovered as a possible remote-preview target.
export struct RemoteViewerInfo {
    /// User-facing name, e.g. "Simon's iPhone".
    name: string,
    /// mDNS `instance.service-type.`; the model's unique key.
    fullname: string,
    /// Sanitized mDNS `.local` hostname.
    host: string,
    port: int,
    /// All resolved addresses, tried in order.
    addresses: [string],
    /// Whether the viewer speaks our protocol version.
    compatible: bool,
    /// If incompatible, a short reason to show to the user.
    incompatible-reason: string,
    /// Monotonic seconds-since-process-start at the last mDNS ServiceResolved.
    /// The prune timer drops entries older than 60 s.
    last-seen-secs: int,
}

export enum RemoteConnectionState {
    Disconnected,
    Connecting,
    /// A session dropped and is being redialed. Connecting elsewhere
    /// replaces the redial.
    Reconnecting,
    /// The viewer is showing a pairing code and is waiting for it to be
    /// typed in here.
    PairingRequired,
    /// The viewer has pairing disabled; waiting for the user to accept the
    /// unencrypted connection or cancel.
    UnpairedWarning,
    Connected,
    Failed,
}

export enum UpdateState {
    UpToDate,
    Available,
    Downloading,
    ReadyToInstall,
    Installing,
    // The update is deployed, but the running process still has the old one
    // mounted: only a fresh launch picks it up.
    RestartRequired,
    Error,
}

export enum EditorSurfaceMode {
    component,
    image,
}

/// What kind of layout we are working with
export enum LayoutKind {
    None,
    Horizontal,
    Vertical,
    Grid,
    Flexbox,
}

/// A rectangular region that is selected
export struct SelectionRectangle {
    x: length,
    y: length,
    width: length,
    height: length,
    angle: angle,
    transform-rotation: angle,
    // False when the element renders as a parallelogram, which these fields cannot describe.
    // Editing its geometry is refused, so don't offer it.
    describes-element: bool,
    top-left-radius: length,
    top-right-radius: length,
    bottom-left-radius: length,
    bottom-right-radius: length,
}

/// The topmost selectable element under a canvas position.
export struct HoveredElement {
    valid: bool,
    is-selected: bool,
    is-over-selected-element: bool,
    element-path: string,
    source-uri: string,
    element-offset: int,
    type-name: string,
    geometry: [SelectionRectangle],
}

export global Hover {
    in-out property <HoveredElement> element;
    in property <int> preview-generation;
    in-out property <string> tree-source-uri;
    in-out property <int> tree-offset: -1;
    in-out property <string> tree-type-name;
    out property <[SelectionRectangle]> geometry: tree-source-uri != ""
        ? Api.highlight-positions(tree-source-uri, tree-offset) : element.geometry;
    pure callback element-at(x: length, y: length, enter-component: bool) -> HoveredElement;
    /// Called with an empty `source-uri` when nothing is hovered anymore.
    callback hovered-changed(source-uri: string, offset: int);

    private property <{ source-uri: string, offset: int }> hovered: tree-source-uri != ""
        ? { source-uri: tree-source-uri, offset: tree-offset }
        : element.valid ? { source-uri: element.source-uri, offset: element.element-offset } : { source-uri: "", offset: -1 };
    changed hovered => { root.hovered-changed(self.hovered.source-uri, self.hovered.offset); }
}

/// A `Selection`
export struct Selection {
    highlight-index: int,
    layout-data: LayoutKind,
    is-interactive: bool,
    is-moveable: bool,
    is-resizable: bool,
    is-wrappable: bool,
}

/// A mark showing where an element will show up when dropped into the current location
export struct DropMark {
    x1: length,
    y1: length,
    x2: length,
    y2: length,
}

export struct SelectionStackFrame {
    width: percent,
    height: percent,
    x: percent,
    y: percent,
    is-in-root-component: bool,
    is-layout: bool,
    is-interactive: bool,
    is-selected: bool,
    type-name: string,
    file-name: string,
    element-path: string,
    element-offset: int,
    id: string,
}

export enum SelectionStackFilter {
    Nothing,
    Layouts,
    Interactive,
    Others,
    LayoutsAndInteractive,
    LayoutsAndOthers,
    InteractiveAndOthers,
    Everything,
}

export struct PropertyValueTable {
    is-array: bool,
    headers: [string],
    values: [[PropertyValue]],
}

export enum PreviewDataKind {
    Value,
    Json,
    Table,
}

export struct PreviewData {
    name: string,
    has-getter: bool,
    has-setter: bool,
    kind: PreviewDataKind,
}

/// Information on exported components and their properties
export struct PropertyContainer {
    container-name: string,
    container-id: string,
    properties: [PreviewData],
}

export struct InlineTextEditStart {
    success: bool,
    text: string,
    color: brush,
}

export global InlineTextEdit {
    in property <bool> can-edit;
    in property <bool> active;
    in property <bool> commit-pending;
    in property <float> scale: 1;
    in property <bool> grow-width;

    callback begin() -> InlineTextEditStart;
    callback commit(text: string) -> bool;
    private property <bool> deferred-selection;
    private property <Point> deferred-selection-position;

    public function defer-selection(position: Point) {
        self.deferred-selection-position = position;
        self.deferred-selection = true;
    }

    callback finished(accepted: bool) -> bool;
    finished(accepted) => {
        let select = self.deferred-selection && accepted;
        self.deferred-selection = false;
        if select { Api.select-at(self.deferred-selection-position.x, self.deferred-selection-position.y, false); }
        return select;
    }
}

/// A node in the outline tree
export struct OutlineTreeNode {
    indent-level: int,
    has-children: bool,
    is-expanded: bool,
    is-last-child: bool,
    icon-kind: ElementKind,
    element-type: string,
    element-id: string,
    uri: string,
    offset: int,

}

export enum DropLocation {
    onto,
    before,
    after,
}

export enum FileTreeNodeKind {
    folder,
    file,
    image,
}

export struct FileTreeNode {
    label: string,
    rename-selection-end: int,
    path: string,
    parent-path: string,
    indent-level: int,
    has-children: bool,
    is-expanded: bool,
    is-selected: bool,
    is-slint-file: bool,
    show-selected-guide: bool,
    kind: FileTreeNodeKind,
}

export struct ImageAssetPreview {
    path: string,
    relative-path: string,
    format: string,
    image: image,
    error: string,
}

export global Api {
    out property <length> minimum-square-resize-size: 80px;
    // # Properties
    // ## General preview state:
    // enable editing mode
    in property <bool> show-preview-ui: true;
    // std-widgets are used (=> show style dropdown)
    in-out property <bool> uses-widgets;
    in-out property <UpdateState> update-state: UpdateState.UpToDate;
    in-out property <float> update-download-progress: 0.0;
    in-out property <string> update-version;
    in-out property <string> update-error;
    in property <bool> focus-previewed-element;
    in property <string> preview-default-font-family;
    in property <float> preview-default-font-size: 12;
    in property <int> preview-default-font-weight;
    callback check-for-update();

    // ## Style:
    // All the known styles
    in property <[string]> known-styles;
    // The index of the current style within `known-styles`
    in-out property <int> current-style-index;
    // control, but command on macOS
    in-out property <string> control-key-name: "control";

    // ## Element library
    in property <[ElementLibraryGroup]> element-library;
    in property <[ElementLibraryGroup]> project-element-library;
    pure callback element-library-has-matches(groups: [ElementLibraryGroup], query: string, section: ElementLibrarySection) -> bool;
    pure callback element-library-normalize-query(query: string) -> string;
    pure callback element-library-filter-entries(entries: [ElementLibraryEntry], query: string) -> [ElementLibraryEntry];

    // ## Drawing Area
    // Borders around things
    pure callback highlight-positions(source-uri: string, offset: int) -> [SelectionRectangle];
    in-out property <Selection> selection;
    in-out property <DropMark> drop-mark;
    // The actual preview
    in-out property <component-factory> preview-area;

    pure callback new-component-data(type-name: string, source-uri: string) -> data-transfer;
    pure callback move-element-instance-data(component-uri: string, offset: int) -> data-transfer;

    // set to true to resize
    in property <bool> resize-to-preferred-size: false;

    // ## Property Editor
    in-out property <ElementInformation> current-element;

    // ## Outline
    in-out property <[OutlineTreeNode]> outline;
    callback outline-select-element(uri: string, offset: int, notify_editor: bool);
    callback outline-set-expanded(row: int, expanded: bool);
    // Data is either a "file:offset" for an element to move, or just a component index.
    callback outline-drop(data: data-transfer, uri: string, offset: int, location: DropLocation);
    callback outline-can-drop(data: data-transfer, uri: string, offset: int, location: DropLocation) -> bool;
    callback outline-add-tab(uri: string, offset: int);

    // ## File Tree
    in-out property <bool> startup-wizard-visible;
    in-out property <EditorSurfaceMode> editor-surface-mode: EditorSurfaceMode.component;
    in-out property <ImageAssetPreview> selected-image-asset;
    in-out property <int> image-nine-slice-top;
    in-out property <int> image-nine-slice-right;
    in-out property <int> image-nine-slice-bottom;
    in-out property <int> image-nine-slice-left;
    callback file-tree-toggle(path: string);
    callback file-tree-select(path: string);
    callback file-tree-rename(path: string, name: string) -> string;
    pure callback image-nine-slice-expression(path: string, top: int, right: int, bottom: int, left: int) -> string;
    pure callback image-nine-slice-preview(source: image, top: int, right: int, bottom: int, left: int) -> image;
    callback copy-nine-slice-expression(value: string);
    callback copy-file-path(path: string);
    callback open-file(path: string);

    // ## preview data

    in-out property <[PropertyContainer]> preview-data;

    // # Callbacks

    // ## Style:
    callback style-changed();

    // ## Component life-cycle:

    // Create a new component
    callback add-new-component();

    // Add an existing component
    pure callback can-drop(data: data-transfer, x: length, y: length, on-drop-area: bool) -> bool;
    callback drop(data: data-transfer, x: length, y: length);
    callback drop-with-geometry(data: data-transfer, hit-position: Point, position: Point, size: Size);

    callback rename-component(old-name: string, defined-at: string, new-name: string);

    callback override-selected-element-border-radius(corner: CanvasCorner, radius: length, single-corner: bool);
    callback reset-selected-element-border-radius(corner: CanvasCorner);
    callback persist-selected-element-border-radius();
    callback selected-element-resize(x: length, y: length, width: length, height: length);
    callback persist-selected-element-geometry() -> bool;
    callback selected-element-rotate(rotation: angle);
    callback root-geometry-to-parent-geometry(geometry: Geometry) -> GeometryResult;
    callback override-selected-element-geometry(x: length, y: length, width: length, height: length, coordinate-space: CoordinateSpace) -> GeometryResult;
    callback override-selected-element-rotation(rotation: angle);

    callback selected-element-delete();
    callback selected-element-wrap-in-layout(layout: string);
    callback selected-element-copy();
    callback selected-element-cut();
    callback paste-element(at-pointer: bool, x: length, y: length);

    // ## Element selection:
    callback selection-stack-at(x: length, y: length) -> [SelectionStackFrame];
    pure callback filter-sort-selection-stack(model: [SelectionStackFrame], filter_text: string, filter: SelectionStackFilter) -> [SelectionStackFrame];
    pure callback find-selected-selection-stack-frame([SelectionStackFrame]) -> SelectionStackFrame;
    callback select-element(file: string, offset: int, x: length, y: length);

    callback select-at(x: length, y: length, enter-component: bool);
    callback select-behind(x: length, y: length, enter-component: bool, reverse: bool);
    callback reselect();
    callback unselect();

    // ## Change Editor:

    // Show a component in the editor
    callback show-component(name: string, url: string);
    // Show a position consisting of `line` and `column` in a `file` in the editor
    callback show-document(file: string, line: int, column: int);
    // Show a position consisting of `line` and `column` in a `file` in the editor
    callback show-document-offset-range(url: string, start_offset: int, end_offset: int, take-focus: bool);

    // ## Drawing Area
    // Preview some other component
    callback show-preview-for(name: string, url: string);
    callback reload-preview();

    pure callback window-active() -> bool;

    // ## Property Editor

    callback set-element-id(element-url: string, element-version: int, element-offset: int, new-id: string);

    // ## preview data
    pure callback get-property-value(component: string, name: string) -> PropertyValue;
    pure callback get-property-value-table(component: string, name: string) -> PropertyValueTable;
    pure callback set-property-value-table(component: string, name: string, table: [[PropertyValue]], is-array: bool) -> string;

    pure callback insert-row-into-value-table(table: PropertyValueTable, insert-before: int);
    pure callback remove-row-from-value-table(table: PropertyValueTable, remove-row: int);

    pure callback set-json-preview-data(component: string, name: string, json-value: string, send-telemetry: bool) -> string;

    // ## Undo/Redo
    callback undo();
    callback redo();
    in-out property <bool> undo-enabled: false;
    in-out property <bool> redo-enabled: false;

    // ## Remote preview
    in-out property <[RemoteViewerInfo]> remote-discovered-viewers;
    in-out property <RemoteConnectionState> remote-connection-state;
    in-out property <string> remote-connection-error;
    in-out property <string> remote-connection-target;
    callback remote-start-discovery();
    callback remote-stop-discovery();
    callback remote-connect(addresses: [string], port: int);
    callback remote-connect-manual(host-port: string);
    callback remote-disconnect();
    callback remote-submit-pairing-code(code: string);
    callback remote-cancel-pairing();
    /// Connect to the pairing-disabled viewer the warning is about.
    callback remote-accept-unpaired();

}
