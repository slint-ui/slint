    out property <ImageRailStyle> image-rail: Theme.current == ThemeKind.dark ? DarkTheme.image-rail : LightTheme.image-rail;
    out property <ImageDetailsStyle> image-details: Theme.current == ThemeKind.dark ? DarkTheme.image-details : LightTheme.image-details;
