    out property <RadiusSliderStyle> radius-slider: Theme.current == ThemeKind.dark ? DarkTheme.radius-slider : LightTheme.radius-slider;
    out property <RotationDialStyle> rotation-dial: Theme.current == ThemeKind.dark ? DarkTheme.rotation-dial : LightTheme.rotation-dial;
    out property <ComboMenuStyle> combo-menu: Theme.current == ThemeKind.dark ? DarkTheme.combo-menu : LightTheme.combo-menu;
    out property <RecentFillsStyle> recent-fills: SharedStyle.recent-fills;
    out property <ColorPlaneStyle> color-plane: Theme.current == ThemeKind.dark ? DarkTheme.color-plane : LightTheme.color-plane;
    out property <ColorSliderStyle> color-slider: Theme.current == ThemeKind.dark ? DarkTheme.color-slider : LightTheme.color-slider;
    out property <ColorHexStyle> color-hex: SharedStyle.color-hex;
