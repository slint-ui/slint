    out property <TreeRowStyle> tree-row: Theme.current == ThemeKind.dark ? DarkTheme.tree-row : LightTheme.tree-row;
    out property <RenameFieldStyle> rename-field: SharedStyle.rename-field;
    out property <TreeGuidesStyle> tree-guides: Theme.current == ThemeKind.dark ? DarkTheme.tree-guides : LightTheme.tree-guides;
    out property <TreeDropStyle> tree-drop: Theme.current == ThemeKind.dark ? DarkTheme.tree-drop : LightTheme.tree-drop;
    out property <PaletteRowStyle> palette-row: Theme.current == ThemeKind.dark ? DarkTheme.palette-row : LightTheme.palette-row;
    out property <ButtonStyle> primary-button: Theme.current == ThemeKind.dark ? DarkTheme.primary-button : LightTheme.primary-button;
    out property <ButtonStyle> compact-button: Theme.current == ThemeKind.dark ? DarkTheme.compact-button : LightTheme.compact-button;
    out property <ButtonStyle> welcome-button: Theme.current == ThemeKind.dark ? DarkTheme.welcome-button : LightTheme.welcome-button;
