    out property <SegmentStyle> segment: Theme.current == ThemeKind.dark ? DarkTheme.segment : LightTheme.segment;
    out property <SidebarToggleStyle> sidebar-toggle: Theme.current == ThemeKind.dark ? DarkTheme.sidebar-toggle : LightTheme.sidebar-toggle;
    out property <ColorControlsStyle> color-controls: Theme.current == ThemeKind.dark ? DarkTheme.color-controls : LightTheme.color-controls;
    out property <GradientStopsStyle> gradient-stops: Theme.current == ThemeKind.dark ? DarkTheme.gradient-stops : LightTheme.gradient-stops;
    out property <ImageAssetEditorStyle> image-asset-editor: Theme.current == ThemeKind.dark ? DarkTheme.image-asset-editor : LightTheme.image-asset-editor;
