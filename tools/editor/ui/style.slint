}

export enum ThemeKind { system, light, dark }

export global Metrics {
    out property <length> space-tight: 2px;
    out property <length> space-small: 4px;
    out property <length> space-compact: 6px;
    out property <length> space-regular: 8px;
    out property <length> space-medium: 12px;
    out property <length> space-large: 16px;
    out property <length> space-section: 24px;
    out property <length> border-width: 1px;
    out property <length> focus-width: 2px;
    out property <length> hairline-width: 0.5px;
    out property <length> radius-small: 4px;
    out property <length> radius-medium: 6px;
    out property <length> radius-large: 8px;
    out property <length> control-compact: 24px;
    out property <length> control-small: 28px;
    out property <length> control-medium: 32px;
    out property <length> control-large: 36px;
    out property <length> icon-medium: 16px;
    out property <length> icon-small: 12px;
    out property <length> icon-large: 18px;
    out property <float> disabled-opacity: 0.55;
}

export global Typography {
    out property <TextStyle> caption: { size: 11px };
    out property <TextStyle> control: { size: 12px };
    out property <TextStyle> body: { size: 13px };
    out property <TextStyle> action: { size: 14px };
    out property <TextStyle> heading: { size: 16px, weight: FontWeight.bold };
    out property <TextStyle> hero: { size: 34px, weight: FontWeight.semi-bold };
    out property <string> family: "Inter";
    out property <TextStyle> section-heading: { size: 12px, weight: FontWeight.bold };
    out property <TextStyle> strong-body: { size: 13px, weight: FontWeight.bold };
}

export global Motion {
    out property <duration> fast: 120ms;
    out property <duration> feedback: 150ms;
    out property <duration> layout: 180ms;
}

export global SharedStyle {
    out property <ShellStyle> shell;

    out property <PanesStyle> panes;

    out property <CollapsedSidebarStyle> collapsed-sidebar;

    out property <length> image-tabs-height: Metrics.control-medium;

    out property <ImageErrorStyle> image-error;

    out property <WelcomeHeroStyle> welcome-hero;

    out property <length> welcome-actions-gap: Metrics.space-regular;

    out property <RecentProjectListStyle> recent-project-list;

    out property <WelcomeBrandStyle> welcome-brand: {
        background: @linear-gradient(155deg, #32e1ff 0%, #0b89ff 52%, #115bea 100%),
        shadow: { color: #00000033, blur: 11px, offset-y: 6px },
    };

    out property <RadiusHandleStyle> radius-handle;

    out property <DropIndicatorStyle> drop-indicator;

    out property <TransparencyGridStyle> transparency-grid;

    out property <length> inspector-layout-padding: Metrics.space-medium;

    out property <length> rotation-dial-size: 32px;

    out property <length> rotation-dial-inset: 2px;

    out property <RecentFillsStyle> recent-fills;

    out property <ColorHexStyle> color-hex;

    out property <GradientStopRowStyle> gradient-stop-row;

    out property <GradientFieldsStyle> gradient-fields;

    out property <RenameFieldStyle> rename-field: {
        background: Palette.control-background,
        border: Palette.border,
    };
}

export global LightTheme {
    private property <color> accent: #0d99ff;
    out property <ColorPalette> colors: {
        background: #f6f8fa,
        surface: #ffffff,
        subtle: #f6f8fa,
        foreground: #1f2328,
        muted: #6e7781,
        border: #d0d7de,
        subtle-border: #eaeef2,
        accent: root.accent,
        focus: #52aeff,
        selection: root.accent.with-alpha(0.14),
        subtle-selection: root.accent.with-alpha(0.10),
        focus-background: root.accent.with-alpha(0.12),
        text-selection: root.accent.with-alpha(0.28),
        on-accent: #ffffff,
        danger: #cf222e,
    };

    out property <ShadowStyle> popup: { color: #64748b30, blur: 12px, offset-y: 4px };
    out property <ShadowStyle> floating: { color: #64748b28, blur: 18px, offset-y: 8px };

    out property <PaletteCardStyle> palette-card: {
        background: LightTheme.colors.subtle.with-alpha(0.72),
        icon-background: LightTheme.colors.surface.with-alpha(0.72),
        icon: LightTheme.colors.muted.with-alpha(0.82),
        border: LightTheme.colors.border.with-alpha(0.82),
        muted-icon: LightTheme.colors.muted.with-alpha(0.72),
    };

    out property <DialogStyle> dialog: {
        border: #c8cbd2,
        background: #ffffff,
        footer-background: #fafafa,
        footer-border: #e1e2e6,
        shadow: { color: #161b233d, blur: 24px, offset-y: 12px },
        error: LightTheme.error-notice,
        close-button: LightTheme.primary-button,
    };

    out property <ErrorNoticeStyle> error-notice: {
        icon-background: #fce6e5,
        icon-foreground: #b3261e,
        border: #e0c5c2,
        background: #fff7f6,
        foreground: #7a2925,
        radius: Metrics.radius-medium,
        icon-text: { size: 20px },
    };

    out property <UpdateStatusStyle> update-status: {
        error: #b42318,
    };

    out property <ImageTabsStyle> image-tabs: {
        height: SharedStyle.image-tabs-height,
        group-height: SharedStyle.image-tabs-height + 2 * Metrics.space-small,
        normal: { background: transparent, foreground: LightTheme.colors.muted, border: LightTheme.colors.border },
        hover: { background: LightTheme.colors.subtle, foreground: LightTheme.colors.muted, border: LightTheme.colors.border },
        selected: { background: LightTheme.colors.surface, foreground: LightTheme.colors.foreground, border: LightTheme.colors.border },
        focus-border: LightTheme.colors.focus,
        radius: Metrics.radius-medium,
    };

    out property <ImageRailStyle> image-rail: {
        background: white.with-alpha(0.4),
        border: #cbd5e166,
    };

    out property <ImageDetailsStyle> image-details: {
        shadow: { color: #64748b25, blur: 18px, offset-y: 8px },
        background: LightTheme.colors.surface,
        border: LightTheme.colors.border,
        radius: Metrics.radius-large,
        padding: Metrics.space-medium,
        gap: Metrics.space-regular,
        heading: { size: Typography.control.size, weight: FontWeight.extra-bold },
        field: LightTheme.image-field,
        syntax: LightTheme.image-syntax,
        copy: LightTheme.copy-button,
    };

    out property <ImageFieldStyle> image-field: {
        background: #f5f5f5cc,
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        foreground: LightTheme.colors.foreground,
        muted: LightTheme.colors.muted,
        text: Typography.control,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-compact,
    };

    out property <ImageSyntaxStyle> image-syntax: {
        background: LightTheme.inspector-field.normal.background,
        text: Typography.caption,
        radius: Metrics.radius-small,
        padding-inline: Metrics.space-regular,
        padding-block: Metrics.space-compact,
    };

    out property <ImagePreviewStyle> image-preview: {
        border: #cbd5e166,
        background: LightTheme.colors.surface.with-alpha(0.76),
        canvas: LightTheme.canvas-surface.background.with-alpha(0.72),
        shadow: { color: #64748b12, blur: 8px, offset-y: 3px },
    };

    out property <ImageCanvasStyle> image-canvas: {
        shadow: { color: #64748b30, blur: 24px, offset-y: 14px },
    };

    out property <WelcomeShellStyle> welcome-shell: {
        stage: #c9c9c9,
        background: #ffffff,
        sidebar: #f5f5f6,
        foreground: #252527,
        muted: #797a7d,
        border: #98999d,
        shadow: { color: #00000030, blur: 18px, offset-y: 8px },
    };

    out property <WelcomeActionsStyle> welcome-actions: {
        height: 2 * LightTheme.welcome-button.height + SharedStyle.welcome-actions-gap,
        gap: SharedStyle.welcome-actions-gap,
    };

    out property <RecentProjectRowStyle> recent-project-row: {
        radius: Metrics.radius-medium,
        padding-right: Metrics.space-medium,
        gap: Metrics.space-regular,
        text-gap: Metrics.space-tight,
        hover: LightTheme.welcome-button.hover.background,
        foreground: LightTheme.welcome-shell.foreground,
        muted: LightTheme.welcome-shell.muted,
        padding-left: LightTheme.welcome-button.padding-inline,
    };

    out property <CanvasSurfaceStyle> canvas-surface: {
        background: #eef2f7,
        grid: LightTheme.grid,
    };

    out property <GridStyle> grid: {
        color: #00000008,
    };

    out property <ArtboardStyle> artboard: {
        background: #ffffff,
        shadow: { color: #64748b30, blur: 30px, offset-y: 18px },
        border: LightTheme.colors.border,
    };

    out property <SelectionFrameStyle> selection-frame: {
        accent: #0b99fe,
    };

    out property <GradientOverlayStyle> gradient-overlay: {
        endpoint-shadow: { color: #0008, blur: 3px, offset-y: 0px },
        axis-shadow: { color: #000a, blur: 2px, offset-y: 0px },
        marker: LightTheme.gradient-marker,
        endpoint-background: LightTheme.colors.on-accent,
        focus-border: LightTheme.colors.focus,
    };

    out property <NineSliceStyle> nine-slice: {
        label-border: #ffffff,
        label-shadow: { color: #00000055, blur: 8px, offset-y: 2px },
