    out property <ColorSliderStyle> color-slider: {
        shadow: { color: #00000070, blur: 2px, offset-y: 0px },
        thumb-border: DarkTheme.colors.on-accent,
        radius: Metrics.radius-large,
    };

    out property <GradientRampStyle> gradient-ramp: {
        height: Metrics.space-small + DarkTheme.inspector-field.height + DarkTheme.gradient-marker.size + Metrics.space-compact,
        inset: DarkTheme.gradient-marker.size / 2,
    };

    out property <InfoIconStyle> info-icon: {
        text: { size: 10px, weight: FontWeight.semi-bold },
        foreground: DarkTheme.colors.muted,
        border: DarkTheme.colors.muted.with-alpha(0.72),
        accent: DarkTheme.colors.accent,
        hover: DarkTheme.colors.subtle-selection,
    };

    out property <CopyButtonStyle> copy-button: {
        button: DarkTheme.copy-action,
    };

    out property <TreeRowStyle> tree-row: {
        hover-background: #383838,
        selected-background: DarkTheme.colors.accent.with-alpha(0.22),
        foreground: DarkTheme.colors.foreground,
        muted: DarkTheme.colors.muted,
        accent: DarkTheme.colors.accent,
        directory-icon: DarkTheme.colors.accent,
        height: Metrics.control-medium,
        font-size: Typography.body.size,
        radius: Metrics.radius-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        toggle-width: Metrics.icon-medium,
        icon-size: Metrics.icon-medium,
        focus-width: Metrics.focus-width,
    };

    out property <TreeGuidesStyle> tree-guides: {
        guide: DarkTheme.inspector-layout.divider,
        guide-width: Metrics.border-width,
        selected-guide: #474747,
        file-guide: DarkTheme.inspector-layout.divider,
    };

    out property <TreeDropStyle> tree-drop: {
        drop-background: DarkTheme.colors.accent.with-alpha(0.14),
        drop-border-width: Metrics.border-width,
        drop-line-height: Metrics.focus-width,
        root-drop-height: Metrics.space-regular,
    };

    out property <PaletteRowStyle> palette-row: {
        height: Metrics.control-large,
        radius: Metrics.radius-medium,
        hover: DarkTheme.colors.subtle,
        selected: DarkTheme.colors.subtle-selection,
        foreground: DarkTheme.colors.foreground,
        selected-foreground: DarkTheme.colors.focus,
        disabled-opacity: Metrics.disabled-opacity,
        text: Typography.control,
    };

    out property <ButtonStyle> primary-button: {
        height: Metrics.control-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.strong-body,
        normal: { background: #196bd6, foreground: DarkTheme.colors.on-accent, border: DarkTheme.colors.border },
        hover: { background: #2073dd, foreground: DarkTheme.colors.on-accent, border: DarkTheme.colors.border },
        pressed: { background: #135bb9, foreground: DarkTheme.colors.on-accent, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        focus-border: DarkTheme.colors.focus,
        disabled-opacity: Metrics.disabled-opacity,
        icon-color: DarkTheme.colors.muted,
    };

    out property <ButtonStyle> compact-button: {
        height: Metrics.control-small,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.control,
        normal: { background: transparent, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        hover: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        pressed: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        focus-border: DarkTheme.colors.focus,
        disabled-opacity: Metrics.disabled-opacity,
        icon-color: DarkTheme.colors.muted,
    };

    out property <ButtonStyle> welcome-button: {
        height: Metrics.control-large,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-medium,
        radius: Metrics.control-large / 2,
        border-width: Metrics.border-width,
        text: { size: Typography.action.size, weight: FontWeight.extra-bold },
        normal: { background: #424347, foreground: DarkTheme.welcome-shell.foreground, border: DarkTheme.colors.border },
        hover: { background: #4d4f54, foreground: DarkTheme.welcome-shell.foreground, border: DarkTheme.colors.border },
        pressed: { background: #55575d, foreground: DarkTheme.welcome-shell.foreground, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        focus-border: DarkTheme.colors.focus,
        disabled-opacity: Metrics.disabled-opacity,
        icon-color: DarkTheme.welcome-shell.muted,
    };

    out property <ButtonStyle> inspector-icon-button: {
        height: Metrics.icon-large,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: 3.5px,
        border-width: Metrics.border-width,
        text: Typography.control,
        normal: { background: transparent, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        hover: { background: DarkTheme.inspector-field.normal.background, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        pressed: { background: DarkTheme.colors.focus-background, foreground: DarkTheme.colors.accent, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        focus-border: DarkTheme.colors.accent,
        disabled-opacity: Metrics.disabled-opacity,
        icon-color: DarkTheme.colors.muted,
    };

    out property <FieldStyle> field: {
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-regular,
        text: Typography.body,
        normal: { background: DarkTheme.colors.surface, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        hover: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        focus: { background: DarkTheme.colors.surface, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        muted: DarkTheme.colors.muted,
        focus-border: DarkTheme.colors.focus,
        selection: DarkTheme.colors.text-selection,
    };

    out property <FieldStyle> inspector-field: {
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-compact,
        text: Typography.control,
        normal: { background: #383838, foreground: DarkTheme.colors.foreground, border: #4b4b4b},
        hover: { background: #414141, foreground: DarkTheme.colors.foreground, border: #4b4b4b},
        focus: { background: DarkTheme.colors.surface, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        disabled: { background: ( #383838).with-alpha(0.65), foreground: DarkTheme.colors.muted, border: #4b4b4b},
        muted: DarkTheme.colors.muted,
        focus-border: DarkTheme.colors.accent,
        selection: DarkTheme.colors.text-selection,
    };

    out property <SegmentStyle> segment: {
        height: DarkTheme.inspector-field.height,
        radius: DarkTheme.inspector-field.radius,
        background: DarkTheme.inspector-field.normal.background,
        hover: DarkTheme.inspector-field.hover.background,
        foreground: DarkTheme.colors.foreground,
        muted: DarkTheme.colors.muted,
        selected-surface: DarkTheme.colors.surface,
        border: DarkTheme.inspector-layout.divider,
        focus-border: DarkTheme.colors.accent,
        text: Typography.control,
    };

    out property <SidebarToggleStyle> sidebar-toggle: {
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        normal: { background: DarkTheme.colors.surface, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        hover: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        selected: { background: DarkTheme.colors.selection, foreground: DarkTheme.colors.focus, border: DarkTheme.colors.focus },
    };

    out property <ColorControlsStyle> color-controls: {
        plane: DarkTheme.color-plane,
        slider: DarkTheme.color-slider,
        hex: SharedStyle.color-hex,
        row-height: DarkTheme.combo-menu.row-height,
        gap: Metrics.space-medium,
    };

    out property <GradientStopsStyle> gradient-stops: {
        ramp: DarkTheme.gradient-ramp,
        marker: DarkTheme.gradient-marker,
        row: SharedStyle.gradient-stop-row,
        gap: Metrics.space-regular,
    };

    out property <ImageAssetEditorStyle> image-asset-editor: {
        canvas: DarkTheme.canvas-surface,
        rail: DarkTheme.image-rail,
        tabs: DarkTheme.image-tabs,
        preview: DarkTheme.image-preview,
        details: DarkTheme.image-details,
        nine-slice: DarkTheme.nine-slice,
        image: DarkTheme.image-canvas,
        error: SharedStyle.image-error,
    };

    out property <ButtonStyle> copy-action: {
        height: Metrics.control-compact,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-small,
        border-width: Metrics.border-width,
        text: { size: Typography.control.size, weight: FontWeight.extra-bold },
        normal: { background: DarkTheme.inspector-field.normal.background, foreground: DarkTheme.colors.foreground, border: DarkTheme.inspector-layout.divider },
        hover: { background: DarkTheme.inspector-field.hover.background, foreground: DarkTheme.colors.foreground, border: DarkTheme.inspector-layout.divider },
        pressed: { background: DarkTheme.colors.selection, foreground: DarkTheme.colors.foreground, border: DarkTheme.colors.border },
        disabled: { background: DarkTheme.colors.subtle, foreground: DarkTheme.colors.muted, border: DarkTheme.colors.border },
        focus-border: DarkTheme.colors.focus,
        disabled-opacity: Metrics.disabled-opacity,
        icon-color: DarkTheme.colors.muted,
    };

    out property <CornerModeStyle> corner-mode: {
        selected-background: DarkTheme.primary-button.normal.background,
        width: Metrics.control-small,
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        background: DarkTheme.inspector-field.normal.background,
        foreground: DarkTheme.colors.foreground,
        muted: DarkTheme.colors.muted,
        focus-border: DarkTheme.colors.accent,
    };

    out property <CornerEditorStyle> corner-editor: {
        gap: Metrics.space-compact,
        mode: DarkTheme.corner-mode,
        slider: DarkTheme.radius-slider,
        field: DarkTheme.inspector-field,
    };

    out property <ColorFieldStyle> color-field: {
        decorative: DarkTheme.colors.muted.with-alpha(0.35),
        field: DarkTheme.inspector-field,
        swatch-border: DarkTheme.colors.muted,
    };
}

export global Theme {
    in property <ThemeKind> preference: ThemeKind.system;
    out property <ThemeKind> current: root.preference == ThemeKind.system
        ? (Palette.color-scheme == ColorScheme.dark ? ThemeKind.dark : ThemeKind.light)
        : root.preference;
    out property <ColorPalette> colors: root.current == ThemeKind.dark ? DarkTheme.colors : LightTheme.colors;
}

export global Colors {
    out property <color> background: Theme.colors.background;
    out property <color> surface: Theme.colors.surface;
    out property <color> subtle: Theme.colors.subtle;
    out property <color> foreground: Theme.colors.foreground;
    out property <color> muted: Theme.colors.muted;
    out property <color> border: Theme.colors.border;
    out property <color> subtle-border: Theme.colors.subtle-border;
    out property <color> accent: Theme.colors.accent;
    out property <color> focus: Theme.colors.focus;
    out property <color> selection: Theme.colors.selection;
    out property <color> subtle-selection: Theme.colors.subtle-selection;
    out property <color> focus-background: Theme.colors.focus-background;
    out property <color> text-selection: Theme.colors.text-selection;
    out property <color> on-accent: Theme.colors.on-accent;
    out property <color> danger: Theme.colors.danger;
}

export global Elevation {
    out property <ShadowStyle> popup: Theme.current == ThemeKind.dark ? DarkTheme.popup : LightTheme.popup;
    out property <ShadowStyle> floating: Theme.current == ThemeKind.dark ? DarkTheme.floating : LightTheme.floating;
}

export global Style {
    out property <ShellStyle> shell: SharedStyle.shell;
