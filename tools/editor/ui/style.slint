export global Theme {
    out property <ThemeKind> current: Palette.color-scheme == ColorScheme.dark ? ThemeKind.dark : ThemeKind.light;

    out property <ColorPalette> colors: root.current == ThemeKind.dark ? DarkTheme.colors : LightTheme.colors;
    out property <ShellTheme> shell: root.current == ThemeKind.dark ? {
        palette-card: DarkTheme.palette-card,
        dialog: DarkTheme.dialog,
        error-notice: DarkTheme.error-notice,
        status-error: DarkTheme.status-error,
    } : {
        palette-card: LightTheme.palette-card,
        dialog: LightTheme.dialog,
        error-notice: LightTheme.error-notice,
        status-error: LightTheme.status-error,
    };

    out property <ImageTheme> image: root.current == ThemeKind.dark ? {
        image-tabs: DarkTheme.image-tabs,
        image-rail: DarkTheme.image-rail,
        image-details: DarkTheme.image-details,
        image-field: DarkTheme.image-field,
        syntax-background: DarkTheme.syntax-background,
        image-preview: DarkTheme.image-preview,
        canvas-shadow: DarkTheme.canvas-shadow,
    } : {
        image-tabs: LightTheme.image-tabs,
        image-rail: LightTheme.image-rail,
        image-details: LightTheme.image-details,
        image-field: LightTheme.image-field,
        syntax-background: LightTheme.syntax-background,
        image-preview: LightTheme.image-preview,
        canvas-shadow: LightTheme.canvas-shadow,
    };

    out property <WelcomeTheme> welcome: root.current == ThemeKind.dark ? {
        welcome-shell: DarkTheme.welcome-shell,
        recent-project-row: DarkTheme.recent-project-row,
    } : {
        welcome-shell: LightTheme.welcome-shell,
        recent-project-row: LightTheme.recent-project-row,
    };

    out property <CanvasTheme> canvas: root.current == ThemeKind.dark ? {
        background: DarkTheme.background,
        grid-color: DarkTheme.grid-color,
        artboard: DarkTheme.artboard,
        selection-accent: DarkTheme.selection-accent,
    } : {
        background: LightTheme.background,
        grid-color: LightTheme.grid-color,
        artboard: LightTheme.artboard,
        selection-accent: LightTheme.selection-accent,
    };

    out property <OverlayTheme> overlay: root.current == ThemeKind.dark ? {
        gradient-overlay: DarkTheme.gradient-overlay,
        slice-label-border: DarkTheme.slice-label-border,
        tooltip-paint: DarkTheme.tooltip-paint,
        drag-preview: DarkTheme.drag-preview,
        floating-panel: DarkTheme.floating-panel,
        marker-inactive: DarkTheme.marker-inactive,
    } : {
        gradient-overlay: LightTheme.gradient-overlay,
        slice-label-border: LightTheme.slice-label-border,
        tooltip-paint: LightTheme.tooltip-paint,
        drag-preview: LightTheme.drag-preview,
        floating-panel: LightTheme.floating-panel,
        marker-inactive: LightTheme.marker-inactive,
    };

    out property <InspectorTheme> inspector: root.current == ThemeKind.dark ? {
        divider: DarkTheme.divider,
        fill-picker: DarkTheme.fill-picker,
        rotation-dial: DarkTheme.rotation-dial,
        combo-menu: DarkTheme.combo-menu,
    } : {
        divider: LightTheme.divider,
        fill-picker: LightTheme.fill-picker,
        rotation-dial: LightTheme.rotation-dial,
        combo-menu: LightTheme.combo-menu,
    };

    out property <PickerTheme> picker: root.current == ThemeKind.dark ? {
        color-plane: DarkTheme.color-plane,
        slider-thumb-border: DarkTheme.slider-thumb-border,
        info-icon: DarkTheme.info-icon,
    } : {
        color-plane: LightTheme.color-plane,
        slider-thumb-border: LightTheme.slider-thumb-border,
        info-icon: LightTheme.info-icon,
    };

    out property <NavigationTheme> navigation: root.current == ThemeKind.dark ? {
        tree-row: DarkTheme.tree-row,
        guide: DarkTheme.guide,
        selected-guide: DarkTheme.selected-guide,
        file-guide: DarkTheme.file-guide,
        drop-background: DarkTheme.drop-background,
        palette-row: DarkTheme.palette-row,
    } : {
        tree-row: LightTheme.tree-row,
        guide: LightTheme.guide,
        selected-guide: LightTheme.selected-guide,
        file-guide: LightTheme.file-guide,
        drop-background: LightTheme.drop-background,
        palette-row: LightTheme.palette-row,
    };

    out property <ButtonsTheme> buttons: root.current == ThemeKind.dark ? {
        primary-button: DarkTheme.primary-button,
        compact-button: DarkTheme.compact-button,
        welcome-button: DarkTheme.welcome-button,
        inspector-icon-button: DarkTheme.inspector-icon-button,
        copy-action: DarkTheme.copy-action,
    } : {
        primary-button: LightTheme.primary-button,
        compact-button: LightTheme.compact-button,
        welcome-button: LightTheme.welcome-button,
        inspector-icon-button: LightTheme.inspector-icon-button,
        copy-action: LightTheme.copy-action,
    };

    out property <FieldsTheme> fields: root.current == ThemeKind.dark ? {
        field: DarkTheme.field,
        inspector-field: DarkTheme.inspector-field,
        color-field: DarkTheme.color-field,
    } : {
        field: LightTheme.field,
        inspector-field: LightTheme.inspector-field,
        color-field: LightTheme.color-field,
    };

    out property <ControlsTheme> controls: root.current == ThemeKind.dark ? {
        segment: DarkTheme.segment,
        sidebar-toggle: DarkTheme.sidebar-toggle,
        corner-mode: DarkTheme.corner-mode,
    } : {
        segment: LightTheme.segment,
        sidebar-toggle: LightTheme.sidebar-toggle,
        corner-mode: LightTheme.corner-mode,
    };

    out property <ShadowStyle> floating-shadow: root.current == ThemeKind.dark ? DarkTheme.floating : LightTheme.floating;
}

export global Colors {
    out property <color> background: Theme.colors.background;
    out property <color> surface: Theme.colors.surface;
    out property <color> subtle: Theme.colors.subtle;
    out property <color> foreground: Theme.colors.foreground;
    out property <color> muted: Theme.colors.muted;
    out property <color> border: Theme.colors.border;
    out property <color> subtle-border: Theme.colors.subtle-border;
    out property <color> accent: Theme.colors.accent;
    out property <color> focus: Theme.colors.focus;
    out property <color> selection: Theme.colors.selection;
    out property <color> focus-background: Theme.colors.focus-background;
    out property <color> on-accent: Theme.colors.on-accent;
    out property <color> danger: Theme.colors.danger;
}

export global Style {
    out property <ScrollIndicatorStyle> scroll-indicator: {
        color: Colors.foreground.with-alpha(0.4),
        active-color: Colors.foreground.with-alpha(0.6),
    };

    out property <ShellStyle> shell;

    out property <PanesStyle> panes;

    out property <CollapsedSidebarStyle> collapsed-sidebar;

    out property <WelcomeHeroStyle> welcome-hero;

    out property <RecentProjectListStyle> recent-project-list;

    out property <WelcomeBrandStyle> welcome-brand: {
        background: @linear-gradient(155deg, #32e1ff 0%, #0b89ff 52%, #115bea 100%),
        shadow: { color: #00000033, blur: 11px, offset-y: 6px },
    };

    out property <RadiusHandleStyle> radius-handle;

    out property <TransparencyGridStyle> transparency-grid;

    out property <PaletteCardStyle> palette-card: {
        background: Theme.shell.palette-card.background,
        icon-background: Theme.shell.palette-card.icon-background,
        icon: Theme.shell.palette-card.icon,
        border: Theme.shell.palette-card.border,
        muted-icon: Theme.shell.palette-card.muted-icon,
    };

    out property <DialogStyle> dialog: {
        error: root.error-notice,
        close-button: root.primary-button,
        border: Theme.shell.dialog.border,
        background: Theme.shell.dialog.background,
        footer-background: Theme.shell.dialog.footer-background,
        footer-border: Theme.shell.dialog.footer-border,
        shadow: Theme.shell.dialog.shadow,
    };

    private property <ErrorNoticeStyle> error-notice: {
        radius: Metrics.radius-medium,
        icon-text: { size: 20px },
        icon-background: Theme.shell.error-notice.icon-background,
        icon-foreground: Theme.shell.error-notice.icon-foreground,
        border: Theme.shell.error-notice.border,
        background: Theme.shell.error-notice.background,
        foreground: Theme.shell.error-notice.foreground,
    };

    out property <UpdateStatusStyle> update-status: {
        error: Theme.shell.status-error,
    };

    out property <ImageTabsStyle> image-tabs: {
        height: Metrics.control-medium,
        group-height: Metrics.control-medium + 2 * Metrics.space-small,
        radius: Metrics.radius-medium,
        normal: Theme.image.image-tabs.normal,
        hover: Theme.image.image-tabs.hover,
        selected: Theme.image.image-tabs.selected,
        focus-border: Theme.image.image-tabs.focus-border,
    };

    private property <ImageRailStyle> image-rail: {
        background: Theme.image.image-rail.background,
        border: Theme.image.image-rail.border,
    };

    out property <ImageDetailsStyle> image-details: {
        radius: Metrics.radius-large,
        padding: Metrics.space-medium,
        gap: Metrics.space-regular,
        heading: { size: Typography.control.size, weight: FontWeight.extra-bold },
        field: root.image-field,
        syntax: root.image-syntax,
        copy: root.copy-button,
        shadow: Theme.image.image-details.shadow,
        background: Theme.image.image-details.background,
        border: Theme.image.image-details.border,
    };

    out property <ImageFieldStyle> image-field: {
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        text: Typography.control,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-compact,
        background: Theme.image.image-field.background,
        foreground: Theme.image.image-field.foreground,
        muted: Theme.image.image-field.muted,
    };

    out property <ImageSyntaxStyle> image-syntax: {
        text: Typography.caption,
        radius: Metrics.radius-small,
        padding-inline: Metrics.space-regular,
        padding-block: Metrics.space-compact,
        background: Theme.image.syntax-background,
    };

    private property <ImagePreviewStyle> image-preview: {
        border: Theme.image.image-preview.border,
        background: Theme.image.image-preview.background,
        canvas: Theme.image.image-preview.canvas,
        shadow: Theme.image.image-preview.shadow,
    };

    private property <ImageCanvasStyle> image-canvas: {
        shadow: Theme.image.canvas-shadow,
    };

    out property <WelcomeShellStyle> welcome-shell: {
        stage: Theme.welcome.welcome-shell.stage,
        background: Theme.welcome.welcome-shell.background,
        sidebar: Theme.welcome.welcome-shell.sidebar,
        foreground: Theme.welcome.welcome-shell.foreground,
        muted: Theme.welcome.welcome-shell.muted,
        border: Theme.welcome.welcome-shell.border,
        shadow: Theme.welcome.welcome-shell.shadow,
    };

    out property <WelcomeActionsStyle> welcome-actions: {
        height: 2 * root.welcome-button.height + Metrics.space-regular,
        gap: Metrics.space-regular,
    };

    out property <RecentProjectRowStyle> recent-project-row: {
        radius: Metrics.radius-medium,
        padding-right: Metrics.space-medium,
        gap: Metrics.space-regular,
        text-gap: Metrics.space-tight,
        padding-left: root.welcome-button.padding-inline,
        hover: Theme.welcome.recent-project-row.hover,
        foreground: Theme.welcome.recent-project-row.foreground,
        muted: Theme.welcome.recent-project-row.muted,
    };

    out property <CanvasSurfaceStyle> canvas-surface: {
        grid: root.grid,
        background: Theme.canvas.background,
    };

    out property <GridStyle> grid: {
        color: Theme.canvas.grid-color,
    };

    out property <ArtboardStyle> artboard: {
        background: Theme.canvas.artboard.background,
        border: Theme.canvas.artboard.border,
    };

    out property <SelectionFrameStyle> selection-frame: {
        accent: Theme.canvas.selection-accent,
    };

    out property <GradientOverlayStyle> gradient-overlay: {
        endpoint-shadow: { color: #0008, blur: 3px, offset-y: 0px },
        axis-shadow: { color: #000a, blur: 2px, offset-y: 0px },
        marker: root.gradient-marker,
        endpoint-background: Theme.overlay.gradient-overlay.endpoint-background,
        focus-border: Theme.overlay.gradient-overlay.focus-border,
    };

    out property <NineSliceStyle> nine-slice: {
        label-shadow: { color: #00000055, blur: 8px, offset-y: 2px },
        text: { size: Typography.caption.size, weight: FontWeight.black },
        label-border: Theme.overlay.slice-label-border,
    };

    out property <TooltipStyle> tooltip: {
        shadow: { color: #33415535, blur: 12px, offset-y: 4px },
        radius: Metrics.radius-medium,
        text: Typography.control,
        normal: Theme.overlay.tooltip-paint,
    };

    out property <DragPreviewStyle> drag-preview: {
        row: root.tree-row,
        text: { size: 24px, weight: FontWeight.extra-bold },
        shadow: Theme.overlay.drag-preview.shadow,
        row-border: Theme.overlay.drag-preview.row-border,
    };

    out property <FloatingPanelStyle> floating-panel: {
        shadow: Theme.floating-shadow,
        border: Theme.overlay.floating-panel.border,
        background: Theme.overlay.floating-panel.background,
    };

    private property <GradientMarkerStyle> gradient-marker: {
        checker: root.transparency-grid,
        inactive: Theme.overlay.marker-inactive,
    };

    out property <InspectorStyle> inspector-layout: {
        row-gap: Metrics.space-compact,
        padding: Metrics.space-medium,
        column-gap: Metrics.space-regular,
        content-width: root.panes.inspector-width - Metrics.border-width - 2 * Metrics.space-medium,
        divider: Theme.inspector.divider,
    };

    out property <FillPickerStyle> fill-picker: {
        gap: Metrics.space-regular,
        margin: Metrics.space-regular,
        radius: Metrics.radius-large,
        shadow: Theme.inspector.fill-picker.shadow,
        background: Theme.inspector.fill-picker.background,
        border: Theme.inspector.fill-picker.border,
    };

    out property <EffectSliderStyle> effect-slider: {
        control-height: root.inspector-field.height,
        foreground: Colors.foreground,
    };

    out property <InspectorSliderStyle> inspector-slider: {
        height: Metrics.control-compact,
        min-width: Metrics.control-medium,
        fill: Colors.accent.with-alpha(0.65),
        track: Theme.fields.inspector-field.normal.background,
        track-border: Theme.fields.inspector-field.normal.border,
        zero: Colors.muted.with-alpha(0.55),
        hover-border: Colors.muted,
        dial: root.rotation-dial,
    };

    out property <RotationDialStyle> rotation-dial: {
        size: Metrics.control-medium,
        inset: Metrics.space-tight,
        face-size: Metrics.control-medium - 2 * Metrics.space-tight,
        dot: @linear-gradient(180deg, #0879b7, #38b9fa),
        shadow: { color: #00000025, blur: 2px, offset-y: 1px },
        ring: Theme.inspector.rotation-dial.ring,
        face: Theme.inspector.rotation-dial.face,
        ring-border: Theme.inspector.rotation-dial.ring-border,
        face-border: Theme.inspector.rotation-dial.face-border,
        dot-border: Theme.inspector.rotation-dial.dot-border,
        focus-border: Theme.inspector.rotation-dial.focus-border,
    };

    out property <ComboMenuStyle> combo-menu: {
        background: Theme.inspector.combo-menu.background,
        border: Theme.inspector.combo-menu.border,
        shadow: Theme.inspector.combo-menu.shadow,
    };

    private property <ColorPlaneStyle> color-plane: {
        shadow: { color: #00000080, blur: 3px, offset-y: 0px },
        radius: Metrics.radius-medium,
        thumb-border: Theme.picker.color-plane.thumb-border,
        border: Theme.picker.color-plane.border,
        checker-light: Theme.picker.color-plane.checker-light,
        checker-dark: Theme.picker.color-plane.checker-dark,
    };

    out property <ColorSliderStyle> color-slider: {
        shadow: { color: #00000070, blur: 2px, offset-y: 0px },
        radius: Metrics.radius-large,
        thumb-border: Theme.picker.slider-thumb-border,
    };

    private property <GradientRampStyle> gradient-ramp: {
        height: Metrics.space-small + root.inspector-field.height + root.gradient-marker.size + Metrics.space-compact,
        inset: root.gradient-marker.size / 2,
    };

    out property <InfoIconStyle> info-icon: {
        text: { size: 10px, weight: FontWeight.semi-bold },
        foreground: Theme.picker.info-icon.foreground,
        border: Theme.picker.info-icon.border,
        accent: Theme.picker.info-icon.accent,
        hover: Theme.picker.info-icon.hover,
    };

    private property <TreeRowStyle> tree-row: {
        height: Metrics.control-medium,
        font-size: Typography.body.size,
        radius: Metrics.radius-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        toggle-width: Metrics.icon-medium,
        icon-size: Metrics.icon-medium,
        focus-width: Metrics.focus-width,
        hover-background: Theme.navigation.tree-row.hover-background,
        selected-background: Theme.navigation.tree-row.selected-background,
        foreground: Theme.navigation.tree-row.foreground,
        muted: Theme.navigation.tree-row.muted,
        accent: Theme.navigation.tree-row.accent,
        directory-icon: Theme.navigation.tree-row.directory-icon,
    };

    out property <TreeStyle> tree: {
        row: root.tree-row,
        guide-width: Metrics.border-width,
        guide: Theme.navigation.guide,
        selected-guide: Theme.navigation.selected-guide,
        file-guide: Theme.navigation.file-guide,
        drop-border-width: Metrics.border-width,
        drop-line-height: Metrics.focus-width,
        root-drop-height: Metrics.space-regular,
        drop-background: Theme.navigation.drop-background,
        rename: { background: Palette.control-background, border: Palette.border },
    };

    out property <PaletteRowStyle> palette-row: {
        height: Metrics.control-large,
        radius: Metrics.radius-medium,
        disabled-opacity: Metrics.disabled-opacity,
        text: Typography.control,
        hover: Theme.navigation.palette-row.hover,
        selected: Theme.navigation.palette-row.selected,
        foreground: Theme.navigation.palette-row.foreground,
        selected-foreground: Theme.navigation.palette-row.selected-foreground,
    };

    out property <ButtonStyle> primary-button: {
        height: Metrics.control-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.strong-body,
        disabled-opacity: Metrics.disabled-opacity,
        appearance: Theme.buttons.primary-button,
    };

    out property <ButtonStyle> compact-button: {
        height: Metrics.control-small,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.control,
        disabled-opacity: Metrics.disabled-opacity,
        appearance: Theme.buttons.compact-button,
    };

    out property <ButtonStyle> welcome-button: {
        height: Metrics.control-large,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-medium,
        radius: Metrics.control-large / 2,
        border-width: Metrics.border-width,
        text: { size: Typography.action.size, weight: FontWeight.extra-bold },
        disabled-opacity: Metrics.disabled-opacity,
        appearance: Theme.buttons.welcome-button,
    };

    out property <ButtonStyle> inspector-icon-button: {
        height: Metrics.icon-large,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: 3.5px,
        border-width: Metrics.border-width,
        text: Typography.control,
        disabled-opacity: Metrics.disabled-opacity,
        appearance: Theme.buttons.inspector-icon-button,
    };

    out property <FieldStyle> field: {
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-regular,
        text: Typography.body,
        appearance: Theme.fields.field,
    };

    out property <FieldStyle> inspector-field: {
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-compact,
        text: Typography.control,
        appearance: Theme.fields.inspector-field,
    };

    pure function field-variant(base: FieldStyle, gap: length, text: TextStyle) -> FieldStyle {
        return {
            height: base.height,
            radius: base.radius,
            border-width: base.border-width,
            padding-inline: base.padding-inline,
            gap: gap,
            text: text,
            appearance: base.appearance,
        };
    }

    out property <FieldStyle> editable-field: root.field-variant(root.inspector-field, Metrics.space-small, root.inspector-field.text);
    out property <FieldStyle> code-field: root.field-variant(root.inspector-field, root.inspector-field.gap, Typography.caption);

    out property <SegmentStyle> segment: {
        height: root.inspector-field.height,
        radius: root.inspector-field.radius,
        text: Typography.control,
        hover: Theme.controls.segment.hover,
        foreground: Theme.controls.segment.foreground,
        muted: Theme.controls.segment.muted,
        selected-surface: Theme.controls.segment.selected-surface,
        border: Theme.controls.segment.border,
        focus-border: Theme.controls.segment.focus-border,
    };

    out property <SidebarToggleStyle> sidebar-toggle: {
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        normal: Theme.controls.sidebar-toggle.normal,
        hover: Theme.controls.sidebar-toggle.hover,
        selected: Theme.controls.sidebar-toggle.selected,
    };

    out property <ColorControlsStyle> color-controls: {
        plane: root.color-plane,
        slider: root.color-slider,
        row-height: root.combo-menu.row-height,
        gap: Metrics.space-medium,
    };

    out property <GradientStopsStyle> gradient-stops: {
        ramp: root.gradient-ramp,
        marker: root.gradient-marker,
    };

    out property <ImageAssetEditorStyle> image-asset-editor: {
        canvas: root.canvas-surface,
        rail: root.image-rail,
        tabs: root.image-tabs,
        preview: root.image-preview,
        details: root.image-details,
        nine-slice: root.nine-slice,
        image: root.image-canvas,
    };

    out property <ButtonStyle> copy-button: {
        width: 54px,
        height: Metrics.control-compact,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-small,
        border-width: Metrics.border-width,
        text: { size: Typography.control.size, weight: FontWeight.extra-bold },
        disabled-opacity: Metrics.disabled-opacity,
        appearance: Theme.buttons.copy-action,
    };

    out property <CornerModeStyle> corner-mode: {
        width: Metrics.control-small,
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        selected-background: Theme.controls.corner-mode.selected-background,
        background: Theme.controls.corner-mode.background,
        foreground: Theme.controls.corner-mode.foreground,
        muted: Theme.controls.corner-mode.muted,
        focus-border: Theme.controls.corner-mode.focus-border,
    };

    out property <CornerEditorStyle> corner-editor: {
        gap: Metrics.space-compact,
        mode: root.corner-mode,
        slider: root.inspector-slider,
        field: root.inspector-field,
    };

    out property <ColorFieldStyle> color-field: {
        field: root.inspector-field,
        decorative: Theme.fields.color-field.decorative,
        swatch-border: Theme.fields.color-field.swatch-border,
    };
}
