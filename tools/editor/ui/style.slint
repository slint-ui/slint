export struct StyleTypography {
    caption: TextStyle,
    control: TextStyle,
    body: TextStyle,
    action: TextStyle,
    heading: TextStyle,
    hero: TextStyle,
    family: string,
    error-icon: TextStyle,
    section-heading: TextStyle,
    strong-body: TextStyle,
    symbol: TextStyle,
    info-symbol: TextStyle,
    slider-tick: TextStyle,
}

export struct StyleControls {
    border-width: length,
    focus-width: length,
    hairline-width: length,
    field-radius: length,
    row-radius: length,
    panel-radius: length,
    field-height: length,
