        minimum: 48px,
        heading-height: 18px,
        heading-top: 8px,
        body-top: 34px,
        body-bottom: 12px,
        border: Colors.dark ? #ffffff18 : #cbd5e166,
        background: Colors.surface.with-alpha(0.76),
        canvas: Style.canvas-surface.background.with-alpha(0.72),
        handle-size: 14px,
        shadow: { color: Colors.dark ? #00000028 : #64748b12, blur: 8px, offset-y: 3px },
    };

    out property <ImageCanvasStyle> image-canvas: {
        fit-bottom: 64px,
        shadow: { color: Colors.dark ? #00000055 : #64748b30, blur: 24px, offset-y: 14px },
    };

    out property <ImageErrorStyle> image-error: {
        margin: 40px,
        height: 96px,
        max-width: 520px,
    };

    out property <WelcomeShellStyle> welcome-shell: {
        stage: Colors.dark ? #202124 : #c9c9c9,
        background: Colors.dark ? #303134 : #ffffff,
        sidebar: Colors.dark ? #2a2b2e : #f5f5f6,
        foreground: Colors.dark ? #f4f4f5 : #252527,
        muted: Colors.dark ? #b5b6ba : #797a7d,
        width: 740px,
        height: 460px,
        outer-inset: 16px,
        compact-threshold: 620px,
        compact-side-width: 220px,
        side-width: 270px,
        radius: 20px,
        border: Colors.dark ? #ffffff22 : #98999d,
        shadow: { color: Colors.dark ? #00000080 : #00000030, blur: 18px, offset-y: 8px },
    };

    out property <WelcomeHeroStyle> welcome-hero: {
        brand-size: 103px,
        top: 64px,
        gap: 18px,
        title-height: 37px,
        subtitle-height: 17px,
    };

    private property <length> welcome-actions-gap: Metrics.space-regular;
    out property <WelcomeActionsStyle> welcome-actions: {
        inset: 56px,
        bottom-inset: 130px,
        height: 2 * Style.welcome-button.height + root.welcome-actions-gap,
        gap: root.welcome-actions-gap,
    };

    out property <RecentProjectListStyle> recent-project-list: {
        inset: 10px,
        height: 195px,
        gap: 5px,
    };

    out property <RecentProjectRowStyle> recent-project-row: {
        selected-background: #0878f8,
        height: 44px,
        radius: Metrics.radius-medium,
        padding-right: Metrics.space-medium,
        gap: Metrics.space-regular,
        icon-size: 27px,
        text-gap: Metrics.space-tight,
        selected-muted: #d7e7ff,
        background: transparent,
        hover: Style.welcome-button.hover.background,
        foreground: Style.welcome-shell.foreground,
        muted: Style.welcome-shell.muted,
        padding-left: Style.welcome-button.padding-inline,
    };

    out property <WelcomeBrandStyle> welcome-brand: {
        background: @linear-gradient(155deg, #32e1ff 0%, #0b89ff 52%, #115bea 100%),
        grid-horizontal: #ffffff26,
        grid-vertical: #ffffff22,
        shadow: { color: #00000033, blur: 11px, offset-y: 6px },
    };

    out property <CanvasSurfaceStyle> canvas-surface: {
        background: Colors.dark ? #1f1f1f : #eef2f7,
    };

    out property <GridStyle> grid: {
        pitch: 32px,
        line-width: 1px,
        color: Colors.dark ? #ffffff0a : #00000008,
    };

    out property <ArtboardStyle> artboard: {
        radius: 34px,
        padding: 1px,
        top-minimum: 40px,
        background: Colors.dark ? #f7f8fb : #ffffff,
        foreground: #20252d,
        shadow: { color: Colors.dark ? #00000055 : #64748b30, blur: 30px, offset-y: 18px },
    };

    out property <SelectionFrameStyle> selection-frame: {
        outline-width: 1px,
        hover-width: 2px,
        handle-size: 8px,
        hit-size: 12px,
        rotation-hit-size: 22px,
        accent: Colors.dark ? #0c8ce9 : #0b99fe,
        handle-background: #ffffff,
        ghost-opacity: 0.5,
    };

    out property <RadiusHandleStyle> radius-handle: {
        size: 10px,
        inset: 10px,
    };

    out property <GradientOverlayStyle> gradient-overlay: {
        hit-size: 32px,
        endpoint-size: 12px,
        halo: #ffffff90,
        axis-hit-size: 10px,
        axis-width: 2px,
        stop-offset: 6px,
        endpoint-shadow: { color: #0008, blur: 3px, offset-y: 0px },
        axis-shadow: { color: #000a, blur: 2px, offset-y: 0px },
    };

    out property <NineSliceStyle> nine-slice: {
        label-size: 22px,
        line-width: 4px,
        hit-size: 20px,
        label-gap: 10px,
        hit-extension: 38px,
        color: #ffd33d,
        overlay: #ffffff1a,
        label-foreground: #111827,
        label-border: Colors.dark ? #111827 : #ffffff,
        label-shadow: { color: #00000055, blur: 8px, offset-y: 2px },
    };

    out property <TooltipStyle> tooltip: {
        offset: 12px,
        padding-inline: 7px,
        padding-block: 4px,
        shadow: { color: #33415535, blur: 12px, offset-y: 4px },
        normal: { background: Colors.focus, foreground: Colors.on-accent, border: Colors.border },
        radius: Metrics.radius-medium,
        text: Typography.caption,
    };

    out property <DragPreviewStyle> drag-preview: {
        background: #ffffff,
        subtle: #f6f8fa,
        border: #d0d7de,
        muted: #6e7781,
        content-opacity: 0.72,
        shadow: { color: Colors.dark ? #00000055 : #33415535, blur: 18px, offset-y: 8px },
    };

    out property <DropIndicatorStyle> drop-indicator: {
        background: #ffffff,
        foreground: #ffffff,
    };

    out property <FloatingPanelStyle> floating-panel: {
        border: Colors.dark ? #ffffff18 : #d0d7de,
        background: Colors.surface.with-alpha(0.92),
    };

    out property <TransparencyGridStyle> transparency-grid: {
        light: #ffffff,
        dark: #e1e1e1,
        cell-size: 8px,
    };

    out property <GradientMarkerStyle> gradient-marker: {
        inactive: Colors.dark ? #3f3f3f : #b5ccdd,
        active: #0c8ce9,
        size: 24px,
        radius: 5px,
        checker: Style.transparency-grid,
    };

    private property <length> inspector-layout-padding: Metrics.space-medium;
    out property <InspectorLayoutStyle> inspector-layout: {
        divider: Colors.dark ? #414141 : #e5e5e5,
        label-width: 52px,
        row-gap: Metrics.space-compact,
        padding: root.inspector-layout-padding,
        column-width: 88px,
        column-gap: Metrics.space-regular,
        content-width: Style.panes.inspector-width - Metrics.border-width - 2 * root.inspector-layout-padding,
        corner-field-width: 72px,
    };

    out property <FillPickerStyle> fill-picker: {
        width: 260px,
        gap: Metrics.space-regular,
        margin: Metrics.space-regular,
        min-height: 200px,
        shadow: { color: Colors.dark ? #00000080 : #64748b35, blur: 18px, offset-y: 8px },
        close-width: 48px,
        background: Colors.surface,
        border: Style.inspector-layout.divider,
        radius: Metrics.radius-large,
    };

    out property <EffectSliderStyle> effect-slider: {
        height: 34px,
        label-width: 48px,
        track-width: 62px,
        track-height: 3px,
        thumb-size: 11px,
        value-width: 44px,
        plain-value-width: 52px,
        suffix-width: 12px,
        pressed-thumb: Colors.accent.with-alpha(0.88),
        shadow: { color: #00000028, blur: 6px, offset-y: 2px },
        track: Style.inspector-field.normal.background,
        fill: Colors.accent,
        thumb: Colors.accent,
        control-height: Style.inspector-field.height,
        border: Colors.surface,
        foreground: Colors.foreground,
    };

    out property <RadiusSliderStyle> radius-slider: {
        thumb-size: 10px,
        track-height: 2px,
        inset: 6px,
        fill: Colors.dark ? Colors.accent : transparent,
        thumb: Colors.dark ? Colors.accent : Colors.muted,
        track: Style.inspector-layout.divider,
        height: Metrics.control-compact,
        min-width: Metrics.control-medium,
        focus-border: Colors.accent,
    };

    private property <length> rotation-dial-size: 32px;
    private property <length> rotation-dial-inset: 2px;
    out property <RotationDialStyle> rotation-dial: {
        size: root.rotation-dial-size,
        inset: root.rotation-dial-inset,
        face-size: root.rotation-dial-size - 2 * root.rotation-dial-inset,
        dot-size: 4px,
        dot-distance: 9px,
        ring: @linear-gradient(145deg, Colors.dark ? #262a30 : #bdc3cc, Colors.dark ? #737c87 : #ffffff),
        face: @radial-gradient(circle at 10px 7px, Colors.dark ? #89919b : #ffffff, Colors.dark ? #5b626d : #f4f6f9 55%, Colors.dark ? #343a43 : #d8dde5),
        dot: @linear-gradient(180deg, #0879b7, #38b9fa),
        ring-border: Colors.dark ? #454b55 : #cbd0d8,
        face-border: Colors.dark ? #858e99 : #ffffff,
        dot-border: Colors.dark ? #343e4a : #b9cbd9,
        shadow: { color: #00000025, blur: 2px, offset-y: 1px },
        focus-border: Colors.accent,
    };

    out property <ComboMenuStyle> combo-menu: {
        row-height: 26px,
        max-height: 220px,
        background: Colors.surface,
        border: Style.inspector-layout.divider,
        shadow: Elevation.popup,
    };

    out property <RecentFillsStyle> recent-fills: {
        swatch-size: 22px,
    };

    out property <ColorPlaneStyle> color-plane: {
        height: 170px,
        thumb-size: 12px,
        shadow: { color: #00000080, blur: 3px, offset-y: 0px },
        thumb-border: Colors.on-accent,
        border: Style.inspector-layout.divider,
        radius: Metrics.radius-medium,
        checker-light: Colors.surface,
        checker-dark: Style.inspector-field.normal.border,
    };

    out property <ColorSliderStyle> color-slider: {
        height: 16px,
        thumb-size: 14px,
        shadow: { color: #00000070, blur: 2px, offset-y: 0px },
        thumb-border: Colors.on-accent,
        radius: Metrics.radius-large,
    };

    out property <ColorHexStyle> color-hex: {
        width: 78px,
        input-width: 58px,
    };

    out property <GradientRampStyle> gradient-ramp: {
        height: Metrics.space-small + Style.inspector-field.height + Style.gradient-marker.size + Metrics.space-compact,
        inset: Style.gradient-marker.size / 2,
        pick-distance: 10px,
    };

    out property <GradientStopRowStyle> gradient-stop-row: {
        action-width: 24px,
        position-width: 66px,
        opacity-width: 48px,
        height: 28px,
        swatch-size: 14px,
    };

    out property <GradientFieldsStyle> gradient-fields: {
        label-width: 58px,
        value-width: 62px,
    };

    out property <InfoIconStyle> info-icon: {
        size: 14px,
        decorative: Colors.muted.with-alpha(0.35),
        text: { size: Typography.info-symbol.size, weight: FontWeight.semi-bold },
        foreground: Colors.muted,
        border: Colors.muted.with-alpha(0.72),
        accent: Colors.accent,
        hover: Colors.subtle-selection,
    };

    out property <CopyButtonStyle> copy-button: {
        width: 54px,
    };

    out property <TreeRowStyle> tree-row: {
        hover-background: Colors.dark ? #383838 : #f5f5f5,
        selected-background: Colors.dark ? Colors.accent.with-alpha(0.22) : #e4f4ff,
        foreground: Colors.foreground,
        muted: Colors.muted,
        accent: Colors.dark ? Colors.accent : #0969da,
        directory-icon: Colors.dark ? Colors.accent : #d29922,
        height: Metrics.control-medium,
        font-size: Typography.body.size,
        radius: Metrics.radius-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        toggle-width: Metrics.icon-medium,
        hit-size: 20px,
        icon-size: Metrics.icon-medium,
        focus-width: Metrics.focus-width,
        drag-opacity: 0.45,
        icon-opacity: 0.5,
    };

    out property <RenameFieldStyle> rename-field: {
        background: Palette.control-background,
        border: Palette.border,
    };

    out property <TreeGuidesStyle> tree-guides: {
        guide: Style.inspector-layout.divider,
        guide-width: Metrics.border-width,
        selected-guide: Colors.dark ? #474747 : #c4c4c4,
        file-guide: Style.inspector-layout.divider,
    };

    out property <TreeDropStyle> tree-drop: {
        drop-background: Colors.dark ? Colors.accent.with-alpha(0.14) : #eaf5ff,
        drop-border-width: Metrics.border-width,
        drop-line-height: Metrics.focus-width,
        root-drop-height: Metrics.space-regular,
    };

    out property <PaletteRowStyle> palette-row: {
        drag-opacity: 0.56,
        icon-opacity: 0.5,
        height: Metrics.control-large,
        radius: Metrics.radius-medium,
        hover: Colors.subtle,
        selected: Colors.subtle-selection,
        foreground: Colors.foreground,
        selected-foreground: Colors.focus,
        disabled-opacity: Style.button.disabled-opacity,
        text: Typography.control,
    };

    out property <ButtonStyle> button: {
        height: Metrics.control-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.control,
        normal: { background: Colors.surface, foreground: Colors.foreground, border: Colors.border },
        hover: { background: Colors.subtle, foreground: Colors.foreground, border: Colors.border },
        pressed: { background: Colors.selection, foreground: Colors.foreground, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        focus-border: Colors.focus,
        disabled-opacity: 0.55,
    };

    out property <ButtonStyle> primary-button: {
        height: Metrics.control-medium,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.strong-body,
        normal: { background: Colors.dark ? #196bd6 : #0969da, foreground: Colors.on-accent, border: Colors.border },
        hover: { background: Colors.dark ? #2073dd : #0860ca, foreground: Colors.on-accent, border: Colors.border },
        pressed: { background: Colors.dark ? #135bb9 : #0756b5, foreground: Colors.on-accent, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        focus-border: Colors.focus,
        disabled-opacity: 0.55,
    };

    out property <ButtonStyle> compact-button: {
        height: Metrics.control-small,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        text: Typography.control,
        normal: { background: transparent, foreground: Colors.muted, border: Colors.border },
        hover: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        pressed: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        focus-border: Colors.focus,
        disabled-opacity: 0.55,
    };

    out property <ButtonStyle> welcome-button: {
        height: Metrics.control-large,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-medium,
        radius: Metrics.control-large / 2,
        border-width: Metrics.border-width,
        text: { size: Typography.action.size, weight: FontWeight.extra-bold },
        normal: { background: Colors.dark ? #424347 : #eeeeef, foreground: Style.welcome-shell.foreground, border: Colors.border },
        hover: { background: Colors.dark ? #4d4f54 : #e2e3e5, foreground: Style.welcome-shell.foreground, border: Colors.border },
        pressed: { background: Colors.dark ? #55575d : #d9dadd, foreground: Style.welcome-shell.foreground, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        focus-border: Colors.focus,
        disabled-opacity: 0.55,
    };

    out property <ButtonStyle> inspector-icon-button: {
        height: Metrics.icon-large,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-regular,
        radius: 3.5px,
        border-width: Metrics.border-width,
        text: Typography.control,
        normal: { background: transparent, foreground: Colors.foreground, border: Colors.border },
        hover: { background: Style.inspector-field.normal.background, foreground: Colors.foreground, border: Colors.border },
        pressed: { background: Colors.focus-background, foreground: Colors.accent, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        focus-border: Colors.accent,
        disabled-opacity: 0.55,
    };

    out property <FieldStyle> field: {
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-medium,
        gap: Metrics.space-regular,
        text: Typography.body,
        normal: { background: Colors.surface, foreground: Colors.foreground, border: Colors.border },
        hover: { background: Colors.subtle, foreground: Colors.foreground, border: Colors.border },
        focus: { background: Colors.surface, foreground: Colors.foreground, border: Colors.border },
        disabled: { background: Colors.subtle, foreground: Colors.muted, border: Colors.border },
        muted: Colors.muted,
        focus-border: Colors.focus,
        selection: Colors.text-selection,
    };

    out property <FieldStyle> inspector-field: {
        height: Metrics.control-compact,
        radius: Metrics.radius-small,
        border-width: Metrics.border-width,
        padding-inline: Metrics.space-regular,
        gap: Metrics.space-compact,
        text: Typography.control,
        normal: { background: Colors.dark ? #383838 : #f5f5f5, foreground: Colors.foreground, border: Colors.dark ? #4b4b4b : #d9d9d9 },
        hover: { background: Colors.dark ? #414141 : #eeeeee, foreground: Colors.foreground, border: Colors.dark ? #4b4b4b : #d9d9d9 },
        focus: { background: Colors.surface, foreground: Colors.foreground, border: Colors.border },
        disabled: { background: ( Colors.dark ? #383838 : #f5f5f5 ).with-alpha(0.65), foreground: Colors.muted, border: Colors.dark ? #4b4b4b : #d9d9d9 },
        muted: Colors.muted,
        focus-border: Colors.accent,
        selection: Colors.text-selection,
    };

    out property <SegmentStyle> segment: {
        selected-background: Colors.dark ? Style.primary-button.normal.background : Colors.accent.with-alpha(0.14),
        height: Style.inspector-field.height,
        radius: Style.inspector-field.radius,
        background: Style.inspector-field.normal.background,
        hover: Style.inspector-field.hover.background,
        foreground: Colors.foreground,
        muted: Colors.muted,
        selected-surface: Colors.surface,
        border: Style.inspector-layout.divider,
        focus-border: Colors.accent,
        text: Typography.control,
    };

    out property <SidebarToggleStyle> sidebar-toggle: {
        width: 34px,
        height: Metrics.control-medium,
        radius: Metrics.radius-medium,
        normal: { background: Colors.surface, foreground: Colors.foreground, border: Colors.border },
        hover: { background: Colors.subtle, foreground: Colors.foreground, border: Colors.border },
        selected: { background: Colors.selection, foreground: Colors.focus, border: Colors.focus },
    };

    out property <ColorControlsStyle> color-controls: {
        plane: Style.color-plane,
        slider: Style.color-slider,
        hex: Style.color-hex,
        row-height: Style.combo-menu.row-height,
        gap: Metrics.space-medium,
    };

    out property <GradientStopsStyle> gradient-stops: {
        ramp: Style.gradient-ramp,
        marker: Style.gradient-marker,
        row: Style.gradient-stop-row,
        gap: Metrics.space-regular,
    };
}
