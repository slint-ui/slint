    out property <ImageSyntaxStyle> image-syntax: Theme.current == ThemeKind.dark ? DarkTheme.image-syntax : LightTheme.image-syntax;
    out property <ImagePreviewStyle> image-preview: Theme.current == ThemeKind.dark ? DarkTheme.image-preview : LightTheme.image-preview;
    out property <ImageCanvasStyle> image-canvas: Theme.current == ThemeKind.dark ? DarkTheme.image-canvas : LightTheme.image-canvas;
    out property <ImageErrorStyle> image-error: SharedStyle.image-error;
