    drag-source-opacity: float,
    palette-drag-opacity: float,
    drag-ghost-opacity: float,
    inactive-icon-opacity: float,
    drag-content-opacity: float,
}

export struct StyleMotion {
    fast: duration,
    feedback: duration,
    normal: duration,
    layout: duration,
}

export struct StyleShadows {
    popup: ShadowStyle,
    picker: ShadowStyle,
    dial: ShadowStyle,
