        slice-label-text: #111827,
        slice-label-border: Style.dark ? #111827 : #ffffff,
        gradient-halo: #ffffff90,
    };

    private property <length> spacing-medium: 12px;

    private property <length> spacing-large: 16px;

    out property <StyleSpacing> spacing: {
        tight: 2px,
        small: 4px,
        compact: 6px,
        regular: 8px,
        control-inset: root.spacing-medium,
        medium: root.spacing-medium,
        pane-inset: root.spacing-medium,
        large: root.spacing-large,
        icon-gap: root.spacing-large,
        section: 24px,
    };

    out property <StyleTypography> typography: {
        caption: { size: 11px, weight: 400 },
        control: { size: 12px, weight: 400 },
        body: { size: 13px, weight: 400 },
        action: { size: 14px, weight: 400 },
        heading: { size: 16px, weight: 700 },
        hero: { size: 34px, weight: 700 },
        family: "Inter",
        error-icon: { size: 20px, weight: 400 },
        section-heading: { size: 12px, weight: 700 },
        strong-body: { size: 13px, weight: 700 },
        symbol: { size: 24px, weight: 400 },
        info-symbol: { size: 10px, weight: 700 },
        slider-tick: { size: 9px, weight: 400 },
    };

    private property <length> controls-field-radius: 4px;

    private property <length> controls-row-radius: 6px;

    private property <length> controls-panel-radius: 8px;

    out property <StyleControls> controls: {
        border-width: 1px,
        focus-width: 2px,
        hairline-width: 0.5px,
        compact-radius: root.controls-field-radius,
        field-radius: root.controls-field-radius,
        small-radius: root.controls-row-radius,
        row-radius: root.controls-row-radius,
        panel-radius: root.controls-panel-radius,
        dialog-radius: root.controls-panel-radius,
        field-height: 24px,
        small-height: 28px,
        height: 32px,
        large-height: 36px,
        icon-size: 16px,
        small-icon-size: 12px,
        large-icon-size: 18px,
        disabled-opacity: 0.55,
        drag-source-opacity: 0.45,
        palette-drag-opacity: 0.56,
        drag-ghost-opacity: 0.5,
        inactive-icon-opacity: 0.5,
        drag-content-opacity: 0.72,
    };

    out property <StyleMotion> motion: {
        fast: 120ms,
        feedback: 150ms,
        normal: 150ms,
        layout: 180ms,
    };

    out property <StyleShadows> shadows: {
        popup: { color: Style.dark ? #00000066 : #64748b30, blur: 12px, offset-y: 4px },
        picker: { color: Style.dark ? #00000080 : #64748b35, blur: 18px, offset-y: 8px },
        dial: { color: #00000025, blur: 2px, offset-y: 1px },
        slider: { color: #00000028, blur: 6px, offset-y: 2px },
        color-plane: { color: #00000080, blur: 3px, offset-y: 0px },
        color-slider: { color: #00000070, blur: 2px, offset-y: 0px },
        dialog: { color: Style.dark ? #00000085 : #161b233d, blur: 24px, offset-y: 12px },
        floating: { color: Style.dark ? #00000055 : #64748b28, blur: 18px, offset-y: 8px },
        welcome: { color: Style.dark ? #00000080 : #00000030, blur: 18px, offset-y: 8px },
        brand: { color: #00000033, blur: 11px, offset-y: 6px },
        artboard: { color: Style.dark ? #00000055 : #64748b30, blur: 30px, offset-y: 18px },
        image: { color: Style.dark ? #00000055 : #64748b30, blur: 24px, offset-y: 14px },
        image-panel: { color: Style.dark ? #00000055 : #64748b25, blur: 18px, offset-y: 8px },
        image-preview: { color: Style.dark ? #00000028 : #64748b12, blur: 8px, offset-y: 3px },
        slice-label: { color: #00000055, blur: 8px, offset-y: 2px },
        gradient-endpoint: { color: #0008, blur: 3px, offset-y: 0px },
        gradient-axis: { color: #000a, blur: 2px, offset-y: 0px },
        tooltip: { color: #33415535, blur: 12px, offset-y: 4px },
        drag: { color: Style.dark ? #00000055 : #33415535, blur: 18px, offset-y: 8px },
    };
}
