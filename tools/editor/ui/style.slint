    out property <NineSliceStyle> nine-slice: Theme.current == ThemeKind.dark ? DarkTheme.nine-slice : LightTheme.nine-slice;
    out property <TooltipStyle> tooltip: Theme.current == ThemeKind.dark ? DarkTheme.tooltip : LightTheme.tooltip;
    out property <DragPreviewStyle> drag-preview: Theme.current == ThemeKind.dark ? DarkTheme.drag-preview : LightTheme.drag-preview;
    out property <DropIndicatorStyle> drop-indicator: SharedStyle.drop-indicator;
    out property <FloatingPanelStyle> floating-panel: Theme.current == ThemeKind.dark ? DarkTheme.floating-panel : LightTheme.floating-panel;
    out property <TransparencyGridStyle> transparency-grid: SharedStyle.transparency-grid;
