import { Palette } from "std-widgets.slint";

export struct TextStyle {
    size: length,
    weight: int,
}

export struct ShadowStyle {
    color: color,
    blur: length,
    offset-y: length,
}

export struct StyleColors {
    app-bg: color,
    panel-bg: color,
    panel-subtle: color,
    text: color,
    muted: color,
    border: color,
    soft-border: color,
    accent: color,
    accent-strong: color,
    canvas-outline: color,
    canvas: color,
    phone-bg: color,
    phone-text: color,
    object-bg: color,
    object-subtle: color,
    object-border: color,
    object-muted: color,
    drop-mark-background: brush,
    drop-mark-foreground: brush,
    checker-light: color,
    checker-dark: color,
    marker-bg: color,
    marker-active: color,
    handle-border: color,
}

export struct StyleInspector {
    picker-width: length,
    picker-gap: length,
    picker-margin: length,
    panel-bg: color,
    divider: color,
    field-bg: color,
    field-bg-hover: color,
    field-border: color,
    text: color,
    muted: color,
    accent: color,
    selected-control-bg: color,
    slider-fill: color,
    slider-thumb: color,
    label-width: length,
    row-gap: length,
    side-padding: length,
    section-title-size: length,
    field-height: length,
    field-radius: length,
    column-width: length,
    column-gap: length,
    wide-width: length,
    stop-action-width: length,
    close-width: length,
    stop-position-width: length,
    stop-opacity-width: length,
    stop-row-height: length,
    stop-ramp-height: length,
    stop-marker-size: length,
    stop-marker-radius: length,
    stop-ramp-inset: length,
    dial-size: length,
    dial-inset: length,
    dial-face-size: length,
    dial-dot-size: length,
    dial-dot-distance: length,
    copy-width: length,
    menu-row-height: length,
    menu-available-height: length,
    recent-swatch-size: length,
    color-field-height: length,
    color-slider-height: length,
    color-slider-thumb-size: length,
    color-plane-thumb-size: length,
    checker-size: length,
    dial-ring: brush,
    dial-face: brush,
    dial-dot: brush,
    dial-ring-border: color,
    dial-face-border: color,
    dial-dot-border: color,
}

export struct StyleTree {
    row-bg-hover: color,
    row-bg-current: color,
    drop-target-bg: color,
    text: color,
    muted-text: color,
    accent: color,
    guide: color,
    directory-icon: color,
    row-height: length,
    row-font-size: length,
    row-radius: length,
    row-padding-inline: length,
    content-gap: length,
    toggle-width: length,
    disclosure-hit-size: length,
    icon-size: length,
    current-indicator-width: length,
    current-indicator-height: length,
    guide-width: length,
    focus-ring-width: length,
    drop-target-border-width: length,
    drop-indicator-height: length,
    root-drop-height: length,
    selected-guide: color,
    file-guide: color,
    rename-bg: brush,
    rename-border: color,
    error: color,
}

export struct StyleWelcome {
    stage-bg: color,
    shell-bg: color,
    side-bg: color,
    control-bg: color,
    control-hover: color,
    text: color,
    muted: color,
    accent: color,
}

export struct StyleLayout {
    left-pane-width: length,
    inspector-pane-width: length,
    top-bar-height: length,
    status-bar-height: length,
    splitter-size: length,
    pane-minimum: length,
    search-height: length,
    sidebar-button-width: length,
    sidebar-button-height: length,
    component-pane-height: length,
    image-pane-height: length,
    files-pane-minimum: length,
    left-heading-height: length,
    palette-card-height: length,
}

export struct StyleCanvas {
    phone-frame-radius: length,
    phone-outer-padding: length,
    selection-outline-width: length,
    hover-outline-width: length,
    selection-handle-size: length,
    selection-handle-touch-size: length,
    rotation-zone-size: length,
    radius-handle-size: length,
    radius-handle-inset: length,
}

export struct StyleSpacing {
    tight: length,
    small: length,
    compact: length,
    regular: length,
    control-inset: length,
    medium: length,
    pane-inset: length,
    large: length,
    icon-gap: length,
    section: length,
}

export struct StyleTypography {
    caption: TextStyle,
    control: TextStyle,
    body: TextStyle,
    action: TextStyle,
    heading: TextStyle,
    hero: TextStyle,
}

export struct StyleControls {
    border-width: length,
    focus-width: length,
    hairline-width: length,
    compact-radius: length,
    field-radius: length,
    small-radius: length,
    row-radius: length,
    panel-radius: length,
    dialog-radius: length,
    field-height: length,
    small-height: length,
    height: length,
    large-height: length,
    icon-size: length,
    small-icon-size: length,
    large-icon-size: length,
    disabled-opacity: float,
}

export struct StyleMotion {
    fast: duration,
    feedback: duration,
    normal: duration,
    layout: duration,
}

export struct StyleShadows {
    popup: ShadowStyle,
    picker: ShadowStyle,
    dial: ShadowStyle,
    slider: ShadowStyle,
    color-plane: ShadowStyle,
    color-slider: ShadowStyle,
}

export global Style {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    private property <color> colors-accent: Style.dark ? #2379f4 : #0d99ff;

    out property <StyleColors> colors: {
        app-bg: Style.dark ? #2c2c2c : #f6f8fa,
        panel-bg: Style.dark ? #2c2c2c : #ffffff,
        panel-subtle: Style.dark ? #383838 : #f6f8fa,
        text: Style.dark ? #f1f1f1 : #1f2328,
        muted: Style.dark ? #b7b7b7 : #6e7781,
        border: Style.dark ? #494949 : #d0d7de,
        soft-border: Style.dark ? #3f3f3f : #eaeef2,
        accent: root.colors-accent,
        accent-strong: Style.dark ? root.colors-accent.mix(#ffffff, 0.75) : #52aeff,
        canvas-outline: Style.dark ? #0c8ce9 : #0b99fe,
        canvas: Style.dark ? #1f1f1f : #eef2f7,
        phone-bg: Style.dark ? #f7f8fb : #ffffff,
        phone-text: #20252d,
        object-bg: #ffffff,
        object-subtle: #f6f8fa,
        object-border: #d0d7de,
        object-muted: #6e7781,
        drop-mark-background: #ffffff,
        drop-mark-foreground: #ffffff,
        checker-light: #ffffff,
        checker-dark: #e1e1e1,
        marker-bg: Style.dark ? #3f3f3f : #b5ccdd,
        marker-active: #0c8ce9,
        handle-border: #ffffff,
    };

    private property <color> inspector-accent: Style.colors.accent;

    private property <color> inspector-field-bg-hover: Style.dark ? #414141 : #eeeeee;

    private property <color> inspector-muted: Style.dark ? #9a9a9a : #8c8c8c;

    out property <StyleInspector> inspector: {
        picker-width: 260px,
        picker-gap: 8px,
        picker-margin: 8px,
        panel-bg: Style.colors.panel-bg,
        divider: Style.dark ? #414141 : #e5e5e5,
        field-bg: Style.dark ? #383838 : #f5f5f5,
        field-bg-hover: root.inspector-field-bg-hover,
        field-border: Style.dark ? #4b4b4b : #d9d9d9,
        text: Style.dark ? #f4f4f4 : #1e1e1e,
        muted: root.inspector-muted,
        accent: root.inspector-accent,
        selected-control-bg: Style.dark ? root.inspector-accent : root.inspector-field-bg-hover,
        slider-fill: Style.dark ? root.inspector-accent : transparent,
        slider-thumb: Style.dark ? root.inspector-accent : root.inspector-muted,
        label-width: 52px,
        row-gap: 6px,
        side-padding: 12px,
        section-title-size: 12px,
        field-height: 24px,
        field-radius: 4px,
        column-width: 88px,
        column-gap: 8px,
        wide-width: 207px,
        stop-action-width: 24px,
        close-width: 48px,
        stop-position-width: 66px,
        stop-opacity-width: 48px,
        stop-row-height: 28px,
        stop-ramp-height: 58px,
        stop-marker-size: 24px,
        stop-marker-radius: 5px,
        stop-ramp-inset: 12px,
        dial-size: 32px,
        dial-inset: 2px,
        dial-face-size: 28px,
        dial-dot-size: 4px,
        dial-dot-distance: 9px,
        copy-width: 54px,
        menu-row-height: 26px,
        menu-available-height: 220px,
        recent-swatch-size: 22px,
        color-field-height: 170px,
        color-slider-height: 16px,
        color-slider-thumb-size: 14px,
        color-plane-thumb-size: 12px,
        checker-size: 8px,
        dial-ring: @linear-gradient(145deg, Style.dark ? #262a30 : #bdc3cc, Style.dark ? #737c87 : #ffffff),
        dial-face: @radial-gradient(circle at 10px 7px, Style.dark ? #89919b : #ffffff, Style.dark ? #5b626d : #f4f6f9 55%, Style.dark ? #343a43 : #d8dde5),
        dial-dot: @linear-gradient(180deg, #0879b7, #38b9fa),
        dial-ring-border: Style.dark ? #454b55 : #cbd0d8,
        dial-face-border: Style.dark ? #858e99 : #ffffff,
        dial-dot-border: Style.dark ? #343e4a : #b9cbd9,
    };

    out property <StyleTree> tree: {
        row-bg-hover: Style.dark ? #383838 : #f5f5f5,
        row-bg-current: Style.dark ? Style.colors.accent.with-alpha(0.22) : #e4f4ff,
        drop-target-bg: Style.dark ? Style.colors.accent.with-alpha(0.14) : #eaf5ff,
        text: Style.dark ? #e6edf3 : #1f2328,
        muted-text: Style.dark ? #848d97 : #656d76,
        accent: Style.dark ? Style.colors.accent : #0969da,
        guide: Style.dark ? #21262d : #d8dee4,
        directory-icon: Style.dark ? Style.colors.accent : #d29922,
        row-height: 32px,
        row-font-size: 13px,
        row-radius: 6px,
        row-padding-inline: 8px,
        content-gap: 8px,
        toggle-width: 16px,
        disclosure-hit-size: 20px,
        icon-size: 16px,
        current-indicator-width: 4px,
        current-indicator-height: 24px,
        guide-width: 1px,
        focus-ring-width: 2px,
        drop-target-border-width: 1px,
        drop-indicator-height: 2px,
        root-drop-height: 8px,
        selected-guide: Style.dark ? #474747 : #c4c4c4,
        file-guide: Style.dark ? #303030 : #e2e2e2,
        rename-bg: Palette.control-background,
        rename-border: Palette.border,
        error: Style.dark ? #ff7b72 : #cf222e,
    };

    out property <StyleWelcome> welcome: {
        stage-bg: Style.dark ? #202124 : #c9c9c9,
        shell-bg: Style.dark ? #303134 : #ffffff,
        side-bg: Style.dark ? #2a2b2e : #f5f5f6,
        control-bg: Style.dark ? #424347 : #eeeeef,
        control-hover: Style.dark ? #4d4f54 : #e2e3e5,
        text: Style.dark ? #f4f4f5 : #252527,
        muted: Style.dark ? #b5b6ba : #797a7d,
        accent: #0878f8,
    };

    out property <StyleLayout> layout: {
        left-pane-width: 286px,
        inspector-pane-width: 232px,
        top-bar-height: 54px,
        status-bar-height: 26px,
        splitter-size: 6px,
        pane-minimum: 120px,
        search-height: 34px,
        sidebar-button-width: 34px,
        sidebar-button-height: 30px,
        component-pane-height: 360px,
        image-pane-height: 540px,
        files-pane-minimum: 250px,
        left-heading-height: 48px,
        palette-card-height: 82px,
    };

    out property <StyleCanvas> canvas: {
        phone-frame-radius: 34px,
        phone-outer-padding: 1px,
        selection-outline-width: 1px,
        hover-outline-width: 2px,
        selection-handle-size: 8px,
        selection-handle-touch-size: 12px,
        rotation-zone-size: 22px,
        radius-handle-size: 10px,
        radius-handle-inset: 10px,
    };

    out property <StyleSpacing> spacing: {
        tight: 2px,
        small: 4px,
        compact: 6px,
        regular: 8px,
        control-inset: 10px,
        medium: 12px,
        pane-inset: 14px,
        large: 16px,
        icon-gap: 18px,
        section: 24px,
    };

    out property <StyleTypography> typography: {
        caption: { size: 11px, weight: 400 },
        control: { size: 12px, weight: 400 },
        body: { size: 13px, weight: 400 },
        action: { size: 14px, weight: 400 },
        heading: { size: 16px, weight: 400 },
        hero: { size: 34px, weight: 400 },
    };

    out property <StyleControls> controls: {
        border-width: 1px,
        focus-width: 2px,
        hairline-width: 0.5px,
        compact-radius: 3px,
        field-radius: 4px,
        small-radius: 5px,
        row-radius: 6px,
        panel-radius: 8px,
        dialog-radius: 9px,
        field-height: 24px,
        small-height: 28px,
        height: 32px,
        large-height: 36px,
        icon-size: 16px,
        small-icon-size: 12px,
        large-icon-size: 18px,
        disabled-opacity: 0.55,
    };

    out property <StyleMotion> motion: {
        fast: 120ms,
        feedback: 140ms,
        normal: 150ms,
        layout: 180ms,
    };

    out property <StyleShadows> shadows: {
        popup: { color: Style.dark ? #00000066 : #64748b30, blur: 12px, offset-y: 4px },
        picker: { color: Style.dark ? #00000080 : #64748b35, blur: 18px, offset-y: 7px },
        dial: { color: #00000025, blur: 2px, offset-y: 1px },
        slider: { color: #00000028, blur: 6px, offset-y: 2px },
        color-plane: { color: #00000080, blur: 3px, offset-y: 0px },
        color-slider: { color: #00000070, blur: 2px, offset-y: 0px },
    };
}
