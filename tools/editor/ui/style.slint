export global Style {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    private property <color> colors-accent: Style.dark ? #2379f4 : #0d99ff;

    out property <StyleColors> colors: {
        app-bg: Style.dark ? #2c2c2c : #f6f8fa,
        panel-bg: Style.dark ? #2c2c2c : #ffffff,
        panel-subtle: Style.dark ? #383838 : #f6f8fa,
        text: Style.dark ? #f1f1f1 : #1f2328,
        muted: Style.dark ? #b7b7b7 : #6e7781,
        border: Style.dark ? #494949 : #d0d7de,
        soft-border: Style.dark ? #3f3f3f : #eaeef2,
        accent: root.colors-accent,
        accent-strong: Style.dark ? root.colors-accent.mix(#ffffff, 0.75) : #52aeff,
        canvas-outline: Style.dark ? #0c8ce9 : #0b99fe,
        canvas: Style.dark ? #1f1f1f : #eef2f7,
        phone-bg: Style.dark ? #f7f8fb : #ffffff,
        phone-text: #20252d,
        object-bg: #ffffff,
        object-subtle: #f6f8fa,
        object-border: #d0d7de,
        object-muted: #6e7781,
        drop-mark-background: #ffffff,
        drop-mark-foreground: #ffffff,
        checker-light: #ffffff,
        checker-dark: #e1e1e1,
        marker-bg: Style.dark ? #3f3f3f : #b5ccdd,
        marker-active: #0c8ce9,
        handle-border: #ffffff,
        dialog-border: Style.dark ? #4a4d55 : #c8cbd2,
        dialog-bg: Style.dark ? #292a30 : #ffffff,
        error-icon-bg: Style.dark ? #542a2c : #fce6e5,
        error-icon-text: Style.dark ? #ffb4ab : #b3261e,
        error-border: Style.dark ? #63373a : #e0c5c2,
        error-bg: Style.dark ? #342426 : #fff7f6,
        error-text: Style.dark ? #f1b8b4 : #7a2925,
        dialog-footer-bg: Style.dark ? #25262b : #fafafa,
        dialog-footer-divider: Style.dark ? #3b3d43 : #e1e2e6,
        floating-border: Style.dark ? #ffffff18 : #d0d7de,
        update-error: Style.dark ? #ff9a94 : #b42318,
        action-text: #ffffff,
        image-field-bg: Style.dark ? #383838aa : #f5f5f5cc,
        image-rail-bg: Style.dark ? white.with-alpha(0.1) : white.with-alpha(0.4),
        image-rail-border: Style.dark ? #ffffff16 : #cbd5e166,
        image-preview-border: Style.dark ? #ffffff18 : #cbd5e166,
        action-bg: Style.dark ? #196bd6 : #0969da,
        action-hover: Style.dark ? #2073dd : #0860ca,
        action-pressed: Style.dark ? #135bb9 : #0756b5,
    };

    private property <color> inspector-accent: Style.colors.accent;

    private property <color> inspector-muted: Style.colors.muted;

    private property <length> inspector-side-padding: 12px;

    private property <length> inspector-stop-marker-size: 24px;

    private property <length> inspector-dial-size: 32px;

    private property <length> inspector-dial-inset: 2px;

    out property <StyleInspector> inspector: {
        picker-width: 260px,
        picker-gap: 8px,
        picker-margin: 8px,
        panel-bg: Style.colors.panel-bg,
        divider: Style.dark ? #414141 : #e5e5e5,
        field-bg: Style.dark ? #383838 : #f5f5f5,
        field-bg-hover: Style.dark ? #414141 : #eeeeee,
        field-border: Style.dark ? #4b4b4b : #d9d9d9,
        text: Style.colors.text,
        muted: root.inspector-muted,
        accent: root.inspector-accent,
        selected-control-bg: Style.dark ? Style.colors.action-bg : Style.colors.accent.with-alpha(0.14),
        slider-fill: Style.dark ? root.inspector-accent : transparent,
        slider-thumb: Style.dark ? root.inspector-accent : root.inspector-muted,
        label-width: 52px,
        row-gap: 6px,
        side-padding: root.inspector-side-padding,
        section-title-size: 12px,
        field-height: 24px,
        field-radius: 4px,
        column-width: 88px,
        column-gap: 8px,
        wide-width: Style.layout.inspector-pane-width - Style.controls.border-width - 2 * root.inspector-side-padding,
        stop-action-width: 24px,
        close-width: 48px,
        stop-position-width: 66px,
        stop-opacity-width: 48px,
        stop-row-height: 28px,
        stop-ramp-height: 58px,
        stop-marker-size: root.inspector-stop-marker-size,
        stop-marker-radius: 5px,
        stop-ramp-inset: root.inspector-stop-marker-size / 2,
        dial-size: root.inspector-dial-size,
        dial-inset: root.inspector-dial-inset,
        dial-face-size: root.inspector-dial-size - 2 * root.inspector-dial-inset,
        dial-dot-size: 4px,
        dial-dot-distance: 9px,
        copy-width: 54px,
        menu-row-height: 26px,
        menu-available-height: 220px,
        recent-swatch-size: 22px,
        color-field-height: 170px,
        color-slider-height: 16px,
        color-slider-thumb-size: 14px,
        color-plane-thumb-size: 12px,
        checker-size: 8px,
        dial-ring: @linear-gradient(145deg, Style.dark ? #262a30 : #bdc3cc, Style.dark ? #737c87 : #ffffff),
        dial-face: @radial-gradient(circle at 10px 7px, Style.dark ? #89919b : #ffffff, Style.dark ? #5b626d : #f4f6f9 55%, Style.dark ? #343a43 : #d8dde5),
        dial-dot: @linear-gradient(180deg, #0879b7, #38b9fa),
        dial-ring-border: Style.dark ? #454b55 : #cbd0d8,
        dial-face-border: Style.dark ? #858e99 : #ffffff,
        dial-dot-border: Style.dark ? #343e4a : #b9cbd9,
        slider-height: 34px,
        slider-label-width: 48px,
        slider-track-width: 62px,
        slider-track-height: 3px,
        slider-thumb-size: 11px,
        slider-value-width: 44px,
        slider-plain-value-width: 52px,
        slider-suffix-width: 12px,
        radius-thumb-size: 10px,
        radius-track-width: 2px,
        radius-inset: 6px,
        gradient-label-width: 58px,
        gradient-value-width: 62px,
        color-hex-width: 78px,
        color-hex-input-width: 58px,
        stop-pick-distance: 10px,
        syntax-min-height: 54px,
        syntax-max-height: 96px,
        info-size: 14px,
        stop-swatch-size: 14px,
        corner-field-width: 72px,
    };

    out property <StyleTree> tree: {
        row-bg-hover: Style.dark ? #383838 : #f5f5f5,
        row-bg-current: Style.dark ? Style.colors.accent.with-alpha(0.22) : #e4f4ff,
        drop-target-bg: Style.dark ? Style.colors.accent.with-alpha(0.14) : #eaf5ff,
        text: Style.colors.text,
        muted-text: Style.colors.muted,
        accent: Style.dark ? Style.colors.accent : #0969da,
        guide: Style.inspector.divider,
        directory-icon: Style.dark ? Style.colors.accent : #d29922,
        row-height: 32px,
        row-font-size: 13px,
        row-radius: 6px,
        row-padding-inline: 8px,
        content-gap: 8px,
        toggle-width: 16px,
        disclosure-hit-size: 20px,
        icon-size: 16px,
        current-indicator-width: 4px,
        current-indicator-height: 24px,
        guide-width: 1px,
        focus-ring-width: 2px,
        drop-target-border-width: 1px,
        drop-indicator-height: 2px,
        root-drop-height: 8px,
        selected-guide: Style.dark ? #474747 : #c4c4c4,
        file-guide: Style.inspector.divider,
        rename-bg: Palette.control-background,
        rename-border: Palette.border,
        error: Style.dark ? #ff7b72 : #cf222e,
    };

    private property <length> welcome-action-height: Style.controls.large-height;

    private property <length> welcome-action-block-gap: Style.spacing.regular;

    out property <StyleWelcome> welcome: {
        stage-bg: Style.dark ? #202124 : #c9c9c9,
        shell-bg: Style.dark ? #303134 : #ffffff,
        side-bg: Style.dark ? #2a2b2e : #f5f5f6,
        control-bg: Style.dark ? #424347 : #eeeeef,
        control-hover: Style.dark ? #4d4f54 : #e2e3e5,
        text: Style.dark ? #f4f4f5 : #252527,
        muted: Style.dark ? #b5b6ba : #797a7d,
        accent: #0878f8,
        shell-width: 740px,
        shell-height: 460px,
        outer-inset: 16px,
        compact-threshold: 620px,
        compact-side-width: 220px,
        side-width: 270px,
        shell-radius: 20px,
        action-height: root.welcome-action-height,
        action-radius: root.welcome-action-height / 2,
        action-inset: Style.spacing.medium,
        action-gap: 10px,
        recent-height: 44px,
        recent-radius: Style.controls.row-radius,
        recent-inset-left: Style.spacing.medium,
        recent-inset-right: Style.spacing.medium,
        recent-gap: Style.spacing.regular,
        recent-icon-size: 27px,
        recent-text-gap: Style.spacing.tight,
        brand-size: 103px,
        hero-top: 64px,
        hero-gap: 18px,
        hero-title-height: 37px,
        hero-subtitle-height: 17px,
        action-block-inset: 56px,
        action-bottom-inset: 130px,
        action-block-height: 2 * root.welcome-action-height + root.welcome-action-block-gap,
        action-block-gap: root.welcome-action-block-gap,
        recent-panel-inset: 10px,
        recent-panel-height: 195px,
        recent-panel-gap: 5px,
        pressed-bg: Style.dark ? #55575d : #d9dadd,
        selected-muted: #d7e7ff,
        shell-border: Style.dark ? #ffffff22 : #98999d,
        brand-brush: @linear-gradient(155deg, #32e1ff 0%, #0b89ff 52%, #115bea 100%),
        brand-grid-horizontal: #ffffff26,
        brand-grid-vertical: #ffffff22,
    };

    private property <length> layout-image-tab-height: Style.controls.height;

    out property <StyleLayout> layout: {
        left-pane-width: 286px,
        inspector-pane-width: 232px,
        top-bar-height: 54px,
        status-bar-height: 26px,
        splitter-size: 6px,
        pane-minimum: 120px,
        search-height: Style.controls.height,
        sidebar-button-width: 34px,
        sidebar-button-height: Style.controls.height,
        component-pane-height: 360px,
        image-pane-height: 540px,
        files-pane-minimum: 250px,
        left-heading-height: 48px,
        palette-card-height: 82px,
        window-width: 1360px,
        window-height: 860px,
        window-min-width: 1040px,
        window-min-height: 680px,
        dialog-width: 360px,
        dialog-height: 212px,
        dialog-padding: 20px,
        dialog-footer-height: 56px,
        dialog-error-height: 46px,
        dialog-error-icon-size: 30px,
        dialog-error-inset: 11px,
        image-tab-height: root.layout-image-tab-height,
        image-tab-group-height: root.layout-image-tab-height + 2 * Style.spacing.small,
        image-tab-group-width: 216px,
        image-tab-bar-height: 58px,
        image-rail-margin: 24px,
        image-rail-gap: 28px,
        image-property-height: 260px,
        image-preview-property-height: 154px,
        image-preview-panel-height: 196px,
        image-safe-bottom: 44px,
        image-fit-bottom: 64px,
        image-preview-minimum: 48px,
        image-wide-field-width: 250px,
        image-field-width: 96px,
        image-syntax-min-height: 78px,
        image-syntax-max-height: 96px,
        image-error-max-width: 520px,
        image-error-height: 96px,
        collapsed-panel-width: 274px,
        collapsed-panel-height: 42px,
        titlebar-safe-left: 100px,
        update-pill-width: 132px,
        update-error-pill-width: 260px,
        update-pill-height: 20px,
    };

    out property <StyleCanvas> canvas: {
        phone-frame-radius: 34px,
        phone-outer-padding: 1px,
        selection-outline-width: 1px,
        hover-outline-width: 2px,
        selection-handle-size: 8px,
        selection-handle-touch-size: 12px,
        rotation-zone-size: 22px,
        radius-handle-size: 10px,
        radius-handle-inset: 10px,
        grid-pitch: 32px,
        grid-width: 1px,
        artboard-top-minimum: 40px,
        gradient-hit-size: 32px,
        gradient-endpoint-size: 12px,
        gradient-axis-hit-size: 10px,
        gradient-axis-width: 2px,
        gradient-stop-offset: 6px,
        slice-label-size: 22px,
        slice-line-width: 4px,
        slice-hit-size: 20px,
