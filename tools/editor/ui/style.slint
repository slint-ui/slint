    out property <WelcomeHeroStyle> welcome-hero: SharedStyle.welcome-hero;
    out property <WelcomeActionsStyle> welcome-actions: Theme.current == ThemeKind.dark ? DarkTheme.welcome-actions : LightTheme.welcome-actions;
    out property <RecentProjectListStyle> recent-project-list: SharedStyle.recent-project-list;
    out property <RecentProjectRowStyle> recent-project-row: Theme.current == ThemeKind.dark ? DarkTheme.recent-project-row : LightTheme.recent-project-row;
    out property <WelcomeBrandStyle> welcome-brand: SharedStyle.welcome-brand;
    out property <CanvasSurfaceStyle> canvas-surface: Theme.current == ThemeKind.dark ? DarkTheme.canvas-surface : LightTheme.canvas-surface;
