import { Icons } from "icons.slint";

export global EditorTreeIcons {
    out property <image> default-item: Icons.panels-top-left;
    out property <image> rectangle: Icons.square;
    out property <image> touch-area: Icons.pointer;
    out property <image> text: Icons.type;
    out property <image> styled-text: Icons.a-large-small;
    out property <image> flickable: Icons.hand;
    out property <image> swipe-gesture-handler: Icons.move-horizontal;
    out property <image> scale-rotate-gesture-handler: Icons.scaling;
    out property <image> drag-area: Icons.grip;
    out property <image> drop-area: Icons.square-dashed-mouse-pointer;
    out property <image> focus-scope: Icons.focus;
    out property <image> text-input: Icons.text-cursor-input;
    out property <image> horizontal-layout: Icons.columns-3;
    out property <image> vertical-layout: Icons.rows-3;
    out property <image> grid-layout: Icons.grid-2x2;
    out property <image> flexbox-layout: Icons.layout-grid;
    out property <image> window-move-area: Icons.move;
}
