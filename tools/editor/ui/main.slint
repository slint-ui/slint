import { Style } from "style.slint";
import "./assets/Inter-VariableFont.ttf";

import { Api, EditorSurfaceMode, Hover } from "api.slint";
import { InspectorFillPicker } from "components/inspector/fill-picker.slint";
import { FillSession } from "components/inspector/fill-session.slint";
export { FillSessionRequest, FillSessionTarget } from "components/inspector/fill-session.slint";
import { Project } from "project.slint";
import { Preview } from "preview.slint";
import { StartupWizard } from "startup-wizard.slint";
import { AppState, ElementKind, SidebarToggleButton } from "components/common.slint";
import { DragPreview } from "components/drag-preview.slint";
import { GradientOverlay } from "components/gradient-overlay.slint";
import { EditorCanvas } from "components/editor-canvas.slint";
import { EditorTopBar } from "components/top-bar.slint";
import { ImageAssetEditor } from "components/image-asset-editor.slint";
import { InspectorPane } from "components/inspector-pane.slint";
import { LeftPane } from "components/left-pane.slint";
import { EditorMetrics, EditorWindow } from "components/common.slint";
import { UpdateStatus, UpdateStatusBar, UpdateStatusPill } from "components/update-status.slint";

export { Api, Hover, Preview, Project, FillSession }
export { EditorCursors, EditorMetrics, EditorWindow } from "components/common.slint";

component NewFileErrorPopup inherits PopupWindow {
    in property <string> error;
    callback dismissed();

    width: Style.layout.dialog-width;
    height: Style.layout.dialog-height;
    close-policy: no-auto-close;

    Rectangle {
        border-width: Style.controls.border-width;
        border-color: Style.colors.dialog-border;
        border-radius: Style.controls.dialog-radius;
        background: Style.colors.dialog-bg;
        clip: true;
        drop-shadow-blur: Style.shadows.dialog.blur;
        drop-shadow-offset-y: Style.shadows.dialog.offset-y;
        drop-shadow-color: Style.shadows.dialog.color;

        VerticalLayout {
            height: parent.height;

            Rectangle {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: Style.layout.dialog-padding;
                    spacing: Style.spacing.pane-inset;

                    HorizontalLayout {
                        spacing: Style.spacing.medium;
                        cross-axis-alignment: start;

                        Rectangle {
                            width: Style.layout.dialog-error-icon-size;
                            height: Style.layout.dialog-error-icon-size;
                            border-radius: Style.layout.dialog-error-icon-size / 2;
                            background: Style.colors.error-icon-bg;

                            Text {
                                text: "×";
                                color: Style.colors.error-icon-text;
                                font-size: Style.typography.error-icon.size;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            spacing: Style.spacing.small;

                            Text {
                                text: @tr("Couldn’t create file");
                                color: Style.colors.text;
                                font-size: Style.typography.heading.size;
                                font-weight: Style.typography.heading.weight;
                            }

                            Text {
                                text: @tr("A new Slint file couldn’t be created in the project root.");
                                color: Style.colors.muted;
                                font-size: Style.typography.body.size;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: Style.layout.dialog-error-height;
                        border-width: Style.controls.border-width;
                        border-color: Style.colors.error-border;
                        border-radius: Style.controls.row-radius;
                        background: Style.colors.error-bg;

                        Text {
                            x: Style.layout.dialog-error-inset;
                            width: parent.width - 2 * Style.layout.dialog-error-inset;
                            text: root.error;
                            color: Style.colors.error-text;
                            font-size: Style.typography.caption.size;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: Style.layout.dialog-footer-height;
                vertical-stretch: 0;
                background: Style.colors.dialog-footer-bg;

                Rectangle {
                    height: Style.controls.border-width;
                    y: 0px;
                    background: Style.colors.dialog-footer-divider;
                }

                Rectangle {
                    width: bt.width + 2 * Style.spacing.regular;
                    height: Style.controls.height;
                    x: parent.width - self.width - Style.spacing.large;
                    y: (parent.height - self.height) / 2;
                    border-width: Style.controls.border-width;
                    border-color: close-touch.pressed ? Style.colors.action-pressed : close-touch.has-hover ? Style.colors.action-hover : Style.colors.action-bg;
                    border-radius: Style.controls.small-radius;
                    background: close-touch.pressed ? Style.colors.action-pressed : close-touch.has-hover ? Style.colors.action-hover : Style.colors.action-bg;

                    bt := Text {
                        text: @tr("Close");
                        color: Style.colors.action-text;
                        font-size: Style.typography.strong-body.size;
                        font-weight: Style.typography.strong-body.weight;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: AccessibleRole.button;
                        accessible-label: @tr("Close");
                        clicked => {
                            root.close();
                            root.dismissed();
                        }
                    }
                }
            }
        }
    }
}

export component EditorUi inherits Window {
    preferred-width: Style.layout.window-width;
    preferred-height: Style.layout.window-height;
    min-width: Style.layout.window-min-width;
    min-height: Style.layout.window-min-height;
    title: "Slint Visual Editor";
    background: Style.colors.app-bg;
    default-font-family: Style.typography.family;

    init => {
        EditorWindow.width = root.width;
        EditorWindow.height = root.height;
    }
    changed width => { EditorWindow.width = root.width; }
    changed height => { EditorWindow.height = root.height; }

    property <bool> sidebars-collapsed: false;
    property <length> inspector-scroll-y: 0px;
    in property <length> elements-pane-height: 0px;
    in property <length> outline-pane-height: 0px;
    callback elements-pane-resized(length);
    callback outline-pane-resized(length);
    callback elements-pane-reset();
    callback outline-pane-reset();
    callback perform-native-window-zoom() -> bool;
    private property <string> new-file-error;

    function create-new-slint-file() {
        root.new-file-error = Project.create-new-slint-file();
        if root.new-file-error != "" {
            new-file-error-popup.show();
        }
    }

    function open-startup-wizard() {
        Api.open-startup-wizard();
    }

    function close-startup-wizard() {
        Api.close-startup-wizard();
    }

    function open-project() {
        root.close-startup-wizard();
    }
    function apply-history(redo: bool) {
        FillSession.apply-history(redo);
    }

    function toggle-maximized() {
        if !root.perform-native-window-zoom() {
            root.maximized = !root.maximized;
        }
    }

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New Slint File");
                enabled: Project.file-tree.length > 0;
                activated => { root.create-new-slint-file(); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Undo");
                enabled: Api.undo-enabled;
                activated => { root.apply-history(false); }
            }
            MenuItem {
                title: @tr("Redo");
                enabled: Api.redo-enabled;
                activated => { root.apply-history(true); }
            }
        }
    }

    Rectangle {
        y: 0;
        height: EditorMetrics.top-bar-height;
        WindowMoveArea {
            TouchArea {
                double-clicked => { root.toggle-maximized(); }
            }
        }
    }

    VerticalLayout {
        if !Api.startup-wizard-visible: editor := FocusScope {
            property <bool> shift-pressed: false;

            init => {
                self.focus();
            }

            capture-key-pressed(event) => {
                if event.text == Key.Shift || event.text == Key.ShiftR {
                    self.shift-pressed = true;
                    return reject;
                }
                reject
            }

            capture-key-released(event) => {
                if event.text == Key.Shift || event.text == Key.ShiftR {
                    self.shift-pressed = false;
                    return reject;
                }
                reject
            }

            key-pressed(event) => {
                let redo-y = Platform.os == OperatingSystemType.windows && (event.text == "y" || event.text == "Y");
                if (event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z" || redo-y) {
                    root.apply-history(event.modifiers.shift || redo-y);
                    return accept;
                }
                if event.text == Key.Escape && AppState.has-active-drag() {
                    AppState.cancel-active-drags();
                    return accept;
                }
                if (event.text == Key.Delete || event.text == Key.Backspace)
                    && Api.selection.highlight-index >= 0 {
                    Api.selected-element-delete();
                    return accept;
                }
                reject
            }

            focus-lost => {
                self.shift-pressed = false;
            }

            DropArea {
                can-drop(event) => {
                    if AppState.palette-drag-kind != ElementKind.none {
                        AppState.update-palette-drag(AppState.palette-drag-kind, { x: event.position.x + self.absolute-position.x, y: event.position.y + self.absolute-position.y });
                    }
                    return DragAction.none;
                }

                Rectangle {
                    background: Style.colors.app-bg;
                }

                VerticalLayout {
                    title-move-area := WindowMoveArea {
                        height: EditorMetrics.top-bar-height;

                        title-touch-area := TouchArea {
                            double-clicked => { root.toggle-maximized(); }
                        }

                        EditorTopBar { }
                    }

                    HorizontalLayout {
                        vertical-stretch: 1;

                        if !root.sidebars-collapsed: LeftPane {
                            can-collapse: true;
                            elements-pane-height: root.elements-pane-height;
                            drag-started => { editor.focus(); }
                            panes-collapsed => {
                                root.sidebars-collapsed = true;
                            }
                            elements-pane-resized(height) => {
                                root.elements-pane-resized(height);
                            }
                            elements-pane-reset => {
                                root.elements-pane-reset();
                            }
                            create-new-slint-file => { root.create-new-slint-file(); }
                        }

                        if Api.editor-surface-mode == EditorSurfaceMode.component: EditorCanvas {
                            shift-pressed: editor.shift-pressed;
                            real-element-selected => { editor.focus(); }
                        }

                        if Api.editor-surface-mode == EditorSurfaceMode.image: ImageAssetEditor {
                            sidebars-collapsed: root.sidebars-collapsed;
                        }

                        if Api.editor-surface-mode == EditorSurfaceMode.component && !root.sidebars-collapsed: InspectorPane {
                            outline-pane-height: root.outline-pane-height;
                            element-information: Api.current-element;
                            inspector-scroll-y <=> root.inspector-scroll-y;
                            element-selected => { editor.focus(); }
                            outline-drag-started => { editor.focus(); }
                            outline-pane-resized(height) => {
                                root.outline-pane-resized(height);
                            }
                            outline-pane-reset => {
                                root.outline-pane-reset();
                            }
                        }
                    }
                }

                DragPreview { parent-origin: parent.absolute-position; }

                if root.sidebars-collapsed: Rectangle {
                    x: Style.spacing.large;
                    y: EditorMetrics.top-bar-height + Style.spacing.medium;
                    width: Style.layout.collapsed-panel-width;
                    height: Style.layout.collapsed-panel-height;
                    border-radius: 12px;
                    border-width: Style.controls.border-width;
                    border-color: Style.colors.floating-border;
                    background: Style.colors.panel-bg.with-alpha(0.92);
                    drop-shadow-blur: Style.shadows.floating.blur;
                    drop-shadow-offset-y: Style.shadows.floating.offset-y;
                    drop-shadow-color: Style.shadows.floating.color;

                    HorizontalLayout {
                        padding-left: Style.spacing.medium;
                        padding-right: Style.spacing.compact;
                        spacing: Style.spacing.control-inset;
                        cross-axis-alignment: center;

                        Text {
                            horizontal-stretch: 1;
                            text: Project.selected-project-file;
                            color: Style.colors.text;
                            font-size: Style.typography.body.size;
                            font-weight: FontWeight.extra-bold;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        SidebarToggleButton {
                            active: true;
                            accessible-role: AccessibleRole.button;
                            accessible-label: "Expand sidebars";
                            clicked => {
                                root.sidebars-collapsed = false;
                            }
                        }
                    }
                }
            }
        }

        if Api.startup-wizard-visible: StartupWizard {
            opened => {
                root.open-project();
            }
            create-new-project => {
                Project.create-new-project();
            }
            open-existing-project => {
                Project.open-existing-project();
            }
        }

        if UpdateStatus.shows-bar(): UpdateStatusBar { }
    }

    new-file-error-popup := NewFileErrorPopup {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        error: root.new-file-error;
        dismissed => { root.new-file-error = ""; }
    }

    fill-layer := TouchArea {
        visible: FillSession.open;
        enabled: FillSession.open;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                Api.dismiss-fill-picker({ x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y }, event.button);
            }
        }
        if FillSession.canvas-active: GradientOverlay {
            x: FillSession.canvas-origin.x - fill-layer.absolute-position.x;
            y: FillSession.canvas-origin.y - fill-layer.absolute-position.y;
            width: FillSession.canvas-size.width;
            height: FillSession.canvas-size.height;
            selection: FillSession.selection;
        }
        InspectorFillPicker { }
    }

    if UpdateStatus.in-titlebar() && UpdateStatus.has-news(): UpdateStatusPill {
        x: Style.layout.titlebar-safe-left;
        y: Style.spacing.large;
    }
}
