export interface SliderInterface {
    in property <bool> enabled;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step;
    in property <float> page-step;
    in property <Orientation> orientation;
    in property <bool> inverted;

    in-out property <float> value;

    out property <bool> has-focus;
    out property <bool> hovered;
    out property <bool> pressed;
    out property <float> position;
    out property <float> visual-position;

    callback changed(value: float);
    callback released(value: float);

    public function set-value(requested: float);

    public function set-position(position: float);
}
