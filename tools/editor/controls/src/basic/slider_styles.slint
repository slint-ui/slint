import { SliderStyle, SliderMetrics } from "slider_style.slint";
import { BasicTheme } from "theme.slint";

export global SliderStyles {
    out property <SliderStyle> standard: {
        rest: {
            track-color: BasicTheme.hover-background,
            fill-color: BasicTheme.accent,
            handle-color: BasicTheme.accent,
            handle-border-color: BasicTheme.border,
        },
        hover: {
            track-color: BasicTheme.hover-background,
            fill-color: BasicTheme.accent,
            handle-color: BasicTheme.accent-hover,
            handle-border-color: BasicTheme.border,
        },
        pressed: {
            track-color: BasicTheme.hover-background,
            fill-color: BasicTheme.accent,
            handle-color: BasicTheme.accent-pressed,
            handle-border-color: BasicTheme.border,
        },
        disabled: {
            track-color: BasicTheme.disabled-background,
            fill-color: BasicTheme.disabled-foreground,
            handle-color: BasicTheme.disabled-foreground,
            handle-border-color: BasicTheme.border,
        },
        focus-color: BasicTheme.focus,
    };
}

export global SliderSizes {
    out property <SliderMetrics> small: {
        preferred-length: 160px,
        min-thickness: 24px,
        handle-width: 16px,
        handle-height: 16px,
        track-thickness: 3px,
    };
    out property <SliderMetrics> medium: {
        preferred-length: 200px,
        min-thickness: 32px,
        handle-width: 20px,
        handle-height: 20px,
        track-thickness: 4px,
    };
    out property <SliderMetrics> large: {
        preferred-length: 240px,
        min-thickness: 40px,
        handle-width: 24px,
        handle-height: 24px,
        track-thickness: 6px,
    };
}
