import { CheckBoxBase } from "../headless.slint";
import {
    CheckBoxStyle,
    CheckBoxStateStyle,
    CheckBoxStateStyles,
    CheckBoxMetrics,
} from "check_box_style.slint";
import { CheckBoxStyles, CheckBoxSizes } from "check_box_styles.slint";
import { FocusOutline } from "focus_outline.slint";

export component CheckBox inherits CheckBoxBase {
    in property <CheckBoxStyle> style: CheckBoxStyles.standard;
    in property <CheckBoxMetrics> size: CheckBoxSizes.medium;
    private property <CheckBoxStateStyles> selected-styles: root.checked ? root.style.checked : root.style.unchecked;
    private property <CheckBoxStateStyle> state-style: root.selected-styles.rest;
    in property <brush> checked-color: root.state-style.indicator-color;
    in property <brush> foreground-color: root.state-style.foreground-color;

    in property <string> font-family;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;
    in property <bool> font-italic;
    spacing: root.text == "" ? 0px : root.size.spacing;
    horizontal-padding: root.size.padding-horizontal;
    vertical-padding: root.size.padding-vertical;
    min-height: root.size.min-height;

    states [
        disabled when !root.enabled: {
            state-style: root.selected-styles.disabled;
        }
        pressed when root.pressed: {
            state-style: root.selected-styles.pressed;
        }
        hover when root.hovered: {
            state-style: root.selected-styles.hover;
        }
    ]

    indicator << Rectangle {
        width: root.size.indicator-size;
        height: root.size.indicator-size;
        vertical-stretch: 0;
        background: root.enabled && root.checked ? root.checked-color : root.state-style.indicator-color;
        border-color: root.state-style.indicator-border-color;
        border-width: root.size.indicator-border-width;
        border-radius: root.size.indicator-radius;

        if root.checked: Path {
            x: root.size.checkmark-padding;
            y: root.size.checkmark-padding;
            width: max(0px, parent.width - 2 * root.size.checkmark-padding);
            height: max(0px, parent.height - 2 * root.size.checkmark-padding);
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: root.state-style.checkmark-color;
            stroke-width: root.size.checkmark-width;
            MoveTo {
                x: 2;
                y: 8;
            }

            LineTo {
                x: 6;
                y: 12;
            }

            LineTo {
                x: 14;
                y: 4;
            }
        }

        focus-outline := FocusOutline {
            active: root.enabled && root.has-focus;
            outline-color: root.style.focus-color;
            target-width: parent.width;
            target-height: parent.height;
            line-width: root.size.focus-width;
            offset: root.size.focus-offset;
            radius: root.size.indicator-radius;
        }
    }

    content << HorizontalLayout {
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? root.foreground-color : root.state-style.foreground-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-family: root.font-family;
            font-italic: root.font-italic;
            vertical-alignment: center;
        }
    }
}
