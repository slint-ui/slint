import { ButtonBase } from "../headless.slint";
import {
    ButtonStateStyle,
    ButtonStyle,
    ButtonSizeMetrics,
    ButtonSizes,
} from "button_style.slint";
import { ButtonStyles } from "button_styles.slint";

export component Button inherits ButtonBase {
    in property <ButtonStyle> style: root.primary || root.checked ? ButtonStyles.primary : ButtonStyles.secondary;
    in property <ButtonSizeMetrics> size: ButtonSizes.medium;
    private property <ButtonStateStyle> current-style: root.style.rest;

    in property <brush> background-color: root.current-style.background-color;
    in property <brush> foreground: root.current-style.foreground;
    in property <brush> border-color: root.current-style.border-color;
    in property <length> border-width: root.current-style.border-width;
    in property <length> border-radius: root.style.border-radius;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;
    in property <length> spacing: root.size.spacing;

    icon-size: root.size.icon-size;
    content-padding: root.size.padding-vertical;
    content-padding-left: root.size.padding-horizontal;
    content-padding-right: root.size.padding-horizontal;
    min-width: root.size.min-width;
    min-height: root.size.min-height;

    states [
        disabled when !root.enabled: {
            current-style: root.style.disabled;
        }
        pressed when root.pressed: {
            current-style: root.style.pressed;
        }
        hover when root.hovered: {
            current-style: root.style.hover;
        }
    ]

    background << Rectangle {
        background: root.background-color;
        border-color: root.border-color;
        border-width: root.border-width;
        border-radius: root.border-radius;

        focus-outline := Rectangle {
            private property <length> outset: root.style.focus-offset + root.style.focus-width;
            x: -self.outset;
            y: -self.outset;
            width: parent.width + 2 * self.outset;
            height: parent.height + 2 * self.outset;
            visible: false;
            background: transparent;
            border-color: root.style.focus-color;
            border-width: root.style.focus-width;
            border-radius: root.border-radius + self.outset;

            states [
                focused when root.enabled && root.has-focus && root.style.focus-width > 0px: {
                    visible: true;
                }
            ]
        }
    }

    content << HorizontalLayout {
        spacing: root.spacing;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0: Image {
            width: root.icon-size;
            height: root.icon-size;
            source: root.icon;
            colorize: root.colorize-icon ? root.foreground : transparent;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.foreground;
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
