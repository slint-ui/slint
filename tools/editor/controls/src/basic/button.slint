import { ButtonBase } from "../headless.slint";
import { BasicTheme } from "theme.slint";

export struct ButtonStateStyle {
    background-color: brush,
    foreground-color: brush,
    border-color: brush,
}

export struct ButtonStyle {
    rest: ButtonStateStyle,
    hover: ButtonStateStyle,
    pressed: ButtonStateStyle,
    disabled: ButtonStateStyle,
    focus-color: brush,
}

export global ButtonStyles {
    out property <ButtonStyle> secondary: {
        rest: {
            background-color: BasicTheme.background,
            foreground-color: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        hover: {
            background-color: BasicTheme.hover-background,
            foreground-color: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        pressed: {
            background-color: BasicTheme.pressed-background,
            foreground-color: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        disabled: {
            background-color: BasicTheme.disabled-background,
            foreground-color: BasicTheme.disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };
    out property <ButtonStyle> primary: {
        rest: {
            background-color: BasicTheme.accent,
            foreground-color: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        hover: {
            background-color: BasicTheme.accent-hover,
            foreground-color: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.accent-pressed,
            foreground-color: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        disabled: ButtonStyles.secondary.disabled,
        focus-color: BasicTheme.focus,
    };
    out property <ButtonStyle> danger: {
        rest: {
            background-color: BasicTheme.background,
            foreground-color: BasicTheme.danger,
            border-color: BasicTheme.border,
        },
        hover: {
            background-color: BasicTheme.danger-hover,
            foreground-color: BasicTheme.danger-foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.danger-pressed,
            foreground-color: BasicTheme.danger-foreground,
            border-color: transparent,
        },
        disabled: {
            background-color: BasicTheme.disabled-background,
            foreground-color: BasicTheme.danger-disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };
    out property <ButtonStyle> invisible: {
        rest: {
            background-color: transparent,
            foreground-color: BasicTheme.foreground,
            border-color: transparent,
        },
        hover: {
            background-color: BasicTheme.invisible-hover-background,
            foreground-color: BasicTheme.foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.invisible-pressed-background,
            foreground-color: BasicTheme.foreground,
            border-color: transparent,
        },
        disabled: {
            background-color: transparent,
            foreground-color: BasicTheme.disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };
}

export component Button inherits ButtonBase {
    in property <ButtonStyle> style: root.primary || root.checked ? ButtonStyles.primary : ButtonStyles.secondary;

    in property <brush> background-color: root.state-style.background-color;
    in property <brush> foreground-color: root.state-style.foreground-color;
    in property <brush> icon-color: root.foreground-color;

    in property <string> font-family;
    in property <length> font-size: 1rem;
    in property <int> font-weight: 400;
    in property <bool> font-italic;

    in property <length> spacing: 6px;
    in property <length> horizontal-padding: 12px;
    in property <length> vertical-padding: 6px;
    in property <length> left-padding: root.horizontal-padding;
    in property <length> right-padding: root.horizontal-padding;
    in property <length> top-padding: root.vertical-padding;
    in property <length> bottom-padding: root.vertical-padding;

    in property <length> border-width: 1px;
    in property <length> border-radius: 4px;

    in property <length> focus-width: 2px;
    in property <length> focus-offset: 2px;

    private property <ButtonStateStyle> state-style: root.style.rest;

    states [
        disabled when !root.enabled: {
            state-style: root.style.disabled;
        }
        pressed when root.pressed: {
            state-style: root.style.pressed;
        }
        hover when root.hovered: {
            state-style: root.style.hover;
        }
    ]

    background << surface := Rectangle {
        background: root.enabled ? root.background-color : root.state-style.background-color;
        border-color: root.state-style.border-color;
        border-width: root.border-width;
        border-radius: root.border-radius;

        focus-outline := Rectangle {
            private property <length> outset: root.focus-offset + root.focus-width;
            x: -self.outset;
            y: -self.outset;
            width: parent.width + 2 * self.outset;
            height: parent.height + 2 * self.outset;
            visible: root.enabled && root.has-focus && root.focus-width > 0px;
            border-color: root.style.focus-color;
            border-width: root.focus-width;
            border-radius: root.border-radius + self.outset;
        }
    }

    content << HorizontalLayout {
        padding-left: root.left-padding;
        padding-right: root.right-padding;
        padding-top: root.top-padding;
        padding-bottom: root.bottom-padding;
        spacing: root.spacing;
        alignment: center;
        if root.icon.width > 0 && root.icon.height > 0: Image {
            width: root.icon-size;
            height: root.icon-size;
            source: root.icon;
            colorize: !root.colorize-icon ? transparent : root.enabled ? root.icon-color : root.state-style.foreground-color;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? root.foreground-color : root.state-style.foreground-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-family: root.font-family;
            font-italic: root.font-italic;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
