export struct LineEditStateStyle {
    background-color: brush,
    foreground-color: brush,
    border-color: brush,
    placeholder-color: brush,
}

export struct LineEditStyle {
    rest: LineEditStateStyle,
    hover: LineEditStateStyle,
    disabled: LineEditStateStyle,
    selection-background-color: color,
    selection-foreground-color: color,
    focus-color: brush,
}

export struct LineEditMetrics {
    min-height: length,
    min-width: length,
    padding-horizontal: length,
    padding-vertical: length,
    font-size: length,
    font-weight: int = 400,
    spacing: length,
    border-width: length = 1px,
    border-radius: length = 4px,
    focus-width: length = 2px,
    focus-offset: length = 2px,
}
