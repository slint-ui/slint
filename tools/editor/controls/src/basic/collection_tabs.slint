import { BasicTheme } from "theme.slint";

interface TabEntry {
    in property <string> title;
}

export component CollectionTab inherits Rectangle {
    in property <string> title;
    accessible-role: tab-panel;
    accessible-label: root.title;
    @children
}

component TabHeader inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    in property <bool> focused;
    callback activated();
    horizontal-stretch: 0;
    min-width: 88px;
    background: root.selected ? BasicTheme.accent.with-alpha(0.1)
        : pointer.has-hover ? BasicTheme.hover-background : transparent;
    accessible-role: tab;
    accessible-label: root.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.title;
            color: root.selected ? BasicTheme.accent : BasicTheme.foreground;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: root.selected ? BasicTheme.accent : transparent;
    }
    if root.focused: Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-width: 1px;
        border-radius: 4px;
        border-color: BasicTheme.focus;
    }
    pointer := TouchArea {
        clicked => { root.activated(); }
    }
}

export component CollectionTabWidget inherits Rectangle {
    in-out property <int> current-index: 0;
    out property <int> item-count: tabs.length;
    private property <int> focused-index: 0;
    default slot <[implements TabEntry]> tabs;

    forward-focus: bar-focus;

    function activate(index: int) {
        if index >= 0 && index < root.item-count {
            root.current-index = index;
            root.focused-index = index;
            bar-focus.focus();
        }
    }

    bar-focus := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.item-count > 0;
        focus-gained => {
            root.focused-index = Math.min(Math.max(root.current-index, 0), root.item-count - 1);
        }
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.focused-index = Math.max(root.focused-index - 1, 0);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.focused-index = Math.min(root.focused-index + 1, root.item-count - 1);
                return accept;
            }
            if event.text == Key.Home {
                root.focused-index = 0;
                return accept;
            }
            if event.text == Key.End {
                root.focused-index = root.item-count - 1;
                return accept;
            }
            if event.text == Key.Return || event.text == Key.Space {
                root.activate(root.focused-index);
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        Flickable {
            min-height: 40px;
            preferred-height: 40px;
            vertical-stretch: 0;
            content-width: Math.max(self.width, header-row.preferred-width);
            content-height: self.height;
            accessible-role: tab-list;
            accessible-item-count: root.item-count;
            accessible-delegate-focus: bar-focus.has-focus ? root.focused-index : root.current-index;

            header-row := HorizontalLayout {
                width: parent.content-width;
                height: parent.height;
                spacing: 4px;
                alignment: start;
                for tab[index] in tabs: TabHeader {
                    title: tab.title;
                    selected: root.current-index == index;
                    focused: bar-focus.has-focus && root.focused-index == index;
                    accessible-item-index: index;
                    activated => { root.activate(index); }
                }
            }
        }

        Rectangle {
            background: BasicTheme.background;
            border-width: 1px;
            border-color: BasicTheme.border;
            for tab[index] in tabs: tab {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                visible: root.current-index == index;
                accessible-role: tab-panel;
                accessible-label: tab.title;
                accessible-item-index: index;
            }
        }
    }
}

