import { CheckBoxStyle, CheckBoxMetrics } from "check_box_style.slint";
import { BasicTheme } from "theme.slint";

export global CheckBoxStyles {
    in-out property <CheckBoxStyle> standard: {
        unchecked: {
            rest: {
                indicator-color: BasicTheme.background,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.border,
            },
            hover: {
                indicator-color: BasicTheme.hover-background,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.border,
            },
            pressed: {
                indicator-color: BasicTheme.pressed-background,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.border,
            },
            disabled: {
                indicator-color: BasicTheme.disabled-background,
                checkmark-color: BasicTheme.disabled-foreground,
                foreground: BasicTheme.disabled-foreground,
                indicator-border-color: BasicTheme.disabled-foreground,
            },
        },
        checked: {
            rest: {
                indicator-color: BasicTheme.accent,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.accent,
            },
            hover: {
                indicator-color: BasicTheme.accent-hover,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.accent-hover,
            },
            pressed: {
                indicator-color: BasicTheme.accent-pressed,
                checkmark-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                indicator-border-color: BasicTheme.accent-pressed,
            },
            disabled: {
                indicator-color: BasicTheme.disabled-background,
                checkmark-color: BasicTheme.disabled-foreground,
                foreground: BasicTheme.disabled-foreground,
                indicator-border-color: BasicTheme.disabled-foreground,
            },
        },
        focus-color: BasicTheme.focus,
    };
}

export global CheckBoxSizes {
    in-out property <CheckBoxMetrics> small: {
        min-height: 24px,
        indicator-size: 16px,
        checkmark-padding: 2px,
        checkmark-width: 1.5px,
        padding-horizontal: 4px,
        padding-vertical: 4px,
        font-size: 12px,
        spacing: 4px,
    };
    in-out property <CheckBoxMetrics> medium: {
        min-height: 32px,
        indicator-size: 20px,
        checkmark-padding: 3px,
        checkmark-width: 2px,
        padding-horizontal: 6px,
        padding-vertical: 6px,
        font-size: 14px,
        spacing: 6px,
    };
    in-out property <CheckBoxMetrics> large: {
        min-height: 40px,
        indicator-size: 24px,
        checkmark-padding: 4px,
        checkmark-width: 2.5px,
        padding-horizontal: 8px,
        padding-vertical: 8px,
        font-size: 16px,
        spacing: 8px,
    };
}
