import {
    ComboBoxBase,
    ComboBoxPopupBase,
    ComboBoxPopupSurface,
    ButtonBase,
} from "../headless.slint";
import {
    ComboBoxStyle,
    ComboBoxStateStyle,
    ComboBoxPopupStyle,
    ComboBoxItemStyle,
    ComboBoxMetrics,
} from "combo_box_style.slint";
import { ComboBoxStyles, ComboBoxSizes } from "combo_box_styles.slint";
import { FocusOutline } from "focus_outline.slint";

component ComboBoxRowMetrics inherits Text {
    in property <ComboBoxMetrics> size;
    out property <length> row-height: max(root.size.item-height,
        max(self.font-metrics.ascent - self.font-metrics.descent,
            selected.font-metrics.ascent - selected.font-metrics.descent)
        + 2 * root.size.padding-vertical);
    width: 0px;
    height: 0px;
    visible: false;
    accessible-role: none;
    selected := Text {
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.size.selected-item-font-weight;
        font-italic: root.font-italic;
        accessible-role: none;
    }
}

export component ComboBoxPopup {
    implement ComboBoxPopupSurface <=> popup;
    out property <int> count: root.model.length;
    in property <length> popup-offset: root.size.popup-offset;
    in property <ComboBoxPopupStyle> style: ComboBoxStyles.standard.popup;
    in property <ComboBoxMetrics> size: ComboBoxSizes.medium;
    in property <string> font-family;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;
    in property <bool> font-italic;
    width: 0px;
    height: 0px;

    row-metrics := ComboBoxRowMetrics {
        size: root.size;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-italic: root.font-italic;
    }

    popup := ComboBoxPopupBase {
        popup-offset: root.popup-offset;
        item-height: row-metrics.row-height;
        popup-padding: root.size.popup-padding;
        Rectangle {
            background: root.style.background-color;
            border-color: root.style.border-color;
            border-width: root.size.popup-border-width;
            border-radius: root.size.popup-border-radius;
        }

        items := Flickable {
            x: root.popup-padding;
            y: root.popup-padding;
            width: root.popup-width - 2 * root.popup-padding;
            height: root.popup-height - 2 * root.popup-padding;
            content-width: self.width;
            content-height: root.count * root.item-height;
            content-y: -max(0, clamp(root.current-index, 0, root.count - 1) - max(1, root.maximum-visible-items) + 1) * root.item-height;
            private property <int> highlight-index: root.highlighted-index;
            private property <bool> opened: root.opened;

            function ensure-highlight-visible() {
                if self.highlight-index < 0 || self.highlight-index >= root.count || self.height <= 0px { return; }
                let maximum-offset = max(0px, self.content-height - self.height);
                let offset = clamp(-self.content-y, 0px, maximum-offset);
                let top = self.highlight-index * root.item-height;
                if top < offset { self.content-y = -min(top, maximum-offset); }
                else if top + root.item-height > offset + self.height {
                    self.content-y = -clamp(top + root.item-height - self.height, 0px, maximum-offset);
                } else {
                    self.content-y = -offset;
                }
            }
            changed highlight-index => { self.ensure-highlight-visible(); }
            changed height => { self.ensure-highlight-visible(); }
            changed content-height => { self.ensure-highlight-visible(); }
            changed opened => { if self.opened { self.ensure-highlight-visible(); } }

            for value[index] in root.model: item := ButtonBase {
                y: index * root.item-height;
                width: items.width;
                height: root.item-height;
                enabled: root.enabled;
                private property <ComboBoxItemStyle> current-style: root.style.rest;
                private property <int> item-font-weight: root.font-weight;
                states [
                    disabled when !root.enabled: {
                        current-style: root.style.disabled;
                    }
                    highlighted when index == root.highlighted-index: {
                        current-style: root.style.highlighted;
                    }
                    selected when index == root.current-index: {
                        current-style: root.style.selected;
                        item-font-weight: root.size.selected-item-font-weight;
                    }
                ]
                text: value;
                accessible-role: list-item;
                accessible-checked: index == root.current-index;
                clicked => { root.selected(index); }
                changed hovered => { if self.hovered { root.highlight(index); } }
                background << Rectangle {
                    background: item.current-style.background-color;
                    border-radius: root.size.popup-border-radius;
                }
                content << HorizontalLayout {
                    padding-left: root.size.item-padding-inline;
                    padding-right: root.size.item-padding-inline;
                    Text {
                        text: value;
                        color: item.current-style.foreground-color;
                        font-size: root.font-size;
                        font-weight: item.item-font-weight;
                        font-family: root.font-family;
                        font-italic: root.font-italic;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
        @children
    }
}

export component ComboBox inherits ComboBoxBase {
    in property <string> placeholder-text;
    in property <string> display-text: root.current-index >= 0 && root.current-index < root.count
        ? root.current-value : root.placeholder-text;
    in property <ComboBoxStyle> style: ComboBoxStyles.standard;
    in property <ComboBoxMetrics> size: ComboBoxSizes.medium;
    private property <ComboBoxStateStyle> state-style: root.style.rest;
    in property <brush> background-color: root.state-style.background-color;
    in property <brush> foreground-color: root.state-style.foreground-color;
    in property <length> border-width: root.size.border-width;
    in property <length> border-radius: root.size.border-radius;
    horizontal-stretch: 1;
    min-width: root.size.min-width;
    min-height: root.size.min-height;
    preferred-width: root.size.preferred-width;
    horizontal-padding: root.size.padding-horizontal;
    vertical-padding: root.size.padding-vertical;
    spacing: root.size.spacing;
    item-height: row-metrics.row-height;
    popup-padding: root.size.popup-padding;
    in property <string> font-family;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;
    in property <bool> font-italic;

    states [
        disabled when !root.enabled: {
            state-style: root.style.disabled;
        }
        pressed when root.pressed || root.expanded: {
            state-style: root.style.pressed;
        }
        hover when root.hovered: {
            state-style: root.style.hover;
        }
    ]
    background << surface := Rectangle {
        background: root.enabled ? root.background-color : root.state-style.background-color;
        border-color: root.state-style.border-color;
        border-width: root.border-width;
        border-radius: root.border-radius;
        row-metrics := ComboBoxRowMetrics {
            size: root.size;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-italic: root.font-italic;
        }

        focus-outline := FocusOutline {
            active: root.enabled && (root.has-focus || root.expanded);
            outline-color: root.style.focus-color;
            target-width: parent.width;
            target-height: parent.height;
            line-width: root.size.focus-width;
            offset: root.size.focus-offset;
            radius: root.border-radius;
        }
    }

    content << Text {
        horizontal-stretch: 1;
        text: root.display-text;
        color: root.enabled ? root.foreground-color : root.state-style.foreground-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        font-italic: root.font-italic;
        vertical-alignment: center;
        overflow: elide;
    }

    indicator << Path {
        width: root.size.indicator-width;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 20;
        stroke: root.enabled ? root.foreground-color : root.state-style.foreground-color;
        stroke-width: root.size.indicator-stroke-width;
        MoveTo {
            x: 3;
            y: 8;
        }

        LineTo {
            x: 8;
            y: 13;
        }

        LineTo {
            x: 13;
            y: 8;
        }
    }

    popup << ComboBoxPopup {
        style: root.style.popup;
        size: root.size;
        font-size: root.font-size;
        font-weight: root.font-weight;
        font-family: root.font-family;
        font-italic: root.font-italic;
    }
}
