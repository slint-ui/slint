import { SliderBase, LinearSliderSurface } from "../headless.slint";
import {
    SliderStyle,
    SliderStateStyle,
    SliderSizeMetrics,
    SliderSizes,
} from "slider_style.slint";
import { SliderStyles } from "slider_styles.slint";
import { FocusOutline } from "focus_outline.slint";

export component Slider inherits SliderBase {
    in property <SliderStyle> style: SliderStyles.standard;
    in property <SliderSizeMetrics> size: SliderSizes.medium;
    private property <SliderStateStyle> state-style: root.style.rest;
    in property <brush> track-color: root.state-style.track-color;
    in property <brush> fill-color: root.state-style.fill-color;
    in property <brush> handle-color: root.state-style.handle-color;
    private property <length> effective-handle-radius: root.size.handle-radius < 0px ? min(root.size.handle-width, root.size.handle-height) / 2 : root.size.handle-radius;
    private property <length> effective-track-radius: root.size.track-radius < 0px ? root.size.track-thickness / 2 : root.size.track-radius;
    preferred-width: root.orientation == Orientation.vertical ? root.size.min-thickness : root.size.preferred-length;
    preferred-height: root.orientation == Orientation.vertical ? root.size.preferred-length : root.size.min-thickness;
    min-width: root.orientation == Orientation.vertical ? root.size.min-thickness : root.size.handle-width;
    min-height: root.orientation == Orientation.vertical ? root.size.handle-height : root.size.min-thickness;

    states [
        disabled when !root.enabled: {
            state-style: root.style.disabled;
        }
        pressed when root.pressed: {
            state-style: root.style.pressed;
        }
        hover when root.hovered: {
            state-style: root.style.hover;
        }
    ]

    surface << LinearSliderSurface {
        handle-width: root.size.handle-width;
        handle-height: root.size.handle-height;
        track-thickness: root.size.track-thickness;
        track << Rectangle {
            background: root.enabled ? root.track-color : root.state-style.track-color;
            border-radius: root.effective-track-radius;
            Rectangle {
                x: root.orientation == Orientation.horizontal && root.inverted
                    ? parent.width * root.visual-position : 0px;
                y: root.orientation == Orientation.vertical && !root.inverted
                    ? parent.height * root.visual-position : 0px;
                width: root.orientation == Orientation.horizontal ? parent.width * root.position : parent.width;
                height: root.orientation == Orientation.vertical ? parent.height * root.position : parent.height;
                background: root.enabled ? root.fill-color : root.state-style.fill-color;
                border-radius: root.effective-track-radius;
            }
        }

        handle << Rectangle {
            background: root.enabled ? root.handle-color : root.state-style.handle-color;
            border-color: root.state-style.handle-border-color;
            border-width: root.size.handle-border-width;
            border-radius: root.effective-handle-radius;

            focus-outline := FocusOutline {
                active: root.enabled && root.has-focus;
                outline-color: root.style.focus-color;
                target-width: parent.width;
                target-height: parent.height;
                line-width: root.size.focus-width;
                offset: root.size.focus-offset;
                radius: root.effective-handle-radius;
            }
        }
    }
}
