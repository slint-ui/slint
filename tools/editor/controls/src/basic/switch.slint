import { SwitchBase } from "../headless.slint";
import { FocusOutline } from "focus_outline.slint";
import { BasicTheme } from "theme.slint";

export struct SwitchStateStyle {
    track-color: brush,
    thumb-color: brush,
    foreground-color: brush,
    track-border-color: brush,
}

export struct SwitchStateStyles {
    rest: SwitchStateStyle,
    hover: SwitchStateStyle,
    pressed: SwitchStateStyle,
    disabled: SwitchStateStyle,
}

export struct SwitchStyle {
    unchecked: SwitchStateStyles,
    checked: SwitchStateStyles,
    focus-color: brush,
}

export global SwitchStyles {
    out property <SwitchStyle> standard: {
        unchecked: {
            rest: {
                track-color: BasicTheme.background,
                thumb-color: BasicTheme.foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            hover: {
                track-color: BasicTheme.hover-background,
                thumb-color: BasicTheme.foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            pressed: {
                track-color: BasicTheme.pressed-background,
                thumb-color: BasicTheme.foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            disabled: {
                track-color: BasicTheme.disabled-background,
                thumb-color: BasicTheme.disabled-foreground,
                foreground-color: BasicTheme.disabled-foreground,
                track-border-color: BasicTheme.disabled-foreground,
            },
        },
        checked: {
            rest: {
                track-color: BasicTheme.accent,
                thumb-color: BasicTheme.accent-foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.accent,
            },
            hover: {
                track-color: BasicTheme.accent-hover,
                thumb-color: BasicTheme.accent-foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.accent-hover,
            },
            pressed: {
                track-color: BasicTheme.accent-pressed,
                thumb-color: BasicTheme.accent-foreground,
                foreground-color: BasicTheme.foreground,
                track-border-color: BasicTheme.accent-pressed,
            },
            disabled: {
                track-color: BasicTheme.disabled-background,
                thumb-color: BasicTheme.disabled-foreground,
                foreground-color: BasicTheme.disabled-foreground,
                track-border-color: BasicTheme.disabled-foreground,
            },
        },
        focus-color: BasicTheme.focus,
    };
}

export component Switch inherits SwitchBase {
    in property <SwitchStyle> style: SwitchStyles.standard;

    in property <brush> checked-color: root.state-style.track-color;
    in property <brush> foreground-color: root.state-style.foreground-color;

    in property <string> font-family;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <bool> font-italic;

    in property <length> track-width: 40px;
    in property <length> track-height: 22px;
    in property <length> track-border-width: 1px;
    in property <length> track-radius: -1px;

    in property <length> thumb-size: max(0px, root.track-height - 2 * root.thumb-padding);
    in property <length> thumb-padding: 3px;
    in property <length> thumb-radius: -1px;

    in property <length> focus-width: 2px;
    in property <length> focus-offset: 2px;

    private property <SwitchStateStyles> selected-styles: root.checked ? root.style.checked : root.style.unchecked;
    private property <SwitchStateStyle> state-style: root.selected-styles.rest;
    private property <length> effective-track-radius: root.track-radius < 0px ? root.track-height / 2 : root.track-radius;
    private property <length> effective-thumb-radius: root.thumb-radius < 0px ? root.thumb-size / 2 : root.thumb-radius;

    spacing: root.text == "" ? 0px : 6px;
    horizontal-padding: 6px;
    vertical-padding: 5px;

    states [
        disabled when !root.enabled: {
            state-style: root.selected-styles.disabled;
        }
        pressed when root.pressed: {
            state-style: root.selected-styles.pressed;
        }
        hover when root.hovered: {
            state-style: root.selected-styles.hover;
        }
    ]

    content << HorizontalLayout {
        padding-left: root.left-padding;
        padding-right: root.right-padding;
        padding-top: root.top-padding;
        padding-bottom: root.bottom-padding;
        spacing: root.spacing;
        cross-axis-alignment: center;

        track := Rectangle {
            width: root.track-width;
            height: root.track-height;
            vertical-stretch: 0;
            background: root.enabled && root.checked ? root.checked-color : root.state-style.track-color;
            border-color: root.state-style.track-border-color;
            border-width: root.track-border-width;
            border-radius: root.effective-track-radius;

            thumb := Rectangle {
                width: min(root.thumb-size, max(0px, min(parent.width, parent.height) - 2 * root.thumb-padding));
                height: self.width;
                x: root.checked ? max(0px, parent.width - self.width - root.thumb-padding) : root.thumb-padding;
                y: (parent.height - self.height) / 2;
                background: root.state-style.thumb-color;
                border-radius: root.effective-thumb-radius;
            }

            focus-outline := FocusOutline {
                active: root.enabled && root.has-focus;
                outline-color: root.style.focus-color;
                target-width: parent.width;
                target-height: parent.height;
                line-width: root.focus-width;
                offset: root.focus-offset;
                radius: root.effective-track-radius;
            }
        }

        HorizontalLayout {
            if root.text != "": Text {
                text: root.text;
                color: root.enabled ? root.foreground-color : root.state-style.foreground-color;
                font-size: root.font-size;
                font-weight: root.font-weight;
                font-family: root.font-family;
                font-italic: root.font-italic;
                vertical-alignment: center;
            }
        }
        @children
    }
}
