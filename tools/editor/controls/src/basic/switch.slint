import { SwitchBase } from "../headless.slint";
import {
    SwitchStyle,
    SwitchStateStyle,
    SwitchStateStyles,
    SwitchSizeMetrics,
    SwitchSizes,
} from "switch_style.slint";
import { SwitchStyles } from "switch_styles.slint";
import { FocusOutline } from "focus_outline.slint";

export component Switch inherits SwitchBase {
    in property <SwitchStyle> style: SwitchStyles.standard;
    in property <SwitchSizeMetrics> size: SwitchSizes.medium;
    private property <SwitchStateStyles> selected-styles: root.checked ? root.style.checked : root.style.unchecked;
    private property <SwitchStateStyle> current-style: root.selected-styles.rest;
    in property <length> track-width: root.size.track-width;
    in property <length> track-height: root.size.track-height;
    in property <length> thumb-size: root.size.thumb-size;
    in property <length> thumb-padding: root.size.thumb-padding;
    in property <length> track-radius: root.track-height / 2;
    in property <length> thumb-radius: root.thumb-size / 2;
    in property <brush> track-color: root.current-style.track-color;
    in property <brush> track-border-color: root.current-style.track-border-color;
    in property <length> track-border-width: root.current-style.track-border-width;
    in property <brush> thumb-color: root.current-style.thumb-color;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;

    indicator-width: root.track-width;
    indicator-height: root.track-height;
    in property <brush> foreground: root.current-style.foreground;
    spacing: root.size.spacing;
    content-padding: root.size.padding-vertical;
    content-padding-left: root.size.padding-horizontal;
    content-padding-right: root.size.padding-horizontal;
    min-height: root.size.min-height;

    states [
        disabled when !root.enabled: {
            current-style: root.selected-styles.disabled;
        }
        pressed when root.pressed: {
            current-style: root.selected-styles.pressed;
        }
        hover when root.hovered: {
            current-style: root.selected-styles.hover;
        }
    ]

    indicator << Rectangle {
        background: root.track-color;
        border-color: root.track-border-color;
        border-width: root.track-border-width;
        border-radius: root.track-radius;

        Rectangle {
            width: min(root.thumb-size, max(0px, min(parent.width, parent.height) - 2 * root.thumb-padding));
            height: self.width;
            x: root.checked ? max(0px, parent.width - self.width - root.thumb-padding) : root.thumb-padding;
            y: (parent.height - self.height) / 2;
            background: root.thumb-color;
            border-radius: root.thumb-radius;
        }

        focus-outline := FocusOutline {
            active: root.enabled && root.has-focus;
            outline-color: root.style.focus-color;
            target-width: parent.width;
            target-height: parent.height;
            line-width: root.style.focus-width;
            offset: root.style.focus-offset;
            radius: root.track-radius;
        }
    }

    content << Text {
        text: root.text;
        color: root.foreground;
        font-size: root.font-size;
        font-weight: root.font-weight;
        vertical-alignment: center;
    }
}
