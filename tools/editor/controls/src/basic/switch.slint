import { SwitchBase } from "../headless.slint";
import {
    SwitchStyle,
    SwitchStateStyle,
    SwitchStateStyles,
    SwitchMetrics,
} from "switch_style.slint";
import { SwitchStyles, SwitchSizes } from "switch_styles.slint";
import { FocusOutline } from "focus_outline.slint";

export component Switch inherits SwitchBase {
    in property <SwitchStyle> style: SwitchStyles.standard;
    in property <SwitchMetrics> size: SwitchSizes.medium;
    private property <SwitchStateStyles> selected-styles: root.checked ? root.style.checked : root.style.unchecked;
    private property <SwitchStateStyle> state-style: root.selected-styles.rest;
    in property <brush> checked-color: root.state-style.track-color;
    in property <brush> foreground-color: root.state-style.foreground-color;
    in property <string> font-family;
    in property <length> font-size: root.size.font-size;
    in property <int> font-weight: 400;
    in property <bool> font-italic;

    private property <length> effective-track-radius: root.size.track-radius < 0px ? root.size.track-height / 2 : root.size.track-radius;
    private property <length> effective-thumb-radius: root.size.thumb-radius < 0px ? root.size.thumb-size / 2 : root.size.thumb-radius;

    spacing: root.text == "" ? 0px : root.size.spacing;
    horizontal-padding: root.size.padding-horizontal;
    vertical-padding: root.size.padding-vertical;
    min-height: root.size.min-height;

    states [
        disabled when !root.enabled: {
            state-style: root.selected-styles.disabled;
        }
        pressed when root.pressed: {
            state-style: root.selected-styles.pressed;
        }
        hover when root.hovered: {
            state-style: root.selected-styles.hover;
        }
    ]

    indicator << Rectangle {
        width: root.size.track-width;
        height: root.size.track-height;
        vertical-stretch: 0;
        background: root.enabled && root.checked ? root.checked-color : root.state-style.track-color;
        border-color: root.state-style.track-border-color;
        border-width: root.size.track-border-width;
        border-radius: root.effective-track-radius;

        Rectangle {
            width: min(root.size.thumb-size, max(0px, min(parent.width, parent.height) - 2 * root.size.thumb-padding));
            height: self.width;
            x: root.checked ? max(0px, parent.width - self.width - root.size.thumb-padding) : root.size.thumb-padding;
            y: (parent.height - self.height) / 2;
            background: root.state-style.thumb-color;
            border-radius: root.effective-thumb-radius;
        }

        focus-outline := FocusOutline {
            active: root.enabled && root.has-focus;
            outline-color: root.style.focus-color;
            target-width: parent.width;
            target-height: parent.height;
            line-width: root.size.focus-width;
            offset: root.size.focus-offset;
            radius: root.effective-track-radius;
        }
    }

    content << HorizontalLayout {
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? root.foreground-color : root.state-style.foreground-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-family: root.font-family;
            font-italic: root.font-italic;
            vertical-alignment: center;
        }
    }
}
