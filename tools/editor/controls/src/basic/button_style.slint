export struct ButtonStateStyle {
    background-color: brush,
    foreground: brush,
    border-color: brush,
}

export struct ButtonStyle {
    rest: ButtonStateStyle,
    hover: ButtonStateStyle,
    pressed: ButtonStateStyle,
    disabled: ButtonStateStyle,
    focus-color: brush,
}

export struct ButtonMetrics {
    border-width: length = 1px,
    border-radius: length = 4px,
    focus-width: length = 2px,
    focus-offset: length = 2px,
    min-height: length,
    min-width: length,
    padding-horizontal: length,
    padding-vertical: length,
    font-size: length,
    icon-size: length,
    spacing: length,
}
