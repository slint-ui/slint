export global BasicTheme {
    in-out property <brush> foreground: #24292f;
    in-out property <brush> background: #f6f8fa;
    in-out property <brush> hover-background: #eef1f4;
    in-out property <brush> pressed-background: #e5eaf0;
    in-out property <brush> border: #d0d7de;
    in-out property <brush> accent: #1c873c;
    in-out property <brush> accent-hover: #1b7f39;
    in-out property <brush> accent-pressed: #197737;
    in-out property <brush> accent-foreground: white;
    in-out property <brush> danger: #b91c1c;
    in-out property <brush> danger-hover: #ad092a;
    in-out property <brush> danger-pressed: #960722;
    in-out property <brush> danger-foreground: white;
    in-out property <brush> danger-disabled-foreground: #f07988;
    in-out property <brush> invisible-hover-background: #e0e2e4;
    in-out property <brush> invisible-pressed-background: #d9dcdf;
    in-out property <brush> disabled-background: #f6f8fa;
    in-out property <brush> disabled-foreground: #8c99aa;
    in-out property <brush> focus: #006cff;
}
