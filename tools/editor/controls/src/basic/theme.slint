export global BasicTheme {
    in-out property <brush> foreground: #1f2937;
    in-out property <brush> background: #f3f4f6;
    in-out property <brush> hover-background: #e5e7eb;
    in-out property <brush> pressed-background: #d1d5db;
    in-out property <brush> border: #9ca3af;
    in-out property <brush> accent: #2563eb;
    in-out property <brush> accent-hover: #1d4ed8;
    in-out property <brush> accent-pressed: #1e40af;
    in-out property <brush> accent-foreground: white;
    in-out property <brush> disabled-background: #e5e7eb;
    in-out property <brush> disabled-foreground: #6b7280;
    in-out property <brush> focus: #2563eb;
}
