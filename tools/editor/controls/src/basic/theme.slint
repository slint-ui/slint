export struct BasicPalette {
    foreground: brush,
    background: brush,
    hover-background: brush,
    pressed-background: brush,
    border: brush,
    accent: brush,
    accent-hover: brush,
    accent-pressed: brush,
    accent-foreground: brush,
    danger: brush,
    danger-hover: brush,
    danger-pressed: brush,
    danger-foreground: brush,
    danger-disabled-foreground: brush,
    invisible-hover-background: brush,
    invisible-pressed-background: brush,
    disabled-background: brush,
    disabled-foreground: brush,
    focus: brush,
}

export global BasicPalettes {
    out property <BasicPalette> light: {
        foreground: #24292f,
        background: #f6f8fa,
        hover-background: #eef1f4,
        pressed-background: #e5eaf0,
        border: #d0d7de,
        accent: #1c873c,
        accent-hover: #1b7f39,
        accent-pressed: #197737,
        accent-foreground: #ffffff,
        danger: #b91c1c,
        danger-hover: #ad092a,
        danger-pressed: #960722,
        danger-foreground: #ffffff,
        danger-disabled-foreground: #f07988,
        invisible-hover-background: #e0e2e4,
        invisible-pressed-background: #d9dcdf,
        disabled-background: #f6f8fa,
        disabled-foreground: #8c99aa,
        focus: #006cff,
    };
    out property <BasicPalette> dark: {
        foreground: #e6edf3,
        background: #161b22,
        hover-background: #21262d,
        pressed-background: #30363d,
        border: #484f58,
        accent: #3fb950,
        accent-hover: #56d364,
        accent-pressed: #2ea043,
        accent-foreground: #0d1117,
        danger: #ff7b72,
        danger-hover: #b62324,
        danger-pressed: #8e1519,
        danger-foreground: #ffffff,
        danger-disabled-foreground: #b76b66,
        invisible-hover-background: #21262d,
        invisible-pressed-background: #30363d,
        disabled-background: #21262d,
        disabled-foreground: #8b949e,
        focus: #58a6ff,
    };
}

export global BasicTheme {
    out property <BasicPalette> default-palette: BasicPalettes.light;
    in property <BasicPalette> palette: root.default-palette;

    out property <brush> foreground: root.palette.foreground;
    out property <brush> background: root.palette.background;
    out property <brush> hover-background: root.palette.hover-background;
    out property <brush> pressed-background: root.palette.pressed-background;
    out property <brush> border: root.palette.border;
    out property <brush> accent: root.palette.accent;
    out property <brush> accent-hover: root.palette.accent-hover;
    out property <brush> accent-pressed: root.palette.accent-pressed;
    out property <brush> accent-foreground: root.palette.accent-foreground;
    out property <brush> danger: root.palette.danger;
    out property <brush> danger-hover: root.palette.danger-hover;
    out property <brush> danger-pressed: root.palette.danger-pressed;
    out property <brush> danger-foreground: root.palette.danger-foreground;
    out property <brush> danger-disabled-foreground: root.palette.danger-disabled-foreground;
    out property <brush> invisible-hover-background: root.palette.invisible-hover-background;
    out property <brush> invisible-pressed-background: root.palette.invisible-pressed-background;
    out property <brush> disabled-background: root.palette.disabled-background;
    out property <brush> disabled-foreground: root.palette.disabled-foreground;
    out property <brush> focus: root.palette.focus;
}

export component BasicThemeProvider {
    in property <BasicPalette> palette <=> BasicTheme.palette;
}
