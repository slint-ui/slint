export struct CheckBoxStateStyle {
    indicator-color: brush,
    checkmark-color: brush,
    foreground-color: brush,
    indicator-border-color: brush,
}

export struct CheckBoxStateStyles {
    rest: CheckBoxStateStyle,
    hover: CheckBoxStateStyle,
    pressed: CheckBoxStateStyle,
    disabled: CheckBoxStateStyle,
}

export struct CheckBoxStyle {
    unchecked: CheckBoxStateStyles,
    checked: CheckBoxStateStyles,
    focus-color: brush,
}
