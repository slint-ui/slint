import { SwitchStyle, SwitchMetrics } from "switch_style.slint";
import { BasicTheme } from "theme.slint";

export global SwitchStyles {
    out property <SwitchStyle> standard: {
        unchecked: {
            rest: {
                track-color: BasicTheme.background,
                thumb-color: BasicTheme.foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            hover: {
                track-color: BasicTheme.hover-background,
                thumb-color: BasicTheme.foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            pressed: {
                track-color: BasicTheme.pressed-background,
                thumb-color: BasicTheme.foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.border,
            },
            disabled: {
                track-color: BasicTheme.disabled-background,
                thumb-color: BasicTheme.disabled-foreground,
                foreground: BasicTheme.disabled-foreground,
                track-border-color: BasicTheme.disabled-foreground,
            },
        },
        checked: {
            rest: {
                track-color: BasicTheme.accent,
                thumb-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.accent,
            },
            hover: {
                track-color: BasicTheme.accent-hover,
                thumb-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.accent-hover,
            },
            pressed: {
                track-color: BasicTheme.accent-pressed,
                thumb-color: BasicTheme.accent-foreground,
                foreground: BasicTheme.foreground,
                track-border-color: BasicTheme.accent-pressed,
            },
            disabled: {
                track-color: BasicTheme.disabled-background,
                thumb-color: BasicTheme.disabled-foreground,
                foreground: BasicTheme.disabled-foreground,
                track-border-color: BasicTheme.disabled-foreground,
            },
        },
        focus-color: BasicTheme.focus,
    };
}

export global SwitchSizes {
    out property <SwitchMetrics> small: {
        min-height: 24px,
        track-width: 32px,
        track-height: 18px,
        thumb-size: 12px,
        thumb-padding: 3px,
        padding-horizontal: 4px,
        padding-vertical: 3px,
        font-size: 12px,
        spacing: 4px,
    };
    out property <SwitchMetrics> medium: {
        min-height: 32px,
        track-width: 40px,
        track-height: 22px,
        thumb-size: 16px,
        thumb-padding: 3px,
        padding-horizontal: 6px,
        padding-vertical: 5px,
        font-size: 14px,
        spacing: 6px,
    };
    out property <SwitchMetrics> large: {
        min-height: 40px,
        track-width: 48px,
        track-height: 26px,
        thumb-size: 20px,
        thumb-padding: 3px,
        padding-horizontal: 8px,
        padding-vertical: 7px,
        font-size: 16px,
        spacing: 8px,
    };
}
