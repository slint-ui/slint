import { ButtonStyle, ButtonMetrics } from "button_style.slint";
import { BasicTheme } from "theme.slint";

export global ButtonStyles {
    out property <ButtonStyle> secondary: {
        rest: {
            background-color: BasicTheme.background,
            foreground: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        hover: {
            background-color: BasicTheme.hover-background,
            foreground: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        pressed: {
            background-color: BasicTheme.pressed-background,
            foreground: BasicTheme.foreground,
            border-color: BasicTheme.border,
        },
        disabled: {
            background-color: BasicTheme.disabled-background,
            foreground: BasicTheme.disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };

    out property <ButtonStyle> primary: {
        rest: {
            background-color: BasicTheme.accent,
            foreground: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        hover: {
            background-color: BasicTheme.accent-hover,
            foreground: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.accent-pressed,
            foreground: BasicTheme.accent-foreground,
            border-color: transparent,
        },
        disabled: ButtonStyles.secondary.disabled,
        focus-color: BasicTheme.focus,
    };

    out property <ButtonStyle> danger: {
        rest: {
            background-color: BasicTheme.background,
            foreground: BasicTheme.danger,
            border-color: BasicTheme.border,
        },
        hover: {
            background-color: BasicTheme.danger-hover,
            foreground: BasicTheme.danger-foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.danger-pressed,
            foreground: BasicTheme.danger-foreground,
            border-color: transparent,
        },
        disabled: {
            background-color: BasicTheme.disabled-background,
            foreground: BasicTheme.danger-disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };

    out property <ButtonStyle> invisible: {
        rest: {
            background-color: transparent,
            foreground: BasicTheme.foreground,
            border-color: transparent,
        },
        hover: {
            background-color: BasicTheme.invisible-hover-background,
            foreground: BasicTheme.foreground,
            border-color: transparent,
        },
        pressed: {
            background-color: BasicTheme.invisible-pressed-background,
            foreground: BasicTheme.foreground,
            border-color: transparent,
        },
        disabled: {
            background-color: transparent,
            foreground: BasicTheme.disabled-foreground,
            border-color: transparent,
        },
        focus-color: BasicTheme.focus,
    };
}

export global ButtonSizes {
    out property <ButtonMetrics> small: {
        min-height: 24px,
        min-width: 48px,
        padding-horizontal: 8px,
        padding-vertical: 4px,
        font-size: 12px,
        icon-size: 16px,
        spacing: 4px,
    };
    out property <ButtonMetrics> medium: {
        min-height: 32px,
        min-width: 64px,
        padding-horizontal: 12px,
        padding-vertical: 6px,
        font-size: 14px,
        icon-size: 20px,
        spacing: 6px,
    };
    out property <ButtonMetrics> large: {
        min-height: 40px,
        min-width: 80px,
        padding-horizontal: 16px,
        padding-vertical: 8px,
        font-size: 16px,
        icon-size: 24px,
        spacing: 8px,
    };
}
