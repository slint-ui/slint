export component FocusOutline inherits Rectangle {
    in property <bool> active;
    in property <brush> outline-color;
    in property <length> line-width: 2px;
    in property <length> offset: 2px;
    in property <length> radius;
    in property <length> target-width;
    in property <length> target-height;
    private property <length> outset: root.offset + root.line-width;
    x: -root.outset;
    y: -root.outset;
    width: root.target-width + 2 * root.outset;
    height: root.target-height + 2 * root.outset;
    visible: root.active && root.line-width > 0px;
    background: transparent;
    border-color: root.outline-color;
    border-width: root.line-width;
    border-radius: root.radius + root.outset;
}
