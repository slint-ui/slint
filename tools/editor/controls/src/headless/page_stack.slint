export component PageStack inherits Rectangle {
    in property <int> current-index: 0;
    in property <length> content-padding: 0px;
    out property <int> item-count: pages.length;
    default slot <[*]> pages;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    GridLayout {
        padding: root.content-padding;
        for page[index] in pages: page {
            row: 0;
            col: 0;
            horizontal-stretch: 1;
            vertical-stretch: 1;
            visible: root.current-index == index;
        }
    }
}
