import { ButtonInterface } from "std-widget-interfaces.slint";

export component ButtonBase {
    implement ButtonInterface <=> self;

    in property <bool> enabled: true;
    in property <bool> checkable;
    in-out property <bool> checked;
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> colorize-icon: true;
    in property <bool> primary;
    in property <length> content-padding;
    in property <length> content-padding-left: root.content-padding;
    in property <length> content-padding-right: root.content-padding;
    in property <length> content-padding-top: root.content-padding;
    in property <length> content-padding-bottom: root.content-padding;
    out property <bool> has-focus: keys.has-focus;
    out property <bool> hovered: root.enabled && pointer.has-hover && root.pointer-inside;
    out property <bool> pressed: root.enabled && (
        (pointer.pressed && root.pointer-inside && !root.pointer-canceled)
        || (root.has-focus && root.pressed-key != ""));
    callback clicked();
    callback toggled(checked: bool);

    slot background;
    slot content;

    private property <string> pressed-key;
    private property <bool> pointer-canceled;
    private property <bool> pointer-inside: pointer.mouse-x >= 0px && pointer.mouse-x < pointer.width
        && pointer.mouse-y >= 0px && pointer.mouse-y < pointer.height;

    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { root.activate(); }

    public function activate() {
        if !root.enabled { return; }
        if root.checkable {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        root.clicked();
    }

    changed enabled => {
        if !root.enabled {
            root.pressed-key = "";
            root.pointer-canceled = true;
        }
    }

    background { }

    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.pointer-canceled = false;
            } else if event.kind == PointerEventKind.cancel {
                root.pointer-canceled = true;
            }
        }
        clicked => {
            if !root.pointer-canceled { root.activate(); }
        }
    }

    HorizontalLayout {
        padding-left: root.content-padding-left;
        padding-right: root.content-padding-right;
        padding-top: root.content-padding-top;
        padding-bottom: root.content-padding-bottom;
        content { }
    }

    keys := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        focus-changed-event => {
            if !self.has-focus { root.pressed-key = ""; }
        }
        key-pressed(event) => {
            if event.text == Key.Escape && root.pressed-key != "" {
                root.pressed-key = "";
                return accept;
            }
            if root.enabled && !event.modifiers.control && !event.modifiers.alt
                && (event.text == Key.Space || event.text == Key.Return) {
                if root.pressed-key == "" { root.pressed-key = event.text; }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if root.pressed-key != "" && event.text == root.pressed-key {
                root.pressed-key = "";
                if root.has-focus { root.activate(); }
                return accept;
            }
            return reject;
        }
    }
}
