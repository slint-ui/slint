import { ButtonInterface } from "../../../../../internal/compiler/widgets/common/std-widget-interfaces.slint";
import { PressInteraction } from "internal/press_interaction.slint";

export component ButtonBase {
    implement ButtonInterface <=> self;

    in property <bool> enabled: true;
    in property <string> text;
    in property <bool> checkable;
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <bool> primary;
    in property <bool> colorize-icon;

    in-out property <bool> checked;

    out property <bool> has-focus: interaction.has-focus;
    out property <bool> hovered: interaction.hovered;
    out property <bool> pressed: interaction.pressed;

    slot background;
    slot content;

    callback clicked();

    public function activate() {
        if !root.enabled { return; }
        if root.checkable { root.checked = !root.checked; }
        root.clicked();
    }

    forward-focus: interaction;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: root.checkable;
    accessible-checked: root.checked;
    accessible-action-default => { root.activate(); }

    background { }

    interaction := PressInteraction {
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        activated => { root.activate(); }
    }

    content { }
    @children
}
