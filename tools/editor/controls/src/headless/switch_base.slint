import { SwitchInterface } from "../../../../../internal/compiler/widgets/common/std-widget-interfaces.slint";
import { PressInteraction } from "internal/press_interaction.slint";

export component SwitchBase {
    implement SwitchInterface <=> self;

    in property <bool> enabled: true;
    in property <string> text;
    in property <bool> focus-on-click;
    in property <bool> focus-on-tab-navigation: true;

    in property <length> spacing;
    in property <length> horizontal-padding;
    in property <length> vertical-padding;
    in property <length> left-padding: root.horizontal-padding;
    in property <length> right-padding: root.horizontal-padding;
    in property <length> top-padding: root.vertical-padding;
    in property <length> bottom-padding: root.vertical-padding;

    in-out property <bool> checked;

    out property <bool> has-focus: interaction.has-focus;
    out property <bool> focus-visible: interaction.focus-visible;
    out property <bool> hovered: interaction.hovered;
    out property <bool> pressed: interaction.pressed;

    slot content;

    callback toggled();

    public function activate() {
        if !root.enabled { return; }
        root.checked = !root.checked;
        root.toggled();
    }

    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: interaction;
    accessible-role: switch;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.activate(); }

    interaction := PressInteraction {
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        focus-on-click: root.focus-on-click;
        focus-on-tab-navigation: root.focus-on-tab-navigation;
        activated => { root.activate(); }
    }

    content { }
    @children
}
