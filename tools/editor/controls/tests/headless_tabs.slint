import { TabHeaderBase, TabBarBase, TabPanelBase } from "../src/headless.slint";

export component TestCase inherits Window {
    width: 440px;
    height: 220px;
    out property <int> current-index: bar.current-index;
    out property <string> text: field.text;
    out property <bool> field-focused: field.has-focus;
    out property <int> panel-inits;
    out property <bool> test: first.selected && !second.selected && root.panel-inits == 2;
    public function edit() { field.text = "Retained page state"; }

    bar := TabBarBase {
        x: 20px;
        y: 20px;
        width: 400px;
        height: 40px;
        tabs: [
            { index: 0, title: "First page" },
            { index: 1, title: "Second page" },
        ];
        HorizontalLayout {
            for tab[index] in bar.tabs: heading := TabHeaderBase {
                title: tab.title;
                selected: bar.current-index == index;
                focused: bar.focused-index == index;
                accessible-item-index: index;
                height: 40px;
                activated => {
                    bar.current-index = index;
                    bar.focus-tab(index);
                }
                content << Text { text: heading.title; }
            }
        }
    }
    first := TabPanelBase {
        x: 20px;
        y: 80px;
        width: 400px;
        height: 100px;
        title: "First page";
        tab-index: 0;
        current-index: bar.current-index;
        init => { root.panel-inits += 1; }
        field := TextInput { text: "Initial state"; }
    }
    second := TabPanelBase {
        x: 20px;
        y: 80px;
        width: 400px;
        height: 100px;
        title: "Second page";
        tab-index: 1;
        current-index: bar.current-index;
        init => { root.panel-inits += 1; }
        Text { text: "Second page content"; }
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton};
use slint_testing::{AccessibleRole, ElementQuery};
let instance = TestCase::new().unwrap();
instance.show().unwrap();
assert!(instance.get_test());
let headers = ElementQuery::from_root(&instance).match_accessible_role(AccessibleRole::Tab).find_all();
assert_eq!(headers.len(), 2);
instance.invoke_edit();
headers[1].mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 1);
headers[0].invoke_accessible_default_action();
assert_eq!(instance.get_current_index(), 0);
assert_eq!(instance.get_text(), "Retained page state");
assert!(instance.get_test());
slint_testing::send_keyboard_char(&instance, Key::Tab.into(), true);
slint_testing::send_keyboard_char(&instance, Key::Tab.into(), false);
assert!(instance.get_field_focused());
```
*/
