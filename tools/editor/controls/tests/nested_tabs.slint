import { TabWidget } from "std-widgets.slint";
import { TabHeader, TabBar, BasicTheme, BasicThemeProvider, BasicPalettes } from "../src/basic.slint";

export component TestCase inherits Window {
    width: 500px;
    height: 260px;
    in-out property <bool> dark;
    out property <int> current-index: tabs.current-index;
    out property <string> text: field.text;
    out property <int> page-inits;
    out property <bool> test: root.page-inits == 3;
    public function edit() { field.text = "Retained Basic page"; }
    BasicThemeProvider { palette: root.dark ? BasicPalettes.dark : BasicPalettes.light; }

    tabs := TabWidget {
        orientation: horizontal;
        bar << TabBar { }
        Tab {
            title: "First";
            header << TabHeader {
                background << Rectangle { background: #123456; }
                content << Rectangle {
                    preferred-width: 80px;
                    preferred-height: 30px;
                    Text { text: "Custom"; }
                }
            }
            field := TextInput {
                text: "Original";
                init => { root.page-inits += 1; }
            }
        }
        Tab {
            title: "Second";
            header << TabHeader { }
            Rectangle { init => { root.page-inits += 1; } }
        }
        Tab {
            title: "Third";
            header << TabHeader { }
            Rectangle { init => { root.page-inits += 1; } }
        }
    }
}

/*
