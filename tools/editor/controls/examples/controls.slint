import { ScrollView } from "std-widgets.slint";
import { Button, BasicTheme } from "../src/basic.slint";
import { ButtonExamples } from "buttons.slint";

export component ControlsDemo inherits Window {
    title: "Slint controls — Component gallery";
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 640px;
    background: BasicTheme.background;
    default-font-size: 14px;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: white;
            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                background: BasicTheme.border.with-alpha(0.3);
            }

            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "SLINT CONTROLS";
                    color: BasicTheme.foreground;
                    font-size: 17px;
                    font-weight: 700;
                }

                Text {
                    text: "Component gallery";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }

                Rectangle {
                    height: 24px;
                }

                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                Button {
                    text: "Button";
                    checked: true;
                    min-height: 44px;
                    background-color: BasicTheme.accent.with-alpha(0.08);
                    foreground: BasicTheme.accent;
                    border-color: BasicTheme.accent.with-alpha(0.4);
                    font-weight: 600;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: "Headless behavior\nBase style · Custom visuals";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }
            }
        }

        ScrollView {
            horizontal-scrollbar-policy: always-off;
            content-width: self.width;
            VerticalLayout {
                padding: 32px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                Text {
                    text: "Button";
                    color: BasicTheme.foreground;
                    font-size: 30px;
                    font-weight: 700;
                }

                Text {
                    text: "Shared button behavior, with a base theme or your own visuals.";
                    color: BasicTheme.disabled-foreground;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 12px;
                }

                ButtonExamples { }
            }
        }
    }
}
