import { ScrollView } from "std-widgets.slint";
import { Button, BasicTheme } from "../src/basic.slint";
import { ButtonExamples } from "buttons.slint";
import { ComboBoxExamples } from "combo_boxes.slint";
import { SliderExamples } from "sliders.slint";

export component ControlsDemo inherits Window {
    in-out property <int> current-page;
    private property <[string]> pages: ["Button", "ComboBox", "Slider"];
    title: "Slint controls — Component gallery";
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 640px;
    background: BasicTheme.background;
    default-font-size: 14px;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: white;
            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                background: BasicTheme.border.with-alpha(0.3);
            }

            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "SLINT CONTROLS";
                    color: BasicTheme.foreground;
                    font-size: 17px;
                    font-weight: 700;
                }

                Text {
                    text: "Component gallery";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }

                Rectangle {
                    height: 24px;
                }

                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                for page[index] in root.pages: Button {
                    text: page;
                    checked: root.current-page == index;
                    min-height: 44px;
                    background-color: self.checked ? BasicTheme.accent.with-alpha(0.08) : transparent;
                    foreground: self.checked ? BasicTheme.accent : BasicTheme.foreground;
                    border-color: self.checked ? BasicTheme.accent.with-alpha(0.4) : transparent;
                    font-weight: 600;
                    clicked => { root.current-page = index; }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: "Headless behavior\nBase style · Custom visuals";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }
            }
        }

        ScrollView {
            horizontal-scrollbar-policy: always-off;
            content-width: self.width;
            VerticalLayout {
                padding: 32px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                Text {
                    text: root.pages[root.current-page];
                    color: BasicTheme.foreground;
                    font-size: 30px;
                    font-weight: 700;
                }

                Text {
                    text: root.current-page == 0
                        ? "Shared button behavior, with a base theme or your own visuals."
                        : root.current-page == 1
                        ? "Shared selection behavior, with a base theme or your own field and popup."
                        : "Shared range behavior, with a base theme or your own track and handle.";
                    color: BasicTheme.disabled-foreground;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 12px;
                }

                if root.current-page == 0: ButtonExamples { }
                if root.current-page == 1: ComboBoxExamples { }
                if root.current-page == 2: SliderExamples { }
            }
        }
    }
}
