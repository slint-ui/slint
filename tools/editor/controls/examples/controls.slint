import { ScrollView } from "std-widgets.slint";
import {
    Button,
    ButtonStyles,
    Switch,
    BasicPalettes,
    BasicTheme,
    BasicThemeProvider,
} from "../src/basic.slint";
import { ButtonExamples } from "buttons.slint";
import { CheckBoxExamples } from "check_boxes.slint";
import { ComboBoxExamples } from "combo_boxes.slint";
import { SliderExamples } from "sliders.slint";
import { SwitchExamples } from "switches.slint";
import { LineEditExamples } from "line_edits.slint";

export component ControlsDemo inherits Window {
    in-out property <int> current-page;
    in-out property <bool> dark-mode;
    private property <[string]> pages: ["Button", "ComboBox", "Slider", "CheckBox", "Switch", "LineEdit"];
    title: "Slint controls — Component gallery";
    preferred-width: 1000px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 640px;
    background: BasicTheme.background;
    default-font-size: 14px;

    BasicThemeProvider {
        palette: root.dark-mode ? BasicPalettes.dark : BasicPalettes.light;
    }

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: BasicTheme.background;
            Rectangle {
                x: parent.width - self.width;
                width: 1px;
                background: BasicTheme.border.with-alpha(0.3);
            }

            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text {
                    text: "SLINT CONTROLS";
                    color: BasicTheme.foreground;
                    font-size: 17px;
                    font-weight: 700;
                }

                Text {
                    text: "Component gallery";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }

                Rectangle {
                    height: 24px;
                }

                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                for page[index] in root.pages: Button {
                    text: page;
                    min-height: 44px;
                    style: ButtonStyles.invisible;
                    background-color: root.current-page == index ? BasicTheme.accent.with-alpha(0.08) : transparent;
                    foreground-color: root.current-page == index ? BasicTheme.accent : BasicTheme.foreground;
                    font-weight: 600;
                    clicked => { root.current-page = index; }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: "Headless behavior\nBase style · Custom visuals";
                    color: BasicTheme.disabled-foreground;
                    font-size: 12px;
                }

                Switch {
                    text: "Dark mode";
                    checked <=> root.dark-mode;
                }
            }
        }

        content-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off;
            content-width: self.width;
            VerticalLayout {
                padding: 32px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: "CONTROLS";
                    color: BasicTheme.disabled-foreground;
                    font-size: 11px;
                    font-weight: 600;
                }

                Text {
                    text: root.pages[root.current-page];
                    color: BasicTheme.foreground;
                    font-size: 30px;
                    font-weight: 700;
                }

                Text {
                    text: root.current-page == 0
                        ? "Shared button behavior, with a base theme or your own visuals."
                        : root.current-page == 1
                        ? "Shared selection behavior, with a base theme or your own field and popup."
                        : root.current-page == 2
                        ? "Shared range behavior, with a base theme or your own track and handle."
                        : root.current-page == 3
                        ? "Shared toggle behavior, with a base theme or your own indicator and label."
                        : root.current-page == 4
                        ? "Shared switch behavior, with a base theme or your own track and label."
                        : "Shared text editing, with a base theme or your own field visuals.";
                    color: BasicTheme.disabled-foreground;
                    wrap: word-wrap;
                }

                Rectangle {
                    height: 12px;
                }

                if root.current-page == 0: ButtonExamples { }
                else if root.current-page == 1: ComboBoxExamples { }
                else if root.current-page == 2: SliderExamples { }
                else if root.current-page == 3: CheckBoxExamples { }
                else if root.current-page == 4: SwitchExamples { }
                else if root.current-page == 5: LineEditExamples { }
            }
        }
    }
}
