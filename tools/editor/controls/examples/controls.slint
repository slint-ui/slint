import { ScrollView } from "std-widgets.slint";
import { ButtonExamples } from "buttons.slint";
import { SliderExamples } from "sliders.slint";

export component ControlsDemo inherits Window {
    title: "Reusable controls";
    width: 720px;
    height: 860px;
    ScrollView {
        horizontal-scrollbar-policy: always-off;
        content-width: self.width;
        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text {
                text: "Buttons";
                font-size: 22px;
                font-weight: 600;
            }

            ButtonExamples { }

            Rectangle {
                height: 1px;
                background: #d1d5db;
            }

            Text {
                text: "Sliders";
                font-size: 22px;
                font-weight: 600;
            }

            SliderExamples { }
        }
    }
}
