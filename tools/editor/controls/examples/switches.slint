import {
    Switch,
    SwitchSizes,
    SwitchSizeMetrics,
    SwitchStyle,
    SwitchStyles,
    BasicTheme,
} from "../src/basic.slint";
import { SwitchBase } from "../src/headless.slint";
import { ExampleSection } from "section.slint";
import { PreviewSettings } from "preview_settings.slint";

export component SwitchExamples inherits Rectangle {
    vertical-stretch: 0;
    in property <SwitchStyle> preview-style: SwitchStyles.standard;
    in-out property <int> size-index: 1;
    in-out property <bool> preview-disabled;
    private property <SwitchSizeMetrics> preview-size: [SwitchSizes.small, SwitchSizes.medium, SwitchSizes.large][clamp(root.size-index, 0, 2)];

    in-out property <int> toggles;
    in-out property <int> custom-toggles;

    VerticalLayout {
        spacing: 20px;
        PreviewSettings {
            control-name: "Switch";
            size-index <=> root.size-index;
            disabled <=> root.preview-disabled;
        }

        ExampleSection {
            title: "Base theme";
            description: "Off, on, and disabled switches using BasicTheme.";
            HorizontalLayout {
                spacing: 12px;
                standard := Switch {
                    style: root.preview-style;
                    size: root.preview-size;
                    enabled: !root.preview-disabled;
                    text: "Notifications";
                    toggled => { root.toggles += 1; }
                }

                Switch {
                    style: root.preview-style;
                    size: root.preview-size;
                    enabled: !root.preview-disabled;
                    text: "Autosave";
                    checked: true;
                    toggled => { root.toggles += 1; }
                }

                Switch {
                    style: root.preview-style;
                    size: root.preview-size;
                    enabled: false;
                    text: "Disabled";
                }
            }

            Switch {
                style: root.preview-style;
                size: root.preview-size;
                enabled: false;
                text: "Disabled on";
                checked: true;
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Toggles: \{root.toggles}  ·  Notifications: \{standard.checked ? "on" : "off"}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        ExampleSection {
            title: "Custom switches";
            description: "Override colors and dimensions, supply headless visuals, or bind the label to the checked state.";
            VerticalLayout {
                spacing: 12px;
                Switch {
                    style: root.preview-style;
                    size: root.preview-size;
                    enabled: !root.preview-disabled;
                    text: "Color override";
                    checked: true;
                    track-color: self.checked ? #0f766e : BasicTheme.background;
                    foreground: #115e59;
                    track-width: 48px;
                    track-height: 26px;
                    thumb-size: 20px;
                    toggled => { root.custom-toggles += 1; }
                }

                bare := SwitchBase {
                    enabled: !root.preview-disabled;
                    text: "Headless switch";
                    content-padding: 6px;
                    indicator << Rectangle {
                        background: bare.checked ? #7c3aed : #f5f3ff;
                        border-color: bare.has-focus ? #5b21b6 : #a78bfa;
                        border-width: bare.has-focus ? 2px : 1px;
                        border-radius: 4px;
                        Rectangle {
                            width: 14px;
                            height: parent.height - 6px;
                            x: bare.checked ? parent.width - self.width - 3px : 3px;
                            y: 3px;
                            background: bare.checked ? white : #7c3aed;
                            border-radius: 2px;
                        }
                    }
                    content << Text {
                        text: bare.text;
                        color: #5b21b6;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    toggled => { root.custom-toggles += 1; }
                }

                custom := Switch {
                    style: root.preview-style;
                    size: root.preview-size;
                    enabled: !root.preview-disabled;
                    accessible-label: "Custom switch content";
                    text: "Cloud sync · " + (self.checked ? "On" : "Off");

                    toggled => { root.custom-toggles += 1; }
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Custom toggles: \{root.custom-toggles}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        Text {
            text: "Click the track or label to toggle. Use Tab to focus, then release Space or Enter to toggle.";
            color: BasicTheme.disabled-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
