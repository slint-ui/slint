import {
    Button,
    CheckBox,
    CheckBoxStyle,
    CheckBoxStateStyle,
    CheckBoxStyles,
    CheckBoxSizes,
    BasicTheme,
} from "../src/basic.slint";

global AppCheckBoxStyles {
    in-out property <brush> accent: #0f766e;
    in-out property <brush> accent-hover: #0d9488;
    in-out property <brush> accent-pressed: #115e59;

    public pure function with-indicator-color(base: CheckBoxStateStyle, color: brush) -> CheckBoxStateStyle {
        return {
            indicator-color: color,
            checkmark-color: base.checkmark-color,
            foreground: base.foreground,
            indicator-border-color: color,
            indicator-border-width: base.indicator-border-width,
        };
    }

    public pure function with-checked-colors(base: CheckBoxStyle, rest: brush, hover: brush, pressed: brush) -> CheckBoxStyle {
        return {
            unchecked: base.unchecked,
            checked: {
                rest: AppCheckBoxStyles.with-indicator-color(base.checked.rest, rest),
                hover: AppCheckBoxStyles.with-indicator-color(base.checked.hover, hover),
                pressed: AppCheckBoxStyles.with-indicator-color(base.checked.pressed, pressed),
                disabled: base.checked.disabled,
            },
            focus-color: rest,
            focus-width: base.focus-width,
            focus-offset: base.focus-offset,
            indicator-radius: base.indicator-radius,
        };
    }

    in-out property <CheckBoxStyle> normal: AppCheckBoxStyles.with-checked-colors(
        CheckBoxStyles.standard, AppCheckBoxStyles.accent, AppCheckBoxStyles.accent-hover, AppCheckBoxStyles.accent-pressed);
    in-out property <CheckBoxStyle> warning: AppCheckBoxStyles.with-checked-colors(
        CheckBoxStyles.standard, #b45309, #92400e, #78350f);
}

component AppCheckBox inherits CheckBox {
    style: AppCheckBoxStyles.normal;
    size: CheckBoxSizes.medium;
}

export component SharedCheckBoxStylesExample inherits Window {
    title: "Shared checkbox styles";
    width: 600px;
    height: 340px;
    background: white;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text {
            text: "Six checkboxes, two shared styles";
            color: BasicTheme.foreground;
            font-size: 22px;
        }

        HorizontalLayout {
            spacing: 32px;
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Normal";
                    color: BasicTheme.foreground;
                }

                AppCheckBox {
                    text: "Notifications";
                    checked: true;
                }

                AppCheckBox {
                    text: "Autosave";
                    checked: true;
                }

                AppCheckBox {
                    text: "Show guides";
                }

                AppCheckBox {
                    text: "Snap to grid";
                }
            }

            VerticalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "Warning";
                    color: BasicTheme.foreground;
                }

                AppCheckBox {
                    text: "Delete originals";
                    style: AppCheckBoxStyles.warning;
                    checked: true;
                }

                AppCheckBox {
                    text: "Overwrite files";
                    style: AppCheckBoxStyles.warning;
                }
            }
        }

        Button {
            text: "Use blue for normal checkboxes";
            clicked => {
                AppCheckBoxStyles.accent = #2563eb;
                AppCheckBoxStyles.accent-hover = #1d4ed8;
                AppCheckBoxStyles.accent-pressed = #1e40af;
            }
        }
    }
}
