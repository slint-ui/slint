import { Button, ButtonSizes, ButtonStyles } from "../src/basic.slint";

export component StyledButtonPreview inherits Window {
    title: "Styled button";
    width: 258px;
    height: 82px;
    background: white;

    out property <int> activations;

    Button {
        text: "Button";
        style: ButtonStyles.primary;
        size: ButtonSizes.large;
        width: 226px;
        clicked => { root.activations += 1; }
    }
}
