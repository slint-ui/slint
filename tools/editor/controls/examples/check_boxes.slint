import {
    CheckBoxStyle,
    CheckBoxStyles,
    BasicTheme,
} from "../src/basic.slint";
import { CheckBoxBase } from "../src/headless.slint";
import { PreviewCheckBox } from "preview_controls.slint";
import { ExampleSection } from "section.slint";
import { PreviewSettings } from "preview_settings.slint";

component CustomCheckBox inherits PreviewCheckBox {
    checked-color: #0f766e;
}

export component CheckBoxExamples inherits Rectangle {
    vertical-stretch: 0;
    in property <CheckBoxStyle> preview-style: CheckBoxStyles.standard;
    in-out property <int> size-index: 1;
    in-out property <bool> preview-disabled;

    in-out property <int> toggles;
    in-out property <int> custom-toggles;

    VerticalLayout {
        spacing: 20px;
        PreviewSettings {
            control-name: "CheckBox";
            size-index <=> root.size-index;
            disabled <=> root.preview-disabled;
        }

        ExampleSection {
            title: "Base theme";
            description: "Unchecked, checked, and disabled checkboxes using BasicTheme.";
            FlexboxLayout {
                spacing: 12px;
                cross-axis-alignment: start;
                cross-axis-line-alignment: start;
                standard := PreviewCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    text: "Show guides";
                    toggled => { root.toggles += 1; }
                }

                PreviewCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    text: "Snap to grid";
                    checked: true;
                    toggled => { root.toggles += 1; }
                }

                PreviewCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: false;
                    text: "Disabled";
                }
            }

            PreviewCheckBox {
                style: root.preview-style;
                size-index: root.size-index;
                enabled: false;
                text: "Disabled checked";
                checked: true;
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Toggles: \{root.toggles}  ·  Show guides: \{standard.checked ? "yes" : "no"}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        ExampleSection {
            title: "Custom checkboxes";
            description: "Set a checked color, reuse component defaults, or supply your own visuals through slots.";
            VerticalLayout {
                spacing: 12px;
                CustomCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    text: "Custom checked color";
                    checked: true;
                    toggled => { root.custom-toggles += 1; }
                }

                CustomCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    text: "Same shared defaults";
                    toggled => { root.custom-toggles += 1; }
                }

                bare := CheckBoxBase {
                    enabled: !root.preview-disabled;
                    text: "Headless checkbox";
                    spacing: 8px;
                    horizontal-padding: 6px;
                    vertical-padding: 6px;
                    content << HorizontalLayout {
                        padding-left: bare.left-padding;
                        padding-right: bare.right-padding;
                        padding-top: bare.top-padding;
                        padding-bottom: bare.bottom-padding;
                        spacing: bare.spacing;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            vertical-stretch: 0;
                            background: bare.checked ? #7c3aed : transparent;
                            border-color: bare.has-focus ? #5b21b6 : #a78bfa;
                            border-width: bare.has-focus ? 2px : 1px;
                            border-radius: 10px;
                            if bare.checked: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: white;
                            }
                        }
                        Text {
                            text: bare.text;
                            color: #5b21b6;
                            font-size: 14px;
                            font-weight: 400;
                            vertical-alignment: center;
                        }
                    }
                    toggled => { root.custom-toggles += 1; }
                }

                custom := PreviewCheckBox {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    accessible-label: "Custom checkbox content";
                    text: "Autosave · " + (self.checked ? "On" : "Off");

                    toggled => { root.custom-toggles += 1; }
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Custom toggles: \{root.custom-toggles}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        Text {
            text: "Click the indicator or label to toggle. Use Tab to focus, then release Space or Enter to toggle.";
            color: BasicTheme.disabled-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
