import { CheckBox, BasicTheme } from "../src/basic.slint";
import { CheckBoxBase } from "../src/headless.slint";
import { ExampleSection } from "section.slint";

export component CheckBoxExamples inherits Rectangle {
    vertical-stretch: 0;
    in-out property <int> toggles;
    in-out property <int> custom-toggles;

    VerticalLayout {
        spacing: 20px;
        ExampleSection {
            title: "Base theme";
            description: "Unchecked, checked, and disabled checkboxes using BasicTheme.";
            HorizontalLayout {
                spacing: 12px;
                standard := CheckBox {
                    text: "Show guides";
                    toggled => { root.toggles += 1; }
                }

                CheckBox {
                    text: "Snap to grid";
                    checked: true;
                    toggled => { root.toggles += 1; }
                }

                CheckBox {
                    text: "Disabled";
                    enabled: false;
                }
            }

            CheckBox {
                text: "Disabled checked";
                checked: true;
                enabled: false;
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Toggles: \{root.toggles}  ·  Show guides: \{standard.checked ? "yes" : "no"}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        ExampleSection {
            title: "Custom checkboxes";
            description: "Override colors, supply headless visuals, or replace the label.";
            VerticalLayout {
                spacing: 12px;
                CheckBox {
                    text: "Color override";
                    checked: true;
                    indicator-color: self.checked ? #0f766e : BasicTheme.background;
                    foreground: #115e59;
                    indicator-radius: 6px;
                    toggled => { root.custom-toggles += 1; }
                }

                bare := CheckBoxBase {
                    text: "Headless checkbox";
                    font-size: 14px;
                    font-weight: 400;
                    content-padding: 6px;
                    indicator << Rectangle {
                        background: bare.checked ? #7c3aed : transparent;
                        border-color: bare.has-focus ? #5b21b6 : #a78bfa;
                        border-width: bare.has-focus ? 2px : 1px;
                        border-radius: 10px;
                        if bare.checked: Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: white;
                        }
                    }
                    content << Text {
                        text: bare.text;
                        color: #5b21b6;
                        font-size: bare.font-size;
                        vertical-alignment: center;
                    }
                    toggled => { root.custom-toggles += 1; }
                }

                custom := CheckBoxBase {
                    in property <length> indicator-size: 20px;
                    private property <brush> state-indicator: custom.checked ? BasicTheme.accent : BasicTheme.background;
                    private property <brush> state-foreground: BasicTheme.foreground;
                    in property <brush> indicator-color: custom.state-indicator;
                    in property <brush> indicator-border-color: !custom.enabled ? BasicTheme.disabled-foreground
                        : custom.checked ? custom.indicator-color : BasicTheme.border;
                    in property <length> indicator-border-width: 1px;
                    in property <length> indicator-radius: 4px;
                    in property <brush> checkmark-color: custom.enabled ? BasicTheme.accent-foreground : BasicTheme.disabled-foreground;
                    in property <brush> foreground: custom.state-foreground;

                    indicator-width: custom.indicator-size;
                    indicator-height: custom.indicator-size;
                    content-padding: 6px;
                    font-size: 14px;
                    font-weight: 400;

                    states [
                        disabled when !custom.enabled: {
                            custom.state-indicator: BasicTheme.disabled-background;
                            custom.state-foreground: BasicTheme.disabled-foreground;
                        }
                        pressed when custom.pressed: {
                            custom.state-indicator: custom.checked ? BasicTheme.accent-pressed : BasicTheme.pressed-background;
                        }
                        hover when custom.hovered: {
                            custom.state-indicator: custom.checked ? BasicTheme.accent-hover : BasicTheme.hover-background;
                        }
                    ]

                    indicator << Rectangle {
                        background: custom.indicator-color;
                        border-color: custom.indicator-border-color;
                        border-width: custom.indicator-border-width;
                        border-radius: custom.indicator-radius;

                        if custom.checked: Path {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            viewbox-width: 16;
                            viewbox-height: 16;
                            stroke: custom.checkmark-color;
                            stroke-width: 2px;
                            MoveTo {
                                x: 2;
                                y: 8;
                            }

                            LineTo {
                                x: 6;
                                y: 12;
                            }

                            LineTo {
                                x: 14;
                                y: 4;
                            }
                        }

                        if custom.enabled && custom.has-focus: Rectangle {
                            x: -3px;
                            y: -3px;
                            width: parent.width + 6px;
                            height: parent.height + 6px;
                            border-width: 2px;
                            border-color: BasicTheme.focus;
                            border-radius: custom.indicator-radius + 2px;
                        }
                    }
                    text: "Custom checkbox content";

                    content << HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "Autosave";
                            color: custom.foreground;
                            font-size: custom.font-size;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }

                        Text {
                            text: custom.checked ? "On" : "Off";
                            color: BasicTheme.disabled-foreground;
                            font-size: 12px;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                    }
                    toggled => { root.custom-toggles += 1; }
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Custom toggles: \{root.custom-toggles}";
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        Text {
            text: "Click the indicator or label to toggle. Use Tab to focus, then release Space or Enter to toggle.";
            color: BasicTheme.disabled-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
