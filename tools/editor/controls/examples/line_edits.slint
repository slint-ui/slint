import {
    LineEditStyle,
    LineEditStateStyle,
    LineEditStyles,
    BasicTheme,
} from "../src/basic.slint";
import { LineEditBase } from "../src/headless.slint";
import { PreviewLineEdit } from "preview_controls.slint";
import { ExampleSection } from "section.slint";
import { PreviewSettings } from "preview_settings.slint";

export component LineEditExamples inherits Rectangle {
    vertical-stretch: 0;
    in property <LineEditStyle> preview-style: LineEditStyles.standard;
    in-out property <int> size-index: 1;
    in-out property <bool> preview-disabled;
    private property <LineEditStateStyle> green-field-colors: {
        background-color: #f0fdfa,
        foreground-color: #0f766e,
        border-color: #0f766e,
        placeholder-color: #0f766e,
    };
    in-out property <int> edits;
    in-out property <int> submissions;
    in-out property <string> last-value;

    VerticalLayout {
        padding: 0px;
        spacing: 20px;
        PreviewSettings {
            control-name: "LineEdit";
            size-index <=> root.size-index;
            disabled <=> root.preview-disabled;
        }

        ExampleSection {
            title: "Base theme";
            description: "Editable, disabled, read-only, and password fields using BasicTheme.";
            HorizontalLayout {
                spacing: 16px;
                name-field := PreviewLineEdit {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    accessible-label: "Name";
                    placeholder-text: "Enter a name";
                    leading << Text {
                        text: "Name:";
                        color: !name-field.enabled ? name-field.style.disabled.foreground-color
                            : name-field.hovered ? name-field.style.hover.foreground-color : name-field.style.rest.foreground-color;
                        font-size: name-field.font-size;
                        vertical-alignment: center;
                    }
                    trailing << Text {
                        text: "Optional";
                        color: BasicTheme.disabled-foreground;
                        font-size: name-field.font-size;
                        vertical-alignment: center;
                    }
                    edited(value) => { root.edits += 1; root.last-value = value; }
                    accepted(value) => { root.submissions += 1; root.last-value = value; }
                }

                PreviewLineEdit {
                    style: root.preview-style;
                    size-index: root.size-index;
                    accessible-label: "Disabled field";
                    text: "Disabled";
                    enabled: false;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                PreviewLineEdit {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    accessible-label: "Read-only field";
                    text: "Read-only text";
                    read-only: true;
                }

                PreviewLineEdit {
                    style: root.preview-style;
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    accessible-label: "Password";
                    placeholder-text: "Enter a password";
                    input-type: password;
                    text: "slint";
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Edits: \{root.edits} · Submissions: \{root.submissions} · Last value: \{root.last-value}";
                    color: BasicTheme.foreground;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        ExampleSection {
            title: "Custom fields";
            description: "Override style properties, supply headless visuals, or add leading and trailing content.";
            HorizontalLayout {
                spacing: 16px;
                PreviewLineEdit {
                    size-index: root.size-index;
                    enabled: !root.preview-disabled;
                    accessible-label: "Color override field";
                    placeholder-text: "Green field";
                    style: {
                        rest: root.green-field-colors,
                        hover: root.green-field-colors,
                        ..root.preview-style,
                    };
                }

                bare := LineEditBase {
                    enabled: !root.preview-disabled;
                    accessible-label: "Headless field";
                    placeholder-text: "Headless field";
                    foreground-color: #7c3aed;
                    font-size: 14px;
                    horizontal-padding: 8px;
                    vertical-padding: 8px;
                    min-height: 40px;
                    background << Rectangle {
                        background: #faf5ff;
                        Rectangle {
                            y: parent.height - self.height;
                            height: bare.has-focus ? 2px : 1px;
                            background: #7c3aed;
                        }
                    }
                    placeholder << Text {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        text: bare.placeholder-text;
                        color: #7c3aed;
                        font-size: bare.font-size;
                        horizontal-alignment: bare.horizontal-alignment;
                        vertical-alignment: center;
                    }
                }
            }

            file-name := PreviewLineEdit {
                style: root.preview-style;
                size-index: root.size-index;
                enabled: !root.preview-disabled;
                accessible-label: "File name";
                placeholder-text: "my-component";
                leading << Text {
                    text: "File:";
                    color: BasicTheme.disabled-foreground;
                    font-size: file-name.font-size;
                    vertical-alignment: center;
                }
                trailing << Text {
                    text: ".slint";
                    color: BasicTheme.disabled-foreground;
                    font-size: file-name.font-size;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "Click or Tab to focus. Enter submits; selection, clipboard shortcuts, and undo/redo use TextInput behavior.";
            color: BasicTheme.disabled-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
