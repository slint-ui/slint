import { ComboBox, BasicTheme } from "../src/basic.slint";
import {
    ComboBoxBase,
    ComboBoxPopupBase,
    ButtonBase,
} from "../src/headless.slint";
import { ExampleSection } from "section.slint";

export component ComboBoxExamples inherits Rectangle {
    vertical-stretch: 0;
    in-out property <int> selections;
    in-out property <int> custom-selections;
    in-out property <string> selected-value: "None yet";
    in-out property <string> custom-value: "None yet";

    VerticalLayout {
        spacing: 20px;
        ExampleSection {
            title: "Base theme";
            description: "Default, disabled, placeholder, and scrollable combo boxes using BasicTheme.";
            HorizontalLayout {
                spacing: 16px;
                ComboBox {
                    accessible-label: "Image fit";
                    model: ["Contain", "Cover", "Fill", "None"];
                    min-height: 40px;
                    selected(value) => { root.selections += 1; root.selected-value = value; }
                }

                ComboBox {
                    accessible-label: "Disabled combo box";
                    model: ["Disabled"];
                    min-height: 40px;
                    enabled: false;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                ComboBox {
                    accessible-label: "Choose a size";
                    model: ["Small", "Medium", "Large", "Extra large"];
                    current-index: -1;
                    placeholder: "Choose a size";
                    min-height: 40px;
                    selected(value) => { root.selections += 1; root.selected-value = value; }
                }

                ComboBox {
                    accessible-label: "Scrollable options";
                    model: [
                        "Zero",
                        "One",
                        "Two",
                        "Three",
                        "Four",
                        "Five",
                        "Six",
                        "Seven",
                        "Eight",
                        "Nine"
                    ];
                    maximum-visible-items: 4;
                    min-height: 40px;
                    selected(value) => { root.selections += 1; root.selected-value = value; }
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Selected: " + root.selected-value + "  ·  Selections: " + root.selections;
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        ExampleSection {
            title: "Custom combo boxes";
            description: "Override theme properties or supply your own field, indicator, and popup visuals.";
            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Color override";
                        color: BasicTheme.disabled-foreground;
                        font-size: 12px;
                    }

                    ComboBox {
                        accessible-label: "Tinted combo box";
                        model: ["Small", "Medium", "Large"];
                        current-index: 1;
                        min-height: 40px;
                        background-color: #f0fdfa;
                        foreground: #115e59;
                        border-color: #0d9488;
                        popup-color: #f0fdfa;
                        highlighted-background: #0d9488;
                        selected(value) => { root.custom-selections += 1; root.custom-value = value; }
                    }
                }

                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Headless visuals";
                        color: BasicTheme.disabled-foreground;
                        font-size: 12px;
                    }

                    custom := ComboBoxBase {
                        accessible-label: "Custom combo box";
                        model: ["First", "Second", "Third"];
                        min-height: 40px;
                        content-padding: 6px;
                        content-padding-left: 16px;
                        content-padding-right: 16px;
                        background << Rectangle {
                            background: #fef3c7;
                            border-radius: 20px;
                            border-width: custom.has-focus ? 2px : 0px;
                            border-color: #d97706;
                        }
                        content << Text {
                            text: custom.current-value;
                            color: #92400e;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        indicator << Text {
                            text: custom.expanded ? "−" : "+";
                            color: #92400e;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        popup << custom-popup := ComboBoxPopupBase {
                            Rectangle {
                                background: #fffbeb;
                                border-width: 1px;
                                border-color: #d97706;
                                border-radius: 4px;
                            }

                            VerticalLayout {
                                padding: custom-popup.popup-padding;
                                for value[index] in custom-popup.model: item := ButtonBase {
                                    text: value;
                                    height: custom-popup.item-height;
                                    accessible-role: list-item;
                                    accessible-checked: index == custom-popup.current-index;
                                    content-padding-left: 12px;
                                    content-padding-right: 12px;
                                    changed hovered => { if self.hovered { custom-popup.highlight(index); } }
                                    clicked => { custom-popup.selected(index); }
                                    background << Rectangle {
                                        background: index == custom-popup.highlighted-index ? #fcd34d : transparent;
                                    }
                                    content << Text {
                                        text: value;
                                        color: #92400e;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        selected(value) => { root.custom-selections += 1; root.custom-value = value; }
                    }
                }
            }

            Rectangle {
                height: 40px;
                background: BasicTheme.background;
                border-radius: 4px;
                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: "Selected: " + root.custom-value + "  ·  Selections: " + root.custom-selections;
                    color: BasicTheme.foreground;
                    vertical-alignment: center;
                    font-size: 12px;
                }
            }
        }

        Text {
            text: "Space or Enter opens the list. Arrows highlight; Enter selects; Escape cancels.";
            color: BasicTheme.disabled-foreground;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
