import { FillData } from "../ui/api.slint";

export struct GalleryPage { id: string, title: string }
export global Gallery {
    in-out property <[GalleryPage]> pages;
    in-out property <string> page: "palette";
    in-out property <string> title;
    in-out property <string> description;
    in-out property <[string]> scenarios;
    in-out property <string> scenario;
    in-out property <int> scenario-index;
    in-out property <string> feedback;
    in-out property <int> reset-generation;
    in-out property <FillData> fill;
    pure callback matches(string, string) -> bool;
    callback navigate(string, string);
    callback open-picker(Point);
}
