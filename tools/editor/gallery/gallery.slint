import { Button, ScrollView, Palette } from "std-widgets.slint";
import { Gallery, GalleryPage } from "state.slint";
import { GalleryProperties } from "properties.slint";
import { Colors, Typography } from "../ui/style.slint";
import { Api, EditorSurfaceMode } from "../ui/api.slint";
import { EditorWindow, MutedLabel } from "../ui/components/index.slint";
import { ElementPalette } from "../ui/components/element-palette.slint";
import { OutlinePane } from "../ui/components/outline-pane.slint";
import { InspectorFillPicker } from "../ui/components/inspector/fill-picker.slint";
import { FillSession } from "../ui/components/inspector/fill-session.slint";
import { GalleryControls, GalleryFoundations } from "pages/controls.slint";
import "../ui/assets/Inter-VariableFont.ttf";

export { Gallery, Api, EditorWindow, FillSession }
export { GalleryPage } from "state.slint";

export component GalleryWindow inherits Window {
    title: "Visual Editor · Component Gallery";
    preferred-width: 1440px; preferred-height: 1000px;
    min-width: 800px; min-height: 600px;
    background: Colors.background;
    default-font-family: Typography.family;
    in-out property <int> theme-index;
    private property <ColorScheme> system-scheme;
    changed theme-index => { Palette.color-scheme = root.theme-index == 1 ? ColorScheme.light : root.theme-index == 2 ? ColorScheme.dark : root.system-scheme; }
    init => { root.system-scheme = Palette.color-scheme; EditorWindow.width = root.width; EditorWindow.height = root.height; if Platform.uses-mock-data { Gallery.navigate(Gallery.page, 0); } }
    changed width => { EditorWindow.width = root.width; }
    changed height => { EditorWindow.height = root.height; }
    HorizontalLayout {
        spacing: 1px;
        Rectangle {
            width: 218px; background: Colors.surface;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: "Component Gallery"; color: Colors.foreground; font-size: Typography.heading.size; font-weight: Typography.heading.weight; }
                for page in Gallery.pages: Button {
                    text: Gallery.page-title(page); checked: Gallery.page == page;
                    clicked => { Gallery.navigate(page, 0); }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
        VerticalLayout {
            padding: 24px; spacing: 16px;
            Text { text: Gallery.title; wrap: word-wrap; color: Colors.foreground; font-size: 24px; font-weight: 600; }
            MutedLabel { text: Gallery.description; wrap: word-wrap; }
            ScrollView {
                vertical-stretch: 1;
                content-width: max(self.width, Gallery.preview-width * 1px);
                content-height: max(self.height, Gallery.preview-height * 1px);
                Rectangle {
                    x: 0px; y: 0px;
                    width: Gallery.preview-width > 0 ? Gallery.preview-width * 1px : parent.width;
                    height: Gallery.preview-height > 0 ? Gallery.preview-height * 1px : parent.height;
                    background: Colors.surface;
                    accessible-role: AccessibleRole.region; accessible-label: "Gallery preview";
                    if Gallery.page == GalleryPage.foundations: GalleryFoundations { }
                    if Gallery.page == GalleryPage.controls || Gallery.page == GalleryPage.inspector-controls: GalleryControls { inspector: Gallery.page == GalleryPage.inspector-controls; }
                    if Gallery.page == GalleryPage.palette: HorizontalLayout {
                        ElementPalette { width: Gallery.panel-width * 1px; image-mode: Api.editor-surface-mode == EditorSurfaceMode.image; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if Gallery.page == GalleryPage.outline: HorizontalLayout {
                        OutlinePane { width: Gallery.panel-width * 1px; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if Gallery.page == GalleryPage.picker: VerticalLayout {
                        padding: 24px; spacing: 16px; alignment: start;
                        Rectangle {
                            width: 240px; height: 160px;
                            background: Api.fill-brush(FillSession.open ? FillSession.working-fill : Gallery.fill);
                            accessible-role: AccessibleRole.region; accessible-label: "Sample fill";
                        }
                        Button { width: 240px; text: "Open color picker"; clicked => { Gallery.open-picker(self.absolute-position); } }
                    }
                }
            }
        }
        GalleryProperties { theme-index <=> root.theme-index; }
    }
    TouchArea {
        visible: FillSession.open;
        clicked => { FillSession.close-picker(true, true); }
        InspectorFillPicker { }
    }
}
