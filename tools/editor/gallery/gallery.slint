import { Button, ComboBox, Palette } from "std-widgets.slint";
import { Gallery } from "state.slint";
import { Colors, Typography } from "../ui/style.slint";
import { Api, EditorSurfaceMode } from "../ui/api.slint";
import { AppState, EditorWindow, PrimerTextInput, MutedLabel } from "../ui/components/common.slint";
import { ElementPalette } from "../ui/components/element-palette.slint";
import { OutlinePane } from "../ui/components/outline-pane.slint";
import { InspectorFillPicker } from "../ui/components/inspector/fill-picker.slint";
import { FillSession } from "../ui/components/inspector/fill-session.slint";
import { DragPreview } from "../ui/components/drag-preview.slint";
import { GalleryControls, GalleryFoundations } from "pages/controls.slint";
import "../ui/assets/Inter-VariableFont.ttf";

export { Gallery, Api, AppState, EditorWindow, FillSession }
export { GalleryPage } from "state.slint";

export component GalleryWindow inherits Window {
    title: "Visual Editor · Component Gallery";
    preferred-width: 1440px; preferred-height: 1000px;
    min-width: 800px; min-height: 600px;
    background: Colors.background;
    default-font-family: Typography.family;
    in-out property <int> theme-index;
    private property <ColorScheme> system-scheme;
    changed theme-index => { Palette.color-scheme = root.theme-index == 1 ? ColorScheme.light : root.theme-index == 2 ? ColorScheme.dark : root.system-scheme; }
    init => { root.system-scheme = Palette.color-scheme; EditorWindow.width = root.width; EditorWindow.height = root.height; }
    changed width => { EditorWindow.width = root.width; }
    changed height => { EditorWindow.height = root.height; }
    public function clear-transients() {
        Gallery.reset-generation += 1;
        FillSession.close-picker(false, false);
        AppState.cancel-active-drags();
        AppState.finish-outline-drag();
        AppState.finish-palette-drag();
    }
    focus := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape { AppState.cancel-active-drags(); }
            return reject;
        }
        HorizontalLayout {
            spacing: 1px;
            Rectangle {
                width: 218px; background: Colors.surface;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "Component Gallery"; color: Colors.foreground; font-size: Typography.heading.size; font-weight: Typography.heading.weight; }
                    search := PrimerTextInput { placeholder: "Find components…"; accessible-name: "Find components"; }
                    for page in Gallery.pages: Button {
                        visible: Gallery.matches(page.title, search.text);
                        text: page.title; checked: Gallery.page == page.id;
                        clicked => { Gallery.navigate(page.id, "Default"); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    ComboBox { model: ["System", "Light", "Dark"]; current-index <=> root.theme-index; }
                }
            }
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Text { text: Gallery.title; color: Colors.foreground; font-size: 24px; font-weight: 600; }
                MutedLabel { text: Gallery.description; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 12px;
                    if Gallery.scenarios.length > 1: ComboBox { width: 220px; model: Gallery.scenarios; current-index: Gallery.scenario-index; selected(value) => { Gallery.navigate(Gallery.page, value); } }
                    if Gallery.page != "foundations": Button { text: "Reset example"; clicked => { Gallery.navigate(Gallery.page, Gallery.scenario); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle {
                    background: Colors.surface;
                    accessible-role: AccessibleRole.region; accessible-label: "Gallery preview";
                    Rectangle {
                        if Gallery.page == "foundations": GalleryFoundations { }
                        if Gallery.page == "controls" || Gallery.page == "inspector-controls": GalleryControls { inspector: Gallery.page == "inspector-controls"; }
                        if Gallery.page == "palette": HorizontalLayout {
                            spacing: 24px;
                            ElementPalette { width: 260px; image-mode: Api.editor-surface-mode == EditorSurfaceMode.image; drag-started => { focus.focus(); } }
                            Rectangle {
                                border-width: 1px; border-color: Colors.border; background: Colors.subtle;
                                accessible-role: AccessibleRole.region; accessible-label: "Sample drop target";
                                MutedLabel { text: "Drop an element here"; horizontal-alignment: center; vertical-alignment: center; }
                                DropArea {
                                    can-drop(event) => { return AppState.palette-drag-cancelled ? DragAction.none : DragAction.copy; }
                                    dropped(event) => { Api.drop(event.data, event.position.x, event.position.y); return DragAction.copy; }
                                }
                            }
                        }
                        if Gallery.page == "outline": HorizontalLayout {
                            OutlinePane { width: 300px; drag-started => { focus.focus(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if Gallery.page == "picker": VerticalLayout {
                            padding: 24px; spacing: 16px; alignment: start;
                            Rectangle {
                                width: 240px; height: 160px;
                                background: Api.fill-brush(FillSession.open ? FillSession.working-fill : Gallery.fill);
                                accessible-role: AccessibleRole.region; accessible-label: "Sample fill";
                            }
                            Button { width: 240px; text: "Open color picker"; clicked => { Gallery.open-picker(self.absolute-position); } }
                        }
                    }
                }
                if Gallery.page == "palette" || Gallery.page == "outline": MutedLabel { text: Gallery.feedback; }
            }
        }
    }
    TouchArea {
        visible: FillSession.open;
        clicked => { FillSession.close-picker(true, true); }
        InspectorFillPicker { }
    }
    DragPreview { parent-origin: { x: 0px, y: 0px }; show-palette: false; }
}
