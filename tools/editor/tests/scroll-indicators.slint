import { EditorScrollView } from "../ui/components/editor-scroll-view.slint";

import { Colors } from "../ui/style.slint";

export component ScrollIndicatorTest inherits Window {
    width: 240px;
    height: 200px;
    in property <bool> always-on;
    in property <bool> always-off;
    in property <bool> glide;
    in property <length> view-width: 240px;
    in-out property <length> content-width <=> scroll.content-width;
    in-out property <length> content-height <=> scroll.content-height;
    in-out property <length> content-x <=> scroll.content-x;
    in-out property <length> content-y <=> scroll.content-y;
    out property <length> visible-width <=> scroll.visible-width;
    out property <length> visible-height <=> scroll.visible-height;
    out property <int> clicks;
    out property <int> scroll-events;
    private property <length> glide-position: root.glide ? -600px : 0px;
    animate glide-position { duration: 1600ms; }

    scroll := EditorScrollView {
        width: root.view-width;
        height: parent.height;
        content-width: 1000px;
        content-height: 1200px;
        content-y: root.glide-position;
        horizontal-scrollbar-policy: root.always-off ? ScrollBarPolicy.always-off
            : root.always-on ? ScrollBarPolicy.always-on : ScrollBarPolicy.as-needed;
        vertical-scrollbar-policy: root.always-off ? ScrollBarPolicy.always-off
            : root.always-on ? ScrollBarPolicy.always-on : ScrollBarPolicy.as-needed;
        scrolled => { root.scroll-events += 1; }

        Rectangle {
            width: scroll.content-width;
            height: scroll.content-height;
            background: Colors.surface;
            TouchArea { clicked => { root.clicks += 1; } }
        }
    }
}
