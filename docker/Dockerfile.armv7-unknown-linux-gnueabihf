# cSpell: ignore CLANGCC CLANGCXX CXXFLAGS lname MULTIARCH noninteractive readlink SDKTARGETSYSROOT Yocto

# Ubuntu 22.04 sysroot with the target libraries for the clang cross-build
# below. Its glibc 2.35 is the oldest glibc the binaries built here run on.
# apt installs the foreign-architecture (multiarch) packages without
# emulation; the target files are then copied into /sysroot.
FROM ubuntu:22.04 AS sysroot
RUN sed -i 's/^deb http/deb [arch=amd64] http/' /etc/apt/sources.list && \
    for suite in jammy jammy-updates jammy-security; do \
        echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports $suite main universe" >> /etc/apt/sources.list; \
    done && \
    dpkg --add-architecture armhf && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes --no-install-recommends \
        libc6-dev:armhf libgcc-12-dev:armhf libstdc++-12-dev:armhf \
        libfontconfig1-dev:armhf libxcb1-dev:armhf libxcb-render0-dev:armhf libxcb-shape0-dev:armhf libxcb-xfixes0-dev:armhf \
        libxkbcommon-dev:armhf libinput-dev:armhf libudev-dev:armhf libgbm-dev:armhf libseat-dev:armhf libssl-dev:armhf
# Absolute symlinks are made relative so that they resolve inside /sysroot.
RUN mkdir -p /sysroot/usr/lib /sysroot/usr/share && \
    cp -a /usr/include /sysroot/usr/ && \
    cp -a /usr/lib/arm-linux-gnueabihf /usr/lib/gcc /usr/lib/ld-linux-armhf.so.3 /sysroot/usr/lib/ && \
    cp -a /usr/share/pkgconfig /sysroot/usr/share/ && \
    ln -s usr/lib /sysroot/lib && \
    find /sysroot -type l -lname '/*' -exec sh -c 'ln -sfr "/sysroot$(readlink "$1")" "$1"' _ {} \;

# Ubuntu 26.04 for a recent clang and a git that is new enough for the Skia
# source build.
FROM ubuntu:26.04

# clang cross-compiles against the sysroot, with lld linking the
# foreign-architecture binaries; ninja and python3 are for the Skia source
# build, cmake is for aws-lc-sys. zstd is for the rust-cache action when this
# image is used as a job container.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes clang lld llvm gcc libclang-dev pkg-config libfontconfig-dev cmake ninja-build python3 git curl ca-certificates zstd && \
    # The skia-bindings build clones git repos into the mounted, differently
    # owned cargo home.
    git config --global safe.directory '*'

COPY --from=sysroot /sysroot /sysroot

ENV CROSS_SYSROOT=/sysroot \
    CROSS_MULTIARCH=arm-linux-gnueabihf \
    CROSS_CLANG_TARGET=armv7-unknown-linux-gnueabihf \
    CROSS_CMAKE_SYSTEM_PROCESSOR=armv7
ARG CROSS="--target=$CROSS_CLANG_TARGET --sysroot=$CROSS_SYSROOT $CROSS_CLANG_FLAGS"

# clang runs the target-prefixed ld when it exists, so this makes lld the
# linker for every clang invocation for the target, including the ones
# Corrosion and CMake make.
RUN ln -s "$(command -v ld.lld)" /usr/local/bin/armv7-unknown-linux-gnueabihf-ld

# The link flags live in a linker wrapper rather than in the rustflags: tools
# like napi overwrite RUSTFLAGS, which takes precedence over the
# CARGO_TARGET_*_RUSTFLAGS variable and would drop them.
RUN printf '#!/bin/sh\nexec clang %s "$@"\n' "$CROSS" > /usr/local/bin/armv7-unknown-linux-gnueabihf-clang && \
    chmod +x /usr/local/bin/armv7-unknown-linux-gnueabihf-clang

# For C++ builds (the -cpp image) and for the cmake crate.
COPY docker/cross-toolchain.cmake /opt/toolchain.cmake
ENV CMAKE_TOOLCHAIN_FILE_armv7_unknown_linux_gnueabihf=/opt/toolchain.cmake

# SDKTARGETSYSROOT and CLANGCC/CLANGCXX are skia-bindings' Yocto-style cross
# setup for the gn build.
ENV SDKTARGETSYSROOT=/sysroot
ENV CLANGCC="clang $CROSS"
ENV CLANGCXX="clang++ $CROSS"
ENV PKG_CONFIG_SYSROOT_DIR_armv7_unknown_linux_gnueabihf=/sysroot
ENV PKG_CONFIG_LIBDIR_armv7_unknown_linux_gnueabihf=/sysroot/usr/lib/arm-linux-gnueabihf/pkgconfig:/sysroot/usr/share/pkgconfig
ENV CC_armv7_unknown_linux_gnueabihf=clang
ENV CXX_armv7_unknown_linux_gnueabihf=clang++
ENV AR_armv7_unknown_linux_gnueabihf=llvm-ar
ENV CFLAGS_armv7_unknown_linux_gnueabihf="$CROSS"
ENV CXXFLAGS_armv7_unknown_linux_gnueabihf="$CROSS"
ENV BINDGEN_EXTRA_CLANG_ARGS_armv7_unknown_linux_gnueabihf="$CROSS"
ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=armv7-unknown-linux-gnueabihf-clang
