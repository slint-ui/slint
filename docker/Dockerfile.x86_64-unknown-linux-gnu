# cSpell: ignore CLANGCC CLANGCXX CXXFLAGS lname MULTIARCH noninteractive readlink SDKTARGETSYSROOT Yocto

# Ubuntu 22.04 sysroot with the target libraries for the clang build below.
# Its glibc 2.35 is the oldest glibc the binaries built here run on; the
# target files are copied into /sysroot.
FROM ubuntu:22.04 AS sysroot
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes --no-install-recommends \
        libc6-dev libgcc-12-dev libstdc++-12-dev \
        libfontconfig1-dev libxcb1-dev libxcb-render0-dev libxcb-shape0-dev libxcb-xfixes0-dev \
        libxkbcommon-dev libinput-dev libudev-dev libgbm-dev libseat-dev libssl-dev
# Absolute symlinks are made relative so that they resolve inside /sysroot.
RUN mkdir -p /sysroot/usr/lib /sysroot/usr/share && \
    cp -a /usr/include /sysroot/usr/ && \
    cp -a /usr/lib/x86_64-linux-gnu /usr/lib/gcc /sysroot/usr/lib/ && \
    cp -a /usr/lib64 /sysroot/usr/ && \
    cp -a /usr/share/pkgconfig /sysroot/usr/share/ && \
    ln -s usr/lib /sysroot/lib && \
    ln -s usr/lib64 /sysroot/lib64 && \
    find /sysroot -type l -lname '/*' -exec sh -c 'ln -sfr "/sysroot$(readlink "$1")" "$1"' _ {} \;

# Ubuntu 26.04 for a recent clang and a git that is new enough for the Skia
# source build.
FROM ubuntu:26.04

# clang compiles and lld links against the sysroot; ninja and python3 are for
# the Skia source build, cmake is for aws-lc-sys. zstd is for the rust-cache
# action when this image is used as a job container.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes clang lld llvm gcc libclang-dev pkg-config libfontconfig-dev cmake ninja-build python3 git curl ca-certificates zstd && \
    # The skia-bindings build clones git repos into the mounted, differently
    # owned cargo home.
    git config --global safe.directory '*'

COPY --from=sysroot /sysroot /sysroot

ENV CROSS_SYSROOT=/sysroot \
    CROSS_MULTIARCH=x86_64-linux-gnu \
    CROSS_CLANG_TARGET=x86_64-unknown-linux-gnu \
    CROSS_CMAKE_SYSTEM_PROCESSOR=x86_64
ARG CROSS="--target=$CROSS_CLANG_TARGET --sysroot=$CROSS_SYSROOT $CROSS_CLANG_FLAGS"

# clang runs the target-prefixed ld when it exists, so this makes lld the
# linker for every clang invocation for the target, including the ones
# Corrosion and CMake make.
RUN ln -s "$(command -v ld.lld)" /usr/local/bin/x86_64-unknown-linux-gnu-ld

# The link flags live in a linker wrapper rather than in the rustflags: tools
# like napi overwrite RUSTFLAGS, which takes precedence over the
# CARGO_TARGET_*_RUSTFLAGS variable and would drop them.
RUN printf '#!/bin/sh\nexec clang %s "$@"\n' "$CROSS" > /usr/local/bin/x86_64-unknown-linux-gnu-clang && \
    chmod +x /usr/local/bin/x86_64-unknown-linux-gnu-clang

# For C++ builds (the -cpp image) and for the cmake crate.
COPY docker/cross-toolchain.cmake /opt/toolchain.cmake
ENV CMAKE_TOOLCHAIN_FILE_x86_64_unknown_linux_gnu=/opt/toolchain.cmake

# SDKTARGETSYSROOT and CLANGCC/CLANGCXX are skia-bindings' Yocto-style cross
# setup for the gn build.
ENV SDKTARGETSYSROOT=/sysroot
ENV CLANGCC="clang $CROSS"
ENV CLANGCXX="clang++ $CROSS"
ENV PKG_CONFIG_SYSROOT_DIR_x86_64_unknown_linux_gnu=/sysroot
ENV PKG_CONFIG_LIBDIR_x86_64_unknown_linux_gnu=/sysroot/usr/lib/x86_64-linux-gnu/pkgconfig:/sysroot/usr/share/pkgconfig
ENV CC_x86_64_unknown_linux_gnu=clang
ENV CXX_x86_64_unknown_linux_gnu=clang++
ENV AR_x86_64_unknown_linux_gnu=llvm-ar
ENV CFLAGS_x86_64_unknown_linux_gnu="$CROSS"
ENV CXXFLAGS_x86_64_unknown_linux_gnu="$CROSS"
ENV BINDGEN_EXTRA_CLANG_ARGS_x86_64_unknown_linux_gnu="$CROSS"
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-unknown-linux-gnu-clang
