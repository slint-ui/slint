#MISE description="Check that every symlink in the repository points to an existing file"

# cSpell: ignore readlink

set -e

broken=0
while IFS= read -r -d '' entry; do
    [[ $entry == 120000* ]] || continue
    link=${entry#*$'\t'}
    if [ ! -e "$link" ]; then
        echo "ERROR: Broken symlink: $link -> $(readlink "$link")"
        broken=1
    fi
done < <(git ls-files -z -s)

exit $broken
