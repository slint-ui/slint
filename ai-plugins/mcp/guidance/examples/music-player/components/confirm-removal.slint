import { Button } from "std-widgets.slint";
import { Metrics } from "../metrics.slint";
import { Style } from "../style.slint";

export component ConfirmRemoval inherits PopupWindow {
    callback confirmed();

    Rectangle {
        background: Style.surface;
    }

    FocusScope {
        init => { cancel.focus() }

        KeyBinding {
            keys: @keys(Escape);
            activated => { root.close(); }
        }

        VerticalLayout {
            padding: Metrics.panel-padding;
            spacing: Metrics.gap;

            Text {
                text: @tr("Are you sure?");
            }

            HorizontalLayout {
                spacing: Metrics.gap;

                cancel := Button {
                    text: @tr("Cancel");
                    clicked => { root.close(); }
                }

                Button {
                    text: @tr("Remove");
                    clicked => { root.confirmed(); root.close(); }
                }
            }
        }
    }
}
