import { LibraryView, PlayerView } from "views/index.slint";
export { Library, Player } from "views/index.slint";

export enum Page { library, player }

export component MainWindow inherits Window {
    in-out property <Page> page: Page.library;

    if root.page == Page.library: LibraryView {
        play => { root.page = Page.player; }
    }

    if root.page == Page.player: PlayerView {
        back => { root.page = Page.library; }
    }
}
