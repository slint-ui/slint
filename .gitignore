!api/python/briefcase/uv.lock
!docs/python/uv.lock
!tools/editor/ui-tests/uv.lock
.python-version

MODULE.bazel.lock

# Ignore Xcode projects created by xcodegen
*.xcodeproj
*.xcworkspace
Info.plist

