// A function called from a nested repeater is reached through a 'parent' frame.
// Its body must still be counted in the frame it belongs to, or the parent
// property it reads is removed while the body keeps referencing it.

export component TestCase inherits Window {
    width: 100phx;
    height: 100phx;

    in property <int> a: 1;
    in property <int> b: 2;
    in property <int> c: 3;
    in property <int> d: 4;
    // Reads four inputs: the binding can't be constant-folded, and its cost is past
    // the inliner's threshold, so `secret` stays a property of its own.
    property <int> secret: a * 3 + b * 5 + c * 7 + d * 11;
    out property <int> result;

    for i in [10]: outer := Rectangle {
        // Called from more than one place, so it is not inlined either.
        function fn() -> int { return root.secret + root.secret * 2 + i; }
        for j in [1]: Rectangle {
            width: 100phx;
            height: 100phx;
            TouchArea {
                clicked => { root.result = outer.fn() + outer.fn(); }
            }
        }
    }
}

/*

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert_eq(instance.get_result(), 0);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq(instance.get_result(), 488);
```

```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_result(), 0);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_result(), 488);
```

```js
var instance = new slint.TestCase();
assert.equal(instance.result, 0);
slintlib.private_api.send_mouse_click(instance, 5., 5.);
assert.equal(instance.result, 488);
```
