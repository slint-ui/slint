import { TabWidget } from "std-widgets.slint";

export component ComboBox inherits Rectangle {
    min-height: max(32px, l.min-height);
    l := HorizontalLayout { Text {} }
}

export component Broken inherits TabWidget {
    t1 := Tab {
        vl := VerticalLayout {
            cb := ComboBox { }
        }
    }
}
export component AppWindow inherits Window {
    hl := HorizontalLayout {
        broken := Broken {}
    }
}
