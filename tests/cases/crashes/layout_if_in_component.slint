export component Btn inherits Rectangle {
    in property <bool> show: false;
    min-height: max(32px, l.min-height);
    l := HorizontalLayout {
        if (show): button_in_image := Image {
            width: 24px;
        }
        text := Text {  }
    }
}

export component TestCase inherits Window {
    in property <bool> show: false;
    x := HorizontalLayout {
        btn := Btn { show: root.show; }
    }
}
