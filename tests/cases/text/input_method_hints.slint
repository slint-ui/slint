//ignore: live-preview

export component TestCase inherits Window {
    width: 100phx;
    height: 100phx;
    ti := TextInput {
        input-method-hints: {
            capitalization: CapitalizationMode.words,
            auto-correct: false,
            auto-complete: false
        };
    }

    out property <bool> input_focused: ti.has_focus;
    out property<InputMethodHints> input-method-hints: TextInputInterface.text-input-method-hints;
}

/*
```rust
use i_slint_core::items::InputMethodHints;

let instance = TestCase::new().unwrap();
assert_eq!(instance.get_input_method_hints(), InputMethodHints::default());

slint_testing::send_mouse_click(&instance, 5., 5.);
assert!(instance.get_input_focused());

let mut hints = InputMethodHints::default();
hints.capitalization = slint::language::CapitalizationMode::Words;
hints.auto_correct = false;
hints.auto_complete = false;

assert_eq!(instance.get_input_method_hints(), hints);
```

```cpp
using slint::cbindgen_private::InputMethodHints;

auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_input_method_hints() == InputMethodHints());

slint_testing::send_mouse_click(&instance, 5., 5.);
assert(instance.get_input_focused());

auto hints = InputMethodHints();
hints.capitalization = slint::language::CapitalizationMode::Words;
hints.auto_correct = false;
hints.auto_complete = false;

assert(instance.get_input_method_hints() == hints);
```
*/
