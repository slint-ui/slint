// cSpell: ignore hunter

export component TestCase inherits Window {
    width: 200phx;
    height: 200phx;

    VerticalLayout {
        secret := TextInput {
            input-type: password;
            text: "hunter2";
        }

        plain := TextInput {
            text: "plain";
        }
    }

    in-out property <string> secret-text <=> secret.text;
    in-out property <string> plain-text <=> plain.text;

    public function focus-secret() { secret.focus(); }
    public function focus-plain() { plain.focus(); }
}

/*
```rust
use slint::platform::Key;
use slint::SharedString;

let instance = TestCase::new().unwrap();

let shortcut = |key: &str| {
    slint_testing::send_keyboard_char(&instance, Key::Control.into(), true);
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(key));
    slint_testing::send_keyboard_char(&instance, Key::Control.into(), false);
};

// Fill the clipboard from the plain field, which also proves the shortcuts below reach the input.
instance.invoke_focus_plain();
shortcut("a");
shortcut("c");

// Cut is disabled on a password field: the selection survives.
instance.invoke_focus_secret();
shortcut("a");
shortcut("x");
assert_eq!(instance.get_secret_text(), "hunter2", "Ctrl+X must not empty a password TextInput");

// Copy is disabled too, so the clipboard still holds "plain" and not the password.
shortcut("c");
instance.invoke_focus_plain();
shortcut("a");
shortcut("v");
assert_eq!(instance.get_plain_text(), "plain", "Ctrl+C must not put a password on the clipboard");
```
*/
