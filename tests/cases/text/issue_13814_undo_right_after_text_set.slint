const TestCase &instance = *handle;
slint_testing::send_mouse_click(&instance, 5., 5.);
assert(instance.get_input_focused());

slint_testing::send_keyboard_string_sequence(&instance, "change this text");
assert_eq(instance.get_test_text(), "change this text");

// The assignment discards the undo history, so the undo has nothing to undo.
instance.invoke_set_and_undo("changed");
assert_eq(instance.get_test_text(), "changed");
slint_testing::mock_elapsed_time(0);
assert_eq(instance.get_test_text(), "changed");

// Same for redo, with a redo item recorded against the previous text.
slint_testing::send_keyboard_string_sequence(&instance, " again");
assert_eq(instance.get_test_text(), "changed again");
instance.invoke_do_undo();
assert_eq(instance.get_test_text(), "changed");
instance.invoke_set_and_redo("x");
assert_eq(instance.get_test_text(), "x");
```
