export component TestCase inherits TextInput {
    font-family: "FixedTestFont";
    font-size: 10px;
    width: 300phx;
    height: 100phx;
    in-out property<string> test_text <=> self.text;
    in-out property<int> test_cursor_pos: self.cursor_position_byte_offset;
    in-out property<int> test_anchor_pos: self.anchor_position_byte_offset;
    in-out property<bool> input_focused: self.has_focus;
}

/*
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};

let instance = TestCase::new().unwrap();
assert!(instance.get_input_focused());
instance.set_test_text("Lorem Ipsum Dolor Sit".into());

// What the Android backend calls when its long-press timer fires.
let long_press = || {
    let window = i_slint_core::window::WindowInner::from_pub(instance.window());
    let focus_item = window.focus_item.borrow().upgrade().unwrap();
    let text_input = focus_item.downcast::<i_slint_core::items::TextInput>().unwrap();
    text_input.as_pin_ref().select_word_on_long_press(&window.window_adapter(), &focus_item);
};

instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(70.0, 6.0), button: PointerEventButton::Left });
assert_eq!(instance.get_test_anchor_pos(), 7);
assert_eq!(instance.get_test_cursor_pos(), 7);
long_press();
assert_eq!(instance.get_test_anchor_pos(), 6);
assert_eq!(instance.get_test_cursor_pos(), 11);

// The finger trembles inside the word: the word stays selected.
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(75.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 6);
assert_eq!(instance.get_test_cursor_pos(), 11);

// Dragging extends the selection by whole words, in both directions.
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(140.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 6);
assert_eq!(instance.get_test_cursor_pos(), 17);
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(75.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 6);
assert_eq!(instance.get_test_cursor_pos(), 11);
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(30.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 11);
assert_eq!(instance.get_test_cursor_pos(), 0);

instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(30.0, 6.0), button: PointerEventButton::Left });
slint_testing::mock_elapsed_time(1000);

// The finger drifts into the next word before the long press fires: the word where it
// pressed gets selected.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(105.0, 6.0), button: PointerEventButton::Left });
assert_eq!(instance.get_test_cursor_pos(), 10);
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(125.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 10);
assert_eq!(instance.get_test_cursor_pos(), 12);
long_press();
assert_eq!(instance.get_test_anchor_pos(), 6);
assert_eq!(instance.get_test_cursor_pos(), 11);
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(125.0, 6.0), button: PointerEventButton::Left });
slint_testing::mock_elapsed_time(1000);

// A triple press keeps its paragraph selection.
instance.set_test_text("Hello world.\nNext".into());
for _ in 0..2 {
    instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(30.0, 6.0), button: PointerEventButton::Left });
    instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(30.0, 6.0), button: PointerEventButton::Left });
}
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(30.0, 6.0), button: PointerEventButton::Left });
let paragraph = (instance.get_test_anchor_pos(), instance.get_test_cursor_pos());
assert_eq!(paragraph.0, 0);
long_press();
assert_eq!((instance.get_test_anchor_pos(), instance.get_test_cursor_pos()), paragraph);
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(30.0, 6.0), button: PointerEventButton::Left });
slint_testing::mock_elapsed_time(1000);
instance.set_test_text("Lorem Ipsum Dolor Sit".into());

// Without a held press, the long press only selects the word.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(140.0, 6.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(140.0, 6.0), button: PointerEventButton::Left });
long_press();
assert_eq!(instance.get_test_anchor_pos(), 12);
assert_eq!(instance.get_test_cursor_pos(), 17);
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(30.0, 6.0) });
assert_eq!(instance.get_test_anchor_pos(), 12);
assert_eq!(instance.get_test_cursor_pos(), 17);
```
*/
