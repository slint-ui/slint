// Moving the cursor panicked when the line-height factor's binding measured text
// while the font context was borrowed.

export component TestCase inherits Window {
    width: 200phx;
    height: 100phx;
    in property <length> font-size: 10px;
    out property <int> cursor-pos: input.cursor-position-byte-offset;

    public function focus-input() {
        input.focus();
    }

    reference := Text {
        text: "reference";
        font-size: root.font-size;
    }

    input := TextInput {
        text: "hello";
        line-height-factor: reference.preferred-height / 10px;
    }
}

/*
```rust
use slint::platform::Key;
use slint::SharedString;

let instance = TestCase::new().unwrap();
instance.invoke_focus_input();
instance.set_font_size(20.);
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::RightArrow));
assert_eq!(instance.get_cursor_pos(), 1);
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
instance.invoke_focus_input();
instance.set_font_size(20.);
slint_testing::send_keyboard_string_sequence(&instance, slint::platform::key_codes::RightArrow);
assert_eq(instance.get_cursor_pos(), 1);
```
