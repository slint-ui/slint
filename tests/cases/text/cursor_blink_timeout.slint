export component TestCase inherits Window {
    width: 100phx;
    height: 100phx;

    ti := TextInput {
        text: "Hello";
    }

    out property <bool> input-focused: ti.has-focus;
}

/*
```rust
use i_slint_core::input::{InternalKeyEvent, KeyEventType};
use slint::platform::{Key, WindowEvent};
use slint::SharedString;

let instance = TestCase::new().unwrap();
let window = i_slint_core::window::WindowInner::from_pub(instance.window());
let cursor_visible = || {
    let item = window.focus_item.borrow().upgrade().unwrap();
    let text_input = item.downcast::<i_slint_core::items::TextInput>().unwrap();
    let visible = text_input.as_pin_ref().cursor_visible();
    visible
};
// Whether the cursor showed at every step of 250 ms over the given time. Every step is taken
// (not just up to the first one with the cursor off), and the time advances in steps because a
// timer that is overdue by several periods fires only once.
let visible_throughout = |ms: u64| {
    (0..ms / 250).fold(true, |all_visible, _| {
        slint_testing::mock_elapsed_time(250);
        cursor_visible() && all_visible
    })
};

slint_testing::send_mouse_click(&instance, 50., 50.);
assert!(instance.get_input_focused());
assert!(!visible_throughout(2000), "the cursor blinks");

// It blinks for a while when nothing happens (GTK's gtk-cursor-blink-timeout is 10 s) ...
assert!(!visible_throughout(7000), "the cursor still blinks after 9 s");

// ... and then stays visible, with no timer left that wakes the window up.
let _ = visible_throughout(3000);
assert!(visible_throughout(5000), "the cursor is steady after the timeout");
assert!(slint::platform::duration_until_next_timer_update().is_none(), "no timer keeps running");

// Moving the cursor starts the blinking again.
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::LeftArrow));
assert!(!visible_throughout(2000), "the cursor blinks after it moved");

// So does typing, and the timeout starts over.
let _ = visible_throughout(9000);
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from("a"));
assert!(!visible_throughout(9000), "the timeout started over with typing");
let _ = visible_throughout(3000);
assert!(visible_throughout(2000));

// Every other way of editing or moving the cursor starts the blinking again, too.
let ctrl_key = |key: &str, shift: bool| {
    slint_testing::send_keyboard_char(&instance, Key::Control.into(), true);
    if shift {
        slint_testing::send_keyboard_char(&instance, Key::Shift.into(), true);
    }
    slint_testing::send_keyboard_string_sequence(&instance, key);
    slint_testing::send_keyboard_char(&instance, Key::Control.into(), false);
    if shift {
        slint_testing::send_keyboard_char(&instance, Key::Shift.into(), false);
    }
};
let compose = |event_type: KeyEventType, text: &str| {
    let mut event = InternalKeyEvent::default();
    event.event_type = event_type;
    if event_type == KeyEventType::CommitComposition {
        event.key_event.text = text.into();
    } else {
        event.preedit_text = text.into();
    }
    instance.window().dispatch_event(WindowEvent::internal(event));
};
slint_testing::send_keyboard_char(&instance, Key::Shift.into(), true);
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::LeftArrow));
slint_testing::send_keyboard_char(&instance, Key::Shift.into(), false);
let actions: [(&str, &dyn Fn()); 7] = [
    ("cut", &|| ctrl_key("x", false)),
    ("a click", &|| slint_testing::send_mouse_click(&instance, 1., 5.)),
    ("a composition", &|| compose(KeyEventType::UpdateComposition, "ka")),
    ("a committed composition", &|| compose(KeyEventType::CommitComposition, "か")),
    ("paste", &|| ctrl_key("v", false)),
    ("undo", &|| ctrl_key("z", false)),
    ("redo", &|| ctrl_key("z", true)),
];
for (name, action) in actions {
    let _ = visible_throughout(11000);
    assert!(visible_throughout(1000), "the cursor is steady before {name}");
    action();
    assert!(!visible_throughout(2000), "the cursor blinks after {name}");
}
```
*/
