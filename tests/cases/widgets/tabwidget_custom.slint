import { TabWidget } from "std-widgets.slint";
import { TabHeaderBase, TabBarBase } from "../../../tools/editor/controls/src/headless.slint";

component BadgeHeader inherits TabHeaderBase {
    min-width: 120px;
    min-height: 40px;
    background << Rectangle {
        background: root.selected ? #dbeafe : root.hovered ? #e2e8f0 : #f1f5f9;
        border-width: root.focused ? 2px : 0px;
        border-color: #2468cf;
        border-radius: 6px;
    }
    content << HorizontalLayout {
        padding: 8px;
        Text { text: root.title; color: root.enabled ? #1e293b : #94a3b8; }
        Text { text: "3"; color: #2468cf; }
    }
}

component CustomBar inherits TabBarBase {
    Flickable {
        FlexboxLayout {
            flex-direction: root.orientation == Orientation.horizontal ? row : column;
            flex-wrap: no-wrap;
            spacing: 8px;
            @children
        }
    }
}

export component TestCase inherits Window {
    width: 560px;
    height: 340px;
    in-out property <int> current-index <=> tabs.current-index;
    out property <int> panel-inits;
    out property <string> edit-text: field.text;
    out property <bool> field-focused: field.has-focus;
    out property <bool> test: root.current-index == 0 && root.panel-inits == 3;
    public function focus-tabs() { custom-bar.focus(); }
    public function edit() { field.text = "Preserved value"; }

    tabs := TabWidget {
        x: 20px;
        y: 20px;
        width: 520px;
        height: 280px;
        orientation: horizontal;
        bar << custom-bar := CustomBar { }
        Tab {
            title: "General";
            header << BadgeHeader { }
            Rectangle {
                init => { root.panel-inits += 1; }
                field := TextInput { text: "Initial value"; }
            }
        }
        Tab {
            title: "Downloads";
            header << BadgeHeader { }
            Rectangle { init => { root.panel-inits += 1; } }
        }
        Tab {
            title: "Editor";
            header << BadgeHeader { }
            Rectangle {
                init => { root.panel-inits += 1; }
                Text { text: "Editor settings"; }
            }
        }
    }
}

/*
```rust
