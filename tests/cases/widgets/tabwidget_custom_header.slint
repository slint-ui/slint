import { TabWidget } from "std-widgets.slint";
import { TabHeaderBase, TabBarLayoutBase } from "../../../tools/editor/controls/src/headless.slint";

component Pages inherits TabWidget {
    orientation: vertical;
    bar << TabBarLayoutBase { }
    Tab {
        title: "First custom";
        header << heading := TabHeaderBase {
            min-width: 120px;
            min-height: 40px;
            content << Text { text: heading.title; }
        }
        Rectangle { min-width: 80px; min-height: 60px; }
    }
    Tab { title: "Middle standard"; }
    Tab { title: "Last standard"; }
}

export component TestCase inherits Window {
    width: 500px;
    height: 300px;
    out property <int> current-index: tabs.current-index;
    out property <bool> test: tabs.current-index == 0;
    tabs := Pages { }
}

/*
```rust
