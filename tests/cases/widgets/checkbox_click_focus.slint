// C++ live preview: no element search (wrapper has no item tree)
//ignore: cpp-live-preview

import { CheckBox, LineEdit } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 200px;
    height: 100px;
    forward-focus: line-edit;

    out property <string> typed: line-edit.text;
    out property <bool> box-focused: checkbox.has-focus;
    out property <bool> edit-focused: line-edit.has-focus;
    in-out property <bool> checked <=> checkbox.checked;

    line-edit := LineEdit {
        x: 0px;
        y: 0px;
        width: 200px;
        height: 40px;
    }

    checkbox := CheckBox {
        x: 0px;
        y: 50px;
        width: 200px;
        height: 40px;
        text: "Click";
    }
}

/*
```rust
use slint::platform::PointerEventButton;

let instance = TestCase::new().unwrap();
assert!(!instance.get_box_focused());

slint_testing::send_keyboard_string_sequence(&instance, "a");
assert_eq!(instance.get_typed().as_str(), "a");
assert!(instance.get_edit_focused());

let checkbox = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::checkbox")
    .next()
    .unwrap();
checkbox.mock_single_click(PointerEventButton::Left);

assert!(instance.get_checked());
assert!(instance.get_box_focused(), "click should move focus to the CheckBox");
assert!(!instance.get_edit_focused());

slint_testing::send_keyboard_string_sequence(&instance, "b");
assert_eq!(instance.get_typed().as_str(), "a");
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(!instance.get_box_focused());

slint_testing::send_keyboard_string_sequence(&instance, "a");
assert_eq(instance.get_typed(), "a");
assert(instance.get_edit_focused());

slint_testing::send_mouse_click(&instance, 100., 70.);
assert(instance.get_checked());
assert(instance.get_box_focused());
assert(!instance.get_edit_focused());

slint_testing::send_keyboard_string_sequence(&instance, "b");
assert_eq(instance.get_typed(), "a");
```
*/
