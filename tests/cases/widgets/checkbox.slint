/*
```rust
fn styled_control_uses_shared_activation() {
    use slint::platform::{Key, WindowEvent};

    let instance = TestCase::new().unwrap();
    if !instance.get_uses_shared_input() {
        return;
    }
    instance.invoke_focus_control();
    instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Return.into() });
    instance.window().dispatch_event(WindowEvent::KeyPressRepeated { text: Key::Return.into() });
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Return.into() });
    assert_eq!(instance.get_checked(), false);
    assert_eq!(instance.get_toggled(), "");

    instance.window().dispatch_event(WindowEvent::KeyPressed { text: Key::Space.into() });
    assert_eq!(instance.get_checked(), false);
    instance.window().dispatch_event(WindowEvent::KeyReleased { text: Key::Space.into() });
    assert_eq!(instance.get_checked(), true);
    assert_eq!(instance.get_toggled(), "a");
}

styled_control_uses_shared_activation();
```
