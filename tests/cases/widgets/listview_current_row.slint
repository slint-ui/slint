// The current row is the topmost row, even when it's only partly visible.
// The item offset is that row's top relative to the list's top edge.
// Some styles inset the visible area, so the expected offsets add `visible-y`.
// Rows from 10 on have differing heights, which changes the ListView's estimated row height.

import { ListView } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 100px;
    height: 200px;

    in-out property <length> content-y <=> list.content-y;
    out property <int> current-row: list.current-row;
    out property <length> item-offset: list.item-offset;
    out property <length> visible-y: list.visible-y;
    out property <int> changed-row: -2;
    out property <int> changes;
    // The row hit by the last click, and its top relative to the list
    out property <int> clicked-row: -1;
    out property <length> clicked-row-y;

    list := ListView {
        changed current-row => {
            root.changed-row = self.current-row;
            root.changes += 1;
        }

        for i in 100: Rectangle {
            height: i < 10 ? 50px : (i.mod(3) + 1) * 30px;
            TouchArea {
                clicked => {
                    root.clicked-row = i;
                    root.clicked-row-y = parent.absolute-position.y - list.absolute-position.y;
                }
            }
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();

// A click lays out the ListView, and the elapsed time runs the `changed` handler.
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 0);
assert_eq!(instance.get_item_offset(), instance.get_visible_y());
assert_eq!(instance.get_changed_row(), 0);
assert_eq!(instance.get_changes(), 1);

// Row 2 starts 25px above the viewport.
instance.set_content_y(-125.);
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 2);
assert_eq!(instance.get_item_offset(), instance.get_visible_y() - 25.);
assert_eq!(instance.get_changed_row(), 2);
assert_eq!(instance.get_changes(), 2);

// Scrolling within row 2 doesn't change the current row.
instance.set_content_y(-140.);
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 2);
assert_eq!(instance.get_item_offset(), instance.get_visible_y() - 40.);
assert_eq!(instance.get_changes(), 2);

// Scroll with the wheel across the rows with differing heights.
// After each step, the current row is the row at the top edge, and the item offset is its top.
let mut partly_visible = false;
for _ in 0..40 {
    instance.window().dispatch_event(slint::platform::WindowEvent::PointerScrolled {
        position: slint::LogicalPosition::new(5., 100.),
        delta_x: 0.,
        delta_y: -37.,
    });
    slint_testing::mock_elapsed_time(500);
    slint_testing::send_mouse_click(&instance, 5., instance.get_visible_y() + 0.5);
    slint_testing::mock_elapsed_time(1);
    assert_eq!(instance.get_current_row(), instance.get_clicked_row());
    assert_eq!(instance.get_item_offset(), instance.get_clicked_row_y());
    assert!(instance.get_item_offset() <= instance.get_visible_y());
    partly_visible |= instance.get_item_offset() < instance.get_visible_y();
}
assert!(partly_visible);
assert!(instance.get_current_row() > 15, "{}", instance.get_current_row());
```

