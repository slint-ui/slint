/*
Test dynamic tab creation where panel has local property used in title
*/

import { TabWidget } from "std-widgets.slint";
export component TestCase inherits Window {
    width: 300px;
    height: 300px;
    property <[string]> tabs: ["A", "B", "C"];
    TabWidget {
        for t in tabs: Tab {
            property <string> extra: t + "!";
            title: self.extra;
        }
    }
    property <bool> test: true;
}
