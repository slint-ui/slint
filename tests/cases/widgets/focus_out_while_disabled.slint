// A widget that loses the focus while disabled must not report `has-focus` once re-enabled.

import { Button, CheckBox, Slider } from "std-widgets.slint";
export component TestCase inherits Window {
    in-out property <bool> enabled: true;
    out property <bool> checkbox-has-focus: checkbox.has-focus;
    out property <bool> button-has-focus: button.has-focus;
    out property <bool> slider-has-focus: slider.has-focus;

    public function focus-checkbox() {
        checkbox.focus();
    }
    public function focus-button() {
        button.focus();
    }
    public function focus-slider() {
        slider.focus();
    }
    public function focus-other() {
        other.focus();
    }

    VerticalLayout {
        checkbox := CheckBox {
            text: "CheckBox";
            enabled: root.enabled;
        }
        button := Button {
            text: "Button";
            enabled: root.enabled;
        }
        slider := Slider {
            enabled: root.enabled;
        }
        other := FocusScope { }
    }
}

