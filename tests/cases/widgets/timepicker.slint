assert_eq!(result.len(), 1);
let button = result.pop().unwrap();

button.invoke_accessible_default_action();
assert_eq!(instance.get_timepicker_created(), true);
```

```rust
let instance = TestCase::new().unwrap();
instance.set_time(Time{ hour: 8, minute: 5, ..Default::default()});

let button = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::b").next().unwrap();
button.invoke_accessible_default_action();

// Minutes have two digits
let minute = slint_testing::ElementHandle::find_by_accessible_label(&instance, "minute").collect::<Vec<_>>();
assert_eq!(minute.len(), 1);
assert_eq!(minute[0].accessible_value().unwrap(), "05");
```

```cpp
using slint_testing::mock_elapsed_time;

auto instance = TestCase::create();

instance->set_time(Time{ .hour = 8, .minute = 45, .second = 0});

auto result = slint::testing::ElementHandle::find_by_element_id(instance, "TestCase::b");
auto button = result[0];

button.invoke_accessible_default_action();

assert_eq(instance->get_timepicker_created(), true);
```

```rust
use slint::{LogicalPosition, platform::PointerEventButton};

let instance = TestCase::new().unwrap();
instance.set_time(Time { hour: 8, minute: 30, ..Default::default() });
slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::b").next().unwrap().invoke_accessible_default_action();

let find = |label: &str| {
    let mut found: Vec<_> = slint_testing::ElementHandle::find_by_accessible_label(&instance, label).collect();
    assert_eq!(found.len(), 1, "{label}");
    found.pop().unwrap()
};
let center = |e: &slint_testing::ElementHandle| {
    let (p, s) = (e.absolute_position(), e.size());
    LogicalPosition::new(p.x + s.width / 2., p.y + s.height / 2.)
};

let minute = find("minute");
minute.mock_single_click(PointerEventButton::Left);

let selector_0 = center(&find("0 Hours or minutes of 60"));
let selector_30 = center(&find("30 Hours or minutes of 60"));
let clock_center = LogicalPosition::new(selector_0.x, (selector_0.y + selector_30.y) / 2.);
let radius = (selector_30.y - selector_0.y) / 2.;
let position_of = |minute: f32| {
    let angle = minute / 60. * std::f32::consts::TAU - std::f32::consts::FRAC_PI_2;
    LogicalPosition::new(clock_center.x + radius * angle.cos(), clock_center.y + radius * angle.sin())
};

// Dragging the hand from 15 selects the minute closest to where it's released.
find("15 Hours or minutes of 60").mock_drag(position_of(17.2), PointerEventButton::Left);
assert_eq!(minute.accessible_value().unwrap(), "17");

find("45 Hours or minutes of 60").mock_drag(position_of(57.8), PointerEventButton::Left);
assert_eq!(minute.accessible_value().unwrap(), "58");

// Clicking a label selects the minute at its angle.
find("20 Hours or minutes of 60").mock_single_click(PointerEventButton::Left);
assert_eq!(minute.accessible_value().unwrap(), "20");
```
*/
