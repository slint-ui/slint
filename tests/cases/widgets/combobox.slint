import { ComboBox } from "std-widgets.slint";
export component TestCase inherits Window {
    width: 200px;
    height: 200px;

    in-out property <string> output;
    in property <bool> show: false;
    TouchArea {
        clicked => { output += "clicked-under\n"; }
    }

    VerticalLayout {
        alignment: center;
        box := ComboBox {
            model: ["Aaa", "Bbb", "Ccc"];
            selected => {
                output += "selected("+self.current-value+","+self.current-index+")\n";
            }
        }
    }

    if root.show : Rectangle {
        test-no-loop := ComboBox {
            width: 10 * self.height; // Test that there is no height for width dependency (loop)
        }
    }

    // `current-value` set declaratively at instantiation replaces the default binding and
    // never fires `changed current-value`, so the reverse lookup must also run from `init`
    // for this to resolve `current-index` consistently with an imperative write.
    // Positioned off the visible 200x200 window so they can't intercept the coordinate-based
    // mouse clicks the rest of this test sends to `box`.
    init-value-found := ComboBox {
        x: 300px;
        model: ["Aaa", "Bbb", "Ccc"];
        current-value: "Bbb";
    }
    init-value-not-found := ComboBox {
        x: 300px;
        y: 100px;
        model: ["Aaa", "Bbb", "Ccc"];
        current-value: "nope";
    }

    public function unfocus() {
        box.clear-focus();
    }

    in-out property current-index <=> box.current-index;
    in-out property current-value <=> box.current-value;
    in-out property model <=> box.model;
    out property has-focus <=> box.has-focus;
    out property init-value-found-index <=> init-value-found.current-index;
    out property init-value-found-value <=> init-value-found.current-value;
    out property init-value-not-found-index <=> init-value-not-found.current-index;
    out property init-value-not-found-value <=> init-value-not-found.current-value;
}

/*


```rust
use std::rc::Rc;
use slint::{platform::WindowEvent, platform::Key, VecModel, SharedString, LogicalPosition};
use i_slint_backend_testing::mock_elapsed_time;

let instance = TestCase::new().unwrap();

assert_eq!(instance.get_current_value(), "Aaa");
assert_eq!(instance.get_current_index(), 0);
assert_eq!(instance.get_has_focus(), false);

let mut combobox_search = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::box");
let combobox = combobox_search.next().unwrap();
assert_eq!(combobox.accessible_expandable(), Some(true));
assert_eq!(combobox.accessible_expanded(), Some(false));
assert_eq!(combobox.accessible_value(), Some(SharedString::from("Aaa")));

let assert_selection = |index: i32, value: &str| {
    assert_eq!(instance.get_current_index(), index);
    assert_eq!(instance.get_current_value(), value);
    assert_eq!(combobox.accessible_value(), Some(SharedString::from(value)));
};

// Change the index programmatically
instance.set_current_index(1);
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "");

instance.set_current_index(0);
assert_selection(0, "Aaa");
assert_eq!(instance.get_output(), "");
assert_eq!(instance.get_has_focus(), false);

// Open the combobox
slint_testing::send_mouse_click(&instance, 100., 100.);
assert_eq!(instance.get_output(), "");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(true));

// click outside of the combobox, this should close it
slint_testing::send_mouse_click(&instance, 100., 10.);
assert_eq!(instance.get_output(), "");
assert_selection(0, "Aaa");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(false));

// click outside of the combobox again
slint_testing::send_mouse_click(&instance, 100., 10.);
assert_eq!(instance.get_output(), "clicked-under\n");
instance.set_output(Default::default());
assert_selection(0, "Aaa");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(false));


// The arrow change the values
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::DownArrow));
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "selected(Bbb,1)\n");
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::DownArrow));
assert_selection(2, "Ccc");
assert_eq!(instance.get_output(), "selected(Bbb,1)\nselected(Ccc,2)\n");
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::UpArrow));
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "selected(Bbb,1)\nselected(Ccc,2)\nselected(Bbb,1)\n");
instance.set_output(Default::default());

// show the popup
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Return));
assert_eq!(instance.get_output(), "");
assert_eq!(combobox.accessible_expanded(), Some(true));
// click outside causes the popup to close
slint_testing::send_mouse_click(&instance, 100., 10.);
assert_eq!(instance.get_output(), "");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(false));
slint_testing::send_mouse_click(&instance, 100., 10.);
assert_eq!(instance.get_output(), "clicked-under\n");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(false));
instance.set_output(Default::default());

instance.set_current_index(0);


// show the popup
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Return));
// The arrow change the values while the popup is shown
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::DownArrow));
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "selected(Bbb,1)\n");
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::DownArrow));
assert_selection(2, "Ccc");
assert_eq!(instance.get_output(), "selected(Bbb,1)\nselected(Ccc,2)\n");
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::UpArrow));
assert_eq!(instance.get_current_value(), "Bbb");
assert_eq!(instance.get_current_index(), 1);
assert_eq!(combobox.accessible_value(), Some(SharedString::from("Bbb")));
assert_eq!(instance.get_output(), "selected(Bbb,1)\nselected(Ccc,2)\nselected(Bbb,1)\n");
// close the popup
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Escape));
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "selected(Bbb,1)\nselected(Ccc,2)\nselected(Bbb,1)\n");
instance.set_output(Default::default());
slint_testing::send_mouse_click(&instance, 100., 10.);
assert_eq!(instance.get_output(), "clicked-under\n");
assert_eq!(combobox.accessible_expanded(), Some(false));
assert_eq!(instance.get_has_focus(), true);
instance.set_output(Default::default());


// The accessible expand action should open the popup
combobox.invoke_accessible_expand_action();
assert_eq!(instance.get_output(), "");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(true));
// close the popup
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Escape));
assert_eq!(instance.get_output(), "");
assert_eq!(instance.get_has_focus(), true);
assert_eq!(combobox.accessible_expanded(), Some(false));

// Scroll with the wheel
let wheel_change_value = !module_path!().contains("cupertino");
instance.set_output(Default::default());
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(100.0, 100.0), delta_x: 0.0, delta_y: 20.0 });
if wheel_change_value {
    assert_selection(0, "Aaa");
    assert_eq!(instance.get_output(), "selected(Aaa,0)\n");
} else {
    assert_selection(1, "Bbb");
    assert_eq!(instance.get_output(), "");
}
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(100.0, 100.0), delta_x: 0.0, delta_y: -5.0 });
assert_eq!(instance.get_has_focus(), true);
assert_selection(1, "Bbb");
if wheel_change_value {
    assert_eq!(instance.get_output(), "selected(Aaa,0)\nselected(Bbb,1)\n");
}
// When not having focus, do nothing
instance.invoke_unfocus();
instance.set_output(Default::default());
assert_eq!(instance.get_has_focus(), false);
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(100.0, 100.0), delta_x: 0.0, delta_y: 20.0 });
assert_selection(1, "Bbb");
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(100.0, 100.0), delta_x: 0.0, delta_y: -5.0 });
assert_eq!(instance.get_has_focus(), false);
assert_selection(1, "Bbb");
assert_eq!(instance.get_output(), "");
slint_testing::send_keyboard_string_sequence(&instance, "\t");
assert_eq!(instance.get_has_focus(), true);

// Set current-index to -1
instance.set_current_index(-1);
mock_elapsed_time(500);
assert_selection(-1, "");

// Replace model
instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("A"), SharedString::from("B")])).into());
mock_elapsed_time(500);
assert_selection(0, "A");

// Model replacement preserves current-index when it's still valid in the new model
instance.set_current_index(1);
mock_elapsed_time(500);
assert_selection(1, "B");

// Replace with a 3-item model - index 1 is still valid, so it must be preserved (not reset to 0)
instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("X"), SharedString::from("Y"), SharedString::from("Z")])).into());
mock_elapsed_time(500);
assert_selection(1, "Y");

// Select the last index and replace with a two-item model - index 2 is not valid anymore, so it should be clamped to 1
instance.set_current_index(2);
mock_elapsed_time(500);
assert_selection(2, "Z");

instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("X"), SharedString::from("Y")])).into());
mock_elapsed_time(500);
assert_selection(1, "Y");

// Set an empty model, this should reset the current-index to 0 and current-value to ""
instance.set_model(Rc::new(VecModel::default()).into());
mock_elapsed_time(500);
assert_selection(0, "");

// With the model still empty, set current-index from Rust. The widget must
// accept the write (current-value stays "" because the model is empty), and
// when a non-empty model arrives the user-supplied index must be preserved
// rather than clobbered by the reset-on-model-change handler. This is the
// "set index before model is populated" path that was a race condition in
// older versions (see https://github.com/slint-ui/slint/issues/10805).
instance.set_current_index(2);
mock_elapsed_time(500);
assert_selection(2, "");

instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("A"), SharedString::from("B"), SharedString::from("C"), SharedString::from("D")])).into());
mock_elapsed_time(500);
assert_selection(2, "C");

// And the symmetric order — set_model then set_current_index in adjacent
// calls — which is the exact reproducer from #7632. The earlier model-swap
// assertions cover this implicitly; this block re-states it verbatim using
// the values from the original bug report.
instance.set_model(Rc::new(VecModel::from_slice(&[
    SharedString::from("not this1"),
    SharedString::from("not this2"),
    SharedString::from("!!!THIS!!!"),
    SharedString::from("not this3"),
    SharedString::from("not this4"),
])).into());
instance.set_current_index(2);
mock_elapsed_time(500);
assert_selection(2, "!!!THIS!!!");

// A host write to `current-value` is a reverse lookup: it moves current-index to
// match. A successful lookup stays silent. See https://github.com/slint-ui/slint/issues/11970.
slint_testing::access_testing_window(instance.window(), |w| w.take_debug_log());
instance.set_current_value(SharedString::from("not this3"));
mock_elapsed_time(500);
assert_selection(3, "not this3");
let logs = slint_testing::access_testing_window(instance.window(), |w| w.take_debug_log());
assert!(logs.is_empty(), "expected no debug log on a successful reverse lookup, got: {logs:?}");

// A value not in the model resolves to no selection, and (unlike the case above) logs why.
instance.set_current_value(SharedString::from("nope"));
mock_elapsed_time(500);
assert_selection(-1, "");
let logs = slint_testing::access_testing_window(instance.window(), |w| w.take_debug_log());
assert_eq!(logs.len(), 1, "expected one debug log for a not-found current-value write, got: {logs:?}");
assert!(logs[0].contains("\"nope\""));
assert!(logs[0].contains("not in `model`"));

// A model swap after a host-written current-value doesn't re-trigger the lookup above:
// `changed model` already clamps current-index and re-derives current-value from it.
instance.set_current_value(SharedString::from("not this1"));
mock_elapsed_time(500);
assert_selection(0, "not this1");

instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("only"), SharedString::from("this")])).into());
mock_elapsed_time(500);
assert_selection(0, "only");

// Known limitation: the lookup only runs on an actual value change, so writing the value
// current-value already holds is a no-op, even though "select the first match" says it
// shouldn't be.
instance.set_model(Rc::new(VecModel::from_slice(&[
    SharedString::from(""),
    SharedString::from("dup"),
    SharedString::from("dup"),
])).into());
mock_elapsed_time(500);
assert_selection(0, "");
instance.set_current_index(-1);
mock_elapsed_time(500);
assert_selection(-1, "");
instance.set_current_value(SharedString::from(""));
mock_elapsed_time(500);
assert_selection(-1, "");

// A fresh write to a duplicate value (a real transition, from "" to "dup") picks the
// first occurrence: `index-of` finds index 1, not the later index 2.
instance.set_current_value(SharedString::from("dup"));
mock_elapsed_time(500);
assert_selection(1, "dup");

// Known limitation: the lookup only runs on an actual value change, so writing the value
// current-value already holds is a no-op, even though "select the first match" says it
// shouldn't be. Force a mismatched index first (2, the second "dup"), then re-write the
// same value: it stays at index 2 instead of moving to the first occurrence.
instance.set_current_index(2);
mock_elapsed_time(500);
assert_selection(2, "dup");
instance.set_current_value(SharedString::from("dup"));
mock_elapsed_time(500);
assert_selection(2, "dup");

// Consecutive writes to current-index and current-value: each write's `changed` handler
// resolves the other property to match before the next call returns, so there's no
// inherent priority between the two — whichever was written last determines the result.
// This is not a guaranteed contract, just how it behaves today; the assertions are here
// so a change to it surfaces as a test failure instead of going unnoticed.
instance.set_model(Rc::new(VecModel::from_slice(&[SharedString::from("Aaa"), SharedString::from("Bbb"), SharedString::from("Ccc")])).into());
instance.set_current_index(0);
mock_elapsed_time(500);
assert_selection(0, "Aaa");

// current-value written after current-index: current-value's resolution sticks.
instance.set_current_index(1);
instance.set_current_value(SharedString::from("Ccc"));
mock_elapsed_time(500);
assert_selection(2, "Ccc");

// current-index written after current-value: current-index's resolution sticks instead.
instance.set_current_value(SharedString::from("Aaa"));
instance.set_current_index(1);
mock_elapsed_time(500);
assert_selection(1, "Bbb");

// Declarative init-time consistency: `current-value` set at instantiation (which replaces
// the default `model[current-index]` binding and never fires `changed current-value`)
// resolves `current-index` from the model just like an imperative write does, instead of
// showing an unresolved value. See https://github.com/slint-ui/slint/issues/11970.
assert_eq!(instance.get_init_value_found_index(), 1);
assert_eq!(instance.get_init_value_found_value(), "Bbb");

// A declaratively-set current-value that isn't in the model clears the selection at init
// too, consistent with the imperative not-found case.
assert_eq!(instance.get_init_value_not_found_index(), -1);
assert_eq!(instance.get_init_value_not_found_value(), "");
```

*/
