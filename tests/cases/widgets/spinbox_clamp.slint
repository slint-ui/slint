// C++ live preview: no element search (wrapper has no item tree)
//ignore: cpp-live-preview

import { SpinBox } from "std-widgets.slint";
export component TestCase inherits Window {
    width: 100px;
    height: 100px;
    box := SpinBox {
        minimum: 0;
        maximum: 10;
        step-size: 3;
        value: 9;
    }

    forward-focus: box;
    callback edited <=> box.edited;
    in-out property <int> value <=> box.value;
    in-out property <bool> read-only <=> box.read-only;
    in-out property <bool> enabled <=> box.enabled;
    out property <bool> box-focused <=> box.has-focus;
}

/*

```rust
use slint::{LogicalPosition, platform::Key, platform::WindowEvent};
use std::cell::RefCell;
use std::rc::Rc;

let instance = TestCase::new().unwrap();

let edits = Rc::new(RefCell::new(Vec::new()));

instance.on_edited({
    let edits = edits.clone();
    move |val| {
    edits.borrow_mut().push(val);
}});

let mut spinbox_search = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::box");
let spinbox = spinbox_search.next().unwrap();

// The announced step is the one a step action applies
assert_eq!(spinbox.accessible_value_step(), Some(3.0));

// A step that would leave the range stops at the maximum
assert_eq!(instance.get_value(), 9);
spinbox.invoke_accessible_increment_action();
assert_eq!(instance.get_value(), 10);
assert_eq!(&*edits.borrow(), &[10_i32]);
edits.borrow_mut().clear();

// At the maximum the value stays put, and nothing is reported as edited
spinbox.invoke_accessible_increment_action();
assert_eq!(instance.get_value(), 10);
assert!(edits.borrow().is_empty());

// The same at the minimum
instance.set_value(2);
spinbox.invoke_accessible_decrement_action();
assert_eq!(instance.get_value(), 0);
assert_eq!(&*edits.borrow(), &[0_i32]);
edits.borrow_mut().clear();

spinbox.invoke_accessible_decrement_action();
assert_eq!(instance.get_value(), 0);
assert!(edits.borrow().is_empty());

// Setting a value beyond the range clamps it
spinbox.set_accessible_value("12");
assert_eq!(instance.get_value(), 10);
assert_eq!(&*edits.borrow(), &[10_i32]);
edits.borrow_mut().clear();

spinbox.set_accessible_value("-5");
assert_eq!(instance.get_value(), 0);
assert_eq!(&*edits.borrow(), &[0_i32]);
edits.borrow_mut().clear();

// A read-only SpinBox ignores all three actions
instance.set_read_only(true);
instance.set_value(5);
spinbox.invoke_accessible_increment_action();
spinbox.invoke_accessible_decrement_action();
spinbox.set_accessible_value("12");
assert_eq!(instance.get_value(), 5);
assert!(edits.borrow().is_empty());

// A disabled SpinBox ignores all three actions
instance.set_read_only(false);
instance.set_enabled(false);
instance.set_value(5);
spinbox.invoke_accessible_increment_action();
spinbox.invoke_accessible_decrement_action();
spinbox.set_accessible_value("12");
assert_eq!(instance.get_value(), 5);
assert!(edits.borrow().is_empty());

// The arrow keys stop at the bounds as well
instance.set_enabled(true);
instance.set_value(9);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert!(instance.get_box_focused());
edits.borrow_mut().clear();

slint_testing::send_keyboard_char(&instance, Key::UpArrow.into(), true);
assert_eq!(instance.get_value(), 10);
assert_eq!(&*edits.borrow(), &[10_i32]);
edits.borrow_mut().clear();

slint_testing::send_keyboard_char(&instance, Key::UpArrow.into(), true);
assert_eq!(instance.get_value(), 10);
assert!(edits.borrow().is_empty());

instance.set_value(1);
slint_testing::send_keyboard_char(&instance, Key::DownArrow.into(), true);
assert_eq!(instance.get_value(), 0);
assert_eq!(&*edits.borrow(), &[0_i32]);
edits.borrow_mut().clear();

slint_testing::send_keyboard_char(&instance, Key::DownArrow.into(), true);
assert_eq!(instance.get_value(), 0);
assert!(edits.borrow().is_empty());

// And so does the mouse wheel. This position happens to work with all styles
instance.set_value(9);
let position = LogicalPosition::new(35.0, 50.0);
instance.window().dispatch_event(WindowEvent::PointerMoved { position });
edits.borrow_mut().clear();

instance.window().dispatch_event(WindowEvent::PointerScrolled { position, delta_x: 0.0, delta_y: 50.0 });
assert_eq!(instance.get_value(), 10);
assert_eq!(&*edits.borrow(), &[10_i32]);
edits.borrow_mut().clear();

instance.window().dispatch_event(WindowEvent::PointerScrolled { position, delta_x: 0.0, delta_y: 50.0 });
assert_eq!(instance.get_value(), 10);
assert!(edits.borrow().is_empty());

instance.set_value(1);
instance.window().dispatch_event(WindowEvent::PointerScrolled { position, delta_x: 0.0, delta_y: -50.0 });
assert_eq!(instance.get_value(), 0);
assert_eq!(&*edits.borrow(), &[0_i32]);
edits.borrow_mut().clear();

instance.window().dispatch_event(WindowEvent::PointerScrolled { position, delta_x: 0.0, delta_y: -50.0 });
assert_eq!(instance.get_value(), 0);
assert!(edits.borrow().is_empty());
```

*/
