//ignore: cpp
//ignore: cpp-live-preview
//ignore: nodejs
//ignore: python
//ignore: style-cupertino
//ignore: style-qt

import { Button, CheckBox, RadioGroup, Switch, VerticalBox } from "std-widgets.slint";

export component TestCase inherits Window {
    out property <bool> button-focused: button.has-focus;
    out property <bool> checkbox-focused: checkbox.has-focus;
    out property <bool> switch-focused: switch.has-focus;
    out property <bool> radio-group-focused: radio-group.has-focus;

    VerticalBox {
        button := Button { text: "Button"; }
        checkbox := CheckBox { text: "CheckBox"; }
        switch := Switch { text: "Switch"; }
        radio-group := RadioGroup {
            RadioButton { text: "RadioButton"; }
        }
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton};
use slint::SharedString;

let instance = TestCase::new().unwrap();
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Tab));
assert!(instance.get_button_focused());

for (label, focused) in [
    ("CheckBox", TestCase::get_checkbox_focused as fn(&TestCase) -> bool),
    ("Switch", TestCase::get_switch_focused),
    ("RadioButton", TestCase::get_radio_group_focused),
] {
    let element = slint_testing::ElementHandle::find_by_accessible_label(&instance, label)
        .next()
        .unwrap();
    element.mock_single_click(PointerEventButton::Left);
    assert!(focused(&instance), "{label} did not gain pointer focus");
}
```
*/
