/*
Test dynamic tab creation with a panel-local property used in title
*/

import { TabWidget } from "std-widgets.slint";
export component TestCase inherits Window {
    width: 300px;
    height: 300px;
    property <[string]> tabs: ["A", "B", "C"];
    TabWidget {
        for t in tabs: Tab {
            property <string> extra: t + "!";
            title: self.extra;
// ><error{The 'title' of a Tab in an 'if' or 'for' can't use 'self.extra' from inside the Tab, use the model data or properties outside the Tab instead"}
        }
    }

    property <bool> test: true;
}
