import { TabWidget } from "std-widgets.slint";
import { TabBarLayoutBase, TabHeaderBase } from "../../../tools/editor/controls/src/headless.slint";

component AppTabs inherits TabWidget {
    in property <string> marker: "Default bar";
    in property <bool> compact;
    out property <length> header-gap: 8px;
    callback ready();
    callback bar-ready();
    init => { root.ready(); }
    states [
        compact when root.compact: { header-gap: 2px; }
    ]
    bar << TabBarLayoutBase {
        init => { root.bar-ready(); }
        spacing: root.header-gap;
        background << Text { text: root.marker + " gap " + root.header-gap / 1px; }
    }
}

component VerticalTabs inherits AppTabs {
    orientation: vertical;
}

component PassThroughTabs inherits VerticalTabs { }

export component TestCase inherits Window {
    width: 700px;
    height: 400px;
    in-out property <bool> compact;
    in-out property <string> marker: "First bar";
    out property <int> first-index: first.current-index;
    out property <int> second-index: second.current-index;
    out property <length> header-gap: first.header-gap;
    out property <int> instances;
    out property <int> bars;

    first := PassThroughTabs {
        x: 20px; y: 20px; width: 300px; height: 300px;
        compact: root.compact;
        marker: root.marker;
        ready => { root.instances += 1; }
        bar-ready => { root.bars += 1; }
        Tab {
            title: "First A";
            header << TabHeaderBase { min-width: 100px; min-height: 40px; }
            Text { text: "First page"; }
        }
        Tab {
            title: "First B";
            header << TabHeaderBase { min-width: 100px; min-height: 40px; }
            Text { text: "Second page"; }
        }
    }
    second := AppTabs {
        x: 350px; y: 20px; width: 300px; height: 300px;
        ready => { root.instances += 1; }
        bar-ready => { root.bars += 1; }
        bar << TabBarLayoutBase {
            background << Text { text: "Overridden bar"; }
        }
        Tab { title: "Second A"; Text { text: "First page"; } }
        Tab { title: "Second B"; Text { text: "Second page"; } }
    }
}

