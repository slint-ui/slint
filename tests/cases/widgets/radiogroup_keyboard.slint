assert(instance->get_test());
slint_testing::send_keyboard_string_sequence(&*instance, slint::SharedString(slint::platform::key_codes::Tab));
assert(instance->get_has_focus());
slint_testing::send_keyboard_char(&*instance, " ", true);
assert(instance->get_current_value() == "First");
assert(instance->get_selected_count() == 1);
slint_testing::send_keyboard_char(&*instance, " ", false);
assert(instance->get_selected_count() == 1);
slint_testing::send_keyboard_string_sequence(&*instance, slint::SharedString(slint::platform::key_codes::Tab));
slint_testing::send_keyboard_char(&*instance, slint::SharedString(slint::platform::key_codes::Return), true);
assert(instance->get_current_value() == "Second");
assert(instance->get_selected_count() == 2);
slint_testing::send_keyboard_char(&*instance, slint::SharedString(slint::platform::key_codes::Return), false);
assert(instance->get_selected_count() == 2);
```
