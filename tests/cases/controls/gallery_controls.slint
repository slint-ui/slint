import { GalleryCheckBox, GallerySwitch, GalleryRadioGroup } from "../../../examples/headless-controls-gallery/components/selection-controls.slint";
import { GallerySlider } from "../../../examples/headless-controls-gallery/components/slider.slint";

export component TestCase inherits Window {
    width: 240px;
    height: 240px;
    in-out property <bool> enabled: true;
    in-out property <bool> read-only: false;
    in-out property <bool> checked <=> checkbox.checked;
    in-out property <bool> switched <=> toggle.checked;
    in-out property <string> selected-value <=> group.selected-value;
    in-out property <float> value <=> slider.value;
    out property <bool> slider-focused: slider.has-focus;
    out property <int> toggles;
    out property <int> selections;
    out property <int> changes;
    out property <int> releases;

    public function focus-checkbox() { checkbox.focus(); }
    public function focus-slider() { slider.focus(); }
    public function set-value(value: float) { slider.set-value(value); }
    public function select(value: string) { group.select(value); }

    VerticalLayout {
        checkbox := GalleryCheckBox {
            text: "Notifications";
            enabled: root.enabled;
            read-only: root.read-only;
            toggled => { root.toggles += 1; }
        }
        toggle := GallerySwitch {
            text: "Live updates";
            enabled: root.enabled;
            toggled => { root.toggles += 1; }
        }
        group := GalleryRadioGroup {
            text: "Density";
            enabled: root.enabled;
            read-only: root.read-only;
            selected-value: "comfortable";
            selected(_) => { root.selections += 1; }
        }
        slider := GallerySlider {
            text: "Volume";
            enabled: root.enabled;
            minimum: 0;
            maximum: 100;
            step: 5;
            value: 50;
            changed(_) => { root.changes += 1; }
            released(_) => { root.releases += 1; }
        }
    }
}

