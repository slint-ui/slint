```rust
fn selection_controls_delegate_state_and_expose_one_accessible_target() {
    use slint::{SharedString, platform::{Key, PointerEventButton}};
    use slint_testing::{AccessibleRole, ElementHandle};
    let instance = TestCase::new().unwrap();
    for (label, role) in [
        ("Notifications", AccessibleRole::Checkbox),
        ("Live updates", AccessibleRole::Switch),
        ("Density", AccessibleRole::RadioGroup),
        ("Comfortable", AccessibleRole::RadioButton),
        ("Compact", AccessibleRole::RadioButton),
    ] {
        let elements: Vec<_> = ElementHandle::find_by_accessible_label(&instance, label).collect();
        assert_eq!(elements.len(), 1, "{label}");
        assert_eq!(elements[0].accessible_role(), Some(role), "{label}");
    }
    let checkbox = ElementHandle::find_by_accessible_label(&instance, "Notifications").next().unwrap();
    let toggle = ElementHandle::find_by_accessible_label(&instance, "Live updates").next().unwrap();
    let comfortable = ElementHandle::find_by_accessible_label(&instance, "Comfortable").next().unwrap();
    let compact = ElementHandle::find_by_accessible_label(&instance, "Compact").next().unwrap();
    checkbox.mock_single_click(PointerEventButton::Left);
    assert!(instance.get_checked());
    assert_eq!(instance.get_toggles(), 1);
    instance.set_checked(false);
    assert_eq!(checkbox.accessible_checked(), Some(false));
    checkbox.invoke_accessible_default_action();
    assert!(instance.get_checked());
    assert_eq!(instance.get_toggles(), 2);
    toggle.invoke_accessible_default_action();
    assert!(instance.get_switched());
    assert_eq!(instance.get_toggles(), 3);

    compact.mock_single_click(PointerEventButton::Left);
    assert_eq!(instance.get_selected_value(), "compact");
    assert_eq!(compact.accessible_checked(), Some(true));
    assert_eq!(comfortable.accessible_checked(), Some(false));
    assert_eq!(instance.get_selections(), 1);
    compact.invoke_accessible_default_action();
    assert_eq!(instance.get_selections(), 1);

    instance.set_read_only(true);
    instance.invoke_focus_checkbox();
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
    checkbox.invoke_accessible_default_action();
    comfortable.invoke_accessible_default_action();
    instance.invoke_select("comfortable".into());
    assert_eq!(instance.get_toggles(), 3);
    assert_eq!(instance.get_selections(), 1);
    assert_eq!(checkbox.accessible_read_only(), Some(true));
    instance.set_read_only(false);
    comfortable.invoke_accessible_default_action();
    assert_eq!(instance.get_selected_value(), "comfortable");
    assert_eq!(instance.get_selections(), 2);

    instance.set_enabled(false);
    checkbox.invoke_accessible_default_action();
    toggle.mock_single_click(PointerEventButton::Left);
    compact.invoke_accessible_default_action();
    assert_eq!(instance.get_toggles(), 3);
    assert_eq!(instance.get_selections(), 2);
    assert_eq!(compact.accessible_enabled(), Some(false));
}
selection_controls_delegate_state_and_expose_one_accessible_target();
```

