fn slider_delegates_value_keyboard_pointer_and_accessible_actions() {
    use slint::{SharedString, platform::Key};
    let instance = TestCase::new().unwrap();
    let sliders: Vec<_> = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Volume").collect();
    assert_eq!(sliders.len(), 1);
    let slider = &sliders[0];
    assert_eq!(slider.accessible_role(), Some(slint_testing::AccessibleRole::Slider));
    assert_eq!(slider.accessible_value(), Some(SharedString::from("50")));
    assert_eq!(slider.accessible_value_step(), Some(5.0));
    instance.invoke_focus_slider();
    assert!(instance.get_slider_focused());
    slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::RightArrow));
    assert_eq!(instance.get_value(), 55.0);
    assert_eq!(instance.get_changes(), 1);
    assert_eq!(instance.get_releases(), 1);
    slider.invoke_accessible_increment_action();
    slider.invoke_accessible_decrement_action();
    assert_eq!(instance.get_value(), 55.0);
    assert_eq!(instance.get_changes(), 3);
    slider.set_accessible_value("75");
    assert_eq!(instance.get_value(), 75.0);
    instance.invoke_set_value(200.0);
    assert_eq!(instance.get_value(), 100.0);
    let origin = slider.absolute_position();
    let size = slider.size();
    slint_testing::send_mouse_click(&instance, origin.x + size.width / 4.0, origin.y + size.height / 2.0);
    assert!((instance.get_value() - 25.0).abs() < 0.1);
    let changes = instance.get_changes();
    instance.set_enabled(false);
    slider.set_accessible_value("80");
    slider.invoke_accessible_increment_action();
    instance.invoke_set_value(90.0);
    assert_eq!(instance.get_changes(), changes);
}
slider_delegates_value_keyboard_pointer_and_accessible_actions();
```
