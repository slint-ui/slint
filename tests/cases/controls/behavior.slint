import { Button, CheckBox, Switch, RadioButton, RadioGroup, Slider } from "../../../internal/compiler/widgets/headless/controls.slint";

export component TestCase inherits Window {
    width: 200px;
    height: 240px;
    out property <int> actions;

    public function activate() {
        button.activate();
        checkbox.toggle();
        toggle.toggle();
        radio.select();
        group.select("choice");
        slider.set-value(50);
    }

    VerticalLayout {
        button := Button { text: "Button"; clicked => { root.actions += 1; } }
        checkbox := CheckBox { text: "CheckBox"; toggled => { root.actions += 1; } }
        toggle := Switch { text: "Switch"; toggled => { root.actions += 1; } }
        radio := RadioButton { text: "RadioButton"; selected => { root.actions += 1; } }
        group := RadioGroup { text: "RadioGroup"; selected(_) => { root.actions += 1; } }
        slider := Slider { text: "Slider"; changed(_) => { root.actions += 1; } }
    }
}

/*
```rust
