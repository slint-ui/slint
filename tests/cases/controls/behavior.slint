for id in ["button", "checkbox", "toggle", "radio", "group", "slider"] {
    let element = slint_testing::ElementHandle::find_by_element_id(&instance, &format!("TestCase::{id}"))
        .next().unwrap();
    assert_eq!(element.accessible_role(), Some(slint_testing::AccessibleRole::None), "{id}");
    assert_eq!(element.accessible_label(), None, "{id}");
    assert_eq!(element.accessible_checkable(), None, "{id}");
    assert_eq!(element.accessible_checked(), None, "{id}");
    assert_eq!(element.accessible_value(), None, "{id}");
    element.invoke_accessible_default_action();
    element.invoke_accessible_increment_action();
    element.invoke_accessible_decrement_action();
    element.set_accessible_value("50");
}
assert_eq!(instance.get_actions(), 0);
instance.invoke_activate();
assert_eq!(instance.get_actions(), 6);
```
*/
