//library_path(headless): ../../../ui-libraries/base-ui/src/base-ui.slint
import { Toggle } from "@headless";

component StyledToggle inherits Toggle {
    Rectangle {
        background: root.checked ? green : gray;
    }
}

component ComposedToggle inherits Rectangle {
    in-out property <bool> checked <=> behavior.checked;
    callback toggled <=> behavior.toggled;

    behavior := Toggle {
        Rectangle { background: root.checked ? blue : gray; }
    }
}

export component TestCase inherits Window {
    in-out property <bool> enabled: true;
    out property <bool> checked: styled.checked;
    out property <int> toggle-count;

    public function focus-toggle() { styled.focus(); }

    HorizontalLayout {
        styled := StyledToggle {
            text: "Bold";
            enabled: root.enabled;
            width: 80px;
            height: 40px;
            toggled => { root.toggle-count += 1; }
        }

        ComposedToggle { width: 80px; height: 40px; }
    }
}

/*
```rust
use slint::{SharedString, platform::{Key, PointerEventButton}};

let instance = TestCase::new().unwrap();
let toggle = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::styled")
    .next().unwrap();

assert_eq!(toggle.accessible_label(), Some(SharedString::from("Bold")));
assert_eq!(toggle.accessible_checkable(), Some(true));
assert_eq!(toggle.accessible_checked(), Some(false));

toggle.mock_single_click(PointerEventButton::Left);
assert!(instance.get_checked());
assert_eq!(instance.get_toggle_count(), 1);

instance.invoke_focus_toggle();
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
assert!(!instance.get_checked());
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Return));
assert!(instance.get_checked());
assert_eq!(instance.get_toggle_count(), 3);

toggle.invoke_accessible_default_action();
assert!(!instance.get_checked());
assert_eq!(instance.get_toggle_count(), 4);

instance.set_enabled(false);
toggle.mock_single_click(PointerEventButton::Left);
toggle.invoke_accessible_default_action();
assert!(!instance.get_checked());
assert_eq!(instance.get_toggle_count(), 4);
```
*/
