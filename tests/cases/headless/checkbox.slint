//library_path(headless): ../../../ui-libraries/base-ui/src/base-ui.slint
import { CheckBox } from "@headless";

component StyledCheckBox inherits CheckBox {
    HorizontalLayout {
        Rectangle { background: root.checked ? green : gray; width: 20px; }
        Text { text: root.text; }
    }
}

component ComposedCheckBox inherits Rectangle {
    in-out property <bool> checked <=> behavior.checked;
    callback toggled <=> behavior.toggled;

    behavior := CheckBox {
        Rectangle { background: root.checked ? blue : gray; }
    }
}

export component TestCase inherits Window {
    in-out property <bool> enabled: true;
    in-out property <bool> read-only: false;
    out property <bool> checked: checkbox.checked;
    out property <int> toggle-count;

    public function focus-checkbox() { checkbox.focus(); }

    VerticalLayout {
        checkbox := StyledCheckBox {
            text: "Updates";
            enabled: root.enabled;
            read-only: root.read-only;
            height: 40px;
            toggled => { root.toggle-count += 1; }
        }

        ComposedCheckBox { height: 40px; }
    }
}

/*
```rust
use slint::{SharedString, platform::{Key, PointerEventButton}};

let instance = TestCase::new().unwrap();
let checkbox = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::checkbox")
    .next().unwrap();

assert_eq!(checkbox.accessible_label(), Some(SharedString::from("Updates")));
assert_eq!(checkbox.accessible_checkable(), Some(true));
assert_eq!(checkbox.accessible_checked(), Some(false));
assert_eq!(checkbox.accessible_read_only(), Some(false));

checkbox.mock_single_click(PointerEventButton::Left);
assert!(instance.get_checked());
assert_eq!(instance.get_toggle_count(), 1);

instance.invoke_focus_checkbox();
slint_testing::send_keyboard_string_sequence(&instance, &SharedString::from(Key::Space));
assert!(!instance.get_checked());
assert_eq!(instance.get_toggle_count(), 2);

instance.set_read_only(true);
assert_eq!(checkbox.accessible_read_only(), Some(true));
checkbox.mock_single_click(PointerEventButton::Left);
checkbox.invoke_accessible_default_action();
assert!(!instance.get_checked());
assert_eq!(instance.get_toggle_count(), 2);

instance.set_read_only(false);
instance.set_enabled(false);
checkbox.mock_single_click(PointerEventButton::Left);
checkbox.invoke_accessible_default_action();
assert!(!instance.get_checked());
assert_eq!(instance.get_toggle_count(), 2);
```
*/
