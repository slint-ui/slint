export component TestCase inherits Window {
    in-out property <int> var1: 1;
    in-out property <int> var2: 2;

    in-out property <int> a: 1;
    in-out property <int> b: 2;

    match a {
        0: TouchArea {
            Text {
                text: var1;
            }

            x: 0px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var1;
            clicked => {
                var1 += self.xx;
            }
        }
        1: TouchArea {
            x: 150px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var1;
            clicked => {
                var1 += self.xx;
            }
        }
        2: TouchArea {
            x: 300px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var1;
            clicked => {
                var1 += self.xx;
            }
        }
        *: { }
    }

    match b {
        0: TouchArea {
            x: 450px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var2;
            clicked => {
                var2 += self.xx;
            }
        }
        1: TouchArea {
            x: 600px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var2;
            clicked => {
                var2 += self.xx;
            }
        }
        2: TouchArea {
            x: 750px;
            y: 100px;
            width: 100px;
            height: 100px;
            property <int> xx: var2;
            clicked => {
                var2 += self.xx;
            }
        }
        *: { }
    }


    in-out property <bool> test: var1 == 1 && var2 == 2 && a == 1 && b == 2;
}

/*
```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;

assert_eq(instance.get_var1(), 1);
assert_eq(instance.get_a(), 1);

slint_testing::send_mouse_click(&instance, 0., 100.);
assert_eq(instance.get_var1(), 1);
slint_testing::send_mouse_click(&instance, 150., 100.);
assert_eq(instance.get_var1(), 2);
slint_testing::send_mouse_click(&instance, 300., 100.);
assert_eq(instance.get_var1(), 2);

assert_eq(instance.get_var2(), 2);
assert_eq(instance.get_b(), 2);

slint_testing::send_mouse_click(&instance, 450., 100.);
assert_eq(instance.get_var2(), 2);
slint_testing::send_mouse_click(&instance, 600., 100.);
assert_eq(instance.get_var2(), 2);
slint_testing::send_mouse_click(&instance, 750., 100.);
assert_eq(instance.get_var2(), 4);
```

```rust
let instance = TestCase::new().unwrap();

assert_eq!(instance.get_var1(), 1);
assert_eq!(instance.get_a(), 1);

slint_testing::send_mouse_click(&instance, 0., 100.);
assert_eq!(instance.get_var1(), 1);
slint_testing::send_mouse_click(&instance, 150., 100.);
assert_eq!(instance.get_var1(), 2);
slint_testing::send_mouse_click(&instance, 300., 100.);
assert_eq!(instance.get_var1(), 2);

assert_eq!(instance.get_var2(), 2);
assert_eq!(instance.get_b(), 2);

slint_testing::send_mouse_click(&instance, 450., 100.);
assert_eq!(instance.get_var2(), 2);
slint_testing::send_mouse_click(&instance, 600., 100.);
assert_eq!(instance.get_var2(), 2);
slint_testing::send_mouse_click(&instance, 750., 100.);
assert_eq!(instance.get_var2(), 4);
```
*/
