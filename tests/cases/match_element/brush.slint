slint_testing::send_mouse_click(&instance, 50., 50.);
assert_eq(instance.get_clicked_case(), "blue");

instance.set_choice(2);
slint_testing::send_mouse_click(&instance, 50., 50.);
assert_eq(instance.get_clicked_case(), "other");
```

