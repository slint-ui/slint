export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    in-out property <int> choice: 0;
    in-out property <string> clicked-case;
    property <brush> fill: choice == 0 ? #ff0000 : choice == 1 ? Colors.blue : @linear-gradient(90deg, red, blue);

    match fill {
        #ff0000: TouchArea {
            clicked => {
                clicked-case = "red";
            }
        }
        blue: TouchArea {
            clicked => {
                clicked-case = "blue";
            }
        }
        *: TouchArea {
            clicked => {
                clicked-case = "other";
            }
        }
    }
}

