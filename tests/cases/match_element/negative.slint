export component TestCase inherits Window {
    width: 200px;
    height: 100px;

    in-out property <int> int-subject: -1;
    in-out property <length> length-subject: -10px;
    in-out property <int> hit;

    match int-subject {
        -1: TouchArea {
            x: 0px;
            width: 100px;
            clicked => {
                hit = 1;
            }
        }
        1: TouchArea {
            x: 0px;
            width: 100px;
            clicked => {
                hit = 2;
            }
        }
        *: TouchArea {
            x: 0px;
            width: 100px;
            clicked => {
                hit = 3;
            }
        }
    }

    match length-subject {
        -10px: TouchArea {
            x: 100px;
            width: 100px;
            clicked => {
                hit = 11;
            }
        }
        -1.5px: TouchArea {
            x: 100px;
            width: 100px;
            clicked => {
                hit = 12;
            }
        }
        *: { }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();

slint_testing::send_mouse_click(&instance, 50., 50.);
assert_eq!(instance.get_hit(), 1);
instance.set_int_subject(1);
slint_testing::send_mouse_click(&instance, 50., 50.);
assert_eq!(instance.get_hit(), 2);
instance.set_int_subject(0);
slint_testing::send_mouse_click(&instance, 50., 50.);
assert_eq!(instance.get_hit(), 3);

slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq!(instance.get_hit(), 11);
instance.set_length_subject(-1.5);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq!(instance.get_hit(), 12);
instance.set_length_subject(0.);
instance.set_hit(0);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq!(instance.get_hit(), 0);
```

