instance.set_length_subject(-1.5);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq(instance.get_hit(), 12);
instance.set_length_subject(0.);
instance.set_hit(0);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq(instance.get_hit(), 0);
