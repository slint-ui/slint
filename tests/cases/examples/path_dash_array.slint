export component PathDashArray inherits Window {
    title: "Path: stroke-dash-array & stroke-dash-offset";
    width: 760px;
    height: 430px;
    background: Colors.whitesmoke;

    VerticalLayout {
        padding: 32px;
        spacing: 18px;

        Text {
            font-size: 22px;
            font-weight: 700;
            color: Colors.darkslategray;
            text: "Path: stroke-dash-array & stroke-dash-offset";
        }

        HorizontalLayout {
            spacing: 26px;

            Text {
                width: 190px;
                vertical-alignment: center;
                color: Colors.slategray;
                text: "Dashes";
            }

            Path {
                width: 480px;
                height: 24px;
                viewbox-width: 480;
                viewbox-height: 24;
                fill: transparent;
                stroke: Colors.steelblue;
                stroke-width: 5px;
                stroke-line-cap: round;
                stroke-dash-array: "14 9";

                MoveTo {
                    x: 2;
                    y: 12;
                }

                LineTo {
                    x: 478;
                    y: 12;
                }
            }
        }

        HorizontalLayout {
            spacing: 26px;

            Text {
                width: 190px;
                vertical-alignment: center;
                color: Colors.slategray;
                text: "Dots";
            }

            Path {
                width: 480px;
                height: 24px;
                viewbox-width: 480;
                viewbox-height: 24;
                fill: transparent;
                stroke: Colors.crimson;
                stroke-width: 10px;
                stroke-line-cap: round;
                stroke-dash-array: "0 16";

                MoveTo {
                    x: 5;
                    y: 12;
                }

                LineTo {
                    x: 475;
                    y: 12;
                }
            }
        }

        HorizontalLayout {
            spacing: 26px;

            Text {
                width: 190px;
                vertical-alignment: center;
                color: Colors.slategray;
                text: "Dash-dot on a curve";
            }

            Path {
                width: 480px;
                height: 52px;
                viewbox-width: 480;
                viewbox-height: 52;
                fill: transparent;
                stroke: Colors.mediumpurple;
                stroke-width: 4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                // An odd list repeats to make it even: 14 7 0 14 7 0.
                stroke-dash-array: "14 7 0";

                MoveTo {
                    x: 2;
                    y: 26;
                }

                QuadraticTo {
                    control-x: 82;
                    control-y: -6;
                    x: 162;
                    y: 26;
                }

                QuadraticTo {
                    control-x: 242;
                    control-y: 58;
                    x: 322;
                    y: 26;
                }

                QuadraticTo {
                    control-x: 362;
                    control-y: -6;
                    x: 402;
                    y: 26;
                }

                LineTo {
                    x: 478;
                    y: 26;
                }
            }
        }

        HorizontalLayout {
            spacing: 26px;

            Text {
                width: 190px;
                vertical-alignment: center;
                color: Colors.slategray;
                text: "Offset 0 vs 12px";
            }

            HorizontalLayout {
                spacing: 20px;

                Path {
                    width: 230px;
                    height: 24px;
                    viewbox-width: 230;
                    viewbox-height: 24;
                    fill: transparent;
                    stroke: Colors.darkorange;
                    stroke-width: 5px;
                    stroke-line-cap: round;
                    stroke-dash-array: "18 10";

                    MoveTo {
                        x: 2;
                        y: 12;
                    }

                    LineTo {
                        x: 228;
                        y: 12;
                    }
                }

                Path {
                    width: 230px;
                    height: 24px;
                    viewbox-width: 230;
                    viewbox-height: 24;
                    fill: transparent;
                    stroke: Colors.darkorange;
                    stroke-width: 5px;
                    stroke-line-cap: round;
                    stroke-dash-array: "18 10";
                    stroke-dash-offset: 12px;

                    MoveTo {
                        x: 2;
                        y: 12;
                    }

                    LineTo {
                        x: 228;
                        y: 12;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 26px;

            Text {
                width: 190px;
                vertical-alignment: center;
                color: Colors.slategray;
                text: "Animated offset";
            }

            Path {
                width: 480px;
                height: 96px;
                viewbox-width: 480;
                viewbox-height: 96;
                fill: transparent;
                stroke: Colors.mediumseagreen;
                stroke-width: 4px;
                stroke-line-cap: round;
                stroke-line-join: round;
                stroke-dash-array: "16 12";
                stroke-dash-offset: (animation-tick() / 1s * 44) * 1px;

                MoveTo {
                    x: 6;
                    y: 6;
                }

                LineTo {
                    x: 474;
                    y: 6;
                }

                LineTo {
                    x: 474;
                    y: 90;
                }

                LineTo {
                    x: 6;
                    y: 90;
                }

                Close { }
            }
        }
    }
}
