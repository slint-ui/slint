// `preferred-width: 0` with flex-grow (the closest analogue of the CSS
// `flex: 1 1 0` idiom) distributes the whole main size by flex-grow.

component ZeroPreferredStatic inherits Rectangle {
    width: 400px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            flex-grow: 1;
            preferred-width: 0px;
            height: 50px;
        }
        r2 := Rectangle {
            flex-grow: 3;
            preferred-width: 0px;
            height: 50px;
        }
    }

    // Both grow from a zero base, so the whole 400px is split 1:3.
    out property <bool> test: r1.width == 100px && r2.width == 300px;
}

component ZeroPreferredRepeated inherits Rectangle {
    width: 400px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            flex-grow: 1;
            preferred-width: 0px;
            height: 50px;
        }
        for g in [1.0]: Rectangle {
            flex-grow: g;
            preferred-width: 0px;
            height: 50px;
        }
    }

    out property <bool> test: r1.width == 200px;
}

export component TestCase inherits Window {
    width: 400px;
    height: 400px;

    VerticalLayout {
        t1 := ZeroPreferredStatic { }
        t2 := ZeroPreferredRepeated { }
    }

    out property <bool> test: t1.test && t2.test;
}

/*
```cpp
auto handle = TestCase::create();
assert(handle->get_test());
```

```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```js
var instance = new slint.TestCase();
assert(instance.test);
```
*/
