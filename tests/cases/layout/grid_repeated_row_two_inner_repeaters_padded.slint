// C++ live preview: no element search (wrapper has no item tree)
//ignore: cpp-live-preview

// Rows of different lengths, right-aligned by a padding repeater before the cells.
// Each cell's value is its expected column plus one.

export component TestCase inherits Window {
    width: 30px;
    height: 30px;

    in property <[[int]]> rows: [[2, 3], [1, 2, 3], [3]];
    out property <int> count;
    out property <int> wrong-col-count;

    GridLayout {
        for cells in root.rows: Row {
            for i in 3 - cells.length: pad := Rectangle {
                min-height: 10px;
                init => {
                    root.count += 1;
                    if pad.col != i {
                        root.wrong-col-count += 1;
                    }
                }
            }
            for value in cells: cell := Rectangle {
                min-height: 10px;
                init => {
                    root.count += 1;
                    if cell.col != value - 1 {
                        root.wrong-col-count += 1;
                    }
                }
            }
        }
    }

    out property <bool> test: root.count == 9 && root.wrong-col-count == 0;
}

