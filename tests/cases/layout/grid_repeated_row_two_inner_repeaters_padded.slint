let positions = |id| {
    let mut positions: Vec<(f32, f32)> = slint_testing::ElementHandle::find_by_element_id(&instance, id)
        .map(|e| (e.absolute_position().y, e.absolute_position().x))
        .collect();
    positions.sort_by(|a, b| a.partial_cmp(b).unwrap());
    positions
};
assert_eq!(positions("TestCase::pad"), [(0., 0.), (20., 0.), (20., 10.)]);
assert_eq!(positions("TestCase::cell"), [(0., 10.), (0., 20.), (10., 0.), (10., 10.), (10., 20.), (20., 20.)]);
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert_eq(instance.get_count(), 9);
assert_eq(instance.get_wrong_col_count(), 0);

// (y, x) of every element with the given id, in reading order
auto positions = [&](std::string_view id) {
    std::vector<std::pair<float, float>> positions;
    for (const auto &e : slint::testing::ElementHandle::find_by_element_id(handle, id)) {
        auto p = e.absolute_position();
        positions.push_back({ p.y, p.x });
    }
    std::sort(positions.begin(), positions.end());
    return positions;
};
assert((positions("TestCase::pad") == std::vector<std::pair<float, float>> { { 0, 0 }, { 20, 0 }, { 20, 10 } }));
assert((positions("TestCase::cell") == std::vector<std::pair<float, float>> { { 0, 10 }, { 0, 20 }, { 10, 0 }, { 10, 10 }, { 10, 20 }, { 20, 20 } }));
```
