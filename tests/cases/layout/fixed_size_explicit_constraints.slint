```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_static_min_width(), 10.);
assert_eq!(instance.get_static_preferred_width(), 120.);
assert_eq!(instance.get_static_preferred_height(), 80.);
assert_eq!(instance.get_repeated_min_width(), 10.);
assert_eq!(instance.get_repeated_preferred_width(), 120.);
assert_eq!(instance.get_repeated_preferred_height(), 80.);
assert_eq!(instance.get_self_preferred_width(), 50.);
assert!(instance.get_test());

instance.set_cond(false);
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq!(instance.get_repeated_min_width(), 0.);
assert_eq!(instance.get_repeated_preferred_width(), 120.);
assert_eq!(instance.get_repeated_preferred_height(), 80.);
```

