// Rows that set `visible` keep their height, like elements in a layout.
// Hidden rows don't react to clicks.

import { ListView } from "std-widgets.slint";

export struct Box {
    visible: bool,
}

export component TestCase inherits Window {
    in property<[Box]> boxes: [{visible: false}, {visible: true}, {visible: false}, { visible: true }];
    preferred-width: 150px;
    preferred-height: 150px;
    out property<int> val;
    out property<length> content-height: lv.content-height;
    lv := ListView {
        for box[i] in root.boxes: Rectangle {
                height: 25px;
                visible: box.visible;
                Text { text: i; }
                TouchArea { clicked => {val*=10;val+=i;}}
        }
    }

}


