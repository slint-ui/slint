//edition: 1.18

// Before edition 1.19, a conditional section measures a wrapped Text with its own width
// at the width the layout gives it (#14705).

export component TestCase inherits Window {
    width: 200px;
    height: 500px;

    property <string> lorem: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.";
    ref-200 := Text { width: 200px; wrap: word-wrap; text: lorem; visible: false; }
    ref-150 := Text { width: 150px; wrap: word-wrap; text: lorem; visible: false; }

    VerticalLayout {
        alignment: start;
        if true: VerticalLayout {
            Text { width: 150px; wrap: word-wrap; text: lorem; }
        }
        after-text-width := Rectangle { height: 10px; }
        if true: GridLayout {
            Text { width: 150px; wrap: word-wrap; text: lorem; }
        }
        after-grid-text-width := Rectangle { height: 10px; }
    }

    out property <bool> test: ref-150.preferred-height > ref-200.preferred-height
        && after-text-width.y == ref-200.preferred-height
        && after-grid-text-width.y == after-text-width.y + 10px + ref-200.preferred-height;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```

```js
var instance = new slint.TestCase({});
assert(instance.test);
```
*/
