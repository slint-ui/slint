    instance->window().set_size(size);
    preferred_instance->window().set_size(size);
    for (auto actual_size : {
        slint::LogicalSize({instance->get_actual_width(), instance->get_actual_height()}),
        slint::LogicalSize({preferred_instance->get_actual_width(), preferred_instance->get_actual_height()}),
    }) {
        assert_eq(actual_size.width, size.width);
        assert_eq(actual_size.height, size.height);
    }
}
```
