export component PreferredFillCase inherits Window {
    preferred-width: 100%;
    preferred-height: 100%;

    out property <length> actual-width: self.width;
    out property <length> actual-height: self.height;
}

export component TestCase inherits Rectangle {
    width: 50%;
    height: 25%;
    preferred-width: 100%;
    preferred-height: 100%;

    out property <length> actual-width: self.width;
    out property <length> actual-height: self.height;
}

/*
```rust
let instance = TestCase::new().unwrap();
let preferred_instance = PreferredFillCase::new().unwrap();
for size in [slint::LogicalSize::new(300., 200.), slint::LogicalSize::new(180., 120.)] {
    instance.window().set_size(size);
    preferred_instance.window().set_size(size);
    for (width, height) in [
        (instance.get_actual_width(), instance.get_actual_height()),
        (preferred_instance.get_actual_width(), preferred_instance.get_actual_height()),
    ] {
        assert_eq!(width, size.width);
        assert_eq!(height, size.height);
    }
}
```

