auto rows = std::make_shared<slint::VectorModel<std::shared_ptr<slint::Model<int>>>>(
    std::vector<std::shared_ptr<slint::Model<int>>>{ inner });
instance.set_rows(rows);
slint_testing::mock_elapsed_time(16);
assert_eq(instance.get_grid_preferred_width(), 100.);

// Insert between the two inner cells and read the layout before the next frame.
inner->insert(1, 2);
assert_eq(instance.get_grid_preferred_width(), 105.);

slint_testing::mock_elapsed_time(16);
assert_eq(instance.get_grid_preferred_width(), 105.);
```
*/
