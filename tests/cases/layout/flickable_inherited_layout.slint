// #13592

component MyBox inherits VerticalLayout {
    Rectangle {
        min-width: 231px;
        min-height: 40px;
    }

    Rectangle {
        min-width: 100px;
        min-height: 24px;
    }
}

component MyDerivedBox inherits MyBox { }

export component TestCase inherits Window {
    width: 100px;
    height: 50px;

    out property <length> via-component: a.preferred-width;
    out property <length> via-derived: d.preferred-width;
    out property <length> via-inline: b.preferred-width;
    out property <length> via-repeated: r.preferred-width;
    out property <length> content-width: fa.content-width;
    out property <length> content-height: fa.content-height;
    out property <length> derived-content-height: fd.content-height;
    out property <length> repeated-content-height: fr.content-height;

    a := Rectangle {
        fa := Flickable {
            MyBox { }
        }
    }

    d := Rectangle {
        fd := Flickable {
            MyDerivedBox { }
        }
    }

    b := Rectangle {
        Flickable {
            VerticalLayout {
                Rectangle {
                    min-width: 231px;
                    min-height: 64px;
                }
            }
        }
    }

    r := Rectangle {
        fr := Flickable {
            for x in 1: MyBox { }
        }
    }

    out property <bool> test: via-component == 231px && via-derived == 231px && via-inline == 231px && via-repeated == 231px && content-width == 231px && content-height == 64px && derived-content-height == 64px && repeated-content-height == 64px;
}

