assert_eq(rep.size(), 2);
auto wrap4 = slint::testing::ElementHandle::find_by_element_id(handle, "TestCase::wrap4")[0];
for (auto e : rep) {
    assert_eq(e.absolute_position().y - wrap4.absolute_position().y, 70.0);
}
```

