//edition: 1.18
// The debug hooks bind the padding of `MyBox { }`, which forces inlining it so the layout reads
// that padding, and an inlined layout counts toward the Flickable's size in 1.18 too.
//ignore: interpreter-debug-hooks

// Before edition 1.19, a Flickable sizes from its static layout children only, not from a child
// created with `if` or `for`, nor from a child component that inherits a layout (#407, #13592).
// The edition of the child decides, so the Flickable inside a ScrollView from the style behaves the same.

import { ScrollView } from "std-widgets.slint";

component MyBox inherits VerticalLayout {
    Rectangle {
        min-width: 231px;
        min-height: 64px;
    }
}

// Sizes itself from the Flickable, which would be a binding loop if it counted toward its size.
component Row inherits Rectangle {
    HorizontalLayout {
        Text {
            min-width: min(self.preferred-width, root.width * 0.5);
            text: "hello";
        }
    }
}

// Same, for a child component that inherits a layout.
component Md inherits VerticalLayout {
    HorizontalLayout {
        Text {
            text: "hello world";
            wrap: word-wrap;
            width: min(self.preferred-width, root.width);
        }
    }
}

export component TestCase inherits Window {
    width: 100px;
    height: 50px;

    out property <length> via-inline: b.preferred-width;
    out property <length> via-component: a.preferred-width;
    out property <length> via-repeated: r.preferred-width;
    out property <length> inline-content-height: fb.content-height;
    out property <length> component-content-height: fa.content-height;
    out property <length> repeated-content-height: fr.content-height;
    out property <bool> scrollview-component-unmerged: sa.content-height == sa.visible-height;
    out property <bool> scrollview-repeated-unmerged: sr.content-height == sr.visible-height;

    b := Rectangle {
        fb := Flickable {
            VerticalLayout {
                Rectangle {
                    min-width: 231px;
                    min-height: 64px;
                }
            }
        }
    }

    a := Rectangle {
        fa := Flickable {
            MyBox { }
        }
    }

    r := Rectangle {
        fr := Flickable {
            for x in 1: VerticalLayout {
                Rectangle {
                    min-width: 231px;
                    min-height: 64px;
                }
            }
        }
    }

    sa := ScrollView {
        MyBox { }
    }

    sr := ScrollView {
        for x in 1: VerticalLayout {
            Rectangle {
                min-width: 231px;
                min-height: 64px;
            }
        }
    }

    Flickable {
        if true: VerticalLayout {
            Row { }
        }
    }

    VerticalLayout {
        Flickable {
            Md {
                width: parent.width;
            }
        }
    }

    out property <bool> test: via-inline == 231px && via-component == 0px && via-repeated == 0px
        && inline-content-height == 64px && component-content-height == 50px && repeated-content-height == 50px
        && scrollview-component-unmerged && scrollview-repeated-unmerged;
}

