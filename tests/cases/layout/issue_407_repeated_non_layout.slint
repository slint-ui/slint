```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_t_tabs());
assert(instance.get_t_plain());
assert(instance.get_t_self_sized());
assert(instance.get_t_stretch());
assert(instance.get_t_explicit());
assert(instance.get_t_empty());
assert(instance.get_t_listview());
assert(instance.get_t_several());
assert(instance.get_t_dynamic_start());
assert(instance.get_t_opted_out());
assert(instance.get_test());
// The merge follows the condition and the model; a click lays the window out again.
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq(instance.get_dynamic_min_height(), 0.);
assert_eq(instance.get_dynamic_min_width(), 30.);
instance.set_cond(true);
instance.set_heights(std::make_shared<slint::VectorModel<float>>(std::vector<float>{99.}));
slint_testing::send_mouse_click(&instance, 5., 5.);
assert_eq(instance.get_dynamic_min_height(), 77.);
assert_eq(instance.get_dynamic_min_width(), 99.);
```

