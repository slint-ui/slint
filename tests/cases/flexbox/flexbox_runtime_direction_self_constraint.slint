// slint-ui/slint#13059 as reported: a runtime-direction flexbox with a
// constraint that reads the layout's own output. Reading the sizes forces the
// solve, which used to panic with "Recursion detected" in the column arm,
// whose width info read the height the enclosing layouts were computing.
// The driver blocks run both arms.
export component TestCase inherits Window {
    in property <bool> horizontal: true;

    HorizontalLayout {
        Rectangle { width: 40px; }
        VerticalLayout {
            if false: Rectangle { }
            fl := FlexboxLayout { min-height: fl.preferred-height; flex-direction: horizontal ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column; flex-wrap: wrap; }
        }
    }
    out property <bool> test: fl.preferred-height >= 0px && fl.width >= 0px;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
instance.set_horizontal(false);
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
assert(handle->get_test());
handle->set_horizontal(false);
assert(handle->get_test());
```

```js
var instance = new slint.TestCase();
assert(instance.test);
instance.horizontal = false;
assert(instance.test);
```
*/
