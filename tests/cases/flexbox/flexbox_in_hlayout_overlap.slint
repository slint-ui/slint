// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-Slint-Royalty-free-2.0 OR LicenseRef-Slint-Software-3.0

// Regression test for https://github.com/slint-ui/slint/issues/11936
//
// A column-direction FlexboxLayout nested in a HorizontalLayout. The window is
// too short for the column, and the flex has no height of its own, so it is
// measured at an unbounded height and reports one column's width. The bug was
// that the solve then wrapped into a second column anyway, past that width,
// so the parent placed the sibling flex over the wrapped column and the two
// collided. A column flex now never wraps into columns wider than its width:
// the third item stacks below the second, past the flex's bottom, and the
// sibling sits right after the one column. Binding the flex's `height` would
// count the columns instead (see flexbox_column_wrap_width.slint).
//
// Fixed sizes (no font metrics) keep the geometry deterministic on every
// backend. The collision was between the *content* of the two flexes, so the
// assertion compares content edges, not the flex width.

export component TestCase inherits Window {
    width: 600px;
    // The row is short on purpose; the window is not, so the boxes that do
    // not fit stay visible below it instead of being cut off.
    height: 220px;

    band := HorizontalLayout {
        x: 0; y: 0; width: 600px; height: 120px;
        alignment: start;
        spacing: 24px;
        padding: 12px;

        f1 := FlexboxLayout {
            flex-direction: column;
            spacing: 8px;
            r1 := Rectangle { width: 100px; height: 40px; background: #c33; Text { text: "1"; color: white; } }
            r2 := Rectangle { width: 100px; height: 40px; background: #3c3; Text { text: "2"; color: white; } }
            r3 := Rectangle { width: 100px; height: 40px; background: #36c; Text { text: "3"; color: white; } }
        }

        f2 := FlexboxLayout {
            flex-direction: row;
            spacing: 8px;
            m := Rectangle { width: 60px; height: 40px; background: #c93; Text { text: "R"; color: white; } }
        }
    }

    // The bottom edge of the box the row gave f1: box 3 sits below it.
    Rectangle { x: band.x + f1.x - 5px; y: band.y + f1.y + f1.height - 1px;
        width: f1.width + 10px; height: 2px; background: #e08020; }

    Text { x: 12px; y: 170px; width: 576px; font-size: 11px; color: #555555; wrap: word-wrap;
        text: "The column flex has no height of its own, so it is measured as one column and does not wrap: box 3 spills below the orange line, the bottom of the box the row gave it, instead of into a second column that would collide with the R sibling."; }

    out property <length> f1_width: f1.width;
    // rightmost edge of f1's actual content
    out property <length> f1_content_right: f1.x + max(r1.x + r1.width, max(r2.x + r2.width, r3.x + r3.width));
    // leftmost edge of f2's content
    out property <length> f2_content_left: f2.x + m.x;

    // One column, reported and laid out: r3 stacks below r2, past f1's bottom.
    out property <bool> one_column: f1_width == 100px && r3.x == r1.x && r3.y + r3.height > f1.height;
    // The sibling flex must not overlap f1's content.
    out property <bool> no_overlap: f2_content_left >= f1_content_right;

    out property <bool> test: one_column && no_overlap;
}

/*
```cpp
auto handle = TestCase::create();
assert(handle->get_one_column());
assert(handle->get_no_overlap());
assert(handle->get_test());
```

```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_one_column(), "f1 should be one column wide, with r3 stacked below r2");
assert!(instance.get_no_overlap(),
    "sibling flex overlaps f1's content: f2 content left = {}, f1 content right = {}",
    instance.get_f2_content_left(), instance.get_f1_content_right());
assert!(instance.get_test());
```

```js
var instance = new slint.TestCase();
assert(instance.one_column);
assert(instance.no_overlap);
assert(instance.test);
```
*/
