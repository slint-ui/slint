// Under `alignment: stretch`, FlexboxLayout items grow along the main axis
// weighted by their `horizontal-stretch` / `vertical-stretch` factor, like a
// HorizontalLayout / VerticalLayout. Shrinking needs no opt-in: when the
// container is too small every item shrinks, in proportion to its preferred
// size (CSS scaled shrinking), and `min-width` / `min-height` is the way to
// refuse it.

// Test 1: items grow proportionally to their horizontal-stretch
component TestStretchGrowRow inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        alignment: stretch;
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 50px;
            horizontal-stretch: 1;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 50px;
            horizontal-stretch: 2;
            height: 50px;
            background: green;
        }
        r3 := Rectangle {
            preferred-width: 50px;
            horizontal-stretch: 0;
            height: 50px;
            background: blue;
        }
    }

    // Total preferred = 150px, extra = 150px
    // r1 gets 150 * 1/3 = 50, r2 gets 150 * 2/3 = 100, r3 gets 0
    // r1 = 100px, r2 = 150px, r3 = 50px
    out property <bool> test_r1: r1.width == 100px;
    out property <bool> test_r2: r2.width == 150px;
    out property <bool> test_r3: r3.width == 50px;
    out property <bool> test: test_r1 && test_r2 && test_r3;
}

// Test 2: column direction grows by vertical-stretch; the cross-axis factor
// (horizontal-stretch here) is ignored, as in a VerticalLayout
component TestStretchGrowColumn inherits Rectangle {
    width: 50px;
    height: 300px;
    FlexboxLayout {
        alignment: stretch;
        flex-direction: column;
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-height: 50px;
            vertical-stretch: 1;
            horizontal-stretch: 0;
            width: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-height: 50px;
            vertical-stretch: 3;
            width: 50px;
            background: green;
        }
    }

    // Total preferred = 100px, extra = 200px
    // r1 gets 200 * 1/4 = 50, r2 gets 200 * 3/4 = 150
    // r1 = 100px, r2 = 200px
    out property <bool> test_r1: r1.height == 100px;
    out property <bool> test_r2: r2.height == 200px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 3: without `alignment: stretch` nothing grows, whatever the factors
component TestNoGrowWithoutStretchAlignment inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 50px;
            horizontal-stretch: 1;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 120px;
            height: 50px;
            background: green;
        }
    }

    out property <bool> test_r1: r1.width == 50px;
    out property <bool> test_r2: r2.width == 120px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 4: all-zero factors split the free space evenly (e.g. a row of Buttons,
// whose styles set horizontal-stretch: 0), like a HorizontalLayout
component TestAllZeroStretch inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        alignment: stretch;
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 50px;
            horizontal-stretch: 0;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 150px;
            horizontal-stretch: 0;
            height: 50px;
            background: green;
        }
    }

    // 100px free, 50px each
    out property <bool> test_r1: r1.width == 100px;
    out property <bool> test_r2: r2.width == 200px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 5: no factors set at all: Rectangle's implicit stretch is 1, so under
// `alignment: stretch` items grow evenly — HorizontalLayout's default behavior
component TestImplicitStretch inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        alignment: stretch;
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 50px;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 150px;
            height: 50px;
            background: green;
        }
    }

    // 100px free, split by the implicit factors (1 each)
    out property <bool> test_r1: r1.width == 100px;
    out property <bool> test_r2: r2.width == 200px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 6: max-width caps growing; the leftover space stays free
component TestMaxWidthCapsGrow inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        alignment: stretch;
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 100px;
            max-width: 120px;
            horizontal-stretch: 1;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 100px;
            horizontal-stretch: 0;
            height: 50px;
            background: green;
        }
    }

    out property <bool> test_r1: r1.width == 120px;
    out property <bool> test_r2: r2.width == 100px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 7: items shrink when the container is too small, no opt-in needed —
// even with a stretch factor of 0 (see flexbox_no_shrink_min_size.slint for
// min-width refusing to shrink)
component TestShrinkRow inherits Rectangle {
    width: 200px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 150px;
            horizontal-stretch: 0;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 150px;
            horizontal-stretch: 0;
            height: 50px;
            background: green;
        }
    }

    // Total preferred = 300px, overflow = 100px: equal preferred sizes, so
    // both give up 50px
    // r1 = 100px, r2 = 100px
    out property <bool> test_r1: r1.width == 100px;
    out property <bool> test_r2: r2.width == 100px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 7b: shrinking is weighted by the preferred size (CSS scaled shrinking):
// the larger item gives up proportionally more
component TestShrinkProportional inherits Rectangle {
    width: 200px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 150px;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 100px;
            height: 50px;
            background: green;
        }
    }

    // Total preferred = 250px, overflow = 50px, split 150:100
    // r1 loses 30px, r2 loses 20px
    out property <bool> test_r1: r1.width == 120px;
    out property <bool> test_r2: r2.width == 80px;
    out property <bool> test: test_r1 && test_r2;
}

// Test 8: default behavior (no flex properties, default alignment) — items
// keep their preferred size
component TestFlexDefaults inherits Rectangle {
    width: 300px;
    height: 50px;
    FlexboxLayout {
        flex-wrap: no-wrap;
        r1 := Rectangle {
            preferred-width: 80px;
            height: 50px;
            background: red;
        }
        r2 := Rectangle {
            preferred-width: 120px;
            height: 50px;
            background: green;
        }
    }

    out property <bool> test_r1: r1.width == 80px;
    out property <bool> test_r2: r2.width == 120px;
    out property <bool> test: test_r1 && test_r2;
}

export component TestCase inherits Window {
    width: 400px;
    height: 400px;

    VerticalLayout {
        t1 := TestStretchGrowRow { }
        t2 := TestStretchGrowColumn { }
        t3 := TestNoGrowWithoutStretchAlignment { }
        t4 := TestAllZeroStretch { }
        t5 := TestImplicitStretch { }
        t6 := TestMaxWidthCapsGrow { }
        t7 := TestShrinkRow { }
        t7b := TestShrinkProportional { }
        t8 := TestFlexDefaults { }
    }

    out property <bool> test: t1.test && t2.test && t3.test && t4.test
        && t5.test && t6.test && t7.test && t7b.test && t8.test;
}

/*
```cpp
auto handle = TestCase::create();
assert(handle->get_test());
```

```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```js
var instance = new slint.TestCase();
assert(instance.test);
```
*/
