// cSpell: ignore foos
struct Foo  {
    ok: bool,
}

// Make sure that the generated code for this compiles, as we emit
// #[derive(Debug)] for structures and in this case the field of the
// struct contains a model handle.
struct Bar  {
    foos: [Foo],
}

export component TestCase inherits Rectangle {
    in-out property <[Bar]> bars: [];

    // make sure the generated code compiles (that we generate .clone() properly)
    in-out property <Foo> foo: {ok: true};
    in-out property <Bar> bar: {foos: [foo, foo]};
    in-out property <[Bar]> bars2: [bar, bar];

    in-out property <int> bar-changes;
    changed bar => { bar-changes += 1; }
}

/*
```js
var instance = new slint.TestCase({});
function changes() {
    slintlib.private_api.mock_elapsed_time(1);
    return instance.bar_changes;
}

// A struct holding the model a property already holds isn't a change.
var before = changes();
instance.bar = instance.bar;
assert.equal(changes(), before);

var model = new slintlib.ArrayModel([{ ok: false }]);
instance.bar = { foos: model };
assert.equal(changes(), before + 1);
instance.bar = { foos: model };
assert.equal(changes(), before + 1);
assert.equal(instance.bar.foos, model);
```

```csharp
using var instance = TestCase.Create();
int Changes()
{
    Testing.MockElapsedTime(1);
    return instance.BarChanges;
}

// A struct with the model that the property already holds isn't a change.
var before = Changes();
instance.Bar = instance.Bar;
Assert.AreEqual(before, Changes());

var model = new ListModel<Foo>([new Foo { Ok = false }]);
instance.Bar = new Bar { Foos = model };
Assert.AreEqual(before + 1, Changes());
instance.Bar = new Bar { Foos = model };
Assert.AreEqual(before + 1, Changes());
Assert.AreSame(model, instance.Bar.Foos);
```
*/
