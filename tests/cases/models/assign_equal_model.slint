}
var before = Changes();
instance.Foo = instance.Foo;
instance.Bar = instance.Foo;
Assert.AreEqual(before, Changes());

var model = new ListModel<int>([4, 5]);
instance.Foo = model;
Assert.AreEqual(before + 1, Changes());
instance.Foo = model;
Assert.AreEqual(before + 1, Changes());
Assert.AreSame(model, instance.Foo);
Assert.AreEqual(4, instance.First);
