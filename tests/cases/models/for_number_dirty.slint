instance.set_r("");

// `count` is dirty but has the same value
instance.set_toggle(true);
slint_testing::send_mouse_click(&instance, 10., 50.);
assert_eq(instance.get_r(), "click0(2).");
instance.set_r("");

// A row is added
instance.set_value(3);
slint_testing::send_mouse_click(&instance, 10., 50.);
assert_eq(instance.get_r(), "init2.click0(3).");
instance.set_r("");

// Rows are removed
instance.set_value(1);
slint_testing::send_mouse_click(&instance, 10., 50.);
assert_eq(instance.get_r(), "click0(4).");
```

