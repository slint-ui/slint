component IndirectChange {
    in property <[int]> mod;
    property <[int]> private: mod;

    init => {
        private[0] += 1;
    }
}

export component TestCase {

    property <[int]> m1: [5];
    property <[int]> m2: [8];
    property <[int]> indirect: m2;

    property <[int]> arr: [1, 2, 3];
    property <[int]> repeated-items: [1, 2];
    out property <int> len: arr.length;
    out property <int> repeated-sum: layout.preferred-height / 1px;

    public function up() {
        indirect[0] += 10;
        arr.push(4);
        repeated-items[1] = 5;
    }

    callback up2();
    up2 => {up()}

    IndirectChange { mod: m1; }

    layout := VerticalLayout {
        for x in repeated-items: Rectangle {
            preferred-height: x * 1px;
        }
        for x in [100, 200]: Rectangle {
            preferred-height: x * 1px;
        }
    }

    out property <int> t1: m1[0];
    out property <int> t2: m2[0];

    out property <bool> test: t1 == 5+1 && t2 == 8 && len == 3 && repeated-sum == 303;
}

/*
```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert_eq(instance.get_t1(), 6);
assert(instance.get_test());
instance.invoke_up();
assert_eq(instance.get_t2(), 18);
assert_eq(instance.get_len(), 4);
assert_eq(instance.get_repeated_sum(), 306);

```


```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_t1(), 6);
assert!(instance.get_test());
instance.invoke_up();
assert_eq!(instance.get_t2(), 18);
assert_eq!(instance.get_len(), 4);
assert_eq!(instance.get_repeated_sum(), 306);
```

```js
var instance = new slint.TestCase({});
assert.equal(instance.t1, 6);
assert(instance.test);
instance.up2();
assert.equal(instance.t2, 18);
assert.equal(instance.len, 4);
assert.equal(instance.repeated_sum, 306);
```
*/
