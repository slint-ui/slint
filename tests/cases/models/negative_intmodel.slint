export component TestCase inherits Rectangle {
    width: 100phx;
    height: 100phx;

    in-out property <int> creation-count: 0;

    in-out property <length> test-height: root.preferred-height;

    in-out property <int> repeater-count: -10;

    in-out property <length> stripes-width: -20px;
    in-out property <int> stripe-count: 0;
    for _ in stripes-width / 10px: Rectangle {
        init => {
            stripe-count += 1;
        }
    }

    VerticalLayout {
        for _ in repeater-count: Rectangle {
            preferred-height: 10px;
            init => {
                creation-count += 1;
            }
        }
    }

}


