assert(!instance.switch);
assert.equal(instance.data.rowCount(), 2);
assert(instance.test);

let row0 = instance.data.rowData(0);
assert.equal(row0.texts.rowCount(), 2);
assert.equal(row0.texts.rowData(0), "Blue");
assert.equal(row0.texts.rowData(1), "Red");

let row1 = instance.data.rowData(1);
assert.equal(row1.texts.rowCount(), 1);
assert.equal(row1.texts.rowData(0), "Green");

instance.switch = true;
assert(instance.switch);
assert.equal(instance.data.rowCount(), 0);
assert(!instance.test);
