struct Data {
    texts: [string],
}

export component TestCase inherits Window {
    in-out property <bool> switch: false;

    out property<[Data]> data: switch ? [] : [
                { texts: ["Blue", "Red"]},
                { texts: ["Green"]},
            ];

    out property<bool> test: data.length == 2 && data[1].texts.length == 1;
}

/*
```rust
use slint::Model;
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_switch(), false);
assert_eq!(instance.get_data().row_count(), 2);
assert_eq!(instance.get_test(), true);

let row0 = instance.get_data().row_data(0).unwrap();
assert_eq!(row0.texts.row_count(), 2);
assert_eq!(row0.texts.row_data(0).unwrap(), "Blue");
assert_eq!(row0.texts.row_data(1).unwrap(), "Red");

let row1 = instance.get_data().row_data(1).unwrap();
assert_eq!(row1.texts.row_count(), 1);
assert_eq!(row1.texts.row_data(0).unwrap(), "Green");

instance.set_switch(true);
assert_eq!(instance.get_switch(), true);
assert_eq!(instance.get_data().row_count(), 0);
assert_eq!(instance.get_test(), false);
```

