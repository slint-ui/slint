auto row0 = instance.get_data()->row_data(0).value();
assert_eq(row0.texts->row_count(), 2);
assert_eq(row0.texts->row_data(0).value(), "Blue");
assert_eq(row0.texts->row_data(1).value(), "Red");

auto row1 = instance.get_data()->row_data(1).value();
assert_eq(row1.texts->row_count(), 1);
assert_eq(row1.texts->row_data(0).value(), "Green");

instance.set_switch(true);
assert_eq(instance.get_switch(), true);
assert_eq(instance.get_data()->row_count(), 0);
assert_eq(instance.get_test(), false);
```

```js
