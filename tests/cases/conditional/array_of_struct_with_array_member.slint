assert texts0[0] == "Blue"
assert texts0[1] == "Red"

row1 = data[1]
texts1 = list(row1.texts)
assert len(texts1) == 1
assert texts1[0] == "Green"

instance.switch = True
assert instance.switch
assert len(list(instance.data)) == 0
assert not instance.test
