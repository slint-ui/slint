struct Data2 {
    text: string,
}

struct Data {
    datas: [Data2],
}

export component TestCase inherits Window {
    in-out property <bool> test: true;

    out property<Data> data: test ? {} : {
                datas: [
                    {text: "text 1"},
                    {text: "text 2"}
                ],
            };
}

/*
```rust
use slint::Model;
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_test(), true);
assert_eq!(instance.get_data().datas.row_count(), 0);

instance.set_test(false);
assert_eq!(instance.get_test(), false);
assert_eq!(instance.get_data().datas.row_count(), 2);

assert_eq!(instance.get_data().datas.row_data(0).unwrap(), Data2 {
    text: "text 1".into()
});
assert_eq!(instance.get_data().datas.row_data(1).unwrap(), Data2 {
    text: "text 2".into()
});
```

