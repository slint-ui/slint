// C++ live preview cannot search elements (the wrapper has no item tree).
//ignore: cpp-live-preview

// While a menu of the MenuBar is open, hovering another entry of the menu bar switches menus,
// also when the menu bar isn't at the window origin, as in a preview that embeds the window.
// Covers native and non-native popups.

component Inner inherits Window {
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New"; }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Copy"; }
        }
    }
}

export component TestCase inherits Window {
    width: 400px;
    height: 300px;
    Rectangle {
        x: 50px;
        y: 40px;
        width: 300px;
        height: 200px;
        Inner { }
    }
    out property <bool> test: true;
}

/*
```rust
// Non-native popups, shown inside the main window.
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};

let instance = TestCase::new().unwrap();
assert!(instance.get_test());

let find = |label| slint_testing::ElementHandle::find_by_accessible_label(&instance, label).next();
let center = |label| {
    let element = find(label).unwrap();
    let (position, size) = (element.absolute_position(), element.size());
    LogicalPosition::new(position.x + size.width / 2., position.y + size.height / 2.)
};
find("File").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("New").is_some());
instance.window().dispatch_event(WindowEvent::PointerMoved { position: center("Edit") });
assert!(find("New").is_none());
assert!(find("Copy").is_some());

// A click on the entry of the open menu closes it.
find("Edit").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("Copy").is_none());

// A click outside the menu bar closes the open menu.
find("File").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("New").is_some());
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(390., 290.), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(390., 290.), button: PointerEventButton::Left });
assert!(find("New").is_none());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());

auto find = [&](const char *label) {
    return slint::testing::ElementHandle::find_by_accessible_label(handle, label);
};
auto center = [&](const char *label) {
    auto element = find(label)[0];
    auto position = element.absolute_position();
    auto size = element.size();
    return slint::LogicalPosition({ position.x + size.width / 2, position.y + size.height / 2 });
};
auto file = center("File");
slint_testing::send_mouse_click(&instance, file.x, file.y);
assert(!find("New").empty());
instance.window().dispatch_pointer_move_event(center("Edit"));
assert(find("New").empty());
assert(!find("Copy").empty());
```

```rust
// Native popup windows.
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};

let instance = TestCase::new().unwrap();
slint_testing::access_testing_window(instance.window(), |w| w.use_native_popup(true));

let find = |label| slint_testing::ElementHandle::find_by_accessible_label(&instance, label).next();
let center = |label| {
    let element = find(label).unwrap();
    let (position, size) = (element.absolute_position(), element.size());
    LogicalPosition::new(position.x + size.width / 2., position.y + size.height / 2.)
};
find("File").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("New").is_some());
assert!(
    matches!(
        slint_testing::WindowInner::from_pub(instance.window()).active_popups()[0].location,
        slint_testing::PopupWindowLocation::TopLevel(_)
    ),
    "the menu is a native popup window"
);
instance.window().dispatch_event(WindowEvent::PointerMoved { position: center("Edit") });
assert!(find("New").is_none());
assert!(find("Copy").is_some());

// A click on the entry of the open menu closes it.
find("Edit").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("Copy").is_none());

// A click outside the menu bar closes the open menu.
find("File").unwrap().mock_single_click(PointerEventButton::Left);
assert!(find("New").is_some());
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(390., 290.), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(390., 290.), button: PointerEventButton::Left });
assert!(find("New").is_none());
```
*/
