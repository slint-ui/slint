// Without a native macOS menu bar, items with the `quit` role stay in place,
// items with the `hide` role are hidden, and so are menus left without items.

export component TestCase inherits Window {
    in-out property <string> result;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "Quit";
                role: quit;
                shortcut: @keys(Control + Q);
                activated => { result += self.title; }
            }
            MenuItem {
                title: "Hide";
                role: hide;
                shortcut: @keys(Control + H);
                activated => { result += self.title; }
            }
        }
        Menu {
            title: "Window";
            MenuItem {
                title: "Show All";
                role: show-all;
            }
        }
    }
}

