component MyPopup inherits PopupWindow {
    callback clicked;
    width: 20px;
    height: 20px;
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TestCase {
    width: 300px;
    height: 300px;

    in property <bool> cond: true;
    out property <int> popup-clicked;

    if cond : Rectangle {
        popup := MyPopup {
            x: 10px;
            y: 10px;
            clicked => {
                popup-clicked += 1;
            }
        }

        TouchArea {
            clicked => {
                popup.show();
            }
        }
    }
}

/*

```rust
let instance = TestCase::new().unwrap();
slint_testing::send_mouse_click(&instance, 15., 15.);
assert_eq!(instance.get_popup_clicked(), 0);

slint_testing::send_mouse_click(&instance, 15., 15.);
assert_eq!(instance.get_popup_clicked(), 1);
```

*/
