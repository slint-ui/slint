// Platform.is-app is a compile-time constant: `true` for a real application (Rust, C++,
// JS, Python, or the interpreter test driver, which all load this file as part of a real
// host application and have no other way to distinguish themselves from a preview tool),
// and `false` only when a tool explicitly marks itself as a preview (slint-viewer, the
// LSP/editor preview, and SLINT_LIVE_PREVIEW's rust/cpp hot-reload, which reloads the
// .slint source through the same preview-marked interpreter at runtime). Skip the latter
// mode here since it can't share this file's `true` expectation.
//ignore: live-preview

export component TestCase inherits Window {
    out property <bool> test: Platform.is-app;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_test(), true);
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert_eq(instance.get_test(), true);
```

```js
let instance = new slint.TestCase({});
assert(instance.test);
```

```python
instance = TestCase()
assert instance.test
```
*/
