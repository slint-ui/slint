//edition: 1.18

// Before edition 1.19, a height that only states set is zero while no state applies (#8852).

export component TestCase inherits Window {
    in-out property <bool> open;
    in-out property <bool> tall;
    out property <length> outer-height: outer.height;
    out property <length> lone-height: lone.height;

    VerticalLayout {
        outer := Rectangle {
            height: inner.height;
            inner := Rectangle {
                states [
                    expanded when open: { height: 50px; }
                    collapsed when !open: { height: 10px; }
                ]
            }
        }
        lone := Rectangle {
            height: lone-inner.height;
            lone-inner := Rectangle {
                states [
                    taller when tall: { height: 30px; }
                ]
            }
        }
    }

    out property <bool> test: outer-height == 10px && lone-height == 0px;
}

