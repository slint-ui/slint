// Reading a component of another context from a binding doesn't make it a dependency.

export component TestCase inherits Window {
    in property <int> value: 1;
    pure callback read-other() -> int;
    out property <int> with-other: value + read-other();
}

/*
```rust
let ctx_b = i_slint_core::SlintContext::new(Box::new(
    i_slint_backend_testing::TestingBackend::new(Default::default()),
));
let a = TestCase::new().unwrap();
let b = TestCase::new_with_context(ctx_b.clone()).unwrap();

let b_weak = b.as_weak();
a.on_read_other(move || b_weak.unwrap().get_value());
assert_eq!(a.get_with_other(), 2);
b.set_value(7);
assert_eq!(a.get_with_other(), 2);
a.set_value(2);
assert_eq!(a.get_with_other(), 9);
```
*/
