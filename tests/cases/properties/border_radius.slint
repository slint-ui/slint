// Reads the corners in the component, so that the instances themselves don't reference them
component Box inherits Rectangle {
    out property <length> top-left: self.border-top-left-radius;
    out property <length> bottom-right: self.border-bottom-right-radius;
}

export component TestCase {
    rect := Rectangle {
        border-radius: 45px;
        border-top-left-radius: 98px;
    }

    // Reading a corner radius of a rectangle that only sets `border-radius`
    only-radius := Rectangle {
        border-radius: 12px;
    }

    // Issue #9690: instances of one component, only one of them sets a corner radius
    b1 := Box {
        border-radius: 10px;
    }
    b2 := Box {
        border-top-left-radius: 5px;
    }

    out property<bool> tl_ok: rect.border-top-left-radius == 98px;
    out property<bool> tr_ok: rect.border-top-right-radius == 45px;
    out property<bool> br_ok: rect.border-bottom-right-radius == 45px;
    out property<bool> bl_ok: rect.border-bottom-left-radius == 45px;

    out property<bool> only_radius_ok: only-radius.border-top-left-radius == 12px
        && only-radius.border-bottom-right-radius == 12px;
    out property<bool> instances_ok: b1.top-left == 10px && b1.bottom-right == 10px
        && b2.top-left == 5px && b2.bottom-right == 0;

    out property<bool> test: tl_ok && tr_ok && br_ok && bl_ok && only_radius_ok && instances_ok;
}

/*

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```


```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```


```js
var instance = new slint.TestCase({});
assert(instance.test);
```

*/
