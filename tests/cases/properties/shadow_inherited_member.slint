```rust
let instance = TestCase::new().unwrap();
// Base only ever sees its own members
assert_eq!(instance.get_base_view(), "Hello/base-secret/Hello/base-secret/base-label");
assert_eq!(instance.get_derived_view(), "Hey/derived-secret/derived/derived-label");
// A property named like the shadow's internal name is independent of it
assert_eq!(instance.get_derived_name_1(), 42);
// The public API of the derived component exposes the shadowing declaration
assert_eq!(instance.get_name(), "Hey");
instance.set_name("Set".into());
assert_eq!(instance.get_name(), "Set");
assert_eq!(instance.get_base_view(), "Hello/base-secret/Hello/base-secret/base-label");
// A shadowed builtin property keeps its source name in the public API
assert!(instance.get_minimized());
instance.set_minimized(false);
assert!(!instance.get_minimized());

assert_eq!(instance.get_wrapper_content_width(), 12.);
assert_eq!(instance.get_wrapper_flickable_content_width(), 34.);

assert_eq!(instance.get_box_gap(), 9.);
assert_eq!(instance.get_box_base_gap(), 3.);
assert_eq!(instance.get_box_extra(), 5);
```

