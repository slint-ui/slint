component Inner {
    in-out property <int> value: 0;
}

export component TestCase inherits Rectangle {
    in-out property <int> idx: 0;
    in-out property <int> prop_1: 0;
    in-out property <int> prop_2: 0;
    in-out property <float> prop_3: 100.0;
    in-out property <color> prop_4: #000000;
    in-out property <length> prop_5: 0px;
    in-out property <bool> not_animatable: false;
    in-out property <int> standalone: 0;
    in-out property <int> named: 0;
    in-out property <int> fallback: 0;
    out property <length> child_width: child.width;
    out property <int> inner_value: inner.value;

    animate standalone { duration: 1000ms; }

    child := Rectangle {
        width: 0px;
    }
    inner := Inner { }

    states [
        a when idx == 1: {
            prop_1: 100;
            prop_2: 100;
            prop_3: 0.0;
            prop_4: #ffffff;
            prop_5: 100px;
            not_animatable: true;
            in {
                animate prop_1 { duration: 300ms; }
                animate * { duration: 100ms; }
            }
        }
        b when idx == 2: {
            standalone: 100;
            named: 100;
            fallback: 100;
            child.width: 100px;
            inner.value: 100;
            in-out {
                animate * { duration: 100ms; }
            }
            in {
                animate named { duration: 400ms; }
            }
        }
    ]
}


/*

```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.get_prop_1(), 0);
assert_eq!(instance.get_prop_2(), 0);
assert_eq!(instance.get_prop_3(), 100.0);
assert_eq!(instance.get_prop_4(), slint::Color::from_rgb_u8(0x00, 0x00, 0x00));
assert_eq!(instance.get_prop_5(), 0.0);
assert!(!instance.get_not_animatable());

instance.set_idx(1);
assert_eq!(instance.get_prop_1(), 0);
assert_eq!(instance.get_prop_2(), 0);
assert_eq!(instance.get_prop_3(), 100.0);
assert_eq!(instance.get_prop_4(), slint::Color::from_rgb_u8(0x00, 0x00, 0x00));
assert_eq!(instance.get_prop_5(), 0.0);
assert!(instance.get_not_animatable());

slint_testing::mock_elapsed_time(50);
assert_eq!(instance.get_prop_1(), 17);
assert_eq!(instance.get_prop_2(), 50);
assert_eq!(instance.get_prop_3(), 50.0);
assert_eq!(instance.get_prop_4(), slint::Color::from_rgb_u8(0x7f, 0x7f, 0x7f));
assert_eq!(instance.get_prop_5(), 50.0);

slint_testing::mock_elapsed_time(100);
assert_eq!(instance.get_prop_1(), 50);
assert_eq!(instance.get_prop_2(), 100);
assert_eq!(instance.get_prop_3(), 0.0);
assert_eq!(instance.get_prop_4(), slint::Color::from_rgb_u8(0xff, 0xff, 0xff));
assert_eq!(instance.get_prop_5(), 100.0);

slint_testing::mock_elapsed_time(150);
assert_eq!(instance.get_prop_1(), 100);
assert_eq!(instance.get_prop_2(), 100);
assert_eq!(instance.get_prop_3(), 0.0);
assert_eq!(instance.get_prop_4(), slint::Color::from_rgb_u8(0xff, 0xff, 0xff));
assert_eq!(instance.get_prop_5(), 100.0);

assert_eq!(instance.get_standalone(), 0);
assert_eq!(instance.get_named(), 0);
assert_eq!(instance.get_fallback(), 0);
assert_eq!(instance.get_child_width(), 0.0);
assert_eq!(instance.get_inner_value(), 0);
instance.set_idx(2);
slint_testing::mock_elapsed_time(40);
assert_eq!(instance.get_standalone(), 4);
assert_eq!(instance.get_named(), 10);
assert_eq!(instance.get_fallback(), 40);
assert_eq!(instance.get_child_width(), 40.0);
assert_eq!(instance.get_inner_value(), 40);

slint_testing::mock_elapsed_time(960);
assert_eq!(instance.get_standalone(), 100);
assert_eq!(instance.get_named(), 100);
assert_eq!(instance.get_fallback(), 100);
assert_eq!(instance.get_child_width(), 100.0);
assert_eq!(instance.get_inner_value(), 100);

// Leaving the state, `named` only has an `in` animation so the `in-out` catch-all applies
instance.set_idx(0);
slint_testing::mock_elapsed_time(40);
assert_eq!(instance.get_standalone(), 96);
assert_eq!(instance.get_named(), 60);
assert_eq!(instance.get_fallback(), 60);
assert_eq!(instance.get_child_width(), 60.0);
assert_eq!(instance.get_inner_value(), 60);
```


