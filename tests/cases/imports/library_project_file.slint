// A library path that names a project file uses that project's `main`, include paths,
// and library paths.

//library_path(old_lib): ../../helper_components/edition_1_18_library/slint-project.json
import { NestedRepeatedText, RepeatedText, Slot, StatesOnly } from "@old_lib";

export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    lib-text := RepeatedText { }
    nested-text := NestedRepeatedText { }
    Slot { }
    lib-states := StatesOnly { }

    out property <bool> test: lib-text.width == 100px && nested-text.width == 100px
        && lib-states.width == 100px;
}

