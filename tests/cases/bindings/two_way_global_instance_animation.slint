global Shared {
    in-out property <int> value;
}

component Alias {
    in-out property <int> value <=> Shared.value;
}

component AnimatedAlias inherits Alias {
    animate value { duration: 200ms; }
}

export component TestCase inherits Window {
    inherited := AnimatedAlias { value: 0; }
    overridden := AnimatedAlias {
        value: 0;
        animate value { duration: 400ms; }
    }
    child := Alias {
        value <=> Shared.value;
        animate value { duration: 400ms; }
    }
    initialized-instance := Alias {
        value: 0;
        animate value { duration: 400ms; }
    }
    out property <int> observed: Shared.value;
    public function write-inherited() { inherited.value = 100; }
    public function write-overridden() { overridden.value = 0; }
    public function write-initialized-instance() { initialized-instance.value = 0; }
    public function write-instance() { child.value = 100; }
}

/*
```rust
let instance = TestCase::new().unwrap();

instance.invoke_write_inherited();
slint_testing::mock_elapsed_time(100);
assert_eq!(instance.get_observed(), 50, "inherited 200ms animation");
slint_testing::mock_elapsed_time(100);
assert_eq!(instance.get_observed(), 100);

instance.invoke_write_overridden();
slint_testing::mock_elapsed_time(200);
assert_eq!(instance.get_observed(), 50, "overridden 400ms animation");
slint_testing::mock_elapsed_time(200);
assert_eq!(instance.get_observed(), 0);

instance.invoke_write_instance();
slint_testing::mock_elapsed_time(200);
assert_eq!(instance.get_observed(), 50, "instance animation with a repeated two-way link");
slint_testing::mock_elapsed_time(200);
assert_eq!(instance.get_observed(), 100);

instance.invoke_write_initialized_instance();
slint_testing::mock_elapsed_time(200);
assert_eq!(instance.get_observed(), 50, "instance animation with a value initializer");
```
*/
