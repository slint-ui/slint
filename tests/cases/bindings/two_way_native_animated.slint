// Assigning to an animated native property installs an animation binding on it,
// and the value must still reach the global that the property is two-way bound to.

export global Adapter {
    in-out property <brush> color: blue;
}

export component TestCase inherits Window {
    r := Rectangle {
        background <=> Adapter.color;
        animate background { duration: 0ms; }
        init => {
            self.background = red;
        }
    }

    out property <bool> test: Adapter.color == red;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```
*/
