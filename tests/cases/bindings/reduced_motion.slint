let instance = TestCase::new().unwrap();
assert_eq!(instance.get_eased(), 1.);
assert_eq!(instance.get_sprung(), 0.);
assert_eq!(instance.get_delayed(), 0.);

slint_testing::set_reduced_motion(true);
instance.set_cond(true);
assert_eq!(instance.get_eased(), 0.);
assert_eq!(instance.get_sprung(), 100.);
assert_eq!(instance.get_delayed(), 100.);

// Back to normal: the next change animates again.
slint_testing::set_reduced_motion(false);
instance.set_cond(false);
assert_eq!(instance.get_eased(), 0.);
assert_eq!(instance.get_delayed(), 100.);
slint_testing::mock_elapsed_time(500);
assert_eq!(instance.get_eased(), 0.5);
assert_eq!(instance.get_delayed(), 100.);
slint_testing::mock_elapsed_time(1500);
assert_eq!(instance.get_eased(), 1.);
assert_eq!(instance.get_delayed(), 0.);
```

