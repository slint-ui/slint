//cpp-namespace: my::ui
// A type named `slint` shadows the library in the generated Rust, TypeScript, and Python code.
//ignore: rust,d.ts,pyi

export struct slint {
    condition: bool,
    name: string,
}

export global Globals {
    in-out property <slint> current: { condition: true, name: "global" };
    callback changed(slint) -> slint;
}

export component TestCase inherits Window {
    in-out property <slint> test_struct;
    in-out property <[slint]> items: [{ condition: true, name: "a" }];

    VerticalLayout {
        for item in items: Text {
            text: item.name;
        }
    }

    out property <bool> test: Globals.current.condition && items[0].name == "a";
}

/*
```cpp
auto handle = my::ui::TestCase::create();
const my::ui::TestCase &instance = *handle;
assert(instance.get_test());

my::ui::slint test_struct {.condition = true, .name = "hello"};
instance.set_test_struct(test_struct);
assert(instance.get_test_struct() == test_struct);

const auto &globals = instance.global<my::ui::Globals>();
globals.on_changed([](my::ui::slint value) {
    value.name = "changed";
    return value;
});
assert(globals.invoke_changed(test_struct).name == "changed");
```
*/
