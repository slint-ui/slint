//cpp-namespace: my::slint::ui
//ignore: rust,js,pyi
struct TestStruct {
    condition: bool,
}

export component TestCase inherits Rectangle {
    in-out property <TestStruct> test_struct;
    in-out property <string> text;
}

/*
```cpp
auto handle = my::slint::ui::TestCase::create();
const my::slint::ui::TestCase &instance = *handle;
my::slint::ui::TestStruct test_struct {.condition = true};
instance.set_test_struct(test_struct);
assert(instance.get_test_struct() == test_struct);
instance.set_text("hello");
assert(instance.get_text() == "hello");
```

*/
