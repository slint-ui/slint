//cpp-namespace: my::slint::ui

export enum Kind {
    Small,
    Large,
}

export struct TestStruct {
    condition: bool,
    kind: Kind,
    name: string,
}

export global Globals {
    in-out property <TestStruct> current: { condition: true, kind: Kind.Large, name: "global" };
    callback changed(TestStruct) -> int;
    public pure function count(items: [TestStruct]) -> int {
        return items.length;
    }
}

component Item inherits Rectangle {
    in property <TestStruct> data;
    out property <bool> selected: data.condition && data.kind == Kind.Large;
}

export component TestCase inherits Window {
    in-out property <TestStruct> test_struct;
    in-out property <[TestStruct]> items: [
        { condition: true, kind: Kind.Small, name: "a" },
        { condition: false, kind: Kind.Large, name: "b" },
    ];
    in-out property <string> text;
    out property <int> item_count: Globals.count(items);
    callback edited(TestStruct) -> TestStruct;

    VerticalLayout {
        for item in items: Item {
            data: item;
        }
        if test_struct.condition: Text {
            text: test_struct.name;
        }
    }

    out property <bool> test: item_count == 2 && Globals.current.kind == Kind.Large;
}

