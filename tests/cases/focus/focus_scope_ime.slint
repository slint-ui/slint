export component TestCase inherits Window {

    callback set_focus();
    set_focus => {
        scope.focus();
    }

    callback unfocus();
    unfocus => {
        scope.clear-focus();
    }

    callback change_ime_text();
    change_ime_text => {
        scope.ime-text = "world";
    }

    callback focus_scope2();
    focus_scope2 => {
        scope2.focus();
    }

    out property <string> preedit;
    out property <string> committed;
    out property <int> preedit-selection-start;
    out property <int> preedit-selection-end;
    out property <string> scope2-preedit;

    scope := FocusScope {
        accepts-text-input: true;
        ime-text: "hello";
        ime-cursor-position: 5;
        ime-cursor-rect-x: 10px;
        ime-cursor-rect-y: 20px;
        ime-cursor-rect-width: 1px;
        ime-cursor-rect-height: 14px;

        composition-update(event) => {
            root.preedit = event.text;
            root.preedit-selection-start = event.preedit-selection-start;
            root.preedit-selection-end = event.preedit-selection-end;
            accept
        }
        composition-commit(event) => {
            root.committed = event.text;
            accept
        }
    }

    scope2 := FocusScope {
        accepts-text-input: false;
        composition-update(event) => {
            root.scope2-preedit = event.text;
            accept
        }
    }
}

/*
```rust
use i_slint_core::input::{InternalKeyEvent, KeyEventType};
use slint::private_unstable_api::re_exports::InputMethodRequest;

let instance = TestCase::new().unwrap();

fn ime_requests(instance: &TestCase) -> Vec<InputMethodRequest> {
    slint_testing::access_testing_window(instance.window(), |w| w.ime_requests())
}

fn clear_ime_requests(instance: &TestCase) {
    slint_testing::access_testing_window(instance.window(), |w| w.clear_ime_requests())
}

// No input method requests before the scope is focused
assert!(ime_requests(&instance).is_empty());

instance.invoke_set_focus();

// Focusing an accepts-text-input FocusScope enables the input method
let requests = ime_requests(&instance);
assert_eq!(requests.len(), 1, "expected one IME request: {:?}", requests);
let InputMethodRequest::Enable(p) = &requests[0] else {
    panic!("expected Enable, got {:?}", requests[0]);
};
assert_eq!(p.text, "hello");
assert_eq!(p.cursor_position, 5);
assert!(p.anchor_position.is_none());

// Changing an ime-* property while focused automatically sends an Update,
// without requiring a manual update-input-method-properties() call.
clear_ime_requests(&instance);
instance.invoke_change_ime_text();
slint_testing::mock_elapsed_time(0);
let requests = ime_requests(&instance);
assert_eq!(requests.len(), 1, "expected one Update request: {:?}", requests);
let InputMethodRequest::Update(p) = &requests[0] else {
    panic!("expected Update, got {:?}", requests[0]);
};
assert_eq!(p.text, "world");

// Leaving focus disables the input method
clear_ime_requests(&instance);
instance.invoke_unfocus();
let requests = ime_requests(&instance);
assert_eq!(requests.len(), 1, "expected one Disable request: {:?}", requests);
let InputMethodRequest::Disable = &requests[0] else {
    panic!("expected Disable, got {:?}", requests[0]);
};

// A FocusScope without accepts-text-input does not enable the IME nor
// forward composition events while focused
clear_ime_requests(&instance);
instance.invoke_focus_scope2();
assert!(ime_requests(&instance).is_empty(), "expected no IME request for scope without accepts-text-input");
let mut event = InternalKeyEvent::default();
event.event_type = KeyEventType::UpdateComposition;
event.preedit_text = "xyz".into();
instance.window().dispatch_event(slint::platform::WindowEvent::internal(event));
assert_eq!(instance.get_scope2_preedit(), "", "composition-update must not fire when accepts-text-input is false");
```
*/
