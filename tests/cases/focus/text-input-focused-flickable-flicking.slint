export component TestCase inherits Window {

    callback set_focus();
    set_focus => {
        ti.focus();
    }

    callback move_textinput_y();
    move_textinput_y => {
        flick.content-y -= 10px;
    }

    flick:= Flickable {
        content-height: 1000px;
        VerticalLayout {
            Rectangle {
                height: 100px;
                background: yellow;
            }

            Rectangle {
                background: green;
                ti:= TextInput {
                    height: self.preferred-height;

                }
            }

            Rectangle {
                background: red;
            }

            Rectangle {
                background: blue;
            }
        }
    }
}

/*
```rust
use slint::private_unstable_api::re_exports::InputMethodRequest;
use slint::LogicalPosition;

let instance = TestCase::new().unwrap();

fn ime_requests(instance: &TestCase) -> Vec<InputMethodRequest> {
    slint_testing::access_testing_window(instance.window(), |w| w.ime_requests())
}

assert!(ime_requests(&instance).is_empty(), "Ime requests not empty: {:?}", ime_requests(&instance));

instance.invoke_set_focus();

let requests = ime_requests(&instance);
assert_eq!(requests.len(), 1, "Ime requests not empty: {:?}", requests);
let relevant_request = &requests[0];
if let InputMethodRequest::Enable(p) = relevant_request {
    assert_eq!(p.cursor_rect_origin, LogicalPosition::new(0., 100.), "The Textinput must be at the top left corner of the window + 100px down because of the yellow rectangle");
} else {
    assert!(false, "InputMethodRequest must be enable but it is: {:?}", relevant_request);
}

instance.invoke_move_textinput_y();
slint_testing::mock_elapsed_time(0);

let requests = ime_requests(&instance);
assert_eq!(requests.len(), 2, "Ime requests not empty: {:?}", requests);
let relevant_request = &requests[1];
if let InputMethodRequest::Update(p) = relevant_request {
    assert_eq!(p.cursor_rect_origin, LogicalPosition::new(0., 100. - 10.), "The position of the textinput has changed so the cursor must change as well");
} else {
    assert!(false, "InputMethodRequest must be update but it is: {:?}", relevant_request);
}




```


*/
