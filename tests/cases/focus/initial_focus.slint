assert(instance.input1_focused);
assert(!instance.input2_focused);

slintlib.private_api.send_keyboard_string_sequence(instance, "Only for field 1");
assert.equal(instance.input1_text, "Only for field 1");
assert.equal(instance.input2_text, "");

slintlib.private_api.send_mouse_click(instance, 150., 100.);
assert(instance.input1_focused);
assert(!instance.input2_focused);

slintlib.private_api.send_mouse_click(instance, 150., 300.);
assert(!instance.input1_focused);
assert(instance.input2_focused);
```

```csharp
using var instance = TestCase.Create();
Assert.IsTrue(instance.Input1Focused);
Assert.IsFalse(instance.Input2Focused);
Testing.SendKeyboardStringSequence(instance.Instance, "Only for field 1");
Assert.AreEqual("Only for field 1", instance.Input1Text);
Assert.AreEqual("", instance.Input2Text);
Testing.SendMouseClick(instance.Instance, 150, 100);
Assert.IsTrue(instance.Input1Focused);
Assert.IsFalse(instance.Input2Focused);
Testing.SendMouseClick(instance.Instance, 150, 300);
Assert.IsFalse(instance.Input1Focused);
Assert.IsTrue(instance.Input2Focused);
```
