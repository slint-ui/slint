// A link is clickable where the text is drawn, which `vertical-alignment` moves down.
export component TestCase inherits Window {
    width: 300px;
    height: 300px;

    bottom := StyledText {
        x: 0;
        y: 0;
        width: 150px;
        height: 200px;
        default-font-size: 20px;
        vertical-alignment: TextVerticalAlignment.bottom;
        text: @markdown("[link](https://slint.dev/bottom)");
        link-clicked(url) => {
            clicked_link_url = url;
        }
    }

    center := StyledText {
        x: 150px;
        y: 0;
        width: 150px;
        height: 200px;
        default-font-size: 20px;
        vertical-alignment: TextVerticalAlignment.center;
        text: @markdown("[link](https://slint.dev/center)");
        link-clicked(url) => {
            clicked_link_url = url;
        }
    }

    out property <bool> test: true;
    in-out property <string> clicked_link_url: "";
}

/*
