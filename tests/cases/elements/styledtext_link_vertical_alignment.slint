// The text sits at the bottom of the item: a click there follows the link, one at the top doesn't.
slint_testing::send_mouse_click(&instance, 10.0, 190.0);
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev/bottom");
instance.set_clicked_link_url("".into());
slint_testing::send_mouse_click(&instance, 10.0, 10.0);
assert_eq!(instance.get_clicked_link_url(), "");

// Centered: the link is in the middle of the item.
slint_testing::send_mouse_click(&instance, 160.0, 100.0);
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev/center");
instance.set_clicked_link_url("".into());
slint_testing::send_mouse_click(&instance, 160.0, 10.0);
assert_eq!(instance.get_clicked_link_url(), "");
```

