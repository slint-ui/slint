// Setting viewport-y far from the current position keeps the offset into the row (#4463)

import { ListView } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 400px;
    height: 300px;

    in-out property <length> viewport-y <=> lv.viewport-y;
    out property <int> clicked-row: -1;
    out property <length> clicked-y;

    lv := ListView {
        for row[index] in 2: Rectangle {
            height: 800px;
            TouchArea {
                clicked => {
                    root.clicked-row = index;
                    root.clicked-y = self.mouse-y;
                }
            }
        }
    }
}

