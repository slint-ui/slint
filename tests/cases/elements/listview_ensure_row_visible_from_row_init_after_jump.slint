slintlib.private_api.send_mouse_click(instance, 150., 50.);
assert.equal(instance.clicked_row, 0);

instance.viewport_y = -5000;
slintlib.private_api.send_mouse_click(instance, 150., 50.);
assert(instance.requested);
assert.equal(instance.viewport_y, -5000);
assert.equal(instance.clicked_row, 50);
```
