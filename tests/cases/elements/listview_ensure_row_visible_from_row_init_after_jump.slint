// Scrolling far away replaces all instances, starting with row 50.
// Row 50's init runs during that layout pass and asks for row 52, which is already in view.
// The request used to see the new instances with the scroll position of the old ones,
// and so scrolled back towards row 2.

import { ListView } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 300px;
    height: 300px;

    in-out property <length> viewport-y <=> listview.viewport-y;
    out property <bool> requested;
    out property <int> clicked-row: -1;

    listview := ListView {
        width: 300px;
        height: 300px;
        for i in 100: Rectangle {
            height: 100px;
            init => {
                if i == 50 && !root.requested {
                    root.requested = true;
                    listview.ensure-row-visible(52, ScrollBehavior.instant);
                }
            }
            TouchArea {
                clicked => {
                    root.clicked-row = i;
                }
            }
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();
slint_testing::send_mouse_click(&instance, 150., 50.);
assert_eq!(instance.get_clicked_row(), 0);

instance.set_viewport_y(-5000.);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert!(instance.get_requested());
assert_eq!(instance.get_viewport_y(), -5000.);
assert_eq!(instance.get_clicked_row(), 50);
```

```cpp
