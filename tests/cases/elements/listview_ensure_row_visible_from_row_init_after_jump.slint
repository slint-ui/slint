instance.set_viewport_y(-5000.);
slint_testing::send_mouse_click(&instance, 150., 50.);
assert(instance.get_requested());
assert_eq(instance.get_viewport_y(), -5000.);
assert_eq(instance.get_clicked_row(), 50);
```

```js
