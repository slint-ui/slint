// Timers and animations belong to the context of the component that declares them, not to the thread's.

export component TestCase inherits Window {
    out property <int> count;

    Timer {
        interval: 100ms;
        triggered => {
            root.count += 1;
        }
    }

    in property <int> target;
    out property <int> bound: target;
    animate bound { duration: 1000ms; }

    out property <int> assigned;
    animate assigned { duration: 1000ms; }
    public function assign(value: int) {
        assigned = value;
    }
}

/*
```rust
let ctx = i_slint_core::SlintContext::new(Box::new(i_slint_backend_testing::TestingBackend::new(
    i_slint_backend_testing::TestingBackendOptions { mock_time: true, ..Default::default() },
)));
let instance = TestCase::new_with_context(ctx.clone()).unwrap();
assert_eq!(instance.get_bound(), 0);
instance.set_target(100);
instance.invoke_assign(100);

// Drives the thread's context only.
slint_testing::mock_elapsed_time(150);
assert_eq!(instance.get_count(), 0);
assert_eq!(instance.get_bound(), 0);
assert_eq!(instance.get_assigned(), 0);

ctx.update_timers_and_animations();
assert_eq!(instance.get_count(), 1);
assert_eq!(instance.get_bound(), 15);
assert_eq!(instance.get_assigned(), 15);
```
*/
