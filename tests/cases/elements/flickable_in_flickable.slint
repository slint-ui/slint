```rust
// Wheel events
use slint::{LogicalPosition, platform::WindowEvent };
let instance = TestCase::new().unwrap();
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(175.0, 175.0), delta_x: 0.0, delta_y: -50.0 });
assert_eq!(instance.get_inner_x(), 0.);
assert_eq!(instance.get_outer_y(), 50., "Scrolling the outer because the inner cannot scroll vertically");

println!("Scroll horizontal");
instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(175.0, 175.0), delta_x: -30.0, delta_y: 0.0 });
assert_eq!(instance.get_inner_x(), 30., "Scrolling the inner horizontal because the outer cannot scroll horizontally");
assert_eq!(instance.get_outer_y(), 50.);

instance.window().dispatch_event(WindowEvent::PointerScrolled { position: LogicalPosition::new(175.0, 175.0), delta_x: 0.0, delta_y: 10.0 });
assert_eq!(instance.get_inner_x(), 30.);
assert_eq!(instance.get_outer_y(), 40., "Scrolling vertical on the outer was not done. Because the inner is only horizontal");
```

```rust
// Touch pad gestures (#13421)
use slint::platform::WindowEvent;
use slint_testing::{BackendMouseEvent, LogicalPoint, TouchPhase};
let instance = TestCase::new().unwrap();
let wheel = |pos: LogicalPoint, delta_y: f32, phase| {
    instance.window().dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel { position: pos, delta_x: 0., delta_y, phase }));
    slint_testing::mock_elapsed_time(16);
};
let gesture = |pos: LogicalPoint, delta_y: f32| {
    wheel(pos, 0., TouchPhase::Started);
    wheel(pos, delta_y, TouchPhase::Moved);
    wheel(pos, delta_y, TouchPhase::Moved);
    wheel(pos, 0., TouchPhase::Ended);
    slint_testing::mock_elapsed_time(3000);
};

// Overlapping location of the Outer and inner Flickable
const LOCATION_OUTER_INNER: LogicalPoint = LogicalPoint::new(175., 175.);
// Overlapping location of the Outer and the nested Flickable
const LOCATION_OUTER_NESTED: LogicalPoint = LogicalPoint::new(445., 445.);

// Scrolling the outer, because the inner cannot scroll vertically
wheel(LOCATION_OUTER_INNER, 0., TouchPhase::Started);
wheel(LOCATION_OUTER_INNER, -20., TouchPhase::Moved);
wheel(LOCATION_OUTER_INNER, -20., TouchPhase::Moved);
assert_eq!(instance.get_inner_x(), 0.);
assert_eq!(instance.get_outer_y(), 40., "The outer follows the gesture because the inner cannot scroll vertically");
wheel(LOCATION_OUTER_INNER, 0., TouchPhase::Ended);
slint_testing::mock_elapsed_time(3000);

// The inner never started flicking until yet so this is a move without any phase (So animation with around 180ms)
instance.window().dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel { position: LOCATION_OUTER_INNER, delta_x: -30., delta_y: 0., phase: TouchPhase::Moved }));
slint_testing::mock_elapsed_time(16); // The animation without any wheel phase is around 180ms
assert!(instance.get_inner_x() > 0. && instance.get_inner_x() < 30., "Mouse wheel is animated: {}", instance.get_inner_x());
slint_testing::mock_elapsed_time(30000);
assert!((instance.get_inner_x()-  30.).abs() < 1e-3, "Animation is finished: {}", instance.get_inner_x());
let inner_x = instance.get_inner_x();

// Scrolling again the outer because the inner cannot scroll vertically
gesture(LOCATION_OUTER_INNER, -300.);
assert_eq!(instance.get_inner_x(), inner_x);
assert_eq!(instance.get_outer_y(), 500.);

gesture(LOCATION_OUTER_NESTED, -20.);
assert_eq!(instance.get_outer_y(), 500.);
assert!(instance.get_nested_y() > 0., "Scrolling the nested one that can scroll vertically: {}", instance.get_nested_y());
let nested_y = instance.get_nested_y();

wheel(LOCATION_OUTER_NESTED, -20., TouchPhase::Moved);
slint_testing::mock_elapsed_time(3000);
assert_eq!(instance.get_outer_y(), 500.);
assert!(instance.get_nested_y() > nested_y, "Mouse wheel scrolls the nested one: {} > {}", instance.get_nested_y(), nested_y);
let nested_y = instance.get_nested_y();

gesture(LOCATION_OUTER_INNER, 20.);
assert!(instance.get_outer_y() < 500., "Scrolling the outer again: {}", instance.get_outer_y());
assert_eq!(instance.get_nested_y(), nested_y);
```

