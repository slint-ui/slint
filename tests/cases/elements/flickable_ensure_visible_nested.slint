    const TestCase &instance = *handle;
    instance.invoke_reveal(behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq(instance.get_inner_offset(), 850.);
    assert_eq(instance.get_outer_offset(), 100.);
}
```

