export component TestCase inherits Window {
    width: 200phx;
    height: 200phx;

    public function reveal(behavior: ScrollBehavior) {
        target.ensure-visible(behavior);
    }

    outer := Flickable {
        content_width: 200phx;
        content_height: 1000phx;

        inner := Flickable {
            y: 100phx;
            width: 200phx;
            height: 200phx;
            content_width: 200phx;
            content_height: 2000phx;

            target := Rectangle {
                y: 1000phx;
                height: 50phx;
                background: green;
            }
        }
    }

    out property <length> outer_offset: -outer.content_y;
    out property <length> inner_offset: -inner.content_y;
}

