    let instance = TestCase::new().unwrap();
    instance.invoke_reveal(behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq!(instance.get_inner_offset(), 850., "{behavior:?}");
    assert_eq!(instance.get_outer_offset(), 100., "{behavior:?}");
}
```

```cpp
using slint::language::ScrollBehavior;
for (auto behavior : { ScrollBehavior::Instant, ScrollBehavior::Smooth }) {
