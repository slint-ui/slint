assert_eq(instance.get_clicked_link_url(), "");
slint_testing::send_mouse_click(&instance, 30., line_height / 2.f);
assert_eq(instance.get_clicked_link_url(), "https://one");
slint_testing::send_mouse_click(&instance, 55., line_height * 1.5f);
assert_eq(instance.get_clicked_link_url(), "https://two");

assert(instance.get_fixed_quoted_width() == 30.f);
```

```js
