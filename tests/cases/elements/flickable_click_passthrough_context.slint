// Variants where the pannable Flickable and the TouchArea it must forward a plain click to don't
// share the same top-level dispatch tree: resolving the delayed press must replay against the
// tree the event actually originated in, not always the main window's. See issue #13118.

// A pannable Flickable inside a `for`-repeated delegate (its own item-tree instance, not the window's)
// must still forward a plain click to a TouchArea outside the repeater.
// Resolving the delayed press must replay from the dispatch's actual root, not from the repeated delegate's own tree.
export component TestCaseRepeated inherits Window {
    width: 100px;
    height: 300px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    VerticalLayout {
        for i in 3: Flickable {
            height: 100px;
            content-width: self.width;
            content-height: 150px;

            Rectangle {
                background: gray;
            }
        }
    }

    out property <int> counter: 0;
}

// A pannable Flickable inside a popup must still forward a plain click to a TouchArea inside that same popup.
// Resolving the delayed press must replay against the popup's own tree and coordinate offset, not the main window's.
export component TestCasePopup inherits Window {
    width: 300px;
    height: 300px;

    popup := PopupWindow {
        close-policy: no-auto-close;
        x: 10px;
        y: 10px;
        width: 100px;
        height: 100px;

        TouchArea {
            clicked => { root.counter += 1; }
        }
        Flickable {
            width: 100px;
            height: 100px;
            content-width: 100px;
            content-height: 200px;

            Rectangle {
                width: 100px;
                height: 200px;
                background: gray;
            }
        }
    }

    TouchArea {
        clicked => { popup.show(); }
    }

    out property <int> counter: 0;
}

/*
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCaseRepeated::new().unwrap();

// A plain click inside the middle repeated Flickable must reach the TouchArea underneath.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 150.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 150.0), button: PointerEventButton::Left });
assert_eq!(instance.get_counter(), 1);
```

```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCasePopup::new().unwrap();

// Open the popup by clicking the main window's TouchArea.
slint_testing::send_mouse_click(&instance, 250., 250.);
assert_eq!(instance.get_counter(), 0);

// A plain click inside the popup's Flickable must reach the TouchArea inside that popup.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
assert_eq!(instance.get_counter(), 1);
```
*/
