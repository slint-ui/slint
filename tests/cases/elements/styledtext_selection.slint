// Selecting text in a `StyledText` with the mouse; no string templates, so the Rust driver runs it.
export component TestCase inherits Window {
    width: 800px;
    height: 600px;

    plain := StyledText {
        x: 0;
        y: 0;
        width: 400px;
        height: 80px;
        text: @markdown("Not [selectable](https://slint.dev/plain) here");
        link-clicked(url) => {
            clicked_link_url = url;
        }
    }

    // Two lines of five fit; the item has room for them all.
    cut := StyledText {
        x: 400px;
        y: 0;
        width: 400px;
        height: 300px;
        text-selectable: true;
        max-lines: 2;
        text: @markdown("one\n\ntwo\n\nthree\n\nfour\n\nfive");
    }

    // The first paragraph is empty.
    blank := StyledText {
        x: 0;
        y: 100px;
        width: 400px;
        height: 80px;
        text-selectable: true;
        text: @markdown("<u></u>\n\nSecond paragraph");
    }

    // The text sits at the bottom of an item taller than it.
    bottom := StyledText {
        x: 400px;
        y: 300px;
        width: 400px;
        height: 100px;
        vertical-alignment: TextVerticalAlignment.bottom;
        text-selectable: true;
        text: @markdown("[link](https://slint.dev/bottom)");
        link-clicked(url) => {
            clicked_link_url = url;
        }
    }

    st := StyledText {
        x: 0;
        y: 450px;
        width: 400px;
        height: 80px;
        text-selectable: true;
        text: root.st-text;
        link-clicked(url) => {
            clicked_link_url = url;
            link_clicks += 1;
        }
    }

    // `copy()` puts the selection on the clipboard; paste it here to read it back.
    pasted := TextInput {
        x: 600px;
        y: 560px;
        width: 180px;
        height: 30px;
        single-line: false;
    }

    in-out property <styled-text> st-text: @markdown("[Select this](https://slint.dev/sel) **text**\n\nand more");
    out property <bool> test: st.text-selectable && !plain.text-selectable && !st.has-selection;
    in-out property <string> clicked_link_url: "";
    out property <int> link_clicks: 0;
    out property <bool> st_has_selection: st.has-selection;
    out property <int> sel_anchor: st.anchor-position-byte-offset;
    out property <int> sel_cursor: st.cursor-position-byte-offset;
    out property <bool> plain_has_selection: plain.has-selection;
    out property <int> plain_cursor: plain.cursor-position-byte-offset;
    out property <bool> cut_has_selection: cut.has-selection;
    out property <int> cut_cursor: cut.cursor-position-byte-offset;
    out property <int> blank_anchor: blank.anchor-position-byte-offset;
    out property <int> blank_cursor: blank.cursor-position-byte-offset;

    // Copies the current selection and returns what reaches the clipboard.
    public function copy-selection() -> string {
        pasted.text = "";
        st.copy();
        pasted.paste();
        return pasted.text;
    }
}

/*
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
use slint::private_unstable_api::re_exports::{BuiltInMouseCursor, MouseCursorInner};

let instance = TestCase::new().unwrap();
assert!(instance.get_test());

let cursor = || slint_testing::access_testing_window(instance.window(), |window| window.mouse_cursor());
let moved = |x, y| instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(x, y) });
let pressed = |x, y| instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(x, y), button: PointerEventButton::Left });
let released = |x, y| instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(x, y), button: PointerEventButton::Left });

// Not selectable: a pointer over the link only, and a drag selects nothing.
moved(300.0, 10.0);
assert_eq!(cursor(), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Default));
moved(40.0, 10.0);
assert_eq!(cursor(), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Pointer));
pressed(2.0, 10.0);
moved(395.0, 10.0);
released(395.0, 10.0);
assert!(!instance.get_plain_has_selection());
assert_eq!(instance.get_plain_cursor(), 0);

// Selectable: an I-beam over the text, a pointer over its link.
moved(300.0, 460.0);
assert_eq!(cursor(), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Text));
moved(5.0, 460.0);
assert_eq!(cursor(), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Pointer));

// Dragging from the link selects instead of following it; `copy()` is the raw text.
pressed(2.0, 460.0);
moved(395.0, 460.0);
assert!(instance.get_st_has_selection());
assert_eq!(instance.invoke_copy_selection(), "Select this text");
released(395.0, 460.0);
assert_eq!(instance.invoke_copy_selection(), "Select this text");
assert_eq!(instance.get_clicked_link_url(), "");
assert_eq!(instance.get_sel_anchor(), 0);
assert_eq!(instance.get_sel_cursor(), 16);

// Across paragraphs, by character: offsets count the line break between them. (Time passes
// first: clicks in quick succession count as double and triple clicks.)
slint_testing::mock_elapsed_time(1000);
pressed(2.0, 460.0);
moved(8.0, 520.0);
released(8.0, 520.0);
assert_eq!(instance.invoke_copy_selection(), "Select this text\na");

// A click without a drag follows the link under it, and clears the selection.
slint_testing::mock_elapsed_time(1000);
slint_testing::send_mouse_click(&instance, 5.0, 460.0);
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev/sel");
assert!(!instance.get_st_has_selection());

// A drag that comes back to where it started is still a drag, not a click.
instance.set_clicked_link_url("".into());
slint_testing::mock_elapsed_time(1000);
pressed(5.0, 460.0);
moved(100.0, 460.0);
moved(5.0, 460.0);
released(5.0, 460.0);
assert_eq!(instance.get_clicked_link_url(), "");

// A double click selects a word; only its first click, a plain one, follows the link.
slint_testing::mock_elapsed_time(1000);
let link_clicks = instance.get_link_clicks();
pressed(5.0, 460.0);
released(5.0, 460.0);
pressed(5.0, 460.0);
released(5.0, 460.0);
assert_eq!(instance.invoke_copy_selection(), "Select");
assert_eq!(instance.get_link_clicks(), link_clicks + 1);

// A new text drops the selection, whose offsets meant the old one.
instance.set_st_text(slint::StyledText::from_markdown("Something else entirely").unwrap());
slint_testing::mock_elapsed_time(0);
assert!(!instance.get_st_has_selection());
assert_eq!(instance.get_sel_anchor(), 0);
assert_eq!(instance.get_sel_cursor(), 0);

// Below the lines `max-lines` keeps, the drag reaches the end of the last kept line.
slint_testing::mock_elapsed_time(1000);
pressed(402.0, 10.0);
moved(600.0, 250.0);
released(600.0, 250.0);
assert!(instance.get_cut_has_selection());
assert_eq!(instance.get_cut_cursor(), 7);

// An empty first paragraph still takes its line break.
slint_testing::mock_elapsed_time(1000);
pressed(2.0, 140.0);
moved(395.0, 140.0);
released(395.0, 140.0);
assert_eq!(instance.get_blank_anchor(), 1);
assert_eq!(instance.get_blank_cursor(), 17);

// With the text at the bottom, the link is where the text is drawn.
slint_testing::mock_elapsed_time(1000);
moved(405.0, 395.0);
assert_eq!(cursor(), MouseCursorInner::BuiltIn(BuiltInMouseCursor::Pointer));
slint_testing::send_mouse_click(&instance, 405.0, 395.0);
assert_eq!(instance.get_clicked_link_url(), "https://slint.dev/bottom");
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());

auto moved = [&](float x, float y) { instance.window().dispatch_pointer_move_event(slint::LogicalPosition({x, y})); };
auto pressed = [&](float x, float y) { instance.window().dispatch_pointer_press_event(slint::LogicalPosition({x, y}), slint::PointerEventButton::Left); };
auto released = [&](float x, float y) { instance.window().dispatch_pointer_release_event(slint::LogicalPosition({x, y}), slint::PointerEventButton::Left); };

// Not selectable: a drag selects nothing.
pressed(2.0, 10.0);
moved(395.0, 10.0);
released(395.0, 10.0);
assert(!instance.get_plain_has_selection());
assert_eq(instance.get_plain_cursor(), 0);

// Dragging from the link selects instead of following it; `copy()` is the raw text.
pressed(2.0, 460.0);
moved(395.0, 460.0);
released(395.0, 460.0);
assert(instance.get_st_has_selection());
assert_eq(instance.invoke_copy_selection(), slint::SharedString("Select this text"));
assert_eq(instance.get_clicked_link_url(), "");
assert_eq(instance.get_sel_anchor(), 0);
assert_eq(instance.get_sel_cursor(), 16);

// Across paragraphs, by character: offsets count the line break between them.
slint_testing::mock_elapsed_time(1000);
pressed(2.0, 460.0);
moved(8.0, 520.0);
released(8.0, 520.0);
assert_eq(instance.invoke_copy_selection(), slint::SharedString("Select this text\na"));

// A click without a drag follows the link under it, and clears the selection.
slint_testing::mock_elapsed_time(1000);
slint_testing::send_mouse_click(&instance, 5.0, 460.0);
assert_eq(instance.get_clicked_link_url(), slint::SharedString("https://slint.dev/sel"));
assert(!instance.get_st_has_selection());

// A double click selects a word; only its first click, a plain one, follows the link.
slint_testing::mock_elapsed_time(1000);
auto link_clicks = instance.get_link_clicks();
pressed(5.0, 460.0);
released(5.0, 460.0);
pressed(5.0, 460.0);
released(5.0, 460.0);
assert_eq(instance.invoke_copy_selection(), slint::SharedString("Select"));
assert_eq(instance.get_link_clicks(), link_clicks + 1);

// Below the lines `max-lines` keeps, the drag reaches the end of the last kept line.
slint_testing::mock_elapsed_time(1000);
pressed(402.0, 10.0);
moved(600.0, 250.0);
released(600.0, 250.0);
assert(instance.get_cut_has_selection());
assert_eq(instance.get_cut_cursor(), 7);

// An empty first paragraph still takes its line break.
slint_testing::mock_elapsed_time(1000);
pressed(2.0, 140.0);
moved(395.0, 140.0);
released(395.0, 140.0);
assert_eq(instance.get_blank_anchor(), 1);
assert_eq(instance.get_blank_cursor(), 17);
```
