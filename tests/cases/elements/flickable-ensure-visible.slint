export component TestCase inherits Window {
    width: 500phx;
    height: 500phx;

    public function reveal(index: int, behavior: ScrollBehavior) {
        if index == 0 {
            red-rectangle.ensure-visible(behavior);
        } else if index == 1 {
            blue-rectangle.ensure-visible(behavior);
        } else if index == 2 {
            green-rectangle.ensure-visible(behavior);
        }
    }

    f := Flickable {
        content_width: 1000phx;
        content_height: 1000phx;

        red-rectangle := Rectangle {
            x: 0px;
            y: 0px;
            width: 100px;
            height: 100px;
            background: red;
        }

        blue-rectangle := Rectangle {
            x: 300px;
            y: 300px;
            width: 100px;
            height: 100px;
            background: blue;
        }

        green-rectangle := Rectangle {
            x: 700px;
            y: 700px;
            width: 100px;
            height: 100px;
            background: green;
        }
    }

    out property <length> offset_x: -f.content_x;
    out property <length> offset_y: -f.content_y;
}

