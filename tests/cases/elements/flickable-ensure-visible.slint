```rust
use slint::language::ScrollBehavior;

const RED: i32 = 0;
const BLUE: i32 = 1;
const GREEN: i32 = 2;

for behavior in [ScrollBehavior::Instant, ScrollBehavior::Smooth] {
    let instance = TestCase::new().unwrap();

    // Already in view
    instance.invoke_reveal(RED, behavior);
    instance.invoke_reveal(BLUE, behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq!(instance.get_offset_x(), 0., "{behavior:?}");
    assert_eq!(instance.get_offset_y(), 0., "{behavior:?}");

    // Scrolls until the bottom right corner is in view
    instance.invoke_reveal(GREEN, behavior);
    if behavior == ScrollBehavior::Smooth {
        assert_eq!(instance.get_offset_x(), 0., "The animation didn't start yet");
        assert_eq!(instance.get_offset_y(), 0., "The animation didn't start yet");
    }
    slint_testing::mock_elapsed_time(5000);
    assert_eq!(instance.get_offset_x(), 300., "{behavior:?}");
    assert_eq!(instance.get_offset_y(), 300., "{behavior:?}");

    // Scrolls back until the top left corner is in view
    instance.invoke_reveal(RED, behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq!(instance.get_offset_x(), 0., "{behavior:?}");
    assert_eq!(instance.get_offset_y(), 0., "{behavior:?}");
}
```

```cpp
using slint::language::ScrollBehavior;

for (auto behavior : { ScrollBehavior::Instant, ScrollBehavior::Smooth }) {
    auto handle = TestCase::create();
    const TestCase &instance = *handle;

    instance.invoke_reveal(0, behavior);
    instance.invoke_reveal(1, behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq(instance.get_offset_x(), 0.);
    assert_eq(instance.get_offset_y(), 0.);

    instance.invoke_reveal(2, behavior);
    if (behavior == ScrollBehavior::Smooth) {
        assert_eq(instance.get_offset_x(), 0.);
        assert_eq(instance.get_offset_y(), 0.);
    }
    slint_testing::mock_elapsed_time(5000);
    assert_eq(instance.get_offset_x(), 300.);
    assert_eq(instance.get_offset_y(), 300.);

    instance.invoke_reveal(0, behavior);
    slint_testing::mock_elapsed_time(5000);
    assert_eq(instance.get_offset_x(), 0.);
    assert_eq(instance.get_offset_y(), 0.);
}
```

```js
const EPSILON = 0.001;

for (const behavior of ["instant", "smooth"]) {
    var instance = new slint.TestCase({});

    instance.reveal(0, behavior);
    instance.reveal(1, behavior);
    slintlib.private_api.mock_elapsed_time(5000);
    assert(Math.abs(instance.offset_x) < EPSILON, `${behavior}: ${instance.offset_x}`);
    assert(Math.abs(instance.offset_y) < EPSILON, `${behavior}: ${instance.offset_y}`);

    instance.reveal(2, behavior);
    if (behavior === "smooth") {
        assert(Math.abs(instance.offset_x) < EPSILON, `${behavior}: ${instance.offset_x}`);
        assert(Math.abs(instance.offset_y) < EPSILON, `${behavior}: ${instance.offset_y}`);
    }
    slintlib.private_api.mock_elapsed_time(5000);
    assert(Math.abs(instance.offset_x - 300) < EPSILON, `${behavior}: ${instance.offset_x}`);
    assert(Math.abs(instance.offset_y - 300) < EPSILON, `${behavior}: ${instance.offset_y}`);

    instance.reveal(0, behavior);
    slintlib.private_api.mock_elapsed_time(5000);
    assert(Math.abs(instance.offset_x) < EPSILON, `${behavior}: ${instance.offset_x}`);
    assert(Math.abs(instance.offset_y) < EPSILON, `${behavior}: ${instance.offset_y}`);
}
