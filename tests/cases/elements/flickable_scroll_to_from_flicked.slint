instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(250.0, 250.0), button: PointerEventButton::Left });
assert_eq!(instance.get_flicked_count(), 4, "the release flings");
slint_testing::mock_elapsed_time(5000);
assert_eq!(instance.get_offset_x(), 0.);
assert_eq!(instance.get_offset_y(), 300.);
