assert(instance.offset_x === 35, instance.offset_x);
assert(instance.offset_y === 45, instance.offset_y);
slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 35, instance.offset_x);
assert(instance.offset_y === 45, instance.offset_y);

instance.flickable_scroll_to(0, 0, "instant");
assert(instance.offset_x === 0, instance.offset_x);
assert(instance.offset_y === 0, instance.offset_y);

instance.flickable_scroll_to(105, 135, "smooth");
assert(instance.offset_x === 0, instance.offset_x);
assert(instance.offset_y === 0, instance.offset_y);

slintlib.private_api.mock_elapsed_time(10);
assert(instance.offset_x > 0, instance.offset_x);
assert(instance.offset_y > 0, instance.offset_y);
assert(instance.offset_x < 105, instance.offset_x);
assert(instance.offset_y < 135, instance.offset_y);

slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 105, instance.offset_x);
assert(instance.offset_y === 135, instance.offset_y);

instance.flickable_scroll_to(0, 0, "smooth");
assert(instance.offset_x > 0, instance.offset_x);
assert(instance.offset_y > 0, instance.offset_y);

slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 0, instance.offset_x);
assert(instance.offset_y === 0, instance.offset_y);

// Targets past the scroll limits are clamped to them.
instance.flickable_scroll_to(5000, -300, "instant");
assert(instance.offset_x === 500, instance.offset_x);
assert(instance.offset_y === 0, instance.offset_y);

instance.flickable_scroll_to(-300, 5000, "smooth");
slintlib.private_api.mock_elapsed_time(10);
assert(instance.offset_y < 100, instance.offset_y);
slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 0, instance.offset_x);
assert(instance.offset_y === 500, instance.offset_y);
