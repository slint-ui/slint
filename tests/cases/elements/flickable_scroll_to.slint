slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 105, instance.offset_x);
assert(instance.offset_y === 135, instance.offset_y);

instance.flickable_scroll_to(0, 0, "smooth");
assert(instance.offset_x > 0, instance.offset_x);
assert(instance.offset_y > 0, instance.offset_y);

slintlib.private_api.mock_elapsed_time(1000000);
assert(instance.offset_x === 0, instance.offset_x);
assert(instance.offset_y === 0, instance.offset_y);
