// Without snapping, the current row is the topmost row, even when it's only partly visible.

import { ListView } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 100px;
    height: 200px;

    in-out property <length> content-y <=> list.content-y;
    out property <int> current-row: list.current-row();
    out property <int> changed-row: -2;
    out property <int> changes;

    list := ListView {
        current-row-changed(row) => {
            root.changed-row = row;
            root.changes += 1;
        }

        for i in 100: Rectangle {
            height: 50px;
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();

// A click lays out the ListView, and the elapsed time runs the `changed` handler.
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 0);
assert_eq!(instance.get_changed_row(), 0);
assert_eq!(instance.get_changes(), 1);

// Row 2 starts 25px above the viewport.
instance.set_content_y(-125.);
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 2);
assert_eq!(instance.get_changed_row(), 2);
assert_eq!(instance.get_changes(), 2);

// Scrolling within row 2 doesn't change the current row.
instance.set_content_y(-140.);
slint_testing::send_mouse_click(&instance, 5., 5.);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_current_row(), 2);
assert_eq!(instance.get_changes(), 2);
```

