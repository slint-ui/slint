// With center snapping, the item offset is the current row's center relative to the list's center.
// A `content-y` of `-50px * row` puts a row's center on the list's center.
// The list springs a `content-y` between rows back to a row, so the test compares
// the offset with the `content-y` the layout used.

import { ListView } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 200px;
    height: 200px;

    in-out property <length> content-y <=> list.content-y;
    out property <int> current-row: list.current-row;
    out property <length> item-offset: list.item-offset;
    out property <length> expected-offset: root.content-y + root.current-row * 50px;

    // A click next to the list lays it out without starting a snap.
    list := ListView {
        x: 0;
        width: 100px;
        snap-mode: SnapMode.center;
        for i in 100: Rectangle {
            height: 50px;
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();

slint_testing::send_mouse_click(&instance, 150., 5.);
assert_eq!(instance.get_current_row(), 0);
assert_eq!(instance.get_item_offset(), 0.);

// Row 1's center is above the list's center.
instance.set_content_y(-60.);
slint_testing::send_mouse_click(&instance, 150., 5.);
assert_eq!(instance.get_current_row(), 1);
assert!(instance.get_item_offset() < 0.);
assert!((instance.get_item_offset() - instance.get_expected_offset()).abs() < 0.01);

// Once snapped, row 1's center is on the list's center.
slint_testing::mock_elapsed_time(5000);
slint_testing::send_mouse_click(&instance, 150., 5.);
assert_eq!(instance.get_current_row(), 1);
assert!(instance.get_item_offset().abs() < 0.01);

// Row 2's center is below the list's center.
instance.set_content_y(-90.);
slint_testing::send_mouse_click(&instance, 150., 5.);
assert_eq!(instance.get_current_row(), 2);
assert!(instance.get_item_offset() > 0.);
assert!((instance.get_item_offset() - instance.get_expected_offset()).abs() < 0.01);
```

