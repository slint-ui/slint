// A plain click through a pannable Flickable must still reach the sibling TouchArea behind it,
// even when the pointer hovered over that same spot first.
// The hover leaves the TouchArea tracked for a deferred Exit,
// and resolving the click must not fire that stale Exit against the TouchArea the click itself just landed on
// (it would press/grab it and immediately cancel it).
// See issue #13118.

export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    Flickable {
        width: 100px;
        height: 100px;
        content-width: 100px;
        content-height: 200px;

        Rectangle {
            width: 100px;
            height: 200px;
            background: gray;
        }
    }

    out property <int> counter: 0;
}

/*
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCase::new().unwrap();

// Hover first, over the same spot the click will land on.
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(50.0, 50.0) });
// A plain click at that same spot must still reach the TouchArea underneath.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
assert_eq!(instance.get_counter(), 1);
```
*/
