use slint::*;
use slint_testing::AutoBool;

fn settle() {
    for _ in 0..40 {
        slint_testing::mock_elapsed_time(100);
    }
}

// The same press as above, during a spring back to the right end.
let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();
slint_testing::set_flickable_physics(&flickable, AutoBool::On, AutoBool::Off);
instance.set_fli_width(600.);
instance.set_fli_content_width(700.);
slint_testing::mock_elapsed_time(1);
instance.set_fli_content_x(-140.);
slint_testing::mock_elapsed_time(1);
slint_testing::mock_elapsed_time(50);
let spring_at = instance.get_fli_content_x();
assert!(spring_at < -100. && spring_at > -140., "the spring has not started: {spring_at}");
let position = LogicalPosition::new(100., 125.);
instance.window().dispatch_event(platform::WindowEvent::PointerPressed {
    position,
    button: platform::PointerEventButton::Left,
});
slint_testing::mock_elapsed_time(500);
assert_eq!(instance.get_fli_content_x(), spring_at);

instance.window().dispatch_event(platform::WindowEvent::PointerReleased {
    position,
    button: platform::PointerEventButton::Left,
});
settle();
assert_eq!(instance.get_fli_content_x(), -100.);
