```rust
use slint::platform::WindowEvent;
use slint_testing::{AutoBool, BackendMouseEvent, LogicalPoint, TouchPhase};

fn wheel(instance: &TestCase, delta_y: f32) {
    instance.window().dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel {
        position: LogicalPoint::new(150., 200.),
        delta_x: 0.,
        delta_y,
        phase: TouchPhase::Moved,
    }));
}

// Without bounce, the content gets shorter while a wheel scroll runs, so that the end is at -30.
// The scroll is shorter than WHEEL_SCROLL_DURATION (180 ms) when the content shrinks.
let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();
slint_testing::set_flickable_physics(&flickable, AutoBool::Off, AutoBool::Off);
instance.set_fli_content_height(2000.);
slint_testing::mock_elapsed_time(1);
wheel(&instance, -100.);
slint_testing::mock_elapsed_time(80);
wheel(&instance, 40.);
instance.set_fli_content_height(630.);
slint_testing::mock_elapsed_time(100);
assert!(instance.get_fli_content_y() < -30., "{} isn't past -30", instance.get_fli_content_y());
slint_testing::mock_elapsed_time(100000);
assert_eq!(instance.get_fli_content_y(), -30.);
```
