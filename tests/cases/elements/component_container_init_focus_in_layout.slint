// Reading the container's layout info must not run the init callbacks of the
// embedded component's conditionals: an init that takes the focus scrolls the
// Flickable, whose size depends on that same layout info.
// This used to panic with "Recursion detected".

// FIXME: Skip embedding test on C++ and NodeJS since ComponentFactory is not implemented there!
//ignore: cpp,js,pyi

export component TestCase inherits Window {
    width: 300px;
    height: 300px;
    in property <component-factory> component-factory <=> cont.component-factory;
    out property <length> flickable-width: f.width;

    f := Flickable {
        x: 0;
        y: 0;
        width: min(root.width, cont.preferred-width);
        height: min(root.height, cont.preferred-height);
        cont := ComponentContainer { }
    }
}

/*
```rust
use slint::ComponentHandle;
let inner_instance = std::rc::Rc::<core::cell::RefCell<Option<slint_interpreter::ComponentInstance>>>::default();
let inner_instance_clone = inner_instance.clone();
let factory = slint::ComponentFactory::new(move |ctx| {
    let compiler = slint_interpreter::Compiler::new();
    let e = spin_on::spin_on(compiler.build_from_source(
        r#"export component Inner {
                in-out property <bool> show;
                out property <bool> focused;
                preferred-width: show ? 200px : 100px;
                preferred-height: 50px;
                if show: FocusScope {
                    init => {
                        self.focus();
                        root.focused = self.has-focus;
                    }
                }
            }"#.into(),
        std::path::PathBuf::from("embedded.slint"),
     )).component("Inner").unwrap();

    let inner = e.create_embedded(ctx).unwrap();
    inner_instance_clone.replace(Some(inner.clone_strong()));
    Some(inner)
});

let instance = TestCase::new().unwrap();
instance.set_component_factory(factory);
slint_testing::mock_elapsed_time(0);
assert_eq!(instance.get_flickable_width(), 100.);

let inner = inner_instance.take().expect("should have been created");
inner.set_property("show", true.into()).unwrap();
assert_eq!(instance.get_flickable_width(), 200.);

// The instantiation pass runs the init callback, which takes the focus.
slint_testing::mock_elapsed_time(0);
assert_eq!(inner.get_property("focused").unwrap(), slint_interpreter::Value::from(true));
```
*/
