// A wheel scroll that starts while the content is past its limit (#14350).
// Moving further away used to fail a debug assertion,
// or leave the content past its end in a release build.

export component TestCase inherits Window {
    width: 300px;
    height: 400px;

    fli := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: 2000px;
    }

    in-out property fli_height <=> fli.height;
    in-out property fli_content_height <=> fli.content_height;
    in-out property fli_content_y <=> fli.content_y;
}

/*
```rust
use slint::platform::WindowEvent;
use slint_testing::{AutoBool, BackendMouseEvent, LogicalPoint, TouchPhase};

// A mouse wheel tick has no phase, so no platform velocity tracker is involved.
fn wheel(instance: &TestCase, delta_y: f32) {
    instance.window().dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel {
        position: LogicalPoint::new(150., 200.),
        delta_x: 0.,
        delta_y,
        phase: TouchPhase::Moved,
    }));
}

fn with_bounce(bounce: AutoBool) -> TestCase {
    let instance = TestCase::new().unwrap();
    let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
        .next()
        .unwrap();
    slint_testing::set_flickable_physics(&flickable, bounce, AutoBool::Off);
    instance
}

fn end(instance: &TestCase) -> f32 {
    instance.get_fli_height() - instance.get_fli_content_height()
}

const SETTLE: u64 = 100000;

// Without bounce: the content shrinks while a wheel animation runs,
// which leaves the content past its end. A tick down springs back.
let instance = with_bounce(AutoBool::Off);
wheel(&instance, -100.);
slint_testing::mock_elapsed_time(80);
wheel(&instance, 40.);
instance.set_fli_content_height(430.);
slint_testing::mock_elapsed_time(100);
assert!(instance.get_fli_content_y() < end(&instance), "{} isn't past {}", instance.get_fli_content_y(), end(&instance));
wheel(&instance, -50.);
slint_testing::mock_elapsed_time(SETTLE);
assert_eq!(instance.get_fli_content_y(), end(&instance));

// With bounce: from past the end, a tick down springs back.
let instance = with_bounce(AutoBool::On);
instance.set_fli_content_y(-1700.);
assert!(instance.get_fli_content_y() < end(&instance));
wheel(&instance, -300.);
slint_testing::mock_elapsed_time(SETTLE);
assert_eq!(instance.get_fli_content_y(), end(&instance));

// With bounce: from past the end, a tick up scrolls into the content.
let instance = with_bounce(AutoBool::On);
instance.set_fli_content_y(-1700.);
wheel(&instance, 300.);
slint_testing::mock_elapsed_time(SETTLE);
assert!(instance.get_fli_content_y() > end(&instance), "{} didn't scroll into the content", instance.get_fli_content_y());
```
*/
