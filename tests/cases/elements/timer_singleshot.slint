export component TestCase inherits Window {
    out property <string> result;
    in-out property <bool> is-running <=> timer.running;

    timer := Timer {
        interval: 1s;
        running: false;
        repeat: false;
        triggered => {
            result += "1";
        }
    }

    public function start_timer() {
        timer.start();
    }

    out property <string> second-result;
    in-out property <bool> is-second-running <=> second-timer.running;
    in-out property <bool> second-timer-repeat <=> second-timer.repeat;

    second-timer := Timer {
        interval: 1s;
        running: false;
        repeat: false;
        triggered => {
            second-result += "1";
        }
    }

    public function start_second_timer() {
        second-timer.start();
    }
}

/*
```rust
let instance = TestCase::new().unwrap();
// first timer
assert_eq!(instance.get_result(), "");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "");
instance.invoke_start_timer();
slint_testing::mock_elapsed_time(0); // We just need update_timers to run

slint_testing::mock_elapsed_time(990); // ensure it doesn't run early
assert_eq!(instance.get_result(), "");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "1");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "1"); // It should only run once
assert_eq!(instance.get_is_running(), false);

// Starting the timer again with start() should work
instance.invoke_start_timer();
slint_testing::mock_elapsed_time(0);

slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "11");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "11"); // It should only run once

// Starting the timer again with restart() should work too
instance.invoke_start_timer();
slint_testing::mock_elapsed_time(0);

slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "111");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_result(), "111"); // It should only run once


// second timer
assert_eq!(instance.get_second_result(), "");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_second_result(), "");
instance.invoke_start_second_timer();
slint_testing::mock_elapsed_time(0);
instance.set_second_timer_repeat(true);

// Repeat is set while the timer is running
slint_testing::mock_elapsed_time(990);
assert_eq!(instance.get_second_result(), "");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_second_result(), "1");
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_second_result(), "11");
assert_eq!(instance.get_is_second_running(), true);
```


