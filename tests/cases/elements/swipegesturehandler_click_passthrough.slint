// SwipeGestureHandler shares Flickable's DelayForwarding mechanism (issue #13118).
// A plain click (press + release, no swipe) with no interactive content of its own must be forwarded
// to the sibling TouchArea behind it, the same way an unclaimed Flickable press now is.

export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    SwipeGestureHandler {
        width: 100px;
        height: 100px;
        handle-swipe-down: true;
    }

    out property <int> counter: 0;
}

/*
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCase::new().unwrap();

instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
assert_eq!(instance.get_counter(), 1);
```
*/
