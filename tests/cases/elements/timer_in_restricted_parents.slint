// A Timer is accepted in parents that otherwise restrict their children.

import { TabWidget } from "std-widgets.slint";

component Leaf {
    Rectangle { }
}

export component TestCase inherits Window {
    out property <int> in-leaf;
    out property <int> in-path;
    out property <int> in-tab-widget;

    Leaf {
        Timer {
            interval: 100ms;
            triggered => { in-leaf += 1; }
        }
    }

    Path {
        MoveTo { x: 0; y: 0; }
        LineTo { x: 10; y: 10; }
        Timer {
            interval: 100ms;
            triggered => { in-path += 1; }
        }
    }

    TabWidget {
        Tab { title: "a"; }
        Timer {
            interval: 100ms;
            triggered => { in-tab-widget += 1; }
        }
    }
}

