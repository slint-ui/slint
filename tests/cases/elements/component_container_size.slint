```rust
use std::cell::RefCell;
use std::rc::Rc;

use slint_interpreter::ComponentInstance;

let embedded_instance: Rc<RefCell<Option<ComponentInstance>>> = Default::default();

let ei = embedded_instance.clone();

let dyn_factory = slint::ComponentFactory::new(move |ctx| {
    let mut compiler = slint_interpreter::Compiler::new();
    compiler.compiler_configuration(i_slint_core::InternalToken).compile_for_component_container = true;
    let e = spin_on::spin_on(compiler.build_from_source(
        r#"export component E1 inherits Rectangle {
    out property <length> embedded-width <=> self.width;
    out property <length> embedded-height <=> self.height;
    out property <length> embedded-x <=> self.x;
    out property <length> embedded-y <=> self.y;

    width: 100%;
    height: 100%;

    min-width: 10px;
    preferred-width: 50px;
    max-width: 100px;
    min-height: 10px;
    preferred-height: 50px;
    max-height: 100px;

}"#.into(),
        std::path::PathBuf::from("embedded.slint"),
     )).component("E1").unwrap();
     let instance = e.create_embedded(ctx).ok();

     ei.replace(instance.as_ref().map(|i| i.clone_strong()));

     instance
});

let instance = TestCase::new().unwrap();

let ei = embedded_instance.take();

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 0.0);
assert_eq!(instance.get_container_height(), 0.0);
assert!(ei.is_none());
drop(ei);

instance.set_cc(dyn_factory.clone());
slint_testing::mock_elapsed_time(0);

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 50.0);
assert_eq!(instance.get_container_height(), 50.0);

let ei = embedded_instance.take().unwrap();
assert_eq!(ei.get_property("embedded-width").unwrap(), instance.get_container_width().into());
assert_eq!(ei.get_property("embedded-height").unwrap(), instance.get_container_height().into());
assert_eq!(ei.get_property("embedded-x").unwrap(), slint_interpreter::Value::Number(0.0));
assert_eq!(ei.get_property("embedded-y").unwrap(), slint_interpreter::Value::Number(0.0));

// Set a valid size:
instance.set_container_width(20.0);
instance.set_container_height(70.0);

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 20.0);
assert_eq!(instance.get_container_height(), 70.0);

assert_eq!(ei.get_property("embedded-width").unwrap(), instance.get_container_width().into());
assert_eq!(ei.get_property("embedded-height").unwrap(), instance.get_container_height().into());
assert_eq!(ei.get_property("embedded-x").unwrap(), slint_interpreter::Value::Number(0.0));
assert_eq!(ei.get_property("embedded-y").unwrap(), slint_interpreter::Value::Number(0.0));

// Set an invalid size:
instance.set_container_width(5.0);
instance.set_container_height(700.0);

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 5.0);
assert_eq!(instance.get_container_height(), 700.0);

assert_eq!(ei.get_property("embedded-width").unwrap(), instance.get_container_width().into());
assert_eq!(ei.get_property("embedded-height").unwrap(), instance.get_container_height().into());
assert_eq!(ei.get_property("embedded-x").unwrap(), slint_interpreter::Value::Number(0.0));
assert_eq!(ei.get_property("embedded-y").unwrap(), slint_interpreter::Value::Number(0.0));
```

// Now with fixed size
```rust
use std::cell::RefCell;
use std::rc::Rc;

use slint_interpreter::ComponentInstance;

let embedded_instance: Rc<RefCell<Option<ComponentInstance>>> = Default::default();

let ei = embedded_instance.clone();

let fixed_factory = slint::ComponentFactory::new(move |ctx| {
    let compiler = slint_interpreter::Compiler::new();
    let e = spin_on::spin_on(compiler.build_from_source(
        r#"export component E1 inherits Rectangle {
    out property <length> embedded-width <=> self.width;
    out property <length> embedded-height <=> self.height;
    out property <length> embedded-x <=> self.x;
    out property <length> embedded-y <=> self.y;

    width: 100px;
    height: 100px;
}"#.into(),
        std::path::PathBuf::from("embedded.slint"),
     )).component("E1").unwrap();
     let instance = e.create_embedded(ctx).ok();

     ei.replace(instance.as_ref().map(|i| i.clone_strong()));

     instance
});

let instance = TestCase::new().unwrap();

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 0.0);
assert_eq!(instance.get_container_height(), 0.0);
assert!(embedded_instance.take().is_none());

instance.set_cc(fixed_factory.clone());
slint_testing::mock_elapsed_time(0);

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 100.0);
assert_eq!(instance.get_container_height(), 100.0);

let ei = embedded_instance.take().unwrap();
assert_eq!(ei.get_property("embedded-width").unwrap(), instance.get_container_width().into());
assert_eq!(ei.get_property("embedded-height").unwrap(), instance.get_container_height().into());
assert_eq!(ei.get_property("embedded-x").unwrap(), slint_interpreter::Value::Number(0.0));
assert_eq!(ei.get_property("embedded-y").unwrap(), slint_interpreter::Value::Number(0.0));

// Change the size of the container
instance.set_container_width(5.0);
instance.set_container_height(700.0);

assert_eq!(instance.get_container_x(), 15.0);
assert_eq!(instance.get_container_y(), 20.0);
assert_eq!(instance.get_container_width(), 5.0);
assert_eq!(instance.get_container_height(), 700.0);

assert_eq!(ei.get_property("embedded-width").unwrap(), slint_interpreter::Value::Number(100.), "The size of the dynamic object must not change because it is fixed");
assert_eq!(ei.get_property("embedded-height").unwrap(), slint_interpreter::Value::Number(100.), "The size of the dynamic object must not change because it is fixed");
assert_eq!(ei.get_property("embedded-x").unwrap(), slint_interpreter::Value::Number(0.0));
assert_eq!(ei.get_property("embedded-y").unwrap(), slint_interpreter::Value::Number(0.0));
```



```rust
use std::cell::RefCell;
use std::rc::Rc;

use slint_interpreter::{ComponentInstance, Value};

for compile_for_component_container in [false, true] {
    for debug_hooks in [false, true] {
        for root_type in ["Rectangle", "Window"] {
            for (fixed_width, fixed_height) in [(true, true), (true, false), (false, true), (false, false)] {
                let embedded_instance: Rc<RefCell<Option<ComponentInstance>>> = Default::default();
                let factory_instance = embedded_instance.clone();
                let factory = slint::ComponentFactory::new(move |context| {
                    let mut compiler = slint_interpreter::Compiler::new();
                    let configuration = compiler.compiler_configuration(i_slint_core::InternalToken);
                    configuration.compile_for_component_container = compile_for_component_container;
                    configuration.error_on_binding_loop_with_window_layout = true;
                    configuration.debug_hooks = debug_hooks.then(std::hash::RandomState::new);
                    let width_binding = if fixed_width { "width: authored-size;" } else if compile_for_component_container { "width: 100%;" } else { "" };
                    let height_binding = if fixed_height { "height: authored-size;" } else if compile_for_component_container { "height: 100%;" } else { "" };
                    let source = format!(r#"
                        export component Embedded inherits {root_type} {{
                            in property <length> authored-size: 100px;
                            out property <length> embedded-width <=> self.width;
                            out property <length> embedded-height <=> self.height;
                            {width_binding}
                            {height_binding}
                        }}
                    "#);
                    let compilation = if debug_hooks {
                        spin_on::spin_on(compiler.build_static_from_source(
                            source,
                            std::path::PathBuf::from("embedded.slint"),
                            i_slint_core::InternalToken,
                        ))
                    } else {
                        spin_on::spin_on(compiler.build_from_source(
                            source,
                            std::path::PathBuf::from("embedded.slint"),
                        ))
                    };
                    assert!(!compilation.has_errors(), "{:?}", compilation.diagnostics().collect::<Vec<_>>());
                    let instance = compilation.component("Embedded").unwrap().create_embedded(context).unwrap();
                    factory_instance.replace(Some(instance.clone_strong()));
                    Some(instance)
                });
                let host = TestCase::new().unwrap();
                host.set_container_width(201.0);
                host.set_container_height(302.0);
                host.set_cc(factory);
                slint_testing::mock_elapsed_time(0);
                let embedded = embedded_instance.take().unwrap();
                let assert_size = |width: f64, height: f64| {
                    for (property, expected) in [("embedded-width", width), ("embedded-height", height)] {
                        assert_eq!(embedded.get_property(property).unwrap(), Value::Number(expected),
                            "{root_type}, container compilation={compile_for_component_container}, debug hooks={debug_hooks}, fixed axes={fixed_width}/{fixed_height}, {property}");
                    }
                };
                assert_size(if fixed_width { 100.0 } else { 201.0 }, if fixed_height { 100.0 } else { 302.0 });
                host.set_force_child_size(true);
                assert_size(
                    if fixed_width && !compile_for_component_container { 100.0 } else { 201.0 },
                    if fixed_height && !compile_for_component_container { 100.0 } else { 302.0 },
                );
                host.set_container_width(341.0);
                host.set_container_height(452.0);
                embedded.set_property("authored-size", Value::Number(123.0)).unwrap();
                assert_size(
                    if fixed_width && !compile_for_component_container { 123.0 } else { 341.0 },
                    if fixed_height && !compile_for_component_container { 123.0 } else { 452.0 },
                );
                host.set_force_child_size(false);
                assert_size(if fixed_width { 123.0 } else { 341.0 }, if fixed_height { 123.0 } else { 452.0 });
            }
        }
    }
}

let compiler = slint_interpreter::Compiler::new();
let compilation = spin_on::spin_on(compiler.build_from_source(
    "export component PrivateSizing inherits Window { force-child-size: true; }".into(),
    std::path::PathBuf::from("private-sizing.slint"),
));
assert!(compilation.has_errors());

for root_type in ["Rectangle", "Window"] {
    for dimension in ["width", "height"] {
        for (compile_for_component_container, percentage) in [(false, 100), (true, 30)] {
            let mut compiler = slint_interpreter::Compiler::new();
            compiler.compiler_configuration(i_slint_core::InternalToken).compile_for_component_container = compile_for_component_container;
            let source = format!("export component InvalidPercentage inherits {root_type} {{ {dimension}: {percentage}%; }}");
            let compilation = spin_on::spin_on(compiler.build_from_source(
                source,
                std::path::PathBuf::from("invalid-percentage.slint"),
            ));
            assert!(compilation.has_errors());
            assert!(compilation.diagnostics().any(|diagnostic| diagnostic.message() == "Cannot find parent property to apply relative length"));
        }
    }
}
