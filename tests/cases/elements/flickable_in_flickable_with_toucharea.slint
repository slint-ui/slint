slint_testing::mock_elapsed_time(300);

window.dispatch_event(WindowEvent::PointerMoved { position: TOUCH_AREA });
assert!(instance.get_touch_area_has_hover(), "The TouchArea gets hover events after the drag");
window.dispatch_event(WindowEvent::PointerPressed { position: TOUCH_AREA, button: PointerEventButton::Left });
window.dispatch_event(WindowEvent::PointerReleased { position: TOUCH_AREA, button: PointerEventButton::Left });
assert_eq!(instance.get_clicked(), 1, "The TouchArea is clickable after the drag");
