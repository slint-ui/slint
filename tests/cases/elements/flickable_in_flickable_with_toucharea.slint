// A tap (press and release without a move) on empty content of the inner Flickable
// must not leave it swallowing the events of its children
use slint::{platform::{WindowEvent, PointerEventButton}, LogicalPosition};
// Empty content of the inner Flickable
const EMPTY: LogicalPosition = LogicalPosition::new(400., 300.);
// Inside the TouchArea
const TOUCH_AREA: LogicalPosition = LogicalPosition::new(150., 135.);

// The outer Flickable forwards the press to the inner one on the release or after 100ms,
// whichever comes first
for hold in [20, 150] {
    let instance = TestCaseTouchArea::new().unwrap();
    let window = instance.window();
    let tap = |position: LogicalPosition| {
        window.dispatch_event(WindowEvent::PointerMoved { position });
        window.dispatch_event(WindowEvent::PointerPressed { position, button: PointerEventButton::Left });
        slint_testing::mock_elapsed_time(hold);
        window.dispatch_event(WindowEvent::PointerReleased { position, button: PointerEventButton::Left });
        slint_testing::mock_elapsed_time(300);
    };

    tap(TOUCH_AREA);
    assert_eq!(instance.get_clicked(), 1, "The TouchArea is clickable (press held for {hold}ms)");

    tap(EMPTY);
    assert_eq!(instance.get_clicked(), 1);

    window.dispatch_event(WindowEvent::PointerMoved { position: TOUCH_AREA });
    assert!(instance.get_touch_area_has_hover(), "The TouchArea gets hover events after a tap on empty content (press held for {hold}ms)");
    tap(TOUCH_AREA);
    assert_eq!(instance.get_clicked(), 2, "The TouchArea is clickable after a tap on empty content (press held for {hold}ms)");
}
