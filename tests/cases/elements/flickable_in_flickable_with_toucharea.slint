// The same two Flickables with an interactive element in the inner one
export component TestCaseTouchArea inherits Window {
    width: 500px;
    height: 500px;

    // Scrolling only vertical
    outer := Flickable {
        x: 10px;
        y: 10px;
        width: parent.width - 20px;
        height: parent.height - 20px;
        content-width: self.width;
        content-height: 980px;

        // Scrolling only horizontal
        inner := Flickable {
            content-width: 1500px;
            content-height: parent.height;

            touch-area := TouchArea {
                x: 100px;
                y: 100px;
                width: 200px;
                height: 50px;
                clicked => {
                    root.clicked += 1;
                }
            }
        }
    }

    in-out property<int> clicked;
    out property<bool> touch_area_has_hover: touch-area.has-hover;
    out property<length> inner_x: - inner.content-x;
}

