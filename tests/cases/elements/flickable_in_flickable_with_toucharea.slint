// Inside the TouchArea, before and after the inner Flickable is scrolled by 50px
const TOUCH_AREA: LogicalPosition = LogicalPosition::new(150., 135.);
let instance = TestCaseTouchArea::new().unwrap();
let window = instance.window();

window.dispatch_event(WindowEvent::PointerMoved { position: EMPTY });
window.dispatch_event(WindowEvent::PointerPressed { position: EMPTY, button: PointerEventButton::Left });
