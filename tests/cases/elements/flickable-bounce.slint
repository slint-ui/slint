export component TestCase inherits Window {
    width: 500phx;
    height: 500phx;

    fli := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        // The content size is the same as the flickable geometry. So no bouncing is enabled
        // The geometry will be changed below to enable the bounce
        content-height: parent.height;
        content-width: parent.width;
    }

    in-out property fli_width <=> fli.width;
    in-out property fli_height <=> fli.height;
    in-out property fli_content_width <=> fli.content_width;
    in-out property fli_content_height <=> fli.content_height;
    in-out property fli_content_x <=> fli.content_x;
    in-out property fli_content_y <=> fli.content_y;
}

/*
/// Check that bouncing is working as expected
```rust
use slint::language::AutoBool;

/// Simulate a mouse press at `(pressed_x, pressed_y)` and release at `(released_x, released_y)`
pub fn send_mouse_press_and_release<Component: slint::ComponentHandle>(
    component: &Component,
    pressed_x: f32,
    pressed_y: f32,
    released_x: f32,
    released_y: f32,
) {
    use slint::*;

    let window = component.window();
    let pressed_position = LogicalPosition::new(pressed_x, pressed_y);
    let released_position = LogicalPosition::new(released_x, released_y);
    let button = platform::PointerEventButton::Left;

    const NUM_MOVEMENTS: u64 = 10;
    const DURATION_MS: u64 = 50;
    const TIME_TO_RELEASE_MS: u64 = 2; // Below threshold
    let diff_x = (released_position.x - pressed_position.x) / NUM_MOVEMENTS as f32;
    let diff_y = (released_position.y - pressed_position.y) / NUM_MOVEMENTS as f32;

    window.dispatch_event(platform::WindowEvent::PointerMoved { position: pressed_position });
    window.dispatch_event(platform::WindowEvent::PointerPressed { position: pressed_position, button });
    for i in 0..NUM_MOVEMENTS {
        slint_testing::mock_elapsed_time(DURATION_MS / NUM_MOVEMENTS);
        window.dispatch_event(platform::WindowEvent::PointerMoved { position: LogicalPosition::new(pressed_position.x + i as f32 * diff_x, pressed_position.y + i as f32 * diff_y) });
    }
    slint_testing::mock_elapsed_time(TIME_TO_RELEASE_MS);
    window.dispatch_event(platform::WindowEvent::PointerReleased { position: released_position, button });
}

// use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
const INFINITE_TIME_SPEND: u64 = 100000000;
let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();
slint_testing::set_flickable_physics(&flickable, AutoBool::Off, AutoBool::Off);

// Try to scroll up
send_mouse_press_and_release(&instance, 5., 5., 5., 130.); // Finger moves down -> Scrolling up. Larger y is display bottom (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_y(), 0., "Bounce is off so scrolling up beyond the limit is not possible");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_y(), 0., "Bounce is off so scrolling up beyond the limit is not possible");

// Try to scroll down
send_mouse_press_and_release(&instance, 5., 130., 5., 5.); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_y(), 0., "Bounce is off so scrolling up beyond the limit is not possible");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_y(), 0., "Bounce is off so scrolling up beyond the limit is not possible");

// Try to scroll left
send_mouse_press_and_release(&instance, 5., 5., 130., 5.); // Finger moves right -> Scrolling left. Larger x is display right (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_x(), 0., "Bounce is off so scrolling left beyond the limit is not possible");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_x(), 0., "Bounce is off so scrolling left beyond the limit is not possible");

// Try to scroll right
send_mouse_press_and_release(&instance, 130., 5., 5., 5.); // Finger moves left -> Scrolling right.
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_x(), 0., "Bounce is off so scrolling right beyond the limit is not possible");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_x(), 0., "Bounce is off so scrolling right beyond the limit is not possible");

// Turning on Bouncing
slint_testing::set_flickable_physics(&flickable, AutoBool::On, AutoBool::Off);

// Change the content width to enable bouncing in the dimension y
instance.set_fli_content_height(instance.get_fli_height() + 40.);

// Try to scroll up again
send_mouse_press_and_release(&instance, 5., 5., 5., 130.); // Finger moves down -> Scrolling up. Larger y is display bottom (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert!(instance.get_fli_content_y() > 20., "We scrolled beyond the limits");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_y(), 0., "Bounced back");

// Try to scroll down again
send_mouse_press_and_release(&instance, 5., 130., 5., 5.); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);
assert!(instance.get_fli_content_y() < -20., "We scrolled beyond the limits");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert!((instance.get_fli_content_y() - (-40.)).abs() < 0.01, "Bounced back, received: {}", instance.get_fli_content_y());

// Try to scroll left -> Not possible because content size is smaller than actual geometry
send_mouse_press_and_release(&instance, 5., 5., 130., 5.); // Finger moves right -> Scrolling left. Larger x is display right (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_x(), 0., "Bouncing is not possible, because the content size is equal to the geometry");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_x(), 0., "Bouncing is not possible, because the content size is equal to the geometry");

// Try to scroll right -> Not possible because content size is smaller than actual geometry
send_mouse_press_and_release(&instance, 130., 5., 5., 5.); // Finger moves left -> Scrolling right.
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_x(), 0., "Bouncing is not possible, because the content size is equal to the geometry");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_x(), 0., "Bouncing is not possible, because the content size is equal to the geometry");

instance.set_fli_content_width(instance.get_fli_width() + 40.);
instance.set_fli_content_height(instance.get_fli_height());

// Try to scroll left again
send_mouse_press_and_release(&instance, 5., 5., 130., 5.); // Finger moves right -> Scrolling left. Larger x is display right (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert!(instance.get_fli_content_x() > 20., "We scrolled beyond the limits");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_x(), 0., "Bounced back");

// Try to scroll right again
send_mouse_press_and_release(&instance, 130., 5., 5., 5.); // Finger moves left -> Scrolling right.
slint_testing::mock_elapsed_time(5);
assert!(instance.get_fli_content_x() < -20., "We scrolled beyond the limits");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert!((instance.get_fli_content_x() - (-40.)).abs() < 0.01, "Bounced back, received: {}", instance.get_fli_content_x());

// Try to scroll up
send_mouse_press_and_release(&instance, 5., 5., 5., 130.); // Finger moves down -> Scrolling up. Larger y is display bottom (Diff: 5 - 130 = -125)
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_y(), 0., "Bouncing is not possible, because the content size is equal to the geometry");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_y(), 0., "Bouncing is not possible, because the content size is equal to the geometry");

// Try to scroll down
send_mouse_press_and_release(&instance, 5., 130., 5., 5.); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);
assert_eq!(instance.get_fli_content_y(), 0., "Bouncing is not possible, because the content size is equal to the geometry");
slint_testing::mock_elapsed_time(INFINITE_TIME_SPEND);
assert_eq!(instance.get_fli_content_y(), 0., "Bouncing is not possible, because the content size is equal to the geometry");
