export global MyGlobal {
    in-out property <bool> popup-open: false;
    in-out property <PopupAnchor> popup-anchor;

    in-out property <bool> anchor-location-correct: popup-anchor.location == PopupAnchorLocation.bottom-left;
    in-out property <bool> anchor-gravity-correct: popup-anchor.gravity == PopupGravity.bottom-right;

    in-out property <length> anchor-x: popup-anchor.x;
    in-out property <length> anchor-y: popup-anchor.y;
    in-out property <length> anchor-width: popup-anchor.width;
    in-out property <length> anchor-height: popup-anchor.height;
}

export component TestCase {
    width: 300px;
    height: 300px;

    // Important, otherwise the popup show will not be created
    TouchArea {
        clicked => {
            default-popup.show()
        }
    }

    callback show-popup();
    show-popup => {
        default-popup.show();
    }

    default-popup := PopupWindow {
        init => {
           MyGlobal.popup-open = true;
           MyGlobal.popup-anchor = self.anchor;
        }

        // Not all properties are specified
        anchor: {
            location: PopupAnchorLocation.bottom-left,
            x: root.x,
            y: root.y,
            width: root.width,
            height: root.height,
            gravity: PopupGravity.bottom-right,
            constraint-adjustment-y: {
                flip: true,
            }
        };

        changed anchor => {
            MyGlobal.popup-anchor = self.anchor;
        }
    }
}

/*

```rust
let instance = TestCase::new().unwrap();
assert_eq!(instance.global::<MyGlobal<'_>>().get_popup_open(), false);

instance.invoke_show_popup();

assert_eq!(instance.global::<MyGlobal<'_>>().get_popup_open(), true);

assert_eq!(instance.global::<MyGlobal<'_>>().get_anchor_location_correct(), true);
assert_eq!(instance.global::<MyGlobal<'_>>().get_anchor_gravity_correct(), true);

assert_eq!(instance.global::<MyGlobal<'_>>().get_popup-anchor(), true);
```
*/
