export component TestCase inherits Window {
    width: 500phx;
    height: 500phx;

    fli := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        // The content size is the same as the flickable geometry to test all for border limits
        content-height: parent.height * 100;
        content-width: parent.width;
    }

    in-out property fli_width <=> fli.width;
    in-out property fli_height <=> fli.height;
    in-out property fli_content_width <=> fli.content_width;
    in-out property fli_content_height <=> fli.content_height;
    in-out property fli_content_x <=> fli.content_x;
    in-out property fli_content_y <=> fli.content_y;
}

/*
/// Check that carry momentum is working as expected
// Testcase 1. Carry momentum is off
```rust
use slint_testing::AutoBool;

/// Simulate a mouse press at `(pressed_x, pressed_y)` and release at `(released_x, released_y)`
pub fn send_mouse_press_and_release<Component: slint::ComponentHandle>(
    component: &Component,
    pressed_x: f32,
    pressed_y: f32,
    released_x: f32,
    released_y: f32,
) {
    use slint::*;

    let window = component.window();
    let pressed_position = LogicalPosition::new(pressed_x, pressed_y);
    let released_position = LogicalPosition::new(released_x, released_y);
    let button = platform::PointerEventButton::Left;

    const NUM_MOVEMENTS: u64 = 10;
    const DURATION_MS: u64 = 10; // Must be shorter than MOMENTUM_RETAIN_TIMEOUT
    const TIME_TO_RELEASE_MS: u64 = 2; // Below threshold
    let diff_x = (released_position.x - pressed_position.x) / NUM_MOVEMENTS as f32;
    let diff_y = (released_position.y - pressed_position.y) / NUM_MOVEMENTS as f32;

    window.dispatch_event(platform::WindowEvent::PointerMoved { position: pressed_position });
    window.dispatch_event(platform::WindowEvent::PointerPressed { position: pressed_position, button });
    for i in 0..NUM_MOVEMENTS {
        slint_testing::mock_elapsed_time(DURATION_MS / NUM_MOVEMENTS);
        window.dispatch_event(platform::WindowEvent::PointerMoved { position: LogicalPosition::new(pressed_position.x + i as f32 * diff_x, pressed_position.y + i as f32 * diff_y) });
    }
    slint_testing::mock_elapsed_time(TIME_TO_RELEASE_MS);
    window.dispatch_event(platform::WindowEvent::PointerReleased { position: released_position, button });
}

let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();

// Scroll down with no carry momentum
slint_testing::set_flickable_physics(&flickable, AutoBool::Off, AutoBool::Off);
send_mouse_press_and_release(&instance, 5., 130., 5., 5.); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);

let content_y = instance.get_fli_content_y();
assert!(content_y < 0., "We started scrolling");
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!((velocity - (130. - 5.) / 10e-3).abs() < 100., "Received: {velocity}");

// Compare the same interval after release for both flings. The AOSP table's
// small nonzero first entry affects the first millisecond's finite difference.
let first_velocity = velocity;
// Flick again while the other is ongoing
send_mouse_press_and_release(&instance, 5., 130., 5., 5.); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);

let content_y = instance.get_fli_content_y();
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!((velocity - first_velocity).abs() < 1., "Received: {velocity}, first fling: {first_velocity}. There is no velocity increase because carry-momentum is off");
```

// Testcase 2. Carry momentum is on
```rust
use slint_testing::AutoBool;

/// Simulate a mouse press at `(pressed_x, pressed_y)` and release at `(released_x, released_y)`
pub fn send_mouse_press_and_release<Component: slint::ComponentHandle>(
    component: &Component,
    pressed_x: f32,
    pressed_y: f32,
    released_x: f32,
    released_y: f32,
) {
    use slint::*;

    let window = component.window();
    let pressed_position = LogicalPosition::new(pressed_x, pressed_y);
    let released_position = LogicalPosition::new(released_x, released_y);
    let button = platform::PointerEventButton::Left;

    const NUM_MOVEMENTS: u64 = 10;
    const DURATION_MS: u64 = 10; // Must be shorter than MOMENTUM_RETAIN_TIMEOUT
    const TIME_TO_RELEASE_MS: u64 = 2; // Below threshold
    let diff_x = (released_position.x - pressed_position.x) / NUM_MOVEMENTS as f32;
    let diff_y = (released_position.y - pressed_position.y) / NUM_MOVEMENTS as f32;

    window.dispatch_event(platform::WindowEvent::PointerMoved { position: pressed_position });
    window.dispatch_event(platform::WindowEvent::PointerPressed { position: pressed_position, button });
    for i in 0..NUM_MOVEMENTS {
        slint_testing::mock_elapsed_time(DURATION_MS / NUM_MOVEMENTS);
        window.dispatch_event(platform::WindowEvent::PointerMoved { position: LogicalPosition::new(pressed_position.x + i as f32 * diff_x, pressed_position.y + i as f32 * diff_y) });
    }
    slint_testing::mock_elapsed_time(TIME_TO_RELEASE_MS);
    window.dispatch_event(platform::WindowEvent::PointerReleased { position: released_position, button });
}

let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();

const FLICK_DISTANCE: f32 = 20.;

// Scroll down with no carry momentum
slint_testing::set_flickable_physics(&flickable, AutoBool::Off, AutoBool::On);
send_mouse_press_and_release(&instance, 5., 130., 5., 130. - FLICK_DISTANCE); // Finger moves up -> Scrolling down.
slint_testing::mock_elapsed_time(5);

let content_y = instance.get_fli_content_y();
assert!(content_y < 0., "We started scrolling");
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!((velocity - FLICK_DISTANCE / 10e-3).abs() < 30., "Received: {velocity}");

// Flick again, at the same strength, while the other is ongoing: this is
// the one flick that's strong enough to clear the momentum-retention
// threshold, so its velocity is boosted by the carried momentum.
send_mouse_press_and_release(&instance, 5., 130., 5., 130. - FLICK_DISTANCE); // Finger moves up -> Scrolling down.

let content_y = instance.get_fli_content_y();
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!(velocity.abs() > (2_f32 * FLICK_DISTANCE / 10e-3).abs(), "Received: {velocity}. There is a large velocity increase because the previous velocity is added to the newly estimated one");
```

Testcase 3. Carry momentum is on, driven by wheel/trackpad events instead of a mouse drag.
```rust
use slint_testing::AutoBool;

/// Simulate a trackpad scroll gesture at `(x, y)` covering `(delta_x, delta_y)` in total.
pub fn send_wheel_scroll<Component: slint::ComponentHandle>(
    component: &Component,
    x: f32,
    y: f32,
    delta_x: f32,
    delta_y: f32,
) {
    use slint::platform::WindowEvent;
    use slint_testing::{BackendMouseEvent, LogicalPoint, TouchPhase};

    let window = component.window();
    let position = LogicalPoint::new(x, y);

    const NUM_MOVEMENTS: u64 = 10;
    const DURATION_MS: u64 = 10; // Must be shorter than MOMENTUM_RETAIN_TIMEOUT
    const TIME_TO_END_MS: u64 = 2; // Below threshold
    let step_x = delta_x / NUM_MOVEMENTS as f32;
    let step_y = delta_y / NUM_MOVEMENTS as f32;

    window.dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel {
        position,
        delta_x: 0.,
        delta_y: 0.,
        phase: TouchPhase::Started,
    }));
    for _ in 0..NUM_MOVEMENTS {
        slint_testing::mock_elapsed_time(DURATION_MS / NUM_MOVEMENTS);
        window.dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel {
            position,
            delta_x: step_x,
            delta_y: step_y,
            phase: TouchPhase::Moved,
        }));
    }
    slint_testing::mock_elapsed_time(TIME_TO_END_MS);
    window.dispatch_event(WindowEvent::internal(BackendMouseEvent::Wheel {
        position,
        delta_x: 0.,
        delta_y: 0.,
        phase: TouchPhase::Ended,
    }));
}

let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli")
    .next()
    .unwrap();

const FLICK_DISTANCE: f32 = 20.;

// Scroll down with carry momentum
slint_testing::set_flickable_physics(&flickable, AutoBool::Off, AutoBool::On);
send_wheel_scroll(&instance, 5., 5., 0., -FLICK_DISTANCE); // Scrolling down.
slint_testing::mock_elapsed_time(5);

let content_y = instance.get_fli_content_y();
assert!(content_y < 0., "We started scrolling");
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!((velocity - FLICK_DISTANCE / 10e-3).abs() < 30., "Received: {velocity}");

// Flick again, at the same strength, while the other is ongoing: this one
// is strong enough to clear the momentum-retention threshold, so its
// velocity is boosted by the carried momentum.
send_wheel_scroll(&instance, 5., 5., 0., -FLICK_DISTANCE); // Scrolling down.

let content_y = instance.get_fli_content_y();
slint_testing::mock_elapsed_time(1);
let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
assert!(velocity.abs() > (2_f32 * FLICK_DISTANCE / 10e-3).abs(), "Received: {velocity}. There is a large velocity increase because the previous velocity is added to the newly estimated one");

// Real repeated same-strength, same-direction flicks (measured on a live iOS
// UIScrollView, see /home/martin/Downloads/iosFlick) keep compounding release over
// release; they don't alternate between a boosted and an un-boosted repeat.
let mut previous_velocity = velocity;
for i in 0..4 {
    send_wheel_scroll(&instance, 5., 5., 0., -FLICK_DISTANCE); // Scrolling down.

    let content_y = instance.get_fli_content_y();
    slint_testing::mock_elapsed_time(1);
    let velocity = (content_y - instance.get_fli_content_y()) / 0.001;
    assert!(velocity.abs() >= previous_velocity.abs(), "Iteration {i}. Received: {velocity}, previous: {previous_velocity}. Repeating the flick must not lose the carried momentum");
    previous_velocity = velocity;
}
```

// A same-direction touch flick that starts while the previous one is still gliding must
// still carry momentum, even with an unremarkable ~25ms gap between two tracked move
// samples (slower than an idealized 60Hz, but a plausible real cadence once dispatch and
// processing delay are accounted for). Real device timings for the flick shape used here:
// /home/martin/Downloads/iosFlick, uniform-flick-events-t1.csv.
```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
use slint_testing::AutoBool;

// One flick: press, drag upward in 25ms steps (a plausible touch/processing cadence,
// slower than an idealized 60Hz), release. Does not wait for the resulting animation to settle.
fn flick(window: &slint::Window) {
    const STEPS: u64 = 12;
    const STEP_MS: u64 = 25;
    const STEP_TRAVEL: f32 = 19.0; // -> roughly matches the measured ~780px/s release speed
    let start = LogicalPosition::new(200.0, 450.0);
    window.dispatch_event(WindowEvent::PointerMoved { position: start });
    window.dispatch_event(WindowEvent::PointerPressed { position: start, button: PointerEventButton::Left });
    let mut y = start.y;
    for _ in 0..STEPS {
        slint_testing::mock_elapsed_time(STEP_MS);
        y -= STEP_TRAVEL;
        window.dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(200.0, y) });
    }
    window.dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(200.0, y), button: PointerEventButton::Left });
}

fn settle(instance: &TestCase) {
    let mut last = instance.get_fli_content_y();
    loop {
        slint_testing::mock_elapsed_time(200);
        let now = instance.get_fli_content_y();
        if (now - last).abs() < 0.01 {
            break;
        }
        last = now;
    }
}

// Baseline: a single flick with nothing before or after it.
let baseline = TestCase::new().unwrap();
let baseline_flickable = slint_testing::ElementHandle::find_by_element_id(&baseline, "TestCase::fli").next().unwrap();
slint_testing::set_flickable_physics(&baseline_flickable, AutoBool::On, AutoBool::On);
flick(baseline.window());
let baseline_release_y = baseline.get_fli_content_y();
settle(&baseline);
let baseline_travel = (baseline.get_fli_content_y() - baseline_release_y).abs();

// The second flick interrupts the first one's still-running animation (60Hz touch delivery
// means ~17ms between samples, well over the retention timeout from before this fix), so it
// must carry momentum and travel noticeably farther, once settled, than the isolated baseline.
let instance = TestCase::new().unwrap();
let flickable = slint_testing::ElementHandle::find_by_element_id(&instance, "TestCase::fli").next().unwrap();
slint_testing::set_flickable_physics(&flickable, AutoBool::On, AutoBool::On);
flick(instance.window());
slint_testing::mock_elapsed_time(220); // real measured inter-flick gap
flick(instance.window());
let second_release_y = instance.get_fli_content_y();
settle(&instance);
let second_travel = (instance.get_fli_content_y() - second_release_y).abs();

assert!(
    second_travel > baseline_travel * 1.2,
    "The second flick should carry momentum from the still-running first one, \
     traveling noticeably farther once settled: baseline {baseline_travel}px, second flick {second_travel}px"
);
```
*/
