// A drag that first moves along an axis the Flickable can't pan,
// and then along an axis it can pan, still pans the Flickable. #13673

export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.clicked-count += 1; }

        f := Flickable {
            width: 100px;
            height: 100px;
            content-width: parent.width; // Only vertical flick
            content-height: 200px;
        }
    }

    out property <length> content-x: f.content-x;
    out property <length> content-y: f.content-y;
    out property <int> clicked-count;
}

/*

```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCase::new().unwrap();

instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
// Past the dead zone horizontally, but the content is exactly as wide as the Flickable
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(62.0, 50.0) });
assert_eq!(instance.get_content_x(), 0.);
assert_eq!(instance.get_content_y(), 0.);
// The vertical move pans the content
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(62.0, 10.0) });
assert_eq!(instance.get_content_x(), 0.);
assert_eq!(instance.get_content_y(), -40.);
slint_testing::mock_elapsed_time(1000);
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(62.0, 10.0), button: PointerEventButton::Left });
slint_testing::mock_elapsed_time(1000);
assert_eq!(instance.get_content_y(), -40.);
assert_eq!(instance.get_clicked_count(), 0, "The flickable flicked, so the TouchArea should not receive the event");
```

