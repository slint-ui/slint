```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCaseAfterHover::new().unwrap();

// Hover first, over the same spot the click will land on.
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(50.0, 50.0) });
// A plain click at that same spot must still reach the TouchArea underneath.
instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
assert_eq!(instance.get_counter(), 1);
```

```rust
use slint::{platform::WindowEvent, platform::PointerEventButton, LogicalPosition};
let instance = TestCaseDelayedStartDrag::new().unwrap();

instance.window().dispatch_event(WindowEvent::PointerPressed { position: LogicalPosition::new(50.0, 50.0), button: PointerEventButton::Left });
// Past the 100ms forward-delay timer, still well within the 500ms drag-recognition window.
slint_testing::mock_elapsed_time(150);
// Now move past the 8px distance threshold: this must still start a real drag.
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(50.0, 30.0) });
instance.window().dispatch_event(WindowEvent::PointerMoved { position: LogicalPosition::new(50.0, 10.0) });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: LogicalPosition::new(50.0, 10.0), button: PointerEventButton::Left });
assert_eq!(instance.get_content_y(), -40.);
assert_eq!(instance.get_counter(), 0);
```

```rust
use slint_testing::{InternalEvent, LogicalPoint, TouchPhase};
use slint::platform::WindowEvent;
let instance = TestCaseSecondFinger::new().unwrap();

// First finger presses over the pannable Flickable; the press is held back by `DelayForwarding`.
instance.window().dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 1, position: LogicalPoint::new(100.0, 100.0), phase: TouchPhase::Started }));
slint_testing::mock_elapsed_time(10);

// A second finger touches down elsewhere before the delay resolves. This synthesizes a `Released`
// for the first finger to clear its grab/delay state, but must not trigger the full-dispatch replay.
instance.window().dispatch_event(WindowEvent::internal(InternalEvent::Touch { id: 2, position: LogicalPoint::new(10.0, 10.0), phase: TouchPhase::Started }));
assert_eq!(instance.get_counter(), 0);
```

