// Timer, hover, and multi-touch edge cases of Flickable/SwipeGestureHandler's shared
// `DelayForwarding` mechanism for forwarding a plain click. See issue #13118.

// A plain click through a pannable Flickable must still reach the sibling TouchArea behind it,
// even when the pointer hovered over that same spot first.
// The hover leaves the TouchArea tracked for a deferred Exit,
// and resolving the click must not fire that stale Exit against the TouchArea the click itself just landed on
// (it would press/grab it and immediately cancel it).
export component TestCaseAfterHover inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    Flickable {
        width: 100px;
        height: 100px;
        content-width: 100px;
        content-height: 200px;

        Rectangle {
            width: 100px;
            height: 200px;
            background: gray;
        }
    }

    out property <int> counter: 0;
}

// A press held past Flickable's 100ms forward-delay, but still within the 500ms drag-recognition window,
// must still let a *later* move start a real drag.
// The 100ms timer only gives a descendant a chance to show press feedback,
// it must not itself hand the press to a sibling TouchArea.
// That would leave the Flickable unable to intercept the later drag-starting move,
// since a grabbed sibling routes future events to itself, not back through the Flickable.
export component TestCaseDelayedStartDrag inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    flick := Flickable {
        width: 100px;
        height: 100px;
        content-width: 100px;
        content-height: 200px;

        Rectangle {
            width: 100px;
            height: 200px;
            background: gray;
        }
    }

    out property <int> counter: 0;
    out property <length> content-y: flick.content-y;
}

// When a second finger touches down while a first finger's press on a pannable `Flickable` is still
// held back by `DelayForwarding`, touch gesture recognition synthesizes a `Released` for the first
// finger purely to clear its grab/delay state -- this must not be mistaken for that finger's own
// interaction ending, or the stored press would spuriously bubble to whatever is behind the Flickable.
// (This is a regression the release-triggered replay could otherwise introduce.)
export component TestCaseSecondFinger inherits Window {
    width: 200px;
    height: 200px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    Flickable {
        width: 200px;
        height: 200px;
        content-width: 300px;
        content-height: 300px;
    }

    out property <int> counter: 0;
}

// SwipeGestureHandler shares Flickable's DelayForwarding mechanism.
// A plain click (press + release, no swipe) with no interactive content of its own must be forwarded
// to the sibling TouchArea behind it, the same way an unclaimed Flickable press now is.
export component TestCaseSwipeGestureHandler inherits Window {
    width: 100px;
    height: 100px;

    TouchArea {
        clicked => { root.counter += 1; }
    }
    SwipeGestureHandler {
        width: 100px;
        height: 100px;
        handle-swipe-down: true;
    }

    out property <int> counter: 0;
}

