export component TestCase inherits Window {


    width: 500phx;
    height: 500phx;
    no-frame: false;

    f := Flickable {
        x: 10phx;
        y: 10phx;
        width: parent.width - 20phx;
        height: parent.height - 20phx;
        content_width: 2100phx;
        content_height: 2100phx;

        flicked => {
            root.flicked += self.content_x/1phx * 100000 + self.content_y/1phx;
        }

        inner_ta := TouchArea {
            x: 150phx;
            y: 150phx;
            width: 50phx;
            height: 50phx;
            Rectangle {
                background: parent.pressed ? blue : parent.has_hover ? green : red;
            }
            clicked => {
                root.clicked = self.mouse_x/1phx * 100000 + self.mouse_y/1phx;
            }
            double-clicked => {
                root.double-clicked = self.mouse_x/1phx * 100000 + self.mouse_y/1phx;
            }
        }

    }

    in-out property<length> offset_x: -f.content_x;
    in-out property<length> offset_y: -f.content_y;
    in-out property<bool> inner_ta_pressed: inner_ta.pressed;
    in-out property<bool> inner_ta_has_hover: inner_ta.has_hover;
    in-out property<int> clicked;
    in-out property<int> double-clicked;
    in-out property <int> flicked;
}

