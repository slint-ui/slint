```rust
use i_slint_core::input::{InternalKeyEvent, KeyEventType};
let instance = TestCase::new().unwrap();
instance.show().unwrap();
instance.invoke_focus_field();
let field = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Editable value").next().unwrap();
let placeholder = field.query_descendants().match_id("LineEdit::placeholder-label").find_first().unwrap();
let placeholder_visible = || field.query_descendants().match_id("LineEdit::placeholder-label").find_first().is_some();
assert!(placeholder_visible());
assert_eq!(placeholder.accessible_role(), Some(slint_testing::AccessibleRole::None));
let mut composition = InternalKeyEvent::default();
composition.event_type = KeyEventType::UpdateComposition;
composition.preedit_text = "東京".into();
composition.cursor_position = Some(6);
instance.window().dispatch_event(slint::platform::WindowEvent::internal(composition));
assert_eq!(instance.get_text(), "");
assert_eq!(instance.get_edits(), 0);
assert!(!placeholder_visible());
let mut cancel = InternalKeyEvent::default();
cancel.event_type = KeyEventType::UpdateComposition;
instance.window().dispatch_event(slint::platform::WindowEvent::internal(cancel));
assert!(placeholder_visible());
assert_eq!(instance.get_edits(), 0);
let mut commit = InternalKeyEvent::default();
commit.event_type = KeyEventType::CommitComposition;
commit.key_event.text = "東京".into();
instance.window().dispatch_event(slint::platform::WindowEvent::internal(commit));
assert_eq!(instance.get_text(), "東京");
assert_eq!(instance.get_edits(), 1);
assert_eq!(instance.get_submissions(), 0);
instance.set_text("".into());
assert!(placeholder_visible());
```

```rust
let instance = TestCase::new().unwrap();
instance.show().unwrap();
instance.invoke_focus_field();
let field = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Editable value").next().unwrap();
let input = field.query_descendants().match_id("LineEditBase::input").find_first().unwrap();
let viewport = field.query_descendants().match_id("LineEditBase::viewport").find_first().unwrap();
let placeholder = field.query_descendants().match_id("LineEdit::placeholder-label").find_first().unwrap();
let small_height = field.size().height;
instance.set_font_size(30.);
slint::platform::update_timers_and_animations();
assert!(field.size().height > small_height);
assert!((placeholder.size().height - viewport.size().height).abs() < 0.01);
let text = "Aé🦀e\u{301}東京 abcdefghijklmnopqrstuvwxyz";
instance.set_text(text.into());
for alignment in [i_slint_core::items::TextHorizontalAlignment::Left, i_slint_core::items::TextHorizontalAlignment::Center, i_slint_core::items::TextHorizontalAlignment::Right] {
    instance.set_alignment(alignment);
    for width in [100., 200., 140.] {
        instance.set_field_width(width);
        for decoration in [4., 20.] {
            instance.set_adornment_width(decoration);
            instance.invoke_select(text.len() as i32, text.len() as i32);
            slint::platform::update_timers_and_animations();
            assert!(viewport.size().width > 0.);
            assert!(input.absolute_position().x < viewport.absolute_position().x);
            let end = input.absolute_position().x + input.size().width;
            let edge = viewport.absolute_position().x + viewport.size().width;
            assert!(end <= edge && edge - end < 3.);
            instance.invoke_select(0, 0);
            slint::platform::update_timers_and_animations();
            let start_offset = input.absolute_position().x - viewport.absolute_position().x;
            assert!((-1. ..=0.01).contains(&start_offset),
                "alignment={alignment:?}, width={width}, decoration={decoration}, delta={}",
                start_offset);
        }
    }
}
```

