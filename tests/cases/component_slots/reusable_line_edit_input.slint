instance.invoke_paste();
assert_eq!(instance.get_text(), unicode);
assert_eq!(instance.get_edits(), edits);
instance.set_read_only(false);
instance.invoke_select_all();
instance.invoke_paste();
assert_eq!(instance.get_text(), "é🦀");
