import { LineEdit } from "../../../tools/editor/controls/src/basic.slint";
import { LineEditBase } from "../../../tools/editor/controls/src/headless.slint";
import { LineEditInterface } from "std-widget-interfaces.slint";

component PasswordField inherits LineEditBase {
    input-type: InputType.password;
    accessible-label: "Derived password";
    placeholder << Text {
        text: root.placeholder-text;
        width: 100%;
        height: 100%;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component ContractHost {
    slot <LineEditInterface> field;
    field { read-only: true; }
}

export component TestCase inherits Window {
    width: 540px;
    height: 320px;
    in-out property <string> text <=> field.text;
    in-out property <length> field-width: 200px;
    in-out property <length> font-size: 16px;
    in-out property <length> adornment-width: 20px;
    in-out property <TextHorizontalAlignment> alignment: left;
    in-out property <bool> read-only <=> field.read-only;
    in-out property <bool> enabled <=> secret.enabled;
    in-out property <bool> revealed <=> secret.password-revealed;
    in-out property <InputType> input-type <=> secret.input-type;
    in-out property <bool> styled-revealed <=> styled-secret.password-revealed;
    out property <string> password: secret.text;
    out property <bool> selected: field.has-selection;
    out property <bool> field-focused: field.has-focus;
    out property <bool> password-focused: secret.has-focus;
    out property <int> edits;
    out property <int> submissions;
    out property <bool> test: root.password == "secret" && !root.revealed;

    public function focus-field() { field.focus(); }
    public function focus-password() { secret.focus(); }
    public function focus-styled-password() { styled-secret.focus(); }
    public function select(anchor: int, focus: int) { field.set-selection-offsets(anchor, focus); }
    public function copy() { field.copy(); }
    public function paste() { field.paste(); }
    public function select-all() { field.select-all(); }
    public function cut-password() { secret.select-all(); secret.cut(); }
    public function copy-password() { secret.select-all(); secret.copy(); }

    field := LineEdit {
        x: 20px;
        y: 20px;
        width: root.field-width;
        height: self.min-height;
        font-size: root.font-size;
        horizontal-alignment: root.alignment;
        placeholder-text: "Enter a value";
        accessible-label: "Editable value";
        edited => { root.edits += 1; }
        accepted => { root.submissions += 1; }
        leading << Rectangle { width: root.adornment-width; height: 20px; background: #cccccc; }
        trailing << Rectangle { width: root.adornment-width; height: 20px; background: #cccccc; }
    }

    secret := PasswordField {
        x: 20px;
        y: 100px;
        width: 200px;
        height: 40px;
        text: "secret";
    }
    styled-secret := LineEdit {
        x: 280px;
        y: 100px;
        width: 220px;
        height: 40px;
        accessible-label: "Styled password";
        input-type: InputType.password;
        text: "styled-secret";
    }
    ContractHost {
        x: 20px;
        y: 180px;
        width: 200px;
        height: 40px;
        field << PasswordField { text: "contract-secret"; accessible-label: "Password contract"; }
    }
}

