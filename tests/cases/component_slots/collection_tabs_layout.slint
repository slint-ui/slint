import { CollectionTabWidget, CollectionTab } from "../../../tools/editor/controls/src/basic.slint";

component SizedTabs inherits CollectionTabWidget {
    in property <length> page-width;
    in property <length> page-height;
    out property <bool> pages-aligned: first.x == second.x && first.y == second.y
        && first.width == second.width && first.height == second.height;
    out property <length> content-x: first.absolute-position.x - root.absolute-position.x;
    out property <length> content-y: first.absolute-position.y - root.absolute-position.y;

    first := CollectionTab {
        title: "A";
        Rectangle { min-width: 80px; min-height: 30px; }
    }
    second := CollectionTab {
        title: "B";
        Rectangle {
            min-width: root.page-width;
            min-height: root.page-height;
            preferred-width: root.page-width + 60px;
            preferred-height: root.page-height + 20px;
        }
    }
}

export component TestCase inherits Window {
    width: 600px;
    height: 420px;
    in-out property <length> page-width: 280px;
    in-out property <length> page-height: 90px;
    in-out property <Orientation> orientation: Orientation.horizontal;
    in-out property <int> current-index <=> tabs.current-index;
    in-out property <length> wrapping-width: 400px;
    out property <length> tabs-min-width: tabs.min-width;
    out property <length> tabs-min-height: tabs.min-height;
    out property <length> tabs-preferred-width: tabs.preferred-width;
    out property <length> tabs-preferred-height: tabs.preferred-height;
    out property <length> wrapping-min-height: wrapping.min-height;
    out property <bool> pages-aligned: tabs.pages-aligned;
    out property <length> content-x: tabs.content-x;
    out property <length> content-y: tabs.content-y;
    out property <bool> test: tabs.min-width == root.page-width + 24px
        && tabs.min-height == root.page-height + 64px && empty.item-count == 0;

    tabs := SizedTabs {
        page-width: root.page-width;
        page-height: root.page-height;
        orientation: root.orientation;
    }
    empty := CollectionTabWidget { visible: false; }
    wrapping := CollectionTabWidget {
        visible: false;
        width: root.wrapping-width;
        CollectionTab { title: "A"; }
        CollectionTab {
            title: "B";
            VerticalLayout {
                Text {
                    text: "This inactive page has a long paragraph that must wrap into more lines when less width is available to the tab widget.";
                    wrap: word-wrap;
                }
            }
        }
    }
}

