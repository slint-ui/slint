assert_eq!(instance.get_value(), 3);
assert_eq!(instance.get_supplied_value(), 3);
slint_testing::mock_elapsed_time(1);
let host_changes = instance.get_host_changes();
let supplied_changes = instance.get_supplied_changes();

instance.set_value(7);
assert_eq!(instance.get_supplied_value(), 7);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_observed(), 7);
assert_eq!(instance.get_host_changes(), host_changes + 1);
assert_eq!(instance.get_supplied_changes(), supplied_changes + 1);

instance.invoke_set_supplied_value(11);
assert_eq!(instance.get_value(), 11);
slint_testing::mock_elapsed_time(1);
assert_eq!(instance.get_observed(), 11);
assert_eq!(instance.get_host_changes(), host_changes + 2);
assert_eq!(instance.get_supplied_changes(), supplied_changes + 2);
```
