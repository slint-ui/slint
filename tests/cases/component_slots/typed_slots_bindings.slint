interface ValueControl {
    in-out property <int> value;
}

component ValueImpl inherits Rectangle {
    implement ValueControl <=> self;
    in-out property <int> value;
    out property <int> changes;
    changed value => { root.changes += 1; }
    height: 20px;
}

component Host {
    in-out property <int> value: 3;
    out property <int> changes;
    out property <int> observed;
    slot <ValueControl> control;

    VerticalLayout {
        spacing: 0px;
        alignment: start;
        control {
            value <=> root.value;
            changed value => {
                root.observed = control.value;
                root.changes += 1;
            }
        }

        @children
    }
}

export component TestCase inherits Window {
    width: 100px;
    height: 80px;
    in-out property <int> value <=> host.value;
    out property <int> supplied-value: supplied.value;
    out property <int> host-changes: host.changes;
    out property <int> supplied-changes: supplied.changes;
    out property <int> observed: host.observed;
    public function set-supplied-value(value: int) { supplied.value = value; }

    host := Host {
        width: 100px;
        height: 80px;
        control << supplied := ValueImpl { }
        extra := Rectangle {
            height: 17px;
        }
    }

    out property <bool> test: supplied.height == 20px && extra.height == 17px
        && extra.absolute-position.y - supplied.absolute-position.y == 20px;
}

