let inside = slint::LogicalPosition::new(origin.x + size.width / 2., origin.y + size.height / 2.);
let outside = slint::LogicalPosition::new(origin.x + size.width + 10., origin.y + size.height / 2.);
instance.window().dispatch_event(WindowEvent::PointerPressed { position: inside, button: PointerEventButton::Left });
assert!(instance.get_basic_pressed());
instance.window().dispatch_event(WindowEvent::PointerMoved { position: outside });
assert!(!instance.get_basic_pressed());
assert!(!instance.get_basic_hovered());
instance.window().dispatch_event(WindowEvent::PointerReleased { position: outside, button: PointerEventButton::Left });
assert!(!instance.get_basic_pressed());
assert_eq!(instance.get_basic_clicks(), 4);

instance.window().dispatch_event(WindowEvent::PointerPressed { position: inside, button: PointerEventButton::Left });
instance.set_basic_enabled(false);
slint::platform::update_timers_and_animations();
instance.set_basic_enabled(true);
assert!(!instance.get_basic_pressed());
instance.window().dispatch_event(WindowEvent::PointerReleased { position: inside, button: PointerEventButton::Left });
assert_eq!(instance.get_basic_clicks(), 4);
assert_eq!(instance.get_basic_toggles(), 4);

instance.window().dispatch_event(WindowEvent::PointerPressed { position: inside, button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerMoved { position: outside });
assert!(!instance.get_basic_pressed());
instance.window().dispatch_event(WindowEvent::PointerMoved { position: inside });
assert!(instance.get_basic_pressed());
instance.window().dispatch_event(WindowEvent::PointerReleased { position: inside, button: PointerEventButton::Left });
assert!(!instance.get_basic_pressed());
assert_eq!(instance.get_basic_clicks(), 5);
assert_eq!(instance.get_basic_toggles(), 5);
assert!(instance.get_basic_checked());

instance.window().dispatch_event(WindowEvent::PointerPressed { position: inside, button: PointerEventButton::Left });
instance.window().dispatch_event(WindowEvent::PointerExited);
assert!(!instance.get_basic_pressed());
instance.window().dispatch_event(WindowEvent::PointerMoved { position: inside });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: inside, button: PointerEventButton::Left });
assert_eq!(instance.get_basic_clicks(), 5);
assert_eq!(instance.get_basic_toggles(), 5);

click(&find("Template"));
