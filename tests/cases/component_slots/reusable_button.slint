assert!(instance.get_test());
let find = |name: &str| {
    slint_testing::ElementHandle::find_by_accessible_label(&instance, name).next().unwrap()
};
let basic = find("Basic");
let disabled = find("Disabled");
let key = |key: Key, pressed: bool| {
    slint_testing::send_keyboard_char(&instance, key.into(), pressed);
};
let click = |element: &slint_testing::ElementHandle| {
    let origin = element.absolute_position();
    let size = element.size();
    slint_testing::send_mouse_click(&instance, origin.x + size.width / 2., origin.y + size.height / 2.);
};

instance.invoke_focus_basic();
key(Key::Space, true);
key(Key::Space, true);
assert!(instance.get_basic_pressed());
assert_eq!(instance.get_basic_clicks(), 0);
key(Key::Space, false);
assert!(!instance.get_basic_pressed());
assert_eq!(instance.get_basic_clicks(), 1);
assert!(instance.get_basic_checked());
assert_eq!(instance.get_basic_toggles(), 1);
assert_eq!(instance.get_basic_events(), "toggled:true;clicked;");
key(Key::Return, true);
key(Key::Return, false);
assert_eq!(instance.get_basic_clicks(), 2);
assert!(!instance.get_basic_checked());
assert_eq!(instance.get_basic_toggles(), 2);
assert_eq!(instance.get_basic_events(), "toggled:true;clicked;toggled:false;clicked;");
instance.set_basic_checked(true);
slint::platform::update_timers_and_animations();
instance.set_basic_checked(false);
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_basic_toggles(), 2);
assert_eq!(instance.get_basic_clicks(), 2);

key(Key::Space, true);
key(Key::Escape, true);
key(Key::Escape, false);
key(Key::Space, false);
assert_eq!(instance.get_basic_clicks(), 2);
assert!(!instance.get_basic_pressed());

key(Key::Space, true);
instance.invoke_focus_other();
assert!(!instance.get_basic_focused());
assert!(!instance.get_basic_pressed());
instance.invoke_focus_basic();
key(Key::Space, false);
assert_eq!(instance.get_basic_clicks(), 2);

key(Key::Space, true);
