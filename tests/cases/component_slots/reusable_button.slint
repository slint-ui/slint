import { Button } from "../../../tools/editor/controls/src/basic.slint";
import {
    ButtonBase,
} from "../../../tools/editor/controls/src/headless.slint";
import {
    ButtonInterface,
} from "std-widget-interfaces.slint";

component CustomButton inherits Button {
    content {
        Text {
            text: "Inherited content";
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component ButtonHost {
    slot <ButtonInterface> action;
    callback activated();
    action {
        enabled: true;
        clicked => { root.activated(); }
    }
}

export component TestCase inherits Window {
    width: 540px;
    height: 340px;
    in-out property <int> basic-clicks;
    in-out property <int> basic-toggles;
    in-out property <string> basic-events;
    in-out property <int> template-clicks;
    in-out property <int> custom-clicks;
    in-out property <int> inner-clicks;
    in-out property <int> outer-clicks;
    in-out property <int> contract-clicks;
    in-out property <int> headless-contract-clicks;
    in-out property <int> disabled-clicks;
    in-out property <bool> basic-enabled <=> basic.enabled;
    in-out property <bool> basic-checked <=> basic.checked;
    out property <bool> basic-pressed: basic.pressed;
    out property <bool> basic-hovered: basic.hovered;
    out property <bool> basic-focused: basic.has-focus;
    private property <int> probe-clicks;
    private property <int> probe-toggles;
    private property <int> disabled-toggles;
    in-out property <int> template-toggles;
    out property <bool> test: probe.checked && root.probe-clicks == 1 && root.probe-toggles == 1
        && !disabled.checked && root.disabled-clicks == 0 && root.disabled-toggles == 0
        && headless-action.checked && root.headless-contract-clicks == 1;

    public function focus-basic() { basic.focus(); }
    public function focus-other() { other-focus.focus(); }
    init => { probe.activate(); disabled.activate(); headless-action.activate(); }

    basic := Button {
        x: 20px;
        y: 20px;
        width: 160px;
        height: 44px;
        text: "Basic";
        checkable: true;
        toggled(checked) => {
            root.basic-toggles += 1;
            root.basic-events += checked ? "toggled:true;" : "toggled:false;";
        }
        clicked => {
            root.basic-clicks += 1;
            root.basic-events += "clicked;";
        }
    }

    custom := CustomButton {
        x: 20px;
        y: 80px;
        width: 160px;
        height: 44px;
        text: "Replaced default";
        background << Rectangle {
            background: #22c55e;
        }
        clicked => { root.custom-clicks += 1; }
    }

    bare := ButtonBase {
        x: 20px;
        y: 140px;
        width: 160px;
        height: 44px;
        text: "Template";
        background << Rectangle {
            background: rgb(37, 99, 235);
        }
        content << Text {
            text: bare.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        clicked => { root.template-clicks += 1; }
        toggled(checked) => { root.template-toggles += 1; }
    }

    disabled := Button {
        x: 20px;
        y: 200px;
        width: 160px;
        height: 44px;
        text: "Disabled";
        enabled: false;
        checkable: true;
        clicked => { root.disabled-clicks += 1; }
        toggled(checked) => { root.disabled-toggles += 1; }
    }

    outer := Button {
        x: 220px;
        y: 20px;
        width: 280px;
        height: 100px;
        text: "Outer";
        content << HorizontalLayout {
            Text {
                text: "Outer";
                horizontal-stretch: 1;
            }

            inner := Button {
                text: "Inner";
                width: 90px;
                clicked => { root.inner-clicks += 1; }
            }
        }
        clicked => { root.outer-clicks += 1; }
    }

    other-focus := FocusScope {
        x: 220px;
        y: 140px;
        width: 100px;
        height: 30px;
    }

    ButtonHost {
        x: 220px;
        y: 200px;
        width: 160px;
        height: 44px;
        action << Button {
            text: "Contract";
        }
        activated => { root.contract-clicks += 1; }
    }

    ButtonHost {
        x: 440px;
        y: 270px;
        width: 80px;
        height: 44px;
        action << headless-action := ButtonBase {
            text: "Headless contract";
            checkable: true;
        }
        activated => { root.headless-contract-clicks += 1; }
    }

    probe := Button {
        x: 20px;
        y: 270px;
        width: 160px;
        height: 44px;
        text: "Activation probe";
        checkable: true;
        clicked => { root.probe-clicks += 1; }
        toggled(checked) => { root.probe-toggles += 1; }
    }
}

