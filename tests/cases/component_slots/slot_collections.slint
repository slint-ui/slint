assert(instance->get_test());
instance->invoke_trigger_second();
assert(instance->get_last_index() == 1);
assert(instance->get_last_value() == 2);
instance->set_factor(5);
assert(instance->get_second_factor() == 5);
slint_testing::mock_elapsed_time(0);
assert(instance->get_observed_factor() == 5);
assert(instance->get_child_observed_factor() == 5);
instance->invoke_set_shared(13);
assert(instance->get_first_shared() == 13);
assert(instance->get_second_shared() == 13);
assert(instance->get_inherited_shared() == 0);
instance->invoke_trigger_second();
assert(instance->get_last_value() == 5);
```
