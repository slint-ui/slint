interface Entry {
    in property <int> position;
    in property <int> factor;
    in-out property <int> shared;
    callback triggered(value: int);
}

component EntryView {
    in property <int> position;
    in property <int> factor;
    in-out property <int> shared;
    out property <int> observed-factor;
    callback triggered(value: int);
    changed factor => { root.observed-factor = root.factor; }
    public function trigger() { root.triggered(root.position * root.factor); }
    Rectangle { width: 8px; height: 8px; background: green; }
    @children
}

component DecoratedEntry inherits EntryView {
    Rectangle { width: 4px; height: 4px; accessible-role: image; accessible-label: "Preserved decoration"; }
}

component EntryGroup {
    in property <int> factor: 2;
    in-out property <int> shared;
    out property <int> count: entries.length;
    out property <int> last-value: -1;
    out property <int> last-index: -1;
    out property <int> observed-factor;
    default slot <[implements Entry]> entries;
    helper := Rectangle { property <int> factor: root.factor; }
    HorizontalLayout {
        for entry[index] in entries: entry {
            position: index;
            factor: helper.factor;
            shared <=> root.shared;
            changed factor => {
            if index == 1 { root.observed-factor = entry.factor; }
            }
            triggered(value) => {
                root.last-index = index;
                root.last-value = value;
            }
        }
    }
}

component FixedGroup inherits EntryGroup {
    EntryView { }
    fixed-second := DecoratedEntry { }
    public function trigger-second() { fixed-second.trigger(); }
}

interface Positioned {
    in property <int> index;
    in property <int> length;
}

component PositionedView {
    in property <int> index;
    in property <int> length;
}

component SeveralSlots {
    slot <[implements Positioned]> leading;
    default slot <[implements Positioned]> trailing;
    slot <Entry> action;
    out property <int> leading-count: leading.length;
    out property <int> trailing-count: trailing.length;
    HorizontalLayout {
        Rectangle { width: 3px; }
        for child[index] in leading: child {
            index: index;
            length: leading.length;
        }
        action { position: 12; }
        for child[index] in trailing: child {
            index: index;
            length: trailing.length;
        }
        Rectangle { width: 4px; }
    }
}

component AnyChildren {
    default slot <[*]> children;
    out property <int> count: children.length;
    VerticalLayout { for child in children: child { } }
}

component DerivedPositionedView inherits PositionedView { }

component ComponentChildren {
    default slot <[PositionedView]> entries;
    out property <int> count: entries.length;
    HorizontalLayout {
        for entry[index] in entries: entry {
            index: index;
            length: entries.length;
        }
    }
}

component RectangleView inherits Rectangle { }
component RectangleChildren {
    default slot <[Rectangle]> entries;
    out property <int> count: entries.length;
    HorizontalLayout { for entry in entries: entry { width: 2px; height: 2px; } }
}

component component { }
component ComponentNamedComponent {
    default slot <[component]> entries;
    out property <int> count: entries.length;
    for entry in entries: entry { }
}

export component TestCase inherits Window {
    width: 300px;
    height: 200px;
    in-out property <int> factor <=> static-group.factor;
    in-out property <[string]> model: ["A", "B", "C"];
    out property <bool> test: static-group.count == 2 && repeated.count == 3
        && first.position == 0 && second.position == 1
        && inherited.count == 2 && empty.count == 0
        && multiple.leading-count == 2 && multiple.trailing-count == 1
        && leading-first.index == 0 && leading-second.index == 1
        && leading-second.length == 2 && trailing-first.index == 0
        && trailing-first.length == 1 && action.position == 12 && any.count == 2
        && nominal.count == 2 && nominal-first.index == 0 && nominal-second.index == 1
        && nominal-second.length == 2 && nominal-repeated.count == 3
        && rectangles.count == 2 && literal-name.count == 1;
    out property <int> static-count: static-group.count;
    out property <int> repeated-count: repeated.count;
    out property <int> nominal-repeated-count: nominal-repeated.count;
    out property <int> second-factor: second.factor;
    out property <int> observed-factor: static-group.observed-factor;
    out property <int> child-observed-factor: second.observed-factor;
    out property <int> first-shared: first.shared;
    out property <int> second-shared: second.shared;
    out property <int> inherited-shared: inherited.shared;
    out property <int> last-value: static-group.last-value;
    out property <int> last-index: static-group.last-index;
    out property <int> inherited-value: inherited.last-value;
    public function trigger-second() { second.trigger(); }
    public function trigger-inherited() { inherited.trigger-second(); }
    public function set-shared(value: int) { second.shared = value; }
    public function clear-model() { root.model = []; }
    VerticalLayout {
        static-group := EntryGroup {
            first := EntryView { }
            second := DecoratedEntry { }
        }
        repeated := EntryGroup {
            factor: 7;
            for label in root.model: EntryView { }
        }
        inherited := FixedGroup { factor: 9; }
        empty := EntryGroup { }
        multiple := SeveralSlots {
            leading << leading-first := PositionedView { }
            leading << leading-second := PositionedView { }
            action << action := EntryView { }
            trailing << trailing-first := PositionedView { }
        }
        any := AnyChildren {
            Rectangle { }
            Text { text: "User content"; }
        }
        nominal := ComponentChildren {
            entries << nominal-first := PositionedView { }
            entries << nominal-second := DerivedPositionedView { }
        }
        nominal-repeated := ComponentChildren {
            for label in root.model: DerivedPositionedView { }
        }
        rectangles := RectangleChildren { Rectangle { } RectangleView { } }
        literal-name := ComponentNamedComponent { component { } }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
instance.invoke_trigger_second();
assert_eq!(instance.get_last_index(), 1);
assert_eq!(instance.get_last_value(), 2);
instance.set_factor(5);
assert_eq!(instance.get_second_factor(), 5);
slint_testing::mock_elapsed_time(0);
assert_eq!(instance.get_observed_factor(), 5);
assert_eq!(instance.get_child_observed_factor(), 5);
instance.invoke_set_shared(13);
assert_eq!(instance.get_first_shared(), 13);
assert_eq!(instance.get_second_shared(), 13);
assert_eq!(instance.get_inherited_shared(), 0);
instance.invoke_trigger_second();
assert_eq!(instance.get_last_value(), 5);
instance.invoke_trigger_inherited();
assert_eq!(instance.get_inherited_value(), 9);
assert_eq!(slint_testing::ElementHandle::find_by_accessible_label(&instance, "Preserved decoration").count(), 2);
instance.invoke_clear_model();
slint_testing::mock_elapsed_time(0);
assert_eq!(instance.get_repeated_count(), 0);
assert_eq!(instance.get_nominal_repeated_count(), 0);
assert_eq!(instance.get_static_count(), 2);
```

```cpp
