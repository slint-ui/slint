use slint::platform::PointerEventButton;
use slint_testing::ElementHandle;
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
let find = |label: &str| {
    ElementHandle::find_by_accessible_label(&instance, label).next().unwrap()
};
let action = find("Toggle action");
let checkbox = find("Shared checkbox");
let switch = find("Shared switch");
let custom = find("Custom action");

action.mock_single_click(PointerEventButton::Right);
action.mock_single_click(PointerEventButton::Middle);
assert_eq!(instance.get_clicks(), 0);
assert!(!instance.get_selected());

action.mock_single_click(PointerEventButton::Left);
assert!(instance.get_selected());
assert_eq!(instance.get_events(), "button:on;");
assert_eq!(instance.get_toggles(), 0);
for element in [&action, &checkbox, &switch, &custom] {
    assert_eq!(element.accessible_checked(), Some(true));
}
checkbox.mock_single_click(PointerEventButton::Left);
assert!(!instance.get_selected());
switch.invoke_accessible_default_action();
assert!(instance.get_selected());
custom.invoke_accessible_default_action();
assert!(!instance.get_selected());
assert_eq!(instance.get_clicks(), 2);
assert_eq!(instance.get_toggles(), 2);
assert_eq!(instance.get_events(), "button:on;checkbox:off;switch:on;custom:off;");

instance.set_selected(true);
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_clicks(), 2);
assert_eq!(instance.get_toggles(), 2);
instance.set_actions_enabled(false);
slint::platform::update_timers_and_animations();
for element in [&action, &checkbox, &switch, &custom] {
    assert_eq!(element.accessible_checked(), Some(true));
    assert_eq!(element.accessible_enabled(), Some(false));
    element.invoke_accessible_default_action();
    element.mock_single_click(PointerEventButton::Left);
}
assert_eq!(instance.get_clicks(), 2);
assert_eq!(instance.get_toggles(), 2);
assert!(instance.get_selected());
