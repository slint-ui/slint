let instance = TestCase::new().unwrap();
instance.show().unwrap();
let combo = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Selection").next().unwrap();
let arrow = combo.query_descendants().match_type_name("Path").find_first().unwrap();
for height in [40., 160.] {
    for width in [8., 16., 32.] {
        instance.set_combo_height(height);
        instance.set_indicator_width(width);
        slint::platform::update_timers_and_animations();
        let left = arrow.absolute_position().x;
        let right = left + arrow.size().width;
        assert!((arrow.size().width - width).abs() < 0.01);
        assert!(left >= combo.absolute_position().x);
        assert!(right <= combo.absolute_position().x + combo.size().width);
        assert!(arrow.size().height <= combo.size().height);
    }
}
instance.invoke_focus_field();
instance.invoke_set_cursor(15);
slint::platform::update_timers_and_animations();
