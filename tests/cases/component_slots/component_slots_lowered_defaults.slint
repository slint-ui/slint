import { TabWidget } from "std-widgets.slint";

component Counting inherits Rectangle {
    in-out property <int> ticks;
    slot content << Timer {
        interval: 1ms;
        triggered => {
            root.ticks += 1;
        }
    }
    VerticalLayout {
        content { }
    }
}

component Middle inherits Rectangle {
    in-out property <int> ticks <=> counting.ticks;
    slot outer;
    counting := Counting {
        content << outer;
    }
}

component Filling inherits Counting {
    in-out property <int> derived-ticks;
    content << Timer {
        interval: 1ms;
        triggered => {
            root.derived-ticks += 1;
        }
    }
}

component TabCounting inherits TabWidget {
    in-out property <int> ticks;
    slot extra << Timer {
        interval: 1ms;
        triggered => {
            root.ticks += 1;
        }
    }
    Tab {
        title: "Tab";
    }
    extra { }
}

export component TestCase inherits Window {
    in-out property <int> kept-ticks: kept.ticks;
    in-out property <int> replaced-ticks: replaced.ticks;
    in-out property <int> cleared-ticks: cleared.ticks;
    in-out property <int> forwarded-ticks: forwarded.ticks;
    in-out property <int> forwarded-kept-ticks: forwarded-kept.ticks;
    in-out property <int> derived-base-ticks: derived.ticks;
    in-out property <int> derived-ticks: derived.derived-ticks;
    in-out property <int> derived-replaced-ticks: derived-replaced.ticks + derived-replaced.derived-ticks;
    in-out property <int> supplied-base-ticks: supplied.ticks;
    in-out property <int> supplied-ticks;
    in-out property <int> tab-kept-ticks: tab-kept.ticks;
    in-out property <int> tab-cleared-ticks: tab-cleared.ticks;

    VerticalLayout {
        kept := Counting { }

        replaced := Counting {
            content << Rectangle { }
        }

        cleared := Counting {
            content << { }
        }

        forwarded := Middle {
            outer << Rectangle { }
        }

        forwarded-kept := Middle { }

        derived := Filling { }

        derived-replaced := Filling {
            content << Rectangle { }
        }

        supplied := Counting {
            content << Timer {
                interval: 1ms;
                triggered => {
                    root.supplied-ticks += 1;
                }
            }
        }

        tab-kept := TabCounting { }

        tab-cleared := TabCounting {
            extra << { }
        }
    }
}

