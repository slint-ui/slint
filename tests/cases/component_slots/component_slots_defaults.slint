component Host inherits Rectangle {
    slot header << Rectangle {
        min-width: 300px;
        height: 11px;
    }
    slot footer << Rectangle {
        height: 17px;
    }
    min-width: layout.min-width;
    min-height: layout.min-height;
    layout := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        header { }

        Rectangle {
            height: 7px;
        }

        footer { }
    }
}

component AdjacentHost inherits Rectangle {
    slot first << Rectangle {
        height: 1px;
    }
    slot second << Rectangle {
        height: 2px;
    }
    slot third;
    min-height: layout.min-height;
    layout := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        first { }

        second { }

        third { }
    }
}

component Forwarded inherits Rectangle {
    slot heading;
    min-width: inner.min-width;
    min-height: inner.min-height;
    inner := Host {
        header << heading;
    }
}

component Counting inherits Rectangle {
    out property <int> inits;
    out property <int> ticks;
    slot content << Rectangle {
        init => {
            root.inits += 1;
        }
        Timer {
            interval: 1ms;
            triggered => {
                root.ticks += 1;
            }
        }
    }
    VerticalLayout {
        content { }
    }
}

component ForwardedCounting inherits Rectangle {
    out property <int> inits: inner.inits;
    out property <int> ticks: inner.ticks;
    slot outer;
    inner := Counting {
        content << outer;
    }
}

component HeaderOverride inherits Host {
    header << Rectangle {
        height: 2px;
    }
}

component SecondLevelOverride inherits HeaderOverride {
    header << Rectangle {
        height: 3px;
    }
}

component SecondLevel inherits HeaderOverride { }

component ThirdFilled inherits AdjacentHost {
    third << Rectangle {
        height: 4px;
    }
}

component ForwardedOverride inherits Forwarded {
    heading << Rectangle {
        height: 2px;
    }
}

component GapHost inherits Rectangle {
    slot lead;
    slot tail << Rectangle {
        height: 1px;
    }
    min-height: layout.min-height;
    layout := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        lead { }

        tail { }
    }
}

component GapFilled inherits GapHost {
    lead << Rectangle {
        height: 2px;
    }
}

component RootSlotHost inherits VerticalLayout {
    slot body << Rectangle {
        height: 1px;
    }
    padding: 0px;
    spacing: 0px;
    Rectangle {
        height: 10px;
    }

    body { }

    Rectangle {
        height: 100px;
    }
}

component RootSlotOverride inherits RootSlotHost {
    body << Rectangle {
        height: 2px;
    }
}

export component TestCase inherits Window {
    out property <bool> test: defaults.min-height == 35px && defaults.min-width == 300px
        && replaced-header.min-height == 29px && replaced-header.min-width == 20px
        && replaced-both.min-height == 15px
        && adjacent-defaults.min-height == 3px && adjacent-first.min-height == 6px
        && adjacent-second.min-height == 9px && adjacent-third.min-height == 11px
        && forwarded-defaults.min-height == 35px && forwarded-defaults.min-width == 300px
        && forwarded-replacement.min-height == 27px
        && replaced-counting.inits == 0 && kept-counting.inits == 1
        && forwarded-counting.inits == 0
        && derived-override.min-height == 26px && derived-override-2.min-height == 26px
        && derived-replaced.min-height == 28px
        && second-level-override.min-height == 27px
        && second-level-override-replaced.min-height == 29px
        && second-level-replaced.min-height == 28px
        && third-filled.min-height == 7px && third-filled-replaced.min-height == 11px
        && forwarded-override.min-height == 26px
        && forwarded-override-replaced.min-height == 27px
        && derived-override-footer-replaced.min-height == 14px
        && gap-filled.min-height == 3px && gap-filled-tail-replaced.min-height == 6px
        && gap-filled-lead-replaced.min-height == 4px
        && root-slot-override.min-height == 112px
        && root-slot-override-replaced.min-height == 114px
        && in-for.min-height == 56px && in-for-kept.min-height == 52px
        && in-if.min-height == 28px && in-if-kept.min-height == 26px;
    out property <int> replaced-ticks: replaced-counting.ticks;
    out property <int> kept-ticks: kept-counting.ticks;
    out property <int> forwarded-ticks: forwarded-counting.ticks;

    defaults := Host { }

    replaced-header := Host {
        header << Rectangle {
            min-width: 20px;
            height: 5px;
        }
    }

    replaced-both := Host {
        header << Rectangle {
            height: 3px;
        }
        footer << Rectangle {
            height: 5px;
        }
    }

    adjacent-defaults := AdjacentHost { }

    adjacent-first := AdjacentHost {
        first << Rectangle {
            height: 4px;
        }
    }

    adjacent-second := AdjacentHost {
        second << Rectangle {
            height: 8px;
        }
    }

    adjacent-third := AdjacentHost {
        third << Rectangle {
            height: 8px;
        }
    }

    forwarded-defaults := Forwarded { }

    forwarded-replacement := Forwarded {
        heading << Rectangle {
            height: 3px;
        }
    }

    replaced-counting := Counting {
        content << Rectangle { }
    }

    kept-counting := Counting { }

    forwarded-counting := ForwardedCounting {
        outer << Rectangle { }
    }

    derived-override := HeaderOverride { }

    derived-override-2 := HeaderOverride { }

    derived-replaced := HeaderOverride {
        header << Rectangle {
            height: 4px;
        }
    }

    second-level-override := SecondLevelOverride { }

    second-level-override-replaced := SecondLevelOverride {
        header << Rectangle {
            height: 5px;
        }
    }

    second-level-replaced := SecondLevel {
        header << Rectangle {
            height: 4px;
        }
    }

    third-filled := ThirdFilled { }

    third-filled-replaced := ThirdFilled {
        third << Rectangle {
            height: 8px;
        }
    }

    forwarded-override := ForwardedOverride { }

    forwarded-override-replaced := ForwardedOverride {
        heading << Rectangle {
            height: 3px;
        }
    }

    derived-override-footer-replaced := HeaderOverride {
        footer << Rectangle {
            height: 5px;
        }
    }

    gap-filled := GapFilled { }

    gap-filled-tail-replaced := GapFilled {
        tail << Rectangle {
            height: 4px;
        }
    }

    gap-filled-lead-replaced := GapFilled {
        lead << Rectangle {
            height: 3px;
        }
    }

    root-slot-override := RootSlotOverride { }

    root-slot-override-replaced := RootSlotOverride {
        body << Rectangle {
            height: 4px;
        }
    }

    in-for := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        for i in 2: HeaderOverride {
            header << Rectangle {
                height: 4px;
            }
        }
    }

    in-for-kept := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        for i in 2: HeaderOverride { }
    }

    in-if := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        if true: HeaderOverride {
            header << Rectangle {
                height: 4px;
            }
        }
    }

    in-if-kept := VerticalLayout {
        padding: 0px;
        spacing: 0px;
        if true: HeaderOverride { }
    }
}

