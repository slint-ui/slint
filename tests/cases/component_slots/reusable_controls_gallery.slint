for (field, placeholder_id) in [
    (&field, "LineEdit::placeholder-label"),
    (&decorated_field, "LineEditExamples::placeholder-label"),
] {
    field.set_accessible_value("");
    slint::platform::update_timers_and_animations();
    let viewport = field.query_descendants().match_id("LineEditBase::viewport").find_first().unwrap();
    let placeholder = field.query_descendants().match_id(placeholder_id).find_first().unwrap();
    assert!((placeholder.absolute_position().x - viewport.absolute_position().x).abs() < 0.01);
    assert!((placeholder.size().width - viewport.size().width).abs() < 0.01);
    assert!(viewport.absolute_position().x >= field.absolute_position().x + 12. - 0.01);
    assert!(viewport.absolute_position().x + viewport.size().width
        <= field.absolute_position().x + field.size().width - 12. + 0.01);
}
find("Button", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_page(), 0);
assert!(instance.get_test());
