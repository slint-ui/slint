```rust
use slint::platform::PointerEventButton;
use slint_testing::AccessibleRole;
let instance = TestCase::new().unwrap();
instance.show().unwrap();
assert!(instance.get_test());
let content_scroll = slint_testing::ElementHandle::find_by_element_id(&instance, "ControlsDemo::content-scroll")
    .next().unwrap();
let find = |label: &str, role: AccessibleRole| {
    let query = || slint_testing::ElementHandle::find_by_accessible_label(&instance, label)
        .find(|element| element.accessible_role() == Some(role));
    if let Some(element) = query() { return element; }
    content_scroll.scroll(0., 10_000.);
    for _ in 0..24 {
        slint::platform::update_timers_and_animations();
        if let Some(element) = query() { return element; }
        content_scroll.scroll(0., -content_scroll.size().height / 2.);
    }
    panic!("Missing {role:?} with label {label:?}")
};
let select_size = |label: &str| {
    find("Control size", AccessibleRole::Combobox).mock_single_click(PointerEventButton::Left);
    find(label, AccessibleRole::ListItem).mock_single_click(PointerEventButton::Left);
    slint::platform::update_timers_and_animations();
    assert_eq!(find("Control size", AccessibleRole::Combobox).accessible_value().as_deref(), Some(label));
};
assert_eq!(find("Control size", AccessibleRole::Combobox).accessible_value().as_deref(), Some("Medium"));
select_size("Small");
let small_height = find("Primary", AccessibleRole::Button).size().height;
select_size("Large");
for label in ["Primary", "Danger", "Secondary", "Invisible"] {
    assert!(find(label, AccessibleRole::Button).size().height > small_height);
