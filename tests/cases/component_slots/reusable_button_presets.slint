import {
    Button,
    ButtonStyle,
    ButtonSizeMetrics,
    ButtonSizes,
    ButtonStyles,
    BasicTheme,
} from "../../../tools/editor/controls/src/basic.slint";
export { ButtonSizes, ButtonStyles, BasicTheme }
export component TestCase inherits Window {
    width: 400px;
    height: 120px;
    in-out property <ButtonStyle> style: ButtonStyles.primary;
    in-out property <ButtonSizeMetrics> size: ButtonSizes.medium;
    in-out property <bool> enabled: true;
    in-out property <bool> checked;
    out property <int> activations;
    out property <brush> subject-background: subject.background-color;
    out property <brush> foreground: subject.foreground;
    out property <brush> border: subject.border-color;
    out property <bool> focused: subject.has-focus;
    out property <bool> pressed: subject.pressed;
    out property <length> font-size: subject.font-size;
    out property <length> icon-size: subject.icon-size;
    out property <length> spacing: subject.spacing;
    out property <length> subject-padding: subject.content-padding-left;
    out property <length> preset-font-size: overridden.font-size;
    out property <bool> test: overridden.background-color == #123456
        && overridden.foreground == #abcdef
        && subject.style == root.style;

    public function focus-subject() { subject.focus(); }
    public function activate-subject() { subject.activate(); }

    subject := Button {
        x: 20px;
        y: 20px;
        width: 160px;
        height: 50px;
        text: "Subject";
        style: root.style;
        size: root.size;
        enabled: root.enabled;
        checked: root.checked;
        clicked => { root.activations += 1; }
    }

    overridden := Button {
        x: 220px;
        y: 20px;
        width: 160px;
        height: 50px;
        text: "Override";
        size: ButtonSizes.large;
        style: root.style;
        enabled: root.enabled;
        background-color: #123456;
        foreground: #abcdef;
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton, WindowEvent};
let instance = TestCase::new().unwrap();
let presets = instance.global::<ButtonStyles<'_>>();
let inside = slint::LogicalPosition::new(100., 45.);
let outside = slint::LogicalPosition::new(390., 100.);
let subject = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Subject").next().unwrap();
let outline = || subject.query_descendants().match_id("Button::focus-outline").find_first();
let move_to = |position| instance.window().dispatch_event(WindowEvent::PointerMoved { position });
let press = || instance.window().dispatch_event(WindowEvent::PointerPressed {
    position: inside, button: PointerEventButton::Left,
});
let release = || instance.window().dispatch_event(WindowEvent::PointerReleased {
    position: inside, button: PointerEventButton::Left,
});

for style in [presets.get_secondary(), presets.get_primary(), presets.get_danger(), presets.get_invisible()] {
    instance.set_style(style.clone());
    move_to(outside);
    assert_eq!(instance.get_subject_background(), style.rest.background_color);
    assert_eq!(instance.get_foreground(), style.rest.foreground);
    move_to(inside);
    assert_eq!(instance.get_subject_background(), style.hover.background_color);
    assert_eq!(instance.get_foreground(), style.hover.foreground);
    instance.invoke_focus_subject();
    assert!(instance.get_focused());
    assert_eq!(instance.get_border(), style.hover.border_color);
    let ring = outline().expect("Focused button has no outline");
    let outset = style.focus_width + style.focus_offset;
    assert_eq!(ring.absolute_position().x, subject.absolute_position().x - outset);
    assert_eq!(ring.absolute_position().y, subject.absolute_position().y - outset);
    assert_eq!(ring.size().width, subject.size().width + 2. * outset);
    assert_eq!(ring.size().height, subject.size().height + 2. * outset);

    let before = instance.get_activations();
    press();
    assert!(instance.get_pressed());
    assert_eq!(instance.get_subject_background(), style.pressed.background_color);
    assert_eq!(instance.get_border(), style.pressed.border_color);
    release();
    assert_eq!(instance.get_activations(), before + 1);

    instance.set_enabled(false);
    assert!(outline().is_none());
    assert_eq!(instance.get_subject_background(), style.disabled.background_color);
    assert_eq!(instance.get_foreground(), style.disabled.foreground);
    assert!(instance.get_test());
    let before = instance.get_activations();
    press();
    release();
    instance.invoke_activate_subject();
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
    assert_eq!(instance.get_activations(), before);
    instance.set_enabled(true);
}

move_to(outside);
instance.invoke_focus_subject();
let before = instance.get_activations();
for key in [Key::Space, Key::Return] {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    assert_eq!(instance.get_subject_background(), instance.get_style().pressed.background_color);
    assert_eq!(instance.get_border(), instance.get_style().pressed.border_color);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
}
assert_eq!(instance.get_activations(), before + 2);

let mut custom = presets.get_primary();
custom.rest.background_color = slint::Color::from_rgb_u8(0x68, 0x21, 0xa8).into();
custom.hover.background_color = slint::Color::from_rgb_u8(0x58, 0x1c, 0x87).into();
custom.focus_width = 3.;
custom.focus_offset = 6.;
instance.set_style(custom.clone());
assert_eq!(instance.get_subject_background(), custom.rest.background_color);
assert_eq!(outline().unwrap().size().width, subject.size().width + 18.);
move_to(inside);
assert_eq!(instance.get_subject_background(), custom.hover.background_color);
instance.set_checked(true);
assert_eq!(instance.get_subject_background(), custom.hover.background_color);
assert!(instance.get_test());
let mut no_outline = custom.clone();
no_outline.focus_width = 0.;
instance.set_style(no_outline);
assert!(outline().is_none());
assert_eq!(instance.get_border(), custom.hover.border_color);
instance.set_style(custom.clone());

let sizes = instance.global::<ButtonSizes<'_>>();
for metrics in [sizes.get_small(), sizes.get_medium(), sizes.get_large()] {
    instance.set_size(metrics.clone());
    assert_eq!(instance.get_font_size(), metrics.font_size);
    assert_eq!(instance.get_icon_size(), metrics.icon_size);
    assert_eq!(instance.get_spacing(), metrics.spacing);
    assert_eq!(instance.get_subject_padding(), metrics.padding_horizontal);
    assert_eq!(instance.get_style(), custom);
}
let mut metrics = sizes.get_large();
metrics.font_size = 22.;
sizes.set_large(metrics.clone());
assert_eq!(instance.get_preset_font_size(), 22.);
metrics.font_size = 21.;
metrics.icon_size = 28.;
metrics.padding_horizontal = 18.;
instance.set_size(metrics);
assert_eq!(instance.get_font_size(), 21.);
assert_eq!(instance.get_icon_size(), 28.);
assert_eq!(instance.get_subject_padding(), 18.);
assert_eq!(instance.get_style(), custom);

let theme = instance.global::<BasicTheme<'_>>();
let styles = instance.global::<ButtonStyles<'_>>();
let accent = slint::Brush::from(slint::Color::from_rgb_u8(0x7c, 0x3a, 0xed));
theme.set_accent(accent.clone());
assert_eq!(styles.get_primary().rest.background_color, accent);
assert!(instance.get_test());
```
