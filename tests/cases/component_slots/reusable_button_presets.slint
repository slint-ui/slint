import {
    Button,
    ButtonStyle,
    ButtonStyles,
    BasicTheme,
} from "../../../tools/editor/controls/src/basic.slint";
export { ButtonStyles, BasicTheme }
export component TestCase inherits Window {
    width: 400px;
    height: 120px;
    in-out property <ButtonStyle> style: ButtonStyles.primary;
    in-out property <bool> enabled: true;
    in-out property <length> focus-width <=> subject.focus-width;
    in-out property <length> focus-offset <=> subject.focus-offset;
    out property <int> activations;
    out property <bool> focused: subject.has-focus;
    out property <bool> pressed: subject.pressed;
    in-out property <length> font-size <=> subject.font-size;
    in-out property <length> icon-size <=> subject.icon-size;
    in-out property <length> spacing <=> subject.spacing;
    in-out property <length> subject-padding <=> subject.horizontal-padding;
    in-out property <length> preset-font-size <=> overridden.font-size;
    out property <bool> test: overridden.style.rest.background-color == #123456
        && overridden.style.rest.foreground-color == #abcdef
        && subject.style == root.style;

    public function focus-subject() { subject.focus(); }
    public function activate-subject() { subject.activate(); }

    subject := Button {
        x: 20px;
        y: 20px;
        width: 160px;
        height: 50px;
        text: "Subject";
        style: root.style;
        enabled: root.enabled;
        clicked => { root.activations += 1; }
    }

    overridden := Button {
        x: 220px;
        y: 20px;
        width: 160px;
        height: 50px;
        text: "Override";
        font-size: 16px;
        style: {
            rest: {
                background-color: #123456,
                foreground-color: #abcdef,
                ..root.style.rest,
            },
            hover: {
                background-color: #123456,
                foreground-color: #abcdef,
                ..root.style.hover,
            },
            pressed: {
                background-color: #123456,
                foreground-color: #abcdef,
                ..root.style.pressed,
            },
            ..root.style,
        };
        enabled: root.enabled;
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton, WindowEvent};
let instance = TestCase::new().unwrap();
mod visuals { include!(concat!(env!("CARGO_MANIFEST_DIR"), "/control_visuals.rs")); }
let subject_background = || visuals::color(instance.window(), "TestCase::subject", "Button::surface");
let foreground_color = || visuals::color(instance.window(), "TestCase::subject", "Button::label");

let presets = instance.global::<ButtonStyles<'_>>();
let inside = slint::LogicalPosition::new(100., 45.);
let outside = slint::LogicalPosition::new(390., 100.);
let subject = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Subject").next().unwrap();
let outline = || subject.query_descendants().match_id("Button::focus-outline").find_first();
let move_to = |position| instance.window().dispatch_event(WindowEvent::PointerMoved { position });
let press = || instance.window().dispatch_event(WindowEvent::PointerPressed {
    position: inside, button: PointerEventButton::Left,
});
let release = || instance.window().dispatch_event(WindowEvent::PointerReleased {
    position: inside, button: PointerEventButton::Left,
});

for style in [presets.get_secondary(), presets.get_primary(), presets.get_danger(), presets.get_invisible()] {
    instance.set_style(style.clone());
    move_to(outside);
    assert_eq!(subject_background(), style.rest.background_color);
    assert_eq!(foreground_color(), style.rest.foreground_color);
    move_to(inside);
    assert_eq!(subject_background(), style.hover.background_color);
    assert_eq!(foreground_color(), style.hover.foreground_color);
    instance.invoke_focus_subject();
    assert!(instance.get_focused());
    let ring = outline().expect("Focused button has no outline");
    let outset = instance.get_focus_width() + instance.get_focus_offset();
    assert_eq!(ring.absolute_position().x, subject.absolute_position().x - outset);
    assert_eq!(ring.absolute_position().y, subject.absolute_position().y - outset);
    assert_eq!(ring.size().width, subject.size().width + 2. * outset);
    assert_eq!(ring.size().height, subject.size().height + 2. * outset);

    let before = instance.get_activations();
    press();
    assert!(instance.get_pressed());
    assert_eq!(subject_background(), style.pressed.background_color);
    release();
    assert_eq!(instance.get_activations(), before + 1);

    instance.set_enabled(false);
    assert!(outline().is_none());
    assert_eq!(subject_background(), style.disabled.background_color);
    assert_eq!(foreground_color(), style.disabled.foreground_color);
    assert!(instance.get_test());
    let before = instance.get_activations();
    press();
    release();
    instance.invoke_activate_subject();
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
    assert_eq!(instance.get_activations(), before);
    instance.set_enabled(true);
}

move_to(outside);
instance.invoke_focus_subject();
let before = instance.get_activations();
for key in [Key::Space, Key::Return] {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    assert_eq!(subject_background(), instance.get_style().pressed.background_color);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
}
assert_eq!(instance.get_activations(), before + 2);

let mut custom = presets.get_primary();
custom.rest.background_color = slint::Color::from_rgb_u8(0x68, 0x21, 0xa8).into();
custom.hover.background_color = slint::Color::from_rgb_u8(0x58, 0x1c, 0x87).into();
instance.set_focus_width(3.);
instance.set_focus_offset(6.);
instance.set_style(custom.clone());
assert_eq!(subject_background(), custom.rest.background_color);
assert_eq!(outline().unwrap().size().width, subject.size().width + 18.);
move_to(inside);
assert_eq!(subject_background(), custom.hover.background_color);
assert!(instance.get_test());
instance.set_focus_width(0.);
assert!(outline().is_none());
instance.set_focus_width(3.);

instance.set_preset_font_size(22.);
assert_eq!(instance.get_preset_font_size(), 22.);
assert_eq!(instance.get_font_size(), 14.);
for (font, icon, padding, spacing) in [(12., 16., 8., 4.), (16., 24., 16., 8.), (21., 28., 18., 7.)] {
    instance.set_font_size(font);
    instance.set_icon_size(icon);
    instance.set_subject_padding(padding);
    instance.set_spacing(spacing);
    assert_eq!(instance.get_font_size(), font);
    assert_eq!(instance.get_icon_size(), icon);
    assert_eq!(instance.get_subject_padding(), padding);
    assert_eq!(instance.get_spacing(), spacing);
    assert_eq!(instance.get_preset_font_size(), 22.);
    assert_eq!(instance.get_style(), custom);
}

let theme = instance.global::<BasicTheme<'_>>();
let styles = instance.global::<ButtonStyles<'_>>();
let accent = slint::Brush::from(slint::Color::from_rgb_u8(0x7c, 0x3a, 0xed));
let mut palette = theme.get_palette();
palette.accent = accent.clone();
theme.set_palette(palette);
assert_eq!(styles.get_primary().rest.background_color, accent);
assert!(instance.get_test());
```
