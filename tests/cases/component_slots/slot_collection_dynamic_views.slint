```rust
use slint::ComponentHandle;
use slint_testing::ElementHandle;
for composed in [false, true] {
    for mode in 0..3 {
        let instance = LifetimeTest::new().unwrap();
        instance.set_composed(composed);
        let names = std::rc::Rc::new(slint::VecModel::from(vec!["A".into(), "B".into()]));
        instance.set_names(names.clone().into());
        let weak = instance.as_weak();
        instance.on_mutate(move || {
            let instance = weak.upgrade().unwrap();
            match mode {
                0 => { names.remove(0); }
                1 => instance.set_names(std::rc::Rc::new(slint::VecModel::from(vec!["Replacement".into()])).into()),
                _ => instance.set_show_group(false),
            }
            ElementHandle::find_by_accessible_label(&instance, "Change B: 100").next();
        });
        ElementHandle::find_by_accessible_label(&instance, "Mutate A").next().unwrap()
            .invoke_accessible_default_action();
        let probe = instance.global::<CollectionProbe<'_>>();
        assert_eq!(probe.get_returned(), 1);
        assert_eq!(probe.get_after(), 0);
        assert_eq!(probe.get_after_call(), 0);
        assert_eq!(probe.get_completed(), 1);
        if mode == 0 {
            assert!(ElementHandle::find_by_accessible_label(&instance, "Change B: 100").next().is_some());
        }
    }
}
```

```rust
use slint::platform::WindowEvent;
use slint_testing::ElementHandle;
let instance = VirtualizedTest::new().unwrap();
let layout = || instance.window().dispatch_event(WindowEvent::PointerMoved {
    position: slint::LogicalPosition::new(1., 1.),
});
let button = |label: &str| ElementHandle::find_by_accessible_label(&instance, label)
    .find(|element| element.accessible_role() == Some(slint_testing::AccessibleRole::Button)).unwrap();
layout();
assert!(instance.get_constructions() > 0 && instance.get_constructions() < 200);
button("Change 0:B: 0").invoke_accessible_default_action();
button("Change 0:B: 1");
instance.invoke_scroll_to(80);
layout();
button("Change 80:B: 0").invoke_accessible_default_action();
button("Change 80:B: 1");
assert!(instance.get_constructions() < 200);
instance.invoke_scroll_to(0);
layout();
button("Change 0:B: 0");
```

