```cpp
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
for (bool composed : {false, true}) {
    for (int mode = 0; mode < 3; ++mode) {
        auto handle = LifetimeTest::create();
        handle->set_composed(composed);
        auto names = std::make_shared<slint::VectorModel<slint::SharedString>>(
            std::vector<slint::SharedString>{"A", "B"});
        handle->set_names(names);
        auto weak = slint::ComponentWeakHandle(handle);
        handle->on_mutate([weak, names, mode] {
            auto instance = weak.lock().value();
            if (mode == 0) {
                names->erase(0);
            } else if (mode == 1) {
                instance->set_names(std::make_shared<slint::VectorModel<slint::SharedString>>(
                    std::vector<slint::SharedString>{"Replacement"}));
            } else {
                instance->set_show_group(false);
            }
            slint::testing::ElementHandle::find_by_accessible_label(instance, "Change B: 100");
        });
        auto action = slint::testing::ElementHandle::find_by_accessible_label(handle, "Mutate A");
        assert_eq(action.size(), 1u);
        action[0].invoke_accessible_default_action();
        const auto &probe = handle->global<CollectionProbe>();
        assert_eq(probe.get_returned(), 1);
        assert_eq(probe.get_after(), 0);
        assert_eq(probe.get_after_call(), 0);
        assert_eq(probe.get_completed(), 1);
        if (mode == 0) {
            assert_eq(slint::testing::ElementHandle::find_by_accessible_label(handle, "Change B: 100").size(), 1u);
        }
    }
}
#endif
```

```cpp
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
auto handle = VirtualizedTest::create();
auto layout = [&] { handle->window().dispatch_pointer_move_event(slint::LogicalPosition({ 1., 1. })); };
auto button = [&](const char *label) {
    auto matches = slint::testing::ElementHandle::find_by_accessible_label(handle, label);
    for (const auto &element : matches) {
        if (element.accessible_role() == slint::language::AccessibleRole::Button)
            return element;
    }
    std::abort();
};
layout();
assert(handle->get_constructions() > 0 && handle->get_constructions() < 200);
button("Change 0:B: 0").invoke_accessible_default_action();
button("Change 0:B: 1");
handle->invoke_scroll_to(80);
layout();
button("Change 80:B: 0").invoke_accessible_default_action();
button("Change 80:B: 1");
assert(handle->get_constructions() < 200);
handle->invoke_scroll_to(0);
layout();
button("Change 0:B: 0");
#endif
```

