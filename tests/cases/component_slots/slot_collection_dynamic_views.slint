import { Button, ListView } from "std-widgets.slint";

interface Entry {
    in property <string> title;
    in-out property <int> value;
    in-out property <float> progress;
    public function reset();
    public function mutate() -> int;
    callback pinged();
}

component Item inherits Rectangle {
    in property <string> title;
    in-out property <int> value;
    in-out property <float> progress;
    animate progress { duration: root.title == "B" ? 200ms : 100ms; easing: linear; }
    callback pinged();
    public function reset() { root.value = 0; }
    public function mutate() -> int {
        root.pinged();
        root.value += 1;
        return root.value;
    }
    VerticalLayout {
        Text { text: "Page \{root.title}: \{root.value}"; }
        Text { text: "Progress \{root.title}: \{round(root.progress)}"; }
    }
}

export global CollectionProbe {
    in-out property <int> returned: -1;
    in-out property <int> after: -1;
    in-out property <int> after-call: -1;
    in-out property <int> completed;
}

component Editor inherits Rectangle {
    in property <string> title;
    in-out property <int> value;
    Button { text: "Proxy \{root.title}: \{root.value}"; clicked => { root.value += 10; } }
}

component EntryGroup inherits Rectangle {
    default slot <[implements Entry]> entries;
    VerticalLayout {
        for entry in entries: HorizontalLayout {
            Button {
                text: "Change \{entry.title}: \{entry.value}";
                clicked => { entry.value += 1; entry.pinged(); }
            }
            Button { text: "Reset \{entry.title}"; clicked => { entry.reset(); } }
            Button { text: "Animate \{entry.title}"; clicked => { entry.progress = 100; } }
            Button {
                text: "Mutate \{entry.title}";
                clicked => {
                    CollectionProbe.returned = entry.mutate();
                    CollectionProbe.after = entry.value;
                    entry.value = 999;
                    CollectionProbe.after-call = entry.mutate();
                    CollectionProbe.completed += 1;
                }
            }
            Editor { title: entry.title; value <=> entry.value; }
        }
        for entry in entries: Rectangle {
            for suffix in ["state"]: Text {
                text: "\{entry.title} \{suffix}: \{entry.value}";
            }
        }
        for entry in entries: entry { }
    }
}

component ComposedEntryGroup inherits Rectangle {
    default slot <[implements Entry]> entries;
    EntryGroup {
        for entry in entries: Item {
            title: entry.title;
            value <=> entry.value;
            progress <=> entry.progress;
            pinged => { entry.pinged(); }
        }
    }
    Rectangle { for entry in entries: entry { } }
}

export component TestCase inherits Window {
    width: 640px;
    height: 600px;
    in-out property <[[string]]> groups: [["A", "B"], ["C", "D"]];
    out property <int> pings;
    out property <bool> test: root.pings == 0;
    public function insert-first() { root.groups[0].insert(0, "Zero"); }
    public function remove-first() { root.groups[0].remove(0); }
    VerticalLayout {
        for names in root.groups: EntryGroup {
            for name in names: Item {
                title: name;
                pinged => { root.pings += 1; }
            }
        }
    }
}

export component LifetimeTest inherits Window {
    width: 640px;
    height: 600px;
    in-out property <[string]> names: ["A", "B"];
    in-out property <bool> show-group: true;
    in property <bool> composed;
    callback mutate();
    out property <bool> test: root.names.length == 2 && root.show-group;
    if root.show-group && !root.composed: EntryGroup {
        for name in root.names: Item {
            title: name;
            value: name == "B" ? 100 : 0;
            pinged => { root.mutate(); }
        }
    }
    if root.show-group && root.composed: ComposedEntryGroup {
        for name in root.names: Item {
            title: name;
            value: name == "B" ? 100 : 0;
            pinged => { root.mutate(); }
        }
    }
}

export component VirtualizedTest inherits Window {
    width: 640px;
    height: 240px;
    out property <int> constructions;
    out property <bool> test: root.constructions < 200;
    public function scroll-to(index: int) {
        list.ensure-row-visible(index, ScrollBehavior.instant);
    }
    list := ListView {
        for group in 100: Rectangle {
            height: 240px;
            EntryGroup {
                for name in ["A", "B"]: Item {
                    title: "\{group}:\{name}";
                    init => { root.constructions += 1; }
                }
            }
        }
    }
}

component FocusGroup {
    default slot <[FocusScope]> entries;
    HorizontalLayout {
        for entry[index] in entries: Button {
            text: "Focus \{index}";
            clicked => { entry.focus(); }
        }
    }
    for entry in entries: entry { }
}

export component FocusTest inherits Window {
    width: 300px;
    height: 120px;
    out property <int> focused-index: -1;
    out property <bool> test: root.focused-index == -1;
    FocusGroup {
        for index in 2: FocusScope {
            focus-gained => { root.focused-index = index; }
        }
    }
}

component InitView {
    in-out property <int> value;
    callback value-changed();
    changed value => { root.value-changed(); }
    init => { root.value += 1; }
}

component InitGroup {
    default slot <[Item]> entries;
    out property <int> value: entries[0].value;
    callback value-changed();
    VerticalLayout {
        for entry in entries: InitView {
            value <=> entry.value;
            value-changed => { root.value-changed(); }
        }
        for entry in entries: entry { }
    }
}

export component InitTest inherits Window {
    out property <int> changes;
    out property <bool> test: static-group.value == 6 && repeated-group.value == 6;
    static-group := InitGroup {
        value-changed => { root.changes += 1; }
        Item { value: 5; }
    }
    repeated-group := InitGroup {
        value-changed => { root.changes += 1; }
        for index in 1: Item { value: 5; }
    }
}

