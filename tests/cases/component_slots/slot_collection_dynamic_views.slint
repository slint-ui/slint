auto handle = TestCase::create();
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
const auto &instance = *handle;
auto button = [&](const char *label) {
    auto matches = slint::testing::ElementHandle::find_by_accessible_label(handle, label);
    assert_eq(matches.size(), 1u);
    return matches[0];
};
button("Change B: 0").invoke_accessible_default_action();
button("Change B: 1");
assert_eq(instance.get_pings(), 1);
button("Proxy B: 1").invoke_accessible_default_action();
button("Change B: 11");
button("Change A: 0");
button("Change D: 0");
instance.invoke_insert_first();
button("Proxy B: 11").invoke_accessible_default_action();
button("Change B: 21");
instance.invoke_remove_first();
button("Reset B").invoke_accessible_default_action();
button("Proxy B: 0");
button("Animate B").invoke_accessible_default_action();
slint_testing::mock_elapsed_time(100);
assert_eq(slint::testing::ElementHandle::find_by_accessible_label(handle, "Progress B: 50").size(), 1u);
slint_testing::mock_elapsed_time(100);
assert_eq(slint::testing::ElementHandle::find_by_accessible_label(handle, "Progress B: 100").size(), 1u);
#endif
