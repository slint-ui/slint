auto handle = FocusTest::create();
assert(handle->get_test());
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
for (int index : {1, 0}) {
    auto buttons = slint::testing::ElementHandle::find_by_accessible_label(handle, index ? "Focus 1" : "Focus 0");
    auto button = std::find_if(buttons.begin(), buttons.end(), [](const auto &element) {
        return element.accessible_role() == slint::language::AccessibleRole::Button;
    });
    assert(button != buttons.end());
    button->invoke_accessible_default_action();
    assert(handle->get_focused_index() == index);
}
#endif
