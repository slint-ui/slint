use slint_testing::{AccessibleRole, ElementHandle};
let instance = FocusTest::new().unwrap();
assert!(instance.get_test());
for index in [1, 0] {
    ElementHandle::find_by_accessible_label(&instance, &format!("Focus {index}"))
        .find(|element| element.accessible_role() == Some(AccessibleRole::Button)).unwrap()
        .invoke_accessible_default_action();
    assert_eq!(instance.get_focused_index(), index);
}
