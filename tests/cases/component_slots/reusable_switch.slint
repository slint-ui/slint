import { Switch } from "../../../tools/editor/controls/src/basic.slint";
import { SwitchBase } from "../../../tools/editor/controls/src/headless.slint";
import { SwitchInterface } from "std-widget-interfaces.slint";

component SwitchHost {
    slot <SwitchInterface> choice;
    callback toggled();
    choice {
        enabled: true;
        toggled => { root.toggled(); }
    }
}

component CustomSwitch inherits Switch {
    content {
        Text {
            text: "Replacement label";
            vertical-alignment: center;
        }
    }
}

export component TestCase inherits Window {
    width: 440px;
    height: 280px;
    in-out property <bool> enabled <=> basic.enabled;
    in-out property <bool> checked <=> basic.checked;
    out property <bool> pressed: basic.pressed;
    out property <bool> hovered: basic.hovered;
    out property <bool> focused: basic.has-focus;
    out property <int> toggles;
    out property <string> values;
    out property <int> custom-toggles;
    out property <int> contract-toggles;
    out property <int> disabled-toggles;
    out property <bool> test: !root.checked && disabled.checked;

    public function focus-basic() { basic.focus(); }
    public function focus-other() { other.focus(); }
    public function activate-basic() { basic.activate(); }
    public function activate-disabled() { disabled.activate(); }

    basic := Switch {
        x: 20px;
        y: 20px;
        width: 180px;
        height: 40px;
        text: "Basic switch";
        toggled => {
            root.toggles += 1;
            root.values += basic.checked ? "on;" : "off;";
        }
    }

    disabled := Switch {
        x: 20px;
        y: 80px;
        width: 180px;
        height: 40px;
        text: "Disabled switch";
        checked: true;
        enabled: false;
        toggled => { root.disabled-toggles += 1; }
    }

    CustomSwitch {
        x: 20px;
        y: 140px;
        width: 180px;
        height: 40px;
        text: "Custom switch";
        indicator << Rectangle {
            background: #0f766e;
        }
        toggled => { root.custom-toggles += 1; }
    }

    SwitchHost {
        x: 240px;
        y: 20px;
        width: 180px;
        height: 40px;
        choice << SwitchBase {
            text: "Headless contract";
        }
        toggled => { root.contract-toggles += 1; }
    }

    SwitchHost {
        x: 240px;
        y: 80px;
        width: 180px;
        height: 40px;
        choice << Switch {
            text: "Styled contract";
        }
        toggled => { root.contract-toggles += 1; }
    }

    other := FocusScope {
        x: 240px;
        y: 140px;
        width: 40px;
        height: 40px;
    }
}

