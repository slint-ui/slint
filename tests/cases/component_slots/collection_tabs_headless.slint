bar.scroll(0.0, 20.0);
assert_eq!(instance.get_current_index(), 1);
two.invoke_accessible_default_action();
assert_eq!(instance.get_current_index(), 1);
instance.set_count(0);
instance.set_bar_enabled(true);
instance.invoke_activate_invalid();
bar.scroll(0.0, 20.0);
