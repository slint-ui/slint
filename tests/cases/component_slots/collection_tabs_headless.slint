import { CollectionTabBar, CollectionTabBarBase, CollectionTabHeaderBase } from "../../../tools/editor/controls/src/headless.slint";

component CustomHeader inherits CollectionTabHeaderBase {
    min-width: 80px;
    min-height: 32px;
    Rectangle {
        background: root.selected ? blue : white;
        border-width: root.focused ? 2px : 0px;
        border-color: black;
        Text { text: root.title; }
    }
}

export component TestCase inherits Window {
    width: 300px;
    height: 80px;
    in-out property <bool> bar-enabled: true;
    in-out property <int> count: 2;
    out property <int> current-index: bar.current-index;
    out property <bool> test: root.current-index == 0;
    public function activate-invalid() {
        bar.activate(-1);
        bar.activate(root.count);
    }

    bar := CollectionTabBarBase {
        accessible-label: "Custom bar";
        item-count: root.count;
        enabled: root.bar-enabled;
        HorizontalLayout {
            for index in root.count: CustomHeader {
                title: index == 0 ? "One" : "Two";
                enabled: bar.enabled;
                selected: bar.current-index == index;
                focused: bar.focused-index == index;
                accessible-item-index: index;
                activated => { bar.activate(index); }
            }
        }
    }
}

export component DisabledHeaders inherits Window {
    width: 400px;
    height: 80px;
    in-out property <bool> all-disabled;
    in-out property <bool> last-enabled: true;
    in-out property <Orientation> orientation <=> bar.orientation;
    out property <int> current-index: bar.current-index;
    out property <int> focused-index: bar.focused-index;
    out property <bool> test: root.current-index == 1;
    public function activate(index: int) { bar.activate(index); }
    bar := CollectionTabBar {
        accessible-label: "Disabled headers";
        current-index: 1;
        for index in 5: CustomHeader {
            title: "Header \{index}";
            enabled: !root.all-disabled && (index == 1 || (index == 3 && root.last-enabled));
        }
    }
}

export component StaticDisabledHeaders inherits Window {
    width: 300px;
    height: 80px;
    out property <int> current-index: bar.current-index;
    out property <bool> test: root.current-index == 0;
    public function activate(index: int) { bar.activate(index); }
    bar := CollectionTabBar {
        accessible-label: "Static disabled headers";
        CustomHeader { title: "First"; }
        CustomHeader { title: "Disabled"; enabled: false; }
        CustomHeader { title: "Last"; }
    }
}

