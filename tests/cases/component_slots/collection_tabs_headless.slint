```rust
use slint::platform::Key;
use slint_testing::{AccessibleRole, ElementHandle};
let instance = DisabledHeaders::new().unwrap();
assert!(instance.get_test());
let bar = ElementHandle::find_by_accessible_label(&instance, "Disabled headers")
    .find(|element| element.accessible_role() == Some(AccessibleRole::TabList)).unwrap();
let key = |key: Key| slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(key));
instance.invoke_activate(1);
key(Key::RightArrow);
key(Key::Return);
assert_eq!(instance.get_current_index(), 3);
key(Key::Home);
key(Key::Return);
assert_eq!(instance.get_current_index(), 1);
key(Key::End);
key(Key::Space);
assert_eq!(instance.get_current_index(), 3);
key(Key::LeftArrow);
key(Key::Return);
assert_eq!(instance.get_current_index(), 1);
instance.invoke_activate(2);
assert_eq!(instance.get_current_index(), 1);
bar.scroll(0.0, -20.0);
assert_eq!(instance.get_current_index(), 3);
bar.scroll(0.0, 20.0);
assert_eq!(instance.get_current_index(), 1);
instance.set_orientation(slint::language::Orientation::Vertical);
key(Key::DownArrow);
slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
instance.set_last_enabled(false);
slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
assert_eq!(instance.get_current_index(), 1);
key(Key::Return);
assert_eq!(instance.get_current_index(), 1);
bar.scroll(0.0, -20.0);
assert_eq!(instance.get_current_index(), 1);
instance.set_all_disabled(true);
instance.invoke_activate(1);
bar.scroll(0.0, 20.0);
key(Key::End);
key(Key::Return);
assert_eq!(instance.get_current_index(), 1);
```

```rust
use slint_testing::{AccessibleRole, ElementHandle};
let instance = StaticDisabledHeaders::new().unwrap();
assert!(instance.get_test());
instance.invoke_activate(1);
assert_eq!(instance.get_current_index(), 0);
let bar = ElementHandle::find_by_accessible_label(&instance, "Static disabled headers")
    .find(|element| element.accessible_role() == Some(AccessibleRole::TabList)).unwrap();
bar.scroll(0.0, -20.0);
assert_eq!(instance.get_current_index(), 2);
bar.scroll(0.0, 20.0);
assert_eq!(instance.get_current_index(), 0);
```

