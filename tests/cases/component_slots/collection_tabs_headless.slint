    .find(|element| element.accessible_role() == Some(AccessibleRole::TabList)).unwrap();
let two = ElementHandle::find_by_accessible_label(&instance, "Two")
    .find(|element| element.accessible_role() == Some(AccessibleRole::Tab)).unwrap();
assert_eq!(bar.accessible_item_count(), Some(2));
two.mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 1);
assert_eq!(two.accessible_item_selected(), Some(true));
instance.invoke_activate_invalid();
assert_eq!(instance.get_current_index(), 1);
bar.scroll(0.0, 20.0);
assert_eq!(instance.get_current_index(), 0);
bar.scroll(0.0, -20.0);
assert_eq!(instance.get_current_index(), 1);
instance.set_bar_enabled(false);
