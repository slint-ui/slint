assert!(!instance.get_first_visible());
assert!(!instance.get_second_visible());
instance.set_current_index(9);
assert!(!instance.get_first_visible());
assert!(!instance.get_second_visible());
instance.set_current_index(1);
assert!(instance.get_second_visible());
assert_eq!(instance.get_repeated_pages(), 2);
assert_eq!(instance.get_repeated_headers(), 2);
instance.set_repeated_count(3);
assert_eq!(instance.get_repeated_pages(), 3);
assert_eq!(instance.get_repeated_headers(), 3);
```
