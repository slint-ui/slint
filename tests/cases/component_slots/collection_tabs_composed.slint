import { PageStack, CollectionTabHeaderBase } from "../../../tools/editor/controls/src/headless.slint";
import { CollectionTabBar, CollectionTabHeader } from "../../../tools/editor/controls/src/basic.slint";

component CustomHeader inherits CollectionTabHeaderBase {
    min-width: 100px;
    min-height: 40px;
    Rectangle { background: root.selected ? blue : white; }
    Text { text: root.title; accessible-role: none; }
}

export component TestCase inherits Window {
    width: 500px;
    height: 300px;
    in-out property <int> current-index <=> bar.current-index;
    in-out property <Orientation> orientation <=> bar.orientation;
    in-out property <length> content-padding: 18px;
    in-out property <int> repeated-count: 2;
    out property <int> constructions;
    out property <int> value: first.value;
    out property <bool> first-visible: first.visible;
    out property <bool> second-visible: second.visible;
    out property <length> content-x: first.absolute-position.x - stack.absolute-position.x;
    out property <length> stack-min-width: stack.min-width;
    out property <length> page-width: first.width;
    out property <length> stack-width: stack.width;
    out property <int> repeated-pages: repeated-stack.item-count;
    out property <int> repeated-headers: repeated-bar.item-count;
    out property <bool> test: stack.item-count == 2 && bar.item-count == 2 && empty.item-count == 0;

    VerticalLayout {
        padding: 10px;
        spacing: 12px;
        stack := PageStack {
            current-index: bar.current-index;
            content-padding: root.content-padding;
            first := Rectangle {
                in-out property <int> value;
                min-width: 80px;
                min-height: 60px;
                init => { root.constructions += 1; }
                Text { text: "Value: \{first.value}"; }
                TouchArea {
                    accessible-role: button;
                    accessible-label: "Increment page";
                    clicked => { first.value += 1; }
                }
            }
            second := Rectangle {
                min-width: 220px;
                min-height: 90px;
                init => { root.constructions += 1; }
                Text { text: "Second page"; }
            }
        }
        bar := CollectionTabBar {
            spacing: 16px;
            CollectionTabHeader { title: "First"; horizontal-padding: 24px; }
            CustomHeader { title: "Second"; }
        }
    }
    empty := PageStack { visible: false; }
    repeated-stack := PageStack {
        visible: false;
        for index in root.repeated-count: Rectangle { min-width: 20px; min-height: 20px; }
    }
    repeated-bar := CollectionTabBar {
        visible: false;
        for index in root.repeated-count: CollectionTabHeader { title: "Repeated \{index}"; }
    }
}

/*
```rust
