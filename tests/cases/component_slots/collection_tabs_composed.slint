let instance = TestCase::new().unwrap();
assert!(instance.get_test());
assert_eq!(instance.get_constructions(), 2);
assert!(instance.get_first_visible());
assert!(!instance.get_second_visible());
assert_eq!(instance.get_content_x(), 18.0);
assert_eq!(instance.get_stack_min_width(), 256.0);
assert_eq!(instance.get_stack_width(), 480.0);
assert_eq!(instance.get_page_width(), 444.0);
let tab = |label: &str| ElementHandle::find_by_accessible_label(&instance, label)
    .find(|element| element.accessible_role() == Some(AccessibleRole::Tab)).unwrap();
assert_eq!(tab("First").absolute_position().y, tab("Second").absolute_position().y);
assert_eq!(tab("Second").absolute_position().x - tab("First").absolute_position().x
    - tab("First").size().width, 16.0);
ElementHandle::find_by_accessible_label(&instance, "Increment page").next().unwrap()
    .mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_value(), 1);
tab("Second").mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 1);
assert!(!instance.get_first_visible());
assert!(instance.get_second_visible());
assert_eq!(tab("Second").accessible_item_selected(), Some(true));
assert_eq!(instance.get_constructions(), 2);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Home));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 0);
assert!(instance.get_first_visible());
assert_eq!(instance.get_value(), 1);
instance.set_orientation(slint::language::Orientation::Vertical);
assert_eq!(tab("First").absolute_position().x, tab("Second").absolute_position().x);
assert_eq!(tab("Second").absolute_position().y - tab("First").absolute_position().y
    - tab("First").size().height, 16.0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::DownArrow));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 1);
instance.set_orientation(slint::language::Orientation::Horizontal);
instance.set_content_padding(24.0);
assert_eq!(instance.get_content_x(), 24.0);
assert_eq!(instance.get_stack_min_width(), 268.0);
assert_eq!(instance.get_page_width(), 432.0);
