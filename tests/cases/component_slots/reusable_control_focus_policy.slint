import { Button, CheckBox, Switch } from "../../../tools/editor/controls/src/basic.slint";

export component TestCase inherits Window {
    width: 500px;
    height: 330px;
    in-out property <bool> click-focus: true;
    in-out property <bool> actions-enabled: true;
    out property <bool> editor-focused: editor.has-focus;
    out property <bool> toolbar-focused: toolbar.has-focus;
    out property <bool> action-focused: action.has-focus;
    out property <bool> checkbox-focused: checkbox.has-focus;
    out property <bool> switch-focused: toggle.has-focus;
    out property <int> activations;
    out property <bool> test: root.activations == 0;

    public function focus-editor() { editor.focus(); }

    editor := TextInput {
        x: 20px;
        y: 20px;
        width: 200px;
        height: 32px;
        text: "Edit without losing focus";
    }
    toolbar := Button {
        x: 250px;
        y: 20px;
        width: 160px;
        height: 32px;
        text: "Reveal action";
        focus-on-tab-navigation: false;
        clicked => { root.activations += 1; }
    }
    action := Button {
        x: 20px;
        y: 90px;
        width: 200px;
        height: 44px;
        text: "Form action";
        enabled: root.actions-enabled;
        focus-on-click: root.click-focus;
        clicked => { root.activations += 1; }
    }
    checkbox := CheckBox {
        x: 20px;
        y: 160px;
        width: 200px;
        height: 44px;
        text: "Form checkbox";
        focus-on-click: root.click-focus;
        toggled => { root.activations += 1; }
    }
    toggle := Switch {
        x: 20px;
        y: 230px;
        width: 200px;
        height: 44px;
        text: "Form switch";
        focus-on-click: root.click-focus;
        toggled => { root.activations += 1; }
    }
}

