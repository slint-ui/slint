import { LineEdit } from "../../../tools/editor/controls/src/basic.slint";
import {
    LineEditBase,
} from "../../../tools/editor/controls/src/headless.slint";
import { LineEditInterface } from "std-widget-interfaces.slint";

component LineEditHost {
    slot <LineEditInterface> field;
    out property <string> text: field.text;
    out property <bool> selected: field.has-selection;
    out property <int> edits;
    public function select-all() { field.select-all(); }
    field {
        enabled: true;
        placeholder-text: "Contract placeholder";
        edited(value) => { root.edits += 1; }
    }
}

export component TestCase inherits Window {
    width: 600px;
    height: 320px;
    in-out property <string> text <=> basic.text;
    in-out property <bool> enabled <=> basic.enabled;
    in-out property <bool> read-only <=> basic.read-only;
    out property <bool> focused: basic.has-focus;
    out property <bool> hovered: basic.hovered;
    out property <bool> selected: basic.has-selection;
    out property <bool> read-only-focused: immutable.has-focus;
    out property <int> edits;
    out property <int> submissions;
    out property <string> last-edit;
    out property <string> last-submission;
    out property <int> key-presses;
    out property <int> key-releases;
    out property <string> password: secret.text;
    out property <string> contract-text: host.text;
    out property <int> contract-edits: host.edits;
    out property <bool> contract-selected: host.selected;
    out property <bool> test: root.text == "initial" && !root.read-only;

    public function focus-basic() { basic.focus(); }
    public function focus-other() { other.focus(); }
    public function select-all() { basic.select-all(); }
    public function clear-selection() { basic.clear-selection(); }
    public function set-selection-offsets(anchor: int, focus: int) { basic.set-selection-offsets(anchor, focus); }
    public function copy() { basic.copy(); }
    public function cut() { basic.cut(); }
    public function paste() { basic.paste(); }
    public function undo() { basic.undo(); }
    public function redo() { basic.redo(); }
    public function copy-read-only() { immutable.select-all(); immutable.copy(); }
    public function copy-password() { secret.select-all(); secret.copy(); secret.cut(); }
    public function focus-contract() { supplied.focus(); }
    public function select-contract() { host.select-all(); }

    basic := LineEdit {
        x: 20px;
        y: 20px;
        width: 220px;
        height: 40px;
        accessible-label: "Basic field";
        text: "initial";
        placeholder-text: "Type here";
        edited(value) => { root.edits += 1; root.last-edit = value; }
        accepted(value) => { root.submissions += 1; root.last-submission = value; }
        key-pressed(event) => {
            root.key-presses += 1;
            return event.text == "x" ? accept : reject;
        }
        key-released(event) => { root.key-releases += 1; return reject; }
    }

    immutable := LineEdit {
        x: 20px;
        y: 80px;
        width: 220px;
        height: 40px;
        accessible-label: "Read-only field";
        text: "Read only";
        read-only: true;
    }

    LineEdit {
        x: 20px;
        y: 140px;
        width: 220px;
        height: 40px;
        accessible-label: "Disabled field";
        text: "Disabled";
        enabled: false;
    }

    secret := LineEdit {
        x: 20px;
        y: 200px;
        width: 220px;
        height: 40px;
        accessible-label: "Password field";
        text: "secret";
        input-type: InputType.password;
    }

    other := FocusScope {
        x: 20px;
        y: 260px;
        width: 40px;
        height: 40px;
    }

    host := LineEditHost {
        x: 300px;
        y: 20px;
        width: 220px;
        height: 40px;
        field << supplied := LineEditBase {
            accessible-label: "Headless contract";
            text: "contract";
        }
    }

    LineEditHost {
        x: 300px;
        y: 80px;
        width: 220px;
        height: 40px;
        field << LineEdit {
            accessible-label: "Styled contract";
        }
    }
}

