import { ComboBox } from "../../../tools/editor/controls/src/basic.slint";

export component TestCase inherits Window {
    width: 640px;
    height: 280px;
    in-out property <[string]> model;
    in-out property <int> current-index <=> combo.current-index;
    in-out property <string> current-value <=> combo.current-value;
    in-out property <length> text-size: 14px;
    in-out property <length> label-padding: 6px;
    out property <bool> expanded: combo.expanded;
    out property <bool> focused: combo.has-focus;
    out property <int> highlighted-index: combo.highlighted-index;
    out property <int> selections;
    out property <bool> test: root.current-index == -1 && root.current-value == "";
    public function open() { combo.open(); }
    public function focus-combo() { combo.focus(); }
    public function focus-next() { next.focus(); }
    combo := ComboBox {
        accessible-label: "Dynamic selection";
        x: 20px;
        y: 20px;
        width: 220px;
        height: 40px;
        model: root.model;
        maximum-visible-items: 2;
        selected(value) => { root.selections += 1; }
    }
    next := FocusScope {
        x: 300px;
        y: 20px;
        width: 40px;
        height: 40px;
    }
    VerticalLayout {
        y: 120px;
        width: 300px;
        height: 1px;
        ComboBox {
            accessible-label: "Sized selection";
            model: ["An enlarged label"];
            font-size: root.text-size;
            vertical-padding: root.label-padding;
        }
    }
    ComboBox {
        accessible-label: "Preferred selection";
        x: 20px;
        y: 200px;
        width: self.preferred-width;
        height: self.preferred-height;
        model: ["Wide"];
        indicator-width: 300px;
        horizontal-padding: 40px;
        font-size: 36px;
    }
}

/*
```rust
