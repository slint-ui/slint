model.remove(2);
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_highlighted_index(), 1);
slint_testing::send_keyboard_char(&instance, Key::Escape.into(), true);
slint_testing::send_keyboard_char(&instance, Key::Escape.into(), false);
assert!(!instance.get_expanded());
assert_eq!(instance.get_current_value(), "Renamed");
assert_eq!(instance.get_selections(), 0);
instance.invoke_open();
model.remove(1);
model.remove(0);
slint::platform::update_timers_and_animations();
assert!(!instance.get_expanded());
assert!(instance.get_focused());
assert_eq!(instance.get_current_index(), -1);
assert_eq!(instance.get_current_value(), "");
assert_eq!(instance.get_highlighted_index(), -1);
model.push("Replacement".into());
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_current_index(), -1);
assert_eq!(instance.get_current_value(), "");
instance.invoke_open();
slint_testing::send_keyboard_char(&instance, Key::Return.into(), true);
slint_testing::send_keyboard_char(&instance, Key::Return.into(), false);
assert_eq!(instance.get_current_value(), "Replacement");
assert_eq!(instance.get_selections(), 1);
instance.invoke_open();
instance.invoke_focus_next();
slint::platform::update_timers_and_animations();
assert!(!instance.get_expanded());
assert!(!instance.get_focused());
instance.set_model(std::rc::Rc::new(VecModel::<SharedString>::default()).into());
slint::platform::update_timers_and_animations();
assert!(!instance.get_focused());
assert_eq!(instance.get_selections(), 1);
for (font, padding) in [(14., 6.), (36., 6.), (14., 20.)] {
    instance.set_text_size(font);
    instance.set_label_padding(padding);
    slint::platform::update_timers_and_animations();
    let control = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Sized selection").next().unwrap();
    let label = control.query_descendants().match_type_name("Text").find_all().into_iter()
        .find(|text| text.size().width > 0.).unwrap();
    let position = control.absolute_position();
    let label_position = label.absolute_position();
    assert!(label_position.y >= position.y + padding - 0.1);
    assert!(label_position.y + label.size().height <= position.y + control.size().height - padding + 0.1,
        "A {font}px combo label overflows {}px high control with {padding}px padding", control.size().height);
