use slint::platform::Key;
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
let wide = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Preferred selection").next().unwrap();
let arrow = wide.query_descendants().match_type_name("Path").find_first().unwrap();
assert!(arrow.absolute_position().x + arrow.size().width <= wide.absolute_position().x + wide.size().width - 40. + 0.1,
    "The ComboBox preferred size clips its configured indicator");
let model = std::rc::Rc::new(VecModel::from(vec!["Duplicate".into(), "Other".into(), "Duplicate".into()]));
// https://github.com/slint-ui/slint/issues/7632
instance.set_model(model.clone().into());
instance.set_current_index(2);
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_current_index(), 2);
assert_eq!(instance.get_current_value(), "Duplicate");
assert_eq!(instance.get_selections(), 0);
instance.invoke_focus_combo();
for modifier in [Key::Control, Key::Meta] {
    slint_testing::send_keyboard_char(&instance, modifier.into(), true);
    slint_testing::send_keyboard_char(&instance, Key::UpArrow.into(), true);
    slint_testing::send_keyboard_char(&instance, Key::UpArrow.into(), false);
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
    slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
    slint_testing::send_keyboard_char(&instance, modifier.into(), false);
    assert_eq!(instance.get_current_index(), 2, "A modified arrow changed the selection");
    assert_eq!(instance.get_selections(), 0);
    assert!(!instance.get_expanded());
}
instance.set_current_value("Duplicate".into());
