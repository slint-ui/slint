assert_eq!(rows.len(), 3);
assert!(rows.iter().all(|row| row.accessible_item_selectable() == Some(true)));
assert_eq!(rows.iter().filter(|row| row.accessible_item_selected() == Some(true)).count(), 1);
assert_eq!(rows[0].accessible_item_selected(), Some(true));
