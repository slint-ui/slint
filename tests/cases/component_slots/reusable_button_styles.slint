let subject_foreground = || visuals::color(instance.window(), "TestCase::subject", "Button::label");

let palette = instance.global::<BasicTheme<'_>>();
let styles = instance.global::<ButtonStyles<'_>>();
let inside = slint::LogicalPosition::new(50., 20.);
let outside = slint::LogicalPosition::new(350., 80.);
for (style, accented) in [(styles.get_secondary(), false), (styles.get_primary(), true)] {
    instance.set_style(style);
    instance.window().dispatch_event(WindowEvent::PointerMoved { position: outside });
    assert_eq!(subject_background(), if accented { palette.get_accent() } else { palette.get_background() });
    assert_eq!(subject_foreground(), if accented { palette.get_accent_foreground() } else { palette.get_foreground() });
    instance.window().dispatch_event(WindowEvent::PointerMoved { position: inside });
    assert_eq!(subject_background(), if accented { palette.get_accent_hover() } else { palette.get_hover_background() });
    instance.invoke_focus_subject();
    instance.window().dispatch_event(WindowEvent::PointerPressed { position: inside, button: PointerEventButton::Left });
    assert!(instance.get_subject_pressed());
    assert!(instance.get_subject_focused());
    let subject = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Subject").next().unwrap();
    let outline = subject.query_descendants().match_id("Button::focus-outline").find_first().unwrap();
    assert_eq!(outline.size().width, 108.);
    assert_eq!(subject_background(), if accented { palette.get_accent_pressed() } else { palette.get_pressed_background() });
    instance.set_enabled(false);
    slint::platform::update_timers_and_animations();
    assert!(!instance.get_subject_pressed());
    assert_eq!(subject_background(), palette.get_disabled_background());
    assert_eq!(subject_foreground(), palette.get_disabled_foreground());
    assert!(instance.get_test());
    instance.set_enabled(true);
    instance.window().dispatch_event(WindowEvent::PointerReleased { position: inside, button: PointerEventButton::Left });
    assert_eq!(subject_background(), if accented { palette.get_accent_hover() } else { palette.get_hover_background() });
}

for x in [170., 290.] {
