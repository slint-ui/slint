import {
    Button,
    ButtonStyle,
    ButtonStyles,
    BasicTheme,
} from "../../../tools/editor/controls/src/basic.slint";
export { BasicTheme, ButtonStyles }
component CustomButton inherits Button {
    style: {
        rest: {
            background-color: #123456,
            foreground-color: #abcdef,
            ..ButtonStyles.primary.rest,
        },
        hover: {
            background-color: #123456,
            foreground-color: #abcdef,
            ..ButtonStyles.primary.hover,
        },
        pressed: {
            background-color: #123456,
            foreground-color: #abcdef,
            ..ButtonStyles.primary.pressed,
        },
        ..ButtonStyles.primary,
    };
}

export component TestCase inherits Window {
    width: 360px;
    height: 100px;
    in-out property <bool> enabled: true;
    in-out property <ButtonStyle> style: ButtonStyles.secondary;
    in-out property <brush> custom-background: #654321;
    in-out property <brush> custom-foreground: #fedcba;
    out property <bool> subject-pressed: subject.pressed;
    out property <bool> subject-focused: subject.has-focus;
    out property <bool> test: custom.style.rest.background-color == #123456 && custom.style.rest.foreground-color == #abcdef
        && bound.style.rest.background-color == root.custom-background && bound.style.rest.foreground-color == root.custom-foreground;
    public function focus-subject() { subject.focus(); }

    subject := Button {
        x: 0px;
        y: 0px;
        width: 100px;
        height: 40px;
        text: "Subject";
        enabled: root.enabled;
        style: root.style;
    }

    custom := CustomButton {
        x: 120px;
        y: 0px;
        width: 100px;
        height: 40px;
        text: "Custom";
        enabled: root.enabled;
    }

    bound := Button {
        x: 240px;
        y: 0px;
        width: 100px;
        height: 40px;
        text: "Bound";
        enabled: root.enabled;
        style: {
            rest: {
                background-color: root.custom-background,
                foreground-color: root.custom-foreground,
                ..ButtonStyles.secondary.rest,
            },
            hover: {
                background-color: root.custom-background,
                foreground-color: root.custom-foreground,
                ..ButtonStyles.secondary.hover,
            },
            pressed: {
                background-color: root.custom-background,
                foreground-color: root.custom-foreground,
                ..ButtonStyles.secondary.pressed,
            },
            ..ButtonStyles.secondary,
        };
    }
}

