import { Button } from "../../../tools/editor/controls/src/basic.slint";

component CustomButton inherits Button {
    min-width: 0px;
    min-height: 0px;
    content {
        Rectangle {
            preferred-width: 80px;
            preferred-height: 20px;
            accessible-role: none;
        }
    }
}

export component TestCase inherits Window {
    width: 600px;
    height: 260px;
    out property <bool> plain-focused: plain.has-focus;
    out property <bool> custom-focused: custom.has-focus;
    out property <bool> next-focused: next.has-focus;
    out property <bool> disabled-focused: disabled.has-focus;
    in-out property <int> custom-clicks;
    out property <bool> test: custom.width == 96px && custom.height == 28px
        && plain.width > custom.width;

    VerticalLayout {
        alignment: start;
        spacing: 8px;
        plain := Button {
            text: "A deliberately long default button label";
            width: self.preferred-width;
            height: self.preferred-height;
        }

        custom := CustomButton {
            text: "A deliberately long label for accessibility only";
            accessible-label: "Custom action";
            content-padding-left: 7px;
            content-padding-right: 9px;
            content-padding-top: 3px;
            content-padding-bottom: 5px;
            width: self.preferred-width;
            height: self.preferred-height;
            background << Rectangle {
                background: #2563eb;
                accessible-role: none;
            }
            clicked => { root.custom-clicks += 1; }
        }

        disabled := Button {
            text: "Disabled";
            enabled: false;
        }

        next := Button {
            text: "Next";
        }
    }
}

/*
```rust
