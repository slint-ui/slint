assert!(instance.get_test());
let custom = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Custom action")
    .next().unwrap();
assert_eq!(custom.accessible_role(), Some(slint_testing::AccessibleRole::Button));
assert_eq!(custom.accessible_label().as_deref(), Some("Custom action"));
assert_eq!(custom.accessible_enabled(), Some(true));

slint_testing::send_keyboard_string_sequence(&instance, "\t");
assert!(instance.get_plain_focused());
slint_testing::send_keyboard_string_sequence(&instance, "\t");
assert!(instance.get_custom_focused());
assert!(!instance.get_plain_focused());
slint_testing::send_keyboard_string_sequence(&instance, " ");
assert_eq!(instance.get_custom_clicks(), 1);
slint_testing::send_keyboard_string_sequence(&instance, "\t");
assert!(instance.get_next_focused());
assert!(!instance.get_custom_focused());
assert!(!instance.get_disabled_focused());

custom.invoke_accessible_default_action();
assert_eq!(instance.get_custom_clicks(), 2);
let origin = custom.absolute_position();
let size = custom.size();
slint_testing::send_mouse_click(&instance, origin.x + size.width / 2., origin.y + size.height / 2.);
assert_eq!(instance.get_custom_clicks(), 3);
assert!(instance.get_custom_focused());
assert!(instance.get_test());
