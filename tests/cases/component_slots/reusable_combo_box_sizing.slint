import {
    ComboBox,
    ComboBoxSizeMetrics,
    ComboBoxSizes,
} from "../../../tools/editor/controls/src/basic.slint";
export { ComboBoxSizes }
export component TestCase inherits Window {
    width: 400px;
    height: 400px;
    in-out property <ComboBoxSizeMetrics> size: ComboBoxSizes.medium;
    in-out property <int> visible-items: 3;
    in-out property <length> row-height: root.size.item-height;
    in-out property <[string]> model: ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
    out property <bool> test: combo.current-index == 0;
    out property <int> highlighted-index: combo.highlighted-index;
    public function open-combo() { combo.open(); }
    public function close-combo() { combo.close(); }

    combo := ComboBox {
        x: 20px;
        y: 20px;
        width: 240px;
        accessible-label: "Sized combo";
        model: root.model;
        size: root.size;
        maximum-visible-items: root.visible-items;
        item-height: root.row-height;
    }
}

/*
```rust
use slint::platform::Key;
let instance = TestCase::new().unwrap();
instance.show().unwrap();
assert!(instance.get_test());
let sizes = instance.global::<ComboBoxSizes<'_>>();
let key = |key: Key| {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
    slint::platform::update_timers_and_animations();
};
let assert_visible = |label: &str| {
    let item = slint_testing::ElementHandle::find_by_accessible_label(&instance, label)
        .find(|item| item.accessible_role() == Some(slint_testing::AccessibleRole::ListItem)).unwrap();
    let viewport = slint_testing::ElementHandle::find_by_element_id(&instance, "ComboBoxPopup::items").next().unwrap();
    let top = item.absolute_position().y;
    let bottom = top + item.size().height;
    assert!(top >= viewport.absolute_position().y - 0.01);
    assert!(bottom <= viewport.absolute_position().y + viewport.size().height + 0.01);
    assert_eq!(item.size().height, instance.get_row_height());
};
instance.invoke_open_combo();
key(Key::End);
assert_eq!(instance.get_highlighted_index(), 7);
assert_visible("Seven");
for metrics in [sizes.get_large(), sizes.get_small(), sizes.get_medium()] {
    instance.set_size(metrics);
    slint::platform::update_timers_and_animations();
    assert_eq!(instance.get_highlighted_index(), 7);
    assert_visible("Seven");
}
for count in [1, 4, 2] {
    instance.set_visible_items(count);
    slint::platform::update_timers_and_animations();
    assert_visible("Seven");
}
instance.set_row_height(48.);
slint::platform::update_timers_and_animations();
assert_visible("Seven");
key(Key::Home);
assert_eq!(instance.get_highlighted_index(), 0);
assert_visible("Zero");
instance.invoke_close_combo();
instance.set_row_height(24.);
instance.invoke_open_combo();
slint::platform::update_timers_and_animations();
assert_visible("Zero");
key(Key::End);
instance.set_model(std::rc::Rc::new(slint::VecModel::from(vec!["Only".into()])).into());
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_highlighted_index(), 0);
assert_visible("Only");
```
