import {
    ComboBox,
} from "../../../tools/editor/controls/src/basic.slint";
export component TestCase inherits Window {
    width: 400px;
    height: 400px;
    in-out property <int> visible-items: 3;
    in-out property <length> row-height: 32px;
    in-out property <length> field-width: 240px;
    in-out property <length> field-height: 32px;
    in-out property <length> popup-offset: 2px;
    in-out property <[string]> model: ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven"];
    out property <bool> test: combo.current-index == 0;
    out property <int> highlighted-index: combo.highlighted-index;
    in-out property <int> selected-index <=> combo.current-index;
    out property <bool> expanded: combo.expanded;
    public function open-combo() { combo.open(); }
    public function close-combo() { combo.close(); }

    Rectangle {
        x: 20px;
        y: 20px;
        width: parent.width - 40px;
        height: parent.height - 40px;
        combo := ComboBox {
            x: 12px;
            y: 8px;
            width: root.field-width;
            height: root.field-height;
            popup-offset: root.popup-offset;
            accessible-label: "Sized combo";
            model: root.model;
            maximum-visible-items: root.visible-items;
            item-height: root.row-height;
        }
    }
}

/*
```rust
use slint::platform::Key;
let instance = TestCase::new().unwrap();
instance.show().unwrap();
assert!(instance.get_test());
for scale_factor in [1., 2.] {
    instance.window().dispatch_event(slint::platform::WindowEvent::ScaleFactorChanged { scale_factor });
    instance.window().dispatch_event(slint::platform::WindowEvent::Resized {
        size: slint::LogicalSize::new(400., 400.),
    });
    for (width, height, offset) in [(200., 32., 2.), (280., 48., 10.), (240., 40., 0.)] {
        instance.set_field_width(width);
        instance.set_field_height(height);
        instance.set_popup_offset(offset);
        instance.set_selected_index(0);
        instance.invoke_open_combo();
        let field = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Sized combo").next().unwrap();
        let position = field.absolute_position();
        // Click the second row where the popup belongs, relative to the field.
        slint_testing::send_mouse_click(&instance,
            position.x + 12.,
            position.y + field.size().height + offset + 4. + 1.5 * instance.get_row_height());
        assert_eq!(instance.get_selected_index(), 1, "popup placement at scale {scale_factor}, width {width}, height {height}, offset {offset}");
        assert!(!instance.get_expanded());
    }
}
let key = |key: Key| {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
    slint::platform::update_timers_and_animations();
};
let assert_visible = |label: &str| {
    let item = slint_testing::ElementHandle::find_by_accessible_label(&instance, label)
        .find(|item| item.accessible_role() == Some(slint_testing::AccessibleRole::ListItem)).unwrap();
    let viewport = slint_testing::ElementHandle::find_by_element_id(&instance, "ComboBoxPopup::items").next().unwrap();
    let top = item.absolute_position().y;
    let bottom = top + item.size().height;
    assert!(top >= viewport.absolute_position().y - 0.01);
    assert!(bottom <= viewport.absolute_position().y + viewport.size().height + 0.01);
    assert_eq!(item.size().height, instance.get_row_height());
};
instance.invoke_open_combo();
key(Key::End);
assert_eq!(instance.get_highlighted_index(), 7);
assert_visible("Seven");
for height in [40., 24., 32.] {
    instance.set_row_height(height);
    slint::platform::update_timers_and_animations();
    assert_eq!(instance.get_highlighted_index(), 7);
    assert_visible("Seven");
}
for count in [1, 4, 2] {
    instance.set_visible_items(count);
    slint::platform::update_timers_and_animations();
    assert_visible("Seven");
}
instance.set_row_height(48.);
slint::platform::update_timers_and_animations();
assert_visible("Seven");
key(Key::Home);
assert_eq!(instance.get_highlighted_index(), 0);
assert_visible("Zero");
instance.invoke_close_combo();
instance.set_row_height(24.);
instance.invoke_open_combo();
slint::platform::update_timers_and_animations();
assert_visible("Zero");
key(Key::End);
instance.set_model(std::rc::Rc::new(slint::VecModel::from(vec!["Only".into()])).into());
slint::platform::update_timers_and_animations();
assert_eq!(instance.get_highlighted_index(), 0);
assert_visible("Only");
```
*/
