assert!(instance.get_static_enabled());
assert!(instance.get_repeated_enabled());
instance.set_index(0);
assert_eq!(instance.get_static_title(), "First");
assert_eq!(instance.get_repeated_title(), "A");
let names = std::rc::Rc::new(slint::VecModel::from(vec!["X".into(), "Y".into()]));
instance.set_names(names.clone().into());
