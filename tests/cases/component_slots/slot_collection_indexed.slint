interface Entry {
    in property <bool> enabled;
    in property <string> title;
}

component Item {
    in property <bool> enabled: true;
    in property <string> title;
}

component Group {
    default slot <[implements Entry]> entries;
    in property <int> index;
    out property <bool> selected-enabled: entries[root.index].enabled;
    out property <string> selected-title: entries[root.index].title;
    VerticalLayout {
        for entry in entries: Text { text: entry.title; }
        for entry in entries: entry { }
    }
}

component AnyGroup {
    default slot <[*]> entries;
    in property <int> index;
    out property <bool> selected-visible: entries[root.index].visible;
    for entry in entries: entry { }
}

export component TestCase inherits Window {
    in-out property <int> index: 1;
    in-out property <bool> second-enabled;
    in-out property <bool> second-visible;
    in-out property <[string]> names: ["A", "B", "C"];
    out property <bool> static-enabled: static-group.selected-enabled;
    out property <bool> repeated-enabled: repeated-group.selected-enabled;
    out property <string> static-title: static-group.selected-title;
    out property <string> repeated-title: repeated-group.selected-title;
    out property <bool> wildcard-static-visible: wildcard-static.selected-visible;
    out property <bool> wildcard-repeated-visible: wildcard-repeated.selected-visible;
    out property <bool> test: !root.wildcard-static-visible && !root.wildcard-repeated-visible
        && !root.static-enabled && !root.repeated-enabled
        && root.static-title == "Second" && root.repeated-title == "B";
    wildcard-static := AnyGroup {
        index: root.index;
        Text { text: "First"; }
        Rectangle { visible: root.second-visible; }
    }
    wildcard-repeated := AnyGroup {
        index: root.index;
        for name[index] in root.names: Text {
            text: name;
            visible: index != 1 || root.second-visible;
        }
    }
    static-group := Group {
        index: root.index;
        Item { title: "First"; }
        Item { title: "Second"; enabled: root.second-enabled; }
    }
    repeated-group := Group {
        index: root.index;
        for name[index] in root.names: Item {
            title: name;
            enabled: index != 1 || root.second-enabled;
        }
    }
}

