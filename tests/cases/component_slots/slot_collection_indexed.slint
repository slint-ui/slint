names.remove(0);
assert_eq!(instance.get_repeated_title(), "Y");
for index in [-1, 3] {
    instance.set_index(index);
    assert!(!instance.get_wildcard_static_visible());
    assert!(!instance.get_wildcard_repeated_visible());
    assert!(!instance.get_static_enabled());
    assert!(!instance.get_repeated_enabled());
    assert_eq!(instance.get_static_title(), "");
    assert_eq!(instance.get_repeated_title(), "");
}
