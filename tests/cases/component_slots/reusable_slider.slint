import {
    SliderTemplate,
} from "../../../tools/editor/controls/src/templates.slint";

export component TestCase inherits Window {
    width: 260px;
    height: 80px;
    in-out property <float> minimum: 10;
    in-out property <float> maximum: 90;
    in-out property <float> step: 7;
    in-out property <float> value: 50;
    in-out property <bool> enabled: true;
    in-out property <bool> inverted;
    out property <float> position: slider.position;
    out property <int> changes;
    out property <bool> test: slider.position == 0.5;
    public function request(value: float) { slider.set-value(value); }
    public function seek(position: float) { slider.set-position(position); }
    public function focus-slider() { slider.focus(); }
    slider := SliderTemplate {
        accessible-label: "Range slider";
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
        enabled: root.enabled;
        inverted: root.inverted;
    }
}

/*
```rust
use slint::platform::Key;
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
let slider = slint_testing::ElementHandle::find_by_accessible_label(&instance, "Range slider").next().unwrap();
assert_eq!(slider.accessible_role(), Some(slint_testing::AccessibleRole::Slider));
let key = |key: Key| {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
};
for (minimum, maximum) in [(10., 90.), (90., 10.)] {
    instance.set_minimum(minimum);
    instance.set_maximum(maximum);
    instance.set_step(7.);
    instance.set_value(50.);
    assert_eq!(slider.accessible_value_minimum(), Some(10.));
    assert_eq!(slider.accessible_value_maximum(), Some(90.));
    instance.invoke_request(46.);
    assert_eq!(instance.get_value(), 45.);
    instance.invoke_request(90.);
    assert_eq!(instance.get_value(), 90.);
    instance.invoke_request(-20.);
    assert_eq!(instance.get_value(), 10.);
    instance.invoke_seek(0.5);
    assert_eq!(instance.get_value(), 52.);
    assert!((instance.get_position() - 0.525).abs() < 0.0001);
    let count = instance.get_changes();
    instance.invoke_request(52.);
    assert_eq!(instance.get_changes(), count);
    instance.invoke_focus_slider();
    key(Key::Home);
    assert_eq!(instance.get_value(), 10.);
    key(Key::End);
    assert_eq!(instance.get_value(), 90.);
    instance.set_step(1.);
    instance.set_value(40.);
    key(Key::RightArrow);
    assert_eq!(instance.get_value(), 41.);
    key(Key::LeftArrow);
    assert_eq!(instance.get_value(), 40.);
    key(Key::PageUp);
    assert_eq!(instance.get_value(), 50.);
    key(Key::PageDown);
    assert_eq!(instance.get_value(), 40.);
    instance.set_inverted(true);
    key(Key::UpArrow);
    assert_eq!(instance.get_value(), 39.);
    key(Key::DownArrow);
    assert_eq!(instance.get_value(), 40.);
    instance.set_inverted(false);
