import {
    Button,
    ButtonStyles,
    CheckBox,
    CheckBoxStyle,
    CheckBoxStyles,
    Switch,
    SwitchStyles,
    Slider,
    SliderStyles,
    ComboBox,
    ComboBoxStyles,
    BasicTheme,
} from "../../../tools/editor/controls/src/basic.slint";
export { CheckBoxStyles, BasicTheme }
global AppColors {
    in-out property <brush> checkbox: #0f766e;
}

component AppCheckBox inherits CheckBox {
    in property <CheckBoxStyle> base-style: CheckBoxStyles.standard;
    style: {
        checked: {
            rest: {
                indicator-color: AppColors.checkbox,
                ..root.base-style.checked.rest,
            },
            hover: {
                indicator-color: AppColors.checkbox,
                ..root.base-style.checked.hover,
            },
            pressed: {
                indicator-color: AppColors.checkbox,
                ..root.base-style.checked.pressed,
            },
            ..root.base-style.checked,
        },
        ..root.base-style,
    };
}

export component TestCase inherits Window {
    width: 600px;
    height: 220px;
    in-out property <brush> custom-color <=> AppColors.checkbox;
    in-out property <brush> foreground-color: #ffffff;
    in-out property <bool> enabled: true;
    in-out property <bool> checked: true;
    in-out property <CheckBoxStyle> checkbox-style: CheckBoxStyles.standard;
    out property <int> activations;
    out property <brush> switch-foreground: switch.style.unchecked.rest.foreground-color;
    out property <bool> test: first.style.checked.rest.indicator-color == second.style.checked.rest.indicator-color
        && first.style.checked.rest.indicator-color == root.custom-color
        && button.style.rest.background-color == root.custom-color
        && button.style.rest.foreground-color == root.foreground-color
        && switch.style.checked.rest.track-color == root.custom-color
        && slider.style.rest.fill-color == root.custom-color
        && slider.style.rest.handle-color == root.custom-color
        && combo.style.rest.background-color == root.custom-color
        && combo.style.rest.foreground-color == root.foreground-color
        && first.style.unchecked == root.checkbox-style.unchecked
        && first.style.checked.disabled == root.checkbox-style.checked.disabled
        && button.style.disabled == ButtonStyles.primary.disabled
        && switch.style.checked.disabled == SwitchStyles.standard.checked.disabled
        && slider.style.disabled == SliderStyles.standard.disabled
        && combo.style.disabled == ComboBoxStyles.standard.disabled;

    public function activate-all() {
        first.activate();
        switch.activate();
        button.activate();
        slider.set-value(67);
        combo.select(1);
    }

    VerticalLayout {
        HorizontalLayout {
            first := AppCheckBox {
                base-style: root.checkbox-style;
                text: "Shared one";
                checked <=> root.checked;
                enabled: root.enabled;
                toggled => { root.activations += 1; }
            }

            second := AppCheckBox {
                base-style: root.checkbox-style;
                text: "Shared two";
                checked <=> root.checked;
                enabled: root.enabled;
            }

            switch := Switch {
                text: "Switch";
                checked <=> root.checked;
                style: {
                    checked: {
                        rest: {
                            track-color: root.custom-color,
                            ..SwitchStyles.standard.checked.rest,
                        },
                        hover: {
                            track-color: root.custom-color,
                            ..SwitchStyles.standard.checked.hover,
                        },
                        pressed: {
                            track-color: root.custom-color,
                            ..SwitchStyles.standard.checked.pressed,
                        },
                        ..SwitchStyles.standard.checked,
                    },
                    ..SwitchStyles.standard,
                };
                enabled: root.enabled;
                toggled => { root.activations += 1; }
            }
        }

        HorizontalLayout {
            button := Button {
                text: "Button";
                style: {
                    rest: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ButtonStyles.primary.rest,
                    },
                    hover: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ButtonStyles.primary.hover,
                    },
                    pressed: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ButtonStyles.primary.pressed,
                    },
                    ..ButtonStyles.primary,
                };
                enabled: root.enabled;
                clicked => { root.activations += 1; }
            }

            slider := Slider {
                accessible-label: "Slider";
                style: {
                    rest: {
                        fill-color: root.custom-color,
                        handle-color: root.custom-color,
                        ..SliderStyles.standard.rest,
                    },
                    hover: {
                        fill-color: root.custom-color,
                        handle-color: root.custom-color,
                        ..SliderStyles.standard.hover,
                    },
                    pressed: {
                        fill-color: root.custom-color,
                        handle-color: root.custom-color,
                        ..SliderStyles.standard.pressed,
                    },
                    ..SliderStyles.standard,
                };
                enabled: root.enabled;
                changed(value) => { root.activations += 1; }
            }

            combo := ComboBox {
                accessible-label: "ComboBox";
                model: ["One", "Two"];
                style: {
                    rest: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ComboBoxStyles.standard.rest,
                    },
                    hover: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ComboBoxStyles.standard.hover,
                    },
                    pressed: {
                        background-color: root.custom-color,
                        foreground-color: root.foreground-color,
                        ..ComboBoxStyles.standard.pressed,
                    },
                    ..ComboBoxStyles.standard,
                };
                enabled: root.enabled;
                selected(value) => { root.activations += 1; }
            }
        }
    }
}

/*
```rust
let instance = TestCase::new().unwrap();
let brush = |r, g, b| slint::Brush::from(slint::Color::from_rgb_u8(r, g, b));
assert!(instance.get_test());
instance.set_custom_color(brush(0x7c, 0x3a, 0xed));
instance.set_foreground_color(brush(0xfe, 0xf3, 0xc7));
assert!(instance.get_test());
instance.set_checked(false);
assert!(instance.get_test());
instance.set_checked(true);
instance.invoke_activate_all();
assert_eq!(instance.get_activations(), 5);
assert!(instance.get_test());

instance.set_enabled(false);
for label in ["Shared one", "Shared two", "Switch", "Button", "Slider", "ComboBox"] {
    let element = slint_testing::ElementHandle::find_by_accessible_label(&instance, label).next().unwrap();
    assert_eq!(element.accessible_enabled(), Some(false));
}
let before = instance.get_activations();
instance.invoke_activate_all();
assert_eq!(instance.get_activations(), before);
assert!(instance.get_test());

let presets = instance.global::<CheckBoxStyles<'_>>();
let mut style = presets.get_standard();
style.checked.disabled.indicator_color = brush(0x12, 0x34, 0x56);
instance.set_checkbox_style(style);
assert!(instance.get_test());
instance.set_enabled(true);
assert!(instance.get_test());

let label = brush(0x65, 0x43, 0x21);
let theme = instance.global::<BasicTheme<'_>>();
let mut palette = theme.get_palette();
palette.foreground = label.clone();
theme.set_palette(palette);
assert_eq!(instance.get_switch_foreground(), label);
assert!(instance.get_test());
```
*/
