import {
    Button,
    ButtonStyles,
    CheckBox,
    CheckBoxStyles,
    Switch,
    SwitchStyles,
    Slider,
    SliderStyles,
    ComboBox,
    ComboBoxStyles,
    BasicTheme,
} from "../../../tools/editor/controls/src/basic.slint";
export { CheckBoxStyles, BasicTheme }
global AppColors {
    in-out property <brush> checkbox: #0f766e;
}

component AppCheckBox inherits CheckBox {
    checked-color: AppColors.checkbox;
}

export component TestCase inherits Window {
    width: 600px;
    height: 220px;
    in-out property <brush> custom-color <=> AppColors.checkbox;
    in-out property <brush> foreground: #ffffff;
    in-out property <bool> enabled: true;
    in-out property <bool> checked: true;
    out property <int> activations;
    out property <brush> switch-foreground: switch.foreground;
    out property <bool> test: first.checked-color == second.checked-color
        && first.checked-color == root.custom-color
        && button.background-color == root.custom-color
        && button.foreground == root.foreground
        && switch.checked-color == root.custom-color
        && slider.fill-color == root.custom-color
        && slider.handle-color == root.custom-color
        && combo.background-color == root.custom-color
        && combo.foreground == root.foreground
        && first.style == CheckBoxStyles.standard
        && button.style == ButtonStyles.primary
        && switch.style == SwitchStyles.standard
        && slider.style == SliderStyles.standard
        && combo.style == ComboBoxStyles.standard;

    public function activate-all() {
        first.activate();
        switch.activate();
        button.activate();
        slider.set-value(67);
        combo.select(1);
    }

    VerticalLayout {
        HorizontalLayout {
            first := AppCheckBox {
                text: "Shared one";
                checked <=> root.checked;
                enabled: root.enabled;
                toggled => { root.activations += 1; }
            }

            second := AppCheckBox {
                text: "Shared two";
                checked <=> root.checked;
                enabled: root.enabled;
            }

            switch := Switch {
                text: "Switch";
                checked <=> root.checked;
                checked-color: root.custom-color;
                enabled: root.enabled;
                toggled => { root.activations += 1; }
            }
        }

        HorizontalLayout {
            button := Button {
                text: "Button";
                style: ButtonStyles.primary;
                background-color: root.custom-color;
                foreground: root.foreground;
                enabled: root.enabled;
                clicked => { root.activations += 1; }
            }

            slider := Slider {
                accessible-label: "Slider";
                fill-color: root.custom-color;
                handle-color: root.custom-color;
                enabled: root.enabled;
                changed(value) => { root.activations += 1; }
            }

            combo := ComboBox {
                accessible-label: "ComboBox";
                model: ["One", "Two"];
                background-color: root.custom-color;
                foreground: root.foreground;
                enabled: root.enabled;
                selected(value) => { root.activations += 1; }
            }
        }
    }
}

