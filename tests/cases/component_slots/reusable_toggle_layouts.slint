import { CheckBoxBase, SwitchBase } from "../../../tools/editor/controls/src/headless.slint";
import { Switch } from "../../../tools/editor/controls/src/basic.slint";

export component TestCase inherits Window {
    width: 600px;
    height: 300px;
    in-out property <bool> controls-enabled: true;
    out property <int> toggles;
    out property <bool> test: choice.height > 26px && toggle.height > 30px;

    choice := CheckBoxBase {
        x: 20px;
        y: 20px;
        width: self.preferred-width;
        height: self.preferred-height;
        enabled: root.controls-enabled;
        text: "Checkbox label below";
        content << VerticalLayout {
            padding: 4px;
            spacing: 8px;
            cross-axis-alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                background: choice.checked ? green : gray;
            }
            Text {
                text: choice.text;
                font-size: 14px;
            }
        }
        toggled => { root.toggles += 1; }
    }

    toggle := SwitchBase {
        x: 20px;
        y: 130px;
        width: self.preferred-width;
        height: self.preferred-height;
        enabled: root.controls-enabled;
        text: "Switch label below";
        content << VerticalLayout {
            padding: 4px;
            spacing: 8px;
            cross-axis-alignment: center;
            Rectangle {
                width: 40px;
                height: 22px;
                background: toggle.checked ? green : gray;
            }
            Text {
                text: toggle.text;
                font-size: 14px;
            }
        }
        toggled => { root.toggles += 1; }
    }

    Switch {
        x: 260px;
        y: 20px;
        width: self.preferred-width;
        height: self.preferred-height;
        accessible-label: "Multiline switch";
        text: "Enable notifications\nFor messages and updates";
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton};
use slint_testing::ElementHandle;
let instance = TestCase::new().unwrap();
instance.show().unwrap();
assert!(instance.get_test());
let find = |label: &str| {
    ElementHandle::find_by_accessible_label(&instance, label).next().unwrap()
};
for label in ["Checkbox label below", "Switch label below"] {
    let control = find(label);
    let indicator = control.query_descendants().match_type_name("Rectangle").find_first().unwrap();
    let text = control.query_descendants().match_type_name("Text").find_first().unwrap();
    let indicator_position = indicator.absolute_position();
    let text_position = text.absolute_position();
    assert!(text_position.y >= indicator_position.y + indicator.size().height + 8. - 0.1);
    assert!((text_position.x + text.size().width / 2.
        - indicator_position.x - indicator.size().width / 2.).abs() < 0.1);

    indicator.mock_single_click(PointerEventButton::Left);
    assert_eq!(control.accessible_checked(), Some(true));
    text.mock_single_click(PointerEventButton::Left);
    assert_eq!(control.accessible_checked(), Some(false));

    control.invoke_accessible_default_action();
    assert_eq!(control.accessible_checked(), Some(true));
}
assert_eq!(instance.get_toggles(), 6);

let multiline = find("Multiline switch");
let track = multiline.query_descendants().match_id("Switch::track").find_first().unwrap();
let text = multiline.query_descendants().match_type_name("Text").find_first().unwrap();
assert!(text.size().height > track.size().height);
assert!((track.absolute_position().y + track.size().height / 2.
    - text.absolute_position().y - text.size().height / 2.).abs() < 0.1);

instance.set_controls_enabled(false);
for label in ["Checkbox label below", "Switch label below"] {
    let control = find(label);
    control.mock_single_click(PointerEventButton::Left);
    control.invoke_accessible_default_action();
}
assert_eq!(instance.get_toggles(), 6);

instance.set_controls_enabled(true);
slint_testing::send_keyboard_char(&instance, Key::Tab.into(), true);
slint_testing::send_keyboard_char(&instance, Key::Tab.into(), false);
slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
assert_eq!(instance.get_toggles(), 7);
```
