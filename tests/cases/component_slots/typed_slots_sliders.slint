import { SliderDemo } from "../../../examples/slots/sliders.slint";

export component TestCase inherits SliderDemo {
    in-out property <float> shared-value <=> root.value;
    in-out property <bool> controls-enabled <=> root.sliders-enabled;
    out property <int> change-count: root.changes;
    out property <bool> test: root.value == 50;
}

/*
```rust
use slint::platform::{Key, PointerEventButton, WindowEvent};
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
let straight = slint_testing::ElementHandle::find_by_element_type_name(&instance, "StraightSurface").next().unwrap();
let circular = slint_testing::ElementHandle::find_by_element_type_name(&instance, "CircularSurface").next().unwrap();
let line = straight.absolute_position();
let line_size = straight.size();
let circle = circular.absolute_position();
let circle_size = circular.size();
let click_line = |fraction: f32| {
    slint_testing::send_mouse_click(&instance, line.x + 14. + fraction * (line_size.width - 28.), line.y + line_size.height / 2.);
};
let click_circle = |x: f32, y: f32| {
    slint_testing::send_mouse_click(&instance, circle.x + circle_size.width * x, circle.y + circle_size.height * y);
};
let key = |key: Key| {
    slint_testing::send_keyboard_char(&instance, key.into(), true);
    slint_testing::send_keyboard_char(&instance, key.into(), false);
};
click_line(0.734);
assert_eq!(instance.get_shared_value(), 73.);
assert_eq!(instance.get_change_count(), 1);
key(Key::RightArrow);
assert_eq!(instance.get_shared_value(), 74.);
click_circle(0.5, 0.1);
assert_eq!(instance.get_shared_value(), 50.);
key(Key::DownArrow);
assert_eq!(instance.get_shared_value(), 49.);
key(Key::End);
assert_eq!(instance.get_shared_value(), 100.);
let count = instance.get_change_count();
key(Key::RightArrow);
assert_eq!(instance.get_change_count(), count);
key(Key::Home);
assert_eq!(instance.get_shared_value(), 0.);
click_circle(0.1, 0.5);
assert_eq!(instance.get_shared_value(), 17.);
click_circle(0.9, 0.5);
assert_eq!(instance.get_shared_value(), 83.);
click_circle(0.4, 0.9);
assert_eq!(instance.get_shared_value(), 0.);
click_circle(0.6, 0.9);
assert_eq!(instance.get_shared_value(), 100.);
click_circle(0.5, 0.5);
assert_eq!(instance.get_shared_value(), 100.);
let button = PointerEventButton::Left;
let start = slint::LogicalPosition::new(line.x + 14., line.y + line_size.height / 2.);
let end = slint::LogicalPosition::new(line.x + line_size.width + 20., start.y);
instance.window().dispatch_event(WindowEvent::PointerPressed { position: start, button });
instance.window().dispatch_event(WindowEvent::PointerMoved { position: end });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: end, button });
assert_eq!(instance.get_shared_value(), 100.);
let start = slint::LogicalPosition::new(circle.x + circle_size.width / 2., circle.y + 14.);
let end = slint::LogicalPosition::new(circle.x + circle_size.width - 14., circle.y + circle_size.height / 2.);
instance.window().dispatch_event(WindowEvent::PointerPressed { position: start, button });
instance.window().dispatch_event(WindowEvent::PointerMoved { position: end });
instance.window().dispatch_event(WindowEvent::PointerReleased { position: end, button });
assert_eq!(instance.get_shared_value(), 83.);
instance.set_shared_value(35.);
let sliders: Vec<_> = slint_testing::ElementHandle::find_by_element_type_name(&instance, "HeadlessSlider").collect();
assert_eq!(sliders.len(), 2);
for slider in &sliders {
    assert_eq!(slider.accessible_value().unwrap().as_str(), "35");
}
instance.set_controls_enabled(false);
let count = instance.get_change_count();
click_line(0.5);
click_circle(0.5, 0.1);
key(Key::RightArrow);
sliders[0].invoke_accessible_increment_action();
assert_eq!(instance.get_shared_value(), 35.);
assert_eq!(instance.get_change_count(), count);
instance.set_controls_enabled(true);
sliders[1].invoke_accessible_increment_action();
assert_eq!(instance.get_shared_value(), 36.);
```
*/
