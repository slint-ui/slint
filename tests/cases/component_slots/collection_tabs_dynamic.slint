```rust
use slint::platform::{Key, PointerEventButton};
use slint_testing::{AccessibleRole, ElementHandle};
let instance = GalleryTest::new().unwrap();
assert!(instance.get_test());
let element = |label: &str, role| ElementHandle::find_by_accessible_label(&instance, label)
    .find(|element| element.accessible_role() == Some(role))
    .unwrap_or_else(|| panic!("Missing {role:?}: {label}"));
let click = |label: &str, role| element(label, role).mock_single_click(PointerEventButton::Left);
element("Counter 1 (0)", AccessibleRole::Tab);
click("Increment Counter 1", AccessibleRole::Button);
element("Counter 1 (1)", AccessibleRole::Tab);
click("Notes 2", AccessibleRole::Tab);
element("Notes 2", AccessibleRole::TextInput).set_accessible_value("Retained notes");
click("Add counter", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), 2);
click("Increment Counter 3", AccessibleRole::Button);
click("Insert before", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), 3);
assert_eq!(element("Counter 3 (1)", AccessibleRole::Tab).accessible_item_selected(), Some(true));
click("Notes 2", AccessibleRole::Tab);
assert_eq!(element("Notes 2", AccessibleRole::TextInput).accessible_value().as_deref(), Some("Retained notes"));
click("Counter 1 (1)", AccessibleRole::Tab);
click("Close tab", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), 0);
assert_eq!(element("Notes 2", AccessibleRole::TextInput).accessible_value().as_deref(), Some("Retained notes"));
click("Counter 3 (1)", AccessibleRole::Tab);
element("Tab title", AccessibleRole::TextInput).set_accessible_value("Renamed");
element("Renamed (1)", AccessibleRole::Tab);
click("Close tab", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), 1);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::LeftArrow));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::End));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 1);
click("Close tab", AccessibleRole::Button);
click("Close tab", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), -1);
assert_eq!(instance.get_item_count(), 0);
assert_eq!(element("Close tab", AccessibleRole::Button).accessible_enabled(), Some(false));
click("Add notes", AccessibleRole::Button);
assert_eq!(instance.get_current_index(), 0);
assert_eq!(instance.get_item_count(), 1);
assert_eq!(element("Notes 5", AccessibleRole::TextInput).accessible_value().as_deref(), Some(""));
```

```cpp
auto handle = TestCase::create();
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
const auto &instance = *handle;
auto element = [&](const char *label, slint::language::AccessibleRole role) {
    auto matches = slint::testing::ElementHandle::find_by_accessible_label(handle, label);
    for (const auto &element : matches) {
        if (element.accessible_role() == role)
            return element;
    }
    std::abort();
};
auto tab = [&](const char *label) { return element(label, slint::language::AccessibleRole::Tab); };
auto increment = [&](const char *label) {
    element(label, slint::language::AccessibleRole::Button).invoke_accessible_default_action();
};
tab("Two (0)").invoke_accessible_default_action();
increment("Increment Two");
tab("Two (1)");
assert_eq(instance.get_current_index(), 1);
assert_eq(instance.get_constructions(), 2);
increment("Open related Two");
assert_eq(instance.get_last_open_index(), 1);
assert_eq(instance.get_last_open_path(), "Two-1.slint");
instance.invoke_insert(0, "Zero");
tab("Two (1)").invoke_accessible_default_action();
assert_eq(instance.get_current_index(), 2);
assert_eq(instance.get_constructions(), 3);
increment("Open related Two");
assert_eq(instance.get_last_open_index(), 2);
assert_eq(instance.get_last_open_path(), "Two-2.slint");
instance.invoke_remove(0);
instance.invoke_rename(1, "Renamed");
tab("Renamed (1)").invoke_accessible_default_action();
assert_eq(instance.get_current_index(), 1);
increment("Increment Renamed");
tab("Renamed (2)");
assert_eq(instance.get_constructions(), 3);
instance.invoke_clear();
assert_eq(instance.get_item_count(), 0);
instance.invoke_append("Fresh");
tab("Fresh (0)").invoke_accessible_default_action();
increment("Increment Fresh");
tab("Fresh (1)");
assert_eq(instance.get_constructions(), 4);
#endif
```

