auto handle = GalleryTest::create();
#ifndef SLINT_FEATURE_LIVE_PREVIEW
// The live-preview wrapper does not support ElementHandle queries.
auto tabs = slint::testing::ElementHandle::find_by_accessible_label(handle, "Counter 1 (0)");
assert(!tabs.empty());
auto buttons = slint::testing::ElementHandle::find_by_accessible_label(handle, "Increment Counter 1");
auto button = std::find_if(buttons.begin(), buttons.end(), [](const auto &element) {
    return element.accessible_role() == slint::language::AccessibleRole::Button;
});
assert(button != buttons.end());
button->invoke_accessible_default_action();
assert(!slint::testing::ElementHandle::find_by_accessible_label(handle, "Counter 1 (1)").empty());
#endif
