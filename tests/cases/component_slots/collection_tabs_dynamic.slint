instance.invoke_append("Fresh".into());
element("Fresh (0)", AccessibleRole::Tab).mock_single_click(PointerEventButton::Left);
element("Increment Fresh", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
element("Fresh (1)", AccessibleRole::Tab);
assert_eq!(instance.get_constructions(), 4);
