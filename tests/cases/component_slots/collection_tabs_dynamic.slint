import { CollectionTabWidget, CollectionTab, Button } from "../../../tools/editor/controls/src/basic.slint";
import { DynamicTabsExample } from "../../../tools/editor/controls/examples/dynamic_collection_tabs.slint";

interface WorkspacePage {
    in property <string> title;
    in property <int> position;
    callback open-file-requested(string);
}

component Workspace {
    default slot <[implements WorkspacePage]> pages;
    in-out property <int> current-index;
    out property <int> item-count: tabs.item-count;
    out property <int> last-open-index: -1;
    callback open-file(string);
    tabs := CollectionTabWidget {
        current-index <=> root.current-index;
        for page[index] in pages: page {
            position: index;
            open-file-requested(path) => {
                root.last-open-index = index;
                root.open-file(path);
            }
        }
    }
}

component CounterPage inherits CollectionTab {
    in property <string> name;
    in property <int> position;
    callback open-file-requested(string);
    private property <int> count;
    title: "\{root.name} (\{root.count})";
    VerticalLayout {
        Button { text: "Increment \{root.name}"; clicked => { root.count += 1; } }
        Button {
            text: "Open related \{root.name}";
            clicked => { root.open-file-requested("\{root.name}-\{root.position}.slint"); }
        }
    }
}

export component TestCase inherits Window {
    width: 640px;
    height: 260px;
    in-out property <[string]> names: ["One", "Two"];
    out property <int> current-index: tabs.current-index;
    out property <int> item-count: tabs.item-count;
    out property <int> constructions;
    out property <int> last-open-index: tabs.last-open-index;
    out property <string> last-open-path;
    out property <bool> test: root.item-count == 2 && root.current-index == 0;
    public function append(name: string) { root.names.push(name); }
    public function insert(index: int, name: string) { root.names.insert(index, name); }
    public function remove(index: int) { root.names.remove(index); }
    public function rename(index: int, name: string) { root.names[index] = name; }
    public function clear() { root.names = []; }
    tabs := Workspace {
        open-file(path) => { root.last-open-path = path; }
        for name in root.names: CounterPage {
            name: name;
            init => { root.constructions += 1; }
        }
    }
}

export component GalleryTest inherits Window {
    width: 720px;
    height: 360px;
    out property <int> current-index: example.current-index;
    out property <int> item-count: example.item-count;
    out property <bool> test: root.current-index == 0 && root.item-count == 2;
    example := DynamicTabsExample { }
}

