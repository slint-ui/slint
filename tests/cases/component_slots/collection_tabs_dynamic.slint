    .find(|element| element.accessible_role() == Some(role)).unwrap();
element("Two (0)", AccessibleRole::Tab).mock_single_click(PointerEventButton::Left);
element("Increment Two", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
element("Open related Two", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_last_open_index(), 1);
assert_eq!(instance.get_last_open_path(), "Two-1.slint");
assert_eq!(instance.get_current_index(), 1);
element("Two (1)", AccessibleRole::Tab);
assert_eq!(instance.get_constructions(), 2);
instance.invoke_insert(0, "Zero".into());
assert_eq!(instance.get_item_count(), 3);
element("Two (1)", AccessibleRole::Tab).mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 2);
assert_eq!(instance.get_constructions(), 3);
element("Open related Two", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_last_open_index(), 2);
assert_eq!(instance.get_last_open_path(), "Two-2.slint");
instance.invoke_remove(0);
instance.invoke_rename(1, "Renamed".into());
assert_eq!(instance.get_item_count(), 2);
element("Renamed (1)", AccessibleRole::Tab).mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 1);
element("Increment Renamed", AccessibleRole::Button).mock_single_click(PointerEventButton::Left);
element("Renamed (2)", AccessibleRole::Tab);
assert_eq!(instance.get_constructions(), 3);
instance.invoke_clear();
assert_eq!(instance.get_item_count(), 0);
