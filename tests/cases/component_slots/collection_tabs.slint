import { CollectionTabWidget, CollectionTab } from "../../../tools/editor/controls/src/basic.slint";
import { TabWidget } from "std-widgets.slint";

export component TestCase inherits Window {
    width: 400px;
    height: 300px;
    out property <int> current-index: tabs.current-index;
    in-out property <Orientation> orientation <=> tabs.orientation;
    out property <int> count: counter.value;
    out property <int> constructions;
    out property <bool> test: tabs.item-count == 2 && standard.current-index == 0;
    public function increment() { counter.value += 1; }
    VerticalLayout {
        tabs := CollectionTabWidget {
            CollectionTab {
                title: "Settings";
                Text { text: "Settings page"; }
            }
            CollectionTab {
                title: "Counter (\{counter.value})";
                counter := Rectangle {
                    in-out property <int> value;
                    init => { root.constructions += 1; }
                    Text { text: "Count: \{counter.value}"; }
                }
            }
        }
        standard := TabWidget {
            Tab { title: "Standard"; Text { text: "Existing API"; } }
        }
    }
}

/*
```rust
use slint::platform::{Key, PointerEventButton};
use slint_testing::{AccessibleRole, ElementHandle};
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
assert_eq!(instance.get_constructions(), 1);
let tab = |label: &str| ElementHandle::find_by_accessible_label(&instance, label)
    .find(|element| element.accessible_role() == Some(AccessibleRole::Tab)).unwrap();
tab("Counter (0)").mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 1);
instance.invoke_increment();
assert_eq!(tab("Counter (1)").accessible_label().as_deref(), Some("Counter (1)"));
tab("Settings").mock_single_click(PointerEventButton::Left);
assert_eq!(instance.get_current_index(), 0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::RightArrow));
assert_eq!(instance.get_current_index(), 0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 1);
assert_eq!(instance.get_count(), 1);
assert_eq!(instance.get_constructions(), 1);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::LeftArrow));
slint_testing::send_keyboard_char(&instance, Key::Space.into(), true);
assert_eq!(instance.get_current_index(), 1, "Space activates on release");
slint_testing::send_keyboard_char(&instance, Key::Space.into(), false);
assert_eq!(instance.get_current_index(), 0);
instance.set_orientation(slint::language::Orientation::Vertical);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::DownArrow));
assert_eq!(instance.get_current_index(), 0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 1);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Home));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 0);
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::End));
slint_testing::send_keyboard_string_sequence(&instance, &slint::SharedString::from(Key::Return));
assert_eq!(instance.get_current_index(), 1);
```
