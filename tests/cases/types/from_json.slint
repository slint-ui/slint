export enum Direction { left, right, up, down }

struct Point { x: int, y: int }
export struct Nested { point: Point, label: string }
struct Complex {
    value: string,
    array: [int],
    nested: [Nested],
}
// Declares only a subset of the keys at the root of from_json.json
struct Root {
    int_property: int,
    a-float: float,
    a_point: Point,
}
struct WithDefaults {
    label: string = @from-json("from_json.json").a_string,
    point: Point = @from-json("from_json.json").a_point,
}

export component TestCase {
    // The whole file: a JSON object converts to a struct, a JSON array to an array
    property <Root> root_object: @from-json("from_json.json");
    property <[Point]> root_array: @from-json("from_json_array.json");

    // Member access selects a value inside the file
    property <int> flat_value: @from-json("from_json.json").flat_value;
    property <int> nested_value_underscore: @from-json("from_json.json").element.sub_element.nested_value;
    property <int> nested_value_dash: @from-json("from_json.json").element.sub-element.nested-value;
    property <int> dashed_key_underscore: @from-json("from_json.json").dashed_key;
    property <int> dashed_key_dash: @from-json("from_json.json").dashed-key;

    // Part of a larger expression: the type comes from the JSON value
    property <int> a_sum: @from-json("from_json.json").a_point.x + @from-json("from_json.json").a_nested.point.y;
    property <bool> a_comparison: @from-json("from_json.json").int_property > 4;

    // Indexing with a constant integer, on its own and combined with member access
    property <Point> root_array_element: @from-json("from_json_array.json")[1];
    property <int> root_array_element_field: @from-json("from_json_array.json")[0].y;
    property <int> an_array_element: @from-json("from_json.json").an_array[1];
    property <Point> an_array_of_points_element: @from-json("from_json.json").an_array_of_points[1];
    property <int> nested_array_element: @from-json("from_json.json").element.sub_element.complex_nested.array[2];
    property <int> nested_struct_array_element: @from-json("from_json.json").element.sub_element.complex_nested.nested[1].point.y;

    // scalar types
    property <string> a_string: @from-json("from_json.json").a_string;
    property <bool> a_bool: @from-json("from_json.json").a_bool;
    property <percent> a_percent: @from-json("from_json.json").a_percent;
    property <length> a_length: @from-json("from_json.json").a_length;
    property <duration> a_duration: @from-json("from_json.json").a_duration;
    property <angle> a_angle: @from-json("from_json.json").a_angle;
    property <color> a_color: @from-json("from_json.json").a_color;
    property <color> a_named_color: @from-json("from_json.json").a_named_color;
    property <Direction> a_direction: @from-json("from_json.json").a_direction;
    property <Direction> a_direction_prefixed: @from-json("from_json.json").a_direction_prefixed;
    property <brush> color_to_brush: @from-json("from_json.json").a_color;

    // array / struct, including nesting, a defaulted field, and array-of-struct
    property <[int]> an_array: @from-json("from_json.json").an_array;
    property <Point> a_point: @from-json("from_json.json").a_point;
    property <Point> a_partial_point: @from-json("from_json.json").a_partial_point;
    property <Nested> a_nested: @from-json("from_json.json").a_nested;
    property <[Point]> an_array_of_points: @from-json("from_json.json").an_array_of_points;
    property <Complex> a_complex_nested: @from-json("from_json.json").element.sub_element.complex_nested;

    // Field default values of a struct
    property <WithDefaults> with_defaults;

    // The return value of a function or callback
    function implicit_return() -> Point { @from-json("from_json.json").a_point }
    function explicit_return() -> string { return @from-json("from_json.json").a_string; }
    function early_return(from_json: bool) -> int {
        if from_json { return @from-json("from_json.json").flat_value; }
        0
    }
    pure callback callback_return() -> [int];
    callback_return => { @from-json("from_json.json").an_array }
    function implicit_return_whole_file() -> Root { @from-json("from_json.json") }
    function explicit_return_whole_file() -> [Point] { return @from-json("from_json_array.json"); }
    pure callback callback_return_whole_file() -> Root;
    callback_return_whole_file => { @from-json("from_json.json") }

    // The model of a repeater
    points_layout := HorizontalLayout {
        padding: 0;
        for point in @from-json("from_json.json").an_array_of_points : Rectangle {
            width: point.x * 1px;
        }
    }
    root_points_layout := HorizontalLayout {
        padding: 0;
        for point in @from-json("from_json_array.json") : Rectangle {
            width: point.y * 1px;
        }
    }
    ints_layout := HorizontalLayout {
        padding: 0;
        for value in @from-json("from_json.json").an_array : Rectangle {
            width: value * 1px;
        }
    }

    // Built-in members of a value that isn't a JSON object
    property <int> array_length: @from-json("from_json.json").an_array.length;
    property <int> root_array_length: @from-json("from_json_array.json").length;
    property <int> nested_array_length: @from-json("from_json.json").element.sub_element.complex_nested.nested.length;
    property <int> empty_array_length: @from-json("from_json.json").an_empty_array.length;
    property <bool> array_length_comparison: @from-json("from_json.json").an_array.length > 2;
    property <int> string_character_count: @from-json("from_json.json").a_string.character-count;
    property <bool> string_is_empty: @from-json("from_json.json").a_string.is-empty;
    property <bool> empty_string_is_empty: @from-json("from_json.json").an_empty_string.is-empty;
    property <string> string_to_uppercase: @from-json("from_json.json").a_string.to-uppercase();
    property <string> string_to_lowercase: @from-json("from_json.json").a_nested.label.to-uppercase().to-lowercase();
    property <int> string_to_uppercase_count: @from-json("from_json.json").a_string.to-uppercase().character-count;
    property <bool> string_starts_with: @from-json("from_json.json").a_string.starts-with("he");
    property <bool> string_is_float: @from-json("from_json.json").a_numeric_string.is-float();
    property <float> string_to_float: @from-json("from_json.json").a_numeric_string.to-float();
    property <int> element_character_count: @from-json("from_json.json").element.sub_element.complex_nested.nested[0].label.character-count;
    property <float> number_abs: @from-json("from_json.json").a_negative.abs();
    property <int> number_round: @from-json("from_json.json").a_float.round();
    property <int> number_floor: @from-json("from_json.json").a_negative.floor();
    property <int> number_mod: @from-json("from_json.json").flat_value.mod(4);
    property <string> number_to_fixed: @from-json("from_json.json").a_float.to-fixed(2);
    property <int> element_max: @from-json("from_json.json").an_array[0].max(@from-json("from_json.json").an_array[2]);

    out property <bool> test:
        points_layout.min-width == 3px
        && root_points_layout.min-width == 6px
        && ints_layout.min-width == 6px
        && array_length == 3
        && root_array_length == 2
        && nested_array_length == 2
        && empty_array_length == 0
        && array_length_comparison
        && string_character_count == 5
        && !string_is_empty
        && empty_string_is_empty
        && string_to_uppercase == "HELLO"
        && string_to_lowercase == "hi"
        && string_to_uppercase_count == 5
        && string_starts_with
        && string_is_float
        && string_to_float == 4.5
        && element_character_count == 5
        && number_abs == 2.5
        && number_round == 4
        && number_floor == -3
        && number_mod == 2
        && number_to_fixed == "3.50"
        && element_max == 3
        && root_object.int_property == 5
        && root_object.a-float == 3.5
        && root_object.a_point.x == 1 && root_object.a_point.y == 2
        && root_array.length == 2
        && root_array[0].x == 1 && root_array[0].y == 2
        && root_array[1].x == 3 && root_array[1].y == 4
        && root_array_element.x == 3 && root_array_element.y == 4
        && root_array_element_field == 2
        && an_array_element == 2
        && an_array_of_points_element.x == 2 && an_array_of_points_element.y == 2
        && nested_array_element == 16
        && nested_struct_array_element == 10
        && flat_value == 10
        && nested_value_dash == 7
        && nested_value_underscore == 7
        && a_string == "hello"
        && a_bool
        && a_percent == 42%
        && a_length == 10px
        && a_duration == 250ms
        && a_angle == 90deg
        && a_color == #ff0000
        && a_named_color == #ff0000
        && a_direction == Direction.right
        && a_direction_prefixed == Direction.down
        && an_array.length == 3 && an_array[0] == 1 && an_array[1] == 2 && an_array[2] == 3
        && a_point.x == 1 && a_point.y == 2
        && a_partial_point.x == 9 && a_partial_point.y == 0
        && a_nested.point.x == 3 && a_nested.point.y == 4 && a_nested.label == "hi"
        && an_array_of_points.length == 2
        && an_array_of_points[0].x == 1 && an_array_of_points[0].y == 1
        && an_array_of_points[1].x == 2 && an_array_of_points[1].y == 2
        && a_complex_nested.value == "complex_nested_value"
        && a_complex_nested.array.length == 3
        && a_complex_nested.array[0] == 13 && a_complex_nested.array[1] == 14 && a_complex_nested.array[2] == 16
        && a_complex_nested.nested.length == 2
        && a_complex_nested.nested[0].point.x == 7 && a_complex_nested.nested[0].point.y == 8
        && a_complex_nested.nested[0].label == "first"
        && a_complex_nested.nested[1].point.x == 9 && a_complex_nested.nested[1].point.y == 10
        && a_complex_nested.nested[1].label == "second"
        && color_to_brush == #ff0000
        && dashed_key_underscore == 11 && dashed_key_dash == 11
        && a_sum == 5 && a_comparison
        && with_defaults.label == "hello"
        && with_defaults.point.x == 1 && with_defaults.point.y == 2
        && implicit_return().x == 1 && implicit_return().y == 2
        && explicit_return() == "hello"
        && early_return(true) == 10 && early_return(false) == 0
        && callback_return().length == 3 && callback_return()[2] == 3
        && implicit_return_whole_file().int_property == 5
        && implicit_return_whole_file().a_point.y == 2
        && explicit_return_whole_file().length == 2 && explicit_return_whole_file()[1].x == 3
        && callback_return_whole_file().a-float == 3.5;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```

```js
let instance = new slint.TestCase({});
assert(instance.test);
```

```python
instance = TestCase()
assert instance.test
```
*/
