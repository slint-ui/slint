export enum Emphasis { normal, strong }

export struct StateColors {
    background: color,
    foreground: color,
}

export struct Style {
    rest: StateColors,
    pressed: StateColors,
    spacing: length = 4px,
    emphasis: Emphasis,
}

struct UpdateOrder { x: int, y: int }
struct DefaultPair { x: int, y: int }
struct DefaultNested { data: DefaultPair, z: int }
struct DefaultLabels { labels: [string], count: int }

struct UpdateDefaults {
    with-array: DefaultLabels = { count: 3, ..{ labels: ["one", "two"] } },
    simple: DefaultPair = { x: 3, ..{ x: 1, y: 2 } },
    nested: DefaultNested = {
        data.y: 4,
        ..{ data: { x: 1, y: 2 }, z: 5 }
    },
    chained: DefaultPair = { x: 6, ..{ y: 7, ..{ x: 1, y: 2 } } },
    copied: DefaultPair = { ..(true ? { x: 8, y: 9 } : { x: 0, y: 0 }) },
    style: Style = { ..{ rest: { background: Colors.blue }, emphasis: Emphasis.strong } },
}

component DefaultStyle inherits Rectangle {
    in property <color> input-color;
    private property <color> inherited-color: root.input-color;
    in property <Style> style: {
        pressed: { background: root.default-color(), foreground: child.foreground },
        spacing: 9px,
    };
    pure function default-color() -> color { return root.inherited-color; }
    child := Rectangle {
        in property <color> foreground: root.input-color == black ? white : root.input-color;
    }
}

component CompactStyle inherits DefaultStyle {
    style.spacing: 6px;
}

component InheritedStyle inherits CompactStyle { }

export component TestCase {
    third := InheritedStyle {
        input-color: root.pressed-color;
        style.emphasis: strong;
    }
    fourth := InheritedStyle {
        input-color: root.accent;
        style.rest.background: red;
    }
    first := CompactStyle {
        input-color: root.accent;
        style.pressed { foreground: yellow };
        style.rest {
            background: black,
            foreground: green,
        };
        style.emphasis: strong;
    }

    second := DefaultStyle {
        private property <int> style-override-base: 42;
        input-color: black;
        style.emphasis: strong;
    }

    private property <UpdateDefaults> defaults;
    in-out property <color> accent: blue;
    in-out property <color> pressed-color: yellow;
    in-out property <length> gap: 8px;
    in-out property <Style> base: {
        rest: { background: root.accent, foreground: white },
        pressed: { background: black, foreground: white },
        spacing: root.gap,
    };
    out property <Style> custom: {
        pressed: { background: root.pressed-color, ..root.base.pressed },
        emphasis: strong,
        ..root.base
    };
    out property <Style> copy: { ..root.base };
    out property <Style> inline-base: { spacing: 16px, ..{ emphasis: strong } };
    out property <Style> chained: { spacing: 12px, ..root.custom, };
    out property <Style> replaced: { pressed: { background: red }, ..root.base };

    pure function update(style: Style) -> Style {
        let result = { emphasis: strong, ..style };
        return result;
    }

    pure callback copy-base() -> Style;
    copy-base => { ..root.base };

    pure callback dotted() -> Style;
    dotted => {
        pressed.background: root.pressed-color,
        pressed.foreground: root.accent,
        ..root.base
    };

    private property <UpdateOrder> order-base;
    private property <int> calls;
    private property <bool> single-evaluation;
    private property <bool> reactive;

    function counted-base() -> Style {
        root.calls += 1;
        return root.base;
    }

    function counted-spacing() -> length {
        root.calls += 10;
        return root.calls * 1px;
    }

    function next-override() -> int {
        root.calls += 1;
        return root.calls;
    }

    init => {
        let result = { spacing: 20px, ..root.counted-base() };
        let complete = {
            rest: { background: red },
            pressed: { background: red },
            spacing: 1px,
            emphasis: normal,
            ..root.counted-base()
        };
        root.single-evaluation = root.calls == 2 && result.spacing == 20px && complete.spacing == 1px;
        let ordered = { spacing: root.counted-spacing(), ..root.counted-base() };
        root.single-evaluation = root.single-evaluation && root.calls == 13 && ordered.spacing == 13px;
        let literal-base = { x: root.counted-spacing(), ..{ x: 0px, y: 7 } };
        root.single-evaluation = root.single-evaluation && root.calls == 23
            && literal-base.x == 23px && literal-base.y == 7;
        let ordered-fields = {
            field.y: root.next-override(),
            field.x: root.next-override(),
            ..{ field: root.order-base, rest: 7 },
        };
        root.single-evaluation = root.single-evaluation && ordered-fields.field.y == 24
            && ordered-fields.field.x == 25 && ordered-fields.rest == 7 && root.calls == 25;
        root.reactive = root.custom.rest.background == blue && root.custom.pressed.background == yellow;
        root.accent = green;
        root.pressed-color = orange;
        root.gap = 10px;
        root.reactive = root.reactive && root.custom.rest.background == green
            && root.custom.pressed.background == orange && root.custom.spacing == 10px;
    }

    out property <bool> test: root.single-evaluation && root.reactive
        && root.defaults.simple == { x: 3, y: 2 }
        && root.defaults.with-array.labels.length == 2
        && root.defaults.with-array.labels[1] == "two"
        && root.defaults.with-array.count == 3
        && root.inline-base.emphasis == Emphasis.strong
        && root.inline-base.spacing == 16px
        && root.defaults.nested == { data: { x: 1, y: 4 }, z: 5 }
        && root.defaults.chained == { x: 6, y: 7 }
        && root.defaults.copied == { x: 8, y: 9 }
        && root.defaults.style.spacing == 4px
        && root.defaults.style.emphasis == Emphasis.strong
        && root.defaults.style.rest.background == blue
        && root.custom.rest == root.base.rest
        && root.custom.pressed.background == root.pressed-color
        && root.custom.pressed.foreground == white
        && root.custom.emphasis == Emphasis.strong
        && root.custom.spacing == root.gap
        && root.base.pressed.background == black
        && root.base.emphasis == Emphasis.normal
        && root.dotted().pressed.background == root.pressed-color
        && root.dotted().pressed.foreground == root.accent
        && first.style.pressed.background == root.accent
        && first.style.pressed.foreground == yellow
        && first.style.rest.background == black
        && first.style.rest.foreground == green
        && first.style.emphasis == Emphasis.strong
        && first.style.spacing == 6px
        && second.style.pressed.background == black
        && second.style.pressed.foreground == white
        && second.style.emphasis == Emphasis.strong
        && second.style-override-base == 42
        && second.style.spacing == 9px
        && third.style.spacing == 6px
        && third.style.emphasis == Emphasis.strong
        && third.style.pressed.background == root.pressed-color
        && third.style.pressed.foreground == root.pressed-color
        && fourth.style.spacing == 6px
        && fourth.style.rest.background == red
        && fourth.style.pressed.background == root.accent
        && fourth.style.pressed.foreground == root.accent
        && root.dotted().rest == root.base.rest
        && root.dotted().spacing == root.base.spacing
        && root.copy == root.base
        && root.copy-base() == root.base
        && root.chained.spacing == 12px
        && root.chained.pressed == root.custom.pressed
        && root.replaced.pressed.foreground == transparent
        && root.update(root.base).emphasis == Emphasis.strong
        && ({ b: 9, ..{ a: 1, b: 2 } }.a == 1);
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
instance.set_accent(slint::Color::from_rgb_u8(10, 20, 30));
instance.set_pressed_color(slint::Color::from_rgb_u8(40, 50, 60));
instance.set_gap(16.);
assert!(instance.get_test());
assert_eq!(instance.get_custom().rest.background, instance.get_accent());
assert_eq!(instance.get_custom().pressed.background, instance.get_pressed_color());
assert_eq!(instance.get_custom().spacing, 16.);
```

```cpp
auto instance = TestCase::create();
assert(instance->get_test());
instance->set_accent(slint::Color::from_rgb_uint8(10, 20, 30));
instance->set_pressed_color(slint::Color::from_rgb_uint8(40, 50, 60));
instance->set_gap(16);
assert(instance->get_test());
assert_eq(instance->get_custom().rest.background, instance->get_accent());
assert_eq(instance->get_custom().pressed.background, instance->get_pressed_color());
assert_eq(instance->get_custom().spacing, 16);
```
*/
