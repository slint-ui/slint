// Right now, this test is only testing rust and C++ keyword, but it should be expanded to JS keywords

export struct struct {
    not: image
}

export struct dynamic_cast {
    delete: image
}

export struct operator {
    dynamic-cast: image
}

export struct static_assert {}
export struct unsigned {}
export struct namespace {}

export struct mod := {
    loop: string,
}

// #8923
export struct PlayerData {
    name: string,
    self: bool,
    super: int,
    crate: string,
    class: int,
}

match := Rectangle {
    property<mod> move: {loop : "mod" };
    in-out property<PlayerData> player: { name: "a", self: true, super: 42, crate: "c", class: 3 };
    in-out property<int> class: 7;
    property<bool> test: move.loop == "mod" && player.self && player.super == 42 && player.crate == "c" && player.class == 3;
}

/*
```rust
let instance = r#match::new().unwrap();
assert_eq!(instance.get_move(), r#mod{ r#loop: "mod".into() });
let player = instance.get_player();
assert!(player.self_);
assert_eq!(player.super_, 42);
assert_eq!(player.crate_, "c");
assert_eq!(player.class, 3);
instance.set_player(PlayerData { self_: false, ..player });
assert!(!instance.get_test());
```

```python
instance = match()
assert instance.class_ == 7
player = instance.player
assert player.self_
assert player.class_ == 3
player.self_ = False
instance.player = player
assert not instance.test
instance.player = PlayerData(name="a", self_=True, super=42, crate="c", class_=3)
assert instance.test
```

```csharp
using var instance = Match.Create();
Assert.AreEqual(new Mod { Loop = "mod" }, instance.Move);
Assert.AreEqual(7, instance.Class);
var player = instance.Player;
Assert.IsTrue(player.Self);
Assert.AreEqual(42, player.Super);
Assert.AreEqual("c", player.Crate);
Assert.AreEqual(3, player.Class);
instance.Player = player with { Self = false };
Assert.IsFalse(instance.Test);
instance.Player = player;
Assert.IsTrue(instance.Test);
```
*/
