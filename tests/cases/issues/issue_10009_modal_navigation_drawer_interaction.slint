import { ModalNavigationDrawer } from "../../../ui-libraries/material/src/material.slint";

export component TestCase inherits Window {
    width: 1000px;
    height: 700px;

    out property <int> selections;
    out property <int> selected-index: drawer.current_index;
    out property <bool> is-open: drawer.is-open;
    out property <bool> selection-synced;

    public function open-drawer() { drawer.show(); }
    public function close-drawer() { drawer.close(); }
    public function select-entry(group: int, index: int) { drawer.select(group, index); }

    drawer := ModalNavigationDrawer {
        x: 100px;
        y: 40px;
        width: 400px;
        height: 300px;
        groups: [{ title: "Group", items: [{ text: "First" }, { text: "Second" }] }];
        selected(group, index) => {
            root.selections += 1;
            root.selection-synced = self.current_group == group && self.current_index == index;
        }
    }
}

