// Items that draw outside their geometry, each in a cached layer, which is sized by the
// bounding rect of its children.

// SKIP_LINE_BY_LINE  - Path not implemented in line-by-line mode

export component TestCase inherits Window {
    width: 64px;
    height: 64px;
    background: white;

    // `fit: preserve` draws the path at its own coordinates.
    Rectangle {
        x: 2px;
        y: 4px;
        width: 10px;
        height: 10px;
        cache-rendering-hint: true;
        Path {
            width: 10px;
            height: 10px;
            fit: preserve;
            fill: blue;
            commands: "M 0 0 L 28 0 L 28 16 Z";
        }
    }

    // The miter join reaches past half the stroke width that the fit reserves.
    Rectangle {
        x: 50px;
        y: 2px;
        width: 12px;
        height: 24px;
        cache-rendering-hint: true;
        Path {
            width: 12px;
            height: 24px;
            stroke: green;
            stroke-width: 6px;
            stroke-line-join: miter;
            stroke-miter-limit: 10;
            commands: "M 30 0 L 0 12 L 30 24";
        }
    }

    // Elided text isn't clipped: the italic overhang and the outside stroke reach past it.
    Rectangle {
        x: 6px;
        y: 40px;
        width: 30px;
        height: 20px;
        cache-rendering-hint: true;
        Text {
            text: "ff";
            font-size: 18px;
            font-italic: true;
            color: black;
            stroke: red;
            stroke-width: 2px;
            stroke-style: outside;
            overflow: elide;
        }
    }
}
