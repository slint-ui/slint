// SIZE=132x132

// Same 5→330 upscale as upscaled-last-pixel.slint, unclipped (x/y = 0).

export component TestCase inherits Window {
    width: 132phx;
    height: 132phx;
    background: black;

    Image {
        source: @image-url("upscaled-last-pixel-5x5.png");
        x: 0phx;
        y: 0phx;
        width: 330phx;
        height: 330phx;
        image-fit: ImageFit.fill;
        image-rendering: ImageRendering.pixelated;
    }
}
