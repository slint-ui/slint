//ignore: software

export component TestCase inherits Window {
    width: 100px;
    height: 200px;

    Rectangle {
        transform-scale-x: 5;
        transform-scale-y: 10;

        Image {
            width: 10px;
            height: 10px;
            transform-scale: 2;
            source: @image-url("../../../../logo/slint-logo-small-light.svg");
        }
    }
}

