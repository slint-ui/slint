// SIZE=66x66

// Upscaling must reach the last source pixel (5 → 330). Negative placement shows only the
// trailing edge so a bad step shows up as missing red/green instead of black wrap.

export component TestCase inherits Window {
    width: 66phx;
    height: 66phx;
    background: black;

    // 5 → 330 px: the last source column is 66 px wide starting at x = 264.
    Image {
        source: @image-url("upscaled-last-pixel-5x5.png");
        x: -264phx;
        y: -264phx;
        width: 330phx;
        height: 330phx;
        image-fit: ImageFit.fill;
        image-rendering: ImageRendering.pixelated;
    }
}
