// SIZE=132x132

// 5 → 330 px pixelated upscale. Negative placement leaves only source columns 3–4 and rows 3–4
// visible: a ~66 px boundary between black (3) and red/green (4); wrong stepping shifts it.

export component TestCase inherits Window {
    width: 132phx;
    height: 132phx;
    background: black;

    Image {
        source: @image-url("upscaled-last-pixel-5x5.png");
        x: -198phx;
        y: -198phx;
        width: 330phx;
        height: 330phx;
        image-fit: ImageFit.fill;
        image-rendering: ImageRendering.pixelated;
    }
}
