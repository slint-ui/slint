// SIZE=32x32
// BASE_THRESHOLD=3  - allow small differences in base case due to platform-specific atan2
// ROTATION_THRESHOLD=4
// SKIP_LINE_BY_LINE  - Path not implemented in line-by-line mode

export component TestCase inherits Window {
    width: 32px;
    height: 32px;
    background: white;

    Path {
        width: 32px;
        height: 32px;
        commands: "M 0 0 L 100 0 L 50 100 Z";
        fill: @conic-gradient(red 0deg, lime 120deg, blue 240deg, red 360deg);
    }
}
