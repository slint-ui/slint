// SKIP_LINE_BY_LINE  - Path not implemented in line-by-line mode

export component TestCase inherits Window {
    width: 600px;
    height: 600px;

    property <string> commands: "M 5 5 L 25 5 L 45 30 L 45 60";

    thick := Path {
        width: parent.width;
        height: parent.height;
        fit: preserve;
        stroke-width: 6px;
        stroke: red;
        commands: root.commands;
    }

    thin := Path {
        width: parent.width;
        height: parent.height;
        fit: preserve;
        stroke-width: 4px;
        stroke: black;
        commands: root.commands;
    }
}
