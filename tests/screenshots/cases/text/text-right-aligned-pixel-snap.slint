// Regression test for #6739: a right-aligned `Text` whose right edge is pinned via a *computed*
// `x: 64px - width` (as opposed to a literal `x`) must render its glyphs in the same device-pixel
// column for every `width`, including fractional ones -- the pinned edge never visually moves, so
// the rendering must not either.
//
// Some renderers (skia, femtovg) round a text item's own screen position to the device-pixel grid
// before drawing glyphs, to avoid blurry nearest-neighbor sampling of the rasterized glyph atlas.
// They used to leave the box width that feeds the horizontal-alignment offset (`box_width -
// text_width`) unrounded. Since `x + width` is an exact device-pixel constant here, rounding only
// one of the two addends broke that invariant: `round(x) + width != round(x + width)` in general.
//
// Skia font rendering is not consistent across platforms
//ignore:skia

export component TestCase inherits Window {
    width: 64px;
    height: 50px;

    // Five rows, each holding one right-aligned `Text`. Only `width` varies (whole, quarter, and
    // half pixel steps); `x` is derived so the right edge stays pinned at logical 64px in every
    // row. All five must render the "000" glyphs in the same column.
    for w[i] in [30px, 30.25px, 30.5px, 30.75px, 31px] : Text {
        y: i * 10px;
        height: 10px;
        width: w;
        x: 64px - w;
        text: "000";
        horizontal-alignment: right;
    }
}
