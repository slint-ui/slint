// Regression test for #6739: fractional widths must preserve a fixed right edge.
// This covers exact positioning in the anyrender and software backends, which don't snap text origins.
//
// Skia is excluded because its font rendering varies across platforms.
//ignore:skia

export component TestCase inherits Window {
    width: 64px;
    height: 50px;

    // All five rows must draw "000" in the same column.
    for w[i] in [30px, 30.25px, 30.5px, 30.75px, 31px] : Text {
        y: i * 10px;
        height: 10px;
        width: w;
        x: 64px - w;
        text: "000";
        horizontal-alignment: right;
    }
}
