export component TestCase inherits Window {
    width: 320px;
    height: 200px;
    background: white;
    StyledText {
        width: 100%;
        height: 100%;
        text: @markdown("# Heading 1\n## Heading 2\n### Heading 3\nBody text\n*Italic* body");
        default-color: #025;
    }
}
