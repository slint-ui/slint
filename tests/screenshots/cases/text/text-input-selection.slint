// cSpell: ignore fiifiifiifiifiifiifiifiifii WAWA
// Skia font rendering is not consistent across platforms
//ignore:skia

component TestCase inherits Window {
    width: 64px;
    height: 64px;
    forward-focus: i-text-input;
    i-text-input := TextInput {
        x: 0;
        width: 50%;
        y: 0;
        // `single-line` defaults to true, so the new lines render as spaces (#7413).
        // `word-wrap` still breaks the text into several lines.
        text: "VAVAv\nLine\nWAWA";
        wrap: word-wrap;
        color: green;
        selection-background-color: blue.transparentize(10%);
        selection-foreground-color: yellow;
        font-size: 12px;
        init => { self.set-selection-offsets(13, 3); }
    }
    TextInput {
        x: parent.width / 2;
        width: 50%;
        y: 0;
        text: "fiifiifiifiifiifiifiifiifii";
        wrap: word-wrap;
        color: black;
        selection-background-color: red;
        selection-foreground-color: orange;
        font-size: 13px;
        init => { self.set-selection-offsets(13, 16); }
    }
}
