// Skia font rendering is not consistent across platforms
//ignore:skia
// The embedded bitmap-font fast path in the software renderer doesn't draw the
// inline code capsule, so the embed variant wouldn't exercise this feature.
//ignore: software-embed-assets
// SIZE=240x200

// Code at the start of the text, in the middle, wrapped over two lines,
// and with a symbol that comes from a fallback font.
export component TestCase inherits Window {
    width: 240px;
    height: 200px;
    background: white;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        StyledText {
            default-font-size: 18px;
            default-color: #111;
            text: @markdown("`start` of the text");
        }
        StyledText {
            default-font-size: 18px;
            default-color: #111;
            text: @markdown("in the `middle` of it");
        }
        StyledText {
            default-font-size: 18px;
            default-color: #111;
            text: @markdown("code that wraps: `one two three four five`");
        }
        StyledText {
            default-font-size: 18px;
            default-color: #111;
            text: @markdown("fallback `a●b` font");
        }
    }
}
