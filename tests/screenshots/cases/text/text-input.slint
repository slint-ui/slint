// Skia font rendering is not consistent across platforms
//ignore:skia


component TestCase inherits Window {
    width: 64px;
    height: 64px;
    forward-focus: i-text-input;
    VerticalLayout {
        i-text-input := TextInput {
            text: "Hello Everyone";
            wrap: word-wrap;
            color: green;
            font-size: 10px;
            init => { self.set-selection-offsets(7, 7); }
        }
        TextInput {
            // `single-line` defaults to true, so the new line renders as a space (#7413).
            text: "Hel\nlo";
            color: #abcd;
            opacity: 0.9;
            font-size: 10px;
            horizontal-alignment: center;
            init => { self.set-selection-offsets(4, 2); }
        }
        TextInput {
            text: "Everyone";
            font-size: 10px;
            width: 100%;
            horizontal-alignment: right;
            init => { self.set-selection-offsets(7, 5); }
        }
    }
}
