// SIZE=240x150
// BASE_THRESHOLD=3
//ignore: software

export component TestCase inherits Window {
    width: 240px;
    height: 150px;
    background: white;

    // Equal geometry with different paint exercises the shared shadow cache.
    // Repeated rectangles also exercise shadow bindings on repeated roots.
    for row in 3: Rectangle {
        y: row * 50px;
        height: 50px;
        for column in 4: Rectangle {
            x: 5px + column * 60px;
            y: 5px;
            width: 32px;
            height: 28px;
            background: column == 0 ? transparent : column == 1 ? #00800080
                : column == 2 ? @linear-gradient(90deg, #00800000, #008000ff) : green;
            border-width: 4px;
            border-color: column == 3 ? transparent : column == 2 ? #0000ff80 : blue;
            border-top-left-radius: row == 0 ? 0px : 8px;
            border-bottom-right-radius: row == 0 ? 0px : 4px;
            drop-shadow-color: #ff0000c0;
            drop-shadow-offset-x: 10px;
            drop-shadow-offset-y: 7px;
            drop-shadow-blur: row == 0 ? 0px : 4px;
            drop-shadow-spread: row == 1 ? 2px : row == 2 ? -2px : 0px;
        }
    }
}
