//ignore: software anyrender vello_cpu

export component TestCase inherits Window {
    width: 256px;
    height: 64px;

    HorizontalLayout {
        Rectangle { background: @linear-gradient(0deg, #F00, #488); }
        Rectangle { background: @linear-gradient(in oklab 0deg, #F00, #488); }
        Rectangle { background: @linear-gradient(in oklch 0deg, #F00, #488); }
        Rectangle { background: @linear-gradient(in hsl 0deg, #F00, #488); }
    }
}
