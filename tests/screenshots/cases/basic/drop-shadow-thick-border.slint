// SIZE=210x72
// BASE_THRESHOLD=3
//ignore: software

export component TestCase inherits Window {
    width: 210px;
    height: 72px;
    background: white;

    // The renderer increases positive radii smaller than half the border width.
    // The shadow preserves that painted shape when spread expands or contracts it.
    for row in 2: Rectangle {
        y: row * 36px;
        height: 36px;
        for column in 3: Rectangle {
            x: 4px + column * 70px;
            y: 4px;
            width: 24px;
            height: 24px;
            background: #00800080;
            border-width: 8px;
            border-color: row == 0 ? #0000ff80 : blue;
            border-top-left-radius: 1px;
            border-bottom-right-radius: 2px;
            drop-shadow-color: red;
            drop-shadow-offset-x: 34px;
            drop-shadow-blur: row == 0 ? 0px : 3px;
            drop-shadow-spread: (column - 1) * 1px;
        }
    }
}
