// ROTATION_THRESHOLD=10  - because gradients are imprecise in rotation
// SIZE=64x40

export component TestCase inherits Window {
    width: 64px;
    height: 40px;

    background: @linear-gradient(30deg, red, #00f8);

    Rectangle {
        x: 16px;
        y: 12px;
        width: 20px;
        height: 16px;
        background: #0f0a;
    }
}
