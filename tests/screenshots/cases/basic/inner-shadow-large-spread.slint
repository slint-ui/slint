// SIZE=100x40
// BASE_THRESHOLD=3
//ignore: software

// An inner shadow whose spread is at least half the box covers the whole box, with or without blur.
export component TestCase inherits Window {
    width: 100px;
    height: 40px;
    background: white;
    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        Rectangle {
            background: skyblue;
            border-radius: 8px;
            inner-shadow-color: red;
            inner-shadow-blur: 10px;
            inner-shadow-spread: 16px;
        }
        Rectangle {
            background: skyblue;
            border-radius: 8px;
            inner-shadow-color: red;
            inner-shadow-blur: 10px;
            inner-shadow-spread: 30px;
        }
        Rectangle {
            background: skyblue;
            inner-shadow-color: red;
            inner-shadow-spread: 30px;
        }
    }
}
