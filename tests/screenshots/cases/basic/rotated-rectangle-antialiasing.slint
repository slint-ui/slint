// BASE_THRESHOLD=3
//ignore: software, femtovg

// A rotated rectangle has anti-aliased edges, with and without a border
export component TestCase inherits Window {
    width: 64px;
    height: 32px;
    background: white;

    Rectangle {
        x: 6px;
        y: 6px;
        width: 20px;
        height: 20px;
        background: blue;
        transform-rotation: 20deg;
    }

    Rectangle {
        x: 38px;
        y: 6px;
        width: 20px;
        height: 20px;
        background: red;
        border-width: 2px;
        border-color: black;
        transform-rotation: 20deg;
    }
}
