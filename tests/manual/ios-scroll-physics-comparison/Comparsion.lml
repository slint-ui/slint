<!DOCTYPE LabPlotXML>
<project version="2.12.80" xmlVersion="22" modificationTime="2026-06-10 12:43:15:296" author="martin" saveCalculations="1" compressed="0" saveData="0" dockWidgetState="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;&lt;QtAdvancedDockingSystem Version=&quot;1&quot; UserVersion=&quot;0&quot; Containers=&quot;1&quot;&gt;&lt;Container Floating=&quot;0&quot;&gt;&lt;Splitter Orientation=&quot;-&quot; Count=&quot;0&quot;&gt;&lt;Sizes/&gt;&lt;/Splitter&gt;&lt;/Container&gt;&lt;/QtAdvancedDockingSystem&gt;&#10;" saveDefaultDockWidgetState="0" thumbnail="" creation_time="2026-06-10 09:00:19:874" name="Projekt" fixed="0" undoAware="1" uuid="{e1f35d18-5d17-4abb-90f9-9587ed042097}">
    <comment></comment>
    <child_aspect>
        <script creation_time="2026-06-10 09:08:30:142" name="ImportData" fixed="0" undoAware="1" uuid="{656d533a-ae01-40d8-af88-fe113f7498cc}" runtime="Python">
            <comment></comment>
            <editor text="from pylabplot import *&#10;import os&#10;from pathlib import Path&#10;import csv&#10;&#10;&#10;project = project()&#10;&#10;project_path = Path(project.fileName()).parents[0]&#10;cases = [&quot;01-fling-inside&quot;, &quot;02-fling-into-edge&quot;, &quot;03-release-outside-moving-outward&quot;, &quot;04-release-outside-held&quot;, &quot;05-release-outside-moving-inward&quot;, &quot;06-fling-near-minimum-speed&quot;, &quot;07-reversal-in-overscroll&quot;, &quot;08-touch-during-deceleration&quot;, &quot;09-touch-during-spring-back&quot;]&#10;&#10;filter = AsciiFilter()&#10;p = filter.properties()&#10;p.automaticSeparatorDetection = True&#10;p.headerEnabled = True&#10;p.headerLine = 1&#10;p.intAsDouble = False&#10;&#10;for case in cases:&#10;    case_path = os.path.join(project_path, &quot;cases&quot;, case)&#10;    &#10;    folderName = f&quot;Folder for {case}&quot;&#10;    folder = project.child(folderName, AspectType.Folder)&#10;    if folder is None:&#10;        folder = Folder(folderName)&#10;        project.addChild(folder)&#10;        &#10;    captures_path = os.path.join(case_path, &quot;captures.csv&quot;)&#10;    with open(captures_path) as csv_file:&#10;        reader = csv.reader(csv_file, delimiter = &quot;,&quot;)&#10;        header = None&#10;        for row in reader:&#10;            if header is None:&#10;                header = row&#10;                continue&#10;            &#10;            # handle subcases&#10;            data = {}&#10;            for (header_entry, row_entry) in zip(header, row):&#10;                data[header_entry] = row_entry&#10;            sub_case = data[&quot;file&quot;]&#10;            sub_case_name = sub_case.rsplit(&quot;-&quot;, 1)[0]&#10;&#10;            uikit_file_path = os.path.join(case_path, sub_case + &quot;.positions.csv&quot;)&#10;            slint_file_path = os.path.join(case_path, sub_case + &quot;.positions.slint.csv&quot;)&#10;            &#10;            worksheetName = f&quot;Worksheet for {sub_case_name}&quot;&#10;            worksheet = folder.child(worksheetName, AspectType.Worksheet)&#10;            if worksheet is None:&#10;                worksheet = Worksheet(worksheetName)&#10;                # TODO: set geometry&#10;                folder.addChild(worksheet)&#10;            &#10;            plot_area_name = f&quot;Plot for {sub_case_name}&quot;&#10;            plot_title = f&quot;{case} - {sub_case_name}&quot;&#10;            plot_area = worksheet.child(plot_area_name, AspectType.CartesianPlot)&#10;            if plot_area is None:&#10;                # print(f&quot;Create new plot: {plot_area_name}&quot;)&#10;                # Create a plot for the imported data&#10;                plot_area = CartesianPlot(plot_area_name)&#10;                plot_area.setType(CartesianPlot.Type.FourAxes)&#10;                plot_area.addLegend()&#10;                worksheet.addChild(plot_area)&#10;            plot_area.title().setText(plot_title)&#10;            print(f&quot;Plot {plot_title}&quot;)&#10;&#10;            &#10;                &#10;            folderName = f&quot;Data Folder for {case}&quot;&#10;            data_folder = folder.child(folderName, AspectType.Folder)&#10;            if data_folder is None:&#10;                data_folder = Folder(folderName)&#10;                folder.addChild(data_folder)&#10;            &#10;            for (file_path, prefix) in [(uikit_file_path, &quot;Reference&quot;), (slint_file_path, &quot;Slint&quot;)]:&#10;                spreadsheet_name = f&quot;{prefix} {sub_case}&quot;&#10;                spreadsheet = data_folder.child(spreadsheet_name, AspectType.Spreadsheet)&#10;                if spreadsheet is None:&#10;                    spreadsheet = Spreadsheet(spreadsheet_name)&#10;                    data_folder.addChild(spreadsheet)&#10;                # print(f&quot;Importing file: {file_path}&quot;)&#10;                filter.setProperties(p) # important to set new properties otherwise the filter stores the previous state&#10;                filter.readDataFromFile(file_path, spreadsheet, AbstractFileFilter.ImportMode.Replace)&#10;                &#10;                if filter.lastError():&#10;                    print(f&quot;Import error for file {file_path}: {filter.lastError()}&quot;)&#10;                &#10;                if prefix == &quot;Reference&quot;:&#10;                    curve_name = f&quot;UIkit {sub_case}&quot;&#10;                    curve = plot_area.child(curve_name, AspectType.XYCurve)&#10;                    if curve is None:&#10;                        curve = XYCurve(curve_name)&#10;                        # symbol = curve.symbol()&#10;                        # style = symbol.style()&#10;                        # symbol.setStyle(style)&#10;                        # curve.setSymbol(symbol)&#10;                        plot_area.addChild(curve)&#10;                    curve.setXColumn(spreadsheet.column(0))&#10;                    curve.setYColumn(spreadsheet.column(2))&#10;                    &#10;                    curve_name = f&quot;Slint {sub_case}&quot;&#10;                    curve = plot_area.child(curve_name, AspectType.XYCurve)&#10;                    if curve is None:&#10;                        curve = XYCurve(curve_name)&#10;                        plot_area.addChild(curve)&#10;                    curve.setXColumn(spreadsheet.column(0))&#10;                    curve.setYColumn(spreadsheet.column(3))&#10;                elif prefix == &quot;Slint&quot;:&#10;                    curve_name = f&quot;{prefix} New {sub_case}&quot;&#10;                    curve = plot_area.child(curve_name, AspectType.XYCurve)&#10;                    if curve is None:&#10;                        curve = XYCurve(curve_name)&#10;                        plot_area.addChild(curve)&#10;                    curve.setXColumn(spreadsheet.column(0))&#10;                    curve.setYColumn(spreadsheet.column(1))&#10;                else:&#10;                    assert false&#10;            result_path = os.path.join(project_path, &quot;results&quot;)&#10;            try:&#10;                os.mkdir(result_path)&#10;            except FileExistsError:&#10;                pass&#10;            except PermissionError:&#10;                print(f&quot;Permission denied: Unable to create '{result_path}'.&quot;)&#10;            except Exception as e:&#10;                print(f&quot;An error occurred: {e}&quot;)&#10;            worksheet.exportToFile(os.path.join(result_path, f&quot;{case}-{sub_case_name}&quot; + &quot;.png&quot;), Worksheet.ExportFormat.PNG)"/>
            <output>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
