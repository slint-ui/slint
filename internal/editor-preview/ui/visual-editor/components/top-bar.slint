import { Api, EditorSurfaceMode } from "../../api.slint";
import { EditorMetrics, StudioTheme } from "common.slint";

component RunButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked;

    width: 82px;
    height: 34px;
    border-radius: 7px;
    background: !root.enabled
        ? StudioTheme.panel-subtle
        : touch.pressed
            ? #087ccc
            : touch.has-hover
                ? #0a8ee8
                : StudioTheme.accent;
    border-width: button-focus.has-focus && root.enabled ? 2px : 0px;
    border-color: StudioTheme.dark ? white : #0969da;
    opacity: root.enabled ? 1 : 0.56;
    accessible-role: button;
    accessible-label: "Run live preview";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    animate background, opacity { duration: 100ms; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 13px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/octicons/play-16.svg");
            colorize: root.enabled ? white : StudioTheme.muted;
        }

        Text {
            text: "Run";
            color: root.enabled ? white : StudioTheme.muted;
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }

    button-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
}

export component EditorTopBar inherits Rectangle {
    height: EditorMetrics.top-bar-height;
    background: StudioTheme.panel-bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: StudioTheme.border;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        alignment: end;
        cross-axis-alignment: center;

        RunButton {
            enabled: !Api.startup-wizard-visible
                && Api.editor-surface-mode == EditorSurfaceMode.component
                && Api.selected-project-file != "";
            clicked => {
                Api.launch-live-preview();
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Api.selected-project-file;
            color: StudioTheme.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
