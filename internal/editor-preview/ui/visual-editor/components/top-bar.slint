import { Api, SpringboardRunState, SpringboardSessionStatus } from "../../api.slint";
import { EditorMetrics, StudioTheme } from "common.slint";

component RunButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label: "Run";
    callback clicked;

    width: root.label == "Run" ? 82px : 104px;
    height: 34px;
    border-radius: 7px;
    background: !root.enabled
        ? StudioTheme.panel-subtle
        : touch.pressed
            ? #087ccc
            : touch.has-hover
                ? #0a8ee8
                : StudioTheme.accent;
    border-width: button-focus.has-focus && root.enabled ? 2px : 0px;
    border-color: StudioTheme.dark ? white : #0969da;
    opacity: root.enabled ? 1 : 0.56;
    accessible-role: button;
    accessible-label: "Run live preview";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    animate background, opacity { duration: 100ms; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 13px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/octicons/play-16.svg");
            colorize: root.enabled ? white : StudioTheme.muted;
        }

        Text {
            text: root.label;
            color: root.enabled ? white : StudioTheme.muted;
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
        }
    }

    button-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
}

component DevicesButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked;

    width: 104px;
    height: 34px;
    border-radius: 7px;
    border-width: button-focus.has-focus && root.enabled ? 2px : 1px;
    border-color: button-focus.has-focus && root.enabled ? StudioTheme.accent-strong : StudioTheme.border;
    background: touch.pressed
        ? StudioTheme.soft-border
        : touch.has-hover
            ? StudioTheme.panel-subtle
            : StudioTheme.panel-bg;
    opacity: root.enabled ? 1 : 0.56;
    accessible-role: button;
    accessible-label: "Manage preview devices";
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    animate background, border-color, opacity { duration: 100ms; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Image {
            width: 16px;
            height: 16px;
            source: @image-url("../../assets/slinterface-primer-device-desktop.svg");
            colorize: root.enabled ? StudioTheme.text : StudioTheme.muted;
        }

        Text {
            text: "Devices";
            color: root.enabled ? StudioTheme.text : StudioTheme.muted;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    button-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            button-focus.focus();
            root.clicked();
        }
    }
}

export component EditorTopBar inherits Rectangle {
    height: EditorMetrics.top-bar-height;
    background: StudioTheme.panel-bg;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: StudioTheme.border;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: end;
        cross-axis-alignment: center;

        DevicesButton {
            enabled: !Api.startup-wizard-visible
                && Api.project-root != "";
            clicked => {
                Api.springboard-device-manager-selected-device-id = Api.springboard-last-used-device-id;
                Api.springboard-device-manager-visible = true;
            }
        }

        RunButton {
            enabled: !Api.startup-wizard-visible
                && Api.project-root != "";
            label: Api.springboard-run-state == SpringboardRunState.Starting
                ? "Starting…"
                : Api.springboard-run-state == SpringboardRunState.Connecting
                    ? "Connecting…"
                    : Api.springboard-run-state == SpringboardRunState.Reconnecting
                        ? "Reconnecting…"
                    : Api.springboard-run-state == SpringboardRunState.Running
                        ? "Running"
                        : "Run";
            clicked => {
                if Api.springboard-session-status == SpringboardSessionStatus.Unavailable {
                    Api.springboard-configure-project(Api.project-root);
                } else if Api.springboard-run-state == SpringboardRunState.Ready
                        || Api.springboard-run-state == SpringboardRunState.Starting
                        || Api.springboard-run-state == SpringboardRunState.Connecting
                        || Api.springboard-run-state == SpringboardRunState.Reconnecting
                        || Api.springboard-run-state == SpringboardRunState.Running {
                    Api.springboard-launch-device(Api.springboard-last-used-device-id);
                } else {
                    Api.springboard-device-manager-selected-device-id = Api.springboard-last-used-device-id;
                    Api.springboard-device-manager-visible = true;
                }
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: Api.selected-project-file;
            color: StudioTheme.muted;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
