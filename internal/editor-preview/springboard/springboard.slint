export enum PreviewEndpointKind {
    Local,
    Remote,
    Manual,
}

export struct PreviewEndpoint {
    name: string,
    kind: PreviewEndpointKind,
    address: string,
    unavailable-reason: string,
    version-mismatch: string,
    // Whether a discovered endpoint is also in `saved-endpoints`.
    saved: bool,
}

export enum SpringboardState {
    Stopped,
    Running,
}

export enum ConnectionState {
    None,
    Connecting,
    PairingRequired,
    UnpairedConfirmationRequired,
    Connected,
    Failed,
}

export struct Connection {
    state: ConnectionState,
    pairing-code-digits: int,
    error: string,
}

export enum ManualEndpointState {
    Idle,
    Probing,
    Reachable,
    Unreachable,
    Incompatible,
}

export struct ManualEndpoint {
    state: ManualEndpointState,
    version: string,
}

export global Springboard {
    // Local is always first.
    in property <[PreviewEndpoint]> saved-endpoints;
    in property <[PreviewEndpoint]> discovered-endpoints;
    in property <string> discovery-error;
    // Index into `saved-endpoints`.
    in property <int> selected-endpoint-index;
    in property <PreviewEndpoint> selected-endpoint;
    in property <SpringboardState> state;
    in property <Connection> connection;
    in property <ManualEndpoint> manual-endpoint;
    in property <string> editor-version;

    public pure function version-description(version: string) -> string {
        return @tr("Slint {} · Editor {}", version == "" || version == "unknown" ? @tr("Unknown") : version, root.editor-version);
    }

    callback close();
    // Index into `saved-endpoints`.
    callback select-endpoint(endpoint-index: int);
    // Index into `discovered-endpoints`.
    callback pair-endpoint(endpoint-index: int);
    // An empty host resets `manual-endpoint`.
    callback probe-address(host: string, port: int);
    callback connect-manual-endpoint();
    // Index into `saved-endpoints`.
    callback forget-device(endpoint-index: int);
    callback discover-devices();
    callback cancel-pairing();
    callback submit-pairing-code(code: string);
    callback accept-unpaired-connection();
}

// Library generation requires a component to export the shared global and its types.
export component SpringboardContext inherits Rectangle {}
