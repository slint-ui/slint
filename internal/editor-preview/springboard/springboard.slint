export enum PreviewEndpointKind {
    Local,
    Remote,
}

export struct PreviewEndpoint {
    name: string,
    kind: PreviewEndpointKind,
    addresses: [string],
    port: int,
    unavailable-reason: string,
}

export enum SpringboardState {
    Stopped,
    Idle,
    EndpointSelected,
}

export enum ConnectionState {
    None,
    Connecting,
    PairingRequired,
    UnpairedConfirmationRequired,
    Connected,
    Reconnecting,
    Failed,
}

export global Springboard {
    in property <[PreviewEndpoint]> endpoints;
    in property <int> selected-endpoint-index: -1;
    out property <PreviewEndpoint> selected-endpoint: endpoints[selected-endpoint-index];
    in property <SpringboardState> state;
    in property <ConnectionState> connection-state;
    in property <int> pairing-code-digits;
    in property <string> error-message;

    callback close();
    callback select-endpoint(endpoint-index: int);
    callback select-remote-address(address: string);
    callback submit-pairing-code(code: string);
    callback accept-unpaired-connection();
}

import { Button, VerticalBox, HorizontalBox, LineEdit, ListView } from "std-widgets.slint";

export component SpringboardView inherits Rectangle {
    background: #f5f5f5;
    border-width: 1px;
    border-color: #888;
    TouchArea {
        scroll-event => { return accept; }
    }

    VerticalBox {
        padding: 12px;
        spacing: 8px;
        Text {
            text: "Springboard";
            font-weight: 700;
        }

        ListView {
            height: 60px;
            for endpoint[index] in Springboard.endpoints: VerticalBox {
                padding: 0px;
                spacing: 2px;
                Button {
                    text: endpoint.name;
                    enabled: endpoint.unavailable-reason == "";
                    clicked => { Springboard.select-endpoint(index); }
                }
                if endpoint.unavailable-reason != "": Text {
                    text: endpoint.unavailable-reason;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            text: Springboard.state == SpringboardState.Stopped ? "Preview stopped"
                : Springboard.state == SpringboardState.Idle ? "Select an endpoint"
                : Springboard.selected-endpoint.kind == PreviewEndpointKind.Local ? "Local preview running"
                : Springboard.connection-state == ConnectionState.Connecting ? "Connecting to \{Springboard.selected-endpoint.name}"
                : Springboard.connection-state == ConnectionState.PairingRequired ? "Enter the code shown on \{Springboard.selected-endpoint.name}"
                : Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired ? "Connection to \{Springboard.selected-endpoint.name} is unencrypted"
                : Springboard.connection-state == ConnectionState.Connected ? "Connected to \{Springboard.selected-endpoint.name}"
                : "Connection to \{Springboard.selected-endpoint.name} failed";
            wrap: word-wrap;
        }

        Text {
            text: Springboard.error-message;
            color: #b02020;
            wrap: word-wrap;
        }

        if Springboard.connection-state == ConnectionState.PairingRequired: HorizontalBox {
            padding: 0px;
            code := LineEdit { placeholder-text: "\{Springboard.pairing-code-digits}-digit code"; }
            Button {
                text: "Submit";
                clicked => { Springboard.submit-pairing-code(code.text); code.text = ""; }
            }
        }

        if Springboard.connection-state == ConnectionState.UnpairedConfirmationRequired: Button {
            text: "Accept unencrypted connection";
            clicked => { Springboard.accept-unpaired-connection(); }
        }

        Button {
            text: Springboard.state == SpringboardState.Stopped ? "Close" : "Stop";
            clicked => { Springboard.close(); }
        }
    }
}
