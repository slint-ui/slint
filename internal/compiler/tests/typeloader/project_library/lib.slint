// A binding loop that, before edition 1.19, hides inside a longer one through the window layout
export component InnerLoop {
    HorizontalLayout {
        Rectangle {
            VerticalLayout {
//          >             <note{setting an 'x' or a 'y' here takes 'VerticalLayout' out of its parent's size, one way out of the binding loop reported for 'width' at line 10}
                Rectangle { width: parent.width; }
//                                 >           <warning{The binding for the property 'width' is part of a binding loop (VerticalLayout.width -> InnerLoop.width -> HorizontalLayout.width -> Rectangle.width -> VerticalLayout.width -> Rectangle.width -> VerticalLayout -> Rectangle -> HorizontalLayout -> InnerLoop -> VerticalLayout -> root -> VerticalLayout.width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'VerticalLayout', so its parent stops sizing itself from it↵This was allowed in previous version of Slint, but is deprecated and may cause panic at runtime}
            }
        }
    }
}
