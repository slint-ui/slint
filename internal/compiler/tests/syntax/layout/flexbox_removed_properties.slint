// The per-item flex-grow/flex-shrink/flex-basis properties were replaced by
// concepts the box layouts already use: the `*-stretch` factors (with
// `alignment: stretch` on the container), `min-*`/`max-*`, and `preferred-*`.
// They no longer exist at all.

export component X inherits Rectangle {

    FlexboxLayout {
        Text {
            flex-grow: 1;
//          >       <error{Unknown property flex-grow in Text}
            flex-shrink: 2;
//          >         <error{Unknown property flex-shrink in Text}
            flex-basis: 100px;
//          >        <error{Unknown property flex-basis in Text}
        }
    }
}
