export component SuperSimple {
    property <string> path;
    property <int> i1: @from-json(path);
//                                >  <error{@from-json must contain a plain path as a string literal}
    property <int> i2: @from-json("/home/\{path}.json");
//                                >       <error{@from-json must contain a plain path as a string literal, without any '\{}' expressions}
    property <int> i3: @from-json("/home/" + path + ".json");
//                                         ^error{Syntax error: expected ')'}
    property <int> i4: @from-json;
//                               ^error{Syntax error: expected '('}
    property <int> i5: @from-json("data.json", "int-property");
//                                           ^error{Syntax error: expected ')'}
    property <int> i6: @from-json("data.json",);
//                                           ^error{Syntax error: expected ')'}
}
