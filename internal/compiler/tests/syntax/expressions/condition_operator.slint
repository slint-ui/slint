struct Data {

}

export SuperSimple := Rectangle {
//                 ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    background: area.pressed ? green : blue;
    property<color> c2: area.pressed ? 123 : 456;
//                      >                       <error{Cannot convert float to color}

    property<int> c3: area.pressed ? 123 : #456;
//                                         >  <error{Cannot convert color to float}

    property<int> c4: area.pressed ? 123ms : 123;
//                                           > <error{Cannot convert float to duration. Use an unit, or multiply by 1ms to convert explicitly}

    property <length> c5: true ? 123px : 0;

    property<duration> c6: area.pressed ? 123ms : 123;
//                                                > <error{Cannot convert float to duration. Use an unit, or multiply by 1ms to convert explicitly}

    property<int> value1: 5;
    property<int> value2: 7;

    // true expression and false expression have both the same type so this is fine and results in an int
    // but the int does not match with [Data]
    property<Data> c7: true ? value1 : value2;
//                     >                     <error{Cannot convert int to Data}

    // Array case: true expression and false expression have both the same type so this is fine and results in an int
    // but the int does not match with [Data]
    property<[Data]> c8: true ? value1 : value2;
//                       >                     <error{Cannot convert int to [Data]}

    property<[int]> array1;
    property<[int]> array2;

    // Array case: true expression and false expression have both the same type so this is fine and results in an
    // int array but the does not match with [Data]
    property<[Data]> c9: true ? array1 : array2;
//                       >                     <error{Cannot convert [int] to [Data]}

    area := TouchArea {
    }
}


export Test2 := Rectangle {
//           ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    background: {
//              >error{Cannot convert void to brush}
        if (true) {
        } else {
            blue;
        }
    }

    x: { if (false) {0}; }
// <error{Cannot convert void to brush}
//     >^error{Cannot convert void to length}
    y: { if (false) {0px} else { return 5px; }; }
// <error{Cannot convert void to length}
    property<length> something: { if (true) {"hello"} else { return 5px; }; }
//                              >error{Cannot convert string to length}
}
//<<<<error{Cannot convert string to length}

// One part returns void
export component Test3 {
    property <int> foo: {  if true {}  };
//                      >               <error{Cannot convert void to int}

    property <int> foo2: {  if true { 5 }  };
//                       >                  <error{Cannot convert void to int}

    property <int> foo3: {  if true { } else { } };
//                       >                        <error{Cannot convert void to int}
}
