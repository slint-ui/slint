// A state allows one `animate *` per direction, across all of its blocks.

export component DuplicateInCatchAll inherits Rectangle {
    in-out property <bool> checked;
    in-out property <int> border;
    states [
        checked when checked: {
            border: 42;
            in {
                animate * { duration: 100ms; }
//                      ^note{The first 'animate *' is here}
            }
            in {
                animate * { duration: 200ms; }
//                      ^error{Only one 'animate *' is allowed per state and direction}
            }
        }
    ]
}

