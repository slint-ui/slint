export component InPlusOutCatchAllFine inherits Rectangle {
    in-out property <bool> checked;
    in-out property <int> border;
    states [
        checked when checked: {
            border: 42;
            in {
                animate * { duration: 100ms; }
            }
            out {
                animate * { duration: 200ms; }
            }
        }
    ]
}

export component MultipleNamedOnlyBlocksFine inherits Rectangle {
    in-out property <bool> checked;
    in-out property <int> border;
    in-out property <int> other;
    states [
        checked when checked: {
            border: 42;
            other: 1;
            in {
                animate border { duration: 100ms; }
            }
            in {
                animate other { duration: 200ms; }
            }
        }
    ]
}
