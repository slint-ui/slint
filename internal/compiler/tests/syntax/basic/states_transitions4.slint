// Multiple `in`/`out` blocks per state are fine as long as at most one of them (per
// effective direction) contains a `*` catch-all animation.

export component DuplicateInCatchAll inherits Rectangle {
    in-out property <bool> checked;
    in-out property <int> border;
    states [
        checked when checked: {
            border: 42;
            in {
                animate * { duration: 100ms; }
            }
            in {
                animate * { duration: 200ms; }
//              >                            <error{Multiple * animations are not allowed}
            }
        }
    ]
}

export component DuplicateOutCatchAll inherits Rectangle {
    in-out property <bool> checked;
    in-out property <int> border;
    states [
        checked when checked: {
            border: 42;
            out {
                animate * { duration: 100ms; }
            }
            out {
                animate * { duration: 200ms; }
//              >                            <error{Multiple * animations are not allowed}
            }
        }
    ]
}

