export component X inherits Rectangle {
    property <corner-shape> a: CornerShape.superellipse(3);
    property <float> k: 2;
    property <corner-shape> b: CornerShape.superellipse(k);
    property <corner-shape> c: CornerShape.superellipse();
//                                         >          <error{'superellipse()' expects one argument, the exponent, such as 'superellipse(2)'}
    property <corner-shape> d: CornerShape.superellipse(1, 2);
//                                         >          <error{'superellipse()' expects one argument, the exponent, such as 'superellipse(2)'}
    property <corner-shape> e: CornerShape.superellipse("string");
//                                                      >      <error{Cannot convert string to float}
    bevel := Rectangle {
        corner-shape: bevel;
//                    >   <error{Cannot take reference of an element. Did you mean 'CornerShape.bevel'?}
    }
}
