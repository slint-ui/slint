export component NotInIf inherits Rectangle {
    if true: Rectangle {
        @children
//      >       <error{The @children placeholder cannot appear in a conditional element}
    }
}

export component NotInFor inherits Rectangle {
    HorizontalLayout {
        for xxx in 12: Rectangle {
            VerticalLayout {
                @children
//              >       <error{The @children placeholder cannot appear in a repeated element}
            }
        }
    }
}

component TestBox inherits Rectangle {
    @children
    @children
//  >       <error{The @children placeholder can only appear once in an element}
}

export component TestBox2 inherits Rectangle {
    Rectangle {
        @children
    }
    @children
//  >       <error{The @children placeholder can only appear once in an element}
}

export component Final inherits TestBox {
    Rectangle {
        @children
    }
}
