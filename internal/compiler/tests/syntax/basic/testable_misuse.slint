// `@testable` guarantees a property's entry in the declared-property introspection table.
// Globals have no element-property table and interfaces have no runtime element to
// introspect, so a property declared there is rejected rather than silently accepted.
// Callbacks and functions have no value to read, so they're rejected too.

global G {
    @testable in-out property <int> val;
//  >       <error{'@testable' is not supported on global properties}
}

interface I {
    @testable in-out property <int> val;
//  >       <error{'@testable' is not supported on interface properties}
}

export component Test {
    implement I <=> self;
    in-out property <int> val;

    @testable callback c();
//  >       <error{'@testable' is only supported on properties}
    @testable public function f() { }
//  >       <error{'@testable' is only supported on properties}
}
