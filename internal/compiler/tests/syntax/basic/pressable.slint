import { Pressable } from "../../../widgets/common/pressable.slint";

export component TestCase inherits Window {
    out property <int> activation-count;

    public function activate() {
        pressable.activate();
    }

    pressable := Pressable {
        activate-on-enter: false;
        activated => { root.activation-count += 1; }

        Rectangle { background: blue; }
    }
}
