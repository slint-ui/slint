component Item {
    in property <string> title;
}

component Group {
    default slot <[Item]> entries;
    out property <string> selected-title: entries[1].title;
    for entry in entries: entry { }
}

export component Test inherits Window {
    Group {
        Item { title: "Static"; }
        for title in ["Repeated"]: Item { title: title; }
//                                 >   <error{A 'for' loop must be the only child in a collection slot}
    }
}
