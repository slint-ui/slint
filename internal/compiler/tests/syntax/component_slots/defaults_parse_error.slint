export component ConditionalDefault {
    slot content << if true: Text { }
//                  ><error{Wrap the 'if' in an element to use it as slot default content}
    content { }
}

export component RepeatedDefault {
    slot content << for i in 2: Text { }
//                  > <error{Wrap the 'for' in an element to use it as slot default content}
    content { }
}

export component EmptyDefault {
    slot content << { }
//                  ^error{Use 'slot content;' for a slot without default content}
    content { }
}

export component BracedDefault {
    slot content << { Text { } }
//                    >  <error{Remove '{ }' around slot element}
    content { }
}

export component StrayDefaultSemicolon {
    slot content << Text { };
//                          ^error{Remove the ';' after the slot content}
    content { }
}

export component StrayAssignmentSemicolon {
    StrayDefaultSemicolon {
        content << Text { };
//                         ^error{Remove the ';' after the slot content}
    }
}
