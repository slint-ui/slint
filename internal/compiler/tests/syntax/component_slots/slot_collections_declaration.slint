interface Entry { in property <int> value; }
export component MissingImplements {
    default slot <[Entry]> entries;
//                 >   <error{'Entry' is an interface; use '[implements Entry]' for an interface collection}
    for entry in entries: entry { }
}
export component WildcardDefault {
    slot <[*]> entries << Rectangle { }
//                        >           <error{Collection slots don't support default content yet}
    for entry in entries: entry { }
}
export component WrongType {
    default slot <[implements Rectangle]> items;
//                            >       <error{Slot type 'Rectangle' must be an interface}
    for item in items: item { }
}
export component Nested {
    Rectangle { slot <[implements Entry]> items; }
//                                        >   <error{Declare collection slots on a component root}
}
export component Duplicate {
    default slot <[implements Entry]> first;
    default slot <[implements Entry]> second;
//                                    >    <error{A component can only declare one default slot}
    for item in first: item { }
}
export component InvalidBody {
    default slot <[implements Entry]> items;
    for item in items: item { Rectangle { } }
//                            >           <error{Slot expansions only accept property bindings and callback connections}
}
export component MissingExpansion { default slot <[implements Entry]> items; }
//                                                                    >   <error{Expand collection slot 'items' with a 'for' loop}
export component DuplicateExpansion {
    default slot <[implements Entry]> items;
    for item in items: item { }
//                     >      <note{The slot 'items' is already used here}
    for item in items: item { }
//  >                         <error{The slot 'items' can only appear once in an element}
}
export component WrongExpansion {
    default slot <[implements Entry]> items;
//                                    >   <error{Expand collection slot 'items' with a 'for' loop}
    for item in items: Rectangle { }
}
export component ScalarDefault {
    default slot <Entry> item;
//  >                        <error{A default slot must have a collection type, such as <[*]>}
    item { }
}
export component Base {
    default slot <[implements Entry]> items;
    for item in items: item { }
}
export component Redeclared inherits Base { default slot <[implements Entry]> items; }
//                                                                            >   <error{A component can only declare one default slot}
export component Test inherits Window { }
