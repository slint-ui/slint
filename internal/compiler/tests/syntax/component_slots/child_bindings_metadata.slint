interface Entry {
    in property <int> value;
}

export component Test inherits Window {
    child-bindings <Entry> items { value: items.index; }
    out property <int> count: items.count;
    out property <int> invalid-index: items.index;
//                                          >   <error{Read child members and indexes inside the child-bindings block}

    out property <int> invalid-member: items.value;
//                                           >   <error{Read child members and indexes inside the child-bindings block}

    @children
}
