component Host {
    default slot <[*]> entries;
    for entry in entries: entry { }
}

export component Mixed {
    default slot <[*]> content;
    Host {
        entries << content;
        Rectangle { }
//      >        <error{Remove the children supplied to forwarded collection slot 'entries'}
    }
}
