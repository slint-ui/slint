interface Interaction {
    in property <bool> enabled;
    out property <bool> pressed;
    callback activated();
}

component Host {
    slot <Interaction> control;
    control { }
}

component LooksSimilar {
    in property <bool> enabled;
    out property <bool> pressed;
    callback activated();
}

export component StructuralImplementation {
    Host {
        control << LooksSimilar { }
    }
}

component NominalHost {
    slot <Text> control;
    control { }
}

export component WrongSlotType {
    NominalHost { control << Rectangle { } }
//                           >        <error{Slot 'control' requires 'Text' or a component inheriting it, but got 'Rectangle'}
}

export component IncompatibleForwarding {
    slot <Rectangle> content;
    NominalHost { control << content; }
//                           >     <error{Forwarded slot 'content' has an incompatible type}
}

component WildcardHost {
    slot <*> content;
    content { }
}

export component ListInSingleSlot {
    WildcardHost { content << [Rectangle { }] }
//                            >             <error{A list of elements can only be used with a collection slot}
}

export component NoChildrenInPlaceholder {
    slot <Interaction> control;
    control {
        Rectangle { }
//      >           <error{Typed slot placeholders only accept property bindings and callback connections}

    }
}

interface Other {
    in property <int> value;
}

export component WrongForwarding {
    slot <Other> input;
    Host {
        control << input;
//                 >   <error{Forwarded slot 'input' has an incompatible interface}

    }

    input { }
}

export component CannotReadExtraMembers {
    slot <Interaction> control;
    control { }

    out property <int> secret: control.secret;
//                                     >    <error{Element 'Interaction' does not have a property 'secret'}

}

export component CannotWriteOutput {
    slot <Interaction> control;
    control {
        pressed: true;
//      >     <error{Cannot assign to 'out' property 'pressed'}

    }
}
