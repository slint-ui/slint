interface Entry { in property <int> value; }
export component Test inherits Window {
    default slot <[Entry]> items;
    for item[index] in items: item { value: index; }
    out property <int> count: items.length;
    out property <int> invalid-count: items.count;
//                                          >   <error{A slot collection only exposes its 'length'; access each child inside its expansion}
    out property <int> invalid-index: items.index;
//                                          >   <error{A slot collection only exposes its 'length'; access each child inside its expansion}
    out property <int> invalid-member: items.value;
//                                           >   <error{A slot collection only exposes its 'length'; access each child inside its expansion}
    out property <int> escaped-index: index;
//                                    >   <error{Unknown unqualified identifier 'index'}
    out property <int> escaped-entry: item.value;
//                                    >        <error{Cannot access id 'item'}
}
