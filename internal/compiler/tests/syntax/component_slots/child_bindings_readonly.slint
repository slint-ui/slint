interface Entry {
    in property <int> value;
    callback clicked();
}

component Group {
    child-bindings <Entry> entries {
        clicked => {
            entries.index = 2;
//          >               <error{Collection metadata is read-only}
            entries.count = 3;
//          >               <error{Collection metadata is read-only}
        }
    }
    forward-focus: entries;
//                 >     <error{A child collection is not an element}
    @children
}

component Item {
    in property <int> value;
    callback clicked();
}

export component Test inherits Window {
    Group { Item { } }
}
