interface Entry {
    in property <int> value;
    callback clicked();
}
component Group {
    default slot <[Entry]> entries;
    for entry[index] in entries: entry {
        clicked => {
            index = 2;
//          >       <error{Collection metadata is read-only}
            entries.count = 3;
//          >               <error{Collection metadata is read-only}
        }
    }
    forward-focus: entries;
//                 >     <error{A child collection is not an element}
}
component Item {
    in property <int> value;
    callback clicked();
}
export component Test inherits Window { Group { Item { } } }
