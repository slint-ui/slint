// Embedding glyphs bakes one font into the binary,
// so a family no installed font provides is reported rather than silently replaced.

export component Test inherits Window {
    default-font-family: "NoSuchFamily-4997";
//                       >                  <warning{no font found for family 'NoSuchFamily-4997', embedding the default font instead; add the font with 'import "my-font.ttf";'}
}
