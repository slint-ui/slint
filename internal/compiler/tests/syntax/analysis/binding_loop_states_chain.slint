// The compiler-made 'state' shows in the chain as its element.
export component Test inherits Window {
    r := Rectangle {
//       >        <error{The binding for the property 'width' is part of a binding loop (r.width -> r -> r.width)}
        states [
            big when r.width > 100px: { width: 50px; }
        ]
    }
}
