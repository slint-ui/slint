Compo := Rectangle {
//    ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}

    property <string> the_text;

    lay := HorizontalLayout {
        if true : Rectangle {
            VerticalLayout {
                Text {
                    text: root.the_text;
                }
            }
        }
    }

}

// With layouts all the way up, nothing leaves the Text out, and the loop is reported.
component CompoLayout inherits HorizontalLayout {
    in property <string> the_text;
    if true : VerticalLayout {
        Text { text: root.the_text; }
//                   >            <error{The binding for the property 'text' is part of a binding loop (CompoLayout.preferred-width -> CompoLayout.the-text -> Text.text -> VerticalLayout -> CompoLayout -> CompoLayout.preferred-width)↵Compute 'text' without depending on a size or a position the layout produces}
    }
}

export Foo := Rectangle {
//         ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    Compo {
        the_text: self.preferred-width / 1px;
    }
    CompoLayout {
        the_text: self.preferred-width / 1px;
//                >                         <note{'the-text' is part of the binding loop reported for 'text' at line 25}
    }
}
