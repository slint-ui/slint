Compo := Rectangle {
//    ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}

    property <string> the_text;

    lay := HorizontalLayout {
        if true : Rectangle {
            VerticalLayout {
                Text {
                    text: root.the_text;
//                        >            <error{The binding for the property 'text' is part of a binding loop (Compo.layoutinfo-h -> Compo.preferred-width -> Compo.the-text -> Text.text -> VerticalLayout.layoutinfo-h -> Rectangle.layoutinfo-h -> lay.layoutinfo-h -> Compo.layoutinfo-h)}
                }
            }
        }
    }

}

export Foo := Rectangle {
//         ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    Compo {
        the_text: self.preferred-width / 1px;
//                >                         <note{'the-text' is part of the binding loop reported for 'text' at line 13}
    }
}
