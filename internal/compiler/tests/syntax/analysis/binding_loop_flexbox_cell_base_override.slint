// config:no_inlining
//
// A flexbox cell whose constraint reaches the cell's own geometry through a
// property the instance overrides. The constraint sits on the base, the
// override on the instance, so the walk in `constraint_reads_own_geometry` has
// to resolve each hop from the instance again. Inlining merges the two
// elements and hides that, hence the directive above.

component Card {
    in property <length> helper: 0px;
    min-height: root.helper;
//              >          <error{The binding for the property 'min-height' is part of a binding loop (helper -> root.min-height -> layout-cache -> width -> helper)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

export component Demo inherits Window {
    width: 300px;
    height: 200px;

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (helper -> root.min-height -> layout-cache -> width -> helper)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (helper -> root.min-height -> layout-cache -> width -> helper)}
        flex-direction: column;
        Card { helper: self.width; }
//                     >         <error{The binding for the property 'helper' is part of a binding loop (helper -> root.min-height -> layout-cache -> width -> helper)}
    }
}
