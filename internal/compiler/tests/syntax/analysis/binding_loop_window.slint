// Issue #2902

import { HorizontalBox, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {

    HorizontalBox {
//  >            <note{setting an 'x' or a 'y' here takes 'HorizontalBox' out of its parent's size, one way out of the binding loop reported for 'width' at line 15}

        VerticalBox {

            width: parent.width;
//                 >           <warning{The binding for the property 'width' is part of a binding loop (HorizontalBox.width -> VerticalBox.width -> HorizontalBox -> root -> HorizontalBox.width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'HorizontalBox', so its parent stops sizing itself from it↵This was allowed in previous version of Slint, but is deprecated and may cause panic at runtime}
            //height: parent.height;
            Text {
                text: "Test";
            }
        }
    }
}
