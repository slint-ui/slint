// A loop inside a component is reported once, inside it, not once per instance.
component Wrapper {
    width: 100%;
    height: 100%;
    Rectangle {
//  >        <error{The binding for the property 'layoutinfo-h' is part of a binding loop (Wrapper.width -> VerticalLayout -> Rectangle -> Wrapper -> HorizontalLayout -> Wrapper.width)↵Set an 'x' or a 'y' on 'VerticalLayout', so its parent stops sizing itself from it}
        VerticalLayout {
//      >             <note{setting an 'x' or a 'y' here takes 'VerticalLayout' out of its parent's size, one way out of the binding loop reported for 'layoutinfo-h' at line 8}
            if root.width > 200px: Rectangle { }
        }
    }
}
export component Test inherits Window {
    Rectangle { x: 0; HorizontalLayout { Wrapper { } } }
    Rectangle { x: 0; HorizontalLayout { Wrapper { } } }
}
