// A loop inside a component is reported once, inside it, not once per instance.
component Wrapper {
    HorizontalLayout {
        Text { text: "a"; font-size: self.width / 2.5; }
//                                   >               <error{The binding for the property 'font-size' is part of a binding loop (Text.font-size -> HorizontalLayout -> Text.width -> Text.font-size)↵Compute 'font-size' without depending on a size or a position the layout produces}
    }
}
export component Test inherits Window {
    Rectangle { x: 0; HorizontalLayout { Wrapper { } } }
    Rectangle { x: 0; HorizontalLayout { Wrapper { } } }
}
