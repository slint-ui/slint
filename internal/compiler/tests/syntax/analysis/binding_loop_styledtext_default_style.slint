export component WidthDependentStyle inherits Window {
    VerticalLayout {
        StyledText {
            text: @markdown("One\nTwo");
            default-style: { line-height-factor: self.width / 100px };
        }
    }
}

export component HeightDependentStyle inherits Window {
    StyledText {
        text: @markdown("One");
        default-style: { line-height-factor: self.height / 100px };
//                     >                                          <error{The binding for the property 'default-style' is part of a binding loop (StyledText.preferred-height -> StyledText.height -> StyledText.default-style -> StyledText -> StyledText.preferred-height)↵Compute 'default-style' without depending on a size or a position the layout produces}
    }
}
