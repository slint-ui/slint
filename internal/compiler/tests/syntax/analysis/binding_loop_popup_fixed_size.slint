// The popup's own 'width' binding moves to a compiler-made 'fixed-width', and stays the one reported.
export component Test inherits Window {
    popup := PopupWindow {
        width: t.preferred-width;
//             >                <error{The binding for the property 'fixed-width' is part of a binding loop (popup.fixed-width -> t.text -> t.preferred-width -> popup.fixed-width)}
        t := Text { text: popup.width > 10px ? "a" : "bbbbbbbbbb"; }
//                        >                                      <note{'text' is part of the binding loop reported for 'fixed-width' at line 7}
    }
}
