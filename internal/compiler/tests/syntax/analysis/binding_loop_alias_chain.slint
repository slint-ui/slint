// Issue #6237: the loop goes through two aliases, like the deprecated `viewport-width` of the
// std-widgets ScrollView.

component ScrollView {
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> viewport-width <=> content-width;

    flickable := Flickable {
//               >        <error{The binding for the property 'content-width' is part of a binding loop (flickable.content-width -> flickable-content.width -> v.width -> flickable.content-width)}
        @children
    }
}

// A declaration whose aliases loop, with a two-way binding on an instance.
component AliasCycle {
    in-out property <int> a <=> b;
    in-out property <int> b <=> a;
//                          >    <error{The binding for the property 'b' is part of a binding loop (AliasCycle.a -> AliasCycle.b -> AliasCycle.a)}
}

export component TestCase inherits Window {
    in-out property <int> local;
    AliasCycle { a <=> root.local; }
//               >               <note{'a' is part of the binding loop reported for 'b' at line 20}
    ScrollView {
        viewport-width: v.width;
        v := VerticalLayout { }
    }
}
