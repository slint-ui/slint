// #8852: the default height a state-set height falls back to follows the parent.

export component Test inherits Window {
    in property <bool> open;
    VerticalLayout {
        Rectangle {
            height: inner.height;
//                  >           <error{The binding for the property 'height' is part of a binding loop (Rectangle.height -> inner.height -> Rectangle.height)}
            inner := Rectangle {
//                   >        <note{'height' is part of the binding loop reported for 'height' at line 10}
                states [
                    expanded when open: { height: 50px; }
                    collapsed when !open: { height: 0px; }
                ]
            }
        }
        Rectangle {
            height: fixed.height;
            fixed := Rectangle {
                height: 0px;
                states [
                    expanded when open: { height: 50px; }
                ]
            }
        }
    }
}
