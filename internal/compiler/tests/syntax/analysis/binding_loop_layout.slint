TC := Rectangle {
// ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    outer := VerticalLayout {
        inner := HorizontalLayout {
            inner_inner := VerticalLayout {
                width: parent.width;
                Rectangle {}
            }
        }
    }
}

// With a layout as root, nothing leaves 'inner' out, and the loop is reported.
component TCLayout inherits VerticalLayout {
    inner := HorizontalLayout {
        inner_inner := VerticalLayout {
            width: parent.width;
//                 >           <error{The binding for the property 'width' is part of a binding loop (tc-layout.preferred-width -> tc-layout.width -> inner.width -> inner-inner.width -> inner -> tc-layout -> tc-layout.preferred-width)↵Compute 'width' without depending on a size or a position the layout produces}
            Rectangle {}
        }
    }
}

export Test := Rectangle {
//          ><warning{':=' to declare a component is deprecated. The new syntax declare components with 'component MyComponent {'. Read the documentation for more info}
    VerticalLayout {  // FIXME: That's an internal property, but people might understand
        Rectangle {
            width: parent.min_width;
//                 >               <error{The binding for the property 'width' is part of a binding loop (VerticalLayout.min-width -> Rectangle.width -> VerticalLayout -> VerticalLayout.min-width)↵Compute 'width' without depending on a size or a position the layout produces}
        }
    }


    l := HorizontalLayout {  // FIXME: That's an internal property, but people might understand
        Text {
            text: "hello \{l.preferred-width/1px}x\{l.preferred-height/1px}";
//                >                                                         <error{The binding for the property 'text' is part of a binding loop (l.preferred-width -> Text.text -> l -> l.preferred-width)↵Compute 'text' without depending on a size or a position the layout produces}
            wrap: word-wrap;
        }
    }

    tc := TC {
        width: preferred-width;
    }

    tc-layout := TCLayout {
        width: self.preferred-width;
//             >                   <note{'width' is part of the binding loop reported for 'width' at line 20}
    }
}
