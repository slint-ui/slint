export component Test {
    VerticalLayout {
        cross-axis-alignment: r.x > 10px ? start : end;
//                            >                       <error{The binding for the property 'cross-axis-alignment' is part of a binding loop (VerticalLayout.cross-axis-alignment -> VerticalLayout.layout-cache-ortho -> r.x -> VerticalLayout.cross-axis-alignment)}
        r := Rectangle {
            preferred-width: 50px;
        }
    }
}
