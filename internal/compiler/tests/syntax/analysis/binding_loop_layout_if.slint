component Wrapper {
    width: 100%;
    height: 100%;

    Rectangle {
        VerticalLayout {
            if root.width > 200px: Rectangle { }
        }
    }
}

component WrapperInherited inherits Rectangle {
    VerticalLayout {
        if root.width > 200px: Rectangle { }
    }
}

// With layouts all the way up, nothing leaves the repeated child out, and the loop is reported.
component WrapperLayout inherits VerticalLayout {
//                               >             <error{The binding for the property 'layoutinfo-h' is part of a binding loop (WrapperLayout.width -> WrapperLayout -> WrapperLayout.width)}
    if root.width > 200px: Rectangle { min-width: 300px; }
}

export component Test inherits Window {
    Rectangle { x: 0; HorizontalLayout { WrapperLayout { } } }

    VerticalLayout {
        HorizontalLayout {
            WrapperInherited { }
            Wrapper { }
        }
    }
}
