component Wrapper {
    width: 100%;
    height: 100%;

    Rectangle {
//  >        <error{The binding for the property 'layoutinfo-h' is part of a binding loop (Wrapper.width -> VerticalLayout -> Rectangle -> Wrapper -> HorizontalLayout -> Wrapper.width)↵Set an 'x' or a 'y' on 'VerticalLayout', so its parent stops sizing itself from it}
        VerticalLayout {
//      >             <note{setting an 'x' or a 'y' here takes 'VerticalLayout' out of its parent's size, one way out of the binding loop reported for 'layoutinfo-h' at line 8}
            if root.width > 200px: Rectangle { }
        }
    }
}

component WrapperInherited inherits Rectangle {
//                                  >        <warning{The binding for the property 'layoutinfo-h' is part of a binding loop (VerticalLayout.width -> HorizontalLayout.width -> HorizontalLayout -> WrapperInherited.width -> VerticalLayout -> WrapperInherited -> HorizontalLayout -> VerticalLayout -> root -> VerticalLayout.width)↵Set an 'x' or a 'y' on 'VerticalLayout', so its parent stops sizing itself from it↵This was allowed in previous version of Slint, but is deprecated and may cause panic at runtime}
    VerticalLayout {
//  >             <note{setting an 'x' or a 'y' here takes 'VerticalLayout' out of its parent's size, one way out of the binding loop reported for 'layoutinfo-h' at line 17}
        if root.width > 200px: Rectangle { }
    }
}

export component Test inherits Window {

    VerticalLayout {
        HorizontalLayout {
            WrapperInherited { }
            Wrapper { }
        }
    }
}
