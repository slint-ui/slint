component Foo {
    HorizontalLayout {

        Text {
            text: "hello";
            font_size: self.width / 2.5;
//                     >               <error{The binding for the property 'font-size' is part of a binding loop (Bar.layoutinfo-h -> Bar.preferred-width -> Bar.width -> HorizontalLayout.width -> HorizontalLayout.layout-cache -> Foo.width -> HorizontalLayout.width -> HorizontalLayout.layout-cache -> Text.width -> Text.font-size -> HorizontalLayout.layoutinfo-h -> Foo.layoutinfo-h -> HorizontalLayout.layoutinfo-h -> Bar.layoutinfo-h)}
        }
    }
}

component Bar {
    HorizontalLayout {
        Foo {}
        Foo {}
    }
}

export component Apps inherits Window {
    Bar {}
}
