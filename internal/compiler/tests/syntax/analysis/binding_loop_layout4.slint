component Foo {
    HorizontalLayout {

        Text {
            text: "hello";
            font_size: self.width / 2.5;
//                     >               <error{The binding for the property 'font-size' is part of a binding loop (Text.font-size -> HorizontalLayout -> Text.width -> Text.font-size)↵Compute 'font-size' without depending on a size or a position the layout produces}
        }
    }
}

component Bar {
    HorizontalLayout {
        Foo {}
        Foo {}
    }
}

export component Apps inherits Window {
    Bar {}
}
