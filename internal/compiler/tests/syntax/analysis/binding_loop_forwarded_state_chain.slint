// A state forwards the base's binding for 'w' through a compiler-made property, which shows in the chain as its element.
component Base {
    in-out property <length> a;
    in-out property <length> w: inner.width;
    inner := Rectangle { width: root.a; }
//                              >     <error{The binding for the property 'width' is part of a binding loop (b.a -> inner.width -> b -> b.w -> b.a)}
}
export component Test inherits Window {
    property <bool> c;
    b := Base {
//       >   <note{'w' is part of the binding loop reported for 'width' at line 8}
        a: self.w;
//         >     <note{'a' is part of the binding loop reported for 'width' at line 8}
        states [
            s when c: { w: 3px; }
        ]
    }
}
