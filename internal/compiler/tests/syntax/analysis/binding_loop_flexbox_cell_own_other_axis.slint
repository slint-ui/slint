// A flexbox cell sized from its own other axis. The solve reads the cell's
// explicit size constraints on both axes and produces one cache for both, so
// the read comes back to the solve. A box or grid layout solves one axis at a
// time and takes the cell's cross size straight from its own geometry, so the
// same markup is fine there.
//
// The cases, in order: one per orientation, since the solve declares both and
// dropping either lets a shape through; a constraint that isn't a plain size;
// a repeated component cell, which is measured through its own root; a
// locally-set constraint on a cell that carries its own layout-info, which
// `to_apply` keeps while dropping the inherited 'min-height' next to it; and a
// runtime 'flex-direction', which the solve handles without knowing the axis
// relation.
//
// Then the components that set the constraint inside themselves, where
// `to_apply` drops it — declared anyway, because it reaches the element's own
// geometry: 'CardSelf' directly, 'CardHelper' through a property, 'CardFn'
// through a function, 'CardAlias' through a two-way binding, and 'CardX'
// through 'x' rather than a size.

component CardHelper {
    property <length> helper: self.width;
//                            >         <error{The binding for the property 'helper' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
    min-height: root.helper;
//              >          <error{The binding for the property 'min-height' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

component CardFn {
    pure function helper() -> length { self.width }
//  >                                             <error{The binding for the property 'helper' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
    min-height: self.helper();
//              >            <error{The binding for the property 'min-height' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

component CardAlias {
    property <length> alias <=> self.width;
//                          >             <error{The binding for the property 'alias' is part of a binding loop (alias -> min-height -> layout-cache -> width -> alias)}
    min-height: root.alias;
//              >         <error{The binding for the property 'min-height' is part of a binding loop (alias -> min-height -> layout-cache -> width -> alias)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

component CardX {
    min-height: self.x;
//              >     <error{The binding for the property 'min-height' is part of a binding loop (x -> min-height -> layout-cache -> x)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

component CardSelf {
    min-height: self.width;
//              >         <error{The binding for the property 'min-height' is part of a binding loop (width -> min-height -> layout-cache -> width)}
//              >         <^error{The binding for the property 'min-height' is part of a binding loop (width -> min-height -> layout-cache -> width)}
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

component Card {
    min-height: inner.min-height;
    inner := VerticalLayout {
        Text { text: "a text long enough to wrap"; wrap: word-wrap; }
    }
}

export component Demo inherits Window {
    width: 300px;
    height: 200px;
    in property <bool> horizontal;

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> layout-cache -> height -> width)}
//  >            <^error{The binding for the property 'height' is part of a binding loop (width -> layout-cache -> height -> width)}
        Rectangle { width: self.height; }
//                         >          <error{The binding for the property 'width' is part of a binding loop (width -> layout-cache -> height -> width)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (height -> layout-cache -> width -> height)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (height -> layout-cache -> width -> height)}
        Rectangle { height: self.width; }
//                          >         <error{The binding for the property 'height' is part of a binding loop (height -> layout-cache -> width -> height)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (min-width -> layout-cache -> height -> min-width)}
//  >            <^error{The binding for the property 'height' is part of a binding loop (min-width -> layout-cache -> height -> min-width)}
        Rectangle { min-width: self.height; }
//                             >          <error{The binding for the property 'min-width' is part of a binding loop (min-width -> layout-cache -> height -> min-width)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> layout-cache -> height -> width)}
//  >            <^error{The binding for the property 'height' is part of a binding loop (width -> layout-cache -> height -> width)}
        for i in 2: Card { width: self.height; }
//                                >          <error{The binding for the property 'width' is part of a binding loop (width -> layout-cache -> height -> width)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> min-height -> layout-cache -> width)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (width -> min-height -> layout-cache -> width)}
        for i in 2: CardSelf { }
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> layout-cache -> height -> width)}
//  >            <^error{The binding for the property 'height' is part of a binding loop (width -> layout-cache -> height -> width)}
        flex-direction: column;
        Card { width: self.height; }
//                    >          <error{The binding for the property 'width' is part of a binding loop (width -> layout-cache -> height -> width)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> layout-cache -> height -> width)}
//  >            <^error{The binding for the property 'height' is part of a binding loop (width -> layout-cache -> height -> width)}
        flex-direction: root.horizontal ? row : column;
        Rectangle { width: self.height; }
//                         >          <error{The binding for the property 'width' is part of a binding loop (width -> layout-cache -> height -> width)}
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (width -> min-height -> layout-cache -> width)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (width -> min-height -> layout-cache -> width)}
        flex-direction: column;
        CardSelf { }
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
        flex-direction: column;
        CardHelper { }
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (helper -> min-height -> layout-cache -> width -> helper)}
        flex-direction: column;
        CardFn { }
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (alias -> min-height -> layout-cache -> width -> alias)}
//  >            <^error{The binding for the property 'width' is part of a binding loop (alias -> min-height -> layout-cache -> width -> alias)}
        flex-direction: column;
        CardAlias { }
    }

    FlexboxLayout {
//  >            <error{The binding for the property 'layout-cache' is part of a binding loop (x -> min-height -> layout-cache -> x)}
//  >            <^error{The binding for the property 'x' is part of a binding loop (x -> min-height -> layout-cache -> x)}
        flex-direction: column;
        CardX { }
    }
}
