// The 'x' or 'y' escape has to name the child the parent measures inside the cycle. Here
// 'measured' is that child, while 'sibling' only reaches the cycle through its own width, so
// an 'x' on 'sibling' would leave the loop untouched.
// Only a loop through the window's layout has the escape: elsewhere, the parent leaves the
// measured child out on its own.
export component Test inherits Window {
    in property <length> helper: sibling.width;
//                               >            <warning{The binding for the property 'helper' is part of a binding loop (sibling.width -> root.helper -> measured.text -> root -> sibling.width)↵Compute 'helper' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'measured', so its parent stops sizing itself from it↵This was allowed in previous version of Slint, but is deprecated and may cause panic at runtime}
    sibling := Rectangle { }
    measured := Text { text: root.helper / 1px; }
//              >   <note{setting an 'x' or a 'y' here takes 'measured' out of its parent's size, one way out of the binding loop reported for 'helper' at line 10}
//                           >                <^note{'text' is part of the binding loop reported for 'helper' at line 10}
}
