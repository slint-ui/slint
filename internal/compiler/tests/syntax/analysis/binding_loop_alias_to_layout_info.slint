// The content width is two-way bound to the preferred width of the content,
// which depends on the content width (#4458)

import { ScrollView } from "std-widgets.slint";

export component TestCase inherits Window {
    ScrollView {
        content-width <=> i-table.preferred-width;
        i-table := Rectangle {
            HorizontalLayout {
//          >               <note{setting an 'x' or a 'y' here takes 'HorizontalLayout' out of its parent's size, one way out of the binding loop reported for 'width' at line 16}
                for title in [""] : Rectangle {
                    width: i-table.width;
//                         >            <error{The binding for the property 'width' is part of a binding loop (flickable.content-width -> flickable-content.width -> i-table.width -> Rectangle.width -> HorizontalLayout -> i-table -> flickable.content-width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'HorizontalLayout', so its parent stops sizing itself from it}
                }
            }
        }
    }
}
