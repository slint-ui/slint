// The wrapping counterpart of tests/cases/layout/vlayout_repeated_nowrap_text_sized_by_layout.slint:
// a repeated Text that wraps takes its height from the layout's width, which closes a loop.

component Field inherits Rectangle {
//                       >        <error{The binding for the property 'layoutinfo-h' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
    preferred-width: max(l.preferred-width, 100phx);
    preferred-height: 25phx;
    l := HorizontalLayout {
//       >               <error{The binding for the property 'layoutinfo-h' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//       >               <^error{The binding for the property 'preferred-width' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        padding-left: 5phx + root.border-radius / 2;
//                    >                            <error{The binding for the property 'padding-left' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        Rectangle { }
    }
}

export component TestCase inherits Window {
    in-out property <bool> show;

    panel := Rectangle {
//           >        <error{The binding for the property 'preferred-width' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//           >        <^error{The binding for the property 'layoutinfo-v' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//           >        <^^error{The binding for the property 'preferred-height' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//           >        <^^^error{The binding for the property 'layoutinfo-h' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        width: self.preferred-width;
//             >                   <error{The binding for the property 'width' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        height: self.preferred-height;
//              >                    <error{The binding for the property 'height' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        VerticalLayout {
//      >             <error{The binding for the property 'width' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//      >             <^error{The binding for the property 'layoutinfo-v' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//      >             <^^error{The binding for the property 'height' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//      >             <^^^error{The binding for the property 'layout-cache' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//      >             <^^^^error{The binding for the property 'height' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
//      >             <^^^^^error{The binding for the property 'layoutinfo-h' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
            if show: Text { text: "Label"; wrap: word-wrap; }
//                   >   <error{The binding for the property 'width' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
            field := Field {
                border-radius: self.height / 2;
//                             >              <error{The binding for the property 'border-radius' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
            }
        }
    }
}
