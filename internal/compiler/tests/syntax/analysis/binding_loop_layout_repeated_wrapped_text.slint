// The wrapping counterpart of tests/cases/layout/vlayout_repeated_nowrap_text_sized_by_layout.slint:
// a repeated Text that wraps takes its height from the layout's width.
// 'panel' leaves its layout out of its own size rather than loop.
// 'panel-layout', a layout itself, has nothing to leave out, so its loop is reported.

component Field inherits Rectangle {
    preferred-width: max(l.preferred-width, 100phx);
    preferred-height: 25phx;
    l := HorizontalLayout {
//       >               <note{setting an 'x' or a 'y' here takes 'l' out of its parent's size, one way out of the binding loop reported for 'padding-left' at line 14}
        padding-left: 5phx + root.border-radius / 2;
//                    >                            <error{The binding for the property 'padding-left' is part of a binding loop (panel-layout.preferred-width -> panel-layout.width -> Text.width -> panel-layout -> panel-layout.preferred-height -> panel-layout.height -> panel-layout -> Field.height -> Field.border-radius -> l.padding-left -> l -> l.preferred-width -> Field -> panel-layout -> panel-layout.preferred-width)↵Compute 'padding-left' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'l', so its parent stops sizing itself from it}
        Rectangle { }
    }
}

export component TestCase inherits Window {
    in-out property <bool> show;

    panel := Rectangle {
        width: self.preferred-width;
        height: self.preferred-height;
        VerticalLayout {
            if show: Text { text: "Label"; wrap: word-wrap; }
            field := Field {
                border-radius: self.height / 2;
            }
        }
    }

    Rectangle {
        x: 0;
        panel-layout := VerticalLayout {
            width: self.preferred-width;
//                 >                   <note{'width' is part of the binding loop reported for 'padding-left' at line 14}
            height: self.preferred-height;
//                  >                    <note{'height' is part of the binding loop reported for 'padding-left' at line 14}
            if show: Text { text: "Label"; wrap: word-wrap; }
            Field {
                border-radius: self.height / 2;
//                             >              <note{'border-radius' is part of the binding loop reported for 'padding-left' at line 14}
            }
        }
    }
}
