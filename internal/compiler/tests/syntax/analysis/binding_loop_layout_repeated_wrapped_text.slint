// The wrapping counterpart of tests/cases/layout/vlayout_repeated_nowrap_text_sized_by_layout.slint:
// a repeated Text that wraps takes its height from the layout's width, which closes a loop.

component Field inherits Rectangle {
    preferred-width: max(l.preferred-width, 100phx);
    preferred-height: 25phx;
    l := HorizontalLayout {
        padding-left: 5phx + root.border-radius / 2;
//                    >                            <error{The binding for the property 'padding-left' is part of a binding loop (panel.layoutinfo-h -> panel.preferred-width -> panel.width -> VerticalLayout.width -> Text.width -> VerticalLayout.layoutinfo-v -> panel.layoutinfo-v -> panel.preferred-height -> panel.height -> VerticalLayout.height -> VerticalLayout.layout-cache -> field.height -> field.border-radius -> l.padding-left -> l.layoutinfo-h -> l.preferred-width -> field.layoutinfo-h -> VerticalLayout.layoutinfo-h -> panel.layoutinfo-h)}
        Rectangle { }
    }
}

export component TestCase inherits Window {
    in-out property <bool> show;

    panel := Rectangle {
        width: self.preferred-width;
//             >                   <note{'width' is part of the binding loop reported for 'padding-left' at line 11}
        height: self.preferred-height;
//              >                    <note{'height' is part of the binding loop reported for 'padding-left' at line 11}
        VerticalLayout {
            if show: Text { text: "Label"; wrap: word-wrap; }
            field := Field {
                border-radius: self.height / 2;
//                             >              <note{'border-radius' is part of the binding loop reported for 'padding-left' at line 11}
            }
        }
    }
}
