// config:no_inlining
// Issue 14895

component Icon inherits Image {
    width: 18px;
    height: self.width;
}

component Tile {
    HorizontalLayout {
//  >               <note{setting an 'x' or a 'y' here takes 'HorizontalLayout' out of its parent's size, one way out of the binding loop reported for 'width' at line 16}
        Rectangle {
            width: self.height;
//                 >          <error{The binding for the property 'width' is part of a binding loop (Rectangle.width -> Icon.width -> Rectangle -> HorizontalLayout -> root -> Tile.preferred-height -> Tile.height -> HorizontalLayout.height -> Rectangle.height -> Rectangle.width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'HorizontalLayout', so its parent stops sizing itself from it}
            if true: Icon { width: parent.width; }
//                                 >           <note{'width' is part of the binding loop reported for 'width' at line 16}
        }
    }
}

component BigIcon inherits Icon {
    width: 24px;
}

component DeepTile {
    HorizontalLayout {
//  >               <note{setting an 'x' or a 'y' here takes 'HorizontalLayout' out of its parent's size, one way out of the binding loop reported for 'width' at line 32}
        Rectangle {
            width: self.height;
//                 >          <error{The binding for the property 'width' is part of a binding loop (Rectangle.width -> BigIcon.width -> Rectangle -> HorizontalLayout -> root -> DeepTile.preferred-height -> DeepTile.height -> HorizontalLayout.height -> Rectangle.height -> Rectangle.width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'HorizontalLayout', so its parent stops sizing itself from it}
            if true: BigIcon { width: parent.width; }
//                                    >           <note{'width' is part of the binding loop reported for 'width' at line 32}
        }
    }
}

component WrappedText inherits Text {
    wrap: word-wrap;
}

component Caption inherits WrappedText {
    text: "Caption";
}

component TextTile {
    HorizontalLayout {
//  >               <note{setting an 'x' or a 'y' here takes 'HorizontalLayout' out of its parent's size, one way out of the binding loop reported for 'width' at line 52}
        Rectangle {
            width: self.height;
//                 >          <error{The binding for the property 'width' is part of a binding loop (Rectangle.width -> Caption.width -> Rectangle -> HorizontalLayout -> root -> TextTile.preferred-height -> TextTile.height -> HorizontalLayout.height -> Rectangle.height -> Rectangle.width)↵Compute 'width' without depending on a size or a position the layout produces, or set an 'x' or a 'y' on 'HorizontalLayout', so its parent stops sizing itself from it}
            if true: Caption { width: parent.width; }
//                                    >           <note{'width' is part of the binding loop reported for 'width' at line 52}
        }
    }
}

export component MainWindow inherits Window {
    Tile {
        height: self.preferred-height;
//              >                    <note{'height' is part of the binding loop reported for 'width' at line 16}
    }
    DeepTile {
        height: self.preferred-height;
//              >                    <note{'height' is part of the binding loop reported for 'width' at line 32}
    }
    TextTile {
        height: self.preferred-height;
//              >                    <note{'height' is part of the binding loop reported for 'width' at line 52}
    }
}
