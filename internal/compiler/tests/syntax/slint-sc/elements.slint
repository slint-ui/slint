// Every builtin element other than Rectangle, Window, TouchArea, and Image
// is rejected in Slint SC mode.

export component Test inherits Window {
    //#sls.geom.window
    x: 1px;
//     >  <error{The property 'x' is not supported in Slint SC}
    y: 1px;
//     >  <error{The property 'y' is not supported in Slint SC}
    width: 100px;
//         >    <error{Binding the 'width' of the root element is not supported in Slint SC}
    height: 100px;
//          >    <error{Binding the 'height' of the root element is not supported in Slint SC}

    Rectangle {
        x: 10px;
        width: 20px;
        height: 20px;
        background: red;
//                  > <error{Unknown unqualified identifier 'red'}
    }

    // The Image element is accepted; it's always the size of its source
    // image, so its size and the scaling properties can't be set
    //#sls.ref.image.size
    Image {
        source: @image-url("");
        x: 1px;
        y: 1px;
        width: 10px;
//      >   <error{The property 'width' is not supported in Slint SC}
        height: 10px;
//      >    <error{The property 'height' is not supported in Slint SC}
        image-fit: fill;
//      >       <error{The property 'image-fit' is not supported in Slint SC}
//                 >  <^error{Unknown unqualified identifier 'fill'}
        colorize: #ff0000;
//      >      <error{The property 'colorize' is not supported in Slint SC}
    }

    Text {
//  >   <error{The builtin element 'Text' is not supported in Slint SC}
        text: "hello";
//      >  <error{The property 'text' is not supported in Slint SC}
//            >     <^error{String literals are not supported in Slint SC}
    }

    // TouchArea is in the subset, but only its geometry and `clicked` are
    //#sls.ref.toucharea.members
    TouchArea {
        width: 10px;
        enabled: false;
//      >     <error{The property 'enabled' is not supported in Slint SC}
        pointer-event(event) => { }
//      >           <error{The callback 'pointer-event' is not supported in Slint SC}
//                    >   <^error{Callback handler parameters are not supported in Slint SC}
    }

    Flickable {
//  >        <error{The builtin element 'Flickable' is not supported in Slint SC}
    }

    FocusScope {
//  >         <error{The builtin element 'FocusScope' is not supported in Slint SC}
    }
}
