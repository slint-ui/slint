// A component may inherit from a component previously defined,
// including through a chain reaching a built-in element.

component Base inherits Rectangle {
    width: 8px;
    height: 8px;
    background: #112233;
}

component Mid inherits Base { }

export component Test inherits Window {
    Mid { }
}
