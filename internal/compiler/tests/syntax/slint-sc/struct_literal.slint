// A struct literal must set exactly the struct's fields: no missing, no extra.

struct Point { x: length, y: length }

export component Test inherits Window {
    //#sls.struct.literal.exact
    out property <Point> ok: { x: 1px, y: 2px };
    out property <Point> missing: { x: 1px };
//                                >         <error{Omitting the struct field 'y' is not supported in Slint SC}
    out property <Point> extra: { x: 1px, y: 2px, z: 3px };
//                              >                         <error{Providing the extra struct member 'z' is not supported in Slint SC}
}
