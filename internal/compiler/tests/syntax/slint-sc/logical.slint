// The logical operators require boolean operands; no other type is coerced.

export component Test inherits Window {
    in property <int> n;
    //#sls.op.bool-operands
    out property <bool> a: n && true;
//                         ><error{Cannot convert int to bool}
    out property <bool> b: !n;
//                         ><error{Cannot convert int to bool}
//                         > <^error{Cannot convert int to bool}
}
