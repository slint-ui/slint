// The named import is the only form of import in the subset, and an export
// statement only exports names defined in the file.

import { Frame } from "./imported/shapes.slint";

//#sls.import.named-only
import "./imported/shapes.slint";
//     >                       <error{File imports are not supported in Slint SC}
//>                               <^<<error{Import names are missing. Please specify which types you would like to import}

//#sls.export.forms
export { Frame } from "./imported/shapes.slint";
//                    >                       <error{Re-exports are not supported in Slint SC}

export component Test inherits Window {
    Frame { }
}
