// A user-declared enum is accepted, can be a property type, and a value is written `Enum.value`.

//#sls.file.top-level-item
//#sls.enum.decl
enum Direction { up, down, left, right }

// An enum must have at least one value.
//#sls.enum.nonempty
enum Empty { }
//>            <<<error{Enums must have at least one value}

// A value may not have the same name as the enum.
//#sls.enum.value-name
enum SameName { SameName, other }
//              >      <error{Enum 'SameName' can't have a value with the same name}

// `-` and `_` are the same character, so these name one value.
//#sls.enum.distinct
enum Duplicates { hello-world, hello_world }
//                             >         <error{Duplicated enum value 'hello-world'}

// Different values that map to the same generated name cannot coexist.
//#sls.enum.name-collision
enum Collision { hello-world, HelloWorld }
//                            >        <error{Duplicated enum value 'HelloWorld'}

export component Test inherits Window {
    //#sls.prop.decl.types
    in-out property <Direction> direction;
    //#sls.enum.value
    out property <Direction> fixed: Direction.down;

    out property <int> bare: up;
//                           ><error{Unknown unqualified identifier 'up'. Did you mean 'Direction.up'?}
}
