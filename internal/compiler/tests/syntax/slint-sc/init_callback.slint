// init callbacks are rejected in Slint SC mode.

export component Test inherits Window {
    init => { debug("hello"); }
//  >  <error{The callback 'init' is not supported in Slint SC}
//                  >     <^error{String literals are not supported in Slint SC}
//            >   <^^error{Unknown unqualified identifier 'debug'}
}
