// Each invocation runs the handler of the callback, so a cycle of handlers
// would never end.

component Inner inherits Rectangle {
    callback first;
    callback second;
}

export component Test inherits Window {
    //#sls.callback.handler.no-cycle
    inner := Inner {
        first => { inner.second(); }
//      >error{The binding for the property 'first' is part of a binding loop (inner.first -> inner.second -> inner.first)}
        second => { inner.first(); }
//      >error{The binding for the property 'second' is part of a binding loop (inner.first -> inner.second -> inner.first)}
//     <^error{The binding for the property 'first' is part of a binding loop (inner.first -> inner.second -> inner.first)}
    }
// <error{The binding for the property 'second' is part of a binding loop (inner.first -> inner.second -> inner.first)}
    TouchArea {
        clicked => { inner.first(); }
    }
}
