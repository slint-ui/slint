// Keywords are contextual: outside the position where the grammar expects
// their construct, they are ordinary identifiers, usable as component name,
// property name, or element id.

//#sls.lex.contextual-keywords

export component component inherits Window {
    property <length> property;
    property <length> component;
    property <color> callback;
    property <length> inherits;
    property <color> import;
    property <length> if;
    property <color> export;
    property <length> global;
    property <color> in;
    property <length> out;
    property <color> for;
    property <length> states;
    property <color> animate;
    property <length> function;
    property <color> struct;
    property <length> enum;

    if := Rectangle { }
    for := Rectangle { }
    states := Rectangle { }
}
