// States are part of the Slint SC subset. A state needs a condition, changes
// only properties that are in the subset, and carries no transition.

export component Test inherits Window {
    in-out property <bool> active;
    r := Rectangle { ta := TouchArea { } }

    states [
        //#sls.state.condition-required
        always: { r.background: #0f0; }
//      >    <error{A state without a 'when' condition is not supported in Slint SC}

        on when active: {
            //#sls.state.change.subset
            r.border-width: 2px;
//          >            <error{The property 'r.border-width' is not supported in Slint SC}
            //#sls.state.change.target-must-exist
            r.nope: 3;
//          >    <error{'nope' not found in 'r'}
            unknown.background: #0f0;
//          >                <error{'unknown' is not a valid element id}
            ta.clicked: 1;
//          >        <error{'ta.clicked' is not a valid property}
            //#sls.state.no-transition
            in { }
//          >    <error{Transitions are not supported in Slint SC}
        }
    ]
}
