// States and transitions are rejected in Slint SC mode.

export component Test inherits Window {
    in-out property <bool> active;

    states [
//  >error{States are not supported in Slint SC}
        on when active: { }
        off when !active: { }
    ]
//  <error{States are not supported in Slint SC}
}
