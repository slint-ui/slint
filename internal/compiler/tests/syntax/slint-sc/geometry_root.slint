// The x and y of the root element are meaningless, and its width and height
// are the size the application gives the component: binding any of the four in
// Slint SC is an error.
//#sls.geom.window

export component Test inherits Window {
    //#sls.geom.window.root
    x: 10px;
//     >   <error{The property 'x' is not supported in Slint SC}
    y: 20px;
//     >   <error{The property 'y' is not supported in Slint SC}
    //#sls.ref.window.width-out
    width: 30px;
//         >   <error{Binding the 'width' of the root element is not supported in Slint SC}
    //#sls.ref.window.height-out
    height: 40px;
//          >   <error{Binding the 'height' of the root element is not supported in Slint SC}
}
