// A binding into a child's declared property can form a cycle just like a
// binding between builtin properties; binding_analysis must report it, not
// hang.

component Inner inherits Rectangle {
    in property <length> input;
    out property <length> output: input;
//                                >    <error{The binding for the property 'output' is part of a binding loop (root.loopback -> inner.input -> inner.output -> root.loopback)}
}

export component Test inherits Window {
    property <length> loopback: inner.output;
//                              >           <error{The binding for the property 'loopback' is part of a binding loop (root.loopback -> inner.input -> inner.output -> root.loopback)}
    inner := Inner {
        input: loopback;
//             >       <error{The binding for the property 'input' is part of a binding loop (root.loopback -> inner.input -> inner.output -> root.loopback)}
    }
}
