export component Test inherits Window {
    MenuBar {
        Menu {
            MenuItem {
                role: quit;
            }
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                role: about;
//                    >    <warning{'role' only has an effect on a 'MenuItem' in a 'MenuBar', remove it}
            }
        }
    }
}
