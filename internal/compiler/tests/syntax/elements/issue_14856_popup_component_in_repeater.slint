import { DatePickerPopup } from "std-widgets.slint";

component MyPopup inherits PopupWindow {
    Rectangle { background: red; }
}

export component Test inherits Window {
    in property <bool> cond: true;

    if cond : VerticalLayout {
        p := MyPopup { }
        d := DatePickerPopup { }
        TouchArea {
            clicked => {
                p.show();
                d.show();
            }
        }
    }

    for i in 2 : Rectangle {
        q := MyPopup { }
        TouchArea {
            clicked => {
                q.show();
            }
        }
    }

    if cond : MyPopup { }
//            >      <error{PopupWindow cannot be directly repeated or conditional}
}
