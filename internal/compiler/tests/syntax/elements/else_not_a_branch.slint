// `else` after a conditional starts a branch only as `else if` or `else :`. Every other form
// keeps `else` as an ordinary identifier, so here each `else` resolves as an element or a
// property rather than attaching to the `if` as a branch.

export component TestCase inherits Rectangle {
    if true : Rectangle { }
    else { }
//  >   <error{Unknown element 'else'}

    if true : Rectangle { }
    else : 1px;
//  >  <error{Unknown property else in Rectangle}
}
