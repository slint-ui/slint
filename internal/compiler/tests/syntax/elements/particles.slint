component Base inherits Particles {
    Emitter { }
}

component Bursting inherits Particles { }

export component Foo inherits Window {
    Particles { }
//  >        <warning{This 'Particles' element never shows particles. Add an 'Emitter', or call 'burst()'}

    bursting := Particles { }
    TouchArea {
        clicked => { bursting.burst(5); }
    }

    Base {
//  >   <error{The base type already has an 'Emitter' or affector. Declare all of them in one place}
        Gravity { }
    }

    Bursting { }

    Particles {
        for i in 3: Emitter { x: i * 1px; }
//                  >      <error{'Emitter' and affector elements can't be repeated or conditional}
        if true: Gravity { }
//               >      <error{'Emitter' and affector elements can't be repeated or conditional}
        Emitter { }
    }
}
