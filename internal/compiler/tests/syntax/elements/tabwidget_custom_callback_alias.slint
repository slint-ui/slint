import { TabWidget } from "std-widgets.slint";
import { TabBarItem } from "std-widget-interfaces.slint";

component Bar {
    in property <[TabBarItem]> tabs;
    in property <Orientation> orientation;
    in-out property <int> current-index;
    out property <int> focused-index: -1;
    public function focus-tab(index: int) { }
    @children
}

component Header {
    in property <string> title;
    in property <bool> selected;
    in property <bool> focused;
    callback activated <=> interaction.clicked;
    interaction := TouchArea { }
}

export component Test inherits Window {
    TabWidget {
        bar << Bar { }
        Tab { header << Header { } }
    }
}
