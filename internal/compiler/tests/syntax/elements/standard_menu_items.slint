export component Test inherits Window {
    property <StandardMenuItemKind> paste: StandardMenuItemKind.paste;

    MenuBar {
        Menu {
            StandardMenuItem {
                kind: StandardMenuItemKind.undo;
            }
            StandardMenuItem {}
//          >               <error{StandardMenuItem must have a binding set for its 'kind' property}
            StandardMenuItem {
                kind: root.paste;
//                    >         <error{'kind' must be a 'StandardMenuItemKind' value}
            }
        }
    }

    ContextMenuArea {
        Menu {
            StandardMenuItem {
                kind: StandardMenuItemKind.undo;
            }
            StandardMenuItem {}
//          >               <error{StandardMenuItem must have a binding set for its 'kind' property}
        }
    }
}
