export component Foo inherits Window {
    Particles {
        Emitter { foo: 3; }
//                > <error{Unknown property foo in Emitter}
        Friction { magnitude: 3px; }
//                 >       <error{Unknown property magnitude in Friction}
        Emitter { rate: "fast"; }
//                      >     <error{Cannot convert string to float}
        emitters: [];
//      >      <error{Cannot assign to 'private' property 'emitters'}
    }

    Rectangle {
        Emitter { }
//      >      <error{Emitter can only be within a Particles element}
    }
}
