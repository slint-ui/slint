                text: @markdown("No tooltip here");
            }
            MenuItem {
                title: "Item";
                Tooltip {
//              >      <error{Tooltip cannot be added to MenuItem}
                    text: @markdown("No tooltip here");
                }
            }
        }
        Tooltip {
//      >      <error{Tooltip cannot be added to MenuBar}
            text: @markdown("No tooltip here");
        }
    }
}

