            title: "File";
            Timer { interval: 100ms; }
//          >    <error{Timer cannot be in a menu. Move it out of the menu}
            MenuItem {
                title: "Item";
                Timer { interval: 100ms; }
//              >    <error{Timer cannot be in a menu. Move it out of the menu}
            }
        }
    }
    ContextMenuArea {
        Menu {
            Timer { interval: 100ms; }
//          >    <error{Timer cannot be in a menu. Move it out of the menu}
        }
    }
}

export component Tray inherits SystemTrayIcon {
