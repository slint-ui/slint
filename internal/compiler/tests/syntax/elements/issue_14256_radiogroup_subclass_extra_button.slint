import { RadioGroup, RadioButton } from "std-widgets.slint";

component Colors inherits RadioGroup {
    RadioButton { text: "Red"; }
}

export component Test inherits Window {
    Colors {
//  >     <error{Declare managed children on the component subclass, not on its instance}
        RadioButton { text: "Blue"; }
    }
}
