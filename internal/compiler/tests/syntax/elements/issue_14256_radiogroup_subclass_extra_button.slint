import { RadioGroup } from "std-widgets.slint";

component Colors inherits RadioGroup {
    RadioButton { text: "Red"; }
}

export component Test inherits Window {
    Colors {
//  >     <error{Cannot add 'RadioButton' elements when instantiating a 'RadioGroup' subclass that already declares its own; declare them on the subclass instead}
        RadioButton { text: "Blue"; }
    }
}
