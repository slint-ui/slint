@actor
export component PowerMeter {
    callback fetch-reading() -> string;
//  >                                 <error{Callback 'fetch-reading' of the @actor component 'PowerMeter' can't return a value. Actors receive callbacks as messages; use a property that the actor sets for the result}
    callback refresh();
    in property <string> reading;
}
