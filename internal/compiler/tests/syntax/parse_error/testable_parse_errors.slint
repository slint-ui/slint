export component Test {
    // `@testable` only prefixes a property, callback or function declaration
    @testable
    Rectangle {}
//  >       <error{@testable can only be applied to a member declaration}

    @testable @testable in-out property <int> twice;
//                     ^error{Duplicated @testable attribute}

    // combining `@testable` and `@shadowable` in either order is fine at the parser level
    @testable @shadowable in-out property <int> a;
    @shadowable @testable in-out property <int> b;
}
