export component A inherits Window {
    property <int> value;
    Rectangle {
        y := 50px;
//        ><error{Parse error: expected an element after ':='. Use ':' instead of ':=' to set a binding}
        x := root.x;
//        ><error{Parse error: expected an element after ':='. Use ':' instead of ':=' to set a binding}
        width = 50px;
//            ^error{Parse error: unexpected '='. Use ':' instead of '=' to set a binding}
        background: red;
    }
    value = 42;
//        ^error{Parse error: unexpected '='. Use ':' instead of '=' to set a binding}
    r := Rectangle { }
    t := Text { text: r.width / 1px; }
}
