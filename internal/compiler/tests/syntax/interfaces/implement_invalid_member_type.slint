// A member declared with an unknown type used to be reported as missing, too.
// It is not missing: only 'Unknown type' reports it.

interface Labelled {
    in property <string> text;
    in property <int> level;
}

export component InvalidMemberType {
    implement Labelled <=> self;

    in property <Nonexistent> text;
//               >         <error{Unknown type 'Nonexistent'}
    in property <int> level;
}

export component InvalidMemberTypeAmongMissing {
    implement Labelled <=> self;
//            >       <error{Cannot implement 'Labelled'.↵- missing 'in property <int> level;'}

    in property <Nonexistent> text;
//               >         <error{Unknown type 'Nonexistent'}
}
