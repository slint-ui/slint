// When the member that fails to satisfy an interface is a shadowing declaration (stored under a
// mangled internal name), the "declares here" note must still point at its source location.

interface I {
    in-out property <bool> value;
}

component Base inherits Rectangle {
    @shadowable in-out property <bool> value;
}

export component Impl inherits Base {
    implement I <=> self;
//            ><error{Cannot implement 'I'.↵- 'value' must be a 'bool' property (found a 'int' property)}
    // The shadowing declaration changes the type, so it no longer satisfies the interface:
    in-out property <int> value;
//                        >   <warning{'value' shadows the inherited property of the same name}
//                   > <^note{'Impl' declares 'value' here, 'I' expects 'in-out property <bool> value;'}
}
