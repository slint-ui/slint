component match {
    in-out property <int> match;
}

export component ChildBindings {
    in-out property <int> other;
    match {
        match: 2;
    }
    match {
        match <=> root.other;
    }
}

export component Components {
    in property <int> value;
    in property <bool> condition;
    first := match { }
    match { }
    if condition: match { }
    for i in 2: match { }
    match value {
        1: match { }
        *: match { }
    }
}
