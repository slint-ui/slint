export component Foo {
    in property <float> pi: 3.1;
    in property <float> t: 0.0;

    match pi {
//  >   <error{Cannot match on 'pi', which is of type float}
        2.9: Rectangle { }
        3.0: Rectangle { }
        3.1: Rectangle { }
        3.2: Rectangle { }
        *: Rectangle { }
    }

    match t {
//  >   <error{Cannot match on 't', which is of type float}
        0.0: Rectangle { }
        *: Rectangle { }
    }
}
