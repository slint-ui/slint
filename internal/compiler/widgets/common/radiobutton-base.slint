import { ActivationBase } from "activation-base.slint";

export component RadioButtonBase inherits ActivationBase {
    in property <string> label;
    in property <bool> checked: false;
    in property <int> item-index: -1;

    callback selected;
    callback focus-change(bool);

    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-checked <=> root.checked;
    accessible-role: radio-button;
    accessible-item-index: root.item-index;
    width: 100%;
    height: 100%;

    activated => { root.selected(); }

    changed has-focus => {
        root.focus-change(root.has-focus);
    }

    accessible-action-default => {
        if (root.enabled) {
            root.selected();
        }
    }
}
