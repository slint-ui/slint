export component RadioButtonBase {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> group-enabled: true;
    in property <int> item-index;
    in property <int> group-current-index: -1;
    in-out property <bool> checked: root.group-current-index == root.item-index;

    callback toggled();
    callback group-select();
    callback focus-change(bool);

    out property <bool> has-focus: focus-scope.has-focus;
    out property <bool> pressed: touch-area.pressed;
    out property <bool> has-hover: touch-area.has-hover;

    private property <bool> selected: root.group-current-index == root.item-index;

    changed selected => { root.toggled(); }

    init => {
        if root.checked && root.group-current-index != root.item-index {
            root.group-select();
        }
    }

    // A two-way checked binding replaces the default and needs explicit synchronization.
    changed group-current-index => {
        if root.checked != (root.group-current-index == root.item-index) {
            root.checked = root.group-current-index == root.item-index;
        }
    }

    changed checked => {
        if root.checked && root.group-current-index != root.item-index {
            if root.enabled && root.group-enabled {
                root.group-select();
            } else {
                root.checked = false;
            }
        } else if !root.checked && root.group-current-index == root.item-index {
            root.checked = true;
        }
    }

    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled && root.group-enabled;
    accessible-item-index: root.item-index;
    accessible-action-default => {
        if root.enabled && root.group-enabled {
            root.group-select();
        }
    }

    forward-focus: focus-scope;

    touch-area := TouchArea {
        enabled: root.enabled && root.group-enabled;
        clicked => {
            if root.enabled && root.group-enabled {
                root.group-select();
            }
        }
    }

    focus-scope := FocusScope {
        x: 0;
        width: 0;
        enabled: root.enabled && root.group-enabled;
        focus-gained => { root.focus-change(true); }
        focus-lost => { root.focus-change(false); }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch-area.clicked();
                return accept;
            }
            return reject;
        }
    }

    @children
}
