import { MaterialPalette } from "styling.slint";
import { ProgressIndicatorBase } from "../common/progressindicator-base.slint";

export component ProgressIndicator inherits ProgressIndicatorBase {
    min-height: 4px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    i-background := Rectangle {
        background: MaterialPalette.control-background-variant;
        clip: true;

        i-track := Rectangle {
            background: MaterialPalette.accent-background;
            x: !root.indeterminate ? 0px : -parent.width + (parent.width * mod(animation-tick(), 2s) / 1s);
            y: (parent.height - self.height) / 2;
            width: !root.indeterminate ? parent.width * root.normalized-progress : parent.width;
            border-radius: i-background.border-radius;
        }
    }
}
