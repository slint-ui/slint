import { MaterialPalette, Elevation } from "styling.slint";
import { SliderInterface } from "../common/std-widget-interfaces.slint";
import { Slider as SliderControl } from "../headless/controls.slint";

// Allows to select a value from a range of values.
export component Slider {
    implement SliderInterface <=> control;

    forward-focus: control;

    accessible-role: slider;
    accessible-orientation: root.orientation;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-action-set-value(new-value) => {
        if (new-value.is-float()) {
            root.set-value(new-value.to-float());
        }
    }
    accessible-action-increment => { root.increment(); }
    accessible-action-decrement => { root.decrement(); }

    min-width: control.vertical ? 20px : 0px;
    min-height: control.vertical ? 0px : 20px;
    accessible-value-step: min(root.step, (root.maximum - root.minimum) / 100);

    states [
        disabled when !root.enabled : {
            handle.background: MaterialPalette.control-foreground;
            handle.drop-shadow-blur: Elevation.level0;
            track.background: MaterialPalette.control-foreground;
            surface.background: MaterialPalette.control-foreground;
            root.opacity: 0.38;
        }
        pressed when control.handle-pressed || root.has-focus : {
            state-layer.opacity: 0.12;
            handle.drop-shadow-blur: Elevation.level0;
        }
        hover when root.has-hover : {
            state-layer.background: MaterialPalette.control-foreground;
            state-layer.opacity: 0.08;
        }
    ]

    surface := Rectangle {
        background: MaterialPalette.control-background-variant;
        opacity: 0.38;
        x: control.vertical ? (parent.width - self.width) / 2 : handle.width / 2;
        y: control.vertical ? handle.height / 2 : (parent.height - self.height) / 2;
        width: control.vertical ? 4px : parent.width - handle.width;
        height: control.vertical ? parent.height - handle.height : 4px;
        border-radius: 2px;
    }

    track := Rectangle {
        background: MaterialPalette.accent-background;
        x: control.vertical ? (parent.width - self.width) / 2 : surface.x;
        y: control.vertical ? handle.y + handle.height / 2 : (parent.height - self.height) / 2;
        width: control.vertical? surface.width : handle.x;
        height: control.vertical? parent.height - handle.y - handle.height : surface.height;
        border-radius: surface.border-radius;
    }

    state-layer := Rectangle {
        opacity: 0;
        background: MaterialPalette.accent-background;
        x: control.vertical ? (parent.width - self.width) / 2 : handle.x - (self.width - handle.width) / 2;
        y: control.vertical ? handle.y - (self.height - handle.height) / 2 : (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        border-radius: max(self.width, self.height) / 2;

        animate opacity { duration: 250ms; easing: ease; }
    }

    handle := Rectangle {
        x: control.vertical ? (parent.width - self.width) / 2 : clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0, parent.width - self.width);
        y: control.vertical ? clamp((parent.height - self.height) * (root.maximum - root.value) / (root.maximum - root.minimum), 0, parent.height - self.height) : (parent.height - self.height) / 2;
        background: MaterialPalette.accent-background;
        width: control.vertical ? root.min-width : root.min-height;
        height: self.width;
        border-radius: max(self.width, self.height) / 2;
        drop-shadow-color: MaterialPalette.shadow;
        drop-shadow-blur: Elevation.level1;
        drop-shadow-offset-y: 1px;

        animate drop-shadow-blur { duration: 250ms; easing: ease; }
    }

    control := SliderControl {
        handle-x: handle.x;
        handle-y: handle.y;
        handle-width: handle.width;
        handle-height: handle.height;
    }
}
