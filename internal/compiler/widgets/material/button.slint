import { Ripple } from "components.slint";
import { MaterialFontSettings, MaterialPalette, Elevation } from "styling.slint";
import { ButtonBase } from "../common/button-base.slint";

component MaterialButtonPresentation {
    in property <string> text;
    in property <image> icon;
    in property <length> icon-size: 24px;
    in property <length> border-radius;
    in property <brush> text-color;
    in property <float> text-opacity;
    in property <bool> colorize-icon;
    in property <length> layout-padding-left;
    in property <length> layout-padding-right;
    in property <bool> has-visible-focus;
    in property <bool> has-hover;
    in property <bool> pressed;
    in property <bool> checked;
    in property <length> pressed-x;
    in property <length> pressed-y;

    min-width: layout.min-width;
    min-height: layout.min-height;

    states [
        pressed when root.pressed: {
            ripple.opacity: 0.12;
        }
        checked when root.checked: {
            ripple.opacity: 1.0;
            ripple.background: MaterialPalette.accent-background;
        }
        hover when root.has-hover: {
            ripple.opacity: 0.08;
        }
        focused when root.has-visible-focus: {
            ripple.opacity: 0.12;
        }
    ]

    ripple := Ripple {
        width: 100%;
        height: 100%;
        opacity: 0;
        active: root.pressed;
        ripple-x: root.pressed-x;
        ripple-y: root.pressed-y;
        clip: true;
        background: MaterialPalette.foreground-alt;
        ripple-color: MaterialPalette.secondary-ripple;
        has-effect: true;
        border-radius: root.border-radius;

        animate opacity { duration: 250ms; easing: ease; }
        animate background { duration: 250ms; }
    }

    layout := HorizontalLayout {
        spacing: 8px;
        padding-left: root.layout-padding-left;
        padding-right: root.layout-padding-right;
        padding-top: 5px;
        padding-bottom: 5px;

        if root.icon.width > 0 && root.icon.height > 0: Image {
            source <=> root.icon;
            width: root.icon-size;
            min-height: root.icon-size;
            opacity: root.text-opacity;
            colorize: root.colorize-icon ? root.text-color : transparent;
            accessible-role: none;
        }

        if root.text != "": Text {
            text: root.text;
            color: root.text-color;
            opacity: root.text-opacity;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-weight: MaterialFontSettings.label-large.font-weight;
            accessible-role: none;

            animate color {
                duration: 250ms;
                easing: ease;
            }
        }
    }
}

// Default button widget with Material Design Filled Button look and feel.
export component Button inherits ButtonBase {
    focus-on-pointer-click: true;

    in property <image> icon <=> presentation.icon;
    in property <length> icon-size <=> presentation.icon-size;
    in property <bool> primary;
    in property <bool> colorize-icon <=> presentation.colorize-icon;

    min-height: max(40px, layout.min-height);
    min-width: max(40px, layout.min-width);
    states [
        disabled when !root.enabled: {
            background.background: MaterialPalette.foreground-alt;
            background.opacity: 0.12;
            presentation.text-opacity: 0.38;
            presentation.text-color: MaterialPalette.control-foreground;
        }
        checked when root.checked: {
            presentation.text-color: MaterialPalette.accent-foreground;
        }
    ]

    background := Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 20px;
        background: root.primary ? MaterialPalette.accent-background : MaterialPalette.control-background;
        drop-shadow-color: transparent;
        drop-shadow-blur: Elevation.level0;
        drop-shadow-offset-y: 1px;
    }

    layout := HorizontalLayout {
        presentation := MaterialButtonPresentation {
            text: root.text;
            layout-padding-left: 24px;
            layout-padding-right: 24px;
            border-radius: background.border-radius;
            text-color: root.primary ? MaterialPalette.accent-foreground : MaterialPalette.control-foreground;
            text-opacity: 1.0;
            has-visible-focus: root.has-visible-focus;
            has-hover: root.has-hover;
            pressed: root.pressed;
            checked: root.checked;
            pressed-x: root.pressed-x;
            pressed-y: root.pressed-y;
        }
    }
}

export component TextButton inherits ButtonBase {
    focus-on-pointer-click: true;

    in property <image> icon <=> presentation.icon;
    in property <bool> colorize-icon <=> presentation.colorize-icon;

    min-height: max(40px, presentation.min-height);
    min-width: max(40px, presentation.min-width);

    presentation := MaterialButtonPresentation {
        text: root.text;
        layout-padding-left: 12px;
        layout-padding-right: 12px;
        height: 100%;
        border-radius: 20px;
        text-color: MaterialPalette.accent-background;
        text-opacity: 1.0;
        has-visible-focus: root.has-visible-focus;
        has-hover: root.has-hover;
        pressed: root.pressed;
        checked: root.checked;
        pressed-x: root.pressed-x;
        pressed-y: root.pressed-y;
    }
}

export component IconButton inherits ButtonBase {
    focus-on-pointer-click: true;

    in property <image> icon <=> presentation.icon;

    min-height: max(40px, presentation.min-height);
    min-width: max(40px, presentation.min-width);

    presentation := MaterialButtonPresentation {
        layout-padding-left: 8px;
        layout-padding-right: 8px;
        width: 100%;
        height: 100%;
        border-radius: 20px;
        text-color: MaterialPalette.control-foreground-variant;
        colorize-icon: true;
        text-opacity: 1.0;
        has-visible-focus: root.has-visible-focus;
        has-hover: root.has-hover;
        pressed: root.pressed;
        checked: root.checked;
        pressed-x: root.pressed-x;
        pressed-y: root.pressed-y;
    }
}
