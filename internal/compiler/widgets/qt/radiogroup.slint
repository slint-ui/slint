import { RadioGroupBase } from "../common/radiogroup-base.slint";
import { RadioButtonBase } from "../common/radiobutton-base.slint";

export component RadioButton inherits RadioButtonBase {
    private property <brush> dot-color: root.checked ? NativePalette.accent-background : transparent;

    min-height: max(28px, layout.min-height);

    states [
        disabled when !root.enabled || !root.group-enabled: {
            layout.opacity: 0.5;
        }
        pressed when root.pressed: {
            root.dot-color: root.checked ? NativePalette.accent-background.darker(0.2) : NativePalette.border;
        }
    ]

    animate dot-color { duration: 120ms; }

    layout := HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: self.width;
            cross-axis-self-alignment: center;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: NativePalette.border;
            background: NativePalette.control-background;

            Rectangle {
                width: 8px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.dot-color;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: NativePalette.foreground;
            vertical-alignment: center;
            horizontal-alignment: left;
            accessible-role: none;
        }
    }

    if root.has-focus && root.enabled && root.group-enabled: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 6px;
        border-width: 1px;
        border-color: NativePalette.accent-background;
    }
}

export component RadioGroup inherits RadioGroupBase {
    in property <string> title;
    in property <brush> title-color: root.enabled ? NativePalette.foreground : NativePalette.foreground.transparentize(0.5);
    in property <length> title-font-size: 13px;
    in property <int> title-font-weight: 400;

    accessible-label: root.title;

    header << VerticalLayout {
        padding: 0px;
        padding-bottom: root.title != "" ? root.spacing : 0px;
        vertical-stretch: 0;
        if root.title != "": Text {
            text: root.title;
            color: root.title-color;
            font-size: root.title-font-size;
            font-weight: root.title-font-weight;
            accessible-role: none;
        }
    }
}
