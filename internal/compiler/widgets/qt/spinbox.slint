export component SpinBox inherits NativeSpinBox {
    value: root.minimum;
    accessible-role: spinbox;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-read-only: root.read-only;

    accessible-action-set-value(v) => { if v.is-float() { root.update-value(v.to-float()); } }
    accessible-action-increment => { root.increment(); }
    accessible-action-decrement => { root.decrement(); }

    function increment() {
        root.update-value(root.value + root.step-size);
    }

    function decrement() {
        root.update-value(root.value - root.step-size);
    }

    function update-value(value: int) {
        if root.read-only || !root.enabled {
            return;
        }

        let clamped = clamp(value, root.minimum, root.maximum);
        if root.value == clamped {
            return;
        }

        root.value = clamped;
        root.edited(root.value);
    }
}
