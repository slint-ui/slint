import { FluentPalette } from "styling.slint";
import { SliderInterface } from "../common/std-widget-interfaces.slint";
import { Slider as SliderControl } from "../headless/controls.slint";

export component Slider {
    implement SliderInterface <=> control;

    forward-focus: control;

    accessible-role: slider;
    accessible-orientation: root.orientation;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-action-set-value(new-value) => {
        if (new-value.is-float()) {
            root.set-value(new-value.to-float());
        }
    }
    accessible-action-increment => { root.increment(); }
    accessible-action-decrement => { root.decrement(); }

    min-width: control.vertical ? 20px : 0px;
    min-height: control.vertical ? 0px : 20px;
    vertical-stretch: control.vertical ? 1 : 0;
    horizontal-stretch: control.vertical ? 0 : 1;
    accessible-value-step: min(root.step, (root.maximum - root.minimum) / 100);

    states [
        disabled when !root.enabled : {
            track.background: FluentPalette.accent-disabled;
            rail.background: FluentPalette.accent-disabled;
            thumb-inner.background: FluentPalette.accent-disabled;
        }
        pressed when control.handle-pressed || root.has-focus : {
            thumb-inner.width: 10px;
            thumb-inner.background: FluentPalette.tertiary-accent-background;
            thumb.border-color: FluentPalette.border;
        }
        hover when root.has-hover : {
            thumb-inner.width: 14px;
            thumb-inner.background: FluentPalette.secondary-accent-background;
        }
    ]

    rail := Rectangle {
        x: control.vertical ? (parent.width - self.width) / 2 : thumb.width / 2;
        y: control.vertical ? thumb.height / 2 : (parent.height - self.height) / 2;
        width: control.vertical ? 4px : parent.width - thumb.width;
        height: control.vertical ? parent.height - thumb.height : 4px;
        background: FluentPalette.border;
        border-radius: 2px;
    }

    track := Rectangle {
        x: control.vertical ? (parent.width - self.width) / 2 : thumb.width / 2;
        y: control.vertical ? thumb.y + thumb.height / 2 : (parent.height - self.height) / 2;
        width: control.vertical ? rail.width : thumb.x;
        height: control.vertical ? parent.height - thumb.y - thumb.height : rail.height;
        background: FluentPalette.accent-background;
        border-radius: rail.border-radius;
    }

    thumb := Rectangle {
        x: control.vertical ? (parent.width - self.width) / 2 : clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0, parent.width - self.width);
        y: control.vertical ? clamp((parent.height - self.height) * (root.maximum - root.value) / (root.maximum - root.minimum), 0, parent.height - self.height) : (parent.height - self.height) / 2;
        width: 20px;
        height: self.width;
        border-radius: 10px;
        background: FluentPalette.control-solid;

        thumb-border := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 21px;
            height: self.width;
            border-radius: 10.5px;
            border-width: 1px;
            border-color: FluentPalette.circle-border;
        }

        thumb-inner := Rectangle {
            width: 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: FluentPalette.accent-background;

            animate background, width { duration: 150ms; }
        }
    }

    control := SliderControl {
        handle-x: thumb.x;
        handle-y: thumb.y;
        handle-width: thumb.width;
        handle-height: thumb.height;
    }
}
