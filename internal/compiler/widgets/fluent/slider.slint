import { FluentPalette } from "styling.slint";
import { Slider as SliderControl } from "../headless/controls.slint";

export component Slider inherits SliderControl {
    handle-x: visual-thumb.x;
    handle-y: visual-thumb.y;
    handle-width: visual-thumb.width;
    handle-height: visual-thumb.height;

    min-width: root.vertical ? 20px : 0px;
    min-height: root.vertical ? 0px : 20px;
    vertical-stretch: root.vertical ? 1 : 0;
    horizontal-stretch: root.vertical ? 0 : 1;
    accessible-value-step: min(root.step, (root.maximum - root.minimum) / 100);

    states [
        disabled when !root.enabled : {
            filled-track.background: FluentPalette.accent-disabled;
            rail.background: FluentPalette.accent-disabled;
            thumb-inner.background: FluentPalette.accent-disabled;
        }
        pressed when root.handle-pressed || root.has-focus : {
            thumb-inner.width: 10px;
            thumb-inner.background: FluentPalette.tertiary-accent-background;
            visual-thumb.border-color: FluentPalette.border;
        }
        hover when root.has-hover : {
            thumb-inner.width: 14px;
            thumb-inner.background: FluentPalette.secondary-accent-background;
        }
    ]

    track << Rectangle {
        rail := Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : visual-thumb.width / 2;
            y: root.vertical ? visual-thumb.height / 2 : (parent.height - self.height) / 2;
            width: root.vertical ? 4px : parent.width - visual-thumb.width;
            height: root.vertical ? parent.height - visual-thumb.height : 4px;
            background: FluentPalette.border;
            border-radius: 2px;
        }

        filled-track := Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : visual-thumb.width / 2;
            y: root.vertical ? visual-thumb.y + visual-thumb.height / 2 : (parent.height - self.height) / 2;
            width: root.vertical ? rail.width : visual-thumb.x;
            height: root.vertical ? parent.height - visual-thumb.y - visual-thumb.height : rail.height;
            background: FluentPalette.accent-background;
            border-radius: rail.border-radius;
        }
    }

    thumb << Rectangle {
        visual-thumb := Rectangle {
            x: root.vertical ? (parent.width - self.width) / 2 : clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0, parent.width - self.width);
            y: root.vertical ? clamp((parent.height - self.height) * (root.maximum - root.value) / (root.maximum - root.minimum), 0, parent.height - self.height) : (parent.height - self.height) / 2;
            width: 20px;
            height: self.width;
            border-radius: 10px;
            background: FluentPalette.control-solid;

            thumb-border := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 21px;
                height: self.width;
                border-radius: 10.5px;
                border-width: 1px;
                border-color: FluentPalette.circle-border;
            }

            thumb-inner := Rectangle {
                width: 12px;
                height: self.width;
                border-radius: self.width / 2;
                background: FluentPalette.accent-background;

                animate background, width { duration: 150ms; }
            }
        }
    }
}
