import { FocusBorder } from "components.slint";
import { FluentPalette } from "styling.slint";
import { Button as BasicButton } from "../basic/button.slint";
import { ButtonStyle } from "../basic/button_style.slint";

global FluentButtonStyles {
    out property <ButtonStyle> standard: {
        rest: {
            background-color: FluentPalette.control-background,
            foreground-color: FluentPalette.control-foreground,
            border-color: FluentPalette.control-border,
        },
        hover: {
            background-color: FluentPalette.control-secondary,
            foreground-color: FluentPalette.control-foreground,
            border-color: FluentPalette.control-border,
        },
        pressed: {
            background-color: FluentPalette.control-tertiary,
            foreground-color: FluentPalette.text-secondary,
            border-color: FluentPalette.border,
        },
        disabled: {
            background-color: FluentPalette.control-disabled,
            foreground-color: FluentPalette.text-disabled,
            border-color: FluentPalette.border,
        },
        focus-color: FluentPalette.focus-stroke-outer,
    };
    out property <ButtonStyle> primary: {
        rest: {
            background-color: FluentPalette.accent-background,
            foreground-color: FluentPalette.accent-foreground,
            border-color: FluentPalette.accent-control-border,
        },
        hover: {
            background-color: FluentPalette.secondary-accent-background,
            foreground-color: FluentPalette.accent-foreground,
            border-color: FluentPalette.accent-control-border,
        },
        pressed: {
            background-color: FluentPalette.tertiary-accent-background,
            foreground-color: FluentPalette.text-accent-foreground-secondary,
            border-color: FluentPalette.border,
        },
        disabled: {
            background-color: FluentPalette.accent-disabled,
            foreground-color: FluentPalette.text-accent-foreground-disabled,
            border-color: transparent,
        },
        focus-color: FluentPalette.focus-stroke-outer,
    };
}

export component Button inherits BasicButton {
    in property <bool> primary;

    style: root.primary ? FluentButtonStyles.primary : FluentButtonStyles.standard;

    min-width: max(32px, root.content-min-width);
    font-size: 1rem;
    vertical-padding: 5px;
    spacing: 4px;
    focus-width: 0px;

    if root.has-focus && root.enabled : FocusBorder {
        border-radius: root.border-radius;
    }
}

export component ToggleButton inherits Button {
    in-out property <bool> checked;
    callback toggled();

    primary: root.checked;
    accessible-checkable: true;
    accessible-checked: root.checked;

    activating => {
        root.checked = !root.checked;
        root.toggled();
    }
}
