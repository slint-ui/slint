import { CupertinoFontSettings, CupertinoPalette } from "styling.slint";
import { RadioGroupBase } from "../common/radiogroup-base.slint";
import { RadioButtonBase } from "../common/radiobutton-base.slint";
import { FocusBorder } from "components.slint";

export component RadioButton inherits RadioButtonBase {
    private property <brush> dot-color: root.checked ? CupertinoPalette.accent-background : transparent;

    min-height: max(28px, layout.min-height);

    states [
        disabled when !root.enabled || !root.group-enabled: {
            layout.opacity: 0.5;
        }
        pressed when root.pressed: {
            root.dot-color: root.checked ? CupertinoPalette.secondary-accent-background : CupertinoPalette.hover;
        }
    ]

    animate dot-color { duration: 150ms; }

    layout := HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: self.width;
            cross-axis-self-alignment: center;
            border-radius: self.width / 2;
            border-width: 1px;
            border-color: CupertinoPalette.border;
            background: CupertinoPalette.control-background;

            Rectangle {
                width: 8px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.dot-color;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: CupertinoPalette.foreground;
            vertical-alignment: center;
            horizontal-alignment: left;
            accessible-role: none;
        }
    }

    if root.has-focus && root.enabled && root.group-enabled: FocusBorder {
        border-radius: 7px;
    }
}

export component RadioGroup inherits RadioGroupBase {
    in property <string> title;
    in property <brush> title-color: root.enabled ? CupertinoPalette.foreground : CupertinoPalette.foreground-secondary;
    in property <length> title-font-size: CupertinoFontSettings.body-strong.font-size;
    in property <int> title-font-weight: CupertinoFontSettings.body-strong.font-weight;

    accessible-label: root.title;

    header << VerticalLayout {
        padding: 0px;
        padding-bottom: root.title != "" ? root.spacing : 0px;
        vertical-stretch: 0;
        if root.title != "": Text {
            text: root.title;
            color: root.title-color;
            font-size: root.title-font-size;
            font-weight: root.title-font-weight;
            accessible-role: none;
        }
    }
}
