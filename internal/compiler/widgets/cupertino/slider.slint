import { CupertinoPalette } from "styling.slint";
import { Slider as SliderControl } from "../headless/controls.slint";

export component Slider inherits SliderControl {
    handle-x: thumb.x;
    handle-y: thumb.y;
    handle-width: thumb.width;
    handle-height: thumb.height;

    min-width: root.vertical ? 20px : 0px;
    min-height: root.vertical ? 0px : 20px;
    vertical-stretch: root.vertical ? 1 : 0;
    horizontal-stretch: root.vertical ? 0 : 1;
    accessible-value-step: min(root.step, (root.maximum - root.minimum) / 100);

    states [
        disabled when !root.enabled : {
            root.opacity: 0.5;
        }
        pressed when root.handle-pressed || root.has-focus : {
            thumb.background: CupertinoPalette.pressed;
        }
    ]

    rail := Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : thumb.width / 2;
        y: root.vertical ? thumb.height / 2 : (parent.height - self.height) / 2;
        width: root.vertical ? 4px : parent.width - thumb.width;
        height: root.vertical ? parent.height - thumb.height : 4px;
        background: CupertinoPalette.alternate-control-background;
        border-radius: 2px;

        Rectangle {
            border-width: 1px;
            border-color: @radial-gradient(circle, #00000026, #00000000);
            border-radius: parent.border-radius;
        }
    }

    track := Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : thumb.width / 2;
        y: root.vertical ? thumb.y + thumb.height / 2 : (parent.height - self.height) / 2;
        width: root.vertical ? rail.width : thumb.x;
        height: root.vertical ? parent.height - thumb.y - thumb.height : rail.height;
        background: CupertinoPalette.accent-background;
        border-radius: rail.border-radius;
    }

    thumb := Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0, parent.width - self.width);
        y: root.vertical ? clamp((parent.height - self.height) * (root.maximum - root.value) / (root.maximum - root.minimum), 0, parent.height - self.height) : (parent.height - self.height) / 2;
        width: 20px;
        height: self.width;
        border-radius: 10px;
        background: CupertinoPalette.control-background-thumb;
        drop-shadow-blur: 1px;
        drop-shadow-offset-y: 0.25px;
        drop-shadow-color: #0000003D;

        animate background { duration: 150ms; easing: linear; }
    }
}
