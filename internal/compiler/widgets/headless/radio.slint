import { RadioButtonInterface, RadioGroupInterface } from "../common/std-widget-interfaces.slint";

import { Pressable } from "pressable.slint";

export component RadioButton {
    implement RadioButtonInterface <=> self;

    in property <string> text;
    in property <string> value;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <bool> checked: false;

    out property <bool> has-focus: pressable.has-focus;
    out property <bool> has-hover: pressable.has-hover;
    out property <bool> pressed: pressable.pressed;

    callback selected;
    callback focus-change(bool);

    preferred-width: 100%;
    preferred-height: 100%;
    min-width: pressable.min-width;
    min-height: pressable.min-height;
    forward-focus: pressable;

    public function select() {
        if (root.enabled && !root.read-only && !root.checked) {
            root.selected();
        }
    }

    pressable := Pressable {
        enabled: root.enabled;
        activate-on-enter: false;
        clicked => { root.select(); }
        focus-change(gained) => { root.focus-change(gained); }

        @children
    }
}
export component RadioGroup {
    implement RadioGroupInterface <=> self;

    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in-out property <string> selected-value;

    callback selected(string);

    preferred-width: 100%;
    preferred-height: 100%;
    min-width: content.min-width;
    min-height: content.min-height;

    public function select(value: string) {
        if (root.enabled && !root.read-only && root.selected-value != value) {
            root.selected-value = value;
            root.selected(value);
        }
    }

    content := Rectangle {
        @children
    }
}
