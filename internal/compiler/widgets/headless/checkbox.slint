import { CheckBoxInterface } from "../common/std-widget-interfaces.slint";

import { Pressable } from "pressable.slint";

export component CheckBox {
    implement CheckBoxInterface <=> self;

    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in-out property <bool> checked: false;

    out property <bool> has-focus: pressable.has-focus;
    out property <bool> has-hover: pressable.has-hover;
    out property <bool> pressed: pressable.pressed;

    callback toggled;

    preferred-width: 100%;
    preferred-height: 100%;
    min-width: pressable.min-width;
    min-height: pressable.min-height;
    forward-focus: pressable;

    public function toggle() {
        if (root.enabled && !root.read-only) {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    pressable := Pressable {
        enabled: root.enabled;
        activate-on-enter: false;
        clicked => { root.toggle(); }

        @children
    }
}
