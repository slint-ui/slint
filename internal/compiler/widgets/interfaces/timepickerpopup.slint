export struct Time {
    hour: int,
    minute: int,
    second: int,
}

export interface TimePickerPopup {
    in property <string> title;
    in property <Time> time;
    in property <bool> use-24-hour-format;

    callback accepted(time: Time);
    callback canceled;
}
