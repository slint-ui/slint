import { CosmicFontSettings, CosmicPalette } from "styling.slint";
import { RadioGroupBase } from "../common/radiogroup-base.slint";
import { RadioButtonBase } from "../common/radiobutton-base.slint";

export component RadioButton inherits RadioButtonBase {
    private property <brush> dot-color: root.checked ? CosmicPalette.accent-background : transparent;
    private property <color> text-color: CosmicPalette.control-foreground;

    min-height: max(28px, layout.min-height);

    states [
        disabled when !root.enabled || !root.group-enabled: {
            layout.opacity: 0.5;
        }
        checked when root.checked: {
            border.border-color: CosmicPalette.accent-background;
        }
    ]

    animate dot-color { duration: 150ms; }
    animate text-color { duration: 150ms; }

    layout := HorizontalLayout {
        spacing: 8px;

        Rectangle {
            width: 16px;
            height: self.width;
            cross-axis-self-alignment: center;
            border-radius: self.width / 2;
            background: CosmicPalette.control-background;

            border := Rectangle {
                border-color: CosmicPalette.alternate-border;
                border-width: 1px;
                border-radius: parent.border-radius;
            }

            Rectangle {
                width: 8px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.dot-color;
            }
        }

        if root.text != "": Text {
            text: root.text;
            color: root.text-color;
            vertical-alignment: center;
            horizontal-alignment: left;
            accessible-role: none;
        }
    }
}

export component RadioGroup inherits RadioGroupBase {
    in property <string> title;
    in property <brush> title-color: root.enabled ? CosmicPalette.foreground : CosmicPalette.text-disabled;
    in property <length> title-font-size: CosmicFontSettings.body-strong.font-size;
    in property <int> title-font-weight: CosmicFontSettings.body-strong.font-weight;

    accessible-label: root.title;

    header << VerticalLayout {
        padding: 0px;
        padding-bottom: root.title != "" ? root.spacing : 0px;
        vertical-stretch: 0;
        if root.title != "": Text {
            text: root.title;
            color: root.title-color;
            font-size: root.title-font-size;
            font-weight: root.title-font-weight;
            accessible-role: none;
        }
    }
}
