import { CheckBox, RadioButton, RadioGroup, Switch } from "../../../internal/compiler/widgets/headless/controls.slint";

export component GalleryCheckBox inherits CheckBox {
    min-height: 28px;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: root.has-focus ? 2px : 1px;
            border-color: root.has-focus ? #93c5fd : root.checked ? #2563eb : #94a3b8;
            background: root.checked ? #2563eb : #ffffff;

            if root.checked: Text {
                text: "✓";
                color: #ffffff;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? #0f172a : #94a3b8;
            vertical-alignment: center;
        }
    }
}

export component GallerySwitch inherits Switch {
    min-height: 28px;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: self.height / 2;
            background: !root.enabled ? #cbd5e1 : root.checked ? #2563eb : #94a3b8;

            Rectangle {
                x: root.checked ? parent.width - self.width - 3px : 3px;
                y: 3px;
                width: 14px;
                height: 14px;
                border-radius: self.width / 2;
                background: #ffffff;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #0f172a30;

                animate x { duration: 100ms; easing: ease-out; }
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? #0f172a : #94a3b8;
            vertical-alignment: center;
        }
    }
}

component GalleryRadioButton inherits RadioButton {
    min-height: 28px;

    HorizontalLayout {
        spacing: 8px;
        cross-axis-alignment: center;

        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: self.width / 2;
            border-width: root.has-focus ? 2px : 1px;
            border-color: root.has-focus ? #93c5fd : root.checked ? #2563eb : #94a3b8;
            background: #ffffff;

            Rectangle {
                width: root.checked ? 10px : 0px;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: #2563eb;

                animate width, height { duration: 100ms; easing: ease-out; }
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? #0f172a : #94a3b8;
            vertical-alignment: center;
        }
    }
}

export component GalleryRadioGroup inherits RadioGroup {
    VerticalLayout {
        spacing: 4px;

        GalleryRadioButton {
            text: "Comfortable";
            value: "comfortable";
            enabled: root.enabled;
            read-only: root.read-only;
            checked: root.selected-value == self.value;
            selected => { root.select(self.value); }
        }

        GalleryRadioButton {
            text: "Compact";
            value: "compact";
            enabled: root.enabled;
            read-only: root.read-only;
            checked: root.selected-value == self.value;
            selected => { root.select(self.value); }
        }
    }
}
