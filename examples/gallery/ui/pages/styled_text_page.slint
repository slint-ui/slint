import { Button, GroupBox, HorizontalBox, SpinBox, VerticalBox } from "std-widgets.slint";
import { Page } from "page.slint";

export component StyledTextPage inherits Page {
    show-enable-switch: false;
    title: @tr("Styled Text");
    description: @tr("StyledText demos");
    alignment: start;

    VerticalBox {
        GroupBox {
            title: @tr("Basic Styles");

            VerticalBox {
                StyledText {
                    text: @markdown("**bold text**, *italic text*, <u>underlined text</u>, ~~strikethrough text~~, ***bold italic***.");
                }
            }
        }

        GroupBox {
            title: @tr("Colors");

            VerticalBox {
                StyledText {
                    text: @markdown("<font color='#e74c3c'>Red text</font> and <font color='#27ae60'>green text</font> and <font color='#3498db'>blue text</font>.");
                }

                StyledText {
                    text: @markdown("<font color='#9b59b6'>Purple</font> **bold** <font color='#f39c12'>orange</font> *italic* mixed together.");
                }
            }
        }

        GroupBox {
            title: @tr("Hyperlinks");

            VerticalBox {
                StyledText {
                    text: @markdown("Visit [Slint Website](https://slint.dev) for more information.");
                    link-clicked(link) => {
                        Platform.open-url(link);
                    }
                }

                StyledText {
                    text: @markdown("Check out our [GitHub](https://github.com/slint-ui/slint) repository and [Documentation](https://slint.dev/docs).");
                    link-clicked(link) => {
                        Platform.open-url(link);
                    }
                }
            }
        }

        GroupBox {
            title: @tr("Lists");

            VerticalBox {
                StyledText {
                    text: @markdown(
                        "* First item\n"
                        "* Second item\n"
                        "* Third item\n"
                        "  1. Item one\n"
                        "  2. Item two\n"
                        "  3. Item three"
                    );
                }

                StyledText {
                    text: @markdown("1. First step\n2. Second step\n3. Third step");
                }
            }
        }

        GroupBox {
            title: @tr("Inline Code");

            VerticalBox {
                StyledText {
                    text: @markdown("Run `cargo install slint-lsp` and then call `slint::include_modules!()` in your `main.rs`.");
                }

                StyledText {
                    text: @markdown("Inline `code` mixes with **bold**, *italic* and [links](https://slint.dev) on the same line.");
                }
            }
        }

        GroupBox {
            title: @tr("Text Selection");

            VerticalBox {
                sample := StyledText {
                    text: @markdown("Drag to select this text, double click for a word and triple click for a paragraph.");
                    text-selectable: true;
                }

                HorizontalBox {
                    alignment: start;
                    padding: 0px;

                    Button {
                        text: @tr("Select all");
                        clicked => {
                            sample.select-all();
                        }
                    }

                    Button {
                        text: @tr("Copy");
                        enabled: sample.has-selection;
                        clicked => {
                            sample.copy();
                        }
                    }

                    Button {
                        text: @tr("Clear");
                        enabled: sample.has-selection;
                        clicked => {
                            sample.clear-selection();
                        }
                    }
                }

                HorizontalBox {
                    alignment: start;
                    padding: 0px;

                    Text {
                        text: @tr("Select byte offsets");
                        vertical-alignment: center;
                    }

                    // The sample text is 83 bytes long.
                    anchor := SpinBox {
                        horizontal-stretch: 0;
                        minimum: 0;
                        maximum: 83;
                    }

                    Text {
                        text: @tr("to");
                        vertical-alignment: center;
                    }

                    focus := SpinBox {
                        horizontal-stretch: 0;
                        minimum: 0;
                        maximum: 83;
                    }

                    Button {
                        text: @tr("Select range");
                        clicked => {
                            sample.set-selection-offsets(anchor.value, focus.value);
                        }
                    }
                }
            }
        }
    }
}
