// Image-only progress indicator, 112x61 at its native size.
// The eleven ring PNGs combine the exported base and segment overlays, one per
// completed tenth, clockwise from 12 o'clock: 65% lights six segments.
// Separate raster digits show the exact percentage over the ring.

// One navy digit of the reading. A negative value draws nothing.
component NavyDigit inherits Image {
    in property <int> value: -1;

    source: root.value < 0 ? @image-url("")
        : root.value == 0 ? @image-url("assets/digits/digit-navy-0.png")
        : root.value == 1 ? @image-url("assets/digits/digit-navy-1.png")
        : root.value == 2 ? @image-url("assets/digits/digit-navy-2.png")
        : root.value == 3 ? @image-url("assets/digits/digit-navy-3.png")
        : root.value == 4 ? @image-url("assets/digits/digit-navy-4.png")
        : root.value == 5 ? @image-url("assets/digits/digit-navy-5.png")
        : root.value == 6 ? @image-url("assets/digits/digit-navy-6.png")
        : root.value == 7 ? @image-url("assets/digits/digit-navy-7.png")
        : root.value == 8 ? @image-url("assets/digits/digit-navy-8.png")
        : @image-url("assets/digits/digit-navy-9.png");
}

export component SegmentedProgress inherits Image {
    // The percentage to show, clamped to 0-100.
    in property <int> percent: 0;
    // While inactive the indicator draws nothing.
    in property <bool> active: true;

    private property <int> progress: root.percent < 0 ? 0
        : root.percent > 100 ? 100 : root.percent;
    // 100 reads as "1", "0", "0", so the tens and units of a full ring are zero.
    private property <int> tens: root.progress == 100 ? 0
        : root.progress < 10 ? 0
        : root.progress < 20 ? 1
        : root.progress < 30 ? 2
        : root.progress < 40 ? 3
        : root.progress < 50 ? 4
        : root.progress < 60 ? 5
        : root.progress < 70 ? 6
        : root.progress < 80 ? 7
        : root.progress < 90 ? 8
        : 9;
    private property <int> units: root.progress == 100 ? 0
        : root.progress - root.tens * 10;
    // The reading is centered, so each further digit moves the group 3px left.
    private property <length> tens-x: root.progress == 100 ? 49px : 46px;
    private property <length> units-x: root.progress == 100 ? 55px
        : root.progress >= 10 ? 52px : 49px;

    source: !root.active ? @image-url("")
        : root.progress < 10 ? @image-url("assets/progress/progress-0.png")
        : root.progress < 20 ? @image-url("assets/progress/progress-10.png")
        : root.progress < 30 ? @image-url("assets/progress/progress-20.png")
        : root.progress < 40 ? @image-url("assets/progress/progress-30.png")
        : root.progress < 50 ? @image-url("assets/progress/progress-40.png")
        : root.progress < 60 ? @image-url("assets/progress/progress-50.png")
        : root.progress < 70 ? @image-url("assets/progress/progress-60.png")
        : root.progress < 80 ? @image-url("assets/progress/progress-70.png")
        : root.progress < 90 ? @image-url("assets/progress/progress-80.png")
        : root.progress < 100 ? @image-url("assets/progress/progress-90.png")
        : @image-url("assets/progress/progress-100.png");

    NavyDigit {
        x: 43px;
        y: 13px;
        value: root.active && root.progress == 100 ? 1 : -1;
    }

    NavyDigit {
        x: root.tens-x;
        y: 13px;
        value: root.active && root.progress >= 10 ? root.tens : -1;
    }

    NavyDigit {
        x: root.units-x;
        y: 13px;
        value: root.active ? root.units : -1;
    }

    Image {
        x: root.units-x + 6px;
        y: 13px;
        source: root.active
            ? @image-url("assets/progress/percent-navy.png") : @image-url("");
    }
}
