// The safety-domain scene in the Slint SC subset: Window and Rectangle only,
// no Timer, no model. Rust sets the three color properties; see src/lib.rs.

export component MainWindow inherits Window {
    in property <color> first-color;
    in property <color> second-color;
    in property <color> third-color;

    background: #000000;

    first := Rectangle {
        x: 20px;
        y: 20px;
        width: 60px;
        height: 60px;
        background: root.first-color;
    }

    second := Rectangle {
        x: 100px;
        y: 20px;
        width: 60px;
        height: 60px;
        background: root.second-color;
    }

    third := Rectangle {
        x: 180px;
        y: 20px;
        width: 60px;
        height: 60px;
        background: root.third-color;
    }
}
