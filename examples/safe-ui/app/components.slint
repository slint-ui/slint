// The image components the airlock screen is built from.
// An `Image` in the Slint SC subset is always the size of its source, so a
// component here places artwork and never scales it.

export enum DoorState { sealed, locking, locked, ready, released }

export component DoorImage inherits Image {
    in property <DoorState> state: DoorState.sealed;

    source: root.state == DoorState.sealed ? @image-url("assets/door-sealed.png")
        : root.state == DoorState.locking ? @image-url("assets/door-locking.png")
        : root.state == DoorState.locked ? @image-url("assets/door-locked.png")
        : root.state == DoorState.ready ? @image-url("assets/door-ready.png")
        : @image-url("assets/door-released.png");
}

// One white digit of the countdown. A negative value draws nothing, which is
// how the subset hides an element: it has no 'visible'.
export component RasterDigit inherits Image {
    in property <int> value: -1;

    source: root.value < 0 ? @image-url("")
        : root.value == 0 ? @image-url("assets/digits/digit-white-0.png")
        : root.value == 1 ? @image-url("assets/digits/digit-white-1.png")
        : root.value == 2 ? @image-url("assets/digits/digit-white-2.png")
        : root.value == 3 ? @image-url("assets/digits/digit-white-3.png")
        : root.value == 4 ? @image-url("assets/digits/digit-white-4.png")
        : root.value == 5 ? @image-url("assets/digits/digit-white-5.png")
        : root.value == 6 ? @image-url("assets/digits/digit-white-6.png")
        : root.value == 7 ? @image-url("assets/digits/digit-white-7.png")
        : root.value == 8 ? @image-url("assets/digits/digit-white-8.png")
        : @image-url("assets/digits/digit-white-9.png");
}
