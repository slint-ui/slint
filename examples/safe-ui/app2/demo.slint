// Standalone simulation for ordinary Slint, not Slint SC.
// Launch: slint-viewer demo.slint
// The host-driven UI is main.slint; it does not import this simulation.
// All artwork is reused unchanged from main.slint and its PNG assets.
// ENTER -> securing (6s) -> equalizing (9s) -> EXIT OUTER -> EXIT INNER.
// Double-click/tap the occupant chamber (or press F) to simulate a fault.
// Click/tap the emergency banner (or press R) to reset the simulation.
// These fault/reset gestures exist only in this demo, not the host-driven UI.
import { PublicTransitAirlock, TransitView } from "main.slint";

export global DemoController {
    private property <duration> phase-start: 0ms;

    out property <TransitView> view: TransitView.ready;
    out property <int> seconds-remaining: 6;
    out property <int> progress-percent: 0;

    public function enter() {
        if self.view == TransitView.ready {
            self.phase-start = animation-tick();
            self.seconds-remaining = 6;
            self.progress-percent = 0;
            self.view = TransitView.securing;
        }
    }
    public function exit-outer() {
        if self.view == TransitView.ready-to-open {
            self.view = TransitView.complete;
        }
    }
    public function exit-inner() {
        if self.view == TransitView.complete { self.reset(); }
    }
    public function fault() { self.view = TransitView.fault; }
    public function reset() {
        self.view = TransitView.ready;
        self.seconds-remaining = 6;
        self.progress-percent = 0;
        self.phase-start = 0ms;
    }
    // Elapsed time, not tick count: delayed frames cannot slow the countdown.
    public function advance(now: duration) {
        if self.view == TransitView.securing {
            if now - self.phase-start >= 6s {
                self.phase-start += 6s;
                self.view = TransitView.equalizing;
            } else {
                self.seconds-remaining = ceil(max(0ms, 6s - (now - self.phase-start)) / 1s);
            }
        }
        if self.view == TransitView.equalizing {
            self.seconds-remaining = ceil(max(0ms, 9s - (now - self.phase-start)) / 1s);
            self.progress-percent = min(100, max(0, floor((now - self.phase-start) / 9s * 100)));
            if now - self.phase-start >= 9s {
                self.view = TransitView.ready-to-open;
            }
        }
    }
}

export component PublicTransitDemo inherits PublicTransitAirlock {
    width: 320px;
    height: 240px;
    title: "Public Transit Airlock — Demo (F: fault, R: reset)";
    view: DemoController.view;
    seconds-remaining: DemoController.seconds-remaining;
    progress-percent: DemoController.progress-percent;
    forward-focus: shortcuts;

    enter-requested => { DemoController.enter(); }
    exit-outer-requested => { DemoController.exit-outer(); }
    exit-inner-requested => { DemoController.exit-inner(); }

    Timer {
        interval: 100ms;
        running: DemoController.view == TransitView.securing || DemoController.view == TransitView.equalizing;
        triggered => { DemoController.advance(animation-tick()); }
    }
    TouchArea {
        x: 110px; y: 11px; width: 102px; height: 98px;
        double-clicked => { DemoController.fault(); }
    }
    TouchArea {
        x: 7px; y: 181px; width: 308px; height: 56px;
        enabled: DemoController.view == TransitView.fault;
        clicked => { DemoController.reset(); }
    }
    shortcuts := FocusScope {
        // Keyboard-only: do not cover the image UI's pointer targets.
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if event.text == "f" || event.text == "F" {
                DemoController.fault();
                return accept;
            }
            if event.text == "r" || event.text == "R" {
                DemoController.reset();
                return accept;
            }
            return reject;
        }
    }
}
