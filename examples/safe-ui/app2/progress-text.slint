import { RasterDigit } from "components.slint";

export component ProgressText inherits Image {
    private property <int> clamped-value: value < 0 ? 0 : value > 99 ? 99 : value;
    private property <int> tens: floor(clamped-value / 10);

    in property <int> value: 0;

    width: 20px;
    height: 24px;
    RasterDigit {
        x: 0px;
        y: 0px;
        value: root.tens;
    }

    RasterDigit {
        x: 10px;
        y: 0px;
        value: root.clamped-value - root.tens * 10;
    }
}
