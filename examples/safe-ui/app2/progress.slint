// Image-only progress indicator. Native size: 112x61; screen placement: (105,115).
// PNGs: assets/progress/ and assets/digits/. Figma export section 2086; child coordinates are local pixel offsets.
// Integer input is clamped to 0–100. Ten completed-10% thresholds, clockwise from 12 o'clock.
// 65% = six active segments. No timers, fonts, drawing, scaling or interaction.
// Custom child input bindings require ordinary Slint in the current local compiler.

component NavyDigit inherits Image {
    in property <int> value;
    source: root.value == 0 ? @image-url("assets/digits/digit-navy-0.png")
        : root.value == 1 ? @image-url("assets/digits/digit-navy-1.png")
        : root.value == 2 ? @image-url("assets/digits/digit-navy-2.png")
        : root.value == 3 ? @image-url("assets/digits/digit-navy-3.png")
        : root.value == 4 ? @image-url("assets/digits/digit-navy-4.png")
        : root.value == 5 ? @image-url("assets/digits/digit-navy-5.png")
        : root.value == 6 ? @image-url("assets/digits/digit-navy-6.png")
        : root.value == 7 ? @image-url("assets/digits/digit-navy-7.png")
        : root.value == 8 ? @image-url("assets/digits/digit-navy-8.png")
        : @image-url("assets/digits/digit-navy-9.png");
}

export component SegmentedProgress inherits Image {
    private property <int> progress: percent < 0 ? 0 : percent > 100 ? 100 : percent;
    private property <int> progress-tens: progress == 100 ? 0 : floor(progress / 10);
    private property <int> progress-units: progress == 100 ? 0 : progress - progress-tens * 10;

    in property <int> percent: 0;
    in property <bool> active: true;

    width: 112px;
    height: 61px;
    visible: root.active;
    source: @image-url("assets/progress/progress-base.png");
    Image {
        x: 56px;
        y: 0px;
        visible: root.progress >= 10;
        source: @image-url("assets/progress/progress-segment-01.png");
    }

    Image {
        x: 65px;
        y: 4px;
        visible: root.progress >= 20;
        source: @image-url("assets/progress/progress-segment-02.png");
    }

    Image {
        x: 70px;
        y: 14px;
        visible: root.progress >= 30;
        source: @image-url("assets/progress/progress-segment-03.png");
    }

    Image {
        x: 65px;
        y: 25px;
        visible: root.progress >= 40;
        source: @image-url("assets/progress/progress-segment-04.png");
    }

    Image {
        x: 56px;
        y: 32px;
        visible: root.progress >= 50;
        source: @image-url("assets/progress/progress-segment-05.png");
    }

    Image {
        x: 45px;
        y: 32px;
        visible: root.progress >= 60;
        source: @image-url("assets/progress/progress-segment-06.png");
    }

    Image {
        x: 37px;
        y: 25px;
        visible: root.progress >= 70;
        source: @image-url("assets/progress/progress-segment-07.png");
    }

    Image {
        x: 36px;
        y: 14px;
        visible: root.progress >= 80;
        source: @image-url("assets/progress/progress-segment-08.png");
    }

    Image {
        x: 37px;
        y: 4px;
        visible: root.progress >= 90;
        source: @image-url("assets/progress/progress-segment-09.png");
    }

    Image {
        x: 45px;
        y: 0px;
        visible: root.progress >= 100;
        source: @image-url("assets/progress/progress-segment-10.png");
    }

    NavyDigit {
        x: 43px;
        y: 13px;
        value: 1;
        visible: root.progress == 100;
    }

    NavyDigit {
        x: root.progress == 100 ? 49px : 46px;
        y: 13px;
        value: root.progress-tens;
        visible: root.progress >= 10;
    }

    NavyDigit {
        x: root.progress == 100 ? 55px : root.progress >= 10 ? 52px : 49px;
        y: 13px;
        value: root.progress-units;
    }

    Image {
        x: root.progress == 100 ? 61px : root.progress >= 10 ? 58px : 55px;
        y: 13px;
        source: @image-url("assets/progress/percent-navy.png");
    }
}
