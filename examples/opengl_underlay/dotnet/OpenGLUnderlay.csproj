<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenGLUnderlay</RootNamespace>
    <!-- The UI refers to images around it, so load it from where it is. -->
    <SlintCopyToOutput>false</SlintCopyToOutput>
  </PropertyGroup>
  <ItemGroup>
    <SlintFile Include="../scene.slint" />
  </ItemGroup>
  <!-- Outside this repository, use <PackageReference Include="yurkinh.slint.net" Version="..." /> instead of the two lines below. -->
  <ItemGroup>
    <ProjectReference Include="../../../api/dotnet/Slint/Slint.csproj" />
  </ItemGroup>
  <Import Project="../../../api/dotnet/Slint/build/Slint.targets" />
</Project>
