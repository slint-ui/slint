{
    "name": "imagefilter",
    "version": "1.19.0",
    "main": "main.js",
    "type": "module",
    "dependencies": {
        "slint-ui": "workspace:*",
        "image-js": "1.7.1"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "scripts": {
        "generate": "cargo run --manifest-path ../../../Cargo.toml -p slint-compiler -- -f typescript ../ui/main.slint -o ../ui/main.slint.d.ts",
        "start": "npm run generate && node --import slint-ui/register main.ts",
        "prestart": "cd ../../../api/node/ && pnpm run build && pnpm compile",
        "check": "npm run generate && tsc --noEmit"
    }
}
