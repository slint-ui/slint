{
    "name": "todo-typescript",
    "version": "1.19.0",
    "type": "module",
    "dependencies": {
        "slint-ui": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "scripts": {
        "generate": "slint-typegen ../ui/todo.slint",
        "start": "npm run generate && node --import slint-ui/register main.ts",
        "prestart": "cd ../../../api/node/ && pnpm run build && pnpm compile",
        "check": "npm run generate && tsc --noEmit"
    }
}
